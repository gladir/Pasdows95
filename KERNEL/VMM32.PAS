  FillMem(I, SizeOf(TEmsNmArr), 0);
  Move(I, EmsHName, 4);
  I := KAlloc(SizeOf(TGdiArr));
  Move(I, Gdis, 4);
  I := KAlloc(SizeOf(TWndArr));
  FillMem(I, SizeOf(TWndArr), 0);
  Move(I, Wnds, 4);
  I := KAlloc(SizeOf(TKObjArr));
  FillMem(I, SizeOf(TKObjArr), 0);
  Move(I, KObjs, 4);
