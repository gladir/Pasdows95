{ ------------------------------------------------------------------ }
{ ADVAPI32 : registre en memoire (cles et valeurs), partage avec les   }
{ programmes 16 bits (SHELL.DLL). Racines : 80000000h CLASSES_ROOT    }
{ (1 en Win16), ...01h CURRENT_USER, ...02h LOCAL_MACHINE, ...03h     }
{ USERS, ...05h CURRENT_CONFIG, ...06h DYN_DATA ; autres cles :       }
{ poignee 00C00000h + indice.                                         }
{ ------------------------------------------------------------------ }

Const
  MaxRK = 12000;
  MaxRV = 24000;
  HKBase = $00C00000;

Type
  TRKBool = Array[0..MaxRK - 1] Of Boolean;
  TRKLong = Array[0..MaxRK - 1] Of LongInt;
  TRVBool = Array[0..MaxRV - 1] Of Boolean;
  TRVLong = Array[0..MaxRV - 1] Of LongInt;

Var
  RegDirty : Boolean;          { registre modifie depuis la sauvegarde }
  RegSaveDue : Boolean;        { a sauvegarder (fin d'un programme) }
  { tables dans le tas (RegInit) : en variables globales, elles
    poussaient l'image du noyau au-dela de 4 Mo }
  RKUsed : ^TRKBool;
  RKPar, RKNameP : ^TRKLong;
  RVUsed : ^TRVBool;
  RVKey, RVType, RVData, RVSize, RVNameP : ^TRVLong;

{ Noms des cles et valeurs : chaines terminees par zero dans le tas }
Function RegStrNew(S : String) : LongInt;
Var A, H : LongInt;
Begin
  { bloc du systeme : le registre survit au programme qui l'a ecrit }
  H := HeapOwner; HeapOwner := 0;
  A := KAlloc(Length(S) + 1);
  HeapOwner := H;
  PutPStr(A, S, Length(S) + 1);
  RegStrNew := A;
End;

Function RKName(I : LongInt) : String;
Begin
  If RKNameP^[I] = 0 Then RKName := '' Else RKName := PStr(RKNameP^[I]);
End;

Function RVName(I : LongInt) : String;
Begin
  If RVNameP^[I] = 0 Then RVName := '' Else RVName := PStr(RVNameP^[I]);
End;

Function RegKeyOf(H : LongInt) : LongInt;
Begin
  RegKeyOf := -1;
  If H = 1 Then RegKeyOf := 0
  Else If (H >= LongInt($80000000)) And (H <= LongInt($80000006)) Then
  Begin
    H := H And 7;
    If H = 4 Then Exit;
    If H >= 5 Then H := H - 1;
    RegKeyOf := H;
  End
  Else If (H >= HKBase) And (H < HKBase + MaxRK) Then
    If RKUsed^[H - HKBase] Then RegKeyOf := H - HKBase;
End;

Function RegChild(K : LongInt; Nm : String; Create : Boolean) : LongInt;
Var I : LongInt; U : String;
Begin
  RegChild := -1;
  U := UpStr(Nm);
  For I := 0 To MaxRK - 1 Do
    If RKUsed^[I] And (RKPar^[I] = K) And (UpStr(RKName(I)) = U) Then
    Begin
      RegChild := I;
      Exit;
    End;
  If Not Create Then Exit;
  For I := 6 To MaxRK - 1 Do
    If Not RKUsed^[I] Then
    Begin
      RKUsed^[I] := True; RKPar^[I] := K; RKNameP^[I] := RegStrNew(Nm);
      RegDirty := True;
      RegChild := I;
      Exit;
    End;
End;

{ Cle Path sous K (creee si Create) ; -1 si absente }
Function RegWalk(K : LongInt; Path : String; Create : Boolean) : LongInt;
Var P : LongInt; Part : String;
Begin
  RegWalk := -1;
  If K < 0 Then Exit;
  While Path <> '' Do
  Begin
    P := Pos('\', Path);
    If P > 0 Then
    Begin
      Part := Copy(Path, 1, P - 1); Delete(Path, 1, P);
    End
    Else
    Begin
      Part := Path; Path := '';
    End;
    If Part <> '' Then
    Begin
      K := RegChild(K, Part, Create);
      If K < 0 Then Exit;
    End;
  End;
  RegWalk := K;
End;

Function RegVal(K : LongInt; Nm : String) : LongInt;
Var I : LongInt; U : String;
Begin
  RegVal := -1;
  U := UpStr(Nm);
  For I := 0 To MaxRV - 1 Do
    If RVUsed^[I] And (RVKey^[I] = K) And (UpStr(RVName(I)) = U) Then
    Begin
      RegVal := I;
      Exit;
    End;
End;

Function RegSetK(K : LongInt; Nm : String; Typ, Data, Size : LongInt)
  : LongInt;
Var I, J : LongInt;
Begin
  RegSetK := 1;
  If K < 0 Then Exit;
  I := RegVal(K, Nm);
  If I < 0 Then
    For J := MaxRV - 1 DownTo 0 Do
      If Not RVUsed^[J] Then I := J;
  If I < 0 Then Exit;
  If RVUsed^[I] And (RVData^[I] <> 0) Then KFree(RVData^[I]);
  If Not RVUsed^[I] Then RVNameP^[I] := RegStrNew(Nm);
  RVUsed^[I] := True; RVKey^[I] := K; RVType^[I] := Typ;
  If Size < 0 Then Size := 0;
  J := HeapOwner; HeapOwner := 0;
  RVData^[I] := KAlloc(Size + 2);
  HeapOwner := J;
  FillMem(RVData^[I], Size + 2, 0);
  If (Data <> 0) And (Size > 0) Then MoveMem(Data, RVData^[I], Size);
  RVSize^[I] := Size;
  RegSetK := 0;
  RegDirty := True;
End;

Procedure RegSetStrK(Root : LongInt; Path, Nm, V : String);
Var K : LongInt;
Begin
  K := RegWalk(Root, Path, True);
  RegSetK(K, Nm, 1, LongInt(@V[1]), Length(V));
  K := RegVal(K, Nm);
  If K >= 0 Then RVSize^[K] := Length(V) + 1;
End;

Procedure RegSetStr(Path, Nm, V : String);
Var K : LongInt;
Begin
  K := RegWalk(2, Path, True);
  RegSetK(K, Nm, 1, LongInt(@V[1]), Length(V));
  { RegSetK met deux zeros apres les donnees : compter le terminateur }
  K := RegVal(K, Nm);
  If K >= 0 Then RVSize^[K] := Length(V) + 1;
End;

{ Valeur chaine Nm de la cle Path (racine Root), '' si absente }
Function RegGetStrK(Root : LongInt; Path, Nm : String) : String;
Var K : LongInt;
Begin
  RegGetStrK := '';
  K := RegWalk(Root, Path, False);
  If K < 0 Then Exit;
  K := RegVal(K, Nm);
  If (K >= 0) And (RVData^[K] <> 0) Then RegGetStrK := PStr(RVData^[K]);
End;

{ Repetition des touches : commande F3h du clavier (delai 0..3, vitesse :
  0 lente .. 31 rapide, comme Windows ; le clavier compte a l'envers) }
Procedure KbTypematic;
Begin
  KbcWaitIn;
  Port[$60] := $F3;
  KbcWaitIn;
  Port[$60] := ((KbDelay And 3) Shl 5) Or (31 - (KbSpeed And 31));
End;

Procedure InputSave;
Begin
  RegSetStrK(1, 'Control Panel\Mouse', 'DoubleClickSpeed', IntStr(DblMs));
  RegSetStrK(1, 'Control Panel\Mouse', 'SwapMouseButtons',
             IntStr(Ord(MouSwap)));
  RegSetStrK(1, 'Control Panel\Mouse', 'MouseSensitivity', IntStr(MouSpd));
  RegSetStrK(1, 'Control Panel\Keyboard', 'KeyboardDelay', IntStr(KbDelay));
  RegSetStrK(1, 'Control Panel\Keyboard', 'KeyboardSpeed', IntStr(KbSpeed));
  RegSaveDue := True;
End;

{ Valeurs du registre au demarrage (souris, clavier, langue) }
Procedure InputRestore;
Var S : String; V, C : LongInt;
Begin
  S := RegGetStrK(1, 'Control Panel\Mouse', 'DoubleClickSpeed');
  Val(S, V, C);
  If (S <> '') And (C = 0) And (V >= 100) Then DblMs := Min(V, 5000);
  MouSwap := RegGetStrK(1, 'Control Panel\Mouse', 'SwapMouseButtons') = '1';
  S := RegGetStrK(1, 'Control Panel\Mouse', 'MouseSensitivity');
  Val(S, V, C);
  If (S <> '') And (C = 0) Then MouSpd := Max(1, Min(V, 20));
  S := RegGetStrK(1, 'Control Panel\Keyboard', 'KeyboardDelay');
  Val(S, V, C);
  If (S <> '') And (C = 0) Then KbDelay := Max(0, Min(V, 3));
  S := RegGetStrK(1, 'Control Panel\Keyboard', 'KeyboardSpeed');
  Val(S, V, C);
  If (S <> '') And (C = 0) Then KbSpeed := Max(0, Min(V, 31));
  KbTypematic;
  { Parametres regionaux : langue de Pasdows (Locale, comme Windows 95) }
  S := UpStr(RegGetStrK(1, 'Control Panel\International', 'Locale'));
  S := Copy(S, Length(S) - 3, 4);
  If (S = '040C') Or (S = '0C0C') Or (S = '080C') Or (S = '100C') Then
    Language := _French
  Else If (S = '0409') Or (S = '0809') Or (S = '1009') Then
    Language := _English
  Else If (S = '0407') Or (S = '0807') Then Language := _Germany
  Else If (S = '0410') Or (S = '0810') Then Language := _Italian
  Else If (S = '040A') Or (S = '0C0A') Then Language := _Spain;
End;

Procedure RegDelTree(K : LongInt);
Var I : LongInt;
Begin
  RegDirty := True;
  For I := 0 To MaxRK - 1 Do
    If RKUsed^[I] And (RKPar^[I] = K) And (I <> K) Then RegDelTree(I);
  For I := 0 To MaxRV - 1 Do
    If RVUsed^[I] And (RVKey^[I] = K) Then
    Begin
      If RVData^[I] <> 0 Then KFree(RVData^[I]);
      RVUsed^[I] := False;
    End;
  If K >= 6 Then RKUsed^[K] := False;
End;

{ bloc du tas systeme mis a zero }
Function RegTab(N : LongInt) : LongInt;
Var A, H : LongInt;
Begin
  H := HeapOwner; HeapOwner := 0;
  A := KAlloc(N);
  HeapOwner := H;
  If A <> 0 Then FillMem(A, N, 0);
  RegTab := A;
End;

{ Liste des peripheriques (Gestionnaire de peripheriques) publiee dans
  HKLM\Enum\Pasdows\nn : Class, DeviceDesc, Mfg, Resources (I E/S, Q
  IRQ, D DMA, M memoire), lue par les Informations systeme }
Procedure RegDevices;
Var I : LongInt; S : String;
Begin
  DevScan;
  For I := 0 To DevN - 1 Do
  Begin
    S := 'Enum\Pasdows\' + Pad2(I);
    RegSetStr(S, 'Class', CatName(DevCat[I]));
    RegSetStr(S, 'DeviceDesc', DevName^[I]);
    RegSetStr(S, 'Mfg', DevMfg^[I]);
    RegSetStr(S, 'Resources', DevRes^[I]);
  End;
  RegSetStr('Enum\Pasdows', 'Count', IntStr(DevN));
End;

Procedure RegInit;
Var I, A : LongInt; S : String;
Begin
  A := RegTab(MaxRK); Move(A, RKUsed, 4);
  A := RegTab(MaxRK * 4); Move(A, RKPar, 4);
  A := RegTab(MaxRK * 4); Move(A, RKNameP, 4);
  A := RegTab(MaxRV); Move(A, RVUsed, 4);
  A := RegTab(MaxRV * 4); Move(A, RVKey, 4);
  A := RegTab(MaxRV * 4); Move(A, RVType, 4);
  A := RegTab(MaxRV * 4); Move(A, RVData, 4);
  A := RegTab(MaxRV * 4); Move(A, RVSize, 4);
  A := RegTab(MaxRV * 4); Move(A, RVNameP, 4);
  For I := 0 To 5 Do
  Begin
    RKUsed^[I] := True; RKPar^[I] := -1; RKNameP^[I] := 0;
  End;
  { classes OLE de base de Windows 95 (inscrites par OLE32 et OLEAUT32
    a l'installation du systeme) : la vraie OLEAUT32 met ces cles a
    jour quand un programme l'inscrit (Office 97) }
  { proxys d'OLE Automation : 00020420 PSDispatch, 21 PSEnumVARIANT,
    22 PSTypeInfo, 23 PSTypeLib, 24 PSAutomation, 25 PSTypeComp }
  For I := 0 To 5 Do
  Begin
    S := 'CLSID\{0002042' + Chr(48 + I) + '-0000-0000-C000-000000000046}';
    Case I Of
      0 : RegSetStrK(0, S, '', 'PSDispatch');
      1 : RegSetStrK(0, S, '', 'PSEnumVARIANT');
      2 : RegSetStrK(0, S, '', 'PSTypeInfo');
      3 : RegSetStrK(0, S, '', 'PSTypeLib');
      4 : RegSetStrK(0, S, '', 'PSAutomation');
      5 : RegSetStrK(0, S, '', 'PSTypeComp');
    End;
    RegSetStrK(0, S + '\InprocServer32', '', 'OLEAUT32.DLL');
    RegSetStrK(0, S + '\InprocServer32', 'ThreadingModel', 'Both');
  End;
  S := 'CLSID\{00000320-0000-0000-C000-000000000046}';
  RegSetStrK(0, S, '', 'PSFactoryBuffer');
  RegSetStrK(0, S + '\InprocServer32', '', 'OLE32.DLL');
  S := 'Interface\{00020400-0000-0000-C000-000000000046}';
  RegSetStrK(0, S, '', 'IDispatch');
  RegSetStrK(0, S + '\ProxyStubClsid32', '',
             '{00020420-0000-0000-C000-000000000046}');
  RegWalk(0, 'TypeLib', True);
  S := 'Software\Microsoft\Windows\CurrentVersion';
  RegSetStr(S, 'ProgramFilesDir', 'C:\Program Files');
  RegSetStr(S, 'CommonFilesDir', 'C:\Program Files\Common Files');
  RegSetStr(S, 'SystemRoot', 'C:\WINDOWS');
  RegSetStr(S, 'Version', 'Windows 95');
  RegSetStr(S, 'VersionNumber', '4.00.950');
  RegSetStr(S, 'ProductName', 'Pasdows 95');
  RegSetStr(S, 'RegisteredOwner', 'Pasdows');
  RegSetStr(S, 'RegisteredOrganization', '');
  RegSetStr(S, 'SourcePath', 'D:\');
  RegSetStr(S, 'DevicePath', 'C:\WINDOWS\INF');
  RegSetStr(S, 'MediaPath', 'C:\WINDOWS\MEDIA');
  RegWalk(2, S + '\App Paths', True);
  RegSetStr('Hardware\Description\System\CentralProcessor\0',
            'ProcessorNameString', CpuName);
  RegSetStr('Hardware\Description\System\CentralProcessor\0',
            '~MHz', IntStr(CpuMhz));
  RegSetStr('Software\Microsoft\DirectX', 'Version', '4.08.00.0400');
  RegSetStr('Software\Microsoft\DirectX', 'InstalledVersion',
            '4.08.00.0400');
  RegWalk(2, S + '\Uninstall', True);
  RegWalk(2, 'System\CurrentControlSet\Control', True);
  RegWalk(1, 'Software\Microsoft\Windows\CurrentVersion\Explorer', True);
  { dossiers speciaux de l'utilisateur (Shell Folders), lus par les
    programmes d'installation pour placer leurs raccourcis }
  For I := 0 To 1 Do
  Begin
    If I = 0 Then S := S + '\Explorer\Shell Folders'
    Else S := 'Software\Microsoft\Windows\CurrentVersion' +
              '\Explorer\User Shell Folders';
    RegSetStrK(1, S, 'Desktop', 'C:\WINDOWS\Desktop');
    RegSetStrK(1, S, 'Programs', 'C:\WINDOWS\Start Menu\Programs');
    RegSetStrK(1, S, 'Start Menu', 'C:\WINDOWS\Start Menu');
    RegSetStrK(1, S, 'Startup', 'C:\WINDOWS\Start Menu\Programs\StartUp');
    RegSetStrK(1, S, 'Personal', 'C:\My Documents');
    RegSetStrK(1, S, 'Favorites', 'C:\WINDOWS\Favorites');
    RegSetStrK(1, S, 'Fonts', 'C:\WINDOWS\Fonts');
    RegSetStrK(1, S, 'Templates', 'C:\WINDOWS\ShellNew');
    RegSetStrK(1, S, 'Recent', 'C:\WINDOWS\Recent');
    RegSetStrK(1, S, 'SendTo', 'C:\WINDOWS\SendTo');
    RegSetStrK(1, S, 'NetHood', 'C:\WINDOWS\NetHood');
    RegSetStrK(1, S, 'AppData', 'C:\WINDOWS\Application Data');
  End;
  S := 'Software\Microsoft\Windows\CurrentVersion';
  RegWalk(1, 'Control Panel\International', True);
  S := 'C:\Program Files' + #0;
  CreateDirectoryA(LongInt(@S[1]), 0);
  S := 'C:\Program Files\Common Files' + #0;
  CreateDirectoryA(LongInt(@S[1]), 0);
  RegDevices;
End;

Function RegOpenKeyA(K, Sub, PR : LongInt) : LongInt;
Var I : LongInt;
Begin
  RegOpenKeyA := 2;
  I := RegKeyOf(K);
  If (I >= 0) And (Sub <> 0) Then I := RegWalk(I, PStr(Sub), False);
  If I < 0 Then Exit;
  If PR <> 0 Then MemL[0:PR] := HKBase + I;
  RegOpenKeyA := 0;
End;

Function RegOpenKeyExA(K, Sub, Opt, Sam, PR : LongInt) : LongInt;
Begin
  RegOpenKeyExA := RegOpenKeyA(K, Sub, PR);
End;

Function RegCreateKeyExA(K, Sub, Res, Cls, Opt, Sam, Sec, PR, PDisp
  : LongInt) : LongInt;
Var I, J : LongInt;
Begin
  RegCreateKeyExA := 2;
  I := RegKeyOf(K);
  If (I >= 0) And (Sub <> 0) Then
  Begin
    J := RegWalk(I, PStr(Sub), False);
    If PDisp <> 0 Then MemL[0:PDisp] := 1 + Ord(J >= 0);
    I := RegWalk(I, PStr(Sub), True);
  End;
  If I < 0 Then Exit;
  If PR <> 0 Then MemL[0:PR] := HKBase + I;
  RegCreateKeyExA := 0;
End;

Function RegCreateKeyA(K, Sub, PR : LongInt) : LongInt;
Begin
  RegCreateKeyA := RegCreateKeyExA(K, Sub, 0, 0, 0, 0, 0, PR, 0);
End;

Function RegCloseKey(K : LongInt) : LongInt;
Begin
  RegCloseKey := 0;
End;

{ RegFlushKey : le registre est ecrit sur le disque (PASDOWS.REG) au
  prochain tour de la boucle du systeme }
Function RegFlushKey(K : LongInt) : LongInt;
Begin
  RegSaveDue := True;
  RegFlushKey := 0;
End;

Function RegDeleteKeyA(K, Sub : LongInt) : LongInt;
Var I : LongInt;
Begin
  RegDeleteKeyA := 2;
  I := RegKeyOf(K);
  If (I >= 0) And (Sub <> 0) Then I := RegWalk(I, PStr(Sub), False);
  If I < 6 Then Exit;
  RegDelTree(I);
  RegDeleteKeyA := 0;
End;

Function RegSetValueExA(K, N, R, T, D, Sz : LongInt) : LongInt;
Var Nm : String;
Begin
  If N = 0 Then Nm := '' Else Nm := PStr(N);
  If (T = 1) Or (T = 2) Then
    If (Sz = 0) And (D <> 0) Then Sz := StrLenZ(D) + 1;
  RegSetValueExA := RegSetK(RegKeyOf(K), Nm, T, D, Sz);
End;

Function RegQueryValueExA(K, N, R, PT, PD, PN : LongInt) : LongInt;
Var I, V : LongInt; Nm : String;
Begin
  RegQueryValueExA := 2;
  I := RegKeyOf(K);
  If I < 0 Then Exit;
  If N = 0 Then Nm := '' Else Nm := PStr(N);
  V := RegVal(I, Nm);
  If V < 0 Then Exit;
  If PT <> 0 Then MemL[0:PT] := RVType^[V];
  RegQueryValueExA := 0;
  If PN = 0 Then Exit;
  If PD <> 0 Then
  Begin
    If MemL[0:PN] < RVSize^[V] Then RegQueryValueExA := 234
    Else
    Begin
      MoveMem(RVData^[V], PD, RVSize^[V]);
      { chaine sans terminateur : en ajouter un s'il y a la place }
      If (RVType^[V] In [1, 2, 7]) And (MemL[0:PN] > RVSize^[V]) Then
        Mem[0:PD + RVSize^[V]] := 0;
    End;
  End;
  MemL[0:PN] := RVSize^[V];
End;

Function RegSetValueA(K, Sub, T, D, Len : LongInt) : LongInt;
Var I : LongInt;
Begin
  RegSetValueA := 2;
  I := RegKeyOf(K);
  If (I >= 0) And (Sub <> 0) Then I := RegWalk(I, PStr(Sub), True);
  If (I < 0) Or (D = 0) Then Exit;
  RegSetValueA := RegSetK(I, '', 1, D, StrLenZ(D) + 1);
End;

Function RegQueryValueA(K, Sub, PD, PN : LongInt) : LongInt;
Var I, V, N : LongInt;
Begin
  RegQueryValueA := 2;
  I := RegKeyOf(K);
  If (I >= 0) And (Sub <> 0) Then I := RegWalk(I, PStr(Sub), False);
  If I < 0 Then Exit;
  V := RegVal(I, '');
  RegQueryValueA := 0;
  If V < 0 Then N := 1 Else N := RVSize^[V];
  If (PD <> 0) And (PN <> 0) Then
  Begin
    If MemL[0:PN] < N Then RegQueryValueA := 234
    Else If V < 0 Then Mem[0:PD] := 0
    Else MoveMem(RVData^[V], PD, N);
  End;
  If PN <> 0 Then MemL[0:PN] := N;
End;

Function RegChildN(K, N : LongInt) : LongInt;
Var I : LongInt;
Begin
  RegChildN := -1;
  For I := 0 To MaxRK - 1 Do
    If RKUsed^[I] And (RKPar^[I] = K) And (I <> K) Then
    Begin
      If N = 0 Then
      Begin
        RegChildN := I;
        Exit;
      End;
      Dec(N);
    End;
End;

Function RegEnumKeyExA(K, N, Buf, PLen, R, Cls, PCls, PFt : LongInt)
  : LongInt;
Var I : LongInt;
Begin
  RegEnumKeyExA := 259;
  I := RegKeyOf(K);
  If I < 0 Then Exit;
  I := RegChildN(I, N);
  If I < 0 Then Exit;
  If PLen <> 0 Then
  Begin
    PutPStr(Buf, RKName(I), MemL[0:PLen]);
    MemL[0:PLen] := Length(RKName(I));
  End;
  RegEnumKeyExA := 0;
End;

Function RegEnumKeyA(K, N, Buf, Len : LongInt) : LongInt;
Var L : LongInt;
Begin
  L := Len;
  RegEnumKeyA := RegEnumKeyExA(K, N, Buf, LongInt(@L), 0, 0, 0, 0);
End;

Function RegEnumValueA(K, N, NBuf, PNLen, R, PT, PD, PDLen : LongInt)
  : LongInt;
Var I, V : LongInt;
Begin
  RegEnumValueA := 259;
  I := RegKeyOf(K);
  If I < 0 Then Exit;
  For V := 0 To MaxRV - 1 Do
    If RVUsed^[V] And (RVKey^[V] = I) Then
    Begin
      If N = 0 Then
      Begin
        If PNLen <> 0 Then
        Begin
          PutPStr(NBuf, RVName(V), MemL[0:PNLen]);
          MemL[0:PNLen] := Length(RVName(V));
        End;
        If PT <> 0 Then MemL[0:PT] := RVType^[V];
        If (PD <> 0) And (PDLen <> 0) Then
          MoveMem(RVData^[V], PD, Min(RVSize^[V], MemL[0:PDLen]));
        If PDLen <> 0 Then MemL[0:PDLen] := RVSize^[V];
        RegEnumValueA := 0;
        Exit;
      End;
      Dec(N);
    End;
End;

{ Programmes de HKLM\...\CurrentVersion\Run, lances au demarrage
  (l'agent du Planificateur de taches, par exemple) }
Procedure RunKeyApps;
Var K, V, I : LongInt; S, P, A : String;
Begin
  K := RegWalk(2, 'Software\Microsoft\Windows\CurrentVersion\Run', False);
  If K < 0 Then Exit;
  For V := 0 To MaxRV - 1 Do
    If RVUsed^[V] And (RVKey^[V] = K) And (RVType^[V] = 1) Then
    Begin
      S := Trim(PStr(RVData^[V]));
      If S = '' Then Continue;
      If S[1] = '"' Then
      Begin
        Delete(S, 1, 1);
        I := Pos('"', S);
        If I = 0 Then I := Length(S) + 1;
      End
      Else
      Begin
        I := Pos(' ', S);
        If I = 0 Then I := Length(S) + 1;
      End;
      P := Copy(S, 1, I - 1);
      A := Trim(Copy(S, I + 1, 255));
      KLog('Run : ' + P + ' ' + A);
      RunExe(P, A);
    End;
End;

Function RegDeleteValueA(K, N : LongInt) : LongInt;
Var I, V : LongInt; Nm : String;
Begin
  RegDeleteValueA := 2;
  I := RegKeyOf(K);
  If I < 0 Then Exit;
  If N = 0 Then Nm := '' Else Nm := PStr(N);
  V := RegVal(I, Nm);
  If V < 0 Then Exit;
  KFree(RVData^[V]);
  RVUsed^[V] := False;
  RegDirty := True;
  RegDeleteValueA := 0;
End;

Function RegQueryInfoKeyA(K, Cls, PCls, R, PSub, PMaxSub, PMaxCls, PVal,
  PMaxVN, PMaxVL, PSec, PFt : LongInt) : LongInt;
Var I, J, NS, NV, MS, MN, ML : LongInt;
Begin
  RegQueryInfoKeyA := 2;
  I := RegKeyOf(K);
  If I < 0 Then Exit;
  NS := 0; NV := 0; MS := 0; MN := 0; ML := 0;
  For J := 0 To MaxRK - 1 Do
    If RKUsed^[J] And (RKPar^[J] = I) And (J <> I) Then
    Begin
      Inc(NS);
      MS := Max(MS, Length(RKName(J)));
    End;
  For J := 0 To MaxRV - 1 Do
    If RVUsed^[J] And (RVKey^[J] = I) Then
    Begin
      Inc(NV);
      MN := Max(MN, Length(RVName(J)));
      ML := Max(ML, RVSize^[J]);
    End;
  If PCls <> 0 Then MemL[0:PCls] := 0;
  If PSub <> 0 Then MemL[0:PSub] := NS;
  If PMaxSub <> 0 Then MemL[0:PMaxSub] := MS;
  If PMaxCls <> 0 Then MemL[0:PMaxCls] := 0;
  If PVal <> 0 Then MemL[0:PVal] := NV;
  If PMaxVN <> 0 Then MemL[0:PMaxVN] := MN;
  If PMaxVL <> 0 Then MemL[0:PMaxVL] := ML;
  If PSec <> 0 Then MemL[0:PSec] := 0;
  If PFt <> 0 Then
  Begin
    MemL[0:PFt] := 0; MemL[0:PFt + 4] := 0;
  End;
  RegQueryInfoKeyA := 0;
End;

{ ==================================================================== }
{ Partie 12 - Chargeur de programmes PE (EXE et DLL Windows 95)        }
{ ==================================================================== }
{ Un programme Win32 est charge a son adresse de base si elle est libre
  (fenetre 00400000h-00FFFFFFh, hors du tas), sinon dans le tas avec
  application des relocalisations (.reloc). Chaque importation est liee
  par son nom a la fonction du meme nom de la table d'exportation de
  VMM32.VXD (quelle que soit la DLL : KERNEL32, USER32, GDI32...) ; une
  fonction absente est liee a une souche qui affiche son nom si elle
  est appelee. Les DLL de l'application (LoadLibrary) sont chargees de
  la meme facon et leurs exportations sont consultees en premier. }

Const
  MaxMod = 64;
  SysDllN = 29;
  SysDlls : Array[0..SysDllN - 1] Of String[12] = ('KERNEL32.DLL',
    'USER32.DLL', 'GDI32.DLL', 'WINMM.DLL', 'COMDLG32.DLL', 'SHELL32.DLL',
    'OLE32.DLL', 'MSVFW32.DLL', 'ADVAPI32.DLL', 'VERSION.DLL',
    'COMCTL32.DLL', 'OLEAUT32.DLL', 'MSVCRT.DLL', 'WSOCK32.DLL',
    'DDRAW.DLL', 'DSOUND.DLL', 'DINPUT.DLL', 'DSETUP.DLL', 'WS2_32.DLL',
    'ICMP.DLL', 'WININET.DLL', 'D3DIM.DLL', 'D3DIM700.DLL', 'D3D8.DLL',
    'DINPUT8.DLL', 'DPLAYX.DLL', 'DPLAY.DLL', 'MSACM32.DLL',
    'OPENGL32.DLL');

Type
  TModule = Record
    Used : Boolean;
    Base, Size, Entry : LongInt;
    Name : String[63];
    Path : String[127];
    IsDll : Boolean;
    PrcId : LongInt;              { processus qui l'a charge }
  End;

Type
  TModArr = Array[0..MaxMod - 1] Of TModule;
  PModArr = ^TModArr;

Var
  Mods      : PModArr;         { alloue dans le tas }
  KExpCount, KExpFuncs, KExpNames, KExpOrds, KBase : LongInt;
  StubArea, StubNext, TraceCount, TraceRetStub : LongInt;
  TraceMax : LongInt;            { appels journalises au plus }
  { APITRACEMOD : modules dont les importations sont journalisees
    (' VBE.DLL FM20.DLL ', vide : tous) ; ImpTrace : module en cours }
  TraceMods : String;
  ImpTrace : Boolean;
  TrRet, TrName : ^TLongArr;               { MaxThread * 32, tas }
  TrDepth : Array[0..MaxThread - 1] Of LongInt;
  TraceSkip : String;

{ Table d'exportation du noyau (son image PE) }
Procedure InitExports;
Var Pe, Dir : LongInt;
Begin
  KBase := MemL[0:BootInfo + $1C];
  Pe := KBase + MemL[0:KBase + $3C];
  Dir := MemL[0:Pe + 24 + 96];
  KExpCount := 0;
  If Dir = 0 Then Exit;
  Dir := KBase + Dir;
  KExpCount := MemL[0:Dir + 24];
  KExpFuncs := KBase + MemL[0:Dir + 28];
  KExpNames := KBase + MemL[0:Dir + 32];
  KExpOrds := KBase + MemL[0:Dir + 36];
  KLog('VMM32 : ' + IntStr(KExpCount) + ' fonctions exportees');
End;

Function MemNameEq(A : LongInt; U : String) : Boolean;
Var I, C : LongInt;
Begin
  MemNameEq := False;
  For I := 1 To Length(U) Do
  Begin
    C := Mem[0:A + I - 1];
    If C <> Ord(U[I]) Then Exit;
  End;
  MemNameEq := Mem[0:A + Length(U)] = 0;
End;

{ Recherche dichotomique (noms tries) d'une exportation exacte }
Function KernelExport(Name : String) : LongInt;
Var Lo, Hi, M, A, I, C1, C2, R : LongInt;
Begin
  KernelExport := 0;
  Lo := 0; Hi := KExpCount - 1;
  While Lo <= Hi Do
  Begin
    M := (Lo + Hi) Div 2;
    A := KBase + MemL[0:KExpNames + M * 4];
    R := 0; I := 1;
    Repeat
      C1 := Mem[0:A + I - 1];
      If I <= Length(Name) Then C2 := Ord(Name[I]) Else C2 := 0;
      If C1 <> C2 Then
      Begin
        If C2 < C1 Then R := -1 Else R := 1;
        Break;
      End;
      Inc(I);
    Until C1 = 0;
    If R = 0 Then
    Begin
      KernelExport := KBase + MemL[0:KExpFuncs + MemW[0:KExpOrds + M * 2] *
                      4];
      Exit;
    End;
    If R < 0 Then Hi := M - 1 Else Lo := M + 1;
  End;
  { sans tenir compte de la casse (noms ecrits autrement en Pascal) }
  Name := UpStr(Name);
  For I := 0 To KExpCount - 1 Do
  Begin
    A := KBase + MemL[0:KExpNames + I * 4];
    If UpStr(PStr(A)) = Name Then
    Begin
      KernelExport := KBase + MemL[0:KExpFuncs + MemW[0:KExpOrds + I * 2] *
                      4];
      Exit;
    End;
  End;
End;

Procedure ApiMissing(Name : LongInt);
Begin
  KLog('API non disponible : ' + PStr(Name));

  MsgBoxOpen('Pasdows', L('La fonction ', 'The function ', 'Die Funktion ',
             'La funzione ', 'La funci'#162'n ') + PStr(Name) +
             L(' n''est pas disponible.', ' is not available.',
             ' ist nicht verf'#129'gbar.', ' non '#138' disponibile.',
             ' no est'#160' disponible.'), $10);
  If (CurT > 0) And Threads[CurT].IsApp Then
  Begin
    KillApp;
    Threads[CurT].State := tsDead;
    KSchedule;
  End;
  HaltCpu;
End;

Procedure MissingApi(Name : LongInt);
Begin
  ApiMissing(Name);
End;

{ Souche d'une fonction absente : push nom / call MissingApi }
{ Place pour une souche de N octets : blocs de 64 Ko alloues au besoin
  (un gros programme comme Office importe des milliers de fonctions) }
Function StubAlloc(N : LongInt) : LongInt;
Var H : LongInt;
Begin
  If (StubArea = 0) Or (StubNext + N > StubArea + 65536) Then
  Begin
    { bloc du systeme : il survit a la fin du programme }
    H := HeapOwner; HeapOwner := 0;
    StubArea := KAlloc(65536);
    HeapOwner := H;
    StubNext := StubArea;
  End;
  StubAlloc := 0;
  If StubArea = 0 Then Exit;
  StubAlloc := StubNext;
  StubNext := (StubNext + N + 15) And Not 15;
End;

Function MakeStub(Dll, Name : String) : LongInt;
Var A : LongInt;
Begin
  A := StubAlloc(16 + Length(Dll) + Length(Name) + 2);
  MakeStub := A;
  If A = 0 Then Exit;
  PutPStr(A + 16, Dll + '!' + Name, 80);
  Mem[0:A] := $68; MemL[0:A + 1] := A + 16;
  Mem[0:A + 5] := $B8; MemL[0:A + 6] := LongInt(@MissingApi);
  Mem[0:A + 10] := $FF; Mem[0:A + 11] := $D0;
  Mem[0:A + 12] := $CC;
End;

{ Trace des appels d'API (journal serie), active par ApiTrace }
Procedure TraceApi(Name : LongInt);
Var F, D, R : LongInt; S : String;
Begin
  If TraceCount < TraceMax Then
  Begin
    Inc(TraceCount);
    asm
      mov eax,ebp
      mov F,eax
    end;
    S := '> ' + PStr(Name) + ' @' + HexStr(MemL[0:F + 44], 8);
    S := S + ' ' + HexStr(MemL[0:F + 48], 8) + ' ' + HexStr(MemL[0:F + 52], 8);
    S := S + ' ' + HexStr(MemL[0:F + 56], 8) + ' ' + HexStr(MemL[0:F + 60], 8);
    { arguments qui pointent sur du texte }
    For D := 0 To 3 Do
    Begin
      R := MemL[0:F + 48 + D * 4];
      If (R >= $10000) And (R < MemTop - 256) And LinOk(R) And
         LinOk(R + 63) Then
        If (Mem[0:R] >= 32) And (Mem[0:R] < 127) And
           ((Mem[0:R + 1] = 0) Or ((Mem[0:R + 1] >= 32) And
           (Mem[0:R + 1] < 127))) Then
          S := S + ' "' + Copy(PStr(R), 1, 50) + '"';
    End;
    KLog(S);
    { detourner le retour vers TraceRetStub (pile fantome par tache) }
    D := TrDepth[CurT];
    If (D < 32) And (TraceRetStub <> 0) Then
    Begin
      TrRet^[CurT * 32 + D] := MemL[0:F + 44];
      TrName^[CurT * 32 + D] := Name;
      TrDepth[CurT] := D + 1;
      MemL[0:F + 44] := TraceRetStub;
    End;
  End;
End;

{ Appelee par TraceRetStub : push 0 / pushad / call TraceRetK / popad / ret }
Procedure TraceRetK;
Var F, D : LongInt;
Begin
  asm
    mov eax,ebp
    mov F,eax
  end;
  D := TrDepth[CurT] - 1;
  If D < 0 Then
  Begin
    KLog('TraceRet : pile fantome vide');
    HaltCpu;
  End;
  TrDepth[CurT] := D;
  MemL[0:F + 40] := TrRet^[CurT * 32 + D];
  KLog('< ' + PStr(TrName^[CurT * 32 + D]) + ' = ' + HexStr(MemL[0:F + 36], 8));
End;

Procedure TraceInit;
Var A : LongInt;
Begin
  A := KAlloc(32);
  Mem[0:A] := $6A; Mem[0:A + 1] := 0;
  Mem[0:A + 2] := $60;
  Mem[0:A + 3] := $B8; MemL[0:A + 4] := LongInt(@TraceRetK);
  Mem[0:A + 8] := $FF; Mem[0:A + 9] := $D0;
  Mem[0:A + 10] := $61;
  Mem[0:A + 11] := $C3;
  TraceRetStub := A;
  TraceSkip := ' SETFILEPOINTER ISBADREADPTR GETTICKCOUNT TIMEGETTIME ';
  TraceSkip := TraceSkip + 'GETASYNCKEYSTATE PEEKMESSAGEA SCREENTOCLIENT ';
  TraceSkip := TraceSkip + 'GETCURSORPOS ISBADWRITEPTR LSTRCMPIA ';
  TraceSkip := TraceSkip + 'GETDEVICECAPS CHARNEXTA CHARPREVA ISDBCSLEADBYTE ';
  TraceSkip := TraceSkip + 'LSTRLENA LSTRCMPA ';
End;

Function MakeTrace(Dll, Name : String; Target : LongInt) : LongInt;
Var A : LongInt;
Begin
  A := StubAlloc(32 + Length(Dll) + Length(Name) + 2);
  If A = 0 Then
  Begin
    MakeTrace := Target;
    Exit;
  End;
  PutPStr(A + 32, Dll + '!' + Name, 80);
  Mem[0:A] := $60;
  Mem[0:A + 1] := $68; MemL[0:A + 2] := A + 32;
  Mem[0:A + 6] := $B8; MemL[0:A + 7] := LongInt(@TraceApi);
  Mem[0:A + 11] := $FF; Mem[0:A + 12] := $D0;
  Mem[0:A + 13] := $83; Mem[0:A + 14] := $C4; Mem[0:A + 15] := 4;
  Mem[0:A + 16] := $61;
  Mem[0:A + 17] := $B8; MemL[0:A + 18] := Target;
  Mem[0:A + 22] := $FF; Mem[0:A + 23] := $E0;
  MakeTrace := A;
End;

{ vraie OLEAUT32.DLL dans C:\WINDOWS\SYSTEM (verifie au plus toutes les
  2 secondes : un programme d'installation peut la copier) }
Var
  OleAutChk, OleAutT : LongInt;

Function RealOleAut : Boolean;
Var Attr, Size, Time, Lba, Ram : LongInt;
Begin
  If (OleAutChk = 0) Or (Ticks - OleAutT > 2000) Then
  Begin
    OleAutT := Ticks;
    If PathInfo('C:\WINDOWS\SYSTEM\OLEAUT32.DLL', Attr, Size, Time, Lba,
                Ram) And (Size > 100000) Then OleAutChk := 2
    Else OleAutChk := 1;
  End;
  RealOleAut := OleAutChk = 2;
End;

Function IsSysDll(Name : String) : Boolean;
Var I : LongInt; R : Boolean;
Begin
  R := False;
  Name := UpStr(BaseName(Name));
  If Pos('.', Name) = 0 Then Name := Name + '.DLL';
  For I := 0 To SysDllN - 1 Do
    If SysDlls[I] = Name Then R := True;
  { OLE Automation : la vraie OLEAUT32.DLL (installee par Office 97,
    Visual Basic...) remplace la version minimale du noyau }
  If R And (Name = 'OLEAUT32.DLL') And RealOleAut Then R := False;
  IsSysDll := R;
End;

Function FindModule(Name : String) : LongInt;
Var I : LongInt;
Begin
  FindModule := -1;
  Name := UpStr(BaseName(Name));
  If Pos('.', Name) = 0 Then Name := Name + '.DLL';
  For I := 0 To MaxMod - 1 Do
    If Mods^[I].Used And (Mods^[I].Name = Name) And
       (Mods^[I].PrcId = CurProc) Then
    Begin
      FindModule := I;
      Exit;
    End;
End;

Function ModOfBase(B : LongInt) : LongInt;
Var I : LongInt;
Begin
  ModOfBase := -1;
  For I := 0 To MaxMod - 1 Do
    If Mods^[I].Used And (Mods^[I].Base = B) Then
    Begin
      ModOfBase := I;
      If Mods^[I].PrcId = CurProc Then Exit;
    End;
End;

{ Exportation d'un module charge (par nom, ou par ordinal si Name='') }
Function ModuleExport(M : LongInt; Name : String; Ordinal : LongInt)
  : LongInt;
Var Pe, Dir, N, Funcs, Names, Ords, I, B : LongInt;
Begin
  ModuleExport := 0;
  If (M < 0) Or Not Mods^[M].Used Then Exit;
  B := Mods^[M].Base;
  Pe := B + MemL[0:B + $3C];
  Dir := MemL[0:Pe + 24 + 96];
  If Dir = 0 Then Exit;
  Dir := B + Dir;
  Funcs := B + MemL[0:Dir + 28];
  If Name = '' Then
  Begin
    I := Ordinal - MemL[0:Dir + 16];
    If (I >= 0) And (I < MemL[0:Dir + 20]) And (MemL[0:Funcs + I * 4] <> 0)
    Then ModuleExport := B + MemL[0:Funcs + I * 4];
    Exit;
  End;
  N := MemL[0:Dir + 24];
  Names := B + MemL[0:Dir + 32];
  Ords := B + MemL[0:Dir + 36];
  For I := 0 To N - 1 Do
    If MemNameEq(B + MemL[0:Names + I * 4], Name) Then
    Begin
      ModuleExport := B + MemL[0:Funcs + MemW[0:Ords + I * 2] * 4];
      Exit;
    End;
End;

Function LoadPE(Path : String; IsDll : Boolean) : LongInt; Forward;

{ MSVFW32 : version de Video pour Windows (1.10) }
Function VideoForWindowsVersion : LongInt;
Begin
  VideoForWindowsVersion := $010A0000;
End;

Function IsWsDll(Dll : String) : Boolean; Forward;
Function WsOrdName(N : LongInt) : String; Forward;
Procedure NetAppExit; Forward;

Procedure DXAppDone; Forward;
Procedure GlProcDone(P : LongInt); Forward;
Function DXOrdName(Dll : String; N : LongInt) : String; Forward;
Function OleOrdName(N : LongInt) : String; Forward;

Function ResolveImport(Dll, Name : String; Ordinal : LongInt) : LongInt;
Var M, A : LongInt; Nm : String;
Begin
  A := 0;
  { Winsock : fonctions WS_nom du noyau (par nom ou par ordinal) }
  If IsWsDll(Dll) Then
  Begin
    If Name = '' Then Name := WsOrdName(Ordinal);
    If Name <> '' Then A := KernelExport('WS_' + Name);
  End;
  { importations par ordinal des DLL systeme connues }
  If (Name = '') Then Name := DXOrdName(Dll, Ordinal);
  If (Name = '') And (UpStr(BaseName(Dll)) = 'MSVFW32.DLL') And
     (Ordinal = 2) Then Name := 'VideoForWindowsVersion';
  If (Name = '') And (UpStr(BaseName(Dll)) = 'COMCTL32.DLL') And
     (Ordinal = 17) Then Name := 'InitCommonControls';
  If (Name = '') And (UpStr(BaseName(Dll)) = 'OLEAUT32.DLL') And
     Not RealOleAut Then Name := OleOrdName(Ordinal);
  If (A = 0) And Not IsSysDll(Dll) Then
  Begin
    M := FindModule(Dll);
    If M < 0 Then M := LoadPE(Dll, True);
    If M >= 0 Then A := ModuleExport(M, Name, Ordinal);
  End;
  If (A = 0) And (Name <> '') Then A := KernelExport(Name);
  If (A = 0) And (Length(Name) > 1) And (Name[1] = '_') Then
    A := KernelExport(Copy(Name, 2, 255));
  If A = 0 Then
  Begin
    If Name = '' Then Name := '#' + IntStr(Ordinal);
    KLog('  importation absente : ' + Dll + '!' + Name);
    A := MakeStub(Dll, Name);
  End;
  If ApiTrace And ImpTrace Then
  Begin
    Nm := ' ' + UpStr(Name) + ' ';
    If Pos(Nm, TraceSkip) = 0 Then A := MakeTrace(Dll, Name, A);
  End;
  ResolveImport := A;
End;

{ Chercher un fichier de module : chemin donne, D:\, C:\WINDOWS }
{ Fichier programme Name dans le dossier D (termine par \) ; '' si
  absent. Sans extension : NOM.EXE, NOM.COM, puis NOM }
Function FindInDir(Const D, Name : String) : String;
Var Attr, Size, Time, Lba, Ram : LongInt; B, S, R : String;
Begin
  R := '';
  B := UpStr(BaseName(Name));
  If Pos('.', B) = 0 Then
  Begin
    S := D + B + '.EXE';
    If PathInfo(S, Attr, Size, Time, Lba, Ram) Then R := S;
    If R = '' Then
    Begin
      S := D + B + '.COM';
      If PathInfo(S, Attr, Size, Time, Lba, Ram) Then R := S;
    End;
  End;
  If R = '' Then
  Begin
    S := D + B;
    If PathInfo(S, Attr, Size, Time, Lba, Ram) And
       ((Attr And $10) = 0) Then R := S;
  End;
  FindInDir := R;
End;

Function FindModuleFile(Name : String) : String;
Var Attr, Size, Time, Lba, Ram, Ev, K : LongInt; S, R, D : String;
Begin
  { resultat dans R, affecte une seule fois a la fin }
  R := '';
  S := FullPath(Name);
  If (Pos('.', BaseName(Name)) > 0) And
     PathInfo(S, Attr, Size, Time, Lba, Ram) Then R := S;
  If (R = '') And (Pos('.', BaseName(Name)) = 0) Then
  Begin
    { NOM sans extension : NOM.EXE, NOM.COM, puis NOM (comme MS-DOS,
      README lance README.COM et non le fichier texte README) }
    S := FullPath(Name + '.EXE');
    If PathInfo(S, Attr, Size, Time, Lba, Ram) Then R := S;
    If R = '' Then
    Begin
      S := FullPath(Name + '.COM');
      If PathInfo(S, Attr, Size, Time, Lba, Ram) Then R := S;
    End;
    If R = '' Then
    Begin
      S := FullPath(Name);
      If PathInfo(S, Attr, Size, Time, Lba, Ram) And
         ((Attr And $10) = 0) Then R := S;
    End;
  End;
  { dossier du programme en cours (comme Windows : une DLL est cherchee
    d'abord a cote de l'EXE qui la charge) }
  If (R = '') And (Pos('\', Name) = 0) And (Pos(':', Name) = 0) And
     (CurProc > 0) Then
  Begin
    S := AppPath;
    While (S <> '') And (S[Length(S)] <> '\') Do Delete(S, Length(S), 1);
    If S <> '' Then R := FindInDir(S, Name);
  End;
  { dossier systeme, racine de C:, puis CD-ROM (D:) ; sans extension :
    NOM.EXE puis NOM.COM ("dxdiag" dans la boite Executer) }
  { dossier systeme de Windows (C:\WINDOWS\SYSTEM), puis C:\WINDOWS }
  If (R = '') And (SysDir = 'C:\WINDOWS\') And (Pos('\', Name) = 0) Then
    R := FindInDir('C:\WINDOWS\SYSTEM\', Name);
  If R = '' Then R := FindInDir(SysDir, Name);
  { commandes externes (C:\WINDOWS\COMMAND, ou D:\COMMAND sur le CD) }
  If (R = '') And (Pos('\', Name) = 0) Then
    R := FindInDir(SysDir + 'COMMAND\', Name);
  If (R = '') And (SysDir <> 'C:\') Then R := FindInDir('C:\', Name);
  If (R = '') And (SysDir <> 'D:\') Then R := FindInDir('D:\', Name);
  { dossiers de la variable PATH }
  If (R = '') And (Pos('\', Name) = 0) And (Pos(':', Name) = 0) And
     EnvFind('PATH', Ev) Then
  Begin
    S := PStr(Ev);
    While (R = '') And (S <> '') Do
    Begin
      K := Pos(';', S);
      If K = 0 Then K := Length(S) + 1;
      D := Copy(S, 1, K - 1);
      Delete(S, 1, K);
      If (D <> '') And (D[Length(D)] <> '\') Then D := D + '\';
      If D <> '' Then R := FindInDir(D, Name);
    End;
  End;
  FindModuleFile := R;
End;

{ Charger un EXE ou une DLL ; indice du module ou -1 }
{ Placer l'image d'un programme a son adresse preferee dans la fenetre
  des images : en identite si elle est libre, sinon dans des pages du tas
  mises a cette adresse dans un repertoire de pages propre au processus
  courant (charge aussitot : le chargeur ecrit a l'adresse de l'image) }
Function ProcMapImage(Base, Size : LongInt) : Boolean;
Var P, Pd, Pt, Img, N, I, A, Blk : LongInt;
Begin
  ProcMapImage := False;
  P := CurProc;
  If (P <= 0) Or Not Procs^[P].Used Then Exit;
  If (WinProc < 0) Or (WinProc = P) Then
  Begin
    WinProc := P; Procs^[P].Pd := 0;
    ProcMapImage := True;
    Exit;
  End;
  If KPd = 0 Then Exit;
  N := (ExeTop - $400000) Shr 22;
  Blk := KAlloc(4096 * (N + 2));
  Img := KAlloc(Size + 4096);
  If (Blk = 0) Or (Img = 0) Then Exit;
  Pd := (Blk + 4095) And Not 4095;
  Pt := Pd + 4096;
  MoveMem(KPd, Pd, 4096);
  FillMem(Pt, N * 4096, 0);
  For I := 0 To N - 1 Do MemL[0:Pd + (1 + I) * 4] := (Pt + I * 4096) Or 7;
  Img := (Img + 4095) And Not 4095;
  For I := 0 To (Size + 4095) Div 4096 - 1 Do
  Begin
    A := Base + I * 4096 - $400000;
    MemL[0:Pt + (A Shr 12) * 4] := (Img + I * 4096) Or 7;
  End;
  Procs^[P].Pd := Pd;
  SetCr3(Pd);
  KLog('  image privee ' + HexStr(Base, 8) + ' -> ' + HexStr(Img, 8));
  ProcMapImage := True;
End;

Function PagingInit : Boolean; Forward;

{ Placer l'image d'un programme a une adresse haute, au-dessus de la
  memoire (WINWORD.EXE et EXCEL.EXE : 30000000h, sans relocalisations) :
  pages du tas mises a cette adresse par des tables de pages de 4 Ko dans
  un repertoire de pages propre au processus (copie de celui du noyau,
  qui ne projette rien d'utile a ces adresses) }
Function ProcMapHigh(Base, Size : LongInt) : Boolean;
Var P, Pd, Pt, Img, I, A, Blk, First, Last : LongInt;
Begin
  ProcMapHigh := False;
  P := CurProc;
  If (P <= 0) Or Not Procs^[P].Used Or (Procs^[P].Pd <> 0) Then Exit;
  If (Base And 4095) <> 0 Then Exit;
  If Not PagingInit Then Exit;
  First := Base Shr 22;
  Last := (Base + Size - 1) Shr 22;
  Blk := KAlloc(4096 * (Last - First + 3));
  Img := KAlloc(Size + 4096);
  If (Blk = 0) Or (Img = 0) Then
  Begin
    If Blk <> 0 Then KFree(Blk);
    If Img <> 0 Then KFree(Img);
    Exit;
  End;
  Pd := (Blk + 4095) And Not 4095;
  Pt := Pd + 4096;
  MoveMem(KPd, Pd, 4096);
  FillMem(Pt, (Last - First + 1) * 4096, 0);
  For I := First To Last Do
    MemL[0:Pd + I * 4] := (Pt + (I - First) * 4096) Or 7;
  Img := (Img + 4095) And Not 4095;
  For I := 0 To (Size + 4095) Div 4096 - 1 Do
  Begin
    A := Base + I * 4096 - (First Shl 22);
    MemL[0:Pt + (A Shr 12) * 4] := (Img + I * 4096) Or 7;
  End;
  Procs^[P].Pd := Pd;
  SetCr3(Pd);
  KLog('  image haute ' + HexStr(Base, 8) + ' -> ' + HexStr(Img, 8));
  ProcMapHigh := True;
End;

{ Correctifs de compatibilite du code d'un programme (comme les
  correctifs d'application de Windows). Les programmes Win32 tournent ici
  en anneau 0 : une interruption empile sur la pile du programme, juste
  sous ESP. Sous Windows (anneau 3), elle utilise la pile du noyau, ce
  qui cache certains bogues. Ainsi la conversion flottant -> entier de la
  bibliotheque CodeWarrior (Oni) commence par "add esp,0F4h" au lieu de
  "add esp,-0Ch" : ESP remonte de 244 octets au-dessus de son cadre, et
  l'horloge ecrasait les variables et l'adresse de retour de l'appelant.
  Le code est corrige en "add esp,-0Ch" (meme longueur). }
Procedure PeCompat(Load, Pe : LongInt);
Var S, I, A, E, N : LongInt;
Begin
  N := 0;
  S := Pe + 24 + MemW[0:Pe + 20];
  For I := 0 To MemW[0:Pe + 6] - 1 Do
  Begin
    If (MemL[0:S + 36] And $20000020) <> 0 Then
    Begin
      A := Load + MemL[0:S + 12];
      E := A + MemL[0:S + 8] - 14;
      While A <= E Do
      Begin
        If (MemL[0:A] = LongInt($81EC8B55)) And
           (MemL[0:A + 4] = $0000F4C4) And
           (MemL[0:A + 8] = LongInt($7DD99B00)) And
           (MemW[0:A + 12] = $9BFE) Then
        Begin
          MemW[0:A + 6] := $FFFF; Mem[0:A + 8] := $FF;
          Inc(N);
        End;
        Inc(A);
      End;
    End;
    S := S + 40;
  End;
  If N > 0 Then
    KLog('  correctif de compatibilite : add esp,0F4h (' + IntStr(N) +
         ' fois)');
End;

Function LoadPE(Path : String; IsDll : Boolean) : LongInt;
Var F, FSize, Pe, NSect, OptSz, Base, ImgSize, HdrSize, Load, I, S, VSize,
    VAddr, RawSize, RawPtr, Delta, Dir, DSize, P, PEnd, Cnt, K, T, Ent,
    Imp, NameRva, Thunk, IAT, V, M : LongInt; Dll, Nm : String;
Begin
  LoadPE := -1;
  M := FindModule(Path);
  If M >= 0 Then
  Begin
    LoadPE := M;
    Exit;
  End;
  Path := FindModuleFile(Path);
  If Path = '' Then Exit;
  { les DLL d'un programme sont cherchees d'abord dans son dossier, des
    la resolution de ses importations }
  If Not IsDll And (CurProc > 0) Then AppPath := Path;
  F := LoadWholeFile(Path, FSize);
  If F = 0 Then Exit;
  KLog('Chargement de ' + Path + ' (' + IntStr(FSize) + ' octets)');
  If MemW[0:F] <> $5A4D Then
  Begin
    KFree(F);
    Exit;
  End;
  Pe := F + MemL[0:F + $3C];
  If (MemL[0:Pe] <> $4550) Or (MemW[0:Pe + 4] <> $014C) Then
  Begin
    KLog('  pas une image PE 80386');
    KFree(F);
    Exit;
  End;
  NSect := MemW[0:Pe + 6];
  OptSz := MemW[0:Pe + 20];
  Base := MemL[0:Pe + 24 + 28];
  ImgSize := MemL[0:Pe + 24 + 56];
  HdrSize := MemL[0:Pe + 24 + 60];
  { adresse de chargement : un programme a son adresse preferee, dans
    la fenetre des images du processus }
  If Not IsDll And (Base >= $00400000) And (Base + ImgSize <= ExeTop) And
     ProcMapImage(Base, ImgSize) Then
    Load := Base
  Else If Not IsDll And (Base >= MemTop) And (Base >= ExeTop) And
     (Base + ImgSize > Base) And ProcMapHigh(Base, ImgSize) Then
    Load := Base
  Else
  Begin
    Load := KAlloc(ImgSize + 65536);
    If Load = 0 Then
    Begin
      KFree(F);
      Exit;
    End;
    Load := (Load + 65535) And Not 65535;
  End;
  FillMem(Load, ImgSize, 0);
  MoveMem(F, Load, Min(HdrSize, FSize));
  S := Pe + 24 + OptSz;
  For I := 0 To NSect - 1 Do
  Begin
    VSize := MemL[0:S + 8]; VAddr := MemL[0:S + 12];
    RawSize := MemL[0:S + 16]; RawPtr := MemL[0:S + 20];
    If (VSize = 0) Or (RawSize < VSize) Then VSize := RawSize;
    { sans donnees dans le fichier (PointerToRawData = 0, comme la
      section .bss de certains editeurs de liens) : la section reste a
      zero, comme sous Windows }
    If (RawSize > 0) And (RawPtr > 0) And (RawPtr + VSize <= FSize) Then
      MoveMem(F + RawPtr, Load + VAddr, Min(VSize, RawSize));
    S := S + 40;
  End;
  KFree(F);
  Pe := Load + MemL[0:Load + $3C];
  { relocalisations }
  Delta := Load - Base;
  If Delta <> 0 Then
  Begin
    Dir := MemL[0:Pe + 24 + 136]; DSize := MemL[0:Pe + 24 + 140];
    If Dir = 0 Then KLog('  pas de relocalisations : chargement a ' +
                         HexStr(Load, 8));
    P := Load + Dir; PEnd := P + DSize;
    While (Dir <> 0) And (P < PEnd) And (MemL[0:P + 4] > 0) Do
    Begin
      Cnt := (MemL[0:P + 4] - 8) Div 2;
      For K := 0 To Cnt - 1 Do
      Begin
        T := MemW[0:P + 8 + K * 2];
        If (T Shr 12) = 3 Then
        Begin
          V := Load + MemL[0:P] + (T And $FFF);
          MemL[0:V] := MemL[0:V] + Delta;
        End;
      End;
      P := P + MemL[0:P + 4];
    End;
    MemL[0:Pe + 24 + 28] := Load;
  End;
  PeCompat(Load, Pe);
  { module }
  M := -1;
  For I := 0 To MaxMod - 1 Do
    If Not Mods^[I].Used Then
    Begin
      M := I;
      Break;
    End;
  If M < 0 Then Exit;
  Mods^[M].Used := True; Mods^[M].Base := Load; Mods^[M].Size := ImgSize;
  Mods^[M].Entry := MemL[0:Pe + 24 + 16];
  If Mods^[M].Entry <> 0 Then Mods^[M].Entry := Load + Mods^[M].Entry;
  Mods^[M].Name := UpStr(BaseName(Path));
  Mods^[M].Path := Path;
  Mods^[M].IsDll := IsDll;
  Mods^[M].PrcId := CurProc;
  { GetModuleHandle(NULL) des DLL initialisees pendant le chargement du
    programme (WWINTL32.DLL cherche les exportations de WINWORD.EXE) }
  If Not IsDll And (CurProc > 0) Then
  Begin
    AppBase := Load;
    AppSize := ImgSize;
  End;
  { importations (journalisees si le module est dans APITRACEMOD) }
  ImpTrace := (TraceMods = '') Or
              (Pos(' ' + Mods^[M].Name + ' ', TraceMods) > 0);
  Dir := MemL[0:Pe + 24 + 104];
  If Dir <> 0 Then
  Begin
    Imp := Load + Dir;
    While MemL[0:Imp + 12] <> 0 Do
    Begin
      NameRva := MemL[0:Imp + 12];
      Dll := UpStr(PStr(Load + NameRva));
      Thunk := MemL[0:Imp];
      IAT := Load + MemL[0:Imp + 16];
      If Thunk = 0 Then Thunk := MemL[0:Imp + 16];
      Thunk := Load + Thunk;
      Ent := 0;
      While MemL[0:Thunk + Ent * 4] <> 0 Do
      Begin
        V := MemL[0:Thunk + Ent * 4];
        If V < 0 Then
          MemL[0:IAT + Ent * 4] := ResolveImport(Dll, '', V And $FFFF)
        Else
        Begin
          Nm := PStr(Load + V + 2);
          MemL[0:IAT + Ent * 4] := ResolveImport(Dll, Nm, 0);
        End;
        Inc(Ent);
      End;
      Imp := Imp + 20;
    End;
  End;
  KLog('  module ' + Mods^[M].Name + ' a ' + HexStr(Load, 8) + ' point ' +
       HexStr(Mods^[M].Entry, 8));
  { DllMain(hinst, DLL_PROCESS_ATTACH, 0) }
  If IsDll And (Mods^[M].Entry <> 0) Then
  Begin
    V := Mods^[M].Entry;
    asm
      push 0
      push 1
      mov eax,Load
      push eax
      mov eax,V
      call eax
    end;
  End;
  LoadPE := M;
End;

