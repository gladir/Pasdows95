{ entree de la texture liee a l'unite active (creee au besoin) }
Function GlBoundEnt : LongInt;
Var E : LongInt;
Begin
  GlBoundEnt := 0;
  If Not GlOk Then Exit;
  E := GlTexEnt(Gc^.S.Bound[Gc^.S.ActTex]);
  If E = 0 Then Exit;
  If MemL[0:E] <> 1 Then
  Begin
    MemL[0:E] := 1;
    MemL[0:E + 16] := $2901; MemL[0:E + 20] := $2901;
  End;
  GlBoundEnt := E;
End;

