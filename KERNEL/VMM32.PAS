  MemL[0:B + 32] := 22050;
  If Fmt <> 0 Then
  Begin
    MoveMem(Fmt, B + 40, 18);
    If MemL[0:Fmt + 8] > 0 Then MemL[0:B + 32] := MemL[0:Fmt + 8];
    MemL[0:B + 68] := MemL[0:Fmt + 4];
