    End;
    2037 : SetAX(SetWindowTextA(A(1), Lin16(A(2))));
    2038 : SetAX(GetWindowTextLengthA(A(1)));
    2039 :
    Begin
      R := BeginPaint(A(1), W16Buf);
      P := A(2);
      FillMem(P, 32, 0);
      MemW[0:P] := R;
      MemW[0:P + 2] := MemL[0:W16Buf + 4];
      Rect32To16(W16Buf + 8, P + 4);
      SetAX(R);
