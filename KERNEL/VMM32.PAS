End;

{ Profondeurs disponibles : VGA 16 couleurs, puis celles des modes VESA }
Procedure DispDepths;
Var K, I, B : LongInt; Found : Boolean;
Begin
  DepN := 1; DepBpp[0] := 4;
  For K := 0 To 4 Do
  Begin
    Case K Of
      0 : B := 8; 1 : B := 15; 2 : B := 16; 3 : B := 24;
    Else
      B := 32;
    End;
    Found := False;
    For I := 0 To VmN - 1 Do If VmBpp[I] = B Then Found := True;
    If Found Then
    Begin
      DepBpp[DepN] := B;
      Inc(DepN);
    End;
  End;
End;

{ Resolutions de la profondeur B, de la plus petite a la plus grande }
Procedure DispRes(B : LongInt);
Var I, J : LongInt; Dup : Boolean;
Begin
  ResN := 0;
  If B = 4 Then
  Begin
    ResW[0] := 640; ResH[0] := 480; ResN := 1;
    Exit;
  End;
  For I := 0 To VmN - 1 Do
    If VmBpp[I] = B Then
    Begin
      Dup := False;
      For J := 0 To ResN - 1 Do
        If (ResW[J] = VmW[I]) And (ResH[J] = VmH[I]) Then Dup := True;
      If Not Dup Then
      Begin
        J := ResN;
        While (J > 0) And (ResW[J - 1] * ResH[J - 1] > VmW[I] * VmH[I]) Do
        Begin
          ResW[J] := ResW[J - 1]; ResH[J] := ResH[J - 1];
          Dec(J);
        End;
        ResW[J] := VmW[I]; ResH[J] := VmH[I];
        Inc(ResN);
      End;
    End;
  If ResN = 0 Then
  Begin
    ResW[0] := 640; ResH[0] := 480; ResN := 1;
  End;
End;

{ Lettres libres pour un lecteur reseau (menu de la boite Connecter) :
  les 12 dernieres jusqu'a Z: (les fleches parcourent toutes les lettres) }
Function NetLetAt(K : LongInt) : Char;
Var Ch : Char; F : LongInt;
Begin
  NetLetAt := #0;
  F := 0;
  For Ch := 'E' To 'Z' Do
    If NetLetterFree(Ch) Then Inc(F);
  If F > 12 Then K := K + F - 12;
  For Ch := 'E' To 'Z' Do
    If NetLetterFree(Ch) Then
    Begin
      If K = 0 Then
      Begin
        NetLetAt := Ch;
        Exit;
      End;
      Dec(K);
    End;
End;

Function NetLetCount : LongInt;
Var K : LongInt;
Begin
  K := 0;
  While (K < 12) And (NetLetAt(K) <> #0) Do Inc(K);
  NetLetCount := K;
End;

{ menu de l'icone de la Corbeille (bureau) }
Function IconRecycle : Boolean;
Begin
  IconRecycle := (NewWin < 0) And (DeskSel >= 0) And
                 (DeskCmd[DeskSel] = cmRecycle);
End;

{ menu de l'icone du Poste de travail (bureau) }
Function IconComp : Boolean;
Begin
  IconComp := (NewWin < 0) And (DeskSel >= 0) And
              (DeskCmd[DeskSel] = cmComputer);
End;

Function MenuCount(M : LongInt) : LongInt;
Var N : LongInt; S : String; L : Array[0..63] Of LongInt;
Begin
  If M >= mnW32 Then
  Begin
    MenuCount := MItemList(M - mnW32, L);
    Exit;
  End;
  Case M Of
    mnStart : MenuCount := 9;
    mnFind : MenuCount := 2;
    mnTools : MenuCount := 6 + KnownCount('S');
    mnPrograms : MenuCount := 5 + ExeCnt;
    mnAccess : MenuCount := 11;
    mnComm : MenuCount := 1;
    mnDevKit : MenuCount := 5;
    mnGames : MenuCount := 3;
    mnMedia : MenuCount := 3 + KnownCount('M');
    mnInet : MenuCount := 5 + KnownCount('I');
    mnSettings : MenuCount := 10;
    mnMonths : MenuCount := 12;
    mnVolCtx : MenuCount := 2;
    mnTaskCtx : MenuCount := 2;
    mnDrvCtx : MenuCount := 5;
    mnNetLet : MenuCount := NetLetCount;
    mnMyComp : MenuCount := 4;
    mnTreeCtx : If CtxTreeComp Then MenuCount := 7 Else MenuCount := 4;
    mnConSys : MenuCount := 5;
    mnConEdit : MenuCount := 6;
    mnSysGen : MenuCount := 5;
    mnNFile : MenuCount := 9;
    mnNEdit : MenuCount := 10;
    mnNSearch : MenuCount := 2;
    mnNHelp : MenuCount := 3;
    mnFdDrives : MenuCount := FdDriveCount;
    mnFdTypes : MenuCount := FdFiltN;
    mnTz : MenuCount := TzCount;
    mnDesk : MenuCount := 9;
    mnArrange : MenuCount := 2;
    mnColors : MenuCount := DepN;
    mnIcon :
      If IconComp Then MenuCount := 6
      Else If IconRecycle Then MenuCount := 4
      Else MenuCount := 12;
    mnNew : MenuCount := 5;
    mnExpCtx : MenuCount := 8;
    mnDocs :
    Begin
      N := 0;
      While (N < 10) And DocFile(N, S) Do Inc(N);
      If N = 0 Then N := 1;
      MenuCount := N;
    End;
  Else
    MenuCount := 0;
  End;
End;

Procedure MenuItem(M, I : LongInt; Var T : String;
                   Var Cmd, Sub, Icon : LongInt);
Var K, F : LongInt;
Begin
  T := '-'; Cmd := cmNone; Sub := 0; Icon := 0;
  If M >= mnW32 Then
  Begin
    K := MItemAt(M - mnW32, I);
    If K < 0 Then Exit;
    F := MItemsP^[K].Flags;
    If (F And MF_SEPARATOR) <> 0 Then Exit;
    T := MText(K);
    If (T = '') Or (T = '-') Then T := ' ';
    If (F And 3) <> 0 Then Cmd := cmGray Else Cmd := cmW32Base + K;
    If (F And MF_POPUP) <> 0 Then
    Begin
      Sub := MenuIdx(MItemsP^[K].Id);
      If Sub >= 0 Then Sub := mnW32 + Sub Else Sub := 0;
    End;
    Exit;
  End;
  Case M Of
    mnStart :
      Case I Of
        0 : Begin
              T := L('Programmes', 'Programs', 'Programme', 'Programmi',
                     'Programas');
              Sub := mnPrograms; Icon := icPrograms;
            End;
        1 : Begin
              T := L('Documents', 'Documents', 'Dokumente', 'Documenti',
                     'Documentos');
              Sub := mnDocs; Icon := icDocs;
            End;
        2 : Begin
              T := L('Param'#138'tres', 'Settings', 'Einstellungen',
                     'Impostazioni', 'Configuraci'#162'n');
              Sub := mnSettings; Icon := icSettings;
            End;
        3 : Begin
              T := L('Rechercher', 'Find', 'Suchen', 'Trova', 'Buscar');
              Sub := mnFind; Icon := icFind;
            End;
        4 : Begin
              T := L('Aide', 'Help', 'Hilfe', 'Guida', 'Ayuda');
              Cmd := cmHelp; Icon := icHelp;
            End;
