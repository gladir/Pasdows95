Procedure glPushMatrix;
Begin
  GlTr(90);
  If Not GlOk Then Exit;
  Case Gc^.MMode Of
    $1701 :
      If Gc^.PRTop < 3 Then
      Begin
        Gc^.PR[Gc^.PRTop + 1] := Gc^.PR[Gc^.PRTop]; Inc(Gc^.PRTop);
      End
      Else GlErr($503);
    $1702 :
      If Gc^.TXTop < 3 Then
      Begin
        Gc^.TX[Gc^.TXTop + 1] := Gc^.TX[Gc^.TXTop]; Inc(Gc^.TXTop);
      End
      Else GlErr($503);
  Else
    If Gc^.MVTop < 31 Then
    Begin
      Gc^.MV[Gc^.MVTop + 1] := Gc^.MV[Gc^.MVTop]; Inc(Gc^.MVTop);
    End
    Else GlErr($503);
  End;
End;

