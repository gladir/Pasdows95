  GetThreadPriority := 0;
End;

{ Tache designee par une poignee (-2 : la tache courante), -1 sinon }
Function ThreadOfH(H : LongInt) : LongInt;
Var I, T : LongInt;
Begin
  T := -1;
  If H = -2 Then T := CurT
  Else
  Begin
    I := KObjOf(H, koThread);
    If I >= 0 Then T := KObjs^[I].F1;
  End;
  If (T >= 0) And (T < MaxThread) Then
    If Not Threads[T].Used Or (Threads[T].State = tsDead) Then T := -1;
  If T >= MaxThread Then T := -1;
  ThreadOfH := T;
End;

{ ResumeThread : decremente le compteur de suspension, la tache repart
  quand il revient a 0 ; rend l'ancien compteur }
Function ResumeThread(H : LongInt) : LongInt;
Var T : LongInt;
Begin
  ResumeThread := -1;
  T := ThreadOfH(H);
  If T < 0 Then Exit;
  ResumeThread := Threads[T].Susp;
  If Threads[T].Susp > 0 Then Dec(Threads[T].Susp);
End;

{ SuspendThread : la tache ne recoit plus le processeur tant que son
  compteur n'est pas revenu a 0 (une tache qui se suspend elle-meme
  attend ici son ResumeThread) }
Function SuspendThread(H : LongInt) : LongInt;
Var T : LongInt;
Begin
  SuspendThread := -1;
  T := ThreadOfH(H);
  If T < 0 Then Exit;
  { la tache 0 (bureau) ne peut pas etre arretee }
  If T = 0 Then
  Begin
    SuspendThread := 0;
    Exit;
  End;
  SuspendThread := Threads[T].Susp;
  If Threads[T].Susp < 127 Then Inc(Threads[T].Susp);
  If T = CurT Then KBlock;
End;

Function GetExitCodeThread(H, P : LongInt) : LongInt;
Var I : LongInt;
Begin
  I := KObjOf(H, koThread);
  If (I >= 0) And (P <> 0) Then
  Begin
    If KObjs^[I].F2 <> 0 Then MemL[0:P] := 0
    Else MemL[0:P] := Threads[KObjs^[I].F1].ExitCode;
  End;
  GetExitCodeThread := Ord(I >= 0);
End;

Function CreateSemaphoreA(Sec, Init, Mx, Name : LongInt) : LongInt;
Var I : LongInt; S : String;
Begin
  CreateSemaphoreA := 0;
  If (Mx <= 0) Or (Init < 0) Or (Init > Mx) Then
  Begin
    SetErr(87);
    Exit;
  End;
  S := '';
  If Name <> 0 Then S := KNameNorm(Name);
  I := KNamed(S);
  If I >= 0 Then
  Begin
    If KObjs^[I].Kind <> koSemaphore Then
    Begin
      SetErr(6);
      Exit;
    End;
    KRefAdd(I);
    SetErr(183);
    CreateSemaphoreA := KHandle(I);
    Exit;
  End;
  I := KObjNew(koSemaphore);
  If I < 0 Then Exit;
  KObjOwner[I] := 0;
  KObjs^[I].F1 := Init; KObjs^[I].F2 := Mx;
  KObjs^[I].Name := S;
  KRefAdd(I);
  SetErr(0);
  CreateSemaphoreA := KHandle(I);
End;

Function ReleaseSemaphore(H, N, Prev : LongInt) : LongInt;
Var I : LongInt;
Begin
  ReleaseSemaphore := 0;
  I := KObjOf(H, koSemaphore);
  If I < 0 Then
  Begin
    SetErr(6);
    Exit;
  End;
  If (N <= 0) Or (KObjs^[I].F1 + N > KObjs^[I].F2) Then
  Begin
    SetErr(298);                 { ERROR_TOO_MANY_POSTS }
    Exit;
  End;
  If Prev <> 0 Then MemL[0:Prev] := KObjs^[I].F1;
  KObjs^[I].F1 := KObjs^[I].F1 + N;
  ReleaseSemaphore := 1;
End;

Function CreateEventA(Sec, Manual, Init, Name : LongInt) : LongInt;
Var I : LongInt; S : String;
Begin
  CreateEventA := 0;
  S := '';
  If Name <> 0 Then S := KNameNorm(Name);
  I := KNamed(S);
  If I >= 0 Then
  Begin
    If KObjs^[I].Kind <> koEvent Then
    Begin
      SetErr(6);
      Exit;
    End;
    KRefAdd(I);
    SetErr(183);
    CreateEventA := KHandle(I);
    Exit;
  End;
  I := KObjNew(koEvent);
  If I < 0 Then Exit;
  KObjOwner[I] := 0;
  KObjs^[I].F1 := Ord(Init <> 0); KObjs^[I].F2 := Ord(Manual <> 0);
  KObjs^[I].Name := S;
  KRefAdd(I);
  SetErr(0);
  CreateEventA := KHandle(I);
End;

{ Ouvrir un objet nomme de la sorte K }
Function KOpenNamed(Name, K : LongInt) : LongInt;
