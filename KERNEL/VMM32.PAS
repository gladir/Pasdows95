  FatInit;
  CurDirS := 'D:';
  SysDirInit;
  BootStep(3);
  { ApiTrace := True journalise chaque appel d'API d'un programme Win32
    (nom, appelant, arguments, resultat) sur le port serie COM1 }
  LoadEnvironment;
  { variable APITRACE de AUTOEXEC.BAT : journal des appels d'API }
  ApiTrace := EnvFind('APITRACE', TrI);
  { APITRACE=n : n appels au plus (60000 par defaut) }
  TraceMax := 60000;
  If ApiTrace Then
  Begin
    TrS := PStr(TrI);
    TrJ := 0;
    For TrK := 1 To Length(TrS) Do
      If (TrS[TrK] >= '0') And (TrS[TrK] <= '9') Then
        TrJ := TrJ * 10 + Ord(TrS[TrK]) - 48;
    If TrJ > 1000 Then TraceMax := TrJ;
  End;
  { APITRACEMOD=VBE.DLL,FM20.DLL : seulement ces modules }
  TraceMods := '';
  ImpTrace := True;
  If EnvFind('APITRACEMOD', TrI) Then
  Begin
    TrS := UpStr(PStr(TrI));
    For TrK := 1 To Length(TrS) Do
      If TrS[TrK] = ',' Then TrS[TrK] := ' ';
    TraceMods := ' ' + TrS + ' ';
  End;
  { DRWATCH=adresse (hexadecimal) : ecritures surveillees par DR0 }
  If EnvFind('DRWATCH', TrI) Then
  Begin
    TrS := PStr(TrI);
    DrWatch := 0;
    For TrJ := 1 To Length(TrS) Do
      If Pos(UpCase(TrS[TrJ]), '0123456789ABCDEF') > 0 Then
        DrWatch := DrWatch * 16 + Pos(UpCase(TrS[TrJ]),
                                      '0123456789ABCDEF') - 1;
    TrJ := DrWatch And Not 3;
    DrWatch := TrJ;
    asm
      mov eax,TrJ
      db 0Fh,23h,0C0h
      mov eax,851970
      db 0Fh,23h,0F8h
    end;
    KLog('DRWATCH ' + HexStr(DrWatch, 8));
  End;
