Function MenuNew : LongInt;
Var I : LongInt;
Begin
  MenuNew := 0;
  For I := 0 To MaxMenu - 1 Do
    If Not MenuUsed[I] Then
    Begin
      MenuUsed[I] := True;
      MenuNew := HMenuBase + I * 4;
      Exit;
    End;
End;

Function CreateMenu : LongInt;
Begin
  CreateMenu := MenuNew;
End;

Function CreatePopupMenu : LongInt;
Begin
  CreatePopupMenu := MenuNew;
End;

{ Element de commande Id dans le menu M ou ses sous-menus }
Function MItemFindR(M, Id, Depth : LongInt) : LongInt;
Var I, R, S : LongInt;
Begin
  MItemFindR := -1;
  For I := 0 To MaxMenuItem - 1 Do
    If MItemsP^[I].Used And (MItemsP^[I].Menu = M) And
       (MItemsP^[I].Id = Id) Then
    Begin
      MItemFindR := I;
      Exit;
    End;
  If Depth >= 6 Then Exit;
  For I := 0 To MaxMenuItem - 1 Do
    If MItemsP^[I].Used And (MItemsP^[I].Menu = M) And
       ((MItemsP^[I].Flags And MF_POPUP) <> 0) Then
    Begin
      S := MenuIdx(MItemsP^[I].Id);
      If (S >= 0) And (S <> M) Then
      Begin
        R := MItemFindR(S, Id, Depth + 1);
        If R >= 0 Then
        Begin
          MItemFindR := R;
          Exit;
        End;
      End;
    End;
End;

Function MItemFind(M, Id, Flags : LongInt) : LongInt;
Var I : LongInt;
Begin
  If (Flags And MF_BYPOSITION) <> 0 Then
  Begin
    MItemFind := MItemAt(M, Id);
    Exit;
  End;
  MItemFind := MItemFindR(M, Id, 0);
End;

{ Ajouter un element (texte deja lu) au menu H }
Function MAdd(H, Flags, Id : LongInt; Const T : String) : LongInt;
Var M, I : LongInt;
Begin
  MAdd := 0;
  M := MenuIdx(H);
  If M < 0 Then Exit;
  For I := 0 To MaxMenuItem - 1 Do
    If Not MItemsP^[I].Used Then
    Begin
      MItemsP^[I].Used := True; MItemsP^[I].Menu := M;
      MItemsP^[I].Flags := Flags; MItemsP^[I].Id := Id;
      Inc(MSeq); MItemsP^[I].Seq := MSeq;
      If (Flags And (MF_SEPARATOR Or 4 Or $100)) = 0 Then
        MItemsP^[I].Text := Copy(T, 1, 63)
      Else MItemsP^[I].Text := '';
      MAdd := 1;
      Exit;
    End;
End;

Function AppendMenuA(H, Flags, Id, Item : LongInt) : LongInt;
Begin
  If ((Flags And (MF_SEPARATOR Or 4 Or $100)) = 0) And (Item <> 0) Then
    AppendMenuA := MAdd(H, Flags, Id, APStr(Item))
  Else AppendMenuA := MAdd(H, Flags, Id, '');
End;

Function InsertMenuA(H, Pos0, Flags, Id, Item : LongInt) : LongInt;
Begin
  InsertMenuA := AppendMenuA(H, Flags And Not MF_BYPOSITION, Id, Item);
End;

Function ModifyMenuA(H, Pos0, Flags, Id, Item : LongInt) : LongInt;
Var M, I : LongInt;
Begin
  ModifyMenuA := 0;
  M := MenuIdx(H);
  If M < 0 Then Exit;
  I := MItemFind(M, Pos0, Flags);
  If I < 0 Then Exit;
  MItemsP^[I].Flags := Flags And Not MF_BYPOSITION; MItemsP^[I].Id := Id;
  If ((Flags And (MF_SEPARATOR Or 4 Or $100)) = 0) And (Item <> 0) Then
    MItemsP^[I].Text := Copy(APStr(Item), 1, 63);
  ModifyMenuA := 1;
End;

Function DeleteMenu(H, Pos0, Flags : LongInt) : LongInt;
Var M, I : LongInt;
Begin
  DeleteMenu := 0;
  M := MenuIdx(H);
  If M < 0 Then Exit;
  I := MItemFind(M, Pos0, Flags);
  If I < 0 Then Exit;
  MItemsP^[I].Used := False;
  DeleteMenu := 1;
End;

Function RemoveMenu(H, Pos0, Flags : LongInt) : LongInt;
Begin
  RemoveMenu := DeleteMenu(H, Pos0, Flags);
End;

Function DestroyMenu(H : LongInt) : LongInt;
Var M, I, S : LongInt;
Begin
  DestroyMenu := 0;
  M := MenuIdx(H);
  If M < 0 Then Exit;
  MenuUsed[M] := False;
  For I := 0 To MaxMenuItem - 1 Do
    If MItemsP^[I].Used And (MItemsP^[I].Menu = M) Then
    Begin
      MItemsP^[I].Used := False;
      { les sous-menus sont detruits avec le menu }
      If (MItemsP^[I].Flags And MF_POPUP) <> 0 Then
      Begin
        S := MItemsP^[I].Id;
        If MenuIdx(S) >= 0 Then DestroyMenu(S);
      End;
    End;
  DestroyMenu := 1;
End;

Function GetMenuItemCount(H : LongInt) : LongInt;
Var M, I, N : LongInt;
Begin
  M := MenuIdx(H);
  N := 0;
  If M >= 0 Then
    For I := 0 To MaxMenuItem - 1 Do
      If MItemsP^[I].Used And (MItemsP^[I].Menu = M) Then Inc(N);
  If M < 0 Then N := -1;
  GetMenuItemCount := N;
End;

Function GetMenuItemID(H, Pos0 : LongInt) : LongInt;
Var M, I : LongInt;
Begin
  GetMenuItemID := -1;
  M := MenuIdx(H);
  If M < 0 Then Exit;
  I := MItemAt(M, Pos0);
  If (I >= 0) And ((MItemsP^[I].Flags And MF_POPUP) = 0) Then
    GetMenuItemID := MItemsP^[I].Id;
End;

Function GetSubMenu(H, Pos0 : LongInt) : LongInt;
Var M, I : LongInt;
Begin
  GetSubMenu := 0;
  M := MenuIdx(H);
  If M < 0 Then Exit;
  I := MItemAt(M, Pos0);
  If (I >= 0) And ((MItemsP^[I].Flags And MF_POPUP) <> 0) Then
    GetSubMenu := MItemsP^[I].Id;
End;

Function GetMenuState(H, Id, Flags : LongInt) : LongInt;
Var M, I : LongInt;
Begin
  GetMenuState := -1;
  M := MenuIdx(H);
  If M < 0 Then Exit;
  I := MItemFind(M, Id, Flags);
  If I >= 0 Then GetMenuState := MItemsP^[I].Flags And $FF;
End;

Function GetMenuStringA(H, Id, Buf, N, Flags : LongInt) : LongInt;
