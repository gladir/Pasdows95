Procedure NoteOpen(Path : String); Forward;

Function ExpDirLba(W : LongInt; Var Lba, Size : LongInt) : Boolean;
Var Fl, Tm : LongInt;
Begin
  ExpDirLba := IsoLookup(Copy(Wnds[W].KS, 3, 255), Lba, Size, Fl, Tm);
End;

Var
  ExpCW, ExpCI, ExpCIdx : LongInt;      { parcours FAT en cours }
  ExpCS : String[127];

Function ExpEntry(W, I : LongInt; Var Nm : String; Var Fl, Size : LongInt)
  : Boolean;
Var DL, DS, Lba, Tm, V, Idx, K : LongInt; Ok : Boolean;
Begin
  ExpEntry := False;
  If Wnds[W].KS = '' Then
  Begin
    { lecteurs : C:, D: (CD-ROM), puis les autres volumes FAT }
    Fl := 2; Size := 0;
    If I = 0 Then
    Begin
      If VolN > 0 Then Nm := Trim(VolLab[0] + ' (C:)') Else Nm := '(C:)';
      ExpEntry := True;
    End
    Else If I = 1 Then
    Begin
      Nm := VolLabel + ' (D:)'; ExpEntry := True;
    End
    Else If I < VolN + 1 Then
    Begin
      V := I - 1;
      Nm := Trim(VolLab[V] + ' (' + Chr(VolLetter[V]) + ':)');
      ExpEntry := True;
    End;
    Exit;
  End;
  If FatVolOf(Wnds[W].KS) >= 0 Then
  Begin
    { volume FAT : reprendre le parcours precedent si possible }
    If (ExpCW = W) And (ExpCS = Wnds[W].KS) And (ExpCI < I) Then
    Begin
      K := ExpCI; Idx := ExpCIdx;
    End
    Else
    Begin
      K := -1; Idx := 0;
    End;
    Ok := True;
    While Ok And (K < I) Do
    Begin
      Ok := FatDirEntry(Wnds[W].KS, 0, Idx);
      Inc(K);
    End;
    If Not Ok Then
    Begin
      ExpCW := -1;
      Exit;
    End;
    ExpCW := W; ExpCS := Wnds[W].KS; ExpCI := I; ExpCIdx := Idx;
    Nm := FfName; Size := FfSize;
    If (FfAttr And $10) <> 0 Then Fl := 2 Else Fl := 0;
    ExpEntry := True;
    Exit;
  End;
  If Not ExpDirLba(W, DL, DS) Then Exit;
  ExpEntry := IsoDirEntry(DL, DS, I, Nm, Lba, Size, Fl, Tm);
End;

Function ExpIcon(Nm : String; Fl : LongInt) : LongInt;
Var E : String;
Begin
  E := UpStr(Copy(Nm, Pos('.', Nm) + 1, 3));
  If Pos('(D:)', Nm) > 0 Then ExpIcon := icCdrom
  Else If (Pos(':)', Nm) > 0) And (Nm[Length(Nm)] = ')') Then
    ExpIcon := icHardDisk
  Else If (Fl And 2) <> 0 Then ExpIcon := icFolder
  Else If (E = 'EXE') Or (E = 'COM') Then ExpIcon := icApp
  Else If (E = 'TXT') Or (E = 'BAT') Or (E = 'INI') Or (E = 'SYS') Then
    ExpIcon := icText
  Else ExpIcon := icDocs;
End;

Procedure PaintExplorer(W : LongInt);
Var X1, Y1, X2, Y2, I, X, Y, Fl, Size, Cols, N : LongInt; Nm, S : String;
Begin
  KClient(W, X1, Y1, X2, Y2);
  FBar(X1, Y1, X2, Y1 + 29, cSilver);
  Raised(X1 + 4, Y1 + 4, X1 + 29, Y1 + 26, False);
  PaintIcon(icFolder, X1 + 8, Y1 + 7, 16);
  Arrow(X1 + 13, Y1 + 11, 2, cBlack);
  Sunken(X1 + 36, Y1 + 4, X2 - 4, Y1 + 26, cWhite);
  If Wnds[W].KS = '' Then
    OutTxt(X1 + 42, Y1 + 7, L('Poste de travail', 'My Computer',
           'Arbeitsplatz', 'Risorse del computer', 'Mi PC'), cBlack)
  Else OutTxt(X1 + 42, Y1 + 7, Wnds[W].KS, cBlack);
  Y1 := Y1 + 30;
  Sunken(X1, Y1, X2, Y2 - 22, cWhite);
  Edge(X1, Y2 - 19, X2, Y2, cGray, cWhite);
  FBar(X1 + 1, Y2 - 18, X2 - 1, Y2 - 1, cSilver);
  Cols := Max(1, (X2 - X1 - 8) Div 100);
  SetClip(X1 + 2, Y1 + 2, X2 - 2, Y2 - 24);
  I := 0; N := 0;
  While ExpEntry(W, I, Nm, Fl, Size) Do
  Begin
    X := X1 + 6 + (I Mod Cols) * 100;
    Y := Y1 + 6 + (I Div Cols) * 70 - Wnds[W].K2 * 70;
    If (Y > Y1 - 70) And (Y < Y2) Then
    Begin
      PaintIcon(ExpIcon(Nm, Fl), X + 32, Y, 32);
      DrawLabel(X, Y + 34, 96, Nm, I = Wnds[W].K1, cBlack);
    End;
    If I = Wnds[W].K1 Then
    Begin
      S := Nm;
      If (Fl And 2) = 0 Then S := S + ' : ' + IntStr(Size) + ' ' +
         L('octets', 'bytes', 'Byte', 'byte', 'bytes');
    End;
    Inc(I); Inc(N);
  End;
  SetClip(X1, Y1, X2, Y2);
  If Wnds[W].K1 < 0 Then
    S := IntStr(N) + ' ' + L('objet(s)', 'object(s)', 'Objekt(e)',
                              'oggetti', 'objeto(s)');
  OutTxt(X1 + 4, Y2 - 17, Fit(S, X2 - X1 - 8), cBlack);
End;

Procedure ExpOpenItem(W, I : LongInt);
Var Nm, P, E : String; Fl, Size : LongInt;
Begin
  If Not ExpEntry(W, I, Nm, Fl, Size) Then Exit;
  If Wnds[W].KS = '' Then
  Begin
    If (I = 0) And (VolN = 0) And (DiskN > 0) Then
    Begin
      { disque dur sans volume FAT : proposer de le formater }
      FmtAskW := MsgBoxOpen(L('Poste de travail', 'My Computer',
        'Arbeitsplatz', 'Risorse del computer', 'Mi PC'), L(
        'Le disque dur (' + IntStr(DiskSecs[0] Div 2048) + ' Mo) n''est ' +
        'pas format'#130'. Voulez-vous le formater en FAT32 ? Toutes ses ' +
        'donn'#130'es seront effac'#130'es.',
        'The hard disk (' + IntStr(DiskSecs[0] Div 2048) + ' MB) is not ' +
        'formatted. Do you want to format it (FAT32)? All data on it ' +
        'will be erased.',
        'Die Festplatte ist nicht formatiert. Jetzt mit FAT32 ' +
        'formatieren? Alle Daten werden gel'#148'scht.',
        'Il disco non '#138' formattato. Formattarlo in FAT32? Tutti i dati ' +
        'verranno cancellati.',
        'El disco no est'#160' formateado. '#168'Desea formatearlo en FAT32? ' +
        'Se borrar'#160'n todos los datos.'), $34);
      Exit;
    End;
    If (I = 0) And (VolN = 0) Then
    Begin
      MsgBoxOpen(L('Poste de travail', 'My Computer', 'Arbeitsplatz',
                   'Risorse del computer', 'Mi PC'), L(
        'C: est un disque virtuel en m'#130'moire (C:\WINDOWS, C:\TEMP).',
        'C: is a virtual RAM disk (C:\WINDOWS, C:\TEMP).',
        'C: ist ein virtuelles RAM-Laufwerk.',
        'C: '#138' un disco virtuale in memoria.',
        'C: es un disco virtual en memoria.'), $40);
      Exit;
    End;
    If I = 0 Then Wnds[W].KS := 'C:'
    Else If I = 1 Then Wnds[W].KS := 'D:'
    Else Wnds[W].KS := Chr(VolLetter[I - 1]) + ':';
  End
  Else
  Begin
    P := Wnds[W].KS + '\' + Nm;
    If (Fl And 2) <> 0 Then Wnds[W].KS := P
    Else
    Begin
      E := Copy(Nm, Pos('.', Nm) + 1, 3);
      If (E = 'EXE') Or (E = 'COM') Then RunExe(P, '')
      Else NoteOpen(P);
      Exit;
    End;
  End;
  Wnds[W].K1 := -1; Wnds[W].K2 := 0;
  KRepaint(W);
End;

Procedure ExpUp(W : LongInt);
Var P : LongInt;
Begin
  If Wnds[W].KS = '' Then Exit;
  If Length(Wnds[W].KS) <= 2 Then Wnds[W].KS := ''
  Else
  Begin
    P := Length(Wnds[W].KS);
    While (P > 0) And (Wnds[W].KS[P] <> '\') Do Dec(P);
    Wnds[W].KS := Copy(Wnds[W].KS, 1, P - 1);
  End;
  Wnds[W].K1 := -1; Wnds[W].K2 := 0;
  KRepaint(W);
End;

Procedure ExpMouse(W, Msg, X, Y : LongInt);
Var X1, Y1, X2, Y2, Cols, I, Fl, Size : LongInt; Nm : String;
Begin
  If (Msg <> WM_LBUTTONDOWN) And (Msg <> WM_LBUTTONDBLCLK) Then Exit;
  X := X + Wnds[W].X + Wnds[W].CL; Y := Y + Wnds[W].Y + Wnds[W].CT;
  KClient(W, X1, Y1, X2, Y2);
  If InRect(X, Y, X1 + 4, Y1 + 4, X1 + 29, Y1 + 26) Then
  Begin
    ExpUp(W);
    Exit;
  End;
  Y1 := Y1 + 30;
  Cols := Max(1, (X2 - X1 - 8) Div 100);
  If (X < X1 + 6) Or (Y < Y1 + 6) Then Exit;
  I := ((Y - Y1 - 6) Div 70 + Wnds[W].K2) * Cols + (X - X1 - 6) Div 100;
  If (X - X1 - 6) Div 100 >= Cols Then Exit;
  If Not ExpEntry(W, I, Nm, Fl, Size) Then I := -1;
  If (Msg = WM_LBUTTONDBLCLK) And (I >= 0) Then ExpOpenItem(W, I)
  Else If I <> Wnds[W].K1 Then
  Begin
    Wnds[W].K1 := I;
    KRepaint(W);
  End;
End;

{ ------------------------------------------------------------------ }
{ Bloc-notes (lecture et edition d'un fichier texte)                 }
{   K1 longueur, K2 curseur, K3 premiere ligne affichee, KS nom      }
{ ------------------------------------------------------------------ }

Const
  NoteMax = 60000;

Function NLineStart(B, P : LongInt) : LongInt;
Begin
  While (P > 0) And (Mem[0:B + P - 1] <> 13) Do Dec(P);
  NLineStart := P;
End;

Function NLineEnd(B, P, N : LongInt) : LongInt;
Begin
  While (P < N) And (Mem[0:B + P] <> 13) Do Inc(P);
  NLineEnd := P;
End;

Function KOpenFile(Name : String; Wr : Boolean; Disp : LongInt) : LongInt;
  Forward;
Function KWriteFile(H, Buf, N : LongInt) : LongInt; Forward;
Function CloseHandle(H : LongInt) : LongInt; Forward;
Procedure FdOpen(Mode, Owner : LongInt; Const Dir, Name : String); Forward;

{ Texte du Bloc-notes : CR seul en memoire, CR LF dans les fichiers.
  K1 longueur, K2 position du curseur, K3 debut de la premiere ligne
  affichee ; barre de menus de 20 points en haut de la zone client. }

Function NoteTitle : String;
Begin
  If NotePath = '' Then
    NoteTitle := L('Sans titre', 'Untitled', 'Unbenannt', 'Senza nome',
                   'Sin t'#161'tulo')
  Else NoteTitle := BaseName(NotePath);
End;

Procedure NoteSetTitle(W : LongInt);
Begin
  Wnds[W].Text := NoteTitle + ' - ' + L('Bloc-notes', 'Notepad', 'Editor',
                  'Blocco note', 'Bloc de notas');
  Wnds[W].NeedNc := True;
  TaskbarChanged;
End;

{ Charger le fichier Path (vide : nouveau document) }
Procedure NoteLoad(W : LongInt; Path : String);
Var A, Size, R, Wr, B : LongInt; CR : Boolean;
Begin
  B := Wnds[W].Extra;
  Wnds[W].K1 := 0; Wnds[W].K2 := 0; Wnds[W].K3 := 0;
  NoteSel := -1; NoteLeft := 0; NoteDirty := False;
  NoteUndoOk := False; NoteGroup := False;
  NotePath := '';
  If Path <> '' Then
  Begin
    A := LoadWholeFile(Path, Size);
    If A <> 0 Then
    Begin
      If Size > NoteMax Then Size := NoteMax;
      Wr := 0; CR := False;
      For R := 0 To Size - 1 Do
      Begin
        If Mem[0:A + R] = 13 Then
        Begin
          Mem[0:B + Wr] := 13; Inc(Wr); CR := True;
        End
        Else If Mem[0:A + R] = 10 Then
        Begin
          If Not CR Then Begin Mem[0:B + Wr] := 13; Inc(Wr) End;
          CR := False;
        End
        Else
        Begin
          If (Mem[0:A + R] <> 26) And (Mem[0:A + R] <> 0) Then
          Begin
            Mem[0:B + Wr] := Mem[0:A + R]; Inc(Wr);
          End;
          CR := False;
        End;
      End;
      KFree(A);
      Wnds[W].K1 := Wr;
      NotePath := FullPath(Path);
    End
    Else
      MsgBoxOpen(L('Bloc-notes', 'Notepad', 'Editor', 'Blocco note',
                   'Bloc de notas'), L('Impossible d''ouvrir ', 'Cannot open ',
                   'Kann nicht '#148'ffnen: ', 'Impossibile aprire ',
                   'No se puede abrir ') + Path, $30);
  End;
  NoteSetTitle(W);
  KRepaint(W);
End;

Procedure NoteOpen(Path : String);
Var W, Own : LongInt;
Begin
  W := KFindKind(ikNotepad);
  If W < 0 Then
  Begin
    W := KCreate(ikNotepad, '', icNotepad, 110, 46, 480, 340,
                 WS_OVERLAPPED Or WS_CAPTION Or WS_SYSMENU Or WS_THICKFRAME
                 Or WS_MINIMIZEBOX Or WS_MAXIMIZEBOX, WS_EX_CLIENTEDGE);
    If W < 0 Then Exit;
    Own := HeapOwner; HeapOwner := 0;
    Wnds[W].Extra := KAlloc(NoteMax + 16);
    If NoteUndoBuf = 0 Then NoteUndoBuf := KAlloc(NoteMax + 16);
    HeapOwner := Own;
  End;
  NoteLoad(W, Path);
  ShowW(W, True, True);
  ActivateW(W);
End;

{ Ecrire le texte dans Path (CR LF) ; False si impossible }
Function NoteWrite(W : LongInt; Path : String) : Boolean;
Var B, N, T, I, K, H, Own : LongInt; Ok : Boolean;
Begin
  NoteWrite := False; Ok := False;
  B := Wnds[W].Extra; N := Wnds[W].K1;
  Own := HeapOwner; HeapOwner := 0;
  T := KAlloc(N * 2 + 16);
  HeapOwner := Own;
  If T = 0 Then Exit;
  K := 0;
  For I := 0 To N - 1 Do
  Begin
    Mem[0:T + K] := Mem[0:B + I]; Inc(K);
    If Mem[0:B + I] = 13 Then
    Begin
      Mem[0:T + K] := 10; Inc(K);
    End;
  End;
  H := KOpenFile(Path, True, 2);
  If H <> INVALID_HANDLE Then
  Begin
    Ok := KWriteFile(H, T, K) = K;
    CloseHandle(H);
  End;
  KFree(T);
  NoteWrite := Ok;
  If Ok Then
  Begin
    NotePath := FullPath(Path);
    NoteDirty := False;
    NoteSetTitle(W);
  End
  Else
    MsgBoxOpen(L('Bloc-notes', 'Notepad', 'Editor', 'Blocco note',
               'Bloc de notas'), L('Impossible d''enregistrer ', 'Cannot ' +
               'save ', 'Kann nicht speichern: ', 'Impossibile salvare ',
               'No se puede guardar ') + Path + L(' (le CD-ROM D: est en ' +
               'lecture seule).', ' (CD-ROM D: is read-only).',
               ' (D: ist schreibgesch'#129'tzt).',
               ' (D: '#138' di sola lettura).',
               ' (D: es de s'#162'lo lectura).'), $30);
End;

Procedure NoteSelRange(W : LongInt; Var A, B : LongInt);
Begin
  A := Min(NoteSel, Wnds[W].K2); B := Max(NoteSel, Wnds[W].K2);
End;

{ Copie pour Annuler (debut d'un groupe de modifications) }
Procedure NoteSnap(W : LongInt);
Begin
  If NoteGroup Or (NoteUndoBuf = 0) Then Exit;
  MoveMem(Wnds[W].Extra, NoteUndoBuf, Wnds[W].K1);
  NoteUndoLen := Wnds[W].K1; NoteUndoPos := Wnds[W].K2;
  NoteUndoOk := True;
End;

Procedure NoteUndo(W : LongInt);
Var I, T, B : LongInt;
Begin
  If Not NoteUndoOk Then Exit;
  B := Wnds[W].Extra;
  { echange : un second Annuler retablit }
  For I := 0 To Max(NoteUndoLen, Wnds[W].K1) - 1 Do
  Begin
    T := Mem[0:B + I];
    Mem[0:B + I] := Mem[0:NoteUndoBuf + I];
    Mem[0:NoteUndoBuf + I] := T;
  End;
  T := Wnds[W].K1; Wnds[W].K1 := NoteUndoLen; NoteUndoLen := T;
  T := Wnds[W].K2; Wnds[W].K2 := Min(NoteUndoPos, Wnds[W].K1);
  NoteUndoPos := T;
  NoteSel := -1; NoteDirty := True; NoteGroup := False;
End;

{ Supprimer la selection ; True s'il y en avait une }
Function NoteDelSel(W : LongInt) : Boolean;
Var A, B, Bf, N : LongInt;
Begin
  NoteDelSel := False;
  If NoteSel < 0 Then Exit;
  NoteSelRange(W, A, B);
  NoteSel := -1;
  If A = B Then Exit;
  Bf := Wnds[W].Extra; N := Wnds[W].K1;
  MoveMem(Bf + B, Bf + A, N - B);
  Wnds[W].K1 := N - (B - A); Wnds[W].K2 := A;
  NoteDirty := True;
  NoteDelSel := True;
End;

{ Inserer N caracteres de Src (texte CR LF : les LF sont retires) }
Procedure NoteInsert(W, Src, N : LongInt);
Var I, C, Bf, Len, P : LongInt;
Begin
  Bf := Wnds[W].Extra;
  For I := 0 To N - 1 Do
  Begin
    C := Mem[0:Src + I];
    If (C = 10) Or (C = 0) Then Continue;
    Len := Wnds[W].K1; P := Wnds[W].K2;
    If Len >= NoteMax Then Exit;
    MoveMem(Bf + P, Bf + P + 1, Len - P);
    Mem[0:Bf + P] := C;
    Wnds[W].K1 := Len + 1; Wnds[W].K2 := P + 1;
  End;
  NoteDirty := True;
End;

{ Selection vers le presse-papiers (CR -> CR LF) }
Procedure NoteCopy(W : LongInt);
Var A, B, I, K, Own : LongInt;
Begin
  If NoteSel < 0 Then Exit;
  NoteSelRange(W, A, B);
  If ClipBuf <> 0 Then KFree(ClipBuf);
  Own := HeapOwner; HeapOwner := 0;
  ClipBuf := KAlloc((B - A) * 2 + 16);
  HeapOwner := Own;
  ClipLen := 0;
  If ClipBuf = 0 Then Exit;
  K := 0;
  For I := A To B - 1 Do
  Begin
    Mem[0:ClipBuf + K] := Mem[0:Wnds[W].Extra + I]; Inc(K);
    If Mem[0:Wnds[W].Extra + I] = 13 Then
    Begin
      Mem[0:ClipBuf + K] := 10; Inc(K);
    End;
  End;
  Mem[0:ClipBuf + K] := 0;
  ClipLen := K;
End;

{ Le curseur reste visible (lignes et colonnes) }
Procedure NoteScroll(W : LongInt);
Var B, N, C, X1, Y1, X2, Y2, Rows, Cols, Ln, P, Col : LongInt;
Begin
  B := Wnds[W].Extra; N := Wnds[W].K1; C := Wnds[W].K2;
  KClient(W, X1, Y1, X2, Y2);
  Rows := Max(1, (Y2 - Y1 - 24) Div 16);
  Cols := Max(1, (X2 - X1 - 6) Div 8);
  If C < Wnds[W].K3 Then Wnds[W].K3 := NLineStart(B, C)
  Else
  Begin
    Ln := 0; P := Wnds[W].K3;
    While P < NLineStart(B, C) Do
    Begin
      P := NLineEnd(B, P, N) + 1;
      Inc(Ln);
    End;
    While Ln >= Rows Do
    Begin
      Wnds[W].K3 := NLineEnd(B, Wnds[W].K3, N) + 1;
      Dec(Ln);
    End;
  End;
  Col := C - NLineStart(B, C);
  If Col < NoteLeft Then NoteLeft := Max(0, Col - 8);
  If Col >= NoteLeft + Cols Then NoteLeft := Col - Cols + 8;
End;

{ Titres de la barre de menus : position X (ecran) du titre I }
Function NoteMenuTitle(I : LongInt) : String;
Begin
  Case I Of
    0 : NoteMenuTitle := L('Fichier', 'File', 'Datei', 'File', 'Archivo');
    1 : NoteMenuTitle := L('Edition', 'Edit', 'Bearbeiten', 'Modifica',
                           'Edici'#162'n');
    2 : NoteMenuTitle := L('Recherche', 'Search', 'Suchen', 'Cerca',
                           'Buscar');
  Else
    NoteMenuTitle := '?';
  End;
End;

Function NoteMenuX(W, I : LongInt) : LongInt;
Var X1, Y1, X2, Y2, K, X : LongInt;
Begin
  KClient(W, X1, Y1, X2, Y2);
  X := X1 + 4;
  For K := 0 To I - 1 Do X := X + TextW(NoteMenuTitle(K)) + 16;
  NoteMenuX := X;
End;

Procedure PaintNotepad(W : LongInt);
Var X1, Y1, X2, Y2, Rows, Cols, R, CC, B, N, P, E, Q, I, SA, SB, TX, Fg,
    Bg, Ch, MX, M : LongInt;
Begin
  KClient(W, X1, Y1, X2, Y2);
  { barre de menus }
  FBar(X1, Y1, X2, Y1 + 19, cSilver);
  HLine(X1, X2, Y1 + 19, cGray);
  M := -1;
  If (MenuDepth > 0) And (MenuW[0] >= 0) And Wnds[MenuW[0]].Used Then
    If (Wnds[MenuW[0]].K1 >= mnNFile) And (Wnds[MenuW[0]].K1 <= mnNHelp) Then
      M := Wnds[MenuW[0]].K1 - mnNFile;
  For I := 0 To 3 Do
  Begin
    MX := NoteMenuX(W, I);
    If I = M Then
      Edge(MX - 4, Y1 + 1, MX + TextW(NoteMenuTitle(I)) + 4, Y1 + 18, cGray,
           cWhite);
    OutTxt(MX, Y1 + 2, NoteMenuTitle(I), cBlack);
  End;
  FBar(X1, Y1 + 20, X2, Y2, cWhite);
  B := Wnds[W].Extra; N := Wnds[W].K1;
  Rows := (Y2 - Y1 - 24) Div 16;
  Cols := (X2 - X1 - 6) Div 8;
  SA := -1; SB := -1;
  If NoteSel >= 0 Then NoteSelRange(W, SA, SB);
  P := Wnds[W].K3;
  For R := 0 To Rows - 1 Do
  Begin
    If P > N Then Exit;
    E := NLineEnd(B, P, N);
    Q := P + NoteLeft; CC := 0;
    While (Q < E) And (CC < Cols) Do
    Begin
      Ch := Mem[0:B + Q];
      If Ch < 32 Then Ch := 32;
      TX := X1 + 3 + CC * 8;
      If (Q >= SA) And (Q < SB) Then
      Begin
        FBar(TX, Y1 + 22 + R * 16, TX + 7, Y1 + 37 + R * 16, cNavy);
        Fg := cWhite;
      End
      Else Fg := cBlack;
      DrawChar(TX, Y1 + 22 + R * 16, Chr(Ch), Fg);
      Inc(Q); Inc(CC);
    End;
    { fin de ligne selectionnee }
    If (E >= SA) And (E < SB) And (E - P - NoteLeft >= 0) And
       (E - P - NoteLeft < Cols) Then
      FBar(X1 + 3 + (E - P - NoteLeft) * 8, Y1 + 22 + R * 16,
           X1 + 6 + (E - P - NoteLeft) * 8, Y1 + 37 + R * 16, cNavy);
    If (Wnds[W].K2 >= P) And (Wnds[W].K2 <= E) And (W = ActiveWin) Then
    Begin
      CC := Wnds[W].K2 - P - NoteLeft;
      If (CC >= 0) And (CC <= Cols) Then
        VLine(X1 + 3 + CC * 8, Y1 + 22 + R * 16, Y1 + 36 + R * 16, cBlack);
    End;
    P := E + 1;
  End;
End;

{ Position du texte sous le point (X, Y) de l'ecran }
Function NoteHit(W, X, Y : LongInt) : LongInt;
Var X1, Y1, X2, Y2, B, N, P, R, Col : LongInt;
Begin
  KClient(W, X1, Y1, X2, Y2);
  B := Wnds[W].Extra; N := Wnds[W].K1;
  R := (Y - Y1 - 22) Div 16;
  If Y < Y1 + 22 Then R := 0;
  P := Wnds[W].K3;
  While (R > 0) And (NLineEnd(B, P, N) < N) Do
  Begin
    P := NLineEnd(B, P, N) + 1;
    Dec(R);
  End;
  Col := (X - X1 - 3 + 4) Div 8 + NoteLeft;
  If Col < 0 Then Col := 0;
  NoteHit := Min(P + Col, NLineEnd(B, P, N));
End;

Procedure NoteMouse(W, Msg, X, Y : LongInt);
Var X1, Y1, X2, Y2, I, MX : LongInt;
Begin
  X := X + Wnds[W].X + Wnds[W].CL; Y := Y + Wnds[W].Y + Wnds[W].CT;
  KClient(W, X1, Y1, X2, Y2);
  If (Msg = WM_LBUTTONDOWN) And (Y < Y1 + 20) Then
  Begin
    For I := 0 To 3 Do
    Begin
      MX := NoteMenuX(W, I);
      If InRect(X, Y, MX - 4, Y1, MX + TextW(NoteMenuTitle(I)) + 4,
                Y1 + 19) Then
      Begin
        CloseMenus(0);
        OpenMenu(0, mnNFile + I, MX - 4, Y1 + 19, False);
        KRepaint(W);
        Exit;
      End;
    End;
    Exit;
  End;
  If Msg = WM_LBUTTONDOWN Then
  Begin
    Wnds[W].K2 := NoteHit(W, X, Y);
    NoteSel := Wnds[W].K2;
    NoteGroup := False;
    CaptureWin := W;
    KRepaint(W);
  End
  Else If (Msg = WM_MOUSEMOVE) And (CaptureWin = W) Then
  Begin
    Wnds[W].K2 := NoteHit(W, X, Y);
    NoteScroll(W);
    KRepaint(W);
  End
  Else If Msg = WM_LBUTTONUP Then
  Begin
    CaptureWin := -1;
    If NoteSel = Wnds[W].K2 Then NoteSel := -1;
    KRepaint(W);
  End;
End;

{ Question "enregistrer les modifications ?" puis action Act (0 fermer,
  1 nouveau, 2 ouvrir) ; True si l'action peut avoir lieu tout de suite }
Function NoteAsk(W, Act : LongInt) : Boolean;
Begin
  NoteAsk := True;
  If Not NoteDirty Then Exit;
  NoteAsk := False;
  NoteAskAct := Act;
  NoteAskW := MsgBoxOpen(L('Bloc-notes', 'Notepad', 'Editor', 'Blocco note',
    'Bloc de notas'), L('Le texte du fichier ', 'The text in the ',
    'Der Text in der Datei ', 'Il testo del file ', 'El texto del archivo ') +
    NoteTitle + L(' a '#130't'#130' modifi'#130'.|Voulez-vous enregistrer ' +
    'les modifications'#255'?', ' file has changed.|Do you want to save the ' +
    'changes?', ' wurde ge'#132'ndert.|'#142'nderungen speichern?',
    #138' stato modificato.|Salvare le modifiche?',
    ' ha cambiado.|'#168'Desea guardar los cambios?'), $23);
