Function GlB(V : LongInt) : LongInt;
Begin
  V := V And 255;
  If V > 127 Then V := V - 256;
  GlB := V;
End;

Function GlS(V : LongInt) : LongInt;
Begin
  V := V And $FFFF;
  If V > 32767 Then V := V - 65536;
  GlS := V;
End;

Function GlUI(V : LongInt) : Double;
Begin
  If V < 0 Then GlUI := V + 4294967296.0 Else GlUI := V;
End;

