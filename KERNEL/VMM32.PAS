{ Ouvrir un fichier ; Disp : 1 CREATE_NEW 2 CREATE_ALWAYS 3 OPEN_EXISTING
  4 OPEN_ALWAYS 5 TRUNCATE_EXISTING ; poignee ou -1 }
{ Nom de base tel que le programme l'a ecrit (casse conservee) }
Function OrigBase(Const Name : String) : String;
Var P, E, I : LongInt; R : String;
Begin
  E := Length(Name);
  While (E > 0) And ((Name[E] <= ' ') Or (Name[E] = '\') Or
        (Name[E] = '/')) Do Dec(E);
  P := E;
  While (P > 0) And (Name[P] <> '\') And (Name[P] <> '/') And
        (Name[P] <> ':') Do Dec(P);
  R := '';
  For I := P + 1 To E Do R := R + Name[I];
  OrigBase := R;
End;

Function KOpenFile(Name : String; Wr : Boolean; Disp : LongInt) : LongInt;
Var Path, Ob : String; Attr, Size, Time, Lba, Ram, I, F, E : LongInt;
    Ex : Boolean;
Begin
  KOpenFile := INVALID_HANDLE;
  If (UpStr(Name) = 'CON') Or (UpStr(Name) = 'CONOUT$') Then
  Begin
    KOpenFile := HStdOut;
    Exit;
  End;
  If (UpStr(Name) = 'NUL') Or (UpStr(Name) = 'C:\NUL') Then
  Begin
    { peripherique nul : lectures vides, ecritures ignorees }
    I := KObjNew(koFile);
    If I < 0 Then Exit;
    KObjs^[I].F1 := -1; KObjs^[I].F4 := -2; KObjs^[I].F5 := 1;
    KObjs^[I].Name := 'NUL';
    KOpenFile := KHandle(I);
    Exit;
  End;
  { volume entier (\\.\C:) : DeviceIoControl (defragmentation) }
  If (Length(Name) = 6) And (Copy(Name, 1, 4) = '\\.\') And
     (Name[6] = ':') Then
  Begin
    E := FatVolOf(UpStr(Copy(Name, 5, 2)) + '\');
    If E < 0 Then
    Begin
      SetErr(ErrFileNotFound);
      Exit;
    End;
    I := KObjNew(koFile);
    If I < 0 Then Exit;
    KObjs^[I].F1 := E; KObjs^[I].F2 := 0; KObjs^[I].F3 := 0;
    KObjs^[I].F4 := -3; KObjs^[I].F5 := 0;
    KObjs^[I].Name := Name;
    SetErr(0);
    KOpenFile := KHandle(I);
    Exit;
  End;
  Path := FullPath(Name);
  If FatVolOf(Path) >= 0 Then
  Begin
    { volume FAT d'un disque dur }
    Ob := OrigBase(Name);
    F := FatOpen(Path, Ob, Wr, Disp, E);
    If ApiTrace And (TraceMods = '') Then
      KLog('Fichier FAT : ' + Path + ' -> ' + IntStr(F));
    If F < 0 Then
    Begin
      SetErr(E);
      Exit;
    End;
    I := KObjNew(koFile);
    If I < 0 Then
    Begin
      FatClose(F);
      SetErr(4);
      Exit;
    End;
    KObjs^[I].F1 := -1;
    KObjs^[I].F2 := FoSize[F];
    KObjs^[I].F3 := 0;
    KObjs^[I].F4 := -1000 - F;
    KObjs^[I].F5 := Ord(Wr);
    KObjs^[I].F6 := FoTime[F];
    KObjs^[I].Name := Path;
    If (Disp = 4) And Not FoDirty[F] Then SetErr(183) Else SetErr(0);
    KOpenFile := KHandle(I);
    Exit;
  End;
  Ex := PathInfo(Path, Attr, Size, Time, Lba, Ram);
  If ApiTrace And (TraceMods = '') Then
    KLog('Fichier : ' + Path + ' existe=' + IntStr(Ord(Ex)));
  If Ex And ((Attr And $10) <> 0) Then
  Begin
    SetErr(ErrAccessDenied);
    Exit;
  End;
  If (Disp = 1) And Ex Then
  Begin
    SetErr(80);
    Exit;
  End;
  If ((Disp = 3) Or (Disp = 5)) And Not Ex Then
  Begin
    SetErr(ErrFileNotFound);
    Exit;
  End;
  If Wr Or (Disp = 1) Or (Disp = 2) Then
  Begin
    If Copy(Path, 1, 2) = 'D:' Then
    Begin
      SetErr(ErrAccessDenied);
      Exit;
    End;
    If Not IsCDir(ParentDir(Path)) Then
    Begin
      SetErr(ErrPathNotFound);
      Exit;
    End;
    If Ram < 0 Then
    Begin
      Ram := RamNew(Path);
      If Ram < 0 Then
      Begin
        SetErr(4);
        Exit;
      End;
    End;
    If (Disp = 2) Or (Disp = 5) Then RamFiles[Ram].Size := 0;
    Lba := -1;
  End
  Else If Not Ex Then
  Begin
    If Disp = 4 Then
    Begin
      SetErr(ErrAccessDenied);
      Exit;
    End;
    SetErr(ErrFileNotFound);
    Exit;
  End;
  I := KObjNew(koFile);
  If I < 0 Then
  Begin
    SetErr(4);
    Exit;
  End;
  KObjs^[I].F1 := Lba;
  If Ram >= 0 Then KObjs^[I].F2 := RamFiles[Ram].Size Else KObjs^[I].F2 := Size;
  KObjs^[I].F3 := 0;
  KObjs^[I].F4 := Ram;
  KObjs^[I].F5 := Ord(Wr);
  KObjs^[I].F6 := Time;
  KObjs^[I].Name := Path;
  SetErr(0);
  KOpenFile := KHandle(I);
End;

Function CreateFileA(PName, Access, Share, Sec, Disp, Flags, Templ : LongInt)
  : LongInt;
Begin
  AppYield;
  CreateFileA := KOpenFile(PStr(PName), (Access And $40000000) <> 0, Disp);
End;

Function CloseHandle(H : LongInt) : LongInt;
Var I : LongInt;
Begin
  CloseHandle := 1;
  If IsConsoleH(H) Then Exit;
  I := KObjOf(H, 0);
  If I < 0 Then
  Begin
    CloseHandle := 0;
    SetErr(ErrInvalidHandle);
    Exit;
  End;
  If KObjs^[I].Kind = koThread Then
  Begin
    { la tache continue ; l'objet sera libere a sa fin }
    If (KObjs^[I].F1 >= 0) And Threads[KObjs^[I].F1].Used Then Exit;
  End;
  { objet processus : garde (autres poignees, code de sortie) }
  If KObjs^[I].Kind = koProcess Then Exit;
  If (KObjs^[I].Kind = koSnapshot) And (KObjs^[I].F4 <> 0) Then
    KFree(KObjs^[I].F4);
  { synchronisation et mappages : une reference de moins }
  If KObjs^[I].Kind In [koEvent, koSemaphore, koMutex, koMapping] Then
  Begin
    KRefClose(I, CurProc);
    Exit;
  End;
  If (KObjs^[I].Kind = koFile) And (KObjs^[I].F4 <= -1000) Then
    FatClose(-1000 - KObjs^[I].F4);
  KObjs^[I].Used := False;
End;

{ Lecture des secteurs d'un volume ouvert par \\.\C: (CHKDSK, SCANDISK) ;
  position sur 64 bits (P en bas, Ph en haut) pour les volumes de plus
  de 2 Go }
Function VolReadAt(V, P, Ph, N, Buf : LongInt;
                   Var Got : LongInt) : Boolean;
Var S, O, K : LongInt;
Begin
  VolReadAt := False; Got := 0;
  If (V < 0) Or (VolType[V] = NetT) Then
  Begin
    SetErr(5);
    Exit;
  End;
  FatIoErr := False;
  S := (Ph Shl 23) Or (P Shr 9); O := P And 511;
  While Got < N Do
  Begin
    If S >= VolSecs[V] Then Break;
    K := 512 - O;
    If K > N - Got Then K := N - Got;
    MoveMem(VSec(V, S) + O, Buf + Got, K);
    Got := Got + K;
    Inc(S); O := 0;
  End;
  If FatIoErr Then SetErr(30);
  VolReadAt := Not FatIoErr;
End;

Function KReadFile(H, Buf, N : LongInt; Var Got : LongInt) : Boolean;
Var I, R : LongInt;
Begin
  KReadFile := False; Got := 0;
  If IsConsoleH(H) Then
  Begin
    { entree standard : la console (mode ligne par defaut) }
    If (H = HStdIn) And ((ConW >= 0) Or AppConsole) Then
      Got := ConReadIn(Buf, N);
    KReadFile := True;
    Exit;
  End;
  I := KObjOf(H, koFile);
  If I < 0 Then
  Begin
    SetErr(ErrInvalidHandle);
    Exit;
  End;
  If N < 0 Then N := 0;
  If KObjs^[I].F4 <= -1000 Then
  Begin
    R := -1000 - KObjs^[I].F4;
    FatIoErr := False;
    Got := FatRead(R, KObjs^[I].F3, N, Buf);
    KObjs^[I].F3 := KObjs^[I].F3 + Got;
    KObjs^[I].F2 := FoSize[R];
    If FatIoErr Then SetErr(30);
    KReadFile := Not FatIoErr;
    Exit;
  End;
  If KObjs^[I].F4 = -3 Then
  Begin
    KReadFile := VolReadAt(KObjs^[I].F1, KObjs^[I].F3, KObjs^[I].F5, N,
                           Buf, Got);
    R := KObjs^[I].F3 + Got;
    If (KObjs^[I].F3 < 0) And (R >= 0) Then Inc(KObjs^[I].F5);
    KObjs^[I].F3 := R;
    Exit;
  End;
  If KObjs^[I].F3 + N > KObjs^[I].F2 Then N := KObjs^[I].F2 - KObjs^[I].F3;
  If N < 0 Then N := 0;
  R := KObjs^[I].F4;
  If R >= 0 Then MoveMem(RamFiles[R].Data + KObjs^[I].F3, Buf, N)
  Else If N > 0 Then
    If Not CdReadBytes(KObjs^[I].F1, KObjs^[I].F3, N, Buf) Then
    Begin
      SetErr(30);
      Exit;
    End;
  KObjs^[I].F3 := KObjs^[I].F3 + N;
  Got := N;
  KReadFile := True;
End;


Function ReadFile(H, Buf, N, PRead, Ovl : LongInt) : LongInt;
Var Got : LongInt;
Begin
  AppYield;
  ReadFile := Ord(KReadFile(H, Buf, N, Got));
  If PRead <> 0 Then MemL[0:PRead] := Got;
End;

Function KWriteFile(H, Buf, N : LongInt) : LongInt;
Var I, R, E : LongInt; S : String;
Begin
  KWriteFile := -1;
  If IsConsoleH(H) Then
  Begin
    If (ConW >= 0) Or AppConsole Then ConWrite(Buf, N)
    Else
    Begin
      S := '';
      For I := 0 To Min(N, 200) - 1 Do
        If Mem[0:Buf + I] >= 32 Then S := S + Chr(Mem[0:Buf + I]);
      KLog('CON: ' + S);
    End;
    KWriteFile := N;
    Exit;
  End;
  I := KObjOf(H, koFile);
  If (I >= 0) And (KObjs^[I].F4 = -2) Then
  Begin
    KWriteFile := N;                               { NUL }
    Exit;
  End;
  If (I >= 0) And (KObjs^[I].F4 <= -1000) And (KObjs^[I].F5 <> 0) Then
  Begin
    R := -1000 - KObjs^[I].F4;
    FatIoErr := False;
    E := FatWrite(R, KObjs^[I].F3, N, Buf);
    If E < 0 Then E := 0;
    KObjs^[I].F3 := KObjs^[I].F3 + E;
    KObjs^[I].F2 := FoSize[R];
    If (E < N) Or FatIoErr Then
    Begin
      If FatIoErr Then SetErr(29) Else SetErr(112);
      If E = 0 Then Exit;
    End;
    KWriteFile := E;
    Exit;
  End;
  If (I < 0) Or (KObjs^[I].F4 < 0) Then
  Begin
    SetErr(ErrAccessDenied);
    Exit;
  End;
  R := KObjs^[I].F4;
  E := KObjs^[I].F3 + N;
  If Not RamReserve(R, E) Then
  Begin
    SetErr(112);
    Exit;
  End;
  If KObjs^[I].F3 > RamFiles[R].Size Then
    FillMem(RamFiles[R].Data + RamFiles[R].Size, KObjs^[I].F3 -
            RamFiles[R].Size, 0);
  MoveMem(Buf, RamFiles[R].Data + KObjs^[I].F3, N);
  KObjs^[I].F3 := E;
  If E > RamFiles[R].Size Then RamFiles[R].Size := E;
  KObjs^[I].F2 := RamFiles[R].Size;
  RamFiles[R].Time := DosNow;
  KWriteFile := N;
End;

Function WriteFile(H, Buf, N, PWritten, Ovl : LongInt) : LongInt;
Var R : LongInt;
Begin
  AppYield;
  R := KWriteFile(H, Buf, N);
  If PWritten <> 0 Then MemL[0:PWritten] := Max(R, 0);
  WriteFile := Ord(R >= 0);
End;

Function SetFilePointer(H, Dist, PHigh, Method : LongInt) : LongInt;
Var I, P, Lo, Ph, Hi : LongInt;
Begin
  SetFilePointer := -1;
  I := KObjOf(H, koFile);
  If I < 0 Then
  Begin
    SetErr(ErrInvalidHandle);
    Exit;
  End;
  If KObjs^[I].F4 = -3 Then
  Begin
    { volume \\.\C: : position sur 64 bits (F3 bas, F5 haut) }
    If PHigh <> 0 Then Hi := MemL[0:PHigh]
    Else If Dist < 0 Then Hi := -1 Else Hi := 0;
    Case Method Of
      0 : Begin Lo := 0; Ph := 0; End;
      1 : Begin Lo := KObjs^[I].F3; Ph := KObjs^[I].F5; End;
    Else
      Lo := VolSecs[KObjs^[I].F1] Shl 9;
      Ph := VolSecs[KObjs^[I].F1] Shr 23;
    End;
    P := Lo + Dist;
    Ph := Ph + Hi;
    If (((Lo And Dist) Or ((Lo Or Dist) And Not P)) Shr 31) <> 0 Then
      Inc(Ph);
    If Ph < 0 Then
    Begin
      SetErr(131);
      Exit;
    End;
    KObjs^[I].F3 := P; KObjs^[I].F5 := Ph;
    If PHigh <> 0 Then MemL[0:PHigh] := Ph;
    SetFilePointer := P;
    Exit;
  End;
  Case Method Of
    0 : P := Dist;
    1 : P := KObjs^[I].F3 + Dist;
  Else
    P := KObjs^[I].F2 + Dist;
  End;
  If P < 0 Then
  Begin
    SetErr(131);
    Exit;
  End;
  KObjs^[I].F3 := P;
  If PHigh <> 0 Then MemL[0:PHigh] := 0;
  SetFilePointer := P;
End;

