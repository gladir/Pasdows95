{ Dessiner la boite (Full : avec le fond d'ecran) et la recopier a
  l'ecran }
Procedure BootPaint(Full : Boolean);
Var X1, Y1, X2, Y2, I, Y, C : LongInt; R : TRect;
Begin
  SetTarget(Back, 0, 0);
  X1 := BootX; Y1 := BootY; X2 := BootX + BootW - 1; Y2 := BootY + BootH - 1;
  If Full Then
  Begin
    FBar(0, 0, ScrW - 1, ScrH - 1, cTeal);
    { cadre et barre de titre d'une boite de dialogue }
    FBar(X1, Y1, X2, Y2, cSilver);
    Edge(X1, Y1, X2, Y2, cSilver, cBlack);
    Edge(X1 + 1, Y1 + 1, X2 - 1, Y2 - 1, cWhite, cGray);
    FBar(X1 + 3, Y1 + 3, X2 - 3, Y1 + 20, cNavy);
    PaintIcon(icLogo, X1 + 5, Y1 + 4, 16);
    OutBold(X1 + 24, Y1 + 4, Fit(BootTitle, BootW - 32), cWhite);
    PaintIcon(icLogo, X1 + 16, Y1 + 32, 32);
    WrapText(X1 + 60, Y1 + 34, BootW - 76, BootMsg, cBlack, True);
  End;
  Y := Y1 + 50 + BootMsgN * 16;
  For I := 0 To BootN - 1 Do
  Begin
    FBar(X1 + 8, Y - 2, X2 - 8, Y + 15, cSilver);
    Sunken(X1 + 28, Y + 1, X1 + 40, Y + 13, cWhite);
    If I < BootCur Then BootCheck(X1 + 28, Y + 1);
    If I = BootCur Then
    Begin
      Arrow(X1 + 14, Y + 3, 0, cBlack);
      OutBold(X1 + 50, Y, Fit(BootLabel(I), BootW - 60), cBlack);
    End
    Else
    Begin
      If I < BootCur Then C := cBlack Else C := cGray;
      OutTxt(X1 + 50, Y, Fit(BootLabel(I), BootW - 60), C);
    End;
    Y := Y + 20;
  End;
  { barre de progression }
  Y := Y + 6;
  Sunken(X1 + 16, Y, X2 - 16, Y + 17, cWhite);
  C := (X2 - 16 - X1 - 16 - 4) * BootCur Div BootN;
  For I := 0 To C Div 10 - 1 Do
    FBar(X1 + 19 + I * 10, Y + 3, X1 + 19 + I * 10 + 7, Y + 14, cNavy);
  SetR(R, X1, Y1, X2 + 1, Y2 + 1);
  LfbCopy(R);
  { le fond ensuite : la boite apparait sans attendre la recopie de
    tout l'ecran (lente sur une vieille carte graphique) }
  If Full Then
  Begin
    SetR(R, 0, 0, ScrW, Y1);
    LfbCopy(R);
    SetR(R, 0, Y1, X1, Y2 + 1);
    LfbCopy(R);
    SetR(R, X2 + 1, Y1, ScrW, Y2 + 1);
    LfbCopy(R);
    SetR(R, 0, Y2 + 1, ScrW, ScrH);
    LfbCopy(R);
  End;
End;

{ Afficher la boite, etape 0 en cours }
Procedure BootShow;
Begin
  BootCur := 0;
  BootMsgN := WrapText(0, 0, BootW - 76, BootMsg, 0, False);
  If BootMsgN < 2 Then BootMsgN := 2;
  BootH := 50 + BootMsgN * 16 + BootN * 20 + 6 + 18 + 14;
  BootX := (ScrW - BootW) Div 2;
  BootY := (ScrH - BootH) Div 2;
  BootPaint(True);
End;

{ Etapes precedentes terminees (cochees), etape K en cours }
Procedure BootStep(K : LongInt);
Begin
  BootCur := K;
  BootPaint(False);
End;

Procedure SystemLoop;
Var I : LongInt; Busy : Boolean;
Begin
  Repeat
    ProcessInput;
    ChainPoll;
    DosPoll;
    NetPoll;
    RunMMTimers;
    RunWave;
    KPaintAll;
    For I := 0 To MaxWnd - 1 Do
      If Wnds[I].Used And IsChildW(I) And (Wnds[I].IKind <> ikNone) And
         HasUpdate(I) Then DrawCtl(I);
    FlushScreen;
    ReapThreads;
    Busy := False;
    For I := 1 To MaxThread - 1 Do
      If ThreadRunnable(I) Then Busy := True;
    If Busy Then KYield
    Else If (KbHead = KbTail) And (MouHead = MouTail) Then Idle;
  Until False;
End;


BEGIN
  SerialInit;
  LogOn := True;
  KLog('VMM32.VXD : Pasdows 95 ' + KVersion);
  InitGdt;
  InitPic;
  InitIdt;
  InitTimer;
  asm
    sti
  end;
  MemTop := $100000 + MemL[0:BootInfo + $18] * 1024;
  If MemTop > $40000000 Then MemTop := $40000000;
  { Image du programme a son adresse preferee : de 4 Mo a ExeTop. Avec
    moins de 32 Mo, 4 Mo lui suffisent et le tas commence a 8 Mo : il
    commencait toujours a 16 Mo, et avec 16 Mo de memoire il ne restait
    que 544 Ko libres - aucun programme ne pouvait demarrer. Une image
    plus grande est chargee dans le tas (relocalisee), comme une DLL. }
  If MemTop >= $02000000 Then ExeTop := HeapBase Else ExeTop := $00800000;
  HeapInit(ExeTop, MemTop);
  I := KAlloc(SizeOf(TMItemArr));
  Move(I, MItemsP, 4);
  I := KAlloc(SizeOf(TGdiArr));
  Move(I, Gdis, 4);
  Case Mem[0:BootInfo + 3] Mod 5 Of
    1 : Language := _English;
    2 : Language := _Germany;
    3 : Language := _Italian;
    4 : Language := _Spain;
  Else
    Language := _French;
  End;
  OptFlags := MemL[0:BootInfo + $30];
  VideoFromBoot;
  { la boite de progression remplace l'ecran noir des que le mode
    graphique est pret (palette, tampon de l'ecran, police d'IO.SYS) }
  asm
    finit
  end;
  InitKeyTables;
  DefaultPalette;
  SurfNew(Back, ScrW, ScrH);
  BootShow;
  DispiDetect;
  DispW := -1; RebootAskW := -1; DtW := -1;
  TzLoad;
  PsDev := -1;
  SndInit;
  TrayVol := True; MixW0 := -1; AudW := -1; SysW := -1; DevPW := -1;
  FdW := -1; FindW := -1; NoteAskW := -1; NotePend := -1; NoteSel := -1;
  ThreadInit0;
  KImgLo := $100000;
  KImgHi := KImgLo + MemL[0:KImgLo + MemL[0:KImgLo + $3C] + 80];
  If KImgHi > $00400000 Then
    KLog('ATTENTION : image du noyau au-dela de 00400000h (programmes Win32)');
  CursorSetShape(0);
  CurX := ScrW Div 2; CurY := ScrH Div 2;
  BootStep(1);
  AtaInit;
  CdInit;
  BootStep(2);
  FmtAskW := -1; ExpCW := -1;
  FatInit;
  CurDirS := 'D:';
  SysDirInit;
  BootStep(3);
  { ApiTrace := True journalise chaque appel d'API d'un programme Win32
    (nom, appelant, arguments, resultat) sur le port serie COM1 }
  ApiTrace := False;
  LoadEnvironment;
  InitInput;
  ActiveWin := -1; FocusWin := -1; CaptureWin := -1;
  DragWin := -1; PressWin := -1; LastClickW := -1;
  MenuDepth := 0; DeskSel := -1; TaskbarW := -1;
  DeskColor := cTeal;
  InitClasses;
  InitGdi;
  BootStep(4);
  InitExports;
  If ApiTrace Then TraceInit;
  RegInit;
  BootStep(5);
  InitW16;
  InitW16Apis;
  W16Init2;
  BootStep(6);
  NetInit;
  BootStep(7);
  AppProcObj := -1;
  ConW := -1; ConTitle := ''; ConRowsDue := False; ConLastCY := -1;
  ConPalVer := -1;
  ConKeep := False; ConKillReq := False;
  AppConsole := False; ChainObj := -1;
  ChainExec := ''; ChainArgs := ''; ChainRet := ''; ChainRetArgs := '';
  ChainDir := '';
  DeskBuild;
  BootStep(BootN);
  TaskbarW := KCreate(ikTaskbar, '', 0, 0, TaskY, ScrW, TaskH, WS_POPUP,
                      WS_EX_TOPMOST Or WS_EX_TOOLWINDOW);
  ShowW(TaskbarW, True, False);
  LastMinute := -1;
  PreemptOn := True;
  MarkAll;
  FlushScreen;
  CursorDraw;
  KLog('Memoire libre : ' + IntStr(HeapFreeBytes Div 1024) + ' Ko');
  StartupSound;
  SystemLoop;
END.
