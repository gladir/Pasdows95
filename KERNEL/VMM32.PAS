Function SysErrText(Id : LongInt) : String;
Var S : String;
Begin
  Case Id Of
    0 : S := L('L''operation a reussi.', 'The operation completed ' +
              'successfully.', 'Der Vorgang wurde erfolgreich beendet.',
              'Operazione completata.', 'La operacion se completo.');
