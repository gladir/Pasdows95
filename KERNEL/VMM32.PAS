{ VkKeyScan : touche et majuscule d'un caractere (clavier US) }
Function VkKeyScanA(C : LongInt) : LongInt;
Const Sh1 : String[21] = ')!@#$%^&*(';
Var K : LongInt;
Begin
  C := C And 255;
  If (C >= 97) And (C <= 122) Then VkKeyScanA := C - 32
  Else If (C >= 65) And (C <= 90) Then VkKeyScanA := C Or $100
  Else If (C >= 48) And (C <= 57) Then VkKeyScanA := C
  Else
  Begin
    K := Pos(Chr(C), Sh1);
    If K > 0 Then VkKeyScanA := (47 + K) Or $100
    Else
      Case C Of
        32 : VkKeyScanA := 32;
        13 : VkKeyScanA := 13;
        9 : VkKeyScanA := 9;
        8 : VkKeyScanA := 8;
        27 : VkKeyScanA := 27;
        44 : VkKeyScanA := $BC;
        46 : VkKeyScanA := $BE;
        45 : VkKeyScanA := $BD;
        61 : VkKeyScanA := $BB;
        59 : VkKeyScanA := $BA;
        47 : VkKeyScanA := $BF;
      Else
        VkKeyScanA := -1;
      End;
  End;
End;

Function VkKeyScanW(C : LongInt) : LongInt;
Begin
  VkKeyScanW := VkKeyScanA(C And 255);
End;

{ nom d'une touche (raccourcis des menus) }
Function GetKeyNameTextA(LP, Buf, N : LongInt) : LongInt;
Var Sc : LongInt; S : String;
Begin
  Sc := (LP Shr 16) And $1FF;
  Case Sc And $FF Of
    1 : S := 'Echap';
    $0E : S := 'Retour arr.';
    $0F : S := 'Tab';
    $1C : S := 'Entr'#233'e';
    $1D : S := 'Ctrl';
    $2A, $36 : S := 'Maj';
    $38 : S := 'Alt';
    $39 : S := 'Espace';
    $3B..$44 : S := 'F' + IntStr((Sc And $FF) - $3A);
    $57 : S := 'F11';
    $58 : S := 'F12';
    $47 : S := 'Origine';
    $48 : S := 'Haut';
    $49 : S := 'Pg.pr'#233'c';
    $4B : S := 'Gauche';
    $4D : S := 'Droite';
    $4F : S := 'Fin';
    $50 : S := 'Bas';
    $51 : S := 'Pg.suiv';
    $52 : S := 'Inser';
    $53 : S := 'Suppr';
  Else
    S := Chr(MapVirtualKeyA(MapVirtualKeyA(Sc And $FF, 1), 2) And 255);
    If S = #0 Then S := '';
  End;
  Sc := PutFmt(S, Buf, N) - 1;
  If Sc < 0 Then Sc := 0;
  GetKeyNameTextA := Sc;
End;

