Begin
  timeBeginPeriod := 0;
End;

Function timeEndPeriod(P : LongInt) : LongInt;
Begin
  timeEndPeriod := 0;
End;

Function timeSetEvent(Delay, Res, Proc, User, Flags : LongInt) : LongInt;
Var I : LongInt;
Begin
  timeSetEvent := 0;
  For I := 0 To MaxMMTimer - 1 Do
    If Not MMTimers[I].Used Then
    Begin
      MMTimers[I].Used := True;
      MMTimers[I].Delay := Max(1, Delay);
      MMTimers[I].Next := Ticks + Max(1, Delay);
      MMTimers[I].Proc := Proc;
      MMTimers[I].User := User;
      MMTimers[I].Flags := Flags;
      MMTimers[I].PrcId := CurProc;
      timeSetEvent := I + 1;
      Exit;
    End;
End;

Function timeKillEvent(Id : LongInt) : LongInt;
Begin
  timeKillEvent := 97;
  If (Id >= 1) And (Id <= MaxMMTimer) Then
  Begin
    MMTimers[Id - 1].Used := False;
    timeKillEvent := 0;
  End;
End;

{ ------------------------------------------------------------------ }
{ Carte son muette : les tampons waveOut sont acceptes et rendus      }
{ (WHDR_DONE, WOM_DONE) au rythme reel de leur duree, sans emettre de }
{ son ; les programmes synchronises sur le son avancent normalement.  }
{ ------------------------------------------------------------------ }

Const
  MaxWave = 4;
  MaxWaveQ = 64;
  HWaveBase = $9000;
  WOM_OPEN = $3BB; WOM_CLOSE = $3BC; WOM_DONE = $3BD;

Type
  TWaveDev = Record
    Used : Boolean;
    Paused : Boolean;
    Rate, Cb, Inst, CbType, QN, LastEnd, PauseAt : LongInt;
    PrcId : LongInt;               { processus qui l'a ouvert }
    { position de lecture : octets ecrits, base (octets, instant) et
      alignement des blocs (waveOutGetPosition) }
    Wr, PB, PT, Blk : LongInt;
  End;

Var
  WaveDevs : Array[0..MaxWave - 1] Of TWaveDev;
  { files des tampons (peripherique I : entrees I * MaxWaveQ + K) }
  WaveQHdr, WaveQEnd : Array[0..MaxWave * MaxWaveQ - 1] Of LongInt;
  InWave : Boolean;

{ ------------------------------------------------------------------ }
{ Cartes son : Sound Blaster (1.x, 2.0, Pro, 16) et AdLib (OPL2)      }
{ ------------------------------------------------------------------ }
{ Comme les pilotes de Windows 95 : la carte est trouvee par la
  variable BLASTER (A220 I5 D1 H5) ou en sondant 220h-280h (remise a
  zero du DSP, AAh), sa version par la commande E1h ; une Sound Blaster
  16 donne son IRQ et ses canaux DMA par son mixeur (80h, 81h). Le son
  waveOut passe par un tampon DMA de 32 Ko en 90000h (sous la pile du
  noyau, dans une meme page de 64 Ko) lu en boucle (auto-init) : la
  carte interrompt a chaque moitie jouee, que le gestionnaire remplit
  aussitot avec la suite des tampons du programme (ou du silence). Un
  tampon WAVEHDR est rendu quand ses octets ont ete joues. La Sound
  Blaster 16 joue directement le format du programme (8/16 bits, mono
  ou stereo) ; les cartes 8 bits recoivent du 8 bits mono converti.
  L'AdLib (et l'OPL2 des Sound Blaster) sert de synthetiseur MIDI FM. }

Const
  SbDmaBuf = $90000;
  SbDmaLen = $8000;
  SbHalf = $4000;
  MixLines = 5;              { general, wave, MIDI, CD, ligne }

Var
  SbOk, Sb16, OplOk : Boolean;
  SbBase, SbIrq, SbDma8, SbDma16, SbVer : LongInt;
  SbPlaying, SbPaused : Boolean;
  DSOwn : Boolean;                       { carte prise par DirectSound }
  SbDev : LongInt;                       { peripherique waveOut sur la carte }
  SbBits, SbChans, SbRate : LongInt;     { format du programme }
  SbOBits, SbOChans : LongInt;           { format envoye a la carte }
  SbORate : LongInt;                     { frequence de la carte }
  SbStep, SbFrac : LongInt;              { pas de conversion (1/4096) }
  SndKind : LongInt;                     { 1 SB, 2 AC'97, 3 HDA, 4 ES }
  SbNext : LongInt;                      { moitie a remplir (0/1) }
  SbQueued, SbPlayed : LongInt;          { octets (format carte) }
  SbCopyK, SbCopyOff : LongInt;          { tampon et position en copie }
  SbSilent : LongInt;                    { octets de silence de suite }
  SbIrqs : LongInt;
  MixVolL, MixVolR : Array[0..MixLines - 1] Of LongInt;   { 0..255 }
  MixMute : Array[0..MixLines - 1] Of Boolean;
  OplVoiceNote, OplVoiceChan, OplVoiceAge : Array[0..8] Of LongInt;
  OplAge : LongInt;
  MidiOpen : Boolean;

Const
  SynMax = 24;

Var
  SynNote, SynChan, SynPhase, SynStep : Array[0..SynMax - 1] Of LongInt;
  SynAmp, SynDec, SynWave, SynAge, SynRel : Array[0..SynMax - 1] Of LongInt;
  SynSine : Array[0..255] Of LongInt;            { -32767..32767 }
  SynFreq : Array[0..127] Of LongInt;            { Hz x 16 }
  SynCount, SynAgeC, SynNoise : LongInt;
  SynOk : Boolean;

Const
  skSb = 1; skAc97 = 2; skHda = 3; skEs = 4;
  HdaMaxDac = 8;
  PcmNCh = 32;                     { blocs du tampon (cartes PCI) }
  PcmChL = 1024;                   { octets par bloc }

Var
  PcmIo, PcmIo2, PcmMmio, PcmIrq, PcmId, PcmCh, PcmVra : LongInt;
  PcmMem, PcmBus, PcmDev, PcmFn, PcmCtl : LongInt;
  PcmName, PcmMfg : String[63];
  HdaCorbN, HdaRirbN, HdaWp, HdaRp, HdaCodec, HdaSd, HdaAfg : LongInt;
  HdaDacN : LongInt;
  HdaDac, HdaOff : Array[0..HdaMaxDac - 1] Of LongInt;
  HdaCaps : Array[0..127] Of LongInt;
  HdaWLo, HdaWHi : LongInt;

Procedure PcmVol; Forward;

Function IntOff : LongInt;
Var F : LongInt;
Begin
  asm
    pushfd
    pop eax
    mov F,eax
    cli
  end;
  IntOff := F;
End;

Procedure IntRestore(F : LongInt);
Begin
  If (F And $200) <> 0 Then
    asm
      sti
    end;
End;

Procedure SbDelay(N : LongInt);
Var I, X : LongInt;
Begin
  For I := 1 To N Do X := Port[$80];
End;

Function SbWriteDsp(V : LongInt) : Boolean;
Var N : LongInt;
Begin
  N := 0;
  While ((Port[SbBase + $C] And $80) <> 0) And (N < 100000) Do Inc(N);
  Port[SbBase + $C] := V;
  SbWriteDsp := N < 100000;
End;

Function SbReadDsp : LongInt;
Var N : LongInt;
Begin
  N := 0;
  While ((Port[SbBase + $E] And $80) = 0) And (N < 100000) Do Inc(N);
  If N >= 100000 Then SbReadDsp := -1 Else SbReadDsp := Port[SbBase + $A];
End;

Function SbReset(B : LongInt) : Boolean;
Var N : LongInt;
Begin
  SbBase := B;
  Port[B + 6] := 1;
  SbDelay(8);
  Port[B + 6] := 0;
  N := 0;
  While ((Port[B + $E] And $80) = 0) And (N < 20000) Do Inc(N);
  SbReset := (N < 20000) And (Port[B + $A] = $AA);
End;

Procedure MixW(R, V : LongInt);
Begin
  Port[SbBase + 4] := R;
  Port[SbBase + 5] := V;
End;

Function MixR(R : LongInt) : LongInt;
Begin
  Port[SbBase + 4] := R;
  MixR := Port[SbBase + 5];
End;

{ Valeur numerique apres la lettre C de la variable BLASTER (-1) }
Function BlasterVal(Const B : String; C : Char; Hex : Boolean) : LongInt;
Var I, V, D : LongInt; Ok : Boolean;
Begin
  BlasterVal := -1;
  I := 1;
  While I <= Length(B) Do
  Begin
    If (UpCase(B[I]) = C) And ((I = 1) Or (B[I - 1] = ' ')) Then
    Begin
      V := 0; Ok := False; Inc(I);
      While (I <= Length(B)) And (B[I] <> ' ') Do
      Begin
        D := -1;
        If (B[I] >= '0') And (B[I] <= '9') Then D := Ord(B[I]) - 48
        Else If Hex And (UpCase(B[I]) >= 'A') And (UpCase(B[I]) <= 'F') Then
          D := Ord(UpCase(B[I])) - 55;
        If D < 0 Then Break;
        If Hex Then V := V * 16 + D Else V := V * 10 + D;
        Ok := True; Inc(I);
      End;
      If Ok Then BlasterVal := V;
      Exit;
    End;
    Inc(I);
  End;
End;

{ OPL2 (AdLib) : registre R = V, avec les delais de la puce }
Procedure OplW(R, V : LongInt);
Var I, X : LongInt;
Begin
  Port[$388] := R;
  For I := 1 To 6 Do X := Port[$388];
  Port[$389] := V;
  For I := 1 To 35 Do X := Port[$388];
End;

Function OplDetect : Boolean;
Var S1, S2, I, X : LongInt;
Begin
  OplW(4, $60); OplW(4, $80);
  S1 := Port[$388];
  OplW(2, $FF); OplW(4, $21);
  For I := 1 To 400 Do X := Port[$80];
  S2 := Port[$388];
  OplW(4, $60); OplW(4, $80);
  OplDetect := ((S1 And $E0) = 0) And ((S2 And $E0) = $C0);
End;

Function SbName : String;
Begin
  If Not SbOk Then SbName := ''
  Else If SndKind >= 2 Then SbName := PcmName
  Else If Sb16 Then SbName := 'Sound Blaster 16'
  Else If SbVer >= $300 Then SbName := 'Sound Blaster Pro'
  Else If SbVer >= $200 Then SbName := 'Sound Blaster 2.0'
  Else SbName := 'Sound Blaster';
End;

{ Mixeur : appliquer les volumes (0..255) et les sourdines }
Procedure SndApplyVol;
Var I, L, R : LongInt;
  Reg16, RegPro : Array[0..MixLines - 1] Of LongInt;
Begin
  If Not SbOk Then Exit;
  If SndKind >= 2 Then
  Begin
    PcmVol;
    Exit;
  End;
  Reg16[0] := $30; Reg16[1] := $32; Reg16[2] := $34; Reg16[3] := $36;
  Reg16[4] := $38;
  RegPro[0] := $22; RegPro[1] := $04; RegPro[2] := $26; RegPro[3] := $28;
  RegPro[4] := $2E;
  For I := 0 To MixLines - 1 Do
  Begin
    L := MixVolL[I]; R := MixVolR[I];
    If MixMute[I] Or (MixMute[0] And (I = 0)) Then
    Begin
      L := 0; R := 0;
    End;
    If Sb16 Then
    Begin
      MixW(Reg16[I], (L Shr 3) Shl 3);
      MixW(Reg16[I] + 1, (R Shr 3) Shl 3);
    End
    Else If SbVer >= $300 Then
      MixW(RegPro[I], ((L Shr 5) Shl 5) Or ((R Shr 5) Shl 1) Or $11);
  End;
End;

{ Canal DMA C (0-3 : 8 bits, 5-7 : 16 bits) : lecture memoire -> carte,
  en boucle, sur SbDmaLen octets en SbDmaBuf }
Procedure DmaStart(C : LongInt);
Const Pg8 : Array[0..3] Of LongInt = ($87, $83, $81, $82);
      Pg16 : Array[5..7] Of LongInt = ($8B, $89, $8A);
Var A, N, K : LongInt;
Begin
  A := SbDmaBuf;
  If C < 4 Then
  Begin
    N := SbDmaLen - 1;
    Port[$0A] := 4 Or C;
    Port[$0C] := 0;
    Port[$0B] := $58 Or C;
    Port[C * 2] := A And 255;
    Port[C * 2] := (A Shr 8) And 255;
    Port[Pg8[C]] := (A Shr 16) And 255;
    Port[C * 2 + 1] := N And 255;
    Port[C * 2 + 1] := (N Shr 8) And 255;
    Port[$0A] := C;
  End
  Else
  Begin
    K := C - 4;
    N := SbDmaLen Div 2 - 1;
    Port[$D4] := 4 Or K;
    Port[$D8] := 0;
    Port[$D6] := $58 Or K;
    Port[$C0 + K * 4] := (A Shr 1) And 255;
    Port[$C0 + K * 4] := (A Shr 9) And 255;
    Port[Pg16[C]] := (A Shr 16) And $FE;
    Port[$C2 + K * 4] := N And 255;
    Port[$C2 + K * 4] := (N Shr 8) And 255;
    Port[$D4] := K;
  End;
End;

Procedure DmaStop(C : LongInt);
Begin
  If C < 4 Then Port[$0A] := 4 Or C Else Port[$D4] := 4 Or (C - 4);
End;

{ Remplir la moitie H du tampon DMA avec la suite des tampons du
  peripherique SbDev (format carte), sinon du silence }
Procedure DSMixInto(D, N : LongInt); Forward;
Procedure SynMixInto(D, N : LongInt); Forward;
Function SynBusy : Boolean; Forward;

Procedure SbFill0(Ofs, N : LongInt);
Var D, P, Hdr, Len, B, Got, SBy, OBy, K, Fr, L, R, Q : LongInt;
Begin
  D := SbDmaBuf + Ofs;
  P := 0; Got := 0;
  SBy := (SbBits Div 8) * SbChans;               { octets par trame }
  OBy := (SbOBits Div 8) * SbOChans;
  While (P < N) And (SbDev >= 0) And
        (SbCopyK < WaveDevs[SbDev].QN) Do
  Begin
    Hdr := WaveQHdr[SbDev * MaxWaveQ + SbCopyK];
    Len := MemL[0:Hdr + 4];
    B := MemL[0:Hdr];
    If (SbOBits = SbBits) And (SbOChans = SbChans) And
       (SbORate = SbRate) Then
    Begin
      K := Min(Len - SbCopyOff, N - P);
      If K > 0 Then MoveMem(B + SbCopyOff, D + P, K);
      SbCopyOff := SbCopyOff + Max(K, 0); P := P + Max(K, 0);
    End
    Else
    Begin
      { conversion : 8/16 bits, mono/stereo, frequence (pas SbStep) }
      While (SbCopyOff + SBy <= Len) And (P + OBy <= N) Do
      Begin
        Fr := B + SbCopyOff;
        If SbBits = 16 Then
        Begin
          L := MemW[0:Fr]; If L >= 32768 Then L := L - 65536;
          R := L;
          If SbChans = 2 Then
          Begin
            R := MemW[0:Fr + 2]; If R >= 32768 Then R := R - 65536;
          End;
        End
        Else
        Begin
          L := (Mem[0:Fr] - 128) * 256; R := L;
          If SbChans = 2 Then R := (Mem[0:Fr + 1] - 128) * 256;
        End;
        Q := D + P;
        If SbOBits = 16 Then
        Begin
          If SbOChans = 2 Then
          Begin
            MemW[0:Q] := L And $FFFF; MemW[0:Q + 2] := R And $FFFF;
          End
          Else MemW[0:Q] := ((L + R) Div 2) And $FFFF;
        End
        Else If SbOChans = 2 Then
        Begin
          Mem[0:Q] := L Div 256 + 128; Mem[0:Q + 1] := R Div 256 + 128;
        End
        Else Mem[0:Q] := (L + R) Div 512 + 128;
        P := P + OBy;
        SbFrac := SbFrac + SbStep;
        While SbFrac >= 4096 Do
        Begin
          SbCopyOff := SbCopyOff + SBy;
          SbFrac := SbFrac - 4096;
        End;
      End;
      If SbCopyOff + SBy > Len Then SbCopyOff := Len;
    End;
    If SbCopyOff >= Len Then
    Begin
      { tampon entierement copie : rendu quand cet octet sera joue }
      WaveQEnd[SbDev * MaxWaveQ + SbCopyK] := SbQueued + P;
      Inc(SbCopyK);
      SbCopyOff := 0;
    End;
    Got := 1;
  End;
  If P < N Then
  Begin
    If SbOBits = 16 Then FillMem(D + P, N - P, 0)
    Else FillMem(D + P, N - P, $80);
  End;
  If Got = 0 Then SbSilent := SbSilent + N Else SbSilent := 0;
  DSMixInto(D, N);
  SynMixInto(D, N);
  SbQueued := SbQueued + N;
End;

{ Remplir une moitie du tampon DMA : les WAVEHDR et les donnees sont
  lus dans l'espace d'adresses du processus qui a ouvert la carte }
Procedure SbFill1(Ofs, N : LongInt);
Var Old, New : LongInt;
Begin
  Old := Cr3Now;
  New := Old;
  If (SbDev >= 0) And WaveDevs[SbDev].Used Then
    New := ProcCr3(WaveDevs[SbDev].PrcId);
  If New <> Old Then SetCr3(New);
  SbFill0(Ofs, N);
  If New <> Old Then SetCr3(Old);
End;

{ Interruption de la carte : une moitie vient d'etre jouee }
Procedure SbIsr;
Var X : LongInt;
Begin
  If SbOBits = 16 Then X := Port[SbBase + $F] Else X := Port[SbBase + $E];
  Inc(SbIrqs);
  If Not SbPlaying Then Exit;
  SbPlayed := SbPlayed + SbHalf;
  SbFill1(SbNext * SbHalf, SbHalf);
  SbNext := 1 - SbNext;
End;

Procedure IrqSound; Interrupt;
Var C : LongInt;
Begin
  { interruption pendant un programme DOS (mode V86) : le tampon DMA
    (90000h) n'est visible qu'avec les pages du noyau }
  C := 0;
  If KPd <> 0 Then
  Begin
    asm
      mov eax,cr3
      mov C,eax
      mov eax,KPd
      mov cr3,eax
    end;
  End;
  SbIsr;
  If SbIrq >= 8 Then Port[$A0] := $20;
  Port[$20] := $20;
  If (C <> 0) And (C <> KPd) Then
  Begin
    asm
      mov eax,C
      mov cr3,eax
    end;
  End;
End;

{ ------------------------------------------------------------------ }
{ Cartes son PCI : AC'97 (Intel ICH), HD Audio (Intel), ES1370       }
{ ------------------------------------------------------------------ }
{ Les cartes PCI lisent elles-memes la memoire (bus maitre) : le meme
  tampon de 32 Ko en 90000h, en deux moities jouees en boucle. Sans
  interruption : toutes les 4 ms, la minuterie lit la position de
  lecture de la carte ; une moitie finie est aussitot remplie avec la
  suite des tampons (comme l'interruption de la Sound Blaster).
  AC'97 (VirtualBox, QEMU) : liste de 32 descripteurs (moities
  alternees), 16 bits stereo, frequence variable (VRA) ou 48 000 Hz.
  HD Audio : commandes au codec par les anneaux CORB et RIRB ; les
  broches de sortie analogiques et leur convertisseur (DAC) sont
  cherches dans le graphe du codec, puis le chemin est ouvert (choix
  des entrees, amplis sans sourdine) ; premier flux de sortie, 16 bits
  stereo. ES1370 (Sound Blaster PCI 64) : canal DAC2 en boucle, format
  du programme, frequence 1 411 200 / (diviseur + 2). Les autres
  formats et frequences sont convertis au remplissage (SbFill0). }

Function PInL(P : LongInt) : LongInt;
Var R : LongInt;
Begin
  asm
    mov edx,P
    in eax,dx
    mov R,eax
  end;
  PInL := R;
End;

Procedure POutL(P, V : LongInt);
Begin
  asm
    mov edx,P
    mov eax,V
    out dx,eax
  end;
End;

{ attente bornee (ms) : vrai si la condition est remplie }
Function PcmWaitB(A, Mask, Want, Ms : LongInt; Mmio : Boolean) : Boolean;
Var T, V : LongInt;
Begin
  T := Ticks + Ms;
  Repeat
    If Mmio Then V := MemL[0:A] Else V := Port[A];
    If (V And Mask) = Want Then
    Begin
      PcmWaitB := True;
      Exit;
    End;
  Until Ticks > T;
  PcmWaitB := False;
End;

{ ------------------------------- AC'97 ---------------------------- }

Function Ac97Init : Boolean;
Var K : LongInt;
Begin
  Ac97Init := False;
  PcmIo := PciRead(PcmBus, PcmDev, PcmFn, $10) And $FFFC;   { NAMBAR }
  PcmIo2 := PciRead(PcmBus, PcmDev, PcmFn, $14) And $FFFC;  { NABMBAR }
  If (PcmIo = 0) Or (PcmIo2 = 0) Then Exit;
  K := PciRead(PcmBus, PcmDev, PcmFn, 4);
  PciWrite(PcmBus, PcmDev, PcmFn, 4, (K And $FFFF) Or 5);
  { remise a zero a froid du lien, puis codec pret (bit 8) }
  If (PInL(PcmIo2 + $30) And $100) = 0 Then
  Begin
    POutL(PcmIo2 + $2C, 0);
    KDelay(2);
    POutL(PcmIo2 + $2C, 2);
    K := Ticks + 300;
    While ((PInL(PcmIo2 + $30) And $100) = 0) And (Ticks < K) Do Idle;
  End
  Else POutL(PcmIo2 + $2C, 2);
  If (PInL(PcmIo2 + $30) And $100) = 0 Then
    KLog('Son : codec AC''97 non pret');
  PortW[PcmIo] := 0;                              { remise a zero }
  KDelay(5);
  PortW[PcmIo + $02] := 0;                        { general }
  PortW[PcmIo + $04] := 0;                        { casque }
  PortW[PcmIo + $18] := $0808;                    { sortie PCM }
  PcmVra := 0;
  If (PortW[PcmIo + $28] And 1) <> 0 Then
  Begin
    PortW[PcmIo + $2A] := PortW[PcmIo + $2A] Or 1;
    PcmVra := 1;
  End;
  { 32 descripteurs de 1 Ko : tout le tampon }
  For K := 0 To PcmNCh - 1 Do
  Begin
    MemL[0:PcmMem + K * 8] := SbDmaBuf + K * PcmChL;
    MemL[0:PcmMem + K * 8 + 4] := PcmChL Div 2;     { echantillons }
  End;
  Ac97Init := True;
End;

Procedure Ac97Start;
Var R : LongInt;
Begin
  SbOBits := 16; SbOChans := 2;
  R := Max(8000, Min(SbRate, 48000));
  If PcmVra <> 0 Then
  Begin
    PortW[PcmIo + $2C] := R;
    R := PortW[PcmIo + $2C];
    If R = 0 Then R := 48000;
  End
  Else R := 48000;
  SbORate := R;
  Port[PcmIo2 + $1B] := 0;
  Port[PcmIo2 + $1B] := 2;                        { remise a zero }
  PcmWaitB(PcmIo2 + $1B, 2, 0, 20, False);
  POutL(PcmIo2 + $10, PcmMem);                    { BDBAR }
  PortW[PcmIo2 + $16] := $1C;
End;

Procedure Ac97Stop;
Begin
  Port[PcmIo2 + $1B] := 0;
  Port[PcmIo2 + $1B] := 2;
End;

{ blocs consommes depuis PcmCh ; le controleur s'arrete au dernier
  descripteur valide (LVI) s'il rattrape les donnees }
Function Ac97Used : LongInt;
Var Civ, Sr, N : LongInt;
Begin
  Civ := Port[PcmIo2 + $14] And 31;
  Sr := PortW[PcmIo2 + $16];
  N := (Civ - PcmCh + PcmNCh) Mod PcmNCh;
  If (Sr And 1) <> 0 Then
  Begin
    { arrete : le descripteur LVI est lui aussi joue }
    N := (Civ + 1 - PcmCh + PcmNCh) Mod PcmNCh;
    If N = 0 Then N := PcmNCh;
  End;
  If (Sr And $1C) <> 0 Then PortW[PcmIo2 + $16] := Sr And $1C;
  Ac97Used := N;
End;

{ attenuation AC'97 (0..31, bit 15 : sourdine) du volume V (0..255) }
Function Ac97Att(L, R : LongInt; M : Boolean) : LongInt;
Begin
  If M Or ((L = 0) And (R = 0)) Then Ac97Att := $8000
  Else Ac97Att := (((255 - L) * 31) Div 255) Shl 8 +
                  ((255 - R) * 31) Div 255;
End;

{ ------------------------------- HD Audio ------------------------- }

Function HdaRL(R : LongInt) : LongInt;
Begin
  HdaRL := MemL[0:PcmMmio + R];
End;

Procedure HdaWL(R, V : LongInt);
Begin
  MemL[0:PcmMmio + R] := V;
End;

{ commande au codec (CORB) et reponse (RIRB) ; -1 sans reponse }
Function HdaCmd(Nid, Verb : LongInt) : LongInt;
Var T : LongInt;
Begin
  HdaWp := (HdaWp + 1) Mod HdaCorbN;
  MemL[0:PcmMem + $400 + HdaWp * 4] := (HdaCodec Shl 28) Or
    ((Nid And $7F) Shl 20) Or (Verb And $FFFFF);
  MemW[0:PcmMmio + $48] := HdaWp;
  T := Ticks + 50;
  While ((MemW[0:PcmMmio + $58] And $FF) = HdaRp) And (Ticks <= T) Do;
  If (MemW[0:PcmMmio + $58] And $FF) = HdaRp Then
  Begin
    HdaCmd := -1;
    Exit;
  End;
  HdaRp := (HdaRp + 1) Mod HdaRirbN;
  HdaCmd := MemL[0:PcmMem + $800 + HdaRp * 8];
  { compteur de reponses remis a zero (sinon le controleur attend) }
  Mem[0:PcmMmio + $5D] := 5;
End;

Function HdaType(N : LongInt) : LongInt;
Begin
  If (N < HdaWLo) Or (N > HdaWHi) Then HdaType := -1
  Else HdaType := (HdaCaps[N] Shr 20) And 15;
End;

{ gain 0 dB d'un ampli (pas de decalage), du noeud ou du groupe }
Function HdaAmp0(N, Par : LongInt) : LongInt;
Var C : LongInt;
Begin
  C := HdaCmd(N, $F0000 Or Par);
  If (C = 0) Or (C = -1) Then C := HdaCmd(HdaAfg, $F0000 Or Par);
  If C = -1 Then C := 0;
  HdaAmp0 := C And $7F;
End;

{ Chemin du noeud N vers un DAC (profondeur D) : l'ouvre et rend le
  DAC (0 sans chemin) }
Function HdaPath(N, D : LongInt) : LongInt;
Var T, L, I, R, C, Dac, Long : LongInt;
Begin
  HdaPath := 0;
  T := HdaType(N);
  If T = 0 Then
  Begin
    If (HdaCaps[N] And $200) = 0 Then HdaPath := N;   { pas numerique }
    Exit;
  End;
  If (D > 4) Or ((T <> 2) And (T <> 3) And (T <> 4)) Then Exit;
  L := HdaCmd(N, $F000E);
  If L = -1 Then Exit;
  Long := (L Shr 7) And 1;
  L := L And $7F;
  R := 0;
  For I := 0 To L - 1 Do
  Begin
    If Long = 0 Then
    Begin
      If (I And 3) = 0 Then R := HdaCmd(N, $F0200 Or I);
      C := (R Shr ((I And 3) * 8)) And $7F;
    End
    Else
    Begin
      If (I And 1) = 0 Then R := HdaCmd(N, $F0200 Or I);
      C := (R Shr ((I And 1) * 16)) And $7F;
    End;
    Dac := HdaPath(C, D + 1);
    If Dac <> 0 Then
    Begin
      If ((T = 3) Or (T = 4)) And (L > 1) Then HdaCmd(N, $70100 Or I);
      If (T = 2) And ((HdaCaps[N] And 2) <> 0) Then  { entree du melangeur }
        HdaCmd(N, $37000 Or (I Shl 8) Or HdaAmp0(N, $0D));
      If (T <> 4) And ((HdaCaps[N] And 4) <> 0) Then
        HdaCmd(N, $3B000 Or HdaAmp0(N, $12));
      HdaPath := Dac;
      Exit;
    End;
  End;
End;

Function HdaInit : Boolean;
Var K, St, Gcap, R, N, Pc, Cfg, Dt, Dac, J : LongInt; Have : Boolean;
Begin
  HdaInit := False;
  K := PciRead(PcmBus, PcmDev, PcmFn, $10);
  If (K And 1) <> 0 Then Exit;
  PcmMmio := K And LongInt($FFFFFFF0);
  If PcmMmio = 0 Then Exit;
  K := PciRead(PcmBus, PcmDev, PcmFn, 4);
  PciWrite(PcmBus, PcmDev, PcmFn, 4, (K And $FFFF) Or 6);
  { remise a zero du controleur (GCTL.CRST), puis enumeration }
  HdaWL($08, HdaRL($08) And Not 1);
  PcmWaitB(PcmMmio + $08, 1, 0, 100, True);
  KDelay(1);
  HdaWL($08, HdaRL($08) Or 1);
  If Not PcmWaitB(PcmMmio + $08, 1, 1, 100, True) Then Exit;
  KDelay(10);
  St := MemW[0:PcmMmio + $0E];
  If St = 0 Then
  Begin
    KLog('Son : HD Audio sans codec');
    Exit;
  End;
  HdaCodec := 0;
  While (St And (1 Shl HdaCodec)) = 0 Do Inc(HdaCodec);
  Gcap := MemW[0:PcmMmio];
  If ((Gcap Shr 12) And 15) = 0 Then Exit;
  HdaSd := $80 + ((Gcap Shr 8) And 15) * $20;      { 1er flux de sortie }
  { anneaux CORB (PcmMem + 400h) et RIRB (PcmMem + 800h) }
  Mem[0:PcmMmio + $4C] := 0; Mem[0:PcmMmio + $5C] := 0;
  KDelay(1);
  K := Mem[0:PcmMmio + $4E];
  If (K And $40) <> 0 Then Begin HdaCorbN := 256; R := 2; End
  Else If (K And $20) <> 0 Then Begin HdaCorbN := 16; R := 1; End
  Else Begin HdaCorbN := 2; R := 0; End;
  Mem[0:PcmMmio + $4E] := (K And $F0) Or R;
  K := Mem[0:PcmMmio + $5E];
  If (K And $40) <> 0 Then Begin HdaRirbN := 256; R := 2; End
  Else If (K And $20) <> 0 Then Begin HdaRirbN := 16; R := 1; End
  Else Begin HdaRirbN := 2; R := 0; End;
  Mem[0:PcmMmio + $5E] := (K And $F0) Or R;
  HdaWL($40, PcmMem + $400); HdaWL($44, 0);
  HdaWL($50, PcmMem + $800); HdaWL($54, 0);
  MemW[0:PcmMmio + $4A] := $8000;                  { CORBRP a zero }
  PcmWaitB(PcmMmio + $48, LongInt($80000000), LongInt($80000000), 5,
           True);
  MemW[0:PcmMmio + $4A] := 0;
  PcmWaitB(PcmMmio + $48, LongInt($80000000), 0, 5, True);
  MemW[0:PcmMmio + $48] := 0; HdaWp := 0;
  MemW[0:PcmMmio + $58] := $8000; HdaRp := 0;      { RIRBWP a zero }
  MemW[0:PcmMmio + $5A] := $FF;                    { RINTCNT }
  Mem[0:PcmMmio + $4C] := 2; Mem[0:PcmMmio + $5C] := 2;
  KDelay(1);
  { groupe de fonctions audio (AFG) }
  R := HdaCmd(0, $F0004);
  If R = -1 Then
  Begin
    KLog('Son : HD Audio, le codec ne repond pas');
    Exit;
  End;
  HdaAfg := 0;
  For N := (R Shr 16) And $7F To ((R Shr 16) And $7F) + (R And $7F) - 1 Do
    If (HdaAfg = 0) And ((HdaCmd(N, $F0005) And $FF) = 1) Then
      HdaAfg := N;
  If HdaAfg = 0 Then
  Begin
    KLog('Son : HD Audio sans groupe audio');
    Exit;
  End;
  HdaCmd(HdaAfg, $70500);                         { alimentation D0 }
  R := HdaCmd(HdaAfg, $F0004);
  HdaWLo := (R Shr 16) And $7F;
  HdaWHi := Min(127, HdaWLo + (R And $7F) - 1);
  For N := HdaWLo To HdaWHi Do
  Begin
    HdaCaps[N] := HdaCmd(N, $F0009);
    If HdaCaps[N] = -1 Then HdaCaps[N] := 0;
    If (HdaCaps[N] And $400) <> 0 Then HdaCmd(N, $70500);
  End;
  { broches de sortie analogiques (sortie ligne, haut-parleur, casque) }
  HdaDacN := 0;
  For N := HdaWLo To HdaWHi Do
    If (HdaType(N) = 4) And ((HdaCaps[N] And $200) = 0) Then
    Begin
      Pc := HdaCmd(N, $F000C);
      Cfg := HdaCmd(N, $F1C00);
      Dt := (Cfg Shr 20) And 15;
      If (Pc <> -1) And ((Pc And $10) <> 0) And
         (((Cfg Shr 30) And 3) <> 1) And (Dt <= 2) Then
      Begin
        Dac := HdaPath(N, 0);
        If Dac <> 0 Then
        Begin
          If (Dt = 2) And ((Pc And 8) <> 0) Then HdaCmd(N, $707C0)
          Else HdaCmd(N, $70740);
          If (Pc And $10000) <> 0 Then HdaCmd(N, $70C02);    { EAPD }
          If (HdaCaps[N] And 4) <> 0 Then
            HdaCmd(N, $3B000 Or HdaAmp0(N, $12));
          Have := False;
          For J := 0 To HdaDacN - 1 Do
            If HdaDac[J] = Dac Then Have := True;
          If Not Have And (HdaDacN < HdaMaxDac) Then
          Begin
            HdaDac[HdaDacN] := Dac;
            HdaOff[HdaDacN] := HdaAmp0(Dac, $12);
            Inc(HdaDacN);
          End;
        End;
      End;
    End;
  If HdaDacN = 0 Then
  Begin
    KLog('Son : HD Audio, aucune sortie analogique');
    Exit;
  End;
  For J := 0 To HdaDacN - 1 Do HdaCmd(HdaDac[J], $70610); { flux 1 }
  HdaInit := True;
End;

{ format de flux HD Audio (16 bits stereo) le plus proche de R }
Function HdaFmt(R : LongInt; Var Act : LongInt) : LongInt;
Var F : LongInt;
Begin
  Act := R;
  Case R Of
    8000 : F := $0500;
    11025 : F := $4300;
    12000 : F := $0300;
    16000 : F := $0200;
    22050 : F := $4100;
    24000 : F := $0100;
    32000 : F := $0A00;
    44100 : F := $4000;
    48000 : F := $0000;
  Else
    F := 0; Act := 48000;
  End;
  HdaFmt := F Or $11;
End;

Procedure HdaStart;
Var F, J, A : LongInt;
Begin
  SbOBits := 16; SbOChans := 2;
  F := HdaFmt(SbRate, A);
  SbORate := A;
  HdaWL(HdaSd, 0);
  PcmWaitB(PcmMmio + HdaSd, 2, 0, 10, True);
  HdaWL(HdaSd, 1);                                 { remise a zero }
  PcmWaitB(PcmMmio + HdaSd, 1, 1, 10, True);
  HdaWL(HdaSd, 0);
  PcmWaitB(PcmMmio + HdaSd, 1, 0, 10, True);
  For J := 0 To 1 Do
  Begin
    MemL[0:PcmMem + J * 16] := SbDmaBuf + J * SbHalf;
    MemL[0:PcmMem + J * 16 + 4] := 0;
    MemL[0:PcmMem + J * 16 + 8] := SbHalf;
    MemL[0:PcmMem + J * 16 + 12] := 0;
  End;
  HdaWL(HdaSd + $18, PcmMem); HdaWL(HdaSd + $1C, 0);
  HdaWL(HdaSd + $08, SbDmaLen);
  MemW[0:PcmMmio + HdaSd + $0C] := 1;              { LVI }
  MemW[0:PcmMmio + HdaSd + $12] := F;
  For J := 0 To HdaDacN - 1 Do
  Begin
    HdaCmd(HdaDac[J], $20000 Or F);
    HdaCmd(HdaDac[J], $70610);
  End;
  HdaWL(HdaSd, $100000);                           { flux 1 }
End;

Procedure HdaStop;
Begin
  HdaWL(HdaSd, $100000);
End;

{ ------------------------------- ES1370 --------------------------- }

Procedure EsCodec(R, V : LongInt);
Var T : LongInt;
Begin
  T := Ticks + 5;
  While ((PInL(PcmIo + 4) And $200) <> 0) And (Ticks <= T) Do;
  PortW[PcmIo + $10] := ((R And 255) Shl 8) Or (V And 255);
End;

Function EsInit : Boolean;
Var K : LongInt;
Begin
  EsInit := False;
  PcmIo := PciRead(PcmBus, PcmDev, PcmFn, $10) And $FFFC;
  If PcmIo = 0 Then Exit;
  K := PciRead(PcmBus, PcmDev, PcmFn, 4);
  PciWrite(PcmBus, PcmDev, PcmFn, 4, (K And $FFFF) Or 5);
  PcmCtl := 2;                                     { CDC_EN }
  POutL(PcmIo, PcmCtl);
  POutL(PcmIo + $20, 0);
  EsCodec($16, 2); KDelay(2); EsCodec($16, 3);
  EsCodec($17, 0);
  EsCodec($00, 0); EsCodec($01, 0);                { general }
  EsCodec($02, 0); EsCodec($03, 0);                { voix (DAC2) }
  EsCodec($10, 0); EsCodec($11, $0C);              { melangeur : voix }
  EsInit := True;
End;

Procedure EsStart;
Var Dv, Sc, F : LongInt;
Begin
  SbOBits := SbBits; SbOChans := SbChans;
  Dv := 1411200 Div Max(4000, Min(SbRate, 48000)) - 2;
  SbORate := 1411200 Div (Dv + 2);
  PcmCtl := (PcmCtl And Not LongInt($1FFF0020)) Or ((Dv And $1FFF) Shl 16);
  POutL(PcmIo, PcmCtl);
  POutL(PcmIo + $0C, $0C);                         { page DAC2 }
  POutL(PcmIo + $38, SbDmaBuf);
  POutL(PcmIo + $3C, SbDmaLen Div 4 - 1);
  F := 0;
  If SbOBits = 16 Then F := F Or 2;
  If SbOChans = 2 Then F := F Or 1;
  Sc := PInL(PcmIo + $20);
  Sc := (Sc And Not ($0C Or $1000 Or $4000)) Or (F Shl 2);
  POutL(PcmIo + $20, Sc);
  POutL(PcmIo + $28, SbHalf Div ((SbOBits Div 8) * SbOChans) - 1);
End;

Procedure EsStop;
Begin
  PcmCtl := PcmCtl And Not $20;
  POutL(PcmIo, PcmCtl);
End;

Function EsPos : LongInt;
Begin
  POutL(PcmIo + $0C, $0C);
  EsPos := (((PInL(PcmIo + $3C) Shr 16) And $FFFF) * 4) Mod SbDmaLen;
End;

{ ------------------------------- commun --------------------------- }

Procedure PcmVol;
Var L, R, J, G, V : LongInt; M : Boolean;
Begin
  M := MixMute[0] Or MixMute[1];
  L := (MixVolL[0] * MixVolL[1]) Div 255;
  R := (MixVolR[0] * MixVolR[1]) Div 255;
  Case SndKind Of
    skAc97 :
      Begin
        PortW[PcmIo + $02] := Ac97Att(MixVolL[0], MixVolR[0], MixMute[0]);
        PortW[PcmIo + $18] := Ac97Att(MixVolL[1], MixVolR[1], MixMute[1]);
      End;
    skHda :
      For J := 0 To HdaDacN - 1 Do
      Begin
        V := HdaOff[J];
        If V = 0 Then V := 127;
        G := (V * L) Div 255;
        If M Or (L = 0) Then G := $80;
        HdaCmd(HdaDac[J], $3A000 Or G);
        G := (V * R) Div 255;
        If M Or (R = 0) Then G := $80;
        HdaCmd(HdaDac[J], $39000 Or G);
      End;
    skEs :
      Begin
        G := Ac97Att(MixVolL[0], MixVolR[0], MixMute[0]);
        If G = $8000 Then Begin EsCodec(0, $80); EsCodec(1, $80); End
        Else Begin EsCodec(0, G Shr 8); EsCodec(1, G And 31); End;
        G := Ac97Att(MixVolL[1], MixVolR[1], MixMute[1]);
        If G = $8000 Then Begin EsCodec(2, $80); EsCodec(3, $80); End
        Else Begin EsCodec(2, G Shr 8); EsCodec(3, G And 31); End;
      End;
  End;
End;

{ Minuterie : les blocs de 1 Ko lus par la carte depuis la derniere
  fois sont remplis avec la suite (AC'97 : par l'indice du descripteur
  courant ; HD Audio et ES1370 : par la position de lecture) }
Procedure PcmCheck;
Var N, K, P : LongInt;
Begin
  If SndKind = skAc97 Then N := Ac97Used
  Else
  Begin
    If SndKind = skHda Then P := HdaRL(HdaSd + 4) Mod SbDmaLen
    Else P := EsPos;
    N := (P Div PcmChL - PcmCh + PcmNCh) Mod PcmNCh;
  End;
  While N > 0 Do
  Begin
    K := Min(N, PcmNCh - PcmCh);                    { sans repli }
    SbPlayed := SbPlayed + K * PcmChL;
    SbFill1(PcmCh * PcmChL, K * PcmChL);
    PcmCh := (PcmCh + K) Mod PcmNCh;
    N := N - K;
    If SndKind = skAc97 Then
    Begin
      Port[PcmIo2 + $15] := (PcmCh + PcmNCh - 1) Mod PcmNCh;
      If (PortW[PcmIo2 + $16] And 1) <> 0 Then
      Begin
        PortW[PcmIo2 + $16] := $1C;
        Port[PcmIo2 + $1B] := 1;                    { relancer }
      End;
    End;
  End;
End;

Procedure PcmTick;
Var C : LongInt;
Begin
  If (SndKind < skAc97) Or Not SbPlaying Then Exit;
  C := 0;
  If KPd <> 0 Then
  Begin
    asm
      mov eax,cr3
      mov C,eax
      mov eax,KPd
      mov cr3,eax
    end;
  End;
  PcmCheck;
  If (C <> 0) And (C <> KPd) Then
  Begin
    asm
      mov eax,C
      mov cr3,eax
    end;
  End;
End;

{ Recherche des cartes PCI (bus 0 a 3) }
Function PcmProbe : Boolean;
Var B, D, F, Nf, Id, Cl, Ho, K : LongInt; Ok : Boolean;
Begin
  PcmProbe := False;
  If PciRead(0, 0, 0, 0) = -1 Then Exit;
  For B := 0 To 3 Do
    For D := 0 To 31 Do
    Begin
      Id := PciRead(B, D, 0, 0);
      If (Id And $FFFF) = $FFFF Then Continue;
      If ((PciRead(B, D, 0, $0C) Shr 16) And $80) <> 0 Then Nf := 7
      Else Nf := 0;
      For F := 0 To Nf Do
      Begin
        Id := PciRead(B, D, F, 0);
        If (Id And $FFFF) = $FFFF Then Continue;
        Cl := (PciRead(B, D, F, 8) Shr 16) And $FFFF;
        K := 0;
        If Id = $50001274 Then K := skEs
        Else If Cl = $0403 Then K := skHda
        Else If (Cl = $0401) And ((Id = $24158086) Or (Id = $24258086) Or
          (Id = $24458086) Or (Id = $24858086) Or (Id = $24C58086) Or
          (Id = $24D58086) Or (Id = $266E8086) Or (Id = $27DE8086) Or
          (Id = $71958086) Or (Id = $746D1022) Or (Id = $006A10DE) Or
          (Id = $00DA10DE)) Then K := skAc97;
        If K = 0 Then Continue;
        PcmBus := B; PcmDev := D; PcmFn := F; PcmId := Id;
        PcmIrq := PciRead(B, D, F, $3C) And 255;
        If PcmMem = 0 Then
        Begin
          Ho := HeapOwner; HeapOwner := 0;
          PcmMem := KAlloc(4096 + 128);
          HeapOwner := Ho;
          If PcmMem = 0 Then Exit;
          PcmMem := (PcmMem + 127) And Not 127;
          FillMem(PcmMem, 4096, 0);
        End;
        Case K Of
          skAc97 : Ok := Ac97Init;
          skHda : Ok := HdaInit;
        Else
          Ok := EsInit;
        End;
        If Ok Then
        Begin
          SndKind := K;
          PcmName := PciName(Id);
          Case Id And $FFFF Of
            $8086 : PcmMfg := 'Intel';
            $1274 : PcmMfg := 'Ensoniq';
            $10DE : PcmMfg := 'NVIDIA';
            $1022 : PcmMfg := 'Advanced Micro Devices (AMD)';
          Else
            PcmMfg := '(PCI ' + HexStr(Id And $FFFF, 4) + ')';
          End;
          If PcmName = '' Then
            Case K Of
              skAc97 : PcmName := 'Audio AC''97';
              skHda : PcmName := 'High Definition Audio';
            Else
              PcmName := 'Ensoniq AudioPCI (ES1370)';
            End;
          PcmProbe := True;
          Exit;
        End;
      End;
    End;
End;

Procedure SndInit;
Var V, B, I, Hi, Lo : LongInt; Bl, T : String;
Begin
  SbOk := False; Sb16 := False; SbDev := -1; SbPlaying := False;
  SndKind := 0; PcmMem := 0; SynOk := False;
  For I := 0 To MixLines - 1 Do
  Begin
    MixVolL[I] := 192; MixVolR[I] := 192; MixMute[I] := False;
  End;
  Bl := '';
  If EnvFind('BLASTER', V) Then Bl := PStr(V);
  B := BlasterVal(Bl, 'A', True);
  If (B > 0) And SbReset(B) Then SbOk := True
  Else
  Begin
    B := $220;
    While (B <= $280) And Not SbOk Do
    Begin
      If SbReset(B) Then SbOk := True Else B := B + $20;
    End;
  End;
  If SbOk And SbWriteDsp($E1) Then
  Begin
    Hi := SbReadDsp; Lo := SbReadDsp;
    If Hi < 0 Then SbOk := False
    Else SbVer := Hi * 256 + Lo;
  End;
  If SbOk Then
  Begin
    Sb16 := SbVer >= $400;
    SbIrq := BlasterVal(Bl, 'I', False);
    SbDma8 := BlasterVal(Bl, 'D', False);
    SbDma16 := BlasterVal(Bl, 'H', False);
    If Sb16 Then
    Begin
      MixW(0, 0);
      V := MixR($80);
      If (V And 1) <> 0 Then SbIrq := 2
      Else If (V And 2) <> 0 Then SbIrq := 5
      Else If (V And 4) <> 0 Then SbIrq := 7
      Else If (V And 8) <> 0 Then SbIrq := 10;
      V := MixR($81);
      For I := 0 To 3 Do
        If (V And (1 Shl I)) <> 0 Then SbDma8 := I;
      For I := 5 To 7 Do
        If (V And (1 Shl I)) <> 0 Then SbDma16 := I;
    End;
    If (SbIrq < 2) Or (SbIrq > 15) Then
      If Sb16 Then SbIrq := 5 Else SbIrq := 7;
    If (SbDma8 < 0) Or (SbDma8 > 3) Then SbDma8 := 1;
    If (SbDma16 < 5) Or (SbDma16 > 7) Then SbDma16 := 5;
    If SbIrq = 2 Then SbIrq := 9;
    SetGate($50 + SbIrq, LongInt(@IrqSound));
    If SbIrq < 8 Then Port[$21] := Port[$21] And Not (1 Shl SbIrq)
    Else
    Begin
      Port[$A1] := Port[$A1] And Not (1 Shl (SbIrq - 8));
      Port[$21] := Port[$21] And Not 4;
    End;
    SndApplyVol;
    KLog('Son : ' + SbName + ' (DSP ' + IntStr(SbVer Shr 8) + '.' +
         Pad2(SbVer And 255) + ') en ' + HexStr(SbBase, 3) + 'h, IRQ ' +
         IntStr(SbIrq) + ', DMA ' + IntStr(SbDma8) + '/' + IntStr(SbDma16));
    SndKind := skSb;
  End
  Else If PcmProbe Then
  Begin
    { carte PCI : 16 bits stereo, comme une Sound Blaster 16 }
    SbOk := True; Sb16 := True;
    PcmVol;
    If SndKind = skHda Then
      KLog('Son : ' + PcmName + ' en ' + HexStr(PcmMmio, 8) + 'h, codec ' +
           IntStr(HdaCodec) + ', ' + IntStr(HdaDacN) + ' DAC (noeud ' +
           IntStr(HdaDac[0]) + ')')
    Else
    Begin
      If SndKind = skAc97 Then T := ', VRA ' + IntStr(PcmVra) Else T := '';
      KLog('Son : ' + PcmName + ' en ' + HexStr(PcmIo, 4) + 'h' + T);
    End;
  End;
  OplOk := OplDetect;
  If OplOk Then
  Begin
    KLog('Son : synthetiseur FM OPL2 (AdLib) en 388h');
    OplW(1, $20);
    For I := 0 To 8 Do
    Begin
      OplVoiceNote[I] := -1; OplVoiceAge[I] := 0;
    End;
  End;
  If Not SbOk And Not OplOk Then KLog('Son : aucune carte son');
End;


{ Demarrer la lecture du peripherique SbDev }
Procedure SbStart;
Var TC, N, Md : LongInt;
Begin
  If Not SbOk Or SbPlaying Or ((SbDev < 0) And Not DSOwn) Then Exit;
  SbORate := SbRate;
  If SndKind >= 2 Then
  Begin
    { carte PCI : format et frequence de la carte, puis les deux moities
      remplies et la lecture lancee }
    Case SndKind Of
      skAc97 : Ac97Start;
      skHda : HdaStart;
      skEs : EsStart;
    End;
    SbStep := (SbRate * 4096) Div Max(1, SbORate); SbFrac := 0;
    SbQueued := 0; SbPlayed := 0; SbCopyK := 0; SbCopyOff := 0;
    SbSilent := 0; SbNext := 0; SbPaused := False; PcmCh := 0;
    SbFill1(0, SbDmaLen);                           { tout le tampon }
    SbPlaying := True;
    Case SndKind Of
      skAc97 :
        Begin
          Port[PcmIo2 + $15] := PcmNCh - 1;               { LVI }
          Port[PcmIo2 + $1B] := 1;                        { marche }
        End;
      skHda : HdaWL(HdaSd, $100002);
      skEs :
        Begin
          PcmCtl := PcmCtl Or $20;                        { DAC2_EN }
          POutL(PcmIo, PcmCtl);
        End;
    End;
    Exit;
  End;
  SbStep := 4096; SbFrac := 0;
  If Sb16 Then
  Begin
    SbOBits := SbBits; SbOChans := SbChans;
  End
  Else
  Begin
    SbOBits := 8; SbOChans := 1;
  End;
  SbQueued := 0; SbPlayed := 0; SbCopyK := 0; SbCopyOff := 0;
  SbSilent := 0; SbNext := 0; SbPaused := False;
  SbFill1(0, SbHalf); SbFill1(SbHalf, SbHalf);
  SbPlaying := True;
  SbWriteDsp($D1);
  If SbOBits = 16 Then DmaStart(SbDma16) Else DmaStart(SbDma8);
  If Sb16 Then
  Begin
    SbWriteDsp($41);
    SbWriteDsp((SbRate Shr 8) And 255);
    SbWriteDsp(SbRate And 255);
    If SbOChans = 2 Then Md := $20 Else Md := 0;
    If SbOBits = 16 Then
    Begin
      SbWriteDsp($B6); SbWriteDsp(Md Or $10);
      N := SbHalf Div 2 - 1;
    End
    Else
    Begin
      SbWriteDsp($C6); SbWriteDsp(Md);
      N := SbHalf - 1;
    End;
    SbWriteDsp(N And 255); SbWriteDsp((N Shr 8) And 255);
  End
  Else
  Begin
    TC := 256 - 1000000 Div Max(4000, Min(SbRate, 44100));
    SbWriteDsp($40); SbWriteDsp(TC And 255);
    N := SbHalf - 1;
    SbWriteDsp($48); SbWriteDsp(N And 255); SbWriteDsp((N Shr 8) And 255);
    If (SbRate > 22050) And (SbVer >= $201) Then SbWriteDsp($90)
    Else SbWriteDsp($1C);
  End;
End;

Procedure SbStop;
Begin
  If Not SbPlaying Then Exit;
  SbPlaying := False;
  If SndKind >= 2 Then
  Begin
    Case SndKind Of
      skAc97 : Ac97Stop;
      skHda : HdaStop;
      skEs : EsStop;
    End;
    KLog('Son : fin de lecture (' + IntStr(SbPlayed) + ' octets)');
    Exit;
  End;
  If Sb16 Then
  Begin
    If SbOBits = 16 Then
    Begin
      SbWriteDsp($D9); SbWriteDsp($D5);
    End
    Else
    Begin
      SbWriteDsp($DA); SbWriteDsp($D0);
    End;
  End
  Else SbWriteDsp($D0);
  If SbOBits = 16 Then DmaStop(SbDma16) Else DmaStop(SbDma8);
  SbWriteDsp($D3);
  KLog('Son : fin de lecture (' + IntStr(SbPlayed) + ' octets, ' +
       IntStr(SbIrqs) + ' interruptions)');
End;

{ ------------------------------- MIDI FM (OPL2) ------------------- }

Const
  OplOp : Array[0..8] Of LongInt = (0, 1, 2, 8, 9, 10, 16, 17, 18);
  OplFn : Array[0..11] Of LongInt = ($157, $16B, $181, $198, $1B0, $1CA,
    $1E5, $202, $220, $241, $263, $287);

{ Instrument du programme MIDI P : piano, orgue, cordes ou cuivres }
Procedure OplPatch(V, P : LongInt);
Var O : LongInt;
Begin
  O := OplOp[V];
  Case P Div 16 Of
    1 : Begin { orgue }
          OplW($20 + O, $A1); OplW($40 + O, $1F); OplW($60 + O, $F0);
          OplW($80 + O, $0F); OplW($23 + O, $A1); OplW($63 + O, $F0);
          OplW($83 + O, $0F); OplW($C0 + V, $0F);
        End;
    2 : Begin { cordes et basses }
          OplW($20 + O, $61); OplW($40 + O, $18); OplW($60 + O, $72);
          OplW($80 + O, $16); OplW($23 + O, $21); OplW($63 + O, $71);
          OplW($83 + O, $26); OplW($C0 + V, $0C);
        End;
    3, 4, 5, 6, 7 : Begin { cuivres, anches, flutes }
          OplW($20 + O, $21); OplW($40 + O, $1C); OplW($60 + O, $75);
          OplW($80 + O, $15); OplW($23 + O, $21); OplW($63 + O, $74);
          OplW($83 + O, $17); OplW($C0 + V, $0A);
        End;
  Else
    Begin { piano }
      OplW($20 + O, $01); OplW($40 + O, $1A); OplW($60 + O, $F3);
      OplW($80 + O, $52); OplW($23 + O, $01); OplW($63 + O, $F2);
      OplW($83 + O, $54); OplW($C0 + V, $06);
    End;
  End;
  OplW($E0 + O, 0); OplW($E3 + O, 0);
End;

Var
  MidiProg : Array[0..15] Of LongInt;

Procedure OplNoteOff(Ch, N : LongInt);
Var V : LongInt;
Begin
  For V := 0 To 8 Do
    If (OplVoiceNote[V] = N) And (OplVoiceChan[V] = Ch) Then
    Begin
      OplW($B0 + V, 0);
      OplVoiceNote[V] := -1;
    End;
End;

Procedure OplNoteOn(Ch, N, Vel : LongInt);
Var V, K, Blk, F, TL, Vol : LongInt;
Begin
  If Ch = 9 Then Exit;                     { percussions : non gerees }
  If Vel = 0 Then
  Begin
    OplNoteOff(Ch, N);
    Exit;
  End;
  V := -1;
  For K := 0 To 8 Do
    If (V < 0) And (OplVoiceNote[K] < 0) Then V := K;
  If V < 0 Then
  Begin
    V := 0;
    For K := 1 To 8 Do
      If OplVoiceAge[K] < OplVoiceAge[V] Then V := K;
    OplW($B0 + V, 0);
  End;
  Inc(OplAge);
  OplVoiceNote[V] := N; OplVoiceChan[V] := Ch; OplVoiceAge[V] := OplAge;
  OplPatch(V, MidiProg[Ch]);
  Vol := Vel;
  If MixMute[2] Or MixMute[0] Then Vol := 0
  Else Vol := (Vol * MixVolL[2]) Div 255;
  TL := 63 - (Vol * 63) Div 127;
  OplW($43 + OplOp[V], TL);
  Blk := N Div 12 - 1;
  If Blk < 0 Then Blk := 0;
  If Blk > 7 Then Blk := 7;
  F := OplFn[N Mod 12];
  OplW($A0 + V, F And 255);
  OplW($B0 + V, $20 Or (Blk Shl 2) Or ((F Shr 8) And 3));
End;

Procedure OplAllOff;
Var V : LongInt;
Begin
  For V := 0 To 8 Do
  Begin
    OplW($B0 + V, 0);
    OplVoiceNote[V] := -1;
  End;
End;

{ ----------------------- MIDI logiciel (sans OPL) ----------------- }
{ Cartes sans synthetiseur FM (AC'97, HD Audio, ES1370) : comme le
  synthetiseur logiciel de Windows, les notes sont calculees par le
  noyau et mixees dans le flux PCM de la carte (comme DirectSound).
  24 voix ; forme d'onde et enveloppe selon la famille d'instruments
  General MIDI (piano, orgue, cordes, cuivres...) ; percussions (canal
  10) : bruit ou sinusoide grave a decroissance rapide. Calcul en
  entiers seulement : le mixage a lieu dans l'interruption. }

Procedure SynInit;
Var I : LongInt; F : Double;
Begin
  For I := 0 To 255 Do SynSine[I] := Round(32767 * Sin(I * 2 * Pi / 256));
  F := 8.1757989156 * 16;                         { note 0 (do -1) }
  For I := 0 To 127 Do
  Begin
    SynFreq[I] := Round(F);
    F := F * 1.0594630943593;
  End;
  For I := 0 To SynMax - 1 Do SynAmp[I] := 0;
  SynCount := 0; SynAgeC := 0; SynNoise := 12345;
  SynOk := True;
End;

Function SynBusy : Boolean;
Begin
  SynBusy := SynOk And (SynCount > 0);
End;

{ forme d'onde (0 sinus, 1 triangle, 2 carre, 3 dent de scie, 4 bruit)
  et decroissance (1/65536 par bloc de 16 trames) de l'instrument }
Procedure SynPatch(Ch, N : LongInt; Var W, Dc : LongInt);
Begin
  If Ch = 9 Then
  Begin
    { percussions : grosse caisse et toms graves en sinusoide }
    If (N = 35) Or (N = 36) Or (N = 41) Or (N = 43) Or (N = 45) Then
    Begin
      W := 0; Dc := 400;
    End
    Else
    Begin
      W := 4;
      If (N = 42) Or (N = 44) Then Dc := 1500 Else Dc := 700;
    End;
    Exit;
  End;
  Case MidiProg[Ch] Div 8 Of
    0 : Begin W := 1; Dc := 55; End;              { piano }
    1 : Begin W := 0; Dc := 130; End;             { percussions chrom. }
    2 : Begin W := 2; Dc := 0; End;               { orgue }
    3 : Begin W := 3; Dc := 80; End;              { guitare }
    4 : Begin W := 1; Dc := 40; End;              { basse }
    5, 6 : Begin W := 3; Dc := 0; End;            { cordes, ensembles }
    7, 8 : Begin W := 2; Dc := 10; End;           { cuivres, anches }
    9 : Begin W := 0; Dc := 0; End;               { flutes }
    10 : Begin W := 2; Dc := 0; End;              { synthe solo }
  Else
    Begin W := 1; Dc := 20; End;
  End;
End;

Procedure SynNoteOff(Ch, N : LongInt);
Var V, F : LongInt;
Begin
  F := IntOff;
  For V := 0 To SynMax - 1 Do
    If (SynAmp[V] > 0) And (SynNote[V] = N) And (SynChan[V] = Ch) And
       (SynRel[V] = 0) Then
    Begin
      SynRel[V] := 1;
      If SynDec[V] < 1500 Then SynDec[V] := 1500;
    End;
  IntRestore(F);
End;

Procedure DSCardStart; Forward;

Procedure SynNoteOn(Ch, N, Vel : LongInt);
Var V, K, F, W, Dc, St, R : LongInt;
Begin
  If Vel = 0 Then
  Begin
    SynNoteOff(Ch, N);
    Exit;
  End;
  If Not SbPlaying Then DSCardStart;
  R := SbORate;
  If R <= 0 Then R := 22050;
  If Ch = 9 Then
  Begin
    If (N = 35) Or (N = 36) Then K := 33 Else K := N - 12;
  End
  Else K := N;
  If (K < 0) Or (SynFreq[K] > R * 7) Then Exit;   { au-dela de Nyquist }
  St := SynFreq[K] * (268435456 Div R);
  SynPatch(Ch, N, W, Dc);
  F := IntOff;
  V := -1;
  For K := 0 To SynMax - 1 Do
    If (V < 0) And (SynAmp[K] <= 0) Then V := K;
  If V < 0 Then
  Begin
    V := 0;
    For K := 1 To SynMax - 1 Do
      If SynAge[K] < SynAge[V] Then V := K;
  End
  Else Inc(SynCount);
  Inc(SynAgeC);
  SynNote[V] := N; SynChan[V] := Ch; SynPhase[V] := 0; SynStep[V] := St;
  SynWave[V] := W; SynDec[V] := Dc; SynRel[V] := 0; SynAge[V] := SynAgeC;
  SynAmp[V] := Vel * 400;                         { jusqu'a 50800 }
  IntRestore(F);
End;

Procedure SynAllOff;
Var V, F : LongInt;
Begin
  F := IntOff;
  For V := 0 To SynMax - 1 Do SynAmp[V] := 0;
  SynCount := 0;
  IntRestore(F);
End;

{ Mixer les voix dans N octets du tampon D (format de la carte) }
Procedure SynMixInto(D, N : LongInt);
Var Bpf, Fr, I, V, S, A, P, X, Q, Gl, Gr, Vol : LongInt;
Begin
  If Not SynOk Or (SynCount <= 0) Then Exit;
  Bpf := (SbOBits Div 8) * SbOChans;
  If Bpf <= 0 Then Exit;
  Fr := N Div Bpf;
  If MixMute[2] Or MixMute[0] Then Vol := 0
  Else Vol := MixVolL[2];
  For I := 0 To Fr - 1 Do
  Begin
    S := 0;
    For V := 0 To SynMax - 1 Do
    Begin
      A := SynAmp[V];
      If A > 0 Then
      Begin
        P := SynPhase[V];
        X := (P Shr 24) And 255;
        Case SynWave[V] Of
          0 : Q := SynSine[X];
          1 : If X < 128 Then Q := X * 512 - 32767
              Else Q := 32767 - (X - 128) * 512;
          2 : If X < 128 Then Q := 16000 Else Q := -16000;
          3 : Q := (X - 128) * 200;
        Else
          Begin
            SynNoise := SynNoise * 1103515245 + 12345;
            Q := ((SynNoise Shr 16) And $7FFF) - 16384;
          End;
        End;
        S := S + (Q * (A Shr 4)) Div 4096;
        SynPhase[V] := P + SynStep[V];
        { enveloppe : tous les 16 trames }
        If (I And 15) = 0 Then
        Begin
          A := A - (A Div 65536) * SynDec[V] - ((A Mod 65536) * SynDec[V])
               Div 65536 - 1;
          If A < 64 Then
          Begin
            A := 0;
            Dec(SynCount);
          End;
          SynAmp[V] := A;
        End;
      End;
    End;
    S := (S Div 4) * Vol Div 255;
    If S > 32767 Then S := 32767;
    If S < -32767 Then S := -32767;
    Q := D + I * Bpf;
    If SbOBits = 16 Then
    Begin
      Gl := MemW[0:Q]; If Gl >= 32768 Then Gl := Gl - 65536;
      Gl := Gl + S;
      If Gl > 32767 Then Gl := 32767;
      If Gl < -32768 Then Gl := -32768;
      MemW[0:Q] := Gl And $FFFF;
      If SbOChans = 2 Then
      Begin
        Gr := MemW[0:Q + 2]; If Gr >= 32768 Then Gr := Gr - 65536;
        Gr := Gr + S;
        If Gr > 32767 Then Gr := 32767;
        If Gr < -32768 Then Gr := -32768;
        MemW[0:Q + 2] := Gr And $FFFF;
      End;
    End
    Else
    Begin
      Gl := Mem[0:Q] + S Div 256;
      If Gl > 255 Then Gl := 255;
      If Gl < 0 Then Gl := 0;
      Mem[0:Q] := Gl;
      If SbOChans = 2 Then
      Begin
        Gr := Mem[0:Q + 1] + S Div 256;
        If Gr > 255 Then Gr := 255;
        If Gr < 0 Then Gr := 0;
        Mem[0:Q + 1] := Gr;
      End;
    End;
  End;
  If SynCount < 0 Then SynCount := 0;
End;

Function WaveOf(H : LongInt) : LongInt;
Begin
  WaveOf := -1;
  H := H - HWaveBase;
  If (H >= 0) And (H < MaxWave) Then
    If WaveDevs[H].Used Then WaveOf := H;
End;

{ Prevenir le programme (fenetre, tache, evenement ou fonction) }
Procedure WaveNotify(I, Msg, P1 : LongInt);
Var Cb, Inst, H : LongInt; En : Boolean;
Begin
  Cb := WaveDevs[I].Cb; Inst := WaveDevs[I].Inst; H := HWaveBase + I;
  If Cb = 0 Then Exit;
  En := ProcEnter(WaveDevs[I].PrcId);
  Case WaveDevs[I].CbType Of
    $10000 : PostMessageA(Cb, Msg, H, P1);
    $20000 : PostThreadMessageA(Cb, Msg, H, P1);
    $50000 : SetEvent(Cb);
    $30000 :
      asm
        push 0
        mov eax,P1
        push eax
        mov eax,Inst
        push eax
        mov eax,Msg
        push eax
        mov eax,H
        push eax
        mov eax,Cb
        call eax
      end;
  End;
  If En Then ProcLeave;
End;

{ Tampon K de la file du peripherique I termine }
Procedure WaveDone(I, K : LongInt);
Var Hdr, J, F : LongInt;
Begin
  F := IntOff;
  Hdr := WaveQHdr[I * MaxWaveQ + K];
  For J := K To WaveDevs[I].QN - 2 Do
  Begin
    WaveQHdr[I * MaxWaveQ + J] := WaveQHdr[I * MaxWaveQ + J + 1];
    WaveQEnd[I * MaxWaveQ + J] := WaveQEnd[I * MaxWaveQ + J + 1];
  End;
  Dec(WaveDevs[I].QN);
  If (I = SbDev) And (K < SbCopyK) Then Dec(SbCopyK);
  IntRestore(F);
  MemL[0:Hdr + 16] := (MemL[0:Hdr + 16] And Not 16) Or 1;
  WaveNotify(I, WOM_DONE, Hdr);
End;

{ Appelee par la tache 0 : rendre les tampons dont la duree est passee }
Procedure PlaySoundPoll; Forward;
Function DSAnyPlaying : Boolean; Forward;
Procedure DSPoll; Forward;

Procedure RunWave;
Var I : LongInt; En : Boolean;
Begin
  If InWave Then Exit;
  InWave := True;
  For I := 0 To MaxWave - 1 Do
    If WaveDevs[I].Used And Not WaveDevs[I].Paused Then
    Begin
      { en-tetes WAVEHDR dans la memoire du processus du peripherique }
      En := ProcEnter(WaveDevs[I].PrcId);
      If I = SbDev Then
      Begin
        { carte son : tampons rendus quand leurs octets sont joues }
        While (WaveDevs[I].QN > 0) And (SbCopyK > 0) And
              (SbPlayed >= WaveQEnd[I * MaxWaveQ]) Do
          WaveDone(I, 0);
        If SbPlaying And (WaveDevs[I].QN = 0) And (SbSilent >= SbDmaLen) And
           Not SynBusy And
           Not DSAnyPlaying Then
          SbStop;
      End
      Else
        While (WaveDevs[I].QN > 0) And (Ticks >= WaveQEnd[I * MaxWaveQ]) Do
          WaveDone(I, 0);
      If En Then ProcLeave;
    End;
  PlaySoundPoll;
  DSPoll;
  InWave := False;
End;

{ Fin du processus P : ses peripheriques waveOut sont fermes, sans
  fonction de rappel }
Procedure WaveProcExit(P : LongInt);
Var I : LongInt;
Begin
  For I := 0 To MaxWave - 1 Do
    If WaveDevs[I].Used And (WaveDevs[I].PrcId = P) Then
    Begin
      WaveDevs[I].Cb := 0; WaveDevs[I].CbType := 0;
      If I = SbDev Then
      Begin
        SbStop;
        SbDev := -1;
      End;
      WaveDevs[I].QN := 0;
      WaveDevs[I].Used := False;
    End;
End;

Function waveOutGetNumDevs : LongInt;
Begin
  waveOutGetNumDevs := 1;
End;

{ WAVEOUTCAPSA : +0 fabricant, +2 produit, +4 version, +8 nom (32),
  +40 formats, +44 canaux, +48 possibilites }
Function waveOutGetDevCapsA(Id, P, N : LongInt) : LongInt;
Begin
  waveOutGetDevCapsA := 11;
  If (P = 0) Or (N < 52) Then Exit;
  FillMem(P, 52, 0);
  MemW[0:P] := 1; MemW[0:P + 2] := 1;
  MemL[0:P + 4] := $0400;
  If SbOk Then PutPStr(P + 8, SbName + ' Wave Out', 32)
  Else PutPStr(P + 8, 'Pasdows Son', 32);
  MemL[0:P + 40] := $FFF;
  MemW[0:P + 44] := 2;
  MemL[0:P + 48] := $C;
  waveOutGetDevCapsA := 0;
End;

Function waveOutOpen(PH, Id, Fmt, Cb, Inst, Flags : LongInt) : LongInt;
Var I, K : LongInt;
Begin
  waveOutOpen := 0;
  { WAVE_FORMAT_QUERY : tous les formats sont acceptes }
  If (Flags And 1) <> 0 Then Exit;
  I := -1;
  For K := MaxWave - 1 DownTo 0 Do
    If Not WaveDevs[K].Used Then I := K;
  If I < 0 Then
  Begin
    waveOutOpen := 4;
    Exit;
  End;
  WaveDevs[I].Used := True;
  WaveDevs[I].Paused := False;
  WaveDevs[I].Rate := 11025;
  If Fmt <> 0 Then
    If MemL[0:Fmt + 8] > 0 Then WaveDevs[I].Rate := MemL[0:Fmt + 8];
  { la carte son prend le premier peripherique ouvert (PCM) }
  If SbOk And (SbDev < 0) And Not DSOwn And (Fmt <> 0) And
     (MemW[0:Fmt] = 1) Then
  Begin
    SbDev := I;
    SbChans := Max(1, Min(2, MemW[0:Fmt + 2]));
    SbRate := MemL[0:Fmt + 4];
    SbBits := MemW[0:Fmt + 14];
    If SbBits <> 16 Then SbBits := 8;
  End;
  WaveDevs[I].Cb := Cb;
  WaveDevs[I].Inst := Inst;
  WaveDevs[I].CbType := Flags And $70000;
  WaveDevs[I].PrcId := CurProc;
  WaveDevs[I].QN := 0;
  WaveDevs[I].LastEnd := Ticks;
  WaveDevs[I].Wr := 0; WaveDevs[I].PB := 0; WaveDevs[I].PT := Ticks;
  WaveDevs[I].Blk := 1;
  If Fmt <> 0 Then
    If MemW[0:Fmt + 12] > 0 Then WaveDevs[I].Blk := MemW[0:Fmt + 12];
  If PH <> 0 Then MemL[0:PH] := HWaveBase + I;
  WaveNotify(I, WOM_OPEN, 0);
End;

Function waveOutClose(H : LongInt) : LongInt;
Var I : LongInt;
Begin
  waveOutClose := 5;
  I := WaveOf(H);
  If I < 0 Then Exit;
  If WaveDevs[I].QN > 0 Then
  Begin
    waveOutClose := 33;
    Exit;
  End;
  WaveNotify(I, WOM_CLOSE, 0);
  If I = SbDev Then
  Begin
    SbStop;
    SbDev := -1;
  End;
  WaveDevs[I].Used := False;
  waveOutClose := 0;
End;

{ WAVEHDR : +0 donnees, +4 longueur, +8, +12 utilisateur, +16 drapeaux }
Function waveOutPrepareHeader(H, Hdr, N : LongInt) : LongInt;
Begin
  waveOutPrepareHeader := 11;
  If Hdr = 0 Then Exit;
  MemL[0:Hdr + 16] := MemL[0:Hdr + 16] Or 2;
  waveOutPrepareHeader := 0;
End;

Function waveOutUnprepareHeader(H, Hdr, N : LongInt) : LongInt;
Begin
  waveOutUnprepareHeader := 11;
  If Hdr = 0 Then Exit;
  If (MemL[0:Hdr + 16] And 16) <> 0 Then
  Begin
    waveOutUnprepareHeader := 33;
    Exit;
  End;
  MemL[0:Hdr + 16] := MemL[0:Hdr + 16] And Not 2;
  waveOutUnprepareHeader := 0;
End;

{ Octets deja joues par le peripherique I (estimes d'apres l'horloge,
  sans depasser ce qui a ete ecrit) }
Function WavePosB(I : LongInt) : LongInt;
Var E, P, R : LongInt;
Begin
  If WaveDevs[I].Paused Then E := WaveDevs[I].PauseAt Else E := Ticks;
  E := E - WaveDevs[I].PT;
  If E < 0 Then E := 0;
  R := WaveDevs[I].Rate;
  P := WaveDevs[I].PB + (E Div 1000) * R + ((E Mod 1000) * R) Div 1000;
  If (P < 0) Or (P > WaveDevs[I].Wr) Then P := WaveDevs[I].Wr;
  WavePosB := P;
End;

Function waveOutWrite(H, Hdr, N : LongInt) : LongInt;
Var I, Len, R, St, Q, F : LongInt;
Begin
  waveOutWrite := 5;
  I := WaveOf(H);
  If I < 0 Then Exit;
  If (MemL[0:Hdr + 16] And 2) = 0 Then
  Begin
    waveOutWrite := 34;
    Exit;
  End;
  Q := WaveDevs[I].QN;
  If Q >= MaxWaveQ Then
  Begin
    waveOutWrite := 7;
    Exit;
  End;
  MemL[0:Hdr + 16] := (MemL[0:Hdr + 16] Or 16) And Not 1;
  Len := MemL[0:Hdr + 4]; R := WaveDevs[I].Rate;
  { file vide : la lecture (re)part maintenant }
  If Q = 0 Then
  Begin
    WaveDevs[I].PB := WavePosB(I);
    WaveDevs[I].PT := Ticks;
    If WaveDevs[I].Paused Then WaveDevs[I].PT := WaveDevs[I].PauseAt;
  End;
  WaveDevs[I].Wr := WaveDevs[I].Wr + Len;
  St := Max(Ticks, WaveDevs[I].LastEnd);
  WaveDevs[I].LastEnd := St + (Len Div R) * 1000 + ((Len Mod R) * 1000) Div R;
  F := IntOff;
  WaveQHdr[I * MaxWaveQ + Q] := Hdr;
  If I = SbDev Then WaveQEnd[I * MaxWaveQ + Q] := MaxLongInt
  Else WaveQEnd[I * MaxWaveQ + Q] := WaveDevs[I].LastEnd;
  WaveDevs[I].QN := Q + 1;
  IntRestore(F);
  If (I = SbDev) And Not SbPlaying And Not WaveDevs[I].Paused Then SbStart;
  waveOutWrite := 0;
End;

Function waveOutReset(H : LongInt) : LongInt;
Var I : LongInt;
Begin
  waveOutReset := 5;
  I := WaveOf(H);
  If I < 0 Then Exit;
  If I = SbDev Then SbStop;
  While WaveDevs[I].QN > 0 Do WaveDone(I, 0);
  WaveDevs[I].LastEnd := Ticks;
  WaveDevs[I].Paused := False;
  WaveDevs[I].Wr := 0; WaveDevs[I].PB := 0; WaveDevs[I].PT := Ticks;
  waveOutReset := 0;
End;

Function waveOutPause(H : LongInt) : LongInt;
Var I : LongInt;
Begin
  waveOutPause := 5;
  I := WaveOf(H);
  If I < 0 Then Exit;
  If Not WaveDevs[I].Paused Then
  Begin
    WaveDevs[I].Paused := True;
    WaveDevs[I].PauseAt := Ticks;
    If (I = SbDev) And SbPlaying Then
    Begin
      If SbOBits = 16 Then SbWriteDsp($D5) Else SbWriteDsp($D0);
      SbPaused := True;
    End;
  End;
  waveOutPause := 0;
End;

Function waveOutRestart(H : LongInt) : LongInt;
Var I, K, D : LongInt;
Begin
  waveOutRestart := 5;
  I := WaveOf(H);
  If I < 0 Then Exit;
  If WaveDevs[I].Paused Then
  Begin
    D := Ticks - WaveDevs[I].PauseAt;
    For K := 0 To WaveDevs[I].QN - 1 Do
      WaveQEnd[I * MaxWaveQ + K] := WaveQEnd[I * MaxWaveQ + K] + D;
    WaveDevs[I].LastEnd := WaveDevs[I].LastEnd + D;
    WaveDevs[I].PT := WaveDevs[I].PT + D;
    WaveDevs[I].Paused := False;
    If (I = SbDev) And SbPlaying And SbPaused Then
    Begin
      If SbOBits = 16 Then SbWriteDsp($D6) Else SbWriteDsp($D4);
      SbPaused := False;
    End
    Else If (I = SbDev) And Not SbPlaying And (WaveDevs[I].QN > 0) Then
      SbStart;
  End;
  waveOutRestart := 0;
End;

Function waveOutGetVolume(H, P : LongInt) : LongInt;
Begin
  If P <> 0 Then
    MemL[0:P] := (MixVolL[1] * 257) Or ((MixVolR[1] * 257) Shl 16);
  waveOutGetVolume := 0;
End;

Function waveOutSetVolume(H, V : LongInt) : LongInt;
Begin
  MixVolL[1] := (V And $FFFF) Shr 8;
  MixVolR[1] := (V Shr 24) And 255;
  SndApplyVol;
  waveOutSetVolume := 0;
End;

