Function LbOwner(W : LongInt) : Boolean; Forward;
Function CtlSmall(W : LongInt) : Boolean; Forward;
Function CtlOwner(W : LongInt) : Boolean; Forward;
Function DlgPaints(W : LongInt) : Boolean; Forward;

Procedure InvalW(W : LongInt; R : TRect; Erase : Boolean);
Var C : TRect;
Begin
  If W < 0 Then Exit;
  SetR(C, 0, 0, Wnds^[W].CR - Wnds^[W].CL, Wnds^[W].CB - Wnds^[W].CT);
  If Not RInter(R, R, C) Then Exit;
  RUnion(Wnds^[W].Upd, R);
  If Erase Then Wnds^[W].UpdErase := True;
  If Wnds^[W].IKind <> ikNone Then Wnds^[TopOf(W)].KNeedPaint := True;
  If ((Wnds^[W].IKind = ikNone) Or CtlOwner(W)) And
     (Wnds^[W].Thread >= 0) And (Wnds^[W].Thread < MaxThread) Then
    Threads[Wnds^[W].Thread].PaintReq := True;
End;

Procedure InvalAll(W : LongInt; Erase : Boolean);
Var R : TRect; I : LongInt;
Begin
  SetR(R, 0, 0, 30000, 30000);
  InvalW(W, R, Erase);
  For I := 0 To MaxWnd - 1 Do
    If Wnds^[I].Used And IsChildW(I) And (Wnds^[I].Parent = W) Then
      InvalAll(I, Erase);
End;

Function HasUpdate(W : LongInt) : Boolean;
Begin
  HasUpdate := (Wnds^[W].Upd.L < Wnds^[W].Upd.R) And
               (Wnds^[W].Upd.T < Wnds^[W].Upd.B);
End;

{ ------------------------------------------------------------------ }
{ Messages                                                           }
{ ------------------------------------------------------------------ }

Function CallProc(P, H, M, WP, LP : LongInt) : LongInt;
Var R, W, T : LongInt; En : Boolean;
Begin
  R := 0;
  { procedure d'une fenetre d'un autre processus : dans son contexte }
  En := False;
  W := WndOf(H);
  If W >= 0 Then
  Begin
    T := Wnds^[W].Thread;
    If (T > 0) And (T < MaxThread) Then
    Begin
      If Procs^[ThrProc[T]].Killing Then
      Begin
        CallProc := 0;
        Exit;
      End;
      En := ProcEnter(ThrProc[T]);
    End;
  End;
  asm
    mov eax,LP
    push eax
    mov eax,WP
    push eax
    mov eax,M
    push eax
    mov eax,H
    push eax
    mov eax,P
    call eax
    mov R,eax
  end;
  If En Then ProcLeave;
  CallProc := R;
End;

Function SendMsgW(W, Msg, WP, LP : LongInt) : LongInt;
Begin
  SendMsgW := 0;
  If (W < 0) Or Not Wnds^[W].Used Then Exit;
  If Wnds^[W].Proc <> 0 Then
  Begin
    If Not KillingApp Then
      SendMsgW := CallProc(Wnds^[W].Proc, HwndOf(W), Msg, WP, LP);
  End
  Else
    SendMsgW := KWndProc(W, Msg, WP, LP);
End;

Function PostMsgW(W, Msg, WP, LP : LongInt) : Boolean;
Begin
  PostMsgW := False;
  If (W < 0) Or Not Wnds^[W].Used Then Exit;
  If (Wnds^[W].IKind <> ikNone) And (Wnds^[W].IKind <> ikDialog) Then
  Begin
    KWndProc(W, Msg, WP, LP);
    PostMsgW := True;
  End
  Else
    PostMsgW := QPost(Wnds^[W].Thread, HwndOf(W), Msg, WP, LP);
End;

{ Message en attente pour la tache T (y compris WM_PAINT et WM_TIMER) }
Function MsgPending(T : LongInt) : Boolean;
Var I : LongInt;
Begin
  MsgPending := True;
  If Threads[T].QHead <> Threads[T].QTail Then Exit;
  If Threads[T].QuitFlag Then Exit;
  If Threads[T].PaintReq Then Exit;
  For I := 0 To MaxTimer - 1 Do
    If WTimers[I].Used And (WTimers[I].Thread = T) And
       (Ticks >= WTimers[I].Next) Then Exit;
  MsgPending := False;
End;

{ ------------------------------------------------------------------ }
{ Creation, destruction, activation                                  }
{ ------------------------------------------------------------------ }

{ Classe d'apres son nom : celles du processus courant, puis celles du
  systeme (deux programmes peuvent enregistrer le meme nom) }
Function ClassFind(Name : String) : LongInt;
Var I, K : LongInt;
Begin
  ClassFind := -1;
  Name := UpStr(Name);
  For K := 0 To 1 Do
    For I := 0 To MaxClass - 1 Do
      If Classes^[I].Used And (Classes^[I].Name = Name) And
         (((K = 0) And (Classes^[I].PrcId = CurProc)) Or
          ((K = 1) And ((Classes^[I].PrcId = 0) Or
                        (Classes^[I].IKind <> ikNone)))) Then
      Begin
        ClassFind := I;
        Exit;
      End;
End;

Function ClassAdd(Name : String; Proc, IKind, Style : LongInt) : LongInt;
Var I : LongInt;
Begin
  ClassAdd := -1;
  For I := 0 To MaxClass - 1 Do
    If Not Classes^[I].Used Then
    Begin
      FillMem(LongInt(@Classes^[I]), SizeOf(TClass), 0);
      Classes^[I].Used := True;
      Classes^[I].Name := UpStr(Name);
      Classes^[I].Atom := $C000 + I;
      Classes^[I].Proc := Proc;
      Classes^[I].IKind := IKind;
      Classes^[I].Style := Style;
      Classes^[I].Brush := 6;      { COLOR_WINDOW + 1 }
      Classes^[I].PrcId := CurProc;
      ClassAdd := I;
      Exit;
    End;
End;

Function WndAlloc : LongInt;
Var I : LongInt;
Begin
  WndAlloc := -1;
  For I := 0 To MaxWnd - 1 Do
    If Not Wnds^[I].Used Then
    Begin
      FillMem(LongInt(@Wnds^[I]), SizeOf(TWnd), 0);
      Wnds^[I].Used := True;
      Wnds^[I].Parent := -1;
      Wnds^[I].Owner := -1;
      Wnds^[I].Enabled := True;
      Inc(WndSeq);
      Wnds^[I].Seq := WndSeq;
      WndAlloc := I;
      Exit;
    End;
End;

{ (Re)allouer la surface d'une fenetre de premier niveau }
Procedure WndSurf(W : LongInt);
Var WW, HH, Own, T : LongInt;
Begin
  If IsChildW(W) Then Exit;
  WW := Max(1, Wnds^[W].W); HH := Max(1, Wnds^[W].H);
  If (Wnds^[W].Surf.Bits <> 0) And (Wnds^[W].Surf.W = WW) And
     (Wnds^[W].Surf.H = HH) Then Exit;
  SurfFree(Wnds^[W].Surf);
  { la surface appartient au fil de la fenetre, pas au programme en
    cours : une fenetre du noyau (Invite DOS...) creee ou agrandie
    pendant qu'un programme tourne perdait sa surface a la fin de
    celui-ci (KFreeOwner), puis la reutilisait par-dessus d'autres
    blocs (ligne de commande du programme suivant remplie de 07h) }
  Own := HeapOwner;
  T := Wnds^[W].Thread;
  If (T >= 0) And (T < MaxThread) Then HeapOwner := ThrOwner[T]
  Else HeapOwner := 0;
  If SurfNew(Wnds^[W].Surf, WW, HH) Then
  Begin
    If Wnds^[W].Surf.Bpp = 8 Then
      FillMem(Wnds^[W].Surf.Bits, Wnds^[W].Surf.Pitch * HH, cSilver)
    Else
      For T := 0 To HH - 1 Do
        FillRaw(Wnds^[W].Surf.Bits + T * Wnds^[W].Surf.Pitch, WW,
                RawOf(cSilver, Wnds^[W].Surf.Bpp), Wnds^[W].Surf.Bpp);
  End;
  HeapOwner := Own;
  Wnds^[W].NeedNc := True;
End;

Function IsTaskWin(W : LongInt) : Boolean;
Begin
  IsTaskWin := Wnds^[W].Used And Wnds^[W].Visible And Not IsChildW(W) And
    (Wnds^[W].Owner < 0) And ((Wnds^[W].ExStyle And WS_EX_TOOLWINDOW) = 0)
    And (Wnds^[W].IKind <> ikTaskbar) And (Wnds^[W].IKind <> ikMenu) And
    ((Wnds^[W].Text <> '') Or ((Wnds^[W].Style And WS_CAPTION) <> 0));
End;

Procedure SetFocusW(W : LongInt);
Var Old : LongInt;
Begin
  If W = FocusWin Then Exit;
  Old := FocusWin;
  FocusWin := W;
  { la fenetre de premier niveau retient l'enfant qui avait le focus :
    il le retrouve quand elle est de nouveau activee (comme Windows) }
  If (W >= 0) And IsChildW(W) Then Wnds^[TopOf(W)].FocusChild := W + 1;
  If (Old >= 0) And Wnds^[Old].Used Then
    PostMsgW(Old, WM_KILLFOCUS, HwndOf(W), 0);
  If W >= 0 Then PostMsgW(W, WM_SETFOCUS, HwndOf(Old), 0);
End;

Procedure ActivateW(W : LongInt);
Var Old : LongInt;
Begin
  If W >= 0 Then W := TopOf(W);
  If (W >= 0) And ((Wnds^[W].IKind = ikTaskbar) Or
     (Wnds^[W].IKind = ikMenu)) Then Exit;
  Old := ActiveWin;
  If (W >= 0) And Wnds^[W].Visible Then ZTop(W);
  If W = Old Then
  Begin
    If W >= 0 Then DirtyWnd(W);
    Exit;
  End;
  ActiveWin := W;
  If (Old >= 0) And Wnds^[Old].Used Then
  Begin
    NcPaint(Old);
    If Wnds^[Old].IKind = ikNone Then
    Begin
      PostMsgW(Old, WM_ACTIVATE, 0, HwndOf(W));
      If (W < 0) Or (Wnds^[W].Thread <> Wnds^[Old].Thread) Then
        PostMsgW(Old, WM_ACTIVATEAPP, 0, 0);
    End
    Else
      Wnds^[Old].KNeedPaint := True;
  End;
  If W >= 0 Then
  Begin
    NcPaint(W);
    If Wnds^[W].IKind = ikNone Then
    Begin
      If (Old < 0) Or (Wnds^[Old].Thread <> Wnds^[W].Thread) Then
        PostMsgW(W, WM_ACTIVATEAPP, 1, 0);
      PostMsgW(W, WM_ACTIVATE, 1, HwndOf(Old));
      PostMsgW(W, WM_QUERYNEWPALETTE, 0, 0);
    End
    Else
      Wnds^[W].KNeedPaint := True;
    Old := Wnds^[W].FocusChild - 1;
    If (Old >= 0) And Wnds^[Old].Used And IsChildW(Old) And
       (TopOf(Old) = W) And WndVisible(Old) And Wnds^[Old].Enabled Then
      SetFocusW(Old)
    Else SetFocusW(W);
    KActivated(W);
  End;
  TaskbarChanged;
End;

{ Fenetre suivante a activer apres fermeture ou reduction }
Procedure ActivateNext;
Var I, W : LongInt;
Begin
  For I := ZCnt - 1 DownTo 0 Do
  Begin
    W := ZList[I];
    If Wnds^[W].Used And Wnds^[W].Visible And Not Wnds^[W].Min And
       (Wnds^[W].IKind <> ikTaskbar) And (Wnds^[W].IKind <> ikMenu) Then
    Begin
      ActivateW(W);
      Exit;
    End;
  End;
  ActivateW(-1);
End;

Procedure ShowW(W : LongInt; Show, Activate : Boolean);
Begin
  If Wnds^[W].Visible = Show Then
  Begin
    If Show And Activate And Not IsChildW(W) Then ActivateW(W);
    Exit;
  End;
  Wnds^[W].Visible := Show;
  If Show Then
  Begin
    InvalAll(W, True);
    If Not IsChildW(W) Then
    Begin
      Wnds^[W].NeedNc := True;
      If Activate Then ActivateW(W) Else ZTop(W);
    End;
  End
  Else If (W = ActiveWin) Then ActivateNext;
  DirtyWnd(W);
  If Not IsChildW(W) Then TaskbarChanged;
End;

{ Changer la position et la taille (coordonnees relatives au parent) }
Procedure MoveW(W, X, Y, WW, HH : LongInt; Repaint : Boolean);
Var Sized, Moved : Boolean; R : TRect;
Begin
  If WW < 0 Then WW := 0;
  If HH < 0 Then HH := 0;
  Sized := (WW <> Wnds^[W].W) Or (HH <> Wnds^[W].H);
  Moved := (X <> Wnds^[W].X) Or (Y <> Wnds^[W].Y);
  If Not Sized And Not Moved Then Exit;
  DirtyWnd(W);
  WndScreenRect(W, R);
  Wnds^[W].X := X; Wnds^[W].Y := Y; Wnds^[W].W := WW; Wnds^[W].H := HH;
  CalcNc(W);
  If Sized Then
  Begin
    WndSurf(W);
    If Not IsChildW(W) Then NcPaint(W);
    InvalAll(W, True);
    SendMsgW(W, WM_SIZE, 0, ((Wnds^[W].CB - Wnds^[W].CT) Shl 16) Or
             ((Wnds^[W].CR - Wnds^[W].CL) And $FFFF));
  End;
  If Moved Then
    SendMsgW(W, WM_MOVE, 0, (Wnds^[W].Y Shl 16) Or (Wnds^[W].X And $FFFF));
  If IsChildW(W) Then
  Begin
    { l'ancienne zone de la fille doit etre repeinte par le parent }
    If Wnds^[W].Parent >= 0 Then InvalAll(Wnds^[W].Parent, True);
  End;
  DirtyWnd(W);
End;

Procedure DestroyW(W : LongInt);
Var I, T : LongInt;
Begin
  { fenetre de la console fermee : arreter son programme (tache 0) }
  If (W = ConW) And (ConW >= 0) Then
  Begin
    ConW := -1;
    ConLogFlush;
    ConHistN := 0; ConHistPos := 0; ConView := 0; ConSelOn := False;
    ChainExec := ''; ChainRet := ''; ConKeep := False;
    If AppRunning Then ConKillReq := True;
  End;
  If (W < 0) Or Not Wnds^[W].Used Or Wnds^[W].Destroying Then Exit;
  Wnds^[W].Destroying := True;
  If Wnds^[W].Visible And Not IsChildW(W) Then DirtyWnd(W);
  SendMsgW(W, WM_DESTROY, 0, 0);
  For I := 0 To MaxWnd - 1 Do
    If Wnds^[I].Used And ((Wnds^[I].Parent = W) Or (Wnds^[I].Owner = W)) And
       (I <> W) Then DestroyW(I);
  SendMsgW(W, WM_NCDESTROY, 0, 0);
  For I := 0 To MaxTimer - 1 Do
    If WTimers[I].Used And (WTimers[I].Wnd = W) Then
      WTimers[I].Used := False;
  For I := 0 To MaxProp - 1 Do
    If Props^[I].Used And (Props^[I].Wnd = W) Then Props^[I].Used := False;
  If IsChildW(W) And (Wnds^[W].Parent >= 0) Then
    InvalAll(Wnds^[W].Parent, True);
  If Not IsChildW(W) Then
  Begin
    DirtyWnd(W);
    ZRemove(W);
    SurfFree(Wnds^[W].Surf);
  End;
  If Wnds^[W].Extra <> 0 Then KFree(Wnds^[W].Extra);
  If Wnds^[W].LongTxt <> 0 Then KFree(Wnds^[W].LongTxt);
  Wnds^[W].LongTxt := 0;
  T := Wnds^[W].Thread;
  Wnds^[W].Used := False;
  If CaptureWin = W Then CaptureWin := -1;
  If DragWin = W Then DragWin := -1;
  If PressWin = W Then PressWin := -1;
  If FocusWin = W Then FocusWin := -1;
  If ActiveWin = W Then
  Begin
    ActiveWin := -1;
    ActivateNext;
  End;
  TaskbarChanged;
End;

{ Jeu de caracteres : le noyau et les programmes de Pasdows (compiles
  par WPC) ecrivent en CP437, la police de l'ecran ; les vrais
  programmes Windows ecrivent en ANSI (Windows-1252). Le texte d'un
  programme ANSI est converti a l'entree des API d'affichage (titres,
  controles, menus, TextOut, DrawText) et reconverti a la sortie
  (WM_GETTEXT). }
Const
  AnsiOem : Array[128..255] Of Byte = (
    69, 63, 44, 102, 34, 46, 197, 206, 94, 63, 83, 60, 79, 63, 90, 63, 63,
    39, 39, 34, 34, 249, 45, 45, 126, 159, 115, 62, 111, 63, 122, 89, 255,
    173, 155, 156, 63, 157, 124, 21, 34, 169, 166, 174, 170, 45, 158, 196,
    248, 241, 253, 51, 39, 230, 20, 250, 44, 49, 167, 175, 172, 171, 63, 168,
    65, 65, 65, 65, 142, 143, 146, 128, 69, 144, 69, 69, 73, 73, 73, 73, 68,
    165, 79, 79, 79, 79, 153, 120, 79, 85, 85, 85, 154, 89, 63, 225, 133,
    160, 131, 97, 132, 134, 145, 135, 138, 130, 136, 137, 141, 161, 140, 139,
    63, 164, 149, 162, 147, 111, 148, 246, 111, 151, 163, 150, 129, 121, 63,
    152);
  OemAnsi : Array[128..255] Of Byte = (
    199, 252, 233, 226, 228, 224, 229, 231, 234, 235, 232, 239, 238, 236,
    196, 197, 201, 230, 198, 244, 246, 242, 251, 249, 255, 214, 220, 162,
    163, 165, 174, 153, 225, 237, 243, 250, 241, 209, 170, 186, 191, 169,
    172, 189, 188, 161, 171, 187, 63, 63, 63, 124, 43, 43, 43, 43, 43, 43,
    124, 43, 43, 43, 43, 43, 43, 43, 43, 43, 45, 43, 43, 43, 43, 43, 43, 43,
    43, 45, 43, 43, 43, 43, 43, 43, 43, 43, 43, 43, 43, 43, 43, 63, 63, 63,
    63, 63, 63, 223, 63, 63, 63, 63, 181, 63, 63, 63, 63, 63, 63, 63, 63, 63,
    63, 177, 63, 63, 63, 63, 247, 63, 176, 149, 183, 63, 63, 178, 63, 160);

{ Vrai si le processus courant est un programme Windows ANSI : une
  image de WPC a l'horodatage 0 et l'editeur de liens 1.0 }
Function AnsiApp : Boolean;
Var Pe : LongInt;
Begin
  AnsiApp := False;
  If (CurProc <= 0) Or (AppBase = 0) Then Exit;
  Pe := AppBase + MemL[0:AppBase + $3C];
  AnsiApp := (MemL[0:Pe + 8] <> 0) Or (Mem[0:Pe + 26] <> 1);
End;

{ Octet ANSI -> CP437 (sans conversion pour un programme de Pasdows) }
Function OemB(B : LongInt) : LongInt;
Begin
  B := B And 255;
  If (B >= 128) And AnsiApp Then B := AnsiOem[B];
  OemB := B;
End;

{ Convertir sur place N octets (ASCIIZ si N < 0) ANSI -> CP437 ou
  CP437 -> ANSI }
Procedure CvtZ(A, N : LongInt; ToOem : Boolean);
Var B : LongInt;
Begin
  If A = 0 Then Exit;
  While N <> 0 Do
  Begin
    B := Mem[0:A];
    If (N < 0) And (B = 0) Then Exit;
    If B >= 128 Then
      If ToOem Then Mem[0:A] := AnsiOem[B] Else Mem[0:A] := OemAnsi[B];
    Inc(A);
    If N > 0 Then Dec(N);
  End;
End;

Procedure CvtStr(Var S : String; ToOem : Boolean);
Var I : LongInt;
Begin
  For I := 1 To Length(S) Do
    If Ord(S[I]) >= 128 Then
      If ToOem Then S[I] := Chr(AnsiOem[Ord(S[I])])
      Else S[I] := Chr(OemAnsi[Ord(S[I])]);
End;

{ Chaine d'un programme (ASCIIZ) en CP437 }
Function APStr(A : LongInt) : String;
Var T : String;
Begin
  T := PStr(A);
  If AnsiApp Then CvtStr(T, True);
  APStr := T;
End;

{ Caractere Unicode d'une ressource -> CP437 (ressources de WPC : le
  code CP437 elargi tel quel) }
Function UniOem(C : LongInt; An : Boolean) : Char;
Begin
  C := C And $FFFF;
  If (C >= 128) And (C < 256) And An Then C := AnsiOem[C]
  Else If C >= 256 Then
    Case C Of
      $2018, $2019, $201A : C := 39;
      $201C, $201D, $201E : C := 34;
      $2013, $2014 : C := 45;
      $2022 : C := 249;
      $2026 : C := 46;
      $20AC : C := 69;
      $0152 : C := 79;
      $0153 : C := 111;
      $2122 : C := $9F;
    Else C := 63;
    End;
  UniOem := Chr(C);
End;

{ Caractere Unicode d'une ressource -> ANSI (Windows-1252) }
Function UniAnsi(C : LongInt) : LongInt;
Begin
  C := C And $FFFF;
  If C >= 256 Then
    Case C Of
      $20AC : C := $80; $201A : C := $82; $201E : C := $84;
      $2026 : C := $85; $0152 : C := $8C; $2018 : C := $91;
      $2019 : C := $92; $201C : C := $93; $201D : C := $94;
      $2022 : C := $95; $2013 : C := $96; $2014 : C := $97;
      $2122 : C := $99; $0153 : C := $9C;
    Else C := 63;
    End;
  UniAnsi := C;
End;

{ Texte d'une fenetre depuis une chaine ASCIIZ : les 127 premiers
  caracteres dans Text, le texte complet dans le tas s'il est plus long
  (textes des programmes d'installation) }
Procedure WndSetTextZ(W, A : LongInt);
Var N, H : LongInt;
Begin
  Wnds^[W].Text := PStr(A);
  If Wnds^[W].LongTxt <> 0 Then KFree(Wnds^[W].LongTxt);
  Wnds^[W].LongTxt := 0;
  If A = 0 Then Exit;
  N := StrLenZ(A);
  If N <= 127 Then Exit;
  H := HeapOwner; HeapOwner := 0;
  Wnds^[W].LongTxt := KAlloc(N + 1);
  HeapOwner := H;
  If Wnds^[W].LongTxt <> 0 Then MoveMem(A, Wnds^[W].LongTxt, N + 1);
End;

{ Texte venu d'un programme : converti en CP437 s'il est ANSI }
Procedure WndSetTextA(W, A : LongInt);
Var T : String;
Begin
  WndSetTextZ(W, A);
  If Not AnsiApp Then Exit;
  T := Wnds^[W].Text;
  CvtStr(T, True);
  Wnds^[W].Text := T;
  CvtZ(Wnds^[W].LongTxt, -1, True);
End;

Function WndTextLen(W : LongInt) : LongInt;
Begin
  If Wnds^[W].LongTxt <> 0 Then WndTextLen := StrLenZ(Wnds^[W].LongTxt)
  Else WndTextLen := Length(Wnds^[W].Text);
End;

{ WM_GETTEXT : au plus N - 1 caracteres et le zero ; rend la longueur }
Function WndGetTextZ(W, Buf, N : LongInt) : LongInt;
Var L : LongInt;
Begin
  WndGetTextZ := 0;
  If (Buf = 0) Or (N <= 0) Then Exit;
  If Wnds^[W].LongTxt = 0 Then
  Begin
    PutPStr(Buf, Wnds^[W].Text, N);
    WndGetTextZ := Min(Length(Wnds^[W].Text), N - 1);
    Exit;
  End;
  L := Min(StrLenZ(Wnds^[W].LongTxt), N - 1);
  MoveMem(Wnds^[W].LongTxt, Buf, L);
  Mem[0:Buf + L] := 0;
  WndGetTextZ := L;
End;

{ Texte multiligne (CR LF) de longueur quelconque, coupe en morceaux
  pour WrapText ; rend le nombre de lignes }
Function WrapZ(X, Y, Wd, A, C : LongInt; Draw : Boolean) : LongInt;
Var Ch, N : LongInt; S : String;
Begin
  S := ''; N := 0;
  While True Do
  Begin
    Ch := Mem[0:A];
    { morceaux coupes de preference en fin de ligne }
    If (Ch = 0) Or ((Ch = 32) And (Length(S) >= 240)) Or
       (Length(S) >= 250) Then
    Begin
      If S <> '' Then N := N + WrapText(X, Y + N * TxtCH, Wd, S, C, Draw);
      S := '';
      If Ch = 0 Then Break;
      If Ch = 32 Then
      Begin
        Inc(A);
        Continue;
      End;
    End;
    If Ch = 10 Then
    Begin
      S := S + '|';
      If Length(S) >= 150 Then
      Begin
        N := N + WrapText(X, Y + N * TxtCH, Wd, S, C, Draw);
        S := '';
      End;
    End
    Else If Ch <> 13 Then S := S + Chr(Ch);
    Inc(A);
  End;
  WrapZ := N;
End;

{ Largeur visible d'un controle statique : sa largeur, limitee au bord
  droit de son parent (les panneaux de l'installation d'Office placent
  des textes qui depassent : avec la police MS Sans Serif ils tiennent) }
Function StaticVisW(W : LongInt) : LongInt;
Var VW, P, PW : LongInt;
Begin
  VW := Wnds^[W].W;
  P := Wnds^[W].Parent;
  If IsChildW(W) And (P >= 0) Then
  Begin
    PW := Wnds^[P].CR - Wnds^[P].CL;
    If (PW > 0) And (Wnds^[W].X + VW > PW) And (PW - Wnds^[W].X >= 16) Then
      VW := PW - Wnds^[W].X;
  End;
  StaticVisW := VW;
End;

{ Pas du texte d'un controle statique : 8, ou 7 et 6 si ses lignes ne
  tiennent pas dans sa hauteur }
Function StaticPitch(W : LongInt; T : String) : LongInt;
Var P, N, Rows : LongInt;
Begin
  StaticPitch := 0;
  Rows := Wnds^[W].H Div TxtCH;
  If Rows < 1 Then Rows := 1;
  For P := TxtCW DownTo TxtCW - 2 + Ord(TxtSmall) Do
  Begin
    TxtPitch := P;
    If Wnds^[W].LongTxt <> 0 Then
      N := WrapZ(0, 0, StaticVisW(W), Wnds^[W].LongTxt, 0, False)
    Else If (Pos(#10, T) > 0) Or (Pos(#13, T) > 0) Then
    Begin
      T := T + #0;
      N := WrapZ(0, 0, StaticVisW(W), LongInt(@T[1]), 0, False);
      Delete(T, Length(T), 1);
    End
    Else N := WrapText(0, 0, StaticVisW(W), T, 0, False);
    If N <= Rows Then
    Begin
      If P < TxtCW Then StaticPitch := P;
      TxtPitch := 0;
      Exit;
    End;
  End;
  TxtPitch := 0;
  StaticPitch := TxtCW - 1;
End;

{ Creer une fenetre ; indice ou -1. Param : CREATESTRUCT.lpCreateParams }
Function CreateW(ExStyle, Cls : LongInt; Name : String; Style, X, Y, WW,
                 HH, Parent, Menu, Inst, Param : LongInt) : LongInt;
Var W, CS, R : LongInt;
Begin
  CreateW := -1;
  W := WndAlloc;
  If W < 0 Then Exit;
  Wnds^[W].Cls := Cls;
  Wnds^[W].Style := Style And Not WS_VISIBLE;
  Wnds^[W].ExStyle := ExStyle;
  Wnds^[W].Text := Name;
  Wnds^[W].Proc := Classes^[Cls].Proc;
  Wnds^[W].IKind := Classes^[Cls].IKind;
  Wnds^[W].Thread := CurT;
  Wnds^[W].Inst := Inst;
  Wnds^[W].Cursor := Classes^[Cls].Cursor;
  If (Style And WS_CHILD) <> 0 Then
  Begin
    Wnds^[W].Parent := Parent;
    Wnds^[W].Id := Menu;
  End
  Else
  Begin
    Wnds^[W].Owner := Parent;
    Wnds^[W].Menu := Menu;
  End;
  If Classes^[Cls].WndExtra > 0 Then
  Begin
    Wnds^[W].ExtraSz := Classes^[Cls].WndExtra;
    Wnds^[W].Extra := KAlloc(Classes^[Cls].WndExtra);
  End;
  { CW_USEDEFAULT }
  If X = LongInt($80000000) Then
  Begin
    X := 40 + (W Mod 8) * 24; Y := 30 + (W Mod 8) * 20;
  End;
  If WW = LongInt($80000000) Then
  Begin
    WW := 480; HH := 340;
  End;
  Wnds^[W].X := X; Wnds^[W].Y := Y; Wnds^[W].W := Max(0, WW);
  Wnds^[W].H := Max(0, HH);
  CalcNc(W);
  WndSurf(W);
  If Not IsChildW(W) Then ZTop(W);
  { CREATESTRUCT dans un bloc du tas }
  CS := KAlloc(64 + 256);
  MemL[0:CS] := Param; MemL[0:CS + 4] := Inst; MemL[0:CS + 8] := Menu;
  MemL[0:CS + 12] := HwndOf(Parent); MemL[0:CS + 16] := HH;
  MemL[0:CS + 20] := WW; MemL[0:CS + 24] := Y; MemL[0:CS + 28] := X;
  MemL[0:CS + 32] := Style;
  PutPStr(CS + 64, Name, 128);
  MemL[0:CS + 36] := CS + 64;
  PutPStr(CS + 192, Classes^[Cls].Name, 64);
  MemL[0:CS + 40] := CS + 192;
  MemL[0:CS + 44] := ExStyle;
  CreateW := W;
  If SendMsgW(W, WM_NCCREATE, 0, CS) = 0 Then
    If Wnds^[W].Proc <> 0 Then
    Begin
      KFree(CS);
      DestroyW(W);
      CreateW := -1;
      Exit;
    End;
  R := SendMsgW(W, WM_CREATE, 0, CS);
  KFree(CS);
  If R = -1 Then
  Begin
    DestroyW(W);
    CreateW := -1;
    Exit;
  End;
  If Not Wnds^[W].Used Then
  Begin
    CreateW := -1;
    Exit;
  End;
  SendMsgW(W, WM_SIZE, 0, ((Wnds^[W].CB - Wnds^[W].CT) Shl 16) Or
           ((Wnds^[W].CR - Wnds^[W].CL) And $FFFF));
  SendMsgW(W, WM_MOVE, 0, (Wnds^[W].Y Shl 16) Or (Wnds^[W].X And $FFFF));
  If (Style And WS_MAXIMIZE) <> 0 Then
  Begin
    Wnds^[W].Max := True;
    Wnds^[W].NX := Wnds^[W].X; Wnds^[W].NY := Wnds^[W].Y;
    Wnds^[W].NW := Wnds^[W].W; Wnds^[W].NH := Wnds^[W].H;
  End;
  If (Style And WS_VISIBLE) <> 0 Then
    ShowW(W, True, Not IsChildW(W));
End;

{ ------------------------------------------------------------------ }
{ Recherche de la fenetre sous un point de l'ecran                   }
{ ------------------------------------------------------------------ }

Function ChildAt(W, X, Y : LongInt) : LongInt;
Var I, Best, BestSeq, CX, CY : LongInt; R : TRect;
Begin
  Best := -1; BestSeq := -1;
  For I := 0 To MaxWnd - 1 Do
    If Wnds^[I].Used And Wnds^[I].Visible And IsChildW(I) And
       (Wnds^[I].Parent = W) Then
    Begin
      WndScreenRect(I, R);
      If InRect(X, Y, R.L, R.T, R.R - 1, R.B - 1) Then
        If Wnds^[I].Seq > BestSeq Then
        Begin
          Best := I; BestSeq := Wnds^[I].Seq;
        End;
    End;
  If Best >= 0 Then ChildAt := ChildAt(Best, X, Y) Else ChildAt := W;
  CX := 0; CY := CX;
End;

Function TopAt(X, Y : LongInt) : LongInt;
Var I, W : LongInt;
Begin
  TopAt := -1;
  For I := ZCnt - 1 DownTo 0 Do
  Begin
    W := ZList[I];
    If Wnds^[W].Used And Wnds^[W].Visible And Not Wnds^[W].Min Then
      If InRect(X, Y, Wnds^[W].X, Wnds^[W].Y, Wnds^[W].X + Wnds^[W].W - 1,
                Wnds^[W].Y + Wnds^[W].H - 1) Then
      Begin
        TopAt := W;
        Exit;
      End;
  End;
End;

{ ------------------------------------------------------------------ }
{ Clavier : codes de balayage -> touches virtuelles                  }
{ ------------------------------------------------------------------ }

Procedure InitKeyTables;
Begin
  { #1 : touche sans caractere (WPC concatene les chaines comme des
    PChar : un #0 couperait la chaine) }
  KeyLo := #1#27'1234567890-='#8#9'qwertyuiop[]'#13#1 +
           'asdfghjkl;''`'#1'\zxcvbnm,./'#1'*'#1' ';
  KeyHi := #1#27'!@#$%^&*()_+'#8#9'QWERTYUIOP{}'#13#1 +
           'ASDFGHJKL:"~'#1'|ZXCVBNM<>?'#1'*'#1' ';
End;

Function ScanToVk(Sc : LongInt; Ext : Boolean) : LongInt;
Var C : Char;
Begin
  ScanToVk := 0;
  Case Sc Of
    $01 : ScanToVk := $1B;   $0E : ScanToVk := 8;   $0F : ScanToVk := 9;
    $1C : ScanToVk := $0D;   $1D : ScanToVk := $11; $2A, $36 : ScanToVk := $10;
    $38 : ScanToVk := $12;   $39 : ScanToVk := $20; $3A : ScanToVk := $14;
    $3B..$44 : ScanToVk := $70 + Sc - $3B;
    $57 : ScanToVk := $7A;   $58 : ScanToVk := $7B;
    $47 : ScanToVk := $24;   $48 : ScanToVk := $26; $49 : ScanToVk := $21;
    $4B : ScanToVk := $25;   $4D : ScanToVk := $27; $4F : ScanToVk := $23;
    $50 : ScanToVk := $28;   $51 : ScanToVk := $22; $52 : ScanToVk := $2D;
    $53 : ScanToVk := $2E;   $4A : ScanToVk := $6D; $4E : ScanToVk := $6B;
    $37 : ScanToVk := $6A;   $5B : ScanToVk := $5B; $5C : ScanToVk := $5C;
    $5D : ScanToVk := $5D;
  Else
    If Sc <= $39 Then
    Begin
      C := UpCase(KeyLo[Sc + 1]);
      Case C Of
        'A'..'Z', '0'..'9' : ScanToVk := Ord(C);
        ';' : ScanToVk := $BA; '=' : ScanToVk := $BB; ',' : ScanToVk := $BC;
        '-' : ScanToVk := $BD; '.' : ScanToVk := $BE; '/' : ScanToVk := $BF;
        '`' : ScanToVk := $C0; '[' : ScanToVk := $DB; '\' : ScanToVk := $DC;
        ']' : ScanToVk := $DD; '''' : ScanToVk := $DE;
      End;
    End;
  End;
End;

{ Caractere d'une touche (selon Majuscules et Verr. maj.) ; 0 si aucun }
Function ScanToChar(Sc : LongInt) : LongInt;
Var C : Char; Sh : Boolean;
Begin
  ScanToChar := 0;
  If (Sc > $39) Or (Sc = 0) Then Exit;
  Sh := (KeyState[$10] And $80) <> 0;
  If Sh Then C := KeyHi[Sc + 1] Else C := KeyLo[Sc + 1];
  If ((KeyState[$14] And 1) <> 0) And (UpCase(C) >= 'A') And
     (UpCase(C) <= 'Z') Then
  Begin
    If Sh Then C := KeyLo[Sc + 1] Else C := KeyHi[Sc + 1];
  End;
  If C <> #1 Then ScanToChar := Ord(C);
End;

{ ------------------------------------------------------------------ }
{ Reduire, agrandir, restaurer                                       }
{ ------------------------------------------------------------------ }

Procedure MinimizeW(W : LongInt);
Begin
  If Wnds^[W].Min Then Exit;
  DirtyWnd(W);
  Wnds^[W].Min := True;
  If W = ActiveWin Then ActivateNext;
  PostMsgW(W, WM_SIZE, 1, 0);
  TaskbarChanged;
End;

Procedure RestoreW(W : LongInt);
Begin
  If Wnds^[W].Min Then
  Begin
    Wnds^[W].Min := False;
    DirtyWnd(W);
    ActivateW(W);
    PostMsgW(W, WM_SIZE, 0, ((Wnds^[W].CB - Wnds^[W].CT) Shl 16) Or
             ((Wnds^[W].CR - Wnds^[W].CL) And $FFFF));
    InvalAll(W, True);
    Exit;
  End;
  If Wnds^[W].Max Then
  Begin
    Wnds^[W].Max := False;
    MoveW(W, Wnds^[W].NX, Wnds^[W].NY, Wnds^[W].NW, Wnds^[W].NH, True);
    NcPaint(W);
    ZFullScr(W);
  End;
End;

{ Agrandir : la zone de travail (au-dessus de la barre des taches) ;
  une fenetre sans barre de titre (WS_POPUP d'un jeu) prend tout
  l'ecran, comme sous Windows }
Procedure MaximizeW(W : LongInt);
Var B, HH : LongInt;
Begin
  If Wnds^[W].Max Then Exit;
  Wnds^[W].NX := Wnds^[W].X; Wnds^[W].NY := Wnds^[W].Y;
  Wnds^[W].NW := Wnds^[W].W; Wnds^[W].NH := Wnds^[W].H;
  Wnds^[W].Max := True;
  B := Wnds^[W].CL;
  If (Wnds^[W].Style And $C00000) = $C00000 Then HH := TaskY
  Else HH := ScrH;
  MoveW(W, -B, -B, ScrW + 2 * B, HH + 2 * B, True);
  NcPaint(W);
  ZFullScr(W);
End;

{ Commande systeme (bouton ou menu systeme) }
Procedure SysCommand(W, Cmd : LongInt);
Begin
  Case Cmd And $FFF0 Of
    SC_CLOSE : PostMsgW(W, WM_CLOSE, 0, 0);
    SC_MINIMIZE : MinimizeW(W);
    SC_MAXIMIZE : MaximizeW(W);
    SC_RESTORE : RestoreW(W);
  End;
End;

{ ------------------------------------------------------------------ }
{ Souris (tache 0)                                                   }
{ ------------------------------------------------------------------ }

Function MouseKeys : LongInt;
Var K : LongInt;
Begin
  K := 0;
  If (MouseBtn And 1) <> 0 Then K := K Or 1;
  If (MouseBtn And 2) <> 0 Then K := K Or 2;
  If (KeyState[$10] And $80) <> 0 Then K := K Or 4;
  If (KeyState[$11] And $80) <> 0 Then K := K Or 8;
  MouseKeys := K;
End;

{ Message souris vers la fenetre W (coordonnees client) }
Procedure MouseTo(W, Msg : LongInt);
Var X, Y : LongInt;
Begin
  ClientScreenOrg(W, X, Y);
  X := CurX - X; Y := CurY - Y;
  If (Wnds^[W].IKind >= ikButton) And (Wnds^[W].IKind <= ikMdiClient) And
     ((Wnds^[W].Proc <> 0) Or CtlOwner(W)) And (Wnds^[W].IKind <> ikDialog)
  Then
    { controle sous-classe par le programme ou dessine par lui : le clic
      passe par sa file de messages (sa procedure, puis CallWindowProc) }
    QPost(Wnds^[W].Thread, HwndOf(W), Msg, MouseKeys,
          ((Y And $FFFF) Shl 16) Or (X And $FFFF))
  Else If (Wnds^[W].IKind >= ikButton) And (Wnds^[W].IKind <= ikMdiClient)
  Then
  Begin
    If Wnds^[W].IKind <> ikDialog Then
      KWndProc(W, Msg, MouseKeys, ((Y And $FFFF) Shl 16) Or (X And $FFFF));
  End
  Else If Wnds^[W].IKind <> ikNone Then KMouse(W, Msg, X, Y)
  Else
    PostMsgW(W, Msg, MouseKeys, ((Y And $FFFF) Shl 16) Or (X And $FFFF));
End;

Function ModalBlocked(T : LongInt) : Boolean; Forward;

Procedure CloseMenus(Lv : LongInt); Forward;
Procedure MBarClick(W, It, IX : LongInt); Forward;
Procedure W32MenuPick(K : LongInt); Forward;

Procedure MouseButton(Down : Boolean; Btn : LongInt);
Var T, W, B, X1, Y1, X2, Y2, Msg, OX, OY : LongInt; Dbl : Boolean;
Begin
  If Btn = 1 Then KeyState[1] := Ord(Down) * $80
  Else KeyState[2] := Ord(Down) * $80;
  { programme DOS graphique en plein ecran : la souris lui revient }
  If DosFullScr Then
  Begin
    If Btn = 1 Then
      If Down Then DosMouseScr(WM_LBUTTONDOWN) Else DosMouseScr(WM_LBUTTONUP)
    Else If Down Then DosMouseScr(WM_RBUTTONDOWN)
    Else DosMouseScr(WM_RBUTTONUP);
    Exit;
  End;
  { capture de la souris }
  If (CaptureWin >= 0) And Wnds^[CaptureWin].Used Then
  Begin
    If Btn = 1 Then
      If Down Then Msg := WM_LBUTTONDOWN Else Msg := WM_LBUTTONUP
    Else If Down Then Msg := WM_RBUTTONDOWN Else Msg := WM_RBUTTONUP;
    MouseTo(CaptureWin, Msg);
    Exit;
  End;
  { fin d'un deplacement ou d'un bouton de titre }
  If Not Down And (Btn = 1) Then
  Begin
    If DragWin >= 0 Then
    Begin
      DragWin := -1;
      Exit;
    End;
    If PressWin >= 0 Then
    Begin
      W := PressWin; B := -1 - PressBtn;
      PressWin := -1;
      NcPaint(W);
      CapBtnRect(W, B, X1, Y1, X2, Y2);
      If InRect(CurX - Wnds^[W].X, CurY - Wnds^[W].Y, X1, Y1, X2, Y2) Then
        Case B Of
          0 : SysCommand(W, SC_CLOSE);
          1 : If Wnds^[W].Max Then SysCommand(W, SC_RESTORE)
              Else SysCommand(W, SC_MAXIMIZE);
          2 : SysCommand(W, SC_MINIMIZE);
        End;
      Exit;
    End;
  End;
  T := TopAt(CurX, CurY);
  If T < 0 Then
  Begin
    If Down Then KMouse(-1, WM_LBUTTONDOWN + 3 * (Btn - 1), CurX, CurY)
    Else KMouse(-1, WM_LBUTTONUP + 3 * (Btn - 1), CurX, CurY);
    Exit;
  End;
  { un clic dans la fenetre d'un programme ferme les menus ouverts }
  MBarTog := -1;
  If Down And (MenuDepth > 0) And (Wnds^[T].IKind = ikNone) Then
  Begin
    MBarTog := MBarOpen; MBarTogW := MBarW;
    CloseMenus(0);
  End;
  If Down And ModalBlocked(T) Then
  Begin
    KBeep;
    Exit;
  End;
  If Down And (T <> ActiveWin) Then ActivateW(T);
  OX := CurX - Wnds^[T].X; OY := CurY - Wnds^[T].Y;
  { zone non client : barre de titre et boutons }
  If Down And (Btn = 1) And
     Not InRect(OX, OY, Wnds^[T].CL, Wnds^[T].CT, Wnds^[T].CR - 1,
                Wnds^[T].CB - 1) Then
  Begin
    If HasMenuBar(T) Then
    Begin
      B := MBarHit(T, OX, OY, X1);
      If B >= 0 Then
      Begin
        MBarClick(T, B, X1);
        Exit;
      End;
    End;
    For B := 0 To CapButtonCount(T) - 1 Do
    Begin
      CapBtnRect(T, B, X1, Y1, X2, Y2);
      If InRect(OX, OY, X1, Y1, X2, Y2) Then
      Begin
        PressWin := T; PressBtn := -1 - B;
        NcPaint(T);
        Exit;
      End;
    End;
    { icone de la barre de titre : menu systeme (l'Invite DOS a le
      sien : Modifier, Proprietes) }
    If ((Wnds^[T].Style And WS_CAPTION) = WS_CAPTION) And
       ((Wnds^[T].Style And WS_SYSMENU) <> 0) And
       ((Wnds^[T].ExStyle And WS_EX_DLGMODALFRAME) = 0) And
       (OY < Wnds^[T].CL + 19) And (OX < Wnds^[T].CL + 20) Then
    Begin
      SysMenuW := T;
      CloseMenus(0);
      If T = ConW Then
        OpenMenu(0, mnConSys, Wnds^[T].X + Wnds^[T].CL,
                 Wnds^[T].Y + Wnds^[T].CL + 19, False)
      Else
        OpenMenu(0, mnSysGen, Wnds^[T].X + Wnds^[T].CL,
                 Wnds^[T].Y + Wnds^[T].CL + 19, False);
      Exit;
    End;
    If ((Wnds^[T].Style And WS_CAPTION) = WS_CAPTION) And
       (OY < Wnds^[T].CL + 19) Then
    Begin
      Dbl := (LastClickW = -2 - T) And (Ticks - LastClickT < DblMs);
      LastClickW := -2 - T; LastClickT := Ticks;
      If Dbl And ((Wnds^[T].Style And WS_MAXIMIZEBOX) <> 0) Then
      Begin
        If Wnds^[T].Max Then RestoreW(T) Else MaximizeW(T);
        Exit;
      End;
      If Not Wnds^[T].Max Then
      Begin
        DragWin := T; DragDX := OX; DragDY := OY;
      End;
    End;
    If Wnds^[T].IKind <> ikNone Then KMouse(T, WM_LBUTTONDOWN, OX, OY);
    Exit;
  End;
  If (Not Down) And (Btn = 1) And (Wnds^[T].IKind <> ikNone) And
     Not InRect(OX, OY, Wnds^[T].CL, Wnds^[T].CT, Wnds^[T].CR - 1,
                Wnds^[T].CB - 1) Then Exit;
  { zone client : fenetre fille la plus profonde }
  W := ChildAt(T, CurX, CurY);
  If Not Wnds^[W].Enabled Then Exit;
  If Btn = 1 Then
  Begin
    If Down Then
    Begin
      Dbl := (LastClickW = W) And (Ticks - LastClickT < DblMs) And
             (Abs(CurX - LastClickX) < 4) And (Abs(CurY - LastClickY) < 4);
      LastClickW := W; LastClickT := Ticks;
      LastClickX := CurX; LastClickY := CurY;
      If Dbl And (((Classes^[Wnds^[W].Cls].Style And CS_DBLCLKS) <> 0) Or
         (Wnds^[W].IKind <> ikNone)) Then
      Begin
        Msg := WM_LBUTTONDBLCLK;
        LastClickW := -1;
      End
      Else Msg := WM_LBUTTONDOWN;
      { controle (meme sous-classe par le programme) : il prend le focus }
      If (W <> FocusWin) And IsChildW(W) And
         ((Wnds^[W].Proc = 0) Or (Wnds^[W].IKind <> ikNone)) Then
        SetFocusW(W);
    End
    Else Msg := WM_LBUTTONUP;
  End
  Else If Down Then Msg := WM_RBUTTONDOWN Else Msg := WM_RBUTTONUP;
  MouseTo(W, Msg);
End;

Procedure MouseMoved;
Var T, W, NX, NY : LongInt;
Begin
  If DosFullScr Then
  Begin
    DosMouseScr(WM_MOUSEMOVE);
    Exit;
  End;
  If DragWin >= 0 Then
  Begin
    NX := CurX - DragDX; NY := CurY - DragDY;
    If NY < 0 Then NY := 0;
    If NY > TaskY - 20 Then NY := TaskY - 20;
    MoveW(DragWin, NX, NY, Wnds^[DragWin].W, Wnds^[DragWin].H, False);
    Exit;
  End;
  If PressWin >= 0 Then Exit;
  If (CaptureWin >= 0) And Wnds^[CaptureWin].Used Then
  Begin
    MouseTo(CaptureWin, WM_MOUSEMOVE);
    Exit;
  End;
  T := TopAt(CurX, CurY);
  If T < 0 Then
  Begin
    KMouse(-1, WM_MOUSEMOVE, CurX, CurY);
    If CurKind <> 0 Then CursorSetShape(0);
    Exit;
  End;
  W := ChildAt(T, CurX, CurY);
  If Wnds^[W].IKind <> ikNone Then
  Begin
    If CurKind <> 0 Then CursorSetShape(0);
    MouseTo(W, WM_MOUSEMOVE);
  End
  Else
  Begin
    If InRect(CurX - Wnds^[T].X, CurY - Wnds^[T].Y, Wnds^[T].CL, Wnds^[T].CT,
              Wnds^[T].CR - 1, Wnds^[T].CB - 1) Then
      MouseTo(W, WM_MOUSEMOVE)
    Else If CurKind = 2 Then CursorSetShape(0);
  End;
End;

{ ------------------------------------------------------------------ }
{ Clavier (tache 0)                                                  }
{ ------------------------------------------------------------------ }

Function RunExe(Path, Args : String) : Boolean; Forward;
Procedure SecurityOpen(Mode : LongInt); Forward;
Procedure SecUnlock; Forward;

Var
  SecLockOn : Boolean;               { ecran verrouille (Ctrl+Alt+Suppr) }
  SecLockW : LongInt;

Procedure KeyEvent(Sc : LongInt; Up, Ext : Boolean);
Var Vk, Lp, Msg, W, Ch : LongInt; Alt : Boolean;
Begin
  Vk := ScanToVk(Sc, Ext);
  If Vk = 0 Then Exit;
  If Up Then KeyState[Vk] := KeyState[Vk] And $7F
  Else
  Begin
    If (KeyState[Vk] And $80) = 0 Then KeyState[Vk] := KeyState[Vk] Xor 1;
    KeyState[Vk] := KeyState[Vk] Or $80;
  End;
  Alt := (KeyState[$12] And $80) <> 0;
  Lp := 1 Or (Sc Shl 16);
  If Ext Then Lp := Lp Or $01000000;
  If Alt Then Lp := Lp Or $20000000;
  If Up Then Lp := Lp Or LongInt($C0000000);
  Ch := 0;
  If Not Up Then Ch := ScanToChar(Sc);
  KeyScan := Sc; KeyExt := Ext;
  { raccourcis du systeme : Ctrl+Alt+Suppr ouvre la boite Securite de
    Pasdows (ou deverrouille l'ecran), Ctrl+Maj+Echap le Gestionnaire
    des taches (comme Windows XP) ; ecran verrouille : rien d'autre }
  If SecLockOn And Not (Wnds^[SecLockW].Used And
     (Wnds^[SecLockW].IKind = ikSecurity)) Then SecLockOn := False;
  If Not Up And ((KeyState[$11] And $80) <> 0) And
     (((Vk = $2E) And Alt) Or ((Vk = $1B) And
      ((KeyState[$10] And $80) <> 0))) Then
  Begin
    If SecLockOn Then SecUnlock
    Else If Vk = $2E Then SecurityOpen(0)
    Else RunExe('TASKMGR.EXE', '');
    Exit;
  End;
  If SecLockOn Then Exit;
  If Not Up Then
  Begin
    KKey(-1, WM_KEYDOWN, Vk, Ch);
    If Vk = 0 Then Exit;
  End;
  W := FocusWin;
  If (W < 0) Or Not Wnds^[W].Used Then W := ActiveWin;
  If W < 0 Then
  Begin
    If Not Up Then KKey(-2, WM_KEYDOWN, Vk, Ch);
    Exit;
  End;
  { controle sous-classe par le programme (SetWindowLongA GWL_WNDPROC) :
    il recoit les touches comme une fenetre du programme }
  If (Wnds^[W].IKind <> ikNone) And
     Not ((Wnds^[W].IKind = ikEdit) And (Wnds^[W].Proc <> 0)) Then
  Begin
    If Up Then KKey(W, WM_KEYUP, Vk, Ch) Else KKey(W, WM_KEYDOWN, Vk, Ch);
    Exit;
  End;
  If Alt Or (Vk = $12) Or (Vk = $79) Then
    If Up Then Msg := WM_SYSKEYUP Else Msg := WM_SYSKEYDOWN
  Else If Up Then Msg := WM_KEYUP Else Msg := WM_KEYDOWN;
  If Wnds^[W].IKind <> ikNone Then
    QPost(Wnds^[W].Thread, HwndOf(W), Msg, Vk, Lp)
  Else PostMsgW(W, Msg, Vk, Lp);
End;

{ Traiter les evenements materiels en attente }
Var
  VbPosAt : LongInt;

Function VmmCount : LongInt; Forward;
Procedure VmmPacket(Var X, Y, Btn : LongInt); Forward;
Procedure VwTcloPoll; Forward;

{ Etat des boutons (souris PS/2 ou absolue) }
Procedure MouseSetBtn(Bt : LongInt; Var Moved : Boolean);
Begin
  If MouSwap Then
    Bt := (Bt And Not 3) Or ((Bt And 1) Shl 1) Or ((Bt Shr 1) And 1);
  If (Bt And 1) <> (MouseBtn And 1) Then
  Begin
    If Moved Then MouseMoved;
    Moved := False;
    MouseBtn := (MouseBtn And Not 1) Or (Bt And 1);
    MouseButton((Bt And 1) <> 0, 1);
  End;
  If (Bt And 2) <> (MouseBtn And 2) Then
  Begin
    MouseBtn := (MouseBtn And Not 2) Or (Bt And 2);
    MouseButton((Bt And 2) <> 0, 2);
  End;
End;

Var
  DIInHook : Boolean;        { DIHook en cours (pas de reentree) }
  AbsLX, AbsLY : LongInt;    { derniere position absolue (-1 : aucune) }
  WarpUntil : LongInt;       { un programme replace le curseur (SetCursorPos) }
  LastPI : LongInt;          { dernier passage de ProcessInput }

{ Position absolue (AX, AY) de la souris de l'hote -> deplacement :
  DirectInput recoit toujours le mouvement de l'hote ; le curseur suit la
  position absolue, sauf quand le programme le replace lui-meme (jeux
  qui recentrent le curseur a chaque image) : il avance alors du
  deplacement seulement }
Procedure AbsMouse(AX, AY : LongInt; Var NX, NY : LongInt;
                   Var Moved : Boolean);
Var Dx, Dy : LongInt;
Begin
  If AbsLX < 0 Then
  Begin
    AbsLX := CurX; AbsLY := CurY;
  End;
  Dx := AX - AbsLX; Dy := AY - AbsLY;
  AbsLX := AX; AbsLY := AY;
  If (Dx = 0) And (Dy = 0) Then Exit;
  DIMX := DIMX + Dx; DIMY := DIMY + Dy;
  If Ticks - WarpUntil < 0 Then
  Begin
    NX := Max(0, Min(ScrW - 1, CurX + Dx));
    NY := Max(0, Min(ScrH - 1, CurY + Dy));
  End
  Else
  Begin
    NX := AX; NY := AY;
  End;
  If (NX <> CurX) Or (NY <> CurY) Then
  Begin
    CursorMoveTo(NX, NY);
    Moved := True;
  End;
End;

Procedure DIHook; Forward;

Procedure ProcessInput;
Var B, Dx, Dy, Bt, NX, NY, AX, AY, N : LongInt; Moved : Boolean;
Begin
  LastPI := Ticks;
  While KbHead <> KbTail Do
  Begin
    B := KbQ[KbHead];
    KbHead := (KbHead + 1) And 255;
    If B = $E0 Then KExt := True
    Else
    Begin
      KeyEvent(B And $7F, (B And $80) <> 0, KExt);
      KExt := False;
    End;
  End;
  Moved := False;
  NX := CurX; NY := CurY;
  { VirtualBox : evenements de l'hote ; souris integree : position
    absolue (lue a chaque paquet PS/2 et regulierement) }
  If VbPort <> 0 Then
  Begin
    VbPoll;
    If VbAbs And ((MouHead <> MouTail) Or (Ticks - VbPosAt >= 0)) Then
    Begin
      VbPosAt := Ticks + 15;
      If VbMousePos(AX, AY) Then AbsMouse(AX, AY, NX, NY, Moved);
    End;
  End;
  { VMware : souris absolue (vmmouse) ; les paquets PS/2 ne font que
    signaler les evenements, lus dans la file de la backdoor }
  If VmmOn And ((MouHead <> MouTail) Or (Ticks - VbPosAt >= 0)) Then
  Begin
    VbPosAt := Ticks + 15;
    MouHead := MouTail;
    N := VmmCount;
    While (N >= 4) And VmmOn Do
    Begin
      If AbsLX < 0 Then
      Begin
        AbsLX := CurX; AbsLY := CurY;
      End;
      AX := AbsLX; AY := AbsLY;
      VmmPacket(AX, AY, Bt);
      N := N - 4;
      AbsMouse(AX, AY, NX, NY, Moved);
      DIMBtn := Bt;
      MouseSetBtn(Bt, Moved);
    End;
  End;
  If VwOn Then VwTcloPoll;
  While MouHead <> MouTail Do
  Begin
    Dx := MouQDx[MouHead]; Dy := MouQDy[MouHead]; Bt := MouQBtn[MouHead];
    MouHead := (MouHead + 1) And 255;
    If VbAbs Then
    Begin
      Dx := 0; Dy := 0;
    End;
    { vitesse du pointeur (Panneau de configuration, Souris) }
    If (MouSpd <> 10) And (MouSpd > 0) Then
    Begin
      Dx := (Dx * MouSpd) Div 10; Dy := (Dy * MouSpd) Div 10;
    End;
    NX := NX + Dx; NY := NY + Dy;
    DIMX := DIMX + Dx; DIMY := DIMY + Dy; DIMBtn := Bt;
    If NX < 0 Then NX := 0;
    If NY < 0 Then NY := 0;
    If NX > ScrW - 1 Then NX := ScrW - 1;
    If NY > ScrH - 1 Then NY := ScrH - 1;
    If (NX <> CurX) Or (NY <> CurY) Then
    Begin
      CursorMoveTo(NX, NY);
      Moved := True;
    End;
    MouseSetBtn(Bt, Moved);
  End;
  If Moved Then MouseMoved;
  DIHook;
  If SvOn Then
  Begin
    { apres un changement de mode, tout l'ecran une ou deux fois de plus
      (QEMU ignore les zones recues pendant qu'il change de surface) }
    If (SvFull1 <> 0) And (Ticks - SvFull1 >= 0) Then
    Begin
      SvFull1 := 0;
      SvAdd(0, 0, ScrW, ScrH);
    End;
    If (SvFull2 <> 0) And (Ticks - SvFull2 >= 0) Then
    Begin
      SvFull2 := 0;
      SvAdd(0, 0, ScrW, ScrH);
    End;
    SvFlush;
  End;
End;

{ ------------------------------------------------------------------ }
{ Lecture des messages d'une tache (GetMessage / PeekMessage)        }
{ ------------------------------------------------------------------ }

Function MsgMatch(Var M : TMsgRec; Hwnd, MinM, MaxM : LongInt) : Boolean;
Begin
  MsgMatch := ((Hwnd = 0) Or (M.Hwnd = Hwnd)) And
    (((MinM = 0) And (MaxM = 0)) Or ((M.Msg >= MinM) And (M.Msg <= MaxM)));
End;

{ Message suivant pour la tache T ; False si aucun. Remove : retirer }
Function KPeekMsg(T : LongInt; Var M : TMsgRec; Hwnd, MinM, MaxM : LongInt;
                  Remove : Boolean) : Boolean;
Var I, J, K, W : LongInt;
Begin
  KPeekMsg := True;
  I := Threads[T].QHead;
  While I <> Threads[T].QTail Do
  Begin
    If MsgMatch(MsgQ^[T * MaxQueue + I], Hwnd, MinM, MaxM) Then
    Begin
      M := MsgQ^[T * MaxQueue + I];
      If Remove Then
      Begin
        { retirer l'element I de la file }
        J := I;
        While J <> Threads[T].QHead Do
        Begin
          K := (J + MaxQueue - 1) Mod MaxQueue;
          MsgQ^[T * MaxQueue + J] := MsgQ^[T * MaxQueue + K];
          J := K;
        End;
        Threads[T].QHead := (Threads[T].QHead + 1) Mod MaxQueue;
      End;
      Exit;
    End;
    I := (I + 1) Mod MaxQueue;
  End;
  If Threads[T].QuitFlag Then
  Begin
    M.Hwnd := 0; M.Msg := WM_QUIT; M.WP := Threads[T].QuitCode; M.LP := 0;
    M.Time := Ticks; M.X := CurX; M.Y := CurY;
    If Remove Then Threads[T].QuitFlag := False;
    Exit;
  End;
  { WM_PAINT }
  If Threads[T].PaintReq Then
  Begin
    Threads[T].PaintReq := False;
    For W := 0 To MaxWnd - 1 Do
      If Wnds^[W].Used And (Wnds^[W].Thread = T) And
         ((Wnds^[W].IKind = ikNone) Or CtlOwner(W) Or DlgPaints(W)) And
         HasUpdate(W) And WndVisible(W) Then
      Begin
        Threads[T].PaintReq := True;
        If ((Hwnd = 0) Or (HwndOf(W) = Hwnd)) And
           (((MinM = 0) And (MaxM = 0)) Or
            ((MinM <= WM_PAINT) And (MaxM >= WM_PAINT))) Then
        Begin
          M.Hwnd := HwndOf(W); M.Msg := WM_PAINT; M.WP := 0; M.LP := 0;
          M.Time := Ticks; M.X := CurX; M.Y := CurY;
          Exit;
        End;
      End;
  End;
  { WM_TIMER }
  For I := 0 To MaxTimer - 1 Do
    If WTimers[I].Used And (WTimers[I].Thread = T) And
       (Ticks >= WTimers[I].Next) Then
    Begin
      If ((Hwnd = 0) Or (HwndOf(WTimers[I].Wnd) = Hwnd)) And
         (((MinM = 0) And (MaxM = 0)) Or
          ((MinM <= WM_TIMER) And (MaxM >= WM_TIMER))) Then
      Begin
        M.Hwnd := HwndOf(WTimers[I].Wnd); M.Msg := WM_TIMER;
        M.WP := WTimers[I].Id; M.LP := WTimers[I].Proc;
        M.Time := Ticks; M.X := CurX; M.Y := CurY;
        If Remove Then WTimers[I].Next := Ticks + WTimers[I].Elapse;
        Exit;
      End;
    End;
  KPeekMsg := False;
End;

