Procedure ExitProcessK(Code : LongInt); Forward;

Procedure ExitProcess(Code : LongInt);
Begin
  ExitProcessK(Code);
End;

Function TerminateProcess(H, Code : LongInt) : LongInt;
Var I, P : LongInt;
Begin
  TerminateProcess := 0;
  If H = -1 Then
  Begin
    ExitProcessK(Code);
    Exit;
  End;
  I := KObjOf(H, koProcess);
  If I < 0 Then
  Begin
    SetErr(6);
    Exit;
  End;
  P := KObjs^[I].F1;
  If (KObjs^[I].F2 = 0) And (P > 0) And (P < MaxProc) And Procs^[P].Used Then
  Begin
    If P = ThrProc[CurT] Then ExitProcessK(Code)
    Else KillProc(P, Code);
  End;
  TerminateProcess := 1;
End;

