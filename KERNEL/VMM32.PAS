Function CheckMenuItem(H, Id, Flags : LongInt) : LongInt;
Var M, I : LongInt;
Begin
  CheckMenuItem := -1;
  M := MenuIdx(H);
  If M < 0 Then Exit;
  I := MItemFind(M, Id, Flags);
  If I < 0 Then Exit;
  CheckMenuItem := MItemsP^[I].Flags And MF_CHECKED;
  MItemsP^[I].Flags := (MItemsP^[I].Flags And Not MF_CHECKED) Or
                     (Flags And MF_CHECKED);
