{ LoadIcon : groupe RT_GROUP_ICON (14) du module, entree 32 x 32 la plus
  riche en couleurs (sinon la plus grande), image RT_ICON (3) ; icone du
  systeme (generique) pour Inst = 0 ou sans ressource }
Function LoadIconA(Inst, Name : LongInt) : LongInt;
Var M, E, A, N, I, Best, Sc, BS, Size, W, Id : LongInt;
Begin
  LoadIconA := $7000 + (Name And $FFF);
  If Inst = 0 Then Exit;
  M := AppModule(Inst);
  If M = 0 Then Exit;
  E := ResFind(M, Name, 14);
  If E = 0 Then Exit;
  A := ResData(M, E, Size);
  N := MemW[0:A + 4];
  Best := -1; BS := -1;
  For I := 0 To N - 1 Do
  Begin
    W := Mem[0:A + 6 + I * 14];
    If W = 0 Then W := 256;
    Sc := MemW[0:A + 6 + I * 14 + 6];
    If W = 32 Then Sc := Sc + 10000 Else Sc := Sc + W * 10;
    If Sc > BS Then
    Begin
      BS := Sc; Best := I;
    End;
  End;
  If Best < 0 Then Exit;
  Id := MemW[0:A + 6 + Best * 14 + 12];
  E := ResFind(M, Id, 3);
  If E = 0 Then Exit;
  I := IconNew(ResData(M, E, Size));
  If I <> 0 Then LoadIconA := I;
End;

Function DestroyIcon(H : LongInt) : LongInt;
Begin
  DestroyIcon := 1;
End;

Function LoadBitmapA(Inst, Name : LongInt) : LongInt;
Var E, A, Size, B : LongInt;
Begin
  LoadBitmapA := 0;
  If Inst = 0 Then Exit;
  E := ResFind(AppModule(Inst), Name, 2);
  If E = 0 Then Exit;
  A := ResData(AppModule(Inst), E, Size);
  B := CreateDIBitmapK(A, 0, 0);
  LoadBitmapA := GdiH(B);
End;

Function LoadAcceleratorsA(Inst, Name : LongInt) : LongInt;
