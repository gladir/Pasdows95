  If W < 0 Then Exit;
  MenuBarRecalc(W);
  DrawMenuBar := 1;
End;

Function GetSystemMenu(H, Revert : LongInt) : LongInt;
Var W : LongInt;
Begin
  W := WndOf(H);
  GetSystemMenu := 0;
  If W < 0 Then Exit;
  If Wnds^[W].K1 = 0 Then Wnds^[W].K1 := MenuNew;
  GetSystemMenu := Wnds^[W].K1;
