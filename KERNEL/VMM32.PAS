Function GetVersionExA(P : LongInt) : LongInt;
Begin
  MemL[0:P + 4] := 4;
  MemL[0:P + 8] := 0;
  MemL[0:P + 12] := $040003B6;
  MemL[0:P + 16] := 1;
  Mem[0:P + 20] := 0;
  GetVersionExA := 1;
End;

Procedure GetSystemInfo(P : LongInt);
Begin
  FillMem(P, 36, 0);
  MemL[0:P + 4] := 4096;
  MemL[0:P + 8] := $10000;
  MemL[0:P + 12] := $7FFEFFFF;
  MemL[0:P + 16] := 1;
  MemL[0:P + 20] := 1;
  MemL[0:P + 24] := 586;
  MemL[0:P + 28] := 65536;
  MemW[0:P + 32] := 5;
End;

