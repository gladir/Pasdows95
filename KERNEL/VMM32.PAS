{ tache arretee designee par une poignee de fil : cadre de sa faute }
Function DbgFrameOf(H : LongInt) : LongInt;
Var I : LongInt;
Begin
  DbgFrameOf := 0;
  I := KObjOf(H, koThread);
  If (I >= 0) And DbgOn And (DbgFrame <> 0) And (KObjs^[I].F1 = DbgT) Then
    DbgFrameOf := DbgFrame;
End;

{ CONTEXT x86 : Edi 156, Esi 160, Ebx 164, Edx 168, Ecx 172, Eax 176,
  Ebp 180, Eip 184, SegCs 188, EFlags 192, Esp 196, SegSs 200 }
Function GetThreadContext(H, C : LongInt) : LongInt;
Var F, S : LongInt;
Begin
  GetThreadContext := 0;
  F := DbgFrameOf(H);
  If F = 0 Then Exit;
  FillMem(C + 4, 200, 0);
  MemL[0:C + 156] := MemL[0:F + 12]; MemL[0:C + 160] := MemL[0:F + 16];
  MemL[0:C + 164] := MemL[0:F + 28]; MemL[0:C + 168] := MemL[0:F + 32];
  MemL[0:C + 172] := MemL[0:F + 36]; MemL[0:C + 176] := MemL[0:F + 40];
  MemL[0:C + 180] := MemL[0:F + 20];
  MemL[0:C + 184] := MemL[0:F + 44 + DbgOfs];
  MemL[0:C + 188] := MemL[0:F + 48 + DbgOfs] And $FFFF;
  MemL[0:C + 192] := MemL[0:F + 52 + DbgOfs];
  MemL[0:C + 196] := F + 56 + DbgOfs;
  asm
    xor eax,eax
    mov ax,ds
    mov S,eax
  end;
  MemL[0:C + 152] := S; MemL[0:C + 148] := S; MemL[0:C + 200] := S;
  GetThreadContext := 1;
End;

{ ESP et les segments ne changent pas (cadre de l'anneau 0) }
Function SetThreadContext(H, C : LongInt) : LongInt;
Var F : LongInt;
Begin
  SetThreadContext := 0;
  F := DbgFrameOf(H);
  If F = 0 Then Exit;
  MemL[0:F + 12] := MemL[0:C + 156]; MemL[0:F + 16] := MemL[0:C + 160];
  MemL[0:F + 28] := MemL[0:C + 164]; MemL[0:F + 32] := MemL[0:C + 168];
  MemL[0:F + 36] := MemL[0:C + 172]; MemL[0:F + 40] := MemL[0:C + 176];
  MemL[0:F + 20] := MemL[0:C + 180];
  MemL[0:F + 44 + DbgOfs] := MemL[0:C + 184];
  MemL[0:F + 52 + DbgOfs] := (MemL[0:C + 192] And $DD5) Or $202;
  SetThreadContext := 1;
End;

Var DbgBuf : Array[0..4095] Of Byte;    { memoire d'un autre processus }

{ copie entre l'espace du processus de H et la memoire du noyau ; Wr :
  vers le processus (jamais le code du noyau, partage) }
Function DbgCopy(H, A, B, N, PDone : LongInt; Wr : Boolean) : LongInt;
Var I, P, C, Done, Old, Fl : LongInt; Ok : Boolean;
Begin
  DbgCopy := 0;
  P := CurProc;
  If H <> -1 Then
  Begin
    I := KObjOf(H, koProcess);
    If I < 0 Then Exit;
    P := KObjs^[I].F1;
  End;
  If Wr And (A < KImgHi) Then
  Begin
    SetErr(998);
    Exit;
  End;
  Done := 0;
  While Done < N Do
  Begin
    C := 4096 - ((A + Done) And 4095);
    If C > N - Done Then C := N - Done;
    If Wr Then MoveMem(B + Done, LongInt(@DbgBuf), C);
    asm
      pushfd
      pop eax
      mov Fl,eax
      cli
    end;
    Old := Cr3Now;
    SetCr3(ProcCr3(P));
    Ok := LinOk(A + Done) And LinOk(A + Done + C - 1);
    If Ok Then
      If Wr Then MoveMem(LongInt(@DbgBuf), A + Done, C)
      Else MoveMem(A + Done, LongInt(@DbgBuf), C);
    SetCr3(Old);
    If (Fl And $200) <> 0 Then
      asm
        sti
      end;
    If Not Ok Then Break;
    If Not Wr Then MoveMem(LongInt(@DbgBuf), B + Done, C);
    Done := Done + C;
  End;
  If PDone <> 0 Then MemL[0:PDone] := Done;
  If Done = N Then DbgCopy := 1 Else SetErr(299);
End;

Function ReadProcessMemory(H, A, B, N, PDone : LongInt) : LongInt;
Begin
  ReadProcessMemory := DbgCopy(H, A, B, N, PDone, False);
End;

Function WriteProcessMemory(H, A, B, N, PDone : LongInt) : LongInt;
Begin
  WriteProcessMemory := DbgCopy(H, A, B, N, PDone, True);
End;

Function CreateProcessA(PApp, PCmd, PA, TA, Inh, Flags, Env, PDir, SI,
                        PI : LongInt) : LongInt;
Var S, Prog, Args, F, D : String; P, I, Sh : LongInt; Q : Boolean;
Begin
  CreateProcessA := 0;
  S := '';
  If PCmd <> 0 Then S := Trim(PStr(PCmd));
  If PApp <> 0 Then
  Begin
    Prog := PStr(PApp);
    Args := S;
    { la ligne de commande commence par le nom du programme }
    If (Args <> '') And (Args[1] = '"') Then
    Begin
      P := Pos('"', Copy(Args, 2, 255));
      If P > 0 Then Args := Copy(Args, P + 2, 255) Else Args := '';
    End
    Else
    Begin
      P := Pos(' ', Args);
      If P > 0 Then Args := Copy(Args, P + 1, 255) Else Args := '';
    End;
  End
  Else
  Begin
    Q := (S <> '') And (S[1] = '"');
    If Q Then
    Begin
      P := Pos('"', Copy(S, 2, 255));
      If P = 0 Then P := Length(S);
      Prog := Copy(S, 2, P - 1);
      Args := Copy(S, P + 2, 255);
    End
    Else
    Begin
      P := CmdProgEnd(S);
      Prog := Copy(S, 1, P - 1);
      Args := Copy(S, P + 1, 255);
    End;
  End;
  Args := Trim(Args);
  F := FindModuleFile(Prog);
  If F = '' Then F := FindModuleFile(Prog + '.EXE');
  KLog('CreateProcess [' + Prog + '] -> [' + F + ']');
  If F = '' Then
  Begin
    SetErr(ErrFileNotFound);
    Exit;
  End;
  { Windows 3.x et MS-DOS : lances a part ; objet processus signale a
    la fin (machine DOS) ou aussitot (Win16) }
  If (IsNeFile(F) And Not IsDosFile(F)) Or IsDosFile(F) Then
  Begin
    If IsDosFile(F) Then
    Begin
      If Not RunDos(F, Args) Or (VmProc < 0) Then Exit;
      P := VmProc;
    End
    Else
    Begin
      If Not RunNe(F, Args, 1) Then Exit;
      I := KObjNew(koProcess);
      If I < 0 Then Exit;
      KObjOwner[I] := 0;
      KObjs^[I].F2 := 1;
      If PI <> 0 Then
      Begin
        MemL[0:PI] := KHandle(I); MemL[0:PI + 4] := KHandle(I);
        MemL[0:PI + 8] := $200 + I; MemL[0:PI + 12] := $300 + I;
      End;
      CreateProcessA := 1;
      Exit;
    End;
  End
  Else
  Begin
    { STARTUPINFO : dwFlags +44 (STARTF_USESHOWWINDOW 1), wShowWindow +48 }
    Sh := 1;
    If (SI <> 0) And ((MemL[0:SI + 44] And 1) <> 0) Then Sh := MemW[0:SI + 48];
    { sans dossier : celui du programme appelant (comme Windows) }
    D := '';
    If PDir <> 0 Then D := PStr(PDir)
    Else If CurProc > 0 Then D := CurDirS;
    { STARTF_USESTDHANDLES (100h) : hStdOutput (+60) }
    { (hStdInput +56 ; une poignee de console garde la console) }
    KNextStd := 0; KNextIn := 0;
    If (SI <> 0) And ((MemL[0:SI + 44] And $100) <> 0) Then
    Begin
      KNextStd := MemL[0:SI + 60];
      KNextIn := MemL[0:SI + 56];
      If IsConsoleH(KNextStd) Then KNextStd := 0;
      If IsConsoleH(KNextIn) Then KNextIn := 0;
    End;
    { DEBUG_PROCESS / DEBUG_ONLY_THIS_PROCESS : une session a la fois }
    KNextDbg := Flags And 3;
    If (KNextDbg <> 0) And DbgOn Then
    Begin
      KNextStd := 0; KNextDbg := 0; KNextIn := 0;
      SetErr(5);
      Exit;
    End;
    P := ProcStart(F, Args, D, Sh, ((Flags And 4) <> 0) Or (KNextDbg <> 0));
    If (P >= 0) And (KNextDbg <> 0) Then DbgStart(P);
    KNextStd := 0; KNextDbg := 0; KNextIn := 0;
    If P < 0 Then
    Begin
      SetErr(193);
      Exit;
    End;
  End;
  If PI <> 0 Then
  Begin
    MemL[0:PI] := KHandle(Procs^[P].Obj);
    I := Procs^[P].MainT;
    If (I >= 0) And (Threads[I].KObj >= 0) Then
      MemL[0:PI + 4] := KHandle(Threads[I].KObj)
    Else MemL[0:PI + 4] := KHandle(Procs^[P].Obj);
    MemL[0:PI + 8] := Procs^[P].Pid;
    If I >= 0 Then MemL[0:PI + 12] := ThreadId(I) Else MemL[0:PI + 12] := 0;
  End;
  CreateProcessA := 1;
End;

