{ CreateProcessW : chaines converties, STARTUPINFO sans ses textes }
Function CreateProcessW(PApp, PCmd, PA, TA, Inh, Flags, Env, PDir, SI,
                        PI : LongInt) : LongInt;
Var A, C, D : TZBuf; S : Array[0..16] Of LongInt; Cmd : String;
