{ Ligne de la boite Executer : programme (entre guillemets s'il contient
  des espaces) puis ses arguments ; la ligne entiere est d'abord essayee
  comme nom de programme (C:\Program Files\...\X.EXE sans guillemets) }
Function FindModuleFile(Name : String) : String; Forward;

{ Fin du nom du programme d'une ligne de commande sans guillemets
  (position de l'espace qui le suit) : comme Windows, chaque espace est
  essaye (C:\Program Files\Dossier\Prog.exe /x : C:\Program, puis
  C:\Program Files\Dossier...) jusqu'a un programme existant ; sinon
  le premier mot. }
Function CmdProgEnd(Const S : String) : LongInt;
Var P, I : LongInt; F : String;
Begin
  P := Pos(' ', S);
  If P = 0 Then P := Length(S) + 1;
  I := P;
  While I <= Length(S) Do
  Begin
    F := Copy(S, 1, I - 1);
    If (Pos('\', F) > 0) And ((FindModuleFile(F) <> '') Or
       (FindModuleFile(F + '.EXE') <> '')) Then
    Begin
      P := I;
      Break;
    End;
    Inc(I);
    While (I <= Length(S)) And (S[I] <> ' ') Do Inc(I);
  End;
  CmdProgEnd := P;
End;

Function RunLine(S : String) : Boolean;
Var P : LongInt; Prog, Args : String;
Begin
  RunLine := True;
  If (S[1] <> '"') And (FindModuleFile(S) <> '') Then
    If RunExe(S, '') Then Exit;
  If S[1] = '"' Then
  Begin
    P := Pos('"', Copy(S, 2, 255));
    If P = 0 Then P := Length(S);
    Prog := Copy(S, 2, P - 1);
    Args := Trim(Copy(S, P + 2, 255));
  End
  Else
  Begin
    P := CmdProgEnd(S);
    Prog := Copy(S, 1, P - 1);
    Args := Trim(Copy(S, P + 1, 255));
  End;
  { Bloc-notes (integre au noyau), comme NOTEPAD.EXE de Windows }
  If (UpStr(Prog) = 'NOTEPAD') Or (UpStr(Prog) = 'NOTEPAD.EXE') Then
  Begin
    If (Length(Args) > 1) And (Args[1] = '"') Then
      Args := Copy(Args, 2, Length(Args) - 2);
    NoteOpen(Args);
    Exit;
  End;
  RunLine := RunExe(Prog, Args);
End;

