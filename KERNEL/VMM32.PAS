Function SysColorRGB(I : LongInt) : LongInt;
Begin
  Case I Of
    0, 4, 10, 11, 15, 22 : SysColorRGB := $C0C0C0;
    1 : SysColorRGB := $808000;
    2, 13 : SysColorRGB := $800000;
    3, 12, 16, 17 : SysColorRGB := $808080;
    5, 9, 14, 20 : SysColorRGB := $FFFFFF;
    19 : SysColorRGB := $C0C0C0;
    24 : SysColorRGB := $E1FFFF;
  Else
    SysColorRGB := 0;
  End;
End;

Function GetSysColor(I : LongInt) : LongInt;
Begin
  GetSysColor := SysColorRGB(I);
End;

Function SetSysColors(N, PE, PC : LongInt) : LongInt;
Begin
  SetSysColors := 1;
End;

Var
  SysBrush : Array[0..30] Of LongInt;

{ Pinceau : poignee, ou COLOR_xxx + 1 (classes) }
Function KBrushOf(Br : LongInt) : LongInt;
Begin
  KBrushOf := -1;
  If (Br > 0) And (Br <= 31) Then
  Begin
    If SysBrush[Br - 1] = 0 Then
      SysBrush[Br - 1] := CreateSolidBrush(SysColorRGB(Br - 1));
    KBrushOf := GdiOf(SysBrush[Br - 1], goBrush);
    Exit;
  End;
  KBrushOf := GdiOf(Br, goBrush);
End;

Function GetSysColorBrush(I : LongInt) : LongInt;
Begin
  GetSysColorBrush := GdiH(KBrushOf(I + 1));
End;

Function FillRect(Hdc, P, Br : LongInt) : LongInt;
Var D : LongInt; R : TRect;
Begin
  FillRect := 1;
  D := DcOf(Hdc);
  If Not DcBegin(D) Then Exit;
  GetRectAt(P, R);
  BrushFill(R.L, R.T, R.R - 1, R.B - 1, KBrushOf(Br));
  DcDirty(R.L, R.T, R.R, R.B);
End;

Function FrameRect(Hdc, P, Br : LongInt) : LongInt;
Var D, B : LongInt; R : TRect;
Begin
  FrameRect := 1;
  D := DcOf(Hdc);
  If Not DcBegin(D) Then Exit;
  GetRectAt(P, R);
  B := KBrushOf(Br);
  BrushFill(R.L, R.T, R.R - 1, R.T, B);
  BrushFill(R.L, R.B - 1, R.R - 1, R.B - 1, B);
  BrushFill(R.L, R.T, R.L, R.B - 1, B);
  BrushFill(R.R - 1, R.T, R.R - 1, R.B - 1, B);
  DcDirty(R.L, R.T, R.R, R.B);
End;

Function InvertRect(Hdc, P : LongInt) : LongInt;
Var D, X, Y : LongInt; R : TRect;
Begin
  InvertRect := 1;
  D := DcOf(Hdc);
  If Not DcBegin(D) Then Exit;
  GetRectAt(P, R);
  For Y := Max(R.T, ClipY1) To Min(R.B - 1, ClipY2) Do
    For X := Max(R.L, ClipX1) To Min(R.R - 1, ClipX2) Do
      XorPix(X, Y, TgtMask);
  DcDirty(R.L, R.T, R.R, R.B);
End;

Function DrawEdge(Hdc, P, EdgeT, Flags : LongInt) : LongInt;
Var D : LongInt; R : TRect;
Begin
  DrawEdge := 1;
  D := DcOf(Hdc);
  If Not DcBegin(D) Then Exit;
  GetRectAt(P, R);
  If (EdgeT And 5) <> 0 Then
  Begin
    If (EdgeT And 1) <> 0 Then Edge(R.L, R.T, R.R - 1, R.B - 1, cSilver, cBlack)
    Else Edge(R.L, R.T, R.R - 1, R.B - 1, cWhite, cBlack);
    Edge(R.L + 1, R.T + 1, R.R - 2, R.B - 2, cWhite, cGray);
  End
  Else
  Begin
    Edge(R.L, R.T, R.R - 1, R.B - 1, cGray, cWhite);
    Edge(R.L + 1, R.T + 1, R.R - 2, R.B - 2, cBlack, cSilver);
  End;
  If (Flags And $800) <> 0 Then
    FBar(R.L + 2, R.T + 2, R.R - 3, R.B - 3, cSilver);
  DcDirty(R.L, R.T, R.R, R.B);
End;

{ DrawFrameControl : Typ 1 legende, 2 menu, 3 defilement, 4 bouton ;
  State : sorte (case 0, radio 1 ou 4, trois etats 8, bouton 10h ;
  fleches 0 haut, 1 bas, 2 gauche, 3 droite, 5 liste) et drapeaux
  100h inactif, 200h enfonce, 400h coche, 4000h plat }
Function DrawFrameControl(Hdc, P, Typ, State : LongInt) : LongInt;
Var D, K, X, Y, Sz, C, I : LongInt; R : TRect; Bg : LongInt;
Begin
  DrawFrameControl := 1;
  D := DcOf(Hdc);
  If Not DcBegin(D) Then Exit;
  GetRectAt(P, R);
  K := State And $FF;
  If (Typ = 4) And ((K = 0) Or (K = 8)) Then
  Begin
    { case a cocher : carre creux, coche noire (grise si inactive ou
      troisieme etat) }
    Sz := Min(R.R - R.L, R.B - R.T);
    If Sz > 13 Then Sz := 13;
    X := R.L + (R.R - R.L - Sz) Div 2;
    Y := R.T + (R.B - R.T - Sz) Div 2;
    If ((State And $300) <> 0) Or (K = 8) And ((State And $400) <> 0) Then
      Bg := cSilver
    Else Bg := cWhite;
    Sunken(X, Y, X + Sz - 1, Y + Sz - 1, Bg);
    If (State And $400) <> 0 Then
    Begin
      If ((State And $100) <> 0) Or (K = 8) Then C := cGray Else C := cBlack;
      For I := 0 To 2 Do
      Begin
        DLine(X + 3, Y + Sz Div 2 - 1 + I, X + 5, Y + Sz Div 2 + 1 + I, C);
        DLine(X + 5, Y + Sz Div 2 + 1 + I, X + Sz - 4, Y + 3 + I, C);
      End;
    End;
  End
  Else If (Typ = 4) And ((K = 1) Or (K = 2) Or (K = 4)) Then
    RadioButton(R.L + (R.R - R.L - 13) Div 2, R.T + (R.B - R.T - 14) Div 2,
                '', (State And $400) <> 0)
  Else If Typ = 3 Then
  Begin
    { fleches de defilement et de liste deroulante }
    Raised(R.L, R.T, R.R - 1, R.B - 1, (State And $200) <> 0);
    If (State And $100) <> 0 Then C := cGray Else C := cBlack;
    X := (R.L + R.R) Div 2 - 3;
    Y := (R.T + R.B) Div 2 - 2;
    Case K Of
      0 : Arrow(X, Y, 2, C);
      2 : For I := 0 To 3 Do VLine(X + 4 - I, Y - 1 + I, Y + 5 - I, C);
      3 : Arrow(X + 2, Y - 1, 0, C);
    Else
      Arrow(X, Y, 1, C);
    End;
  End
  Else
  Begin
    FBar(R.L, R.T, R.R - 1, R.B - 1, cSilver);
    Raised(R.L, R.T, R.R - 1, R.B - 1, (State And $200) <> 0);
  End;
  DcDirty(R.L, R.T, R.R, R.B);
End;

Function DrawCaption(H, Hdc, P, Flags : LongInt) : LongInt;
Var D, W : LongInt; R : TRect;
Begin
  DrawCaption := 1;
  D := DcOf(Hdc);
  W := WndOf(H);
  If (W < 0) Or Not DcBegin(D) Then Exit;
  GetRectAt(P, R);
  If (Flags And 1) <> 0 Then FBar(R.L, R.T, R.R - 1, R.B - 1, cNavy)
  Else FBar(R.L, R.T, R.R - 1, R.B - 1, cGray);
  OutBold(R.L + 4, R.T + 1, Fit(Wnds^[W].Text, R.R - R.L - 8), cWhite);
  DcDirty(R.L, R.T, R.R, R.B);
End;

{ ------------------------------------------------------------------ }
{ Icones des programmes : image d'une ressource RT_ICON (en-tete      }
{ BITMAPINFOHEADER, hauteur double : points puis masque ET). Poignee : }
{ IconBase + indice ; les icones du systeme (LoadIcon(0, IDI_...))     }
{ gardent l'icone generique.                                           }
{ ------------------------------------------------------------------ }

Const
  MaxIcon = 256;
  IconBase = $0001C000;

Var
  IconBmi : Array[0..MaxIcon - 1] Of LongInt;
  IconCnt : LongInt;

{ nouvelle icone d'apres une image RT_ICON ; 0 si l'en-tete n'en est pas
  une }
Function IconNew(Bmi : LongInt) : LongInt;
Var I : LongInt;
Begin
  IconNew := 0;
  If (Bmi = 0) Or (MemL[0:Bmi] <> 40) Then Exit;
  If (MemL[0:Bmi + 4] <= 0) Or (MemL[0:Bmi + 4] > 256) Or
     (MemL[0:Bmi + 8] <= 0) Or (MemL[0:Bmi + 8] > 512) Then Exit;
  { la meme image : la meme poignee }
  For I := 0 To IconCnt - 1 Do
    If IconBmi[I] = Bmi Then
    Begin
      IconNew := IconBase + I;
      Exit;
    End;
  If IconCnt >= MaxIcon Then Exit;
  IconBmi[IconCnt] := Bmi;
  IconNew := IconBase + IconCnt;
  Inc(IconCnt);
End;

Function IconOf(H : LongInt) : LongInt;
Begin
  IconOf := -1;
  If (H >= IconBase) And (H < IconBase + IconCnt) Then
    IconOf := H - IconBase;
End;

{ largeur et hauteur d'une icone (32 pour les icones du systeme) }
Procedure IconSize(H : LongInt; Var W, Hh : LongInt);
Var I : LongInt;
Begin
  W := 32; Hh := 32;
  I := IconOf(H);
  If I < 0 Then Exit;
  W := MemL[0:IconBmi[I] + 4];
  Hh := MemL[0:IconBmi[I] + 8] Div 2;
End;

{ dessiner l'icone H en (X, Y), a la taille CW x CH (0 : la sienne), dans
  la cible courante (DcBegin ou dessin d'un controle) : points ou le
  masque ET vaut 0, plus proche voisin pour la mise a l'echelle ; Gdi :
  couleurs du DC (GColor), sinon de l'ecran }
Procedure IconPaint(H, X, Y, CW, CH : LongInt; Gdi : Boolean);
Var I, A, W, Hh, Bpp, N, Tab, Bits, Msk, P, PM, DX, DY, SX, SY, R, V,
    Q : LongInt;
Begin
  I := IconOf(H);
  If I < 0 Then
  Begin
    { icones du systeme (LoadIcon(0, IDI_...)) : IDI_HAND, IDI_QUESTION,
      IDI_EXCLAMATION, IDI_ASTERISK ; l'icone d'application sinon }
    { icones du noyau (ExtractIcon d'une applet .CPL) }
    If (H >= $7E00) And (H < $7F00) Then
    Begin
      If CW <= 0 Then CW := 32;
      PaintIcon(H - $7E00, X, Y, CW);
      Exit;
    End;
    Case H Of
      $7F01 : PaintIcon(icError, X, Y, 32);
      $7F02 : PaintIcon(icQuestion, X, Y, 32);
      $7F03 : PaintIcon(icWarn, X, Y, 32);
      $7F04 : PaintIcon(icInfo, X, Y, 32);
    Else
      PaintIcon(icApp, X, Y, 32);
    End;
    Exit;
  End;
  A := IconBmi[I];
  W := MemL[0:A + 4]; Hh := MemL[0:A + 8] Div 2; Bpp := MemW[0:A + 14];
  If CW <= 0 Then CW := W;
  If CH <= 0 Then CH := Hh;
  N := MemL[0:A + 32];
  If (N = 0) And (Bpp <= 8) Then N := 1 Shl Bpp;
  If Bpp > 8 Then N := 0;
  Tab := A + MemL[0:A];
  Bits := Tab + N * 4;
  P := ((W * Bpp + 31) Div 32) * 4;
  PM := ((W + 31) Div 32) * 4;
  Msk := Bits + P * Hh;
  For DY := 0 To CH - 1 Do
  Begin
    SY := (DY * Hh) Div CH;
    R := Hh - 1 - SY;
    For DX := 0 To CW - 1 Do
    Begin
      SX := (DX * W) Div CW;
      If (Mem[0:Msk + R * PM + SX Shr 3] And ($80 Shr (SX And 7))) = 0 Then
      Begin
        Case Bpp Of
          1 : V := (Mem[0:Bits + R * P + SX Shr 3] Shr (7 - SX And 7)) And 1;
          4 : V := (Mem[0:Bits + R * P + SX Shr 1] Shr
                    (4 * (1 - SX And 1))) And 15;
          8 : V := Mem[0:Bits + R * P + SX];
        Else
          V := -1;
        End;
        If V >= 0 Then
        Begin
          Q := Tab + V * 4;
          V := Mem[0:Q + 2] Or (Mem[0:Q + 1] Shl 8) Or (Mem[0:Q] Shl 16);
        End
        Else If Bpp = 24 Then
        Begin
          Q := Bits + R * P + SX * 3;
          V := Mem[0:Q + 2] Or (Mem[0:Q + 1] Shl 8) Or (Mem[0:Q] Shl 16);
        End
        Else If Bpp = 32 Then
        Begin
          Q := Bits + R * P + SX * 4;
          V := Mem[0:Q + 2] Or (Mem[0:Q + 1] Shl 8) Or (Mem[0:Q] Shl 16);
        End
        Else V := 0;
        If Gdi Then Pix(X + DX, Y + DY, GColor(V))
        Else Pix(X + DX, Y + DY, DirOf(V));
      End;
    End;
  End;
End;

Function DrawIcon(Hdc, X, Y, Icon : LongInt) : LongInt;
Var D, W, H : LongInt;
Begin
  DrawIcon := 1;
  D := DcOf(Hdc);
  If Not DcBegin(D) Then Exit;
  IconSize(Icon, W, H);
  IconPaint(Icon, X, Y, 0, 0, True);
  DcDirty(X, Y, X + W, Y + H);
End;

Function DrawFocusRect(Hdc, P : LongInt) : LongInt;
Begin
  DrawFocusRect := 1;
End;

{ DrawTextA : DT_CENTER 1, DT_RIGHT 2, DT_VCENTER 4, DT_BOTTOM 8,
  DT_WORDBREAK 10h, DT_SINGLELINE 20h, DT_CALCRECT 400h }
Function DrawTextA0(Hdc, Str, N, P, Fmt : LongInt) : LongInt;
Var D, Cols, Lines, I, X, Y, Bg, C, Pt, CW : LongInt; R : TRect;
    S, Ln, Wd : String; LnArr : Array[0..15] Of String[80];
Begin
  DrawTextA0 := 16;
  D := DcOf(Hdc);
  If D < 0 Then Exit;
  If N = -1 Then N := StrLenZ(Str);
  S := '';
  For I := 0 To Min(N, 254) - 1 Do S := S + Chr(Mem[0:Str + I]);
  If AnsiApp Then CvtStr(S, True);
  I := Pos('&', S);
  If I > 0 Then Delete(S, I, 1);
  GetRectAt(P, R);
  { dans une fenetre : pas au-dela de sa zone cliente (les rectangles
    des programmes sont prevus pour MS Sans Serif, plus etroite que la
    police 8x16 : panneaux de l'installation d'Office) }
  If ((Fmt And $400) = 0) And (Dcs[D].Wnd >= 0) And Dcs[D].Client Then
  Begin
    CW := Wnds^[Dcs[D].Wnd].CR - Wnds^[Dcs[D].Wnd].CL;
    If (R.R > CW) And (R.L < CW - 16) Then R.R := CW;
  End;
  { lignes : sauts de ligne respectes hors DT_SINGLELINE, coupure aux
    mots avec DT_WORDBREAK ; texte resserre (7 puis 6 points par
    caractere) si une ligne depasse la largeur (sans DT_WORDBREAK) ou si
    les lignes depassent la hauteur du rectangle (avec) }
  Pt := TxtCW + 1;
  Repeat
    Dec(Pt);
    Cols := Max(1, (R.R - R.L) Div Pt);
    Lines := 0; C := 0;
    Ln := ''; Wd := '';
    For I := 1 To Length(S) + 1 Do
      If (I > Length(S)) Or (S[I] = #10) Or
         ((S[I] = ' ') And ((Fmt And $10) <> 0)) Then
      Begin
        If (Fmt And $10) = 0 Then
        Begin
          If Ln = '' Then Ln := Wd Else Ln := Ln + ' ' + Wd;
        End
        Else If (Length(Ln) + Length(Wd) + 1 > Cols) And (Ln <> '') Then
        Begin
          If Lines < 16 Then LnArr[Lines] := Ln;
          C := Max(C, Length(Ln));
          Inc(Lines);
          Ln := Wd;
        End
        Else If Ln = '' Then Ln := Wd Else Ln := Ln + ' ' + Wd;
        Wd := '';
        If (I > Length(S)) Or ((S[I] = #10) And ((Fmt And $20) = 0)) Then
        Begin
          If (I <= Length(S)) Or (Ln <> '') Or (Lines = 0) Then
          Begin
            If Lines < 16 Then LnArr[Lines] := Ln;
            C := Max(C, Length(Ln));
            Inc(Lines);
          End;
          Ln := '';
        End;
      End
      Else If (S[I] <> #13) And Not ((S[I] = #10) And ((Fmt And $20) <> 0))
      Then
      Begin
        { un mot plus long que la ligne (sans DT_WORDBREAK : la ligne) }
        Wd := Wd + S[I];
      End;
  Until (Pt <= TxtCW - 2 + Ord(TxtSmall)) Or ((Fmt And $400) <> 0) Or
        (((Fmt And $10) <> 0) And (Lines * TxtCH <= R.B - R.T)) Or
        (((Fmt And $10) = 0) And (C * Pt <= R.R - R.L));
  If Lines > 16 Then Lines := 16;
  If (Fmt And $400) <> 0 Then
  Begin
    C := 0;
    For I := 0 To Lines - 1 Do C := Max(C, Length(LnArr[I]));
    R.R := R.L + C * TxtCW; R.B := R.T + Lines * TxtCH;
    PutRectAt(P, R);
    DrawTextA0 := Lines * TxtCH;
    Exit;
  End;
  If Not DcBegin(D) Then Exit;
  Y := R.T;
  If (Fmt And $24) = $24 Then Y := (R.T + R.B - TxtCH) Div 2
  Else If (Fmt And $28) = $28 Then Y := R.B - TxtCH;
  C := GColor(Dcs[D].TextColor);
  Bg := GColor(Dcs[D].BkColor);
  If (Fmt And $100) = 0 Then
  Begin
    ClipX1 := Max(ClipX1, R.L); ClipY1 := Max(ClipY1, R.T);
    ClipX2 := Min(ClipX2, R.R - 1); ClipY2 := Min(ClipY2, R.B - 1);
  End;
  If Pt < TxtCW Then TxtPitch := Pt;
  For I := 0 To Lines - 1 Do
  Begin
    X := R.L;
    If (Fmt And 1) <> 0 Then X := (R.L + R.R - TextW(LnArr[I])) Div 2
    Else If (Fmt And 2) <> 0 Then X := R.R - TextW(LnArr[I]);
    If Dcs[D].BkMode = 2 Then
      FBar(X, Y, X + TextW(LnArr[I]) - 1, Y + TxtCH - 1, Bg);
    OutTxt(X, Y, LnArr[I], C);
    Y := Y + TxtCH;
  End;
  TxtPitch := 0;
  DcDirty(R.L, R.T, R.R, R.B);
  DrawTextA0 := Lines * TxtCH;
End;

{ DrawTextA : petite police du DC (MS Sans Serif 8...) en 6x13 }
