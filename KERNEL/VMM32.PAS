Var R : LongInt;
Begin
  R := KeyState[Vk And 255] And 1;
  If (KeyState[Vk And 255] And $80) <> 0 Then R := R Or LongInt($FFFFFF80);
  GetKeyState := R;
End;

Function GetAsyncKeyState(Vk : LongInt) : LongInt;
Begin
