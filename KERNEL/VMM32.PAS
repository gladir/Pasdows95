{ Signaler un objet puis en attendre un autre }
Function SignalObjectAndWait(HS, HW, Ms, Alert : LongInt) : LongInt;
Var I : LongInt;
Begin
  I := KObjOf(HS, 0);
  If I >= 0 Then
    Case KObjs^[I].Kind Of
      koEvent : SetEvent(HS);
      koMutex : ReleaseMutex(HS);
      koSemaphore : ReleaseSemaphore(HS, 1, 0);
    End;
  SignalObjectAndWait := KWait(HW, Ms);
End;

{ CRITICAL_SECTION : +4 LockCount, +8 RecursionCount, +12 OwningThread }
Procedure InitializeCriticalSection(Cs : LongInt);
Begin
  FillMem(Cs, 24, 0);
  MemL[0:Cs + 4] := -1;
End;

Procedure DeleteCriticalSection(Cs : LongInt);
Begin
End;

Procedure EnterCriticalSection(Cs : LongInt);
Var Me : LongInt;
Begin
  Me := ThreadId(CurT);
  While (MemL[0:Cs + 12] <> 0) And (MemL[0:Cs + 12] <> Me) Do
  Begin
    If ThreadOfId(MemL[0:Cs + 12]) < 0 Then Break;
    If Not Threads[ThreadOfId(MemL[0:Cs + 12])].Used Or
       (Threads[ThreadOfId(MemL[0:Cs + 12])].State = tsDead) Then Break;
    KYield;
  End;
  MemL[0:Cs + 12] := Me;
  MemL[0:Cs + 8] := MemL[0:Cs + 8] + 1;
  MemL[0:Cs + 4] := MemL[0:Cs + 4] + 1;
End;

Procedure LeaveCriticalSection(Cs : LongInt);
Begin
  MemL[0:Cs + 8] := MemL[0:Cs + 8] - 1;
  MemL[0:Cs + 4] := MemL[0:Cs + 4] - 1;
  If MemL[0:Cs + 8] <= 0 Then
  Begin
    MemL[0:Cs + 8] := 0;
    MemL[0:Cs + 12] := 0;
    MemL[0:Cs + 4] := -1;
  End;
End;

Function InterlockedIncrement(P : LongInt) : LongInt;
Begin
  MemL[0:P] := MemL[0:P] + 1;
  InterlockedIncrement := MemL[0:P];
End;

Function InterlockedDecrement(P : LongInt) : LongInt;
Begin
  MemL[0:P] := MemL[0:P] - 1;
  InterlockedDecrement := MemL[0:P];
End;

Function InterlockedExchange(P, V : LongInt) : LongInt;
Begin
  InterlockedExchange := MemL[0:P];
  MemL[0:P] := V;
End;

Function TlsAlloc : LongInt;
Var I : LongInt;
Begin
  TlsAlloc := -1;
  For I := 0 To TlsSlots - 1 Do
    If Not TlsUsed[I] Then
    Begin
      TlsUsed[I] := True;
      TlsAlloc := I;
      Exit;
    End;
End;

Function TlsFree(I : LongInt) : LongInt;
Begin
  If (I >= 0) And (I < TlsSlots) Then TlsUsed[I] := False;
  TlsFree := 1;
End;

Function TlsGetValue(I : LongInt) : LongInt;
Begin
  TlsGetValue := 0;
  If (I >= 0) And (I < TlsSlots) Then
    TlsGetValue := MemL[0:Threads[CurT].Tib + 4096 + I * 4];
  SetErr(0);
End;

Function TlsSetValue(I, V : LongInt) : LongInt;
Begin
  TlsSetValue := 0;
  If (I < 0) Or (I >= TlsSlots) Then Exit;
  MemL[0:Threads[CurT].Tib + 4096 + I * 4] := V;
  TlsSetValue := 1;
End;

{ ==================================================================== }
{ Partie 9 - API Win32 GDI32                                           }
{ ==================================================================== }
{ Objets GDI (poignee = 00020000h + 4 * indice) :
    stylo   : I1 style, I2 largeur, I3 couleur
    pinceau : I1 style (0 plein, 1 nul, 2 hachures, 3 motif), I2 couleur,
              I3 hachure, I4 bitmap du motif
    police  : I1 hauteur, I3 graisse, Name nom
    bitmap  : I1 bits, I2 largeur, I3 hauteur, I4 bits par point,
              I5 octets par ligne, I6 table de couleurs (RGBQUAD) ou 0,
              I7 drapeaux (1 DIB, 2 de haut en bas, 4 monochrome),
              I8 contexte qui l'a selectionne (+1)
    palette : I1 entrees (PALETTEENTRY), I2 nombre, I3 correspondance
              vers la palette systeme (256 octets)
    region  : I1..I4 rectangle (bornes exclusives), I5 sorte
    contexte: I1 indice dans Dcs
  Les bitmaps compatibles (DDB) ont le format de l'ecran : indices de la
  palette systeme en 256 couleurs, couleurs vraies (15, 16, 24 ou 32
  bits) en High Color et True Color ; ils sont convertis quand le mode
  change. Les bitmaps monochromes gardent un octet 0 (noir) ou 1 (blanc)
  par point. Les DIB gardent leur format et leur table de couleurs,
  traduites lors des transferts (I7 : 10h pour une DIB 16 bits en
  5-6-5). }

Const
  MaxDC = 96;
  SRCCOPY = $CC0020; SRCPAINT = $EE0086; SRCAND = $8800C6;
  SRCINVERT = $660046; SRCERASE = $440328; NOTSRCCOPY = $330008;
  NOTSRCERASE = $1100A6; MERGECOPY = $C000CA; MERGEPAINT = $BB0226;
  PATCOPY = $F00021; PATPAINT = $FB0A09; PATINVERT = $5A0049;
  DSTINVERT = $550009; BLACKNESS = $42; WHITENESS = $FF0062;

Type
  TGdi = Record
    Used  : Boolean;
    Kind  : LongInt;
    Stock : Boolean;
    Owner : LongInt;
    I1, I2, I3, I4, I5, I6, I7, I8 : LongInt;
    Name  : String[31];
  End;

  TDC = Record
    Used      : Boolean;
    Wnd       : LongInt;      { fenetre (-1 : memoire ou ecran) }
    Client    : Boolean;
    Screen    : Boolean;
    Bmp, Pen, Brush, Font, Pal : LongInt;   { indices d'objets GDI }
    BkColor, TextColor, BkMode, Rop2, TextAlign, StretchMode : LongInt;
    PolyFill  : LongInt;
    PosX, PosY, VpX, VpY, WinX, WinY : LongInt;
    HasClip   : Boolean;
    ClipR     : TRect;        { coordonnees du periph. (origine du DC) }
    HasPaint  : Boolean;
    PaintR    : TRect;
    Gdi       : LongInt;      { objet GDI du contexte }
    Saved     : LongInt;      { pile SaveDC (bloc du tas) }
    NSaved    : LongInt;
    Owned     : Boolean;      { CS_OWNDC }
  End;

  TGdiArr = Array[0..MaxGdi - 1] Of TGdi;
  PGdiArr = ^TGdiArr;

Var
  Gdis      : PGdiArr;         { alloue dans le tas (place sous 4 Mo) }
  Dcs       : Array[0..MaxDC - 1] Of TDC;
  StockObj  : Array[0..19] Of LongInt;
  DefBmp    : LongInt;        { bitmap monochrome 1x1 par defaut }
  SysPalUse : LongInt;
  DefPal    : LongInt;
  XlatTab   : Array[0..255] Of Byte;
  XlatL     : Array[0..255] Of LongInt;  { indice source -> point cible }
  GMono     : Boolean;        { cible : bitmap monochrome (0 ou 1) }
  DibG6     : Boolean;        { DIB 16 bits en 5-6-5 (BI_BITFIELDS) }
  RopMsk    : LongInt;        { tous les bits d'un point de la cible }
  { cible de dessin d'un contexte }
  GSurf     : TSurf;
  GOX, GOY  : LongInt;
  GClip     : TRect;
  GDc       : LongInt;
  GTab      : LongInt;        { table de couleurs de la cible (DIB) ou 0 }
  GTop      : LongInt;        { fenetre de premier niveau ou -1 }

Function GdiNew(Kind : LongInt) : LongInt;
Var I : LongInt;
Begin
  GdiNew := -1;
  For I := 0 To MaxGdi - 1 Do
    If Not Gdis^[I].Used Then
    Begin
      FillMem(LongInt(@Gdis^[I]), SizeOf(TGdi), 0);
      Gdis^[I].Used := True;
      Gdis^[I].Kind := Kind;
      Gdis^[I].Owner := HeapOwner;
      GdiNew := I;
      Exit;
    End;
  KLog('GDI : table pleine');
End;

Function GdiH(I : LongInt) : LongInt;
Begin
  If I < 0 Then GdiH := 0 Else GdiH := HGdiBase + I * 4;
End;

Function GdiOf(H, Kind : LongInt) : LongInt;
Var I : LongInt;
Begin
  GdiOf := -1;
  If (H < HGdiBase) Or (H >= HGdiBase + MaxGdi * 4) Then Exit;
  I := (H - HGdiBase) Div 4;
  If Not Gdis^[I].Used Then Exit;
  If (Kind <> 0) And (Gdis^[I].Kind <> Kind) Then Exit;
  GdiOf := I;
End;

{ petite police (hauteur de 1 a 13 points : MS Sans Serif 8, Tahoma 8,
  Times New Roman 10...) : rendue avec la police 6x13 }
Function HFontSmall(H : LongInt) : Boolean;
Var I : LongInt;
Begin
  HFontSmall := False;
  I := GdiOf(H, goFont);
  If I < 0 Then Exit;
  HFontSmall := (Abs(Gdis^[I].I1) >= 1) And (Abs(Gdis^[I].I1) <= 13);
End;

{ controle d'une boite de dialogue (modele DLGTEMPLATE), ou qui a recu
  une petite police }
Function CtlSmall(W : LongInt) : Boolean;
Var T : LongInt;
Begin
  CtlSmall := False;
  If (W < 0) Or Not Wnds^[W].Used Then Exit;
  T := TopOf(W);
  If (T >= 0) And (Wnds^[T].IKind = ikDialog) Then CtlSmall := True
  Else If Wnds^[W].Font <> 0 Then CtlSmall := HFontSmall(Wnds^[W].Font);
End;

Function DcOf(H : LongInt) : LongInt;
Var I : LongInt;
Begin
  DcOf := -1;
  I := GdiOf(H, goDC);
  If I >= 0 Then DcOf := Gdis^[I].I1;
End;

{ ------------------------------------------------------------------ }
{ Bitmaps                                                            }
{ ------------------------------------------------------------------ }

Function BmpNew(W, H, Bpp : LongInt; Mono : Boolean) : LongInt;
Var B, Pitch : LongInt;
Begin
  BmpNew := -1;
  B := GdiNew(goBitmap);
  If B < 0 Then Exit;
  If W < 1 Then W := 1;
  If H < 1 Then H := 1;
  If Mono Or (Bpp < 8) Then Bpp := 8;
  Pitch := (W * PxBytes(Bpp) + 3) And Not 3;
  Gdis^[B].I1 := KAlloc(Pitch * H + 16);
  If Gdis^[B].I1 = 0 Then
  Begin
    Gdis^[B].Used := False;
    Exit;
  End;
  FillMem(Gdis^[B].I1, Pitch * H, 0);
  Gdis^[B].I2 := W; Gdis^[B].I3 := H; Gdis^[B].I4 := Bpp; Gdis^[B].I5 := Pitch;
  Gdis^[B].I7 := 2;
  If Mono Then
  Begin
    Gdis^[B].I7 := 2 Or 4;
    Gdis^[B].I4 := 1;
  End;
  BmpNew := B;
End;

{ Format des points d'un bitmap : 8 (indices, ou 0/1 si monochrome),
  15, 16, 24, 32 ; 1 ou 4 pour une DIB de 1 ou 4 bits }
Function BmpFmt(B : LongInt) : LongInt;
Begin
  If (Gdis^[B].I7 And 4) <> 0 Then BmpFmt := 8
  Else If (Gdis^[B].I4 = 16) And ((Gdis^[B].I7 And 1) <> 0) And
          ((Gdis^[B].I7 And $10) = 0) Then BmpFmt := 15
  Else BmpFmt := Gdis^[B].I4;
End;

{ Bits par point annonces aux programmes (15 est annonce 16) }
Function BmpBits(B : LongInt) : LongInt;
Begin
  If Gdis^[B].I4 = 15 Then BmpBits := 16 Else BmpBits := Gdis^[B].I4;
End;

{ Surface d'un bitmap 8 bits (les DIB de bas en haut ont un pas negatif)}
Function BmpSurf(B : LongInt; Var S : TSurf) : Boolean;
Var F : LongInt;
Begin
  BmpSurf := False;
  If B < 0 Then Exit;
  F := BmpFmt(B);
  If (F <> 8) And (F <> 15) And (F <> 16) And (F <> 24) And (F <> 32) Then
    Exit;
  S.W := Gdis^[B].I2; S.H := Gdis^[B].I3; S.Bpp := F;
  If (Gdis^[B].I7 And 2) <> 0 Then
  Begin
    S.Bits := Gdis^[B].I1; S.Pitch := Gdis^[B].I5;
  End
  Else
  Begin
    S.Bits := Gdis^[B].I1 + (Gdis^[B].I3 - 1) * Gdis^[B].I5;
    S.Pitch := -Gdis^[B].I5;
  End;
  BmpSurf := True;
End;

{ Changement de format de l'ecran : les bitmaps compatibles (ni DIB, ni
  monochromes, ni enveloppes de surfaces DirectDraw) prennent le nouveau
  format, couleurs conservees }
Procedure BmpReformat(OldF, NewF : LongInt);
Var B, Own, P, NB, Y, X, SA, DA, SP, DP : LongInt;
Begin
  Own := HeapOwner;
  SP := PxBytes(OldF); DP := PxBytes(NewF);
  For B := 0 To MaxGdi - 1 Do
    If Gdis^[B].Used And (Gdis^[B].Kind = goBitmap) And
       ((Gdis^[B].I7 And (1 Or 4 Or 8)) = 0) And (Gdis^[B].I4 = OldF) Then
    Begin
      HeapOwner := Gdis^[B].Owner;
      P := (Gdis^[B].I2 * DP + 3) And Not 3;
      NB := KAlloc(P * Gdis^[B].I3 + 16);
      If NB <> 0 Then
      Begin
        For Y := 0 To Gdis^[B].I3 - 1 Do
        Begin
          SA := Gdis^[B].I1 + Y * Gdis^[B].I5; DA := NB + Y * P;
          For X := 0 To Gdis^[B].I2 - 1 Do
            PutRaw(DA + X * DP, XToRaw(RawToX(GetRaw(SA + X * SP, OldF),
                   OldF), NewF), NewF);
        End;
        KFree(Gdis^[B].I1);
        Gdis^[B].I1 := NB; Gdis^[B].I5 := P; Gdis^[B].I4 := NewF;
      End;
    End;
  HeapOwner := Own;
End;

Procedure BmpFree(B : LongInt);
Begin
  If (Gdis^[B].I7 And 8) = 0 Then KFree(Gdis^[B].I1);
  If Gdis^[B].I6 <> 0 Then KFree(Gdis^[B].I6);
  Gdis^[B].Used := False;
End;

{ ------------------------------------------------------------------ }
{ Contextes                                                          }
{ ------------------------------------------------------------------ }

Function DcNew(Wnd : LongInt; Client : Boolean) : LongInt;
Var I, G : LongInt;
Begin
  DcNew := 0;
  For I := 0 To MaxDC - 1 Do
    If Not Dcs[I].Used Then
    Begin
      G := GdiNew(goDC);
      If G < 0 Then Exit;
      FillMem(LongInt(@Dcs[I]), SizeOf(TDC), 0);
      Dcs[I].Used := True;
      Dcs[I].Wnd := Wnd;
      Dcs[I].Client := Client;
      Dcs[I].Bmp := -1;
      Dcs[I].Pen := StockObj[7];
      Dcs[I].Brush := StockObj[0];
      Dcs[I].Font := StockObj[13];
      Dcs[I].Pal := DefPal;
      Dcs[I].BkColor := $FFFFFF;
      Dcs[I].TextColor := 0;
      Dcs[I].BkMode := 2;
      Dcs[I].Rop2 := 13;
      Dcs[I].StretchMode := 1;
      Dcs[I].PolyFill := 1;
      Dcs[I].Gdi := G;
      Gdis^[G].I1 := I;
      DcNew := GdiH(G);
      Exit;
    End;
  KLog('GDI : plus de contextes');
End;

Procedure DcFree(D : LongInt);
Begin
  If (D < 0) Or Not Dcs[D].Used Then Exit;
  If (Dcs[D].Bmp >= 0) And Gdis^[Dcs[D].Bmp].Used Then
    Gdis^[Dcs[D].Bmp].I8 := 0;
  If Dcs[D].Saved <> 0 Then KFree(Dcs[D].Saved);
  Gdis^[Dcs[D].Gdi].Used := False;
  Dcs[D].Used := False;
End;

{ Preparer le dessin dans le contexte D : DS, DOX, DOY, ClipX1.. en
  coordonnees logiques. False si rien a dessiner }
Function DcBegin(D : LongInt) : Boolean;
Var S : TSurf; OX, OY, B : LongInt; Clip, R : TRect;
Begin
  DcBegin := False;
  If (D < 0) Or Not Dcs[D].Used Then Exit;
  GTab := 0; GTop := -1; GMono := False;
  If Dcs[D].Wnd >= 0 Then
  Begin
    If Not Wnds^[Dcs[D].Wnd].Used Then Exit;
    If Not WndTarget(Dcs[D].Wnd, Dcs[D].Client, S, OX, OY, Clip) Then Exit;
    GTop := TopOf(Dcs[D].Wnd);
  End
  Else If Dcs[D].Screen Then
  Begin
    S := Back; OX := 0; OY := 0;
    SetR(Clip, 0, 0, ScrW, ScrH);
  End
  Else
  Begin
    B := Dcs[D].Bmp;
    If B < 0 Then B := DefBmp;
    If Not BmpSurf(B, S) Then Exit;
    OX := 0; OY := 0;
    SetR(Clip, 0, 0, S.W, S.H);
    GTab := Gdis^[B].I6;
    GMono := (Gdis^[B].I7 And 4) <> 0;
  End;
  If Dcs[D].HasClip Then
  Begin
    R := Dcs[D].ClipR;
    R.L := R.L + OX; R.R := R.R + OX; R.T := R.T + OY; R.B := R.B + OY;
    If Not RInter(Clip, Clip, R) Then Exit;
  End;
  If Dcs[D].HasPaint Then
  Begin
    R := Dcs[D].PaintR;
    R.L := R.L + OX; R.R := R.R + OX; R.T := R.T + OY; R.B := R.B + OY;
    If Not RInter(Clip, Clip, R) Then Exit;
  End;
  GSurf := S; GOX := OX; GOY := OY; GClip := Clip; GDc := D;
  { coordonnees logiques -> surface : x + VpX - WinX + OX }
  DS := S;
  DOX := -(OX + Dcs[D].VpX - Dcs[D].WinX);
  DOY := -(OY + Dcs[D].VpY - Dcs[D].WinY);
  ClipX1 := Clip.L + DOX; ClipY1 := Clip.T + DOY;
  ClipX2 := Clip.R - 1 + DOX; ClipY2 := Clip.B - 1 + DOY;
  DcBegin := (ClipX1 <= ClipX2) And (ClipY1 <= ClipY2);
End;

{ Signaler qu'une zone logique (bornes incluses) a ete dessinee }
Procedure DcDirty(X1, Y1, X2, Y2 : LongInt);
Begin
  If GTop >= 0 Then
    MarkDirty(Wnds^[GTop].X + Max(X1 - DOX, GClip.L),
              Wnds^[GTop].Y + Max(Y1 - DOY, GClip.T),
              Wnds^[GTop].X + Min(X2 - DOX + 1, GClip.R),
              Wnds^[GTop].Y + Min(Y2 - DOY + 1, GClip.B))
  Else If (GDc >= 0) And Dcs[GDc].Screen Then
    MarkDirty(X1, Y1, X2 + 1, Y2 + 1);
End;

Procedure DcDirtyAll;
Begin
  DcDirty(ClipX1, ClipY1, ClipX2, ClipY2);
End;

{ Couleur (COLORREF) -> indice dans la cible courante }
{ Entree I de la palette logique du contexte D en 00RRGGBB }
Function DcPalX(D, I : LongInt) : LongInt;
Var P, E : LongInt;
Begin
  P := -1;
  If (D >= 0) And Dcs[D].Used Then P := Dcs[D].Pal;
  If (P >= 0) And (I >= 0) And (I < Gdis^[P].I2) Then
  Begin
    E := Gdis^[P].I1 + I * 4;
    DcPalX := (Mem[0:E] Shl 16) Or (Mem[0:E + 1] Shl 8) Or Mem[0:E + 2];
  End
  Else DcPalX := SysX[I And 255];
End;

{ Couleur (COLORREF) -> couleur pour la cible courante : indice en 256
  couleurs (ou dans la table d'une DIB), 0 ou 1 pour un bitmap
  monochrome, couleur directe (CDirect) en couleurs vraies }
Function GColor(C : LongInt) : LongInt;
Var I, Best, BD, D, R, G, B, T, X : LongInt;
Begin
  If (C Shr 24) = 1 Then X := DcPalX(GDc, C And $FFFF)
  Else X := ((C And 255) Shl 16) Or (C And $FF00) Or ((C Shr 16) And 255);
  If GMono Then
  Begin
    GColor := Ord(((X Shr 16) And 255) * 30 + ((X Shr 8) And 255) * 59 +
                  (X And 255) * 11 >= 12800);
    Exit;
  End;
  If GTab = 0 Then
  Begin
    If DS.Bpp = 8 Then GColor := ColorIdx(C) Else GColor := CDirect Or X;
    Exit;
  End;
  If (C Shr 24) = 1 Then
  Begin
    GColor := C And 255;
    Exit;
  End;
  R := (X Shr 16) And 255; G := (X Shr 8) And 255; B := X And 255;
  Best := 0; BD := $7FFFFFFF;
  For I := 0 To 255 Do
  Begin
    T := MemL[0:GTab + I * 4];
    D := Sqr(((T Shr 16) And 255) - R) + Sqr(((T Shr 8) And 255) - G) +
         Sqr((T And 255) - B);
    If D < BD Then
    Begin
      BD := D; Best := I;
      If D = 0 Then Break;
    End;
  End;
  GColor := Best;
End;

{ 00RRGGBB -> point brut de la cible courante }
Function ToTgt(X : LongInt) : LongInt;
Begin
  If GMono Then
    ToTgt := Ord(((X Shr 16) And 255) * 30 + ((X Shr 8) And 255) * 59 +
                 (X And 255) * 11 >= 12800)
  Else If (DS.Bpp = 8) And (GTab <> 0) Then ToTgt := GColor(XToCr(X))
  Else ToTgt := XToRaw(X, DS.Bpp);
End;

{ Point brut V d'une source (format Bpp, table Tab pour 8 bits) en
  00RRGGBB }
Function SrcX(V, Bpp, Tab : LongInt) : LongInt;
Begin
  If (Bpp = 8) And (Tab <> 0) Then SrcX := MemL[0:Tab + (V And 255) * 4] And
                                          $FFFFFF
  Else SrcX := RawToX(V, Bpp);
End;

{ Masque d'inversion de la cible (1 pour un bitmap monochrome) }
Function TgtMask : LongInt;
Begin
  If GMono Then TgtMask := 1 Else TgtMask := RawMask(DS.Bpp);
End;

{ Point brut V en (X, Y) de la cible, avec decoupage }
Procedure PixRaw(X, Y, V : LongInt);
Begin
  If (X < ClipX1) Or (X > ClipX2) Or (Y < ClipY1) Or (Y > ClipY2) Then
    Exit;
  PutRaw(DS.Bits + (Y - DOY) * DS.Pitch + (X - DOX) * PxBytes(DS.Bpp), V,
         DS.Bpp);
End;

{ ------------------------------------------------------------------ }
{ Objets de base et objets predefinis                                }
{ ------------------------------------------------------------------ }

Function CreatePen(Style, Width, Color : LongInt) : LongInt;
Var I : LongInt;
Begin
  I := GdiNew(goPen);
  If I >= 0 Then
  Begin
    Gdis^[I].I1 := Style; Gdis^[I].I2 := Width; Gdis^[I].I3 := Color;
  End;
  CreatePen := GdiH(I);
End;

Function CreatePenIndirect(P : LongInt) : LongInt;
Begin
  CreatePenIndirect := CreatePen(MemL[0:P], MemL[0:P + 4], MemL[0:P + 12]);
End;

Function CreateSolidBrush(Color : LongInt) : LongInt;
Var I : LongInt;
Begin
  I := GdiNew(goBrush);
  If I >= 0 Then Gdis^[I].I2 := Color;
  CreateSolidBrush := GdiH(I);
End;

Function CreateHatchBrush(Hatch, Color : LongInt) : LongInt;
Var I : LongInt;
Begin
  I := GdiNew(goBrush);
  If I >= 0 Then
  Begin
    Gdis^[I].I1 := 2; Gdis^[I].I2 := Color; Gdis^[I].I3 := Hatch;
  End;
  CreateHatchBrush := GdiH(I);
End;

Function CreateBrushIndirect(P : LongInt) : LongInt;
Var I : LongInt;
Begin
  I := GdiNew(goBrush);
  If I >= 0 Then
  Begin
    Case MemL[0:P] Of
      1 : Gdis^[I].I1 := 1;
      2 : Gdis^[I].I1 := 2;
      3 : Gdis^[I].I1 := 3;
    Else
      Gdis^[I].I1 := 0;
    End;
    Gdis^[I].I2 := MemL[0:P + 4];
    Gdis^[I].I3 := MemL[0:P + 8];
    If Gdis^[I].I1 = 3 Then Gdis^[I].I4 := GdiOf(MemL[0:P + 8], goBitmap);
  End;
  CreateBrushIndirect := GdiH(I);
End;

Function CreatePatternBrush(Hbm : LongInt) : LongInt;
Var I : LongInt;
Begin
  I := GdiNew(goBrush);
  If I >= 0 Then
  Begin
    Gdis^[I].I1 := 3;
    Gdis^[I].I4 := GdiOf(Hbm, goBitmap);
    If Gdis^[I].I4 < 0 Then Gdis^[I].I1 := 0;
  End;
  CreatePatternBrush := GdiH(I);
End;

Function CreateDIBitmapK(Bmi, Bits, Usage : LongInt) : LongInt; Forward;

Function CreateDIBPatternBrush(HGlob, Usage : LongInt) : LongInt;
Var I, B : LongInt;
Begin
  I := GdiNew(goBrush);
  If I >= 0 Then
  Begin
    B := CreateDIBitmapK(HGlob, 0, Usage);
