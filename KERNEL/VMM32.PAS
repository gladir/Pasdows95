{ Boite de message d'un programme (modale) }
Function MessageBoxA(H, Text, Cap, Typ : LongInt) : LongInt;
Var T, X, Y : String; I, N, P, Q, Ho, B : LongInt; An : Boolean;
Begin
  If Cap = 0 Then T := 'Erreur' Else T := APStr(Cap);
  { long texte : copie dans le tas du noyau ('|' : fin de ligne) }
  N := 0;
  If Text <> 0 Then
    While (N < 8192) And (Mem[0:Text + N] <> 0) Do Inc(N);
  If N > 255 Then
  Begin
    Ho := HeapOwner; HeapOwner := 0;
    P := KAlloc(N + 1);
    HeapOwner := Ho;
    If P <> 0 Then
    Begin
      An := AnsiApp;
      Q := 0;
      For I := 0 To N - 1 Do
      Begin
        B := Mem[0:Text + I];
        If B = 10 Then B := Ord('|');
        If B <> 13 Then
        Begin
          If An And (B >= 128) Then B := AnsiOem[B];
          Mem[0:P + Q] := B;
          Inc(Q);
        End;
      End;
      MbPendN := Q;
      MbPendP := P;
      KLog('MessageBoxA "' + T + '" : (' + IntStr(Q) + ' caracteres)');
      MessageBoxA := MsgBoxModal(T, '', Typ);
      Exit;
    End;
  End;
  X := APStr(Text);
  { fins de ligne du programme : '|' pour WrapText }
  Y := '';
  For I := 1 To Length(X) Do
    If X[I] = #10 Then Y := Y + '|'
    Else If X[I] <> #13 Then Y := Y + X[I];
  KLog('MessageBoxA "' + T + '" : ' + Y);
  MessageBoxA := MsgBoxModal(T, Y, Typ);
End;

Function MessageBoxExA(H, Text, Cap, Typ, Lang : LongInt) : LongInt;
Begin
  MessageBoxExA := MessageBoxA(H, Text, Cap, Typ);
End;

