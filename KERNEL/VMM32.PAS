    While MemW[0:P + N * 2] <> 0 Do Inc(N);
  lstrlenW := N;
End;

Function lstrcpyA(Dst, Src : LongInt) : LongInt;
Begin
  MoveMem(Src, Dst, StrLenZ(Src) + 1);
  lstrcpyA := Dst;
