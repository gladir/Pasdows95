{ couleur entiere -> [0, 1] (glLightiv, glMaterialiv...) }
Function GlPc(P, K : LongInt; Fl : Boolean) : Double;
Begin
  If Fl Then GlPc := FlM(P + K * 4)
  Else GlPc := MemL[0:P + K * 4] / 2147483647.0;
End;

Procedure GlFog(N, P : LongInt; Fl : Boolean);
