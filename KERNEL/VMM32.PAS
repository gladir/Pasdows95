{ Titre d'un fichier : son nom sans le chemin }
Function GetFileTitleA(Path, Buf, N : LongInt) : LongInt;
Var S : String; K : LongInt;
Begin
  S := PStr(Path);
  K := Length(S);
  While (K > 0) And (S[K] <> '\') And (S[K] <> '/') And (S[K] <> ':') Do
    Dec(K);
  S := Copy(S, K + 1, 255);
  If (S = '') Then
  Begin
    GetFileTitleA := -1;
    Exit;
  End;
  If (Buf = 0) Or (N <= Length(S)) Then
  Begin
    GetFileTitleA := Length(S) + 1;
    Exit;
  End;
  PutPStr(Buf, S, N);
  GetFileTitleA := 0;
End;

