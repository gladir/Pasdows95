    Gdis^[I].I1 := H; Gdis^[I].I2 := W; Gdis^[I].I3 := Weight;
    Gdis^[I].I4 := Italic; Gdis^[I].I5 := Under;
    Gdis^[I].Name := Copy(PStr(Face), 1, 31);
  End;
