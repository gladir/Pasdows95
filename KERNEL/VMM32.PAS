Function SaveDC(Hdc : LongInt) : LongInt;
Var D : LongInt;
Begin
  SaveDC := 0;
  D := DcOf(Hdc);
  If D < 0 Then Exit;
  If Dcs[D].Saved = 0 Then Dcs[D].Saved := KAlloc(SizeOf(TDC) * 8);
  If Dcs[D].NSaved >= 8 Then Exit;
  MoveMem(LongInt(@Dcs[D]), Dcs[D].Saved + Dcs[D].NSaved * SizeOf(TDC),
          SizeOf(TDC));
  Inc(Dcs[D].NSaved);
  SaveDC := Dcs[D].NSaved;
End;

Function RestoreDC(Hdc, N : LongInt) : LongInt;
Var D, S, K : LongInt;
Begin
  RestoreDC := 0;
  D := DcOf(Hdc);
  If (D < 0) Or (Dcs[D].NSaved = 0) Then Exit;
  If N < 0 Then N := Dcs[D].NSaved + 1 + N;
  If (N < 1) Or (N > Dcs[D].NSaved) Then Exit;
  S := Dcs[D].Saved; K := Dcs[D].NSaved;
  MoveMem(S + (N - 1) * SizeOf(TDC), LongInt(@Dcs[D]), SizeOf(TDC));
  Dcs[D].Saved := S; Dcs[D].NSaved := N - 1;
  If (Dcs[D].Bmp >= 0) And Gdis^[Dcs[D].Bmp].Used Then
    Gdis^[Dcs[D].Bmp].I8 := D + 1;
  RestoreDC := Ord(K > 0);
End;

{ ------------------------------------------------------------------ }
{ Regions (rectangulaires)                                           }
{ ------------------------------------------------------------------ }

Function RgnNew(L0, T0, R0, B0 : LongInt) : LongInt;
Var I : LongInt;
Begin
  I := GdiNew(goRegion);
  If I >= 0 Then
  Begin
    Gdis^[I].I1 := Min(L0, R0); Gdis^[I].I2 := Min(T0, B0);
    Gdis^[I].I3 := Max(L0, R0); Gdis^[I].I4 := Max(T0, B0);
    Gdis^[I].I5 := 2;
  End;
  RgnNew := GdiH(I);
End;

Function RgnType(I : LongInt) : LongInt;
Begin
  If (Gdis^[I].I1 >= Gdis^[I].I3) Or (Gdis^[I].I2 >= Gdis^[I].I4) Then
    RgnType := 1
  Else RgnType := 2;
End;

Function CreateRectRgn(L0, T0, R0, B0 : LongInt) : LongInt;
Begin
  CreateRectRgn := RgnNew(L0, T0, R0, B0);
End;

Function CreateRectRgnIndirect(P : LongInt) : LongInt;
Begin
  CreateRectRgnIndirect := RgnNew(MemL[0:P], MemL[0:P + 4], MemL[0:P + 8],
                                  MemL[0:P + 12]);
End;

Function CreateEllipticRgnIndirect(P : LongInt) : LongInt;
Begin
  CreateEllipticRgnIndirect := CreateRectRgnIndirect(P);
End;

Function CreateEllipticRgn(L0, T0, R0, B0 : LongInt) : LongInt;
Begin
  CreateEllipticRgn := RgnNew(L0, T0, R0, B0);
End;

Function CreateRoundRectRgn(L0, T0, R0, B0, W, H : LongInt) : LongInt;
Begin
  CreateRoundRectRgn := RgnNew(L0, T0, R0, B0);
End;

Function CreatePolygonRgn(Pts, N, Mode : LongInt) : LongInt;
Var I, L0, T0, R0, B0 : LongInt;
Begin
  L0 := $7FFFFFF; T0 := $7FFFFFF; R0 := -$7FFFFFF; B0 := -$7FFFFFF;
  For I := 0 To N - 1 Do
  Begin
    L0 := Min(L0, MemL[0:Pts + I * 8]); R0 := Max(R0, MemL[0:Pts + I * 8]);
    T0 := Min(T0, MemL[0:Pts + I * 8 + 4]);
    B0 := Max(B0, MemL[0:Pts + I * 8 + 4]);
  End;
  If N = 0 Then
  Begin
    L0 := 0; T0 := 0; R0 := 0; B0 := 0;
  End;
  CreatePolygonRgn := RgnNew(L0, T0, R0, B0);
End;

Function SetRectRgn(H, L0, T0, R0, B0 : LongInt) : LongInt;
Var I : LongInt;
Begin
  I := GdiOf(H, goRegion);
  SetRectRgn := 0;
  If I < 0 Then Exit;
  Gdis^[I].I1 := L0; Gdis^[I].I2 := T0; Gdis^[I].I3 := R0; Gdis^[I].I4 := B0;
  SetRectRgn := 1;
End;

Function CombineRgn(Dst, S1, S2, Mode : LongInt) : LongInt;
Var D, A, B : LongInt; RA, RB, RR : TRect;
Begin
  CombineRgn := 0;
  D := GdiOf(Dst, goRegion); A := GdiOf(S1, goRegion);
  B := GdiOf(S2, goRegion);
  If (D < 0) Or (A < 0) Then Exit;
  SetR(RA, Gdis^[A].I1, Gdis^[A].I2, Gdis^[A].I3, Gdis^[A].I4);
  If B >= 0 Then SetR(RB, Gdis^[B].I1, Gdis^[B].I2, Gdis^[B].I3, Gdis^[B].I4)
  Else RB := RA;
  Case Mode Of
    1 : If Not RInter(RR, RA, RB) Then SetR(RR, 0, 0, 0, 0);
    2, 3 :
    Begin
      RR := RA;
      RUnion(RR, RB);
    End;
  Else
    RR := RA;
  End;
  Gdis^[D].I1 := RR.L; Gdis^[D].I2 := RR.T; Gdis^[D].I3 := RR.R;
  Gdis^[D].I4 := RR.B;
  CombineRgn := RgnType(D);
End;

Function OffsetRgn(H, X, Y : LongInt) : LongInt;
Var I : LongInt;
Begin
  OffsetRgn := 0;
  I := GdiOf(H, goRegion);
  If I < 0 Then Exit;
  Gdis^[I].I1 := Gdis^[I].I1 + X; Gdis^[I].I3 := Gdis^[I].I3 + X;
  Gdis^[I].I2 := Gdis^[I].I2 + Y; Gdis^[I].I4 := Gdis^[I].I4 + Y;
  OffsetRgn := RgnType(I);
End;

Function GetRgnBox(H, P : LongInt) : LongInt;
Var I : LongInt;
Begin
  GetRgnBox := 0;
  I := GdiOf(H, goRegion);
  If I < 0 Then Exit;
  MemL[0:P] := Gdis^[I].I1; MemL[0:P + 4] := Gdis^[I].I2;
  MemL[0:P + 8] := Gdis^[I].I3; MemL[0:P + 12] := Gdis^[I].I4;
  GetRgnBox := RgnType(I);
End;

Function EqualRgn(A, B : LongInt) : LongInt;
Var I, J : LongInt;
Begin
  I := GdiOf(A, goRegion); J := GdiOf(B, goRegion);
  EqualRgn := Ord((I >= 0) And (J >= 0) And (Gdis^[I].I1 = Gdis^[J].I1) And
    (Gdis^[I].I2 = Gdis^[J].I2) And (Gdis^[I].I3 = Gdis^[J].I3) And
    (Gdis^[I].I4 = Gdis^[J].I4));
End;

Function PtInRegion(H, X, Y : LongInt) : LongInt;
Var I : LongInt;
Begin
  I := GdiOf(H, goRegion);
  PtInRegion := Ord((I >= 0) And (X >= Gdis^[I].I1) And (X < Gdis^[I].I3) And
                    (Y >= Gdis^[I].I2) And (Y < Gdis^[I].I4));
End;

Function SelectClipRgn(Hdc, H : LongInt) : LongInt;
Var D, I : LongInt;
Begin
  SelectClipRgn := 0;
  D := DcOf(Hdc);
  If D < 0 Then Exit;
  I := GdiOf(H, goRegion);
  If I < 0 Then
  Begin
    Dcs[D].HasClip := False;
    SelectClipRgn := 3;
    Exit;
  End;
  Dcs[D].HasClip := True;
  SetR(Dcs[D].ClipR, Gdis^[I].I1, Gdis^[I].I2, Gdis^[I].I3, Gdis^[I].I4);
  SelectClipRgn := RgnType(I);
End;

Function IntersectClipRect(Hdc, L0, T0, R0, B0 : LongInt) : LongInt;
Var D : LongInt; R : TRect;
Begin
  IntersectClipRect := 0;
  D := DcOf(Hdc);
  If D < 0 Then Exit;
  SetR(R, L0 + Dcs[D].VpX - Dcs[D].WinX, T0 + Dcs[D].VpY - Dcs[D].WinY,
       R0 + Dcs[D].VpX - Dcs[D].WinX, B0 + Dcs[D].VpY - Dcs[D].WinY);
  If Dcs[D].HasClip Then
  Begin
    If Not RInter(Dcs[D].ClipR, Dcs[D].ClipR, R) Then
      SetR(Dcs[D].ClipR, 0, 0, 0, 0);
  End
  Else Dcs[D].ClipR := R;
  Dcs[D].HasClip := True;
  IntersectClipRect := 2;
End;

Function GetClipBox(Hdc, P : LongInt) : LongInt;
Var D : LongInt;
Begin
  GetClipBox := 0;
  D := DcOf(Hdc);
  If D < 0 Then Exit;
  If Not DcBegin(D) Then
  Begin
    PutRectAt(P, Dcs[D].ClipR);
    GetClipBox := 1;
    Exit;
  End;
  MemL[0:P] := ClipX1; MemL[0:P + 4] := ClipY1;
  MemL[0:P + 8] := ClipX2 + 1; MemL[0:P + 12] := ClipY2 + 1;
  GetClipBox := 2;
End;

Function GetClipRgn(Hdc, H : LongInt) : LongInt;
Var D, I : LongInt;
Begin
  GetClipRgn := 0;
  D := DcOf(Hdc);
  I := GdiOf(H, goRegion);
  If (D < 0) Or (I < 0) Or Not Dcs[D].HasClip Then Exit;
  Gdis^[I].I1 := Dcs[D].ClipR.L; Gdis^[I].I2 := Dcs[D].ClipR.T;
  Gdis^[I].I3 := Dcs[D].ClipR.R; Gdis^[I].I4 := Dcs[D].ClipR.B;
  GetClipRgn := 1;
End;

{ ------------------------------------------------------------------ }
{ Remplissage et formes                                              }
{ ------------------------------------------------------------------ }

{ Remplir (X1,Y1)-(X2,Y2) inclus avec le pinceau B (indice GDI) }
Procedure BrushFill(X1, Y1, X2, Y2, B : LongInt);
Var C, X, Y, PB, PX, PY, CT, CB : LongInt; PS : TSurf; PM, Same : Boolean;
Begin
  If (B < 0) Or Not Gdis^[B].Used Then Exit;
  Case Gdis^[B].I1 Of
    1 : Exit;
    2 :
    Begin
      C := GColor(Gdis^[B].I2);
      For Y := Max(Y1, ClipY1) To Min(Y2, ClipY2) Do
        For X := Max(X1, ClipX1) To Min(X2, ClipX2) Do
          If ((Gdis^[B].I3 = 0) And (Y Mod 8 = 0)) Or
             ((Gdis^[B].I3 = 1) And (X Mod 8 = 0)) Or
             ((Gdis^[B].I3 >= 2) And ((X + Y) Mod 8 = 0)) Then Pix(X, Y, C);
    End;
    3 :
    Begin
      PB := Gdis^[B].I4;
      If (PB < 0) Or Not BmpSurf(PB, PS) Then Exit;
      PM := (Gdis^[PB].I7 And 4) <> 0;
      CT := RawOf(GColor(Dcs[GDc].TextColor), DS.Bpp);
      CB := RawOf(GColor(Dcs[GDc].BkColor), DS.Bpp);
      Same := (PS.Bpp = DS.Bpp) And Not GMono And Not PM And
              ((PS.Bpp > 8) Or ((Gdis^[PB].I6 = 0) And (GTab = 0)));
      For Y := Max(Y1, ClipY1) To Min(Y2, ClipY2) Do
      Begin
        PY := Y Mod PS.H;
        If PY < 0 Then PY := PY + PS.H;
        For X := Max(X1, ClipX1) To Min(X2, ClipX2) Do
        Begin
          PX := X Mod PS.W;
          If PX < 0 Then PX := PX + PS.W;
          C := GetRaw(PS.Bits + PY * PS.Pitch + PX * PxBytes(PS.Bpp), PS.Bpp);
          If PM Then
          Begin
            If C = 0 Then C := CT Else C := CB;
          End
          Else If Not Same Then C := ToTgt(SrcX(C, PS.Bpp, Gdis^[PB].I6));
          PixRaw(X, Y, C);
        End;
      End;
    End;
  Else
    FBar(X1, Y1, X2, Y2, GColor(Gdis^[B].I2));
  End;
End;

Function PatBlt(Hdc, X, Y, W, H, Rop : LongInt) : LongInt;
Var D, C, YY, XX : LongInt;
Begin
  PatBlt := 1;
  D := DcOf(Hdc);
  If Not DcBegin(D) Then Exit;
  If W < 0 Then
  Begin
    X := X + W; W := -W;
  End;
  If H < 0 Then
  Begin
    Y := Y + H; H := -H;
  End;
  Case Rop Of
    PATCOPY : BrushFill(X, Y, X + W - 1, Y + H - 1, Dcs[D].Brush);
    BLACKNESS : FBar(X, Y, X + W - 1, Y + H - 1, GColor(0));
    WHITENESS : FBar(X, Y, X + W - 1, Y + H - 1, GColor($FFFFFF));
    DSTINVERT, PATINVERT :
    Begin
      C := TgtMask;
      If Rop = PATINVERT Then
        C := RawOf(GColor(Gdis^[Dcs[D].Brush].I2), DS.Bpp);
      For YY := Max(Y, ClipY1) To Min(Y + H - 1, ClipY2) Do
        For XX := Max(X, ClipX1) To Min(X + W - 1, ClipX2) Do
          XorPix(XX, YY, C);
    End;
  Else
    BrushFill(X, Y, X + W - 1, Y + H - 1, Dcs[D].Brush);
  End;
  DcDirty(X, Y, X + W - 1, Y + H - 1);
End;

{ Trait avec le stylo du contexte }
Function PenColor(D : LongInt; Var C : LongInt) : Boolean;
Begin
  PenColor := False;
  If (Dcs[D].Pen < 0) Or (Gdis^[Dcs[D].Pen].I1 = 5) Then Exit;
  C := GColor(Gdis^[Dcs[D].Pen].I3);
  If Dcs[D].Rop2 = 1 Then C := GColor(0);
  If Dcs[D].Rop2 = 16 Then C := GColor($FFFFFF);
  PenColor := True;
End;

Procedure PenLine(D, X1, Y1, X2, Y2 : LongInt);
Var C, W, K : LongInt;
Begin
  If Not PenColor(D, C) Then Exit;
  W := Gdis^[Dcs[D].Pen].I2;
  DLine(X1, Y1, X2, Y2, C);
  If W > 1 Then
    For K := 1 To W - 1 Do
    Begin
      DLine(X1 + K, Y1, X2 + K, Y2, C);
      DLine(X1, Y1 + K, X2, Y2 + K, C);
    End;
  DcDirty(Min(X1, X2), Min(Y1, Y2), Max(X1, X2) + W, Max(Y1, Y2) + W);
End;

Function MoveToEx(Hdc, X, Y, P : LongInt) : LongInt;
Var D : LongInt;
Begin
  MoveToEx := 0;
  D := DcOf(Hdc);
  If D < 0 Then Exit;
  If P <> 0 Then
  Begin
    MemL[0:P] := Dcs[D].PosX; MemL[0:P + 4] := Dcs[D].PosY;
  End;
  Dcs[D].PosX := X; Dcs[D].PosY := Y;
  MoveToEx := 1;
End;

Function LineTo(Hdc, X, Y : LongInt) : LongInt;
Var D : LongInt;
Begin
  LineTo := 1;
  D := DcOf(Hdc);
  If D < 0 Then Exit;
  If DcBegin(D) Then
  Begin
    { le point final n'est pas dessine }
    PenLine(D, Dcs[D].PosX, Dcs[D].PosY, X, Y);
  End;
  Dcs[D].PosX := X; Dcs[D].PosY := Y;
End;

Function Polyline(Hdc, Pts, N : LongInt) : LongInt;
Var D, I : LongInt;
Begin
  Polyline := 1;
  D := DcOf(Hdc);
  If Not DcBegin(D) Then Exit;
  For I := 0 To N - 2 Do
    PenLine(D, MemL[0:Pts + I * 8], MemL[0:Pts + I * 8 + 4],
            MemL[0:Pts + I * 8 + 8], MemL[0:Pts + I * 8 + 12]);
End;

{ Polygone plein (balayage, regle pair-impair) puis contour }
Procedure FillPoly(D, Pts, N : LongInt);
Var Y, I, J, X1, Y1, X2, Y2, K, T, MinY, MaxY : LongInt;
    Xs : Array[0..63] Of LongInt;
Begin
  If (N < 3) Or (Dcs[D].Brush < 0) Or (Gdis^[Dcs[D].Brush].I1 = 1) Then Exit;
  MinY := $7FFFFFF; MaxY := -$7FFFFFF;
  For I := 0 To N - 1 Do
  Begin
    MinY := Min(MinY, MemL[0:Pts + I * 8 + 4]);
    MaxY := Max(MaxY, MemL[0:Pts + I * 8 + 4]);
  End;
  For Y := Max(MinY, ClipY1) To Min(MaxY, ClipY2) Do
  Begin
    K := 0;
    J := N - 1;
    For I := 0 To N - 1 Do
    Begin
      X1 := MemL[0:Pts + I * 8]; Y1 := MemL[0:Pts + I * 8 + 4];
      X2 := MemL[0:Pts + J * 8]; Y2 := MemL[0:Pts + J * 8 + 4];
      If ((Y1 <= Y) And (Y2 > Y)) Or ((Y2 <= Y) And (Y1 > Y)) Then
        If K < 64 Then
        Begin
          Xs[K] := X1 + (Y - Y1) * (X2 - X1) Div (Y2 - Y1);
          Inc(K);
        End;
      J := I;
    End;
    For I := 0 To K - 2 Do
      For J := I + 1 To K - 1 Do
        If Xs[J] < Xs[I] Then
        Begin
          T := Xs[I]; Xs[I] := Xs[J]; Xs[J] := T;
        End;
    I := 0;
    While I + 1 < K Do
    Begin
      BrushFill(Xs[I], Y, Xs[I + 1], Y, Dcs[D].Brush);
      I := I + 2;
    End;
  End;
End;

Function Polygon(Hdc, Pts, N : LongInt) : LongInt;
Var D, I, J : LongInt;
Begin
  Polygon := 1;
  D := DcOf(Hdc);
  If Not DcBegin(D) Then Exit;
  FillPoly(D, Pts, N);
  For I := 0 To N - 1 Do
  Begin
    J := (I + 1) Mod N;
    PenLine(D, MemL[0:Pts + I * 8], MemL[0:Pts + I * 8 + 4],
            MemL[0:Pts + J * 8], MemL[0:Pts + J * 8 + 4]);
  End;
  DcDirtyAll;
End;

Function PolyPolygon(Hdc, Pts, Counts, N : LongInt) : LongInt;
Var I, P : LongInt;
Begin
  P := Pts;
  For I := 0 To N - 1 Do
  Begin
    Polygon(Hdc, P, MemL[0:Counts + I * 4]);
    P := P + MemL[0:Counts + I * 4] * 8;
  End;
  PolyPolygon := 1;
End;

Function Rectangle(Hdc, L0, T0, R0, B0 : LongInt) : LongInt;
Var D, C : LongInt;
Begin
  Rectangle := 1;
  D := DcOf(Hdc);
  If Not DcBegin(D) Then Exit;
  BrushFill(L0 + 1, T0 + 1, R0 - 2, B0 - 2, Dcs[D].Brush);
  If PenColor(D, C) Then Box(L0, T0, R0 - 1, B0 - 1, C)
  Else BrushFill(L0, T0, R0 - 1, B0 - 1, Dcs[D].Brush);
  DcDirty(L0, T0, R0, B0);
End;

{ Rectangle aux coins arrondis : quarts d'ellipse de W x H points }
Function RoundRect(Hdc, L0, T0, R0, B0, W, H : LongInt) : LongInt;
Var D, C, RX, RY, Y, Yr, In0, PIn, A, B : LongInt; Ok : Boolean;
Begin
  RoundRect := 1;
  RX := Min(W Div 2, (R0 - L0) Div 2); RY := Min(H Div 2, (B0 - T0) Div 2);
  If (RX < 1) Or (RY < 1) Then
  Begin
    RoundRect := Rectangle(Hdc, L0, T0, R0, B0);
    Exit;
  End;
  D := DcOf(Hdc);
  If Not DcBegin(D) Then Exit;
  Ok := PenColor(D, C);
  PIn := -1;
  For Y := T0 To B0 - 1 Do
  Begin
    { retrait du bord dans les coins }
    If Y < T0 + RY Then Yr := T0 + RY - Y
    Else If Y > B0 - 1 - RY Then Yr := Y - (B0 - 1 - RY)
    Else Yr := 0;
    If Yr > 0 Then
      In0 := RX - ISqrt(RX * RX - MulDiv(RX * RX, Yr * Yr, RY * RY))
    Else In0 := 0;
    BrushFill(L0 + In0, Y, R0 - 1 - In0, Y, Dcs[D].Brush);
    If Ok Then
    Begin
      If (Y = T0) Or (Y = B0 - 1) Then HLine(L0 + In0, R0 - 1 - In0, Y, C)
      Else
      Begin
        Pix(L0 + In0, Y, C); Pix(R0 - 1 - In0, Y, C);
        If (PIn >= 0) And (Abs(In0 - PIn) > 1) Then
        Begin
          A := Min(In0, PIn); B := Max(In0, PIn);
          HLine(L0 + A, L0 + B, Y, C);
          HLine(R0 - 1 - B, R0 - 1 - A, Y, C);
        End;
      End;
    End;
    PIn := In0;
  End;
  DcDirty(L0, T0, R0, B0);
End;

Function Ellipse(Hdc, L0, T0, R0, B0 : LongInt) : LongInt;
Var D, C, CX, CY, RX, RY, Y, DX, PX : LongInt; Ok : Boolean;
Begin
  Ellipse := 1;
  D := DcOf(Hdc);
  If Not DcBegin(D) Then Exit;
  CX := (L0 + R0 - 1) Div 2; CY := (T0 + B0 - 1) Div 2;
  RX := Max(1, (R0 - L0 - 1) Div 2); RY := Max(1, (B0 - T0 - 1) Div 2);
  Ok := PenColor(D, C);
  PX := 0;
  For Y := -RY To RY Do
  Begin
    DX := ISqrt(RX * RX - MulDiv(RX * RX, Y * Y, RY * RY));
    BrushFill(CX - DX, CY + Y, CX + DX, CY + Y, Dcs[D].Brush);
    If Ok Then
    Begin
      Pix(CX - DX, CY + Y, C); Pix(CX + DX, CY + Y, C);
      If Abs(Y) = RY Then HLine(CX - DX, CX + DX, CY + Y, C);
      If (Y > -RY) And (Abs(DX - PX) > 1) Then
      Begin
        HLine(Min(CX - DX, CX - PX), Max(CX - DX, CX - PX), CY + Y, C);
        HLine(Min(CX + DX, CX + PX), Max(CX + DX, CX + PX), CY + Y, C);
      End;
    End;
    PX := DX;
  End;
  DcDirty(L0, T0, R0, B0);
End;

Function FillRgn(Hdc, H, Br : LongInt) : LongInt;
Var D, I : LongInt;
Begin
  FillRgn := 1;
  D := DcOf(Hdc);
  I := GdiOf(H, goRegion);
  If (I < 0) Or Not DcBegin(D) Then Exit;
  BrushFill(Gdis^[I].I1, Gdis^[I].I2, Gdis^[I].I3 - 1, Gdis^[I].I4 - 1,
            GdiOf(Br, goBrush));
  DcDirty(Gdis^[I].I1, Gdis^[I].I2, Gdis^[I].I3, Gdis^[I].I4);
End;

Function PaintRgn(Hdc, H : LongInt) : LongInt;
Var D : LongInt;
Begin
  D := DcOf(Hdc);
  If D < 0 Then PaintRgn := 0
  Else PaintRgn := FillRgn(Hdc, H, GdiH(Dcs[D].Brush));
End;

Function FrameRgn(Hdc, H, Br, W, Hh : LongInt) : LongInt;
Var D, I, B : LongInt;
Begin
  FrameRgn := 1;
  D := DcOf(Hdc);
  I := GdiOf(H, goRegion);
  B := GdiOf(Br, goBrush);
  If (I < 0) Or Not DcBegin(D) Then Exit;
  BrushFill(Gdis^[I].I1, Gdis^[I].I2, Gdis^[I].I3 - 1, Gdis^[I].I2 + Hh - 1, B);
  BrushFill(Gdis^[I].I1, Gdis^[I].I4 - Hh, Gdis^[I].I3 - 1, Gdis^[I].I4 - 1, B);
  BrushFill(Gdis^[I].I1, Gdis^[I].I2, Gdis^[I].I1 + W - 1, Gdis^[I].I4 - 1, B);
  BrushFill(Gdis^[I].I3 - W, Gdis^[I].I2, Gdis^[I].I3 - 1, Gdis^[I].I4 - 1, B);
  DcDirty(Gdis^[I].I1, Gdis^[I].I2, Gdis^[I].I3, Gdis^[I].I4);
End;

Function InvertRgn(Hdc, H : LongInt) : LongInt;
Var D, I, X, Y, A : LongInt;
Begin
  InvertRgn := 1;
  D := DcOf(Hdc);
  I := GdiOf(H, goRegion);
  If (I < 0) Or Not DcBegin(D) Then Exit;
  For Y := Max(Gdis^[I].I2, ClipY1) To Min(Gdis^[I].I4 - 1, ClipY2) Do
    For X := Max(Gdis^[I].I1, ClipX1) To Min(Gdis^[I].I3 - 1, ClipX2) Do
      XorPix(X, Y, TgtMask);
  DcDirty(Gdis^[I].I1, Gdis^[I].I2, Gdis^[I].I3, Gdis^[I].I4);
End;

Function SetPixel(Hdc, X, Y, C : LongInt) : LongInt;
Var D : LongInt;
Begin
  SetPixel := C;
  D := DcOf(Hdc);
  If Not DcBegin(D) Then Exit;
  Pix(X, Y, GColor(C));
  DcDirty(X, Y, X, Y);
End;

Function GetPixel(Hdc, X, Y : LongInt) : LongInt;
Var D, I : LongInt;
Begin
  GetPixel := -1;
  D := DcOf(Hdc);
  If Not DcBegin(D) Then Exit;
  If (X < ClipX1) Or (X > ClipX2) Or (Y < ClipY1) Or (Y > ClipY2) Then Exit;
  I := GetPix(X, Y);
  If GMono Then
  Begin
    If I <> 0 Then GetPixel := $FFFFFF Else GetPixel := 0;
  End
  Else If GTab <> 0 Then
    GetPixel := ((MemL[0:GTab + I * 4] Shr 16) And 255) Or
                (MemL[0:GTab + I * 4] And $FF00) Or
                ((MemL[0:GTab + I * 4] And 255) Shl 16)
  Else GetPixel := XToCr(RawToX(I, DS.Bpp));
End;

{ ------------------------------------------------------------------ }
{ Texte (police 8x16)                                                }
{ ------------------------------------------------------------------ }

{ Taille des caracteres de la police du DC : 8x16, ou agrandie (12x24,
  16x32) pour une police demandee de 20 points ou plus (CreateFontA) }
Procedure FontDims(D : LongInt; Var Cw, Chh : LongInt);
Var H : LongInt;
Begin
  Cw := 8; Chh := 16;
  If (D < 0) Or (Dcs[D].Font < 0) Then Exit;
  If Gdis^[Dcs[D].Font].Kind <> goFont Then Exit;
  H := Abs(Gdis^[Dcs[D].Font].I1);
  { petite police (MS Sans Serif 8...) : la police 6x13 }
  If (H >= 1) And (H <= 13) Then
  Begin
    Cw := 6; Chh := 13;
  End
  Else If H >= 28 Then
  Begin
    Cw := 16; Chh := 32;
  End
  Else If H >= 20 Then
  Begin
    Cw := 12; Chh := 24;
  End;
End;

{ Caractere agrandi : la police 8x16 etiree (plus proche voisin) }
Procedure DrawCharS(X, Y : LongInt; Ch : Char; C, Cw, Chh : LongInt);
Var R, CX, B, F : LongInt;
Begin
  If (X > ClipX2) Or (X + Cw - 1 < ClipX1) Or (Y > ClipY2) Or
     (Y + Chh - 1 < ClipY1) Then Exit;
  F := FontAddr + Ord(Ch) * 16;
  For R := 0 To Chh - 1 Do
  Begin
    B := Mem[0:F + (R * 16) Div Chh];
    If B <> 0 Then
      For CX := 0 To Cw - 1 Do
        If (B And ($80 Shr ((CX * 8) Div Cw))) <> 0 Then
          Pix(X + CX, Y + R, C);
  End;
End;

Procedure TextAt(D, X, Y, Str, N, Opt, PRect : LongInt);
Var I, C, Bg, W, A, Cw, Chh, Ch : LongInt; R : TRect; An : Boolean;
Begin
  FontDims(D, Cw, Chh);
  W := N * Cw;
  A := Dcs[D].TextAlign;
  If (A And 1) <> 0 Then
  Begin
    X := Dcs[D].PosX; Y := Dcs[D].PosY;
  End;
  If (A And 6) = 6 Then X := X - W Div 2
  Else If (A And 2) <> 0 Then X := X - W;
  If (A And 24) = 24 Then Y := Y - (Chh * 3) Div 4
  Else If (A And 8) <> 0 Then Y := Y - Chh;
  If (A And 1) <> 0 Then Dcs[D].PosX := X + W;
  C := GColor(Dcs[D].TextColor);
  Bg := GColor(Dcs[D].BkColor);
  If (PRect <> 0) And ((Opt And 2) <> 0) Then
  Begin
    GetRectAt(PRect, R);
    FBar(R.L, R.T, R.R - 1, R.B - 1, Bg);
    DcDirty(R.L, R.T, R.R, R.B);
  End;
  If (PRect <> 0) And ((Opt And 4) <> 0) Then
  Begin
    GetRectAt(PRect, R);
    ClipX1 := Max(ClipX1, R.L); ClipY1 := Max(ClipY1, R.T);
    ClipX2 := Min(ClipX2, R.R - 1); ClipY2 := Min(ClipY2, R.B - 1);
  End;
  If (Dcs[D].BkMode = 2) And ((Opt And 2) = 0) Then
    FBar(X, Y, X + W - 1, Y + Chh - 1, Bg);
  An := AnsiApp;
  For I := 0 To N - 1 Do
  Begin
    Ch := Mem[0:Str + I];
    If An And (Ch >= 128) Then Ch := AnsiOem[Ch];
    If (Cw = 8) And (Chh = 16) Then DrawChar(X + I * 8, Y, Chr(Ch), C)
    Else If (Cw = 6) And (Chh = 13) Then DrawSmall(X + I * 6, Y, Chr(Ch), C)
    Else DrawCharS(X + I * Cw, Y, Chr(Ch), C, Cw, Chh);
  End;
  DcDirty(X, Y, X + W, Y + Chh);
End;

Function TextOutA(Hdc, X, Y, Str, N : LongInt) : LongInt;
Var D : LongInt;
Begin
  TextOutA := 1;
  D := DcOf(Hdc);
  If DcBegin(D) Then TextAt(D, X, Y, Str, N, 0, 0);
End;

Function ExtTextOutA(Hdc, X, Y, Opt, PRect, Str, N, Dx : LongInt) : LongInt;
Var D : LongInt;
Begin
  ExtTextOutA := 1;
  D := DcOf(Hdc);
  If DcBegin(D) Then TextAt(D, X, Y, Str, N, Opt, PRect);
End;

Function GetTextExtentPointA(Hdc, Str, N, P : LongInt) : LongInt;
Var Cw, Chh : LongInt;
Begin
  FontDims(DcOf(Hdc), Cw, Chh);
  MemL[0:P] := N * Cw; MemL[0:P + 4] := Chh;
  GetTextExtentPointA := 1;
End;

Function GetTextExtentPoint32A(Hdc, Str, N, P : LongInt) : LongInt;
Begin
  GetTextExtentPoint32A := GetTextExtentPointA(Hdc, Str, N, P);
End;

{ TEXTMETRIC (56 octets) }
Function GetTextMetricsA(Hdc, P : LongInt) : LongInt;
Var Cw, Chh : LongInt;
Begin
  FontDims(DcOf(Hdc), Cw, Chh);
  FillMem(P, 56, 0);
  MemL[0:P] := Chh; MemL[0:P + 4] := (Chh * 3) Div 4;
  MemL[0:P + 8] := Chh - (Chh * 3) Div 4;
  MemL[0:P + 20] := Cw; MemL[0:P + 24] := Cw; MemL[0:P + 28] := 400;
  MemL[0:P + 36] := 96; MemL[0:P + 40] := 96;
  Mem[0:P + 44] := 32; Mem[0:P + 45] := 255; Mem[0:P + 46] := Ord('?');
  Mem[0:P + 47] := 32; Mem[0:P + 51] := $30;
  GetTextMetricsA := 1;
End;

Function GetTextFaceA(Hdc, N, Buf : LongInt) : LongInt;
Var D : LongInt; S : String;
Begin
  D := DcOf(Hdc);
  S := 'System';
  If (D >= 0) And (Dcs[D].Font >= 0) And (Gdis^[Dcs[D].Font].Name <> '') Then
    S := Gdis^[Dcs[D].Font].Name;
  PutPStr(Buf, S, N);
  GetTextFaceA := Length(S);
End;

{ EnumFontsA : une seule police (System) annoncee }
Function EnumFontsA(Hdc, Face, Proc, Lp : LongInt) : LongInt;
Var Lf, Tm, R : LongInt;
Begin
  EnumFontsA := 1;
  If Proc = 0 Then Exit;
  Lf := KAlloc(60); Tm := KAlloc(64);
  MemL[0:Lf] := 16; MemL[0:Lf + 4] := 8; MemL[0:Lf + 16] := 400;
  PutPStr(Lf + 28, 'System', 32);
  GetTextMetricsA(Hdc, Tm);
  R := 0;
  asm
    mov eax,Lp
    push eax
    push 1
    mov eax,Tm
    push eax
    mov eax,Lf
    push eax
    mov eax,Proc
    call eax
    mov R,eax
  end;
  KFree(Lf); KFree(Tm);
  EnumFontsA := R;
End;

{ ------------------------------------------------------------------ }
{ Transferts de blocs                                                }
{ ------------------------------------------------------------------ }

{ Source d'un transfert : surface, table de couleurs (DIB) et
  monochrome. Rend False si la source n'est pas lisible }
Function SrcInfo(D : LongInt; Var S : TSurf; Var Tab : LongInt;
                 Var Mono : Boolean; Var OX, OY : LongInt) : Boolean;
Var B : LongInt; Clip : TRect;
Begin
  SrcInfo := False;
  Tab := 0; Mono := False; OX := 0; OY := 0;
  If (D < 0) Or Not Dcs[D].Used Then Exit;
  If Dcs[D].Wnd >= 0 Then
  Begin
    If Not WndTarget(Dcs[D].Wnd, Dcs[D].Client, S, OX, OY, Clip) Then Exit;
  End
  Else If Dcs[D].Screen Then
  Begin
    S := Back;
  End
  Else
  Begin
    B := Dcs[D].Bmp;
    If B < 0 Then B := DefBmp;
    If Not BmpSurf(B, S) Then Exit;
    Tab := Gdis^[B].I6;
    Mono := (Gdis^[B].I7 And 4) <> 0;
  End;
  OX := OX + Dcs[D].VpX - Dcs[D].WinX;
  OY := OY + Dcs[D].VpY - Dcs[D].WinY;
  SrcInfo := True;
End;

{ Couleur Q (RGBQUAD) de l'entree I d'une table de DIB vers un indice
  de la palette systeme : comme Windows, une couleur presente dans la
  palette logique du contexte (de preference au meme indice) prend
  l'indice systeme realise de cette entree ; sinon la plus proche }
Function PalMatch(D, I, Q, C : LongInt) : LongInt;
Var P, N, E, J, R : LongInt;
Begin
  P := Dcs[D].Pal;
  If (P >= 0) And (P <> DefPal) And (Gdis^[P].I3 <> 0) Then
  Begin
    N := Gdis^[P].I2;
    R := ((Q Shr 16) And 255) Or (Q And $FF00) Or ((Q And 255) Shl 16);
    If I < N Then
    Begin
      E := Gdis^[P].I1 + I * 4;
      If (MemL[0:E] And $FFFFFF) = R Then
      Begin
        PalMatch := Mem[0:Gdis^[P].I3 + I];
        Exit;
      End;
    End;
    For J := 0 To N - 1 Do
      If (MemL[0:Gdis^[P].I1 + J * 4] And $FFFFFF) = R Then
      Begin
        PalMatch := Mem[0:Gdis^[P].I3 + J];
        Exit;
      End;
  End;
  PalMatch := GColor(C);
End;

{ Table de traduction source -> cible (XlatTab) ; False si identite }
Function BuildXlat(STab : LongInt; SMono : Boolean; D : LongInt) : Boolean;
Var I, Q, C : LongInt; Same : Boolean;
Begin
  BuildXlat := False;
  If SMono Then
  Begin
    C := RawOf(GColor(Dcs[D].BkColor), DS.Bpp);
    For I := 0 To 255 Do XlatL[I] := C;
    XlatL[0] := RawOf(GColor(Dcs[D].TextColor), DS.Bpp);
    BuildXlat := True;
    Exit;
  End;
  If (DS.Bpp > 8) Or GMono Then
  Begin
    { couleurs vraies (ou monochrome) : couleur exacte de chaque indice }
    For I := 0 To 255 Do
    Begin
      If STab <> 0 Then Q := MemL[0:STab + I * 4] And $FFFFFF
      Else Q := SysX[I];
      XlatL[I] := ToTgt(Q);
    End;
    BuildXlat := True;
    Exit;
  End;
  If (STab = 0) And (GTab = 0) Then Exit;
  If (STab <> 0) And (GTab <> 0) Then
  Begin
    Same := True;
    For I := 0 To 255 Do
      If MemL[0:STab + I * 4] <> MemL[0:GTab + I * 4] Then
      Begin
        Same := False;
        Break;
      End;
    If Same Then Exit;
  End;
  For I := 0 To 255 Do
  Begin
    If STab <> 0 Then
    Begin
      Q := MemL[0:STab + I * 4];
      C := ((Q Shr 16) And 255) Or (Q And $FF00) Or ((Q And 255) Shl 16);
      If GTab = 0 Then
        XlatL[I] := PalMatch(D, I, Q And $FFFFFF, C)
      Else XlatL[I] := GColor(C);
    End
    Else XlatL[I] := GColor(IdxColor(I));
  End;
  BuildXlat := True;
End;

{ Combiner un point selon une ROP3 (P motif, S source, D cible) }
Function Rop3(Rop, P, S, D : LongInt) : LongInt;
Var R, I : LongInt;
Begin
  Case Rop Of
    SRCCOPY : Rop3 := S;
    SRCPAINT : Rop3 := S Or D;
    SRCAND : Rop3 := S And D;
    SRCINVERT : Rop3 := S Xor D;
    NOTSRCCOPY : Rop3 := (Not S) And RopMsk;
    SRCERASE : Rop3 := S And Not D And RopMsk;
    MERGEPAINT : Rop3 := (Not S Or D) And RopMsk;
    NOTSRCERASE : Rop3 := (Not (S Or D)) And RopMsk;
    MERGECOPY : Rop3 := P And S;
    DSTINVERT : Rop3 := (Not D) And RopMsk;
    PATCOPY : Rop3 := P;
    PATINVERT : Rop3 := P Xor D;
    BLACKNESS : Rop3 := 0;
    WHITENESS : Rop3 := RopMsk;
  Else
    R := 0;
    I := (Rop Shr 16) And 255;
    If (I And $01) <> 0 Then R := R Or (Not P And Not S And Not D);
    If (I And $02) <> 0 Then R := R Or (Not P And Not S And D);
    If (I And $04) <> 0 Then R := R Or (Not P And S And Not D);
    If (I And $08) <> 0 Then R := R Or (Not P And S And D);
    If (I And $10) <> 0 Then R := R Or (P And Not S And Not D);
    If (I And $20) <> 0 Then R := R Or (P And Not S And D);
    If (I And $40) <> 0 Then R := R Or (P And S And Not D);
    If (I And $80) <> 0 Then R := R Or (P And S And D);
    Rop3 := R And RopMsk;
  End;
End;

{ Transfert (avec mise a l'echelle) de la source S vers le contexte
  courant (DcBegin deja fait). Coordonnees logiques de la cible }
Procedure BltCore(DX, DY, DW, DH : LongInt; Var S : TSurf; SX, SY, SW,
                  SH : LongInt; Xl : Boolean; Rop, STab : LongInt;
                  SMono : Boolean; SBk : LongInt);
Var X, Y, SXX, SYY, A, V, X0, X1, Y0, Y1, SRow, Pc, PB, SPB, N : LongInt;
    Simple : Boolean;
Begin
  If (DW = 0) Or (DH = 0) Or (SW = 0) Or (SH = 0) Then Exit;
  If DW < 0 Then
  Begin
    DX := DX + DW + 1; DW := -DW; SX := SX + SW - 1; SW := -SW;
  End;
  If DH < 0 Then
  Begin
    DY := DY + DH + 1; DH := -DH; SY := SY + SH - 1; SH := -SH;
  End;
  X0 := Max(DX, ClipX1); X1 := Min(DX + DW - 1, ClipX2);
  Y0 := Max(DY, ClipY1); Y1 := Min(DY + DH - 1, ClipY2);
  If (X0 > X1) Or (Y0 > Y1) Then Exit;
  PB := PxBytes(DS.Bpp); SPB := PxBytes(S.Bpp);
  RopMsk := TgtMask;
  Pc := 0;
  If (Dcs[GDc].Brush >= 0) Then
    Pc := RawOf(GColor(Gdis^[Dcs[GDc].Brush].I2), DS.Bpp);
  Simple := (Rop = SRCCOPY) And Not Xl And (DW = SW) And (DH = SH) And
            Not GMono And (S.Bpp = DS.Bpp);
  For Y := Y0 To Y1 Do
  Begin
    SYY := SY + ((Y - DY) * SH) Div DH;
    If (SYY < 0) Or (SYY >= S.H) Then Continue;
    SRow := S.Bits + SYY * S.Pitch;
    A := DS.Bits + (Y - DOY) * DS.Pitch - DOX * PB;
    If Simple Then
    Begin
      SXX := SX + (X0 - DX);
      X := X0;
      If SXX < 0 Then
      Begin
        X := X - SXX; SXX := 0;
      End;
      N := Min(X1 - X + 1, S.W - SXX);
      If (X <= X1) And (N > 0) Then
        MoveMem(SRow + SXX * SPB, A + X * PB, N * PB);
      Continue;
    End;
    For X := X0 To X1 Do
    Begin
      SXX := SX + ((X - DX) * SW) Div DW;
      If (SXX < 0) Or (SXX >= S.W) Then Continue;
      V := GetRaw(SRow + SXX * SPB, S.Bpp);
      If GMono Then
      Begin
        { couleur -> monochrome : blanc pour la couleur de fond de la
          source, noir sinon }
        If Not SMono Then V := Ord(SrcX(V, S.Bpp, STab) = SBk);
      End
      Else If Xl Then V := XlatL[V And 255]
      Else If S.Bpp <> DS.Bpp Then V := ToTgt(RawToX(V, S.Bpp));
      If Rop <> SRCCOPY Then V := Rop3(Rop, Pc, V, GetRaw(A + X * PB, DS.Bpp));
      PutRaw(A + X * PB, V, DS.Bpp);
    End;
  End;
  DcDirty(X0, Y0, X1, Y1);
End;

Function StretchBlt(Hdc, X, Y, W, H, Src, SX, SY, SW, SH, Rop : LongInt)
  : LongInt;
Var D, SD, STab, OX, OY, SBk, C : LongInt; S : TSurf; SMono, Xl : Boolean;
Begin
  StretchBlt := 1;
  D := DcOf(Hdc);
  If (Rop = PATCOPY) Or (Rop = BLACKNESS) Or (Rop = WHITENESS) Or
     (Rop = DSTINVERT) Or (Rop = PATINVERT) Then
  Begin
    StretchBlt := PatBlt(Hdc, X, Y, W, H, Rop);
    Exit;
  End;
  SD := DcOf(Src);
  If Not SrcInfo(SD, S, STab, SMono, OX, OY) Then Exit;
  C := Dcs[SD].BkColor;
  SBk := ((C And 255) Shl 16) Or (C And $FF00) Or ((C Shr 16) And 255);
  If Not DcBegin(D) Then Exit;
  Xl := False;
  If S.Bpp = 8 Then Xl := BuildXlat(STab, SMono, D);
  BltCore(X, Y, W, H, S, SX + OX, SY + OY, SW, SH, Xl, Rop, STab, SMono,
          SBk);
End;

Function BitBlt(Hdc, X, Y, W, H, Src, SX, SY, Rop : LongInt) : LongInt;
Begin
  BitBlt := StretchBlt(Hdc, X, Y, W, H, Src, SX, SY, W, H, Rop);
End;

{ ------------------------------------------------------------------ }
{ DIB : BITMAPINFOHEADER +0 taille +4 largeur +8 hauteur +12 plans    }
{       +14 bits par point +16 compression +32 couleurs utilisees      }
{ ------------------------------------------------------------------ }

{ En-tete BITMAPCOREHEADER (12 octets, format OS/2 : largeur et hauteur
  sur 16 bits, couleurs RGBTRIPLE) : copie en BITMAPINFOHEADER avec une
  table RGBQUAD (ou d'indices de palette, Usage 1), a liberer par
  l'appelant si elle differe de Bmi ; DibCoreOfs : debut des bits d'une
  DIB compacte au format OS/2 }
Function DibCore(Bmi, Usage : LongInt) : LongInt;
Var N, Bpp, I, A : LongInt;
Begin
  DibCore := Bmi;
  If (Bmi = 0) Or (MemL[0:Bmi] <> 12) Then Exit;
  Bpp := MemW[0:Bmi + 10];
  N := 0;
  If Bpp <= 8 Then N := 1 Shl Bpp;
  A := KAlloc(40 + 1024);
  If A = 0 Then Exit;
  FillMem(A, 40 + 1024, 0);
  MemL[0:A] := 40;
  MemL[0:A + 4] := MemW[0:Bmi + 4]; MemL[0:A + 8] := MemW[0:Bmi + 6];
  MemW[0:A + 12] := 1; MemW[0:A + 14] := Bpp;
  MemL[0:A + 32] := N;
  For I := 0 To N - 1 Do
    If Usage = 1 Then MemW[0:A + 40 + I * 2] := MemW[0:Bmi + 12 + I * 2]
    Else
    Begin
      Mem[0:A + 40 + I * 4] := Mem[0:Bmi + 12 + I * 3];
      Mem[0:A + 41 + I * 4] := Mem[0:Bmi + 13 + I * 3];
      Mem[0:A + 42 + I * 4] := Mem[0:Bmi + 14 + I * 3];
    End;
  DibCore := A;
End;

Function DibCoreOfs(Bmi, Usage : LongInt) : LongInt;
Var N : LongInt;
Begin
  N := 0;
  If MemW[0:Bmi + 10] <= 8 Then N := 1 Shl MemW[0:Bmi + 10];
  If Usage = 1 Then DibCoreOfs := 12 + N * 2
  Else DibCoreOfs := 12 + N * 3;
End;

Function DibColors(Bmi : LongInt) : LongInt;
Var N : LongInt;
Begin
  N := MemL[0:Bmi + 32];
  If (N = 0) And (MemW[0:Bmi + 14] <= 8) Then N := 1 Shl MemW[0:Bmi + 14];
  If MemW[0:Bmi + 14] > 8 Then N := 0;
  If MemL[0:Bmi + 16] = 3 Then N := 3;
  DibColors := N;
End;

Function DibPitch(W, Bpp : LongInt) : LongInt;
Begin
  DibPitch := ((W * Bpp + 31) Div 32) * 4;
End;

{ Table RGBQUAD (256 entrees) d'apres BITMAPINFO et Usage
  (0 DIB_RGB_COLORS, 1 DIB_PAL_COLORS : indices dans la palette du DC) }
Procedure DibTable(Bmi, Usage, D, Dst : LongInt);
Var I, N, T, P, E, Q : LongInt;
Begin
  FillMem(Dst, 1024, 0);
  N := DibColors(Bmi);
  If N > 256 Then N := 256;
  T := Bmi + MemL[0:Bmi];
  For I := 0 To N - 1 Do
    If Usage = 1 Then
    Begin
      Q := MemW[0:T + I * 2];
      If (D >= 0) And (Dcs[D].Pal >= 0) Then P := Dcs[D].Pal Else P := DefPal;
      If Q < Gdis^[P].I2 Then
      Begin
        E := Gdis^[P].I1 + Q * 4;
        MemL[0:Dst + I * 4] := (Mem[0:E] Shl 16) Or (Mem[0:E + 1] Shl 8) Or
                               Mem[0:E + 2];
      End;
    End
    Else MemL[0:Dst + I * 4] := MemL[0:T + I * 4] And $FFFFFF;
End;

{ Lire le point (X, Y) d'une DIB (Y depuis le haut) comme indice de la
  table (1, 4, 8 bits) ou couleur RGB (16, 24, 32 bits, avec bit 31) }
{ DIB 16 bits en 5-6-5 : BI_BITFIELDS avec le masque vert 07E0h (les
  masques suivent l'en-tete de 40 octets, ou y sont pour V4 et V5) }
Function DibIs565(Bmi : LongInt) : Boolean;
Begin
  DibIs565 := (MemW[0:Bmi + 14] = 16) And (MemL[0:Bmi + 16] = 3) And
              (MemL[0:Bmi + 44] = $7E0);
End;

{ Point X d'une ligne de DIB : indice de la table (1, 4, 8 bits) ou
  couleur 00RRGGBB avec le bit 31 (16, 24, 32 bits ; 16 bits en 5-5-5,
  ou 5-6-5 si DibG6) }
Function DibPixRow(Row, Bpp, X : LongInt) : LongInt;
Var A, V : LongInt;
Begin
  Case Bpp Of
    8 : DibPixRow := Mem[0:Row + X];
    4 :
    Begin
      V := Mem[0:Row + X Div 2];
      If Odd(X) Then DibPixRow := V And 15 Else DibPixRow := V Shr 4;
    End;
    1 : DibPixRow := (Mem[0:Row + X Div 8] Shr (7 - X Mod 8)) And 1;
    24 :
    Begin
      A := Row + X * 3;
      DibPixRow := LongInt($80000000) Or (Mem[0:A + 2] Shl 16) Or
                   (Mem[0:A + 1] Shl 8) Or Mem[0:A];
    End;
    32 : DibPixRow := LongInt($80000000) Or (MemL[0:Row + X * 4] And $FFFFFF);
    16 :
    Begin
      If DibG6 Then V := RawToX(MemW[0:Row + X * 2], 16)
      Else V := RawToX(MemW[0:Row + X * 2], 15);
      DibPixRow := LongInt($80000000) Or V;
    End;
  Else
    DibPixRow := 0;
  End;
End;

{ Ecrire le point X (00RRGGBB, ou indice I pour 1, 4, 8 bits) d'une
  ligne de DIB }
Procedure DibPutRow(Row, Bpp, X, V : LongInt);
Var A, M : LongInt;
Begin
  Case Bpp Of
    8 : Mem[0:Row + X] := V;
    4 :
    Begin
      A := Row + X Div 2;
      If Odd(X) Then Mem[0:A] := (Mem[0:A] And $F0) Or (V And 15)
      Else Mem[0:A] := (Mem[0:A] And 15) Or ((V And 15) Shl 4);
    End;
    1 :
    Begin
      A := Row + X Div 8; M := $80 Shr (X Mod 8);
      If (V And 1) <> 0 Then Mem[0:A] := Mem[0:A] Or M
      Else Mem[0:A] := Mem[0:A] And Not M;
    End;
    16 :
      If DibG6 Then MemW[0:Row + X * 2] := XToRaw(V, 16)
      Else MemW[0:Row + X * 2] := XToRaw(V, 15);
    24 :
    Begin
      A := Row + X * 3;
      MemW[0:A] := V; Mem[0:A + 2] := V Shr 16;
    End;
    32 : MemL[0:Row + X * 4] := V And $FFFFFF;
  End;
End;

Function DibPix(Bits, W, H, Bpp, X, Y : LongInt; TopDown : Boolean)
  : LongInt;
Begin
  If Not TopDown Then Y := H - 1 - Y;
  DibPix := DibPixRow(Bits + Y * DibPitch(W, Bpp), Bpp, X);
End;

{ Transferer une DIB (memoire de l'appelant) vers le contexte courant }
Procedure DibToDc(D, DX, DY, DW, DH, SX, SY, SW, SH, Bits, Bmi, Usage,
                  Rop : LongInt);
Var W, H, Bpp, X, Y, SXX, SYY, V, A, X0, X1, Y0, Y1, Tab, Q, P, N,
    T, PB, DP, Row : LongInt;
    Top : Boolean;
Begin
  W := MemL[0:Bmi + 4]; H := MemL[0:Bmi + 8]; Bpp := MemW[0:Bmi + 14];
  Top := H < 0;
  If Top Then H := -H;
  If (DW = 0) Or (DH = 0) Or (SW = 0) Or (SH = 0) Then Exit;
  DibG6 := DibIs565(Bmi);
  PB := PxBytes(DS.Bpp);
  RopMsk := TgtMask;
  If Bpp <= 8 Then
  Begin
    Tab := KAlloc(1024);
    DibTable(Bmi, Usage, D, Tab);
    For V := 0 To 255 Do
    Begin
      Q := MemL[0:Tab + V * 4];
      XlatL[V] := RawOf(GColor(XToCr(Q And $FFFFFF)), DS.Bpp);
    End;
    KFree(Tab);
    { DIB_PAL_COLORS en 256 couleurs : indices de la palette logique ->
      indices systeme realises (sans passer par RVB : les fondus de
      palette restent possibles) }
    If (Usage = 1) And (DS.Bpp = 8) And Not GMono And (GTab = 0) Then
    Begin
      P := Dcs[D].Pal;
      If (P >= 0) And (Gdis^[P].I3 <> 0) Then
      Begin
        N := Min(DibColors(Bmi), 256);
        T := Bmi + MemL[0:Bmi];
        For V := 0 To N - 1 Do
        Begin
          Q := MemW[0:T + V * 2];
          If Q < Gdis^[P].I2 Then XlatL[V] := Mem[0:Gdis^[P].I3 + Q];
        End;
      End;
    End;
  End;
  If DW < 0 Then
  Begin
    DX := DX + DW + 1; DW := -DW; SX := SX + SW - 1; SW := -SW;
  End;
  If DH < 0 Then
  Begin
    DY := DY + DH + 1; DH := -DH; SY := SY + SH - 1; SH := -SH;
  End;
  X0 := Max(DX, ClipX1); X1 := Min(DX + DW - 1, ClipX2);
  Y0 := Max(DY, ClipY1); Y1 := Min(DY + DH - 1, ClipY2);
  If (X0 > X1) Or (Y0 > Y1) Then Exit;
  DP := DibPitch(W, Bpp);
  For Y := Y0 To Y1 Do
  Begin
    SYY := SY + ((Y - DY) * SH) Div DH;
    If (SYY < 0) Or (SYY >= H) Then Continue;
    If Top Then Row := Bits + SYY * DP Else Row := Bits + (H - 1 - SYY) * DP;
    A := DS.Bits + (Y - DOY) * DS.Pitch - DOX * PB;
    For X := X0 To X1 Do
    Begin
      SXX := SX + ((X - DX) * SW) Div DW;
      If (SXX < 0) Or (SXX >= W) Then Continue;
      V := DibPixRow(Row, Bpp, SXX);
      If V < 0 Then
      Begin
        If DS.Bpp > 8 Then V := XToRaw(V And $FFFFFF, DS.Bpp)
        Else V := RawOf(GColor(XToCr(V And $FFFFFF)), 8);
      End
      Else V := XlatL[V And 255];
      If Rop <> SRCCOPY Then V := Rop3(Rop, 0, V, GetRaw(A + X * PB, DS.Bpp));
      PutRaw(A + X * PB, V, DS.Bpp);
    End;
  End;
  DcDirty(X0, Y0, X1, Y1);
End;

Function StretchDIBits0(Hdc, X, Y, W, H, SX, SY, SW, SH, Bits, Bmi, Usage,
  Rop : LongInt) : LongInt;
Var D, BH : LongInt;
Begin
  StretchDIBits0 := SH;
  D := DcOf(Hdc);
  If Not DcBegin(D) Then Exit;
  BH := Abs(MemL[0:Bmi + 8]);
  { SY est mesure depuis le bas pour une DIB de bas en haut }
  If MemL[0:Bmi + 8] > 0 Then SY := BH - SY - SH;
  DibToDc(D, X, Y, W, H, SX, SY, SW, SH, Bits, Bmi, Usage, Rop);
End;

{ StretchDIBits : en-tete BITMAPCOREHEADER converti }
Function StretchDIBits(Hdc, X, Y, W, H, SX, SY, SW, SH, Bits, Bmi, Usage, Rop
  : LongInt) : LongInt;
Var C : LongInt;
Begin
  C := DibCore(Bmi, Usage);
  StretchDIBits := StretchDIBits0(Hdc, X, Y, W, H, SX, SY, SW, SH, Bits, C,
    Usage, Rop);
  If C <> Bmi Then KFree(C);
End;

Function SetDIBitsToDevice0(Hdc, X, Y, W, H, SX, SY, Start, Lines, Bits, Bmi,
  Usage : LongInt) : LongInt;
Var D, BH : LongInt;
Begin
  SetDIBitsToDevice0 := Lines;
  D := DcOf(Hdc);
  If Not DcBegin(D) Then Exit;
  BH := Abs(MemL[0:Bmi + 8]);
  If MemL[0:Bmi + 8] > 0 Then SY := BH - SY - H;
  DibToDc(D, X, Y, W, H, SX, SY, W, H, Bits, Bmi, Usage, SRCCOPY);
End;

{ SetDIBitsToDevice : en-tete BITMAPCOREHEADER converti }
Function SetDIBitsToDevice(Hdc, X, Y, W, H, SX, SY, Start, Lines, Bits, Bmi,
  Usage : LongInt) : LongInt;
Var C : LongInt;
Begin
  C := DibCore(Bmi, Usage);
  SetDIBitsToDevice := SetDIBitsToDevice0(Hdc, X, Y, W, H, SX, SY, Start,
    Lines, Bits, C, Usage);
  If C <> Bmi Then KFree(C);
End;

{ Creer un bitmap compatible (8 bits) a partir d'une DIB }
{ 00RRGGBB -> point brut du bitmap B (format F, monochrome, table) }
Function BmpRawOf(B, X, F : LongInt) : LongInt;
Var I, Best, BD, D, T : LongInt;
Begin
  If (Gdis^[B].I7 And 4) <> 0 Then
    BmpRawOf := Ord(((X Shr 16) And 255) * 30 + ((X Shr 8) And 255) * 59 +
                    (X And 255) * 11 >= 12800)
  Else If (F = 8) And (Gdis^[B].I6 <> 0) Then
  Begin
    Best := 0; BD := $7FFFFFFF;
    For I := 0 To 255 Do
    Begin
      T := MemL[0:Gdis^[B].I6 + I * 4];
      D := Sqr(((T Shr 16) And 255) - ((X Shr 16) And 255)) +
           Sqr(((T Shr 8) And 255) - ((X Shr 8) And 255)) +
           Sqr((T And 255) - (X And 255));
      If D < BD Then
      Begin
        BD := D; Best := I;
        If D = 0 Then Break;
      End;
    End;
    BmpRawOf := Best;
  End
  Else BmpRawOf := XToRaw(X, F);
End;

{ Lignes Start..Start+Lines-1 d'une DIB (Bits commence a la ligne
  Start) vers le bitmap B ; rend le nombre de lignes copiees }
Function SetDIBitsK(B, Start, Lines, Bits, Bmi, Usage, D : LongInt)
  : LongInt;
Var DW, DH, L, X, SY, Row, V, I, Tab, DP, SA, Bpp, PB, N : LongInt;
    S : TSurf; Top : Boolean;
Begin
  SetDIBitsK := 0;
  If (B < 0) Or Not BmpSurf(B, S) Then Exit;
  DW := MemL[0:Bmi + 4]; DH := MemL[0:Bmi + 8];
  Top := DH < 0;
  DH := Abs(DH);
  Bpp := MemW[0:Bmi + 14];
  DibG6 := DibIs565(Bmi);
  DP := DibPitch(DW, Bpp); PB := PxBytes(S.Bpp);
  If Bpp <= 8 Then
  Begin
    Tab := KAlloc(1024);
    DibTable(Bmi, Usage, D, Tab);
    For I := 0 To 255 Do
      XlatL[I] := BmpRawOf(B, MemL[0:Tab + I * 4] And $FFFFFF, S.Bpp);
    KFree(Tab);
  End;
  N := 0;
  For L := 0 To Lines - 1 Do
  Begin
    If Start + L >= DH Then Break;
    If Top Then SY := Start + L Else SY := S.H - 1 - (Start + L);
    If (SY >= 0) And (SY < S.H) Then
    Begin
      Row := Bits + L * DP;
      SA := S.Bits + SY * S.Pitch;
      For X := 0 To Min(DW, S.W) - 1 Do
      Begin
        V := DibPixRow(Row, Bpp, X);
        If V < 0 Then V := BmpRawOf(B, V And $FFFFFF, S.Bpp)
        Else V := XlatL[V And 255];
        PutRaw(SA + X * PB, V, S.Bpp);
      End;
    End;
    Inc(N);
  End;
  SetDIBitsK := N;
End;

{ Creer un bitmap compatible (format de l'ecran) a partir d'une DIB }
Function CreateDIBitmapK(Bmi, Bits, Usage : LongInt) : LongInt;
Var B, W, H, C : LongInt;
Begin
  C := DibCore(Bmi, Usage);
  If (C <> Bmi) And (Bits = 0) Then Bits := Bmi + DibCoreOfs(Bmi, Usage);
  W := MemL[0:C + 4]; H := Abs(MemL[0:C + 8]);
  If Bits = 0 Then Bits := C + MemL[0:C] + DibColors(C) * 4;
  { en-tete invalide : pas de bitmap geante }
  If (W <= 0) Or (W > 16384) Or (H > 16384) Then B := -1
  Else B := BmpNew(W, H, ScrFmt, False);
  CreateDIBitmapK := B;
  If B >= 0 Then SetDIBitsK(B, 0, H, Bits, C, Usage, -1);
  If C <> Bmi Then KFree(C);
End;

Function CreateDIBitmap(Hdc, Bih, Init, Bits, Bmi, Usage : LongInt)
  : LongInt;
Var B : LongInt;
Begin
  If ((Init And 4) <> 0) And (Bits <> 0) And (Bmi <> 0) Then
    B := CreateDIBitmapK(Bmi, Bits, Usage)
  Else If (Bih <> 0) And (MemL[0:Bih] = 12) Then
    B := BmpNew(MemW[0:Bih + 4], MemW[0:Bih + 6], ScrFmt, False)
  Else
    B := BmpNew(MemL[0:Bih + 4], Abs(MemL[0:Bih + 8]), ScrFmt, False);
  CreateDIBitmap := GdiH(B);
End;

{ Section DIB : les bits restent au format de l'application }
Function CreateDIBSection0(Hdc, Bmi, Usage, PBits, HSec, Ofs : LongInt)
  : LongInt;
Var B, W, H, Bpp, Pitch : LongInt;
Begin
  CreateDIBSection0 := 0;
  W := MemL[0:Bmi + 4]; H := MemL[0:Bmi + 8]; Bpp := MemW[0:Bmi + 14];
  B := GdiNew(goBitmap);
  If B < 0 Then Exit;
  Pitch := DibPitch(W, Bpp);
  Gdis^[B].I1 := KAlloc(Pitch * Abs(H) + 16);
  Gdis^[B].I2 := W; Gdis^[B].I3 := Abs(H); Gdis^[B].I4 := Bpp;
  Gdis^[B].I5 := Pitch;
  Gdis^[B].I7 := 1;
  If H < 0 Then Gdis^[B].I7 := Gdis^[B].I7 Or 2;
  If DibIs565(Bmi) Then Gdis^[B].I7 := Gdis^[B].I7 Or $10;
  If Gdis^[B].I1 <> 0 Then FillMem(Gdis^[B].I1, Pitch * Abs(H), 0);
  If Bpp <= 8 Then
  Begin
    Gdis^[B].I6 := KAlloc(1024);
    DibTable(Bmi, Usage, DcOf(Hdc), Gdis^[B].I6);
  End;
  If PBits <> 0 Then MemL[0:PBits] := Gdis^[B].I1;
  CreateDIBSection0 := GdiH(B);
End;

{ CreateDIBSection : en-tete BITMAPCOREHEADER converti }
Function CreateDIBSection(Hdc, Bmi, Usage, PBits, HSec, Ofs : LongInt) :
  LongInt;
Var C : LongInt;
Begin
  C := DibCore(Bmi, Usage);
  CreateDIBSection := CreateDIBSection0(Hdc, C, Usage, PBits, HSec, Ofs);
  If C <> Bmi Then KFree(C);
End;

Function SetDIBColorTable(Hdc, Start, N, Rgbq : LongInt) : LongInt;
Var D, B : LongInt;
Begin
  SetDIBColorTable := 0;
  D := DcOf(Hdc);
  If D < 0 Then Exit;
  B := Dcs[D].Bmp;
  If (B < 0) Or (Gdis^[B].I6 = 0) Then Exit;
  N := Min(N, 256 - Start);
  MoveMem(Rgbq, Gdis^[B].I6 + Start * 4, N * 4);
  SetDIBColorTable := N;
End;

Function GetDIBColorTable(Hdc, Start, N, Rgbq : LongInt) : LongInt;
Var D, B : LongInt;
Begin
  GetDIBColorTable := 0;
  D := DcOf(Hdc);
  If D < 0 Then Exit;
  B := Dcs[D].Bmp;
  If (B < 0) Or (Gdis^[B].I6 = 0) Then Exit;
  N := Min(N, 256 - Start);
  MoveMem(Gdis^[B].I6 + Start * 4, Rgbq, N * 4);
  GetDIBColorTable := N;
End;

{ Bitmap compatible avec un contexte (monochrome si le contexte est un
  contexte memoire avec le bitmap par defaut) }
Function CreateCompatibleBitmap(Hdc, W, H : LongInt) : LongInt;
Var D, B : LongInt; Mono : Boolean;
Begin
  D := DcOf(Hdc);
  Mono := (D >= 0) And (Dcs[D].Wnd < 0) And Not Dcs[D].Screen And
          ((Dcs[D].Bmp < 0) Or (Dcs[D].Bmp = DefBmp));
  B := BmpNew(W, H, ScrFmt, Mono);
  CreateCompatibleBitmap := GdiH(B);
End;

Function CreateDiscardableBitmap(Hdc, W, H : LongInt) : LongInt;
Begin
  CreateDiscardableBitmap := CreateCompatibleBitmap(Hdc, W, H);
End;

{ CreateBitmap : 1 bit (lignes alignees sur 16 bits) ou 8 bits }
{ Bits par point en memoire d'un format (15 occupe 16 bits) }
Function StoreBits(F : LongInt) : LongInt;
Begin
  If F = 15 Then StoreBits := 16 Else StoreBits := F;
End;

{ CreateBitmap : 1 bit (lignes alignees sur 16 bits), 8, 16, 24 ou 32
  bits (16 bits : format de l'ecran, 5-5-5 ou 5-6-5) }
Function CreateBitmap(W, H, Planes, Bpp, Bits : LongInt) : LongInt;
Var B, X, Y, WB, F : LongInt;
Begin
  If Planes > 1 Then Bpp := Bpp * Planes;
  F := Bpp;
  If (F = 16) And (ScrFmt = 15) Then F := 15;
  If (F <> 1) And (F <> 8) And (F <> 15) And (F <> 16) And (F <> 24) And
     (F <> 32) Then F := ScrFmt;
  B := BmpNew(W, H, F, F = 1);
  CreateBitmap := GdiH(B);
  If (B < 0) Or (Bits = 0) Then Exit;
  If F = 1 Then
  Begin
    WB := ((W + 15) Div 16) * 2;
    For Y := 0 To H - 1 Do
      For X := 0 To W - 1 Do
        Mem[0:Gdis^[B].I1 + Y * Gdis^[B].I5 + X] :=
          (Mem[0:Bits + Y * WB + X Div 8] Shr (7 - X Mod 8)) And 1;
  End
  Else
  Begin
    WB := ((W * StoreBits(F) + 15) Div 16) * 2;
    For Y := 0 To H - 1 Do
      MoveMem(Bits + Y * WB, Gdis^[B].I1 + Y * Gdis^[B].I5,
              W * PxBytes(F));
  End;
End;

Function CreateBitmapIndirect(P : LongInt) : LongInt;
Begin
  CreateBitmapIndirect := CreateBitmap(MemL[0:P + 4], MemL[0:P + 8],
                          MemW[0:P + 16], MemW[0:P + 18], MemL[0:P + 20]);
End;

Function GetBitmapBits(H, N, Bits : LongInt) : LongInt;
Var B, Y, X, WB, V, F : LongInt;
Begin
  GetBitmapBits := 0;
  B := GdiOf(H, goBitmap);
  If B < 0 Then Exit;
  If (Gdis^[B].I7 And 4) <> 0 Then
  Begin
    WB := ((Gdis^[B].I2 + 15) Div 16) * 2;
    FillMem(Bits, Min(N, WB * Gdis^[B].I3), 0);
    For Y := 0 To Gdis^[B].I3 - 1 Do
      For X := 0 To Gdis^[B].I2 - 1 Do
        If (Y * WB + X Div 8 < N) And
           (Mem[0:Gdis^[B].I1 + Y * Gdis^[B].I5 + X] <> 0) Then
        Begin
          V := Bits + Y * WB + X Div 8;
          Mem[0:V] := Mem[0:V] Or ($80 Shr (X Mod 8));
        End;
    GetBitmapBits := Min(N, WB * Gdis^[B].I3);
    Exit;
  End;
  F := BmpFmt(B);
  WB := ((Gdis^[B].I2 * StoreBits(F) + 15) Div 16) * 2;
  For Y := 0 To Gdis^[B].I3 - 1 Do
    If (Y + 1) * WB <= N Then
      MoveMem(Gdis^[B].I1 + Y * Gdis^[B].I5, Bits + Y * WB,
              Gdis^[B].I2 * PxBytes(F));
  GetBitmapBits := Min(N, WB * Gdis^[B].I3);
End;

Function SetBitmapBits(H, N, Bits : LongInt) : LongInt;
Var B, Y, X, WB, F : LongInt;
Begin
  SetBitmapBits := 0;
  B := GdiOf(H, goBitmap);
  If B < 0 Then Exit;
  If (Gdis^[B].I7 And 4) <> 0 Then
  Begin
    WB := ((Gdis^[B].I2 + 15) Div 16) * 2;
    For Y := 0 To Gdis^[B].I3 - 1 Do
      For X := 0 To Gdis^[B].I2 - 1 Do
        If Y * WB + X Div 8 < N Then
          Mem[0:Gdis^[B].I1 + Y * Gdis^[B].I5 + X] :=
            (Mem[0:Bits + Y * WB + X Div 8] Shr (7 - X Mod 8)) And 1;
    SetBitmapBits := N;
    Exit;
  End;
  F := BmpFmt(B);
  WB := ((Gdis^[B].I2 * StoreBits(F) + 15) Div 16) * 2;
  For Y := 0 To Gdis^[B].I3 - 1 Do
    If (Y + 1) * WB <= N Then
      MoveMem(Bits + Y * WB, Gdis^[B].I1 + Y * Gdis^[B].I5,
              Gdis^[B].I2 * PxBytes(F));
  SetBitmapBits := N;
End;

{ GetDIBits : bitmap -> DIB (8 bits ; table de couleurs remplie) }
{ Couleur VGA (16 couleurs) la plus proche de 00RRGGBB }
Function Nearest16(X : LongInt) : LongInt;
Var I, D, BD, Best, T : LongInt;
Begin
  Best := 0; BD := $7FFFFFFF;
  For I := 0 To 15 Do
  Begin
    T := VgaRGB[I];
    D := Sqr(((T Shr 16) And 255) - ((X Shr 16) And 255)) +
         Sqr(((T Shr 8) And 255) - ((X Shr 8) And 255)) +
         Sqr((T And 255) - (X And 255));
    If D < BD Then
    Begin
      BD := D; Best := I;
    End;
  End;
  Nearest16 := Best;
End;

{ GetDIBits : bitmap -> DIB de 1, 4, 8, 16 (5-5-5, ou 5-6-5 avec
  BI_BITFIELDS), 24 ou 32 bits ; sans bits par point (0), decrit le
  format du bitmap }
Function GetDIBits(Hdc, H, Start, Lines, Bits, Bmi, Usage : LongInt)
  : LongInt;
Var B, W, Hh, L, X, SY, OB, DP, Row, V, XX, I, F, SA, Tab, N, DW, SPB
    : LongInt;
    S : TSurf; Mono, Top : Boolean;
Begin
  GetDIBits := 0;
  B := GdiOf(H, goBitmap);
  If B < 0 Then Exit;
  W := Gdis^[B].I2; Hh := Gdis^[B].I3;
  F := BmpFmt(B); Mono := (Gdis^[B].I7 And 4) <> 0;
  If MemW[0:Bmi + 14] = 0 Then
  Begin
    If Mono Then OB := 1 Else OB := BmpBits(B);
    MemL[0:Bmi + 4] := W; MemL[0:Bmi + 8] := Hh;
    MemW[0:Bmi + 12] := 1; MemW[0:Bmi + 14] := OB;
    MemL[0:Bmi + 16] := 0;
    If F = 16 Then MemL[0:Bmi + 16] := 3;
    MemL[0:Bmi + 20] := DibPitch(W, OB) * Hh;
    MemL[0:Bmi + 32] := 0;
    GetDIBits := Hh;
    Exit;
  End;
  OB := MemW[0:Bmi + 14];
  DibG6 := (OB = 16) And (MemL[0:Bmi + 16] = 3);
  DW := MemL[0:Bmi + 4];
  Tab := Bmi + MemL[0:Bmi];
  If OB <= 8 Then
  Begin
    For I := 0 To (1 Shl OB) - 1 Do
    Begin
      If OB = 1 Then
      Begin
        If I = 0 Then V := 0 Else V := $FFFFFF;
      End
      Else If OB = 4 Then V := VgaRGB[I]
      Else If (F = 8) And Not Mono And (Gdis^[B].I6 <> 0) Then
        V := MemL[0:Gdis^[B].I6 + I * 4] And $FFFFFF
      Else V := SysX[I];
      MemL[0:Tab + I * 4] := V;
    End;
  End
  Else If DibG6 Then
  Begin
    MemL[0:Tab] := $F800; MemL[0:Tab + 4] := $7E0; MemL[0:Tab + 8] := $1F;
  End
  Else If (OB = 32) And (MemL[0:Bmi + 16] = 3) Then
  Begin
    MemL[0:Tab] := $FF0000; MemL[0:Tab + 4] := $FF00;
    MemL[0:Tab + 8] := $FF;
  End;
  MemL[0:Bmi + 20] := DibPitch(DW, OB) * Abs(MemL[0:Bmi + 8]);
  If Bits = 0 Then
  Begin
    GetDIBits := Hh;
    Exit;
  End;
  If Not BmpSurf(B, S) Then Exit;
  SPB := PxBytes(S.Bpp);
  DP := DibPitch(DW, OB);
  Top := MemL[0:Bmi + 8] < 0;
  N := 0;
  For L := Start To Min(Start + Lines, Hh) - 1 Do
  Begin
    If Top Then SY := L Else SY := Hh - 1 - L;
    SA := S.Bits + SY * S.Pitch;
    Row := Bits + (L - Start) * DP;
    For X := 0 To Min(W, DW) - 1 Do
    Begin
      V := GetRaw(SA + X * SPB, S.Bpp);
      If Mono Then
      Begin
        If V <> 0 Then XX := $FFFFFF Else XX := 0;
      End
      Else XX := SrcX(V, S.Bpp, Gdis^[B].I6);
      Case OB Of
        1 :
        Begin
          If Mono Then I := V
          Else I := Ord(((XX Shr 16) And 255) * 30 + ((XX Shr 8) And 255) *
                        59 + (XX And 255) * 11 >= 12800);
          DibPutRow(Row, 1, X, I);
        End;
        4 : DibPutRow(Row, 4, X, Nearest16(XX));
        8 :
        Begin
          If (S.Bpp = 8) And Not Mono Then I := V
          Else If Mono Then I := V * 255
          Else I := NearestIdx((XX Shr 16) And 255, (XX Shr 8) And 255,
                               XX And 255);
          DibPutRow(Row, 8, X, I);
        End;
      Else
        DibPutRow(Row, OB, X, XX);
      End;
    End;
    Inc(N);
  End;
  GetDIBits := N;
End;

Function SetDIBits0(Hdc, H, Start, Lines, Bits, Bmi, Usage : LongInt)
  : LongInt;
Begin
  SetDIBits0 := SetDIBitsK(GdiOf(H, goBitmap), Start, Lines, Bits, Bmi,
                          Usage, DcOf(Hdc));
End;

