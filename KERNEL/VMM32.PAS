Function LZCopy(HSrc, HDst : LongInt) : LongInt;
Var B, N, T : LongInt;
Begin
  B := KAlloc(16384);
  T := 0;
  Repeat
    If Not KReadFile(HSrc, B, 16384, N) Then N := 0;
    If N > 0 Then
    Begin
      KWriteFile(HDst, B, N);
      T := T + N;
    End;
  Until N <= 0;
  KFree(B);
  LZCopy := T;
End;

