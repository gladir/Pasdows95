      For N := 4 To 7 Do
        If ArgV[N + K] = -32768 Then ArgV[N + K] := LongInt($80000000);
      P := A(1 + K);
      If (ArgRaw[1 + K] Shr 16) = 0 Then P := ArgRaw[1 + K] And $FFFF;
      R := CreateWindowExA(T, P, A(2 + K), A(3 + K), A(4 + K), A(5 + K),
                           A(6 + K), A(7 + K), A(8 + K), A(9 + K),
