{ GetWindow : 0 premiere, 1 derniere, 2 suivante, 3 precedente,
  4 proprietaire, 5 premiere fille }
Function GetWindow(H, Cmd : LongInt) : LongInt;
Var W, I, Best, BS : LongInt;
Begin
  GetWindow := 0;
  W := WndOf(H);
  Case Cmd Of
    4 : If (W >= 0) And Not IsChildW(W) Then
          GetWindow := HwndOf(Wnds^[W].Owner);
    5 :
    Begin
      { premier enfant cree (le haut de l'ordre Z, comme Windows : les
        controles d'un dialogue dans l'ordre du modele) }
      Best := -1; BS := $7FFFFFFF;
      For I := 0 To MaxWnd - 1 Do
        If Wnds^[I].Used And IsChildW(I) And ((Wnds^[I].Parent = W) Or
           ((H = HDesktop) And (W < 0))) And (Wnds^[I].Seq < BS) Then
        Begin
          Best := I; BS := Wnds^[I].Seq;
        End;
      If H = HDesktop Then
      Begin
        If ZCnt > 0 Then Best := ZList[ZCnt - 1];
      End;
      GetWindow := HwndOf(Best);
    End;
    0, 1, 2, 3 :
    Begin
      If W < 0 Then Exit;
      If Not IsChildW(W) Then
      Begin
        For I := 0 To ZCnt - 1 Do
          If ZList[I] = W Then
          Begin
            Case Cmd Of
              0 : GetWindow := HwndOf(ZList[ZCnt - 1]);
              1 : GetWindow := HwndOf(ZList[0]);
              2 : If I > 0 Then GetWindow := HwndOf(ZList[I - 1]);
              3 : If I < ZCnt - 1 Then GetWindow := HwndOf(ZList[I + 1]);
            End;
            Exit;
          End;
        Exit;
      End;
      { freres dans l'ordre de creation : GW_HWNDFIRST (0) le premier,
        GW_HWNDLAST (1) le dernier, GW_HWNDNEXT (2) le suivant,
        GW_HWNDPREV (3) le precedent }
      Best := -1;
      If (Cmd = 1) Or (Cmd = 3) Then BS := -1 Else BS := $7FFFFFFF;
      For I := 0 To MaxWnd - 1 Do
        If Wnds^[I].Used And IsChildW(I) And
           (Wnds^[I].Parent = Wnds^[W].Parent) Then
          If ((Cmd = 0) And (Wnds^[I].Seq < BS)) Or
             ((Cmd = 1) And (Wnds^[I].Seq > BS)) Or
             ((Cmd = 2) And (Wnds^[I].Seq > Wnds^[W].Seq) And
              (Wnds^[I].Seq < BS)) Or
             ((Cmd = 3) And (Wnds^[I].Seq < Wnds^[W].Seq) And
              (Wnds^[I].Seq > BS)) Then
          Begin
            Best := I; BS := Wnds^[I].Seq;
          End;
      GetWindow := HwndOf(Best);
    End;
  End;
End;

