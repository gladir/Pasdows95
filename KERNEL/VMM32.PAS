Procedure KMouse(W, Msg, X, Y : LongInt);
Var I : LongInt;
Begin
  If VmOn And (W = ConW) And (W >= 0) Then
  Begin
    DosMouseIn(Msg, X, Y);
    Exit;
  End;
  If (W >= 0) And (W = ConW) Then
  Begin
    ConMouse(W, Msg, X, Y);
    Exit;
  End;
  If (W >= 0) And (Wnds^[W].IKind = ikConProps) Then
  Begin
    ConPropsMouse(W, Msg, X, Y);
    Exit;
  End;
  If (W >= 0) And (Wnds^[W].IKind = ikMapDrv) Then
  Begin
    MapDrvMouse(W, Msg, X, Y);
    Exit;
  End;
  If W < 0 Then
  Begin
    { bureau }
    If (Msg <> WM_LBUTTONDOWN) And (Msg <> WM_RBUTTONDOWN) Then Exit;
    If MenuDepth > 0 Then CloseMenus(0);
    I := DeskHit(X, Y);
    If Msg = WM_RBUTTONDOWN Then
    Begin
      { menu contextuel du bureau ou de l'icone }
      If I <> DeskSel Then
      Begin
        DeskRedraw(DeskSel);
        DeskSel := I;
        DeskRedraw(I);
      End;
      ActivateW(-1);
      LastClickW := -1;
      { clic hors de la selection multiple : elle est abandonnee }
      If (I < 0) Or Not DeskMul[I] Then DeskClearMul;
      DeskCtxSet;
      If I >= 0 Then OpenMenu(0, mnIcon, X, Y, False)
      Else OpenMenu(0, mnDesk, X, Y, False);
      Exit;
    End;
    If (I >= 0) And (I = LastClickW - 10000) And (Ticks - LastClickT < DblMs)
    Then
    Begin
      LastClickW := -1;
      KCommand(DeskCmd[I]);
      Exit;
    End;
    LastClickW := 10000 + I; LastClickT := Ticks;
    DeskClearMul;
    If I <> DeskSel Then
    Begin
      DeskRedraw(DeskSel);
      DeskSel := I;
      DeskRedraw(I);
    End;
    ActivateW(-1);
    Exit;
  End;
  If (MenuDepth > 0) And (Wnds^[W].IKind <> ikMenu) And
     (Wnds^[W].IKind <> ikVolPop) And (Msg = WM_LBUTTONDOWN) Then
    CloseMenus(0);
  { boites internes : un second clic rapide reste un clic (compteurs,
    curseurs) ; l'arbre du Gestionnaire de peripheriques s'en sert }
  If (Msg = WM_LBUTTONDBLCLK) And (Wnds^[W].IKind >= ikDisplay) And
     (Wnds^[W].IKind <= ikDevProps) And (Wnds^[W].IKind <> ikSysProps) Then
    Msg := WM_LBUTTONDOWN;
  Case Wnds^[W].IKind Of
    ikTaskbar : TaskbarMouse(Msg, X, Y);
    ikMenu : MenuMouse(W, Msg, X, Y);
    ikMsgBox : MsgBoxMouse(W, Msg, X, Y);
    ikExplorer : ExpMouse(W, Msg, X, Y);
    ikAbout, ikRun, ikShutdown : DialogMouse(W, Msg, X, Y);
    ikSecurity : SecMouse(W, Msg, X, Y);
    ikDisplay : DisplayMouse(W, Msg, X, Y);
    ikDateTime : DateTimeMouse(W, Msg, X, Y);
    ikVolPop : VolPopMouse(W, Msg, X, Y);
    ikMixer : MixerMouse(W, Msg, X, Y);
    ikAudio : AudioMouse(W, Msg, X, Y);
    ikSysProps : SysPropsMouse(W, Msg, X, Y);
    ikVolProps : VolPropsMouse(W, Msg, X, Y);
    ikScanDisk : ScanMouse(W, Msg, X, Y);
    ikNotepad : NoteMouse(W, Msg, X, Y);
    ikFileDlg : FileDlgMouse(W, Msg, X, Y);
    ikFind : FindMouse(W, Msg, X, Y);
    ikDevProps : DevPropsMouse(W, Msg, X, Y);
    ikFileProps : FilePropsMouse(W, Msg, X, Y);
  End;
End;

{ ------------------------------------------------------------------ }
{ Console Win32 (programmes du sous-systeme console, Invite DOS)   }
{ ------------------------------------------------------------------ }
{ Une seule console, 80 x 25, dans une fenetre interne (ikConsole) :
  cellules de 7 x 16 pixels (police 8x16 sans sa 8e colonne, comme la
  fenetre MS-DOS de Windows 95 en 640x480). Les touches frappees
  deviennent des evenements KEY_EVENT (ReadConsoleInput) ou une ligne
  (ReadFile/ReadConsole en mode ligne). }

Const
  ConCols = 80; ConRows = 25;
  ConCW = 7; ConChH = 16;
  ConQMax = 1024;                       { touches et texte colle }
  ConSbW = 16;                          { barre de defilement }
  { couleurs de la console (ordre des attributs : bit 0 bleu, 1 vert,
    2 rouge, 3 intensite) }
  ConRGB : Array[0..15] Of LongInt = (
    $000000, $000080, $008000, $008080, $800000, $800080, $808000,
    $C0C0C0, $808080, $0000FF, $00FF00, $00FFFF, $FF0000, $FF00FF,
    $FFFF00, $FFFFFF);

Var
  ConW : LongInt;                        { fenetre (-1 : aucune) }
  ConCh, ConAt : Array[0..ConCols * ConRows - 1] Of Byte;
  ConX, ConY, ConAttr : LongInt;
  ConInMode : LongInt;                   { modes de l'entree standard }
  ConCurVis : Boolean;
  ConFull : Boolean;                     { tout repeindre }
  ConDLo, ConDHi : LongInt;              { lignes a repeindre }
  ConRowsDue : Boolean;                  { lignes a repeindre seules }
  ConPR0, ConPR1 : LongInt;              { lignes repeintes }
  ConPal : Array[0..15] Of LongInt;      { couleurs -> indices systeme }
  ConPalVer : LongInt;                   { PalVer de ConPal (-1 : a faire) }
  ConLastCY : LongInt;                   { ligne du curseur dessine }
  ConQVk, ConQCh : Array[0..ConQMax - 1] Of Byte;
  ConQCtl : Array[0..ConQMax - 1] Of LongInt;
  ConQHead, ConQLen : LongInt;
  ConPend : String;                      { reste d'une ligne lue }
  ConKeep : Boolean;                     { garder la console a la fin du
                                           programme (retour a l'Invite) }
  ConKillReq : Boolean;                  { fenetre fermee : arreter le
                                           programme (tache 0) }
  ConTitle : String[79];
  { lignes retenues (sorties par le haut de l'ecran) : anneau de
    ConHistMax lignes de 80 caracteres puis 80 attributs ; ConView :
    lignes remontees dans l'affichage (0 : ecran courant) }
  ConHist, ConHistMax, ConHistN, ConHistPos, ConView : LongInt;
  { journal : les lignes retenues sont aussi ecrites dans un fichier }
  ConLogOn : Boolean;
  ConLogPath : String[79];
  ConLogBuf, ConLogLen : LongInt;
  { programme lance depuis l'Invite (CreateProcessA), puis retour }
  ChainExec, ChainArgs, ChainRet, ChainRetArgs, ChainDir : String;
  ChainObj : LongInt;

{ Mot signe 16 bits (SMALL_RECT, COORD) }
Function ConS16(V : LongInt) : LongInt;
Begin
  V := V And $FFFF;
  If V >= $8000 Then V := V - $10000;
  ConS16 := V;
End;

Procedure ConDirty(R : LongInt);
Begin
  If R < ConDLo Then ConDLo := R;
  If R > ConDHi Then ConDHi := R;
  ConRowsDue := True;
End;

Procedure ConClear;
Var I : LongInt;
Begin
  For I := 0 To ConCols * ConRows - 1 Do
  Begin
    ConCh[I] := 32; ConAt[I] := ConAttr;
  End;
  ConX := 0; ConY := 0;
  ConFull := True;
  ConRowsDue := True;
End;

Procedure ConEnsure;
Var X1, Y1, X2, Y2, DW, DH : LongInt;
Begin
  If ConW >= 0 Then Exit;
  ConAttr := 7; ConInMode := 7; ConCurVis := True;
  ConQHead := 0; ConQLen := 0; ConPend := '';
  ConView := 0; ConSelOn := False; ConMark := False;
  If ConHistMax <= 0 Then ConHistMax := 1000;
  If ConLogPath = '' Then ConLogPath := 'C:\WINDOWS\CONSOLE.LOG';
  ConDLo := 0; ConDHi := ConRows - 1;
  If ConTitle = '' Then
    ConTitle := PromptName;
  ConW := KCreate(ikConsole, ConTitle, icDos, 24, 16, 600, 440,
                  WS_OVERLAPPED Or WS_CAPTION Or WS_SYSMENU Or
                  WS_MINIMIZEBOX, 0);
  If ConW < 0 Then Exit;
  { zone cliente exacte : 80 x 25 cellules }
  KClient(ConW, X1, Y1, X2, Y2);
  DW := ConCols * ConCW + ConSbW - (X2 - X1 + 1);
  DH := ConRows * ConChH - (Y2 - Y1 + 1);
  If (DW <> 0) Or (DH <> 0) Then
    MoveW(ConW, Wnds^[ConW].X, Wnds^[ConW].Y, Wnds^[ConW].W + DW,
          Wnds^[ConW].H + DH, False);
  ConClear;
  ShowW(ConW, True, True);
End;

Procedure ConLogFlush;
Var H : LongInt;
Begin
  If (ConLogLen = 0) Or (ConLogBuf = 0) Then Exit;
  If ConLogOn And (ConLogPath <> '') Then
  Begin
    H := KOpenFile(ConLogPath, True, 4);
    If H <> -1 Then
    Begin
      SetFilePointer(H, 0, 0, 2);
      KWriteFile(H, ConLogBuf, ConLogLen);
      CloseHandle(H);
    End;
  End;
  ConLogLen := 0;
End;

{ Ligne R de l'ecran (texte sans les espaces de fin) }
Function ConRowText(R : LongInt) : String;
Var S : String; I : LongInt;
Begin
  S := '';
  For I := 0 To ConCols - 1 Do S := S + Chr(ConCh[R * ConCols + I]);
  While (S <> '') And (S[Length(S)] = ' ') Do Delete(S, Length(S), 1);
  ConRowText := S;
End;

{ La premiere ligne de l'ecran va dans les lignes retenues (et le
  journal) }
Procedure ConHistPush;
Var A, Own : LongInt; S : String;
Begin
  If ConHistMax <= 0 Then Exit;
  If ConHist = 0 Then
  Begin
    Own := HeapOwner; HeapOwner := 0;
    ConHist := KAlloc(ConHistMax * ConCols * 2);
    HeapOwner := Own;
    If ConHist = 0 Then Exit;
  End;
  A := ConHist + ConHistPos * ConCols * 2;
  MoveMem(LongInt(@ConCh), A, ConCols);
  MoveMem(LongInt(@ConAt), A + ConCols, ConCols);
  ConHistPos := (ConHistPos + 1) Mod ConHistMax;
  If ConHistN < ConHistMax Then Inc(ConHistN);
  { l'affichage remonte reste sur les memes lignes }
  If ConView > 0 Then ConView := Min(ConView + 1, ConHistN);
  If ConLogOn Then
  Begin
    If ConLogBuf = 0 Then
    Begin
      Own := HeapOwner; HeapOwner := 0;
      ConLogBuf := KAlloc(4096);
      HeapOwner := Own;
    End;
    If ConLogBuf <> 0 Then
    Begin
      S := ConRowText(0) + #13#10;
      If ConLogLen + Length(S) > 4000 Then ConLogFlush;
      MoveMem(LongInt(@S[1]), ConLogBuf + ConLogLen, Length(S));
      ConLogLen := ConLogLen + Length(S);
    End;
  End;
End;

Procedure ConScrollUp;
Var I : LongInt;
Begin
  ConHistPush;
  MoveMem(LongInt(@ConCh) + ConCols, LongInt(@ConCh),
          ConCols * (ConRows - 1));
  MoveMem(LongInt(@ConAt) + ConCols, LongInt(@ConAt),
          ConCols * (ConRows - 1));
  For I := ConCols * (ConRows - 1) To ConCols * ConRows - 1 Do
  Begin
    ConCh[I] := 32; ConAt[I] := ConAttr;
  End;
  ConFull := True;
  ConRowsDue := True;
End;

Procedure ConNewLine;
Begin
  ConDirty(ConY);
  ConX := 0;
  Inc(ConY);
  If ConY >= ConRows Then
  Begin
    ConScrollUp;
    ConY := ConRows - 1;
  End;
  ConDirty(ConY);
End;

{ Un caractere (sortie traitee : CR, LF, BS, TAB, BEL) }
Procedure ConPutC(C : LongInt);
Begin
  Case C Of
    7 : ;
    8 :
      If ConX > 0 Then
      Begin
        Dec(ConX); ConDirty(ConY);
      End;
    9 :
      Repeat
        ConCh[ConY * ConCols + ConX] := 32;
        ConAt[ConY * ConCols + ConX] := ConAttr;
        Inc(ConX);
        If ConX >= ConCols Then ConNewLine;
      Until (ConX Mod 8) = 0;
    10 : ConNewLine;
    13 :
      Begin
        ConX := 0; ConDirty(ConY);
      End;
  Else
    ConCh[ConY * ConCols + ConX] := C And 255;
    ConAt[ConY * ConCols + ConX] := ConAttr;
    ConDirty(ConY);
    Inc(ConX);
    If ConX >= ConCols Then ConNewLine;
  End;
End;

Procedure ConWrite(Buf, N : LongInt);
Var I : LongInt;
Begin
  ConEnsure;
  For I := 0 To N - 1 Do ConPutC(Mem[0:Buf + I]);
End;

Procedure ConWriteS(Const S : String);
Var I : LongInt;
Begin
  For I := 1 To Length(S) Do ConPutC(Ord(S[I]));
End;

{ Une cellule de la console : 16 lignes de 7 pixels (police 8x16 sans
  sa 8e colonne), couleur Fg sur Bg, en A (surface de pas Pitch). En
  assembleur : la version Pascal (112 tests et ecritures par cellule)
  prenait pres de 300 ms pour un ecran sous l'emulateur de DEVENV, et le
  programme console attendait pendant ce temps (DIR, echo du clavier). }
{ Case de 8x16 points en couleurs vraies (valeurs brutes Fg, Bg) }
Procedure ConCellX(A, F, Pitch, Fg, Bg, Bpp : LongInt);
Var R, X, B, PB : LongInt;
Begin
  PB := PxBytes(Bpp);
  For R := 0 To 15 Do
  Begin
    B := Mem[0:F + R];
    For X := 0 To 7 Do
      If (B And ($80 Shr X)) <> 0 Then PutRaw(A + X * PB, Fg, Bpp)
      Else PutRaw(A + X * PB, Bg, Bpp);
    A := A + Pitch;
  End;
End;

Procedure ConCell(A, F, Pitch, Fg, Bg : LongInt);
Begin
  asm
    push esi
    push edi
    push ebx
    mov eax,Pitch
    sub eax,7
    push eax
    mov edi,A
    mov esi,F
    mov edx,Fg
    mov eax,Bg
    mov dh,al
    mov ecx,16
  @row:
    mov bl,[esi]
    inc esi
    mov al,dh
    test bl,80h
    jz @p1
    mov al,dl
  @p1:
    mov [edi],al
    mov al,dh
    test bl,40h
    jz @p2
    mov al,dl
  @p2:
    mov [edi+1],al
    mov al,dh
    test bl,20h
    jz @p3
    mov al,dl
  @p3:
    mov [edi+2],al
    mov al,dh
    test bl,10h
    jz @p4
    mov al,dl
  @p4:
    mov [edi+3],al
    mov al,dh
    test bl,8
    jz @p5
    mov al,dl
  @p5:
    mov [edi+4],al
    mov al,dh
    test bl,4
    jz @p6
    mov al,dl
  @p6:
    mov [edi+5],al
    mov al,dh
    test bl,2
    jz @p7
    mov al,dl
  @p7:
    mov [edi+6],al
    add edi,7
    add edi,[esp]
    dec ecx
    jnz @row
    pop eax
    pop ebx
    pop edi
    pop esi
  end;
End;

{ Caractere et attribut affiches en (R, C), compte tenu des lignes
  remontees (ConView) }
Procedure ConCellAt(R, C : LongInt; Var Ch, At : LongInt);
Var L, H, A : LongInt;
Begin
  L := R - ConView;
  If L >= 0 Then
  Begin
    Ch := ConCh[L * ConCols + C]; At := ConAt[L * ConCols + C];
    Exit;
  End;
  H := ConHistN + L;
  If (H < 0) Or (ConHist = 0) Then
  Begin
    Ch := 32; At := 7;
    Exit;
  End;
  A := ConHist + ((ConHistPos - ConHistN + H + ConHistMax) Mod ConHistMax) *
       ConCols * 2;
  Ch := Mem[0:A + C]; At := Mem[0:A + ConCols + C];
End;

Function ConInSel(R, C : LongInt) : Boolean;
Begin
  ConInSel := ConSelOn And (R >= Min(ConSR0, ConSR1)) And
              (R <= Max(ConSR0, ConSR1)) And (C >= Min(ConSC0, ConSC1)) And
              (C <= Max(ConSC0, ConSC1));
End;

{ Barre de defilement des lignes retenues (a droite de la console) }
Procedure ConPaintSb(W : LongInt);
Var X1, Y1, X2, Y2, SX, TH, T, N, Y : LongInt;
Begin
  KClient(W, X1, Y1, X2, Y2);
  SX := X1 + ConCols * ConCW;
  If SX + ConSbW - 1 > X2 Then Exit;
  FBar(SX, Y1, X2, Y2, cSilver);
  Raised(SX, Y1, X2, Y1 + 15, False);
  Arrow(SX + 4, Y1 + 5, 2, cBlack);
  Raised(SX, Y2 - 15, X2, Y2, False);
  Arrow(SX + 4, Y2 - 9, 1, cBlack);
  N := ConHistN;
  If N = 0 Then Exit;
  TH := Max(12, ((Y2 - Y1 - 32) * ConRows) Div (N + ConRows));
  T := (Y2 - Y1 - 32 - TH);
  Y := Y1 + 16 + (T * (N - ConView)) Div N;
  Raised(SX, Y, X2, Y + TH - 1, False);
End;

Procedure PaintConsole(W : LongInt);
Var X1, Y1, X2, Y2, R, C, I, A, P, F, Fg, Bg, R0, R1, NC, NR, Ch, At
    : LongInt;
Begin
  KClient(W, X1, Y1, X2, Y2);
  NC := Min(ConCols, (X2 - X1 + 1) Div ConCW);
  NR := Min(ConRows, (Y2 - Y1 + 1) Div ConChH);
  If ConPalVer <> PalVer Then
  Begin
    For I := 0 To 15 Do
      ConPal[I] := NearestIdx((ConRGB[I] Shr 16) And 255,
                              (ConRGB[I] Shr 8) And 255, ConRGB[I] And 255);
    ConPalVer := PalVer;
  End;
  If ConFull Then
  Begin
    FBar(X1, Y1, X2, Y2, ConPal[0]);
    R0 := 0; R1 := NR - 1;
  End
  Else
  Begin
    If (ConLastCY >= 0) And (ConLastCY < ConDLo) Then ConDLo := ConLastCY;
    If ConLastCY > ConDHi Then ConDHi := ConLastCY;
    R0 := Max(ConDLo, 0); R1 := Min(ConDHi, NR - 1);
  End;
  ConFull := False; ConRowsDue := False;
  ConDLo := ConRows; ConDHi := -1;
  ConPR0 := R0; ConPR1 := R1;
  ConLastCY := ConY;
  If (ConView > 0) Or ConSelOn Then
  Begin
    R0 := 0; R1 := NR - 1;
  End;
  If (R0 = 0) And (R1 = NR - 1) Then ConPaintSb(W);
  For R := R0 To R1 Do
    For C := 0 To NC - 1 Do
    Begin
      ConCellAt(R, C, Ch, At);
      Fg := ConPal[At And 15]; Bg := ConPal[(At Shr 4) And 15];
      If ConInSel(R, C) Then
      Begin
        I := Fg; Fg := Bg; Bg := I;
      End;
      F := FontAddr + Ch * 16;
      A := DS.Bits + (Y1 + R * ConChH - DOY) * DS.Pitch +
           (X1 + C * ConCW - DOX) * PxBytes(DS.Bpp);
      If DS.Bpp = 8 Then ConCell(A, F, DS.Pitch, Fg, Bg)
      Else ConCellX(A, F, DS.Pitch, RawOf(Fg, DS.Bpp), RawOf(Bg, DS.Bpp),
                    DS.Bpp);
      { curseur : soulignement, fenetre active seulement }
      If ConCurVis And (R = ConY) And (C = ConX) And (W = ActiveWin) And
         (ConView = 0) Then
      Begin
        P := A + 13 * DS.Pitch;
        FillRaw(P, ConCW, RawOf(Fg, DS.Bpp), DS.Bpp);
        FillRaw(P + DS.Pitch, ConCW, RawOf(Fg, DS.Bpp), DS.Bpp);
      End;
    End;
End;

{ Touche frappee dans la fenetre de la console }
{ Titre de la console (Marquer - ... en mode Marquer) }
Procedure ConSetTitle;
Begin
  If ConW < 0 Then Exit;
  If ConMark Then
    Wnds^[ConW].Text := L('Marquer - ', 'Mark - ', 'Markieren - ',
                          'Seleziona - ', 'Marcar - ') + ConTitle
  Else Wnds^[ConW].Text := ConTitle;
  Wnds^[ConW].NeedNc := True;
  TaskbarChanged;
End;

{ Remonte (D > 0) ou redescend l'affichage dans les lignes retenues }
Procedure ConScrollView(D : LongInt);
Begin
  ConView := ConView + D;
  If ConView > ConHistN Then ConView := ConHistN;
  If ConView < 0 Then ConView := 0;
  ConFull := True;
  If ConW >= 0 Then KRepaint(ConW);
End;

Procedure ConKeyIn(VK, Ch : LongInt);
Var I, Ctl : LongInt;
Begin
  { mode Marquer : Entree copie, Echap annule }
  If ConMark Then
  Begin
    If VK = $0D Then KCommand(cmConCopy);
    If (VK = $0D) Or (VK = $1B) Then
    Begin
      ConMark := False; ConSelOn := False;
      ConSetTitle;
      ConFull := True;
      If ConW >= 0 Then KRepaint(ConW);
    End;
    Exit;
  End;
  { Maj+Page precedente / suivante : lignes retenues }
  If ((KeyState[$10] And $80) <> 0) And ((VK = $21) Or (VK = $22)) Then
  Begin
    If VK = $21 Then ConScrollView(ConRows - 1)
    Else ConScrollView(-(ConRows - 1));
    Exit;
  End;
  If (ConView > 0) Or ConSelOn Then
  Begin
    ConView := 0; ConSelOn := False;
    ConFull := True;
    If ConW >= 0 Then KRepaint(ConW);
  End;
  If ConQLen >= ConQMax Then Exit;
  Ctl := 0;
  If (KeyState[$10] And $80) <> 0 Then Ctl := Ctl Or $10;
  If (KeyState[$11] And $80) <> 0 Then Ctl := Ctl Or $08;
  If (KeyState[$12] And $80) <> 0 Then Ctl := Ctl Or $02;
  { Ctrl+lettre : caractere de controle, comme Windows }
  If ((Ctl And $08) <> 0) And (VK >= $41) And (VK <= $5A) Then
    Ch := VK - $40;
  { ENHANCED_KEY, et le code de balayage (wVirtualScanCode) range dans
    les bits 16-23, inutilises par dwControlKeyState (voir ConPutRec) :
    ReadKey en a besoin pour les fleches et les touches de fonction }
  If KeyExt Then Ctl := Ctl Or $100;
  Ctl := Ctl Or ((KeyScan And 255) Shl 16);
  I := (ConQHead + ConQLen) Mod ConQMax;
  ConQVk[I] := VK; ConQCh[I] := Ch And 255; ConQCtl[I] := Ctl;
  Inc(ConQLen);
End;


{ ------------------------------------------------------------------ }
{ Invite DOS : selection, menus Modifier et Proprietes             }
{ ------------------------------------------------------------------ }

Procedure ConMouse(W, Msg, X, Y : LongInt);
Var X1, Y1, X2, Y2, R, C, TH, TY, N : LongInt;
Begin
  KClient(W, X1, Y1, X2, Y2);
  { barre de defilement des lignes retenues }
  If X >= ConCols * ConCW Then
  Begin
    If (Msg <> WM_LBUTTONDOWN) And (Msg <> WM_LBUTTONDBLCLK) Then Exit;
    If Y < 16 Then ConScrollView(1)
    Else If Y > Y2 - Y1 - 16 Then ConScrollView(-1)
    Else
    Begin
      N := Max(1, ConHistN);
      TH := Max(12, ((Y2 - Y1 - 32) * ConRows) Div (N + ConRows));
      TY := 16 + ((Y2 - Y1 - 32 - TH) * (N - ConView)) Div N;
      If Y < TY Then ConScrollView(ConRows - 1)
      Else If Y > TY + TH Then ConScrollView(-(ConRows - 1));
    End;
    Exit;
  End;
  R := Max(0, Min(ConRows - 1, Y Div ConChH));
  C := Max(0, Min(ConCols - 1, X Div ConCW));
  Case Msg Of
    WM_LBUTTONDOWN, WM_LBUTTONDBLCLK :
    Begin
      ConSR0 := R; ConSC0 := C; ConSR1 := R; ConSC1 := C;
      ConSelOn := True; ConSelDrag := True;
      CaptureWin := W;
      ConFull := True;
      KRepaint(W);
    End;
    WM_MOUSEMOVE :
      If ConSelDrag And ((R <> ConSR1) Or (C <> ConSC1)) Then
      Begin
        ConSR1 := R; ConSC1 := C;
        ConFull := True;
        KRepaint(W);
      End;
    WM_LBUTTONUP :
      If ConSelDrag Then
      Begin
        ConSelDrag := False;
        CaptureWin := -1;
        { simple clic : pas de selection }
        If (ConSR0 = ConSR1) And (ConSC0 = ConSC1) And Not ConMark Then
          ConSelOn := False;
        ConFull := True;
        KRepaint(W);
      End;
    WM_RBUTTONDOWN :
    Begin
      SysMenuW := W;
      CloseMenus(0);
      OpenMenu(0, mnConEdit, CurX, CurY, False);
    End;
  End;
End;

{ Texte des lignes affichees R0..R1, colonnes C0..C1 (CR LF entre les
  lignes, sans les espaces de fin) }
Function ConGrab(R0, R1, C0, C1, Dst : LongInt) : LongInt;
Var R, C, K, E, Ch, At : LongInt;
Begin
  K := 0;
  For R := R0 To R1 Do
  Begin
    E := K;
    For C := C0 To C1 Do
    Begin
      ConCellAt(R, C, Ch, At);
      If Ch = 0 Then Ch := 32;
      Mem[0:Dst + K] := Ch;
      Inc(K);
      If Ch <> 32 Then E := K;
    End;
    K := E;
    If R < R1 Then
    Begin
      Mem[0:Dst + K] := 13; Mem[0:Dst + K + 1] := 10;
      K := K + 2;
    End;
  End;
  ConGrab := K;
End;

Procedure ConCopy;
Var Own : LongInt;
Begin
  If Not ConSelOn Then Exit;
  If ClipBuf <> 0 Then KFree(ClipBuf);
  Own := HeapOwner; HeapOwner := 0;
  ClipBuf := KAlloc(ConRows * (ConCols + 2) + 16);
  HeapOwner := Own;
  ClipLen := 0; ClipFN := 0;
  If ClipBuf = 0 Then Exit;
  ClipLen := ConGrab(Min(ConSR0, ConSR1), Max(ConSR0, ConSR1),
                     Min(ConSC0, ConSC1), Max(ConSC0, ConSC1), ClipBuf);
  Mem[0:ClipBuf + ClipLen] := 0;
End;

{ Enregistre les lignes retenues et l'ecran dans le fichier P }
Procedure ConSaveTo(Const P : String);
Var H, B, I, K, A, Own, Last : LongInt; S : String;
Begin
  H := KOpenFile(P, True, 2);
  If H = -1 Then
  Begin
    MsgBoxOpen(ConTitle, L('Impossible d''enregistrer ', 'Cannot save ',
               'Speichern nicht m'#148'glich: ', 'Impossibile salvare ',
               'No se puede guardar ') + P, $10);
    Exit;
  End;
  Own := HeapOwner; HeapOwner := 0;
  B := KAlloc(4096);
  HeapOwner := Own;
  K := 0;
  For I := 0 To ConHistN - 1 Do
  Begin
    A := ConHist + ((ConHistPos - ConHistN + I + ConHistMax) Mod
         ConHistMax) * ConCols * 2;
    S[0] := Chr(ConCols);
    MoveMem(A, LongInt(@S[1]), ConCols);
    While (S <> '') And ((S[Length(S)] = ' ') Or (S[Length(S)] = #0)) Do
      Delete(S, Length(S), 1);
    S := S + #13#10;
    If K + Length(S) > 4000 Then
    Begin
      KWriteFile(H, B, K);
      K := 0;
    End;
    MoveMem(LongInt(@S[1]), B + K, Length(S));
    K := K + Length(S);
  End;
  { ecran : jusqu'a la derniere ligne non vide (ou le curseur) }
  Last := ConY;
  For I := 0 To ConRows - 1 Do If ConRowText(I) <> '' Then Last := Max(Last, I);
  For I := 0 To Last Do
  Begin
    S := ConRowText(I) + #13#10;
    If K + Length(S) > 4000 Then
    Begin
      KWriteFile(H, B, K);
      K := 0;
    End;
    MoveMem(LongInt(@S[1]), B + K, Length(S));
    K := K + Length(S);
  End;
  If K > 0 Then KWriteFile(H, B, K);
  CloseHandle(H);
  KFree(B);
End;

Procedure ConPropsOpen;
Begin
  If (ConPropW >= 0) And Wnds^[ConPropW].Used And
     (Wnds^[ConPropW].IKind = ikConProps) Then
  Begin
    ActivateW(ConPropW);
    Exit;
  End;
  ConPropW := KCreate(ikConProps, L('Propri'#130't'#130's de ', 'Properties ' +
                      'of ', 'Eigenschaften von ', 'Propriet'#133' di ',
                      'Propiedades de ') + PromptName, icDos,
                      Max(0, (ScrW - 470) Div 2), Max(0, (TaskY - 260) Div 2),
                      470, 260, WS_POPUP Or WS_CAPTION Or WS_SYSMENU,
                      WS_EX_DLGMODALFRAME);
  If ConPropW < 0 Then Exit;
  { K1 champ actif (1 lignes, 2 fichier), K2 journal, KS lignes ; le
    chemin du journal est dans KS2 (ConPPath) }
  Wnds^[ConPropW].K1 := 1;
  Wnds^[ConPropW].K2 := Ord(ConLogOn);
  Wnds^[ConPropW].KS := IntStr(ConHistMax);
  ConPPath := ConLogPath;
  ShowW(ConPropW, True, True);
End;

{ Colle le presse-papiers dans l'entree de la console }
Procedure ConPasteClip;
Var I, C : LongInt;
Begin
  For I := 0 To ClipLen - 1 Do
  Begin
    C := Mem[0:ClipBuf + I];
    If C = 13 Then ConKeyIn($0D, 13)
    Else If (C >= 32) Or (C = 9) Then ConKeyIn(0, C);
  End;
End;

Procedure ConCommand(Cmd : LongInt);
Begin
  If ConW < 0 Then Exit;
  Case Cmd Of
    cmConMark :
    Begin
      ConMark := True; ConSelOn := False;
      ConSetTitle;
    End;
    cmConCopy :
    Begin
      ConCopy;
      ConMark := False; ConSelOn := False;
      ConSetTitle;
    End;
    cmConPaste :
    Begin
      ConMark := False; ConSelOn := False;
      ConPasteClip;
    End;
    cmConSelAll :
    Begin
      ConSR0 := 0; ConSC0 := 0; ConSR1 := ConRows - 1;
      ConSC1 := ConCols - 1;
      ConSelOn := True; ConMark := True;
      ConSetTitle;
    End;
    cmConSave : FdOpen(1, 2, 'C:\WINDOWS', 'CONSOLE.TXT');
    cmConProps : ConPropsOpen;
  End;
  ConFull := True;
  KRepaint(ConW);
End;

{ Champs de la boite Proprietes }
Procedure CpField(W, I : LongInt; Var X1, Y1, X2, Y2 : LongInt);
Var CX1, CY1, CX2, CY2 : LongInt;
Begin
  KClient(W, CX1, CY1, CX2, CY2);
  If I = 1 Then
  Begin
    X1 := CX2 - 104; Y1 := CY1 + 34; X2 := CX2 - 28; Y2 := CY1 + 54;
  End
  Else
  Begin
    X1 := CX1 + 28; Y1 := CY1 + 140; X2 := CX2 - 28; Y2 := CY1 + 160;
  End;
End;

Procedure PaintConProps(W : LongInt);
Var X1, Y1, X2, Y2, FX1, FY1, FX2, FY2, I, BX1, BY1, BX2, BY2 : LongInt;
    T : String;
Begin
  KClient(W, X1, Y1, X2, Y2);
  FBar(X1, Y1, X2, Y2, cSilver);
  GroupBox(X1 + 12, Y1 + 12, X2 - 12, Y1 + 84, L('M'#130'moire tampon de ' +
           'l''affichage', 'Screen buffer', 'Bildschirmpuffer',
           'Buffer dello schermo', 'B'#163'fer de pantalla'));
  OutTxt(X1 + 24, Y1 + 37, L('Nombre de lignes retenues :',
         'Lines kept:', 'Gespeicherte Zeilen:', 'Righe conservate:',
         'L'#161'neas guardadas:'), cBlack);
  OutTxt(X1 + 24, Y1 + 60, L('(de 25 '#133' 32000, barre de d'#130'filement)',
         '(25 to 32000, scroll bar)', '(25 bis 32000)', '(da 25 a 32000)',
         '(de 25 a 32000)'), cGray);
  GroupBox(X1 + 12, Y1 + 96, X2 - 12, Y1 + 176, L('Journal', 'Log',
           'Protokoll', 'Registro', 'Registro'));
  CheckBox(X1 + 24, Y1 + 114, L('Enregistrer aussi les lignes dans le ' +
           'fichier :', 'Also save the lines to the file:', 'Zeilen ' +
           'auch in Datei speichern:', 'Salva le righe nel file:',
           'Guardar las l'#161'neas en el archivo:'), Wnds^[W].K2 <> 0);
  For I := 1 To 2 Do
  Begin
    CpField(W, I, FX1, FY1, FX2, FY2);
    Sunken(FX1, FY1, FX2, FY2, cWhite);
    If I = 1 Then T := Wnds^[W].KS Else T := ConPPath;
    T := Fit(T, FX2 - FX1 - 8);
    OutTxt(FX1 + 4, FY1 + 3, T, cBlack);
    If Wnds^[W].K1 = I Then
      VLine(FX1 + 5 + TextW(T), FY1 + 3, FY2 - 3, cBlack);
  End;
  For I := 0 To 1 Do
  Begin
    DlgBtnRect(W, I, 2, BX1, BY1, BX2, BY2);
    If I = 0 Then T := TxtOk Else T := TxtCancel;
    PushButton(BX1, BY1, BX2, BY2, T, (PressWin = W) And (PressBtn = I),
               I = 0);
  End;
End;

{ OK : nouveau nombre de lignes (les dernieres sont gardees) et journal }
Procedure ConPropsApply(W : LongInt);
Var N, C, K, I, NB, Own : LongInt;
Begin
  Val(Wnds^[W].KS, N, C);
  If (C <> 0) Or (N < 25) Then N := 25;
  If N > 32000 Then N := 32000;
  If N <> ConHistMax Then
  Begin
    Own := HeapOwner; HeapOwner := 0;
    NB := KAlloc(N * ConCols * 2);
    HeapOwner := Own;
    If NB <> 0 Then
    Begin
      K := Min(N, ConHistN);
      For I := 0 To K - 1 Do
        MoveMem(ConHist + ((ConHistPos - K + I + ConHistMax) Mod
                ConHistMax) * ConCols * 2, NB + I * ConCols * 2,
                ConCols * 2);
      If ConHist <> 0 Then KFree(ConHist);
      ConHist := NB;
      ConHistMax := N; ConHistN := K; ConHistPos := K Mod N;
      ConView := 0;
    End;
  End;
  ConLogFlush;
  ConLogOn := Wnds^[W].K2 <> 0;
  If ConPPath <> '' Then ConLogPath := ConPPath;
  ConFull := True;
  If ConW >= 0 Then KRepaint(ConW);
End;

Procedure ConPropsClose(W : LongInt);
Begin
  If ConPropW = W Then ConPropW := -1;
  DestroyW(W);
End;

Procedure ConPropsMouse(W, Msg, X, Y : LongInt);
Var I, BX1, BY1, BX2, BY2, X1, Y1, X2, Y2 : LongInt;
Begin
  X := X + Wnds^[W].X + Wnds^[W].CL; Y := Y + Wnds^[W].Y + Wnds^[W].CT;
  KClient(W, X1, Y1, X2, Y2);
  If Msg = WM_LBUTTONDBLCLK Then Msg := WM_LBUTTONDOWN;
  If Msg = WM_LBUTTONDOWN Then
  Begin
    For I := 1 To 2 Do
    Begin
      CpField(W, I, BX1, BY1, BX2, BY2);
      If InRect(X, Y, BX1, BY1, BX2, BY2) Then
      Begin
        Wnds^[W].K1 := I;
        KRepaint(W);
        Exit;
      End;
    End;
    If InRect(X, Y, X1 + 22, Y1 + 110, X2 - 24, Y1 + 130) Then
    Begin
      Wnds^[W].K2 := 1 - Wnds^[W].K2;
      KRepaint(W);
      Exit;
    End;
  End;
  For I := 0 To 1 Do
  Begin
    DlgBtnRect(W, I, 2, BX1, BY1, BX2, BY2);
    If InRect(X, Y, BX1, BY1, BX2, BY2) Then
    Begin
      If Msg = WM_LBUTTONDOWN Then
      Begin
        PressWin := W; PressBtn := I; CaptureWin := W;
        KRepaint(W);
      End
      Else If (Msg = WM_LBUTTONUP) And (PressWin = W) And (PressBtn = I)
      Then
      Begin
        PressWin := -1; CaptureWin := -1;
        If I = 0 Then ConPropsApply(W);
        ConPropsClose(W);
      End;
      Exit;
    End;
  End;
  If Msg = WM_LBUTTONUP Then
  Begin
    If PressWin = W Then
    Begin
      PressWin := -1;
      KRepaint(W);
    End;
    CaptureWin := -1;
  End;
End;

Procedure ConPropsKey(W, VK, Ch : LongInt);
Var S : String;
Begin
  Case VK Of
    $1B :
    Begin
      ConPropsClose(W);
      Exit;
    End;
    $0D :
    Begin
      ConPropsApply(W);
      ConPropsClose(W);
      Exit;
    End;
    $09 :
    Begin
      Wnds^[W].K1 := 3 - Wnds^[W].K1;
      KRepaint(W);
      Exit;
    End;
  End;
  If Wnds^[W].K1 = 1 Then S := Wnds^[W].KS Else S := ConPPath;
  If VK = 8 Then
  Begin
    If S <> '' Then Delete(S, Length(S), 1);
  End
  Else If Wnds^[W].K1 = 1 Then
  Begin
    If (Ch >= 48) And (Ch <= 57) And (Length(S) < 5) Then S := S + Chr(Ch);
  End
  Else If (Ch >= 32) And (Ch < 256) And (Length(S) < 79) Then
    S := S + UpCase(Chr(Ch));
  If Wnds^[W].K1 = 1 Then Wnds^[W].KS := S Else ConPPath := S;
  KRepaint(W);
End;

Procedure ConQPop(Var VK, Ch, Ctl : LongInt);
Begin
  VK := ConQVk[ConQHead]; Ch := ConQCh[ConQHead]; Ctl := ConQCtl[ConQHead];
  ConQHead := (ConQHead + 1) Mod ConQMax;
  Dec(ConQLen);
End;

{ Bouton par defaut (BS_DEFPUSHBUTTON) ou d'annulation (IDCANCEL)
  d'une fenetre de premier niveau ; -1 si aucun }
Function DefBtnOf(T : LongInt; Cancel : Boolean) : LongInt;
Var I : LongInt;
Begin
  DefBtnOf := -1;
  For I := 0 To MaxWnd - 1 Do
    If Wnds^[I].Used And (Wnds^[I].IKind = ikButton) And IsChildW(I) And
       Wnds^[I].Visible And Wnds^[I].Enabled And (TopOf(I) = T) Then
      If (Cancel And (Wnds^[I].Id = IDCANCEL)) Or
         (Not Cancel And ((Wnds^[I].Style And $F) = 1)) Then
      Begin
        DefBtnOf := I;
        Exit;
      End;
End;

{ Tab / Maj+Tab : controle suivant (precedent) du meme parent qui a
  WS_TABSTOP, dans l'ordre de creation, comme le gestionnaire de
  dialogues de Windows }
Function TabNextOf(W : LongInt; Back : Boolean) : LongInt;
Var I, K, P : LongInt;
Begin
  TabNextOf := -1;
  P := Wnds^[W].Parent;
  For K := 1 To MaxWnd - 1 Do
  Begin
    If Back Then I := (W - K + MaxWnd) Mod MaxWnd
    Else I := (W + K) Mod MaxWnd;
    If Wnds^[I].Used And IsChildW(I) And (Wnds^[I].Parent = P) And
       Wnds^[I].Visible And Wnds^[I].Enabled And
       ((Wnds^[I].Style And $10000) <> 0) And
       (Wnds^[I].IKind >= ikButton) And
       (Wnds^[I].IKind <= ikMdiClient) Then
    Begin
      TabNextOf := I;
      Exit;
    End;
  End;
End;

Procedure KKey(W, Msg, VK, Ch : LongInt);
Var I, K : LongInt;
Begin
  If W = -1 Then
  Begin
    { raccourcis globaux (avant la fenetre active) }
    If (VK = $5B) Or ((VK = $1B) And ((KeyState[$11] And $80) <> 0)) Then
    Begin
      If MenuDepth > 0 Then CloseMenus(0) Else OpenStartMenu;
      KeyState[$11] := KeyState[$11] And $7F;
      Exit;
    End;
    If MenuDepth > 0 Then
    Begin
      If VK = $1B Then CloseMenus(MenuDepth - 1);
      Exit;
    End;
    If ((KeyState[$12] And $80) <> 0) And (VK = $73) Then
    Begin
      I := ActiveWin;
      If I < 0 Then KCommand(cmShutdown)
      Else If Wnds^[I].IKind <> ikNone Then
      Begin
        If Wnds^[I].IKind = ikMsgBox Then MsgBoxEnd(I, IDCANCEL)
        Else If Wnds^[I].IKind = ikShutdown Then DialogAction(I, 1)
        Else If Wnds^[I].IKind = ikNotepad Then KCommand(cmNExit)
        Else If Wnds^[I].IKind = ikFileDlg Then FdClose(False)
        Else DestroyW(I);
      End
      Else PostMsgW(I, WM_CLOSE, 0, 0);
      Exit;
    End;
    If ((KeyState[$12] And $80) <> 0) And (VK = 9) Then
    Begin
      For I := 0 To ZCnt - 1 Do
        If IsTaskWin(ZList[I]) And (ZList[I] <> ActiveWin) Then
        Begin
          If Wnds^[ZList[I]].Min Then RestoreW(ZList[I])
          Else ActivateW(ZList[I]);
          Exit;
        End;
      Exit;
    End;
    Exit;
  End;
  If W = -2 Then
  Begin
    If (VK = $0D) And (DeskSel >= 0) Then KCommand(DeskCmd[DeskSel]);
    { F2 renommer, Suppr supprimer, Ctrl+A tout selectionner, Ctrl+C
      copier, Ctrl+X couper, Ctrl+V coller (documents du bureau) }
    K := VK;
    If (KeyState[$11] And $80) = 0 Then K := 0;
    If K = Ord('A') Then DeskSelectAll
    Else If (VK = $71) Or (VK = $2E) Or (K = Ord('C')) Or (K = Ord('X')) Or
            (K = Ord('V')) Then
    Begin
      DeskCtxSet;
      If K = Ord('V') Then
      Begin
        If DeskOk Then PasteTo(DeskDir);
      End
      Else If (CtxPath <> '') Or (CtxSelN > 1) Then
        If K = Ord('C') Then CtxClip(False)
        Else If Not CtxRO Then
          If K = Ord('X') Then CtxClip(True)
          Else If VK = $2E Then CtxDeleteAsk
          Else If CtxSelN <= 1 Then CtxRenameOpen;
    End;
    Exit;
  End;
  { programme MS-DOS : touches enfoncees et relachees }
  If VmOn And (W = ConW) Then
  Begin
    DosKeyIn(Msg = WM_KEYUP, VK, Ch);
    Exit;
  End;
  If Msg <> WM_KEYDOWN Then Exit;
  If (Wnds^[W].IKind >= ikButton) And (Wnds^[W].IKind <= ikMdiClient) Then
  Begin
    I := TopOf(W);
    If (VK = 9) And ((Wnds^[W].IKind <> ikEdit) Or
       ((Wnds^[W].Style And 4) = 0)) And
       (Wnds^[I].IKind In [ikNone, ikDialog]) Then
    Begin
      K := TabNextOf(W, (KeyState[$10] And $80) <> 0);
      If K >= 0 Then
      Begin
        SetFocusW(K);
        { zone de saisie : tout son texte selectionne }
        If Wnds^[K].IKind = ikEdit Then KWndProc(K, $B1, 0, -1);
      End;
    End
    Else If (VK = $0D) And (Wnds^[I].IKind = ikDialog) Then
      PostMsgW(I, WM_COMMAND, IDOK, 0)
    Else If (VK = $1B) And (Wnds^[I].IKind = ikDialog) Then
      PostMsgW(I, WM_COMMAND, IDCANCEL, 0)
    Else If ((VK = $0D) Or (VK = $1B)) And (Wnds^[I].IKind = ikNone) And
            ((Wnds^[W].IKind <> ikEdit) Or
             ((Wnds^[W].Style And $1004) = 0)) And
            (DefBtnOf(I, VK = $1B) >= 0) Then
    Begin
      { fenetre d'un programme : Entree = bouton par defaut,
        Echap = bouton Annuler (comme le gestionnaire de dialogues) }
      K := DefBtnOf(I, VK = $1B);
      PostMsgW(Wnds^[K].Parent, WM_COMMAND, Wnds^[K].Id And $FFFF, 0);
    End
    Else If (Ch <> 0) And (Wnds^[W].IKind = ikEdit) Then
    Begin
      If (KeyState[$11] And $80) <> 0 Then
        If (VK >= $41) And (VK <= $5A) Then Ch := VK - $40;
      KWndProc(W, WM_CHAR, Ch, 0);
    End
    Else If Wnds^[W].IKind In [ikEdit, ikListBox] Then
      KWndProc(W, WM_KEYDOWN, VK, 0);
    Exit;
  End;
  Case Wnds^[W].IKind Of
    ikMsgBox :
      If VK = $0D Then MsgBoxEnd(W, MbId(Wnds^[W].K2, 0))
      Else If VK = $1B Then MsgBoxEnd(W, MbId(Wnds^[W].K2,
                                       MbCount(Wnds^[W].K2) - 1));
    ikRun :
      If VK = $0D Then DialogAction(W, 0)
      Else If VK = $1B Then DialogAction(W, 1)
      Else If VK = 8 Then
      Begin
        If Wnds^[W].K2 = 1 Then Wnds^[W].KS := '';
        Wnds^[W].K2 := 0;
        Delete(Wnds^[W].KS, Length(Wnds^[W].KS), 1);
        KRepaint(W);
      End
      Else If (VK = $23) Or (VK = $24) Or (VK = $25) Or (VK = $27) Then
      Begin
        { fleches, Debut, Fin : le nom n'est plus choisi }
        Wnds^[W].K2 := 0;
        KRepaint(W);
      End
      Else If (Ch >= 32) And (Length(Wnds^[W].KS) < 250) Then
      Begin
        { nom choisi (Renommer) : la frappe le remplace }
        If Wnds^[W].K2 = 1 Then Wnds^[W].KS := '';
        Wnds^[W].K2 := 0;
        Wnds^[W].KS := Wnds^[W].KS + Chr(Ch);
        KRepaint(W);
      End;
    ikShutdown :
      If VK = $0D Then DialogAction(W, 0)
      Else If VK = $1B Then DialogAction(W, 1)
      Else If (VK = $26) Or (VK = $28) Then
      Begin
        If VK = $26 Then Wnds^[W].K1 := (Wnds^[W].K1 + 2) Mod 3
        Else Wnds^[W].K1 := (Wnds^[W].K1 + 1) Mod 3;
        KRepaint(W);
      End;
    ikAbout : If (VK = $0D) Or (VK = $1B) Then DestroyW(W);
    ikSecurity : SecKey(W, VK);
    ikDisplay : DisplayKey(W, VK);
    ikDateTime : DateTimeKey(W, VK);
    ikSysProps : SysPropsKey(W, VK);
    ikVolProps : VolPropsKey(W, VK, Ch);
    ikScanDisk : If VK = $1B Then ScanClose(W);
    ikConProps : ConPropsKey(W, VK, Ch);
    ikMapDrv : MapDrvKey(W, VK, Ch);
    ikFileDlg : FileDlgKey(W, VK, Ch);
    ikFind : FindKey(W, VK, Ch);
    ikDevProps : If (VK = $0D) Or (VK = $1B) Then
                 Begin
                   DestroyW(W);
                   DevPW := -1;
                 End;
    ikNotepad : NoteKey(W, VK, Ch);
    ikConsole : ConKeyIn(VK, Ch);
    ikExplorer : ExpKey(W, VK);
    ikFileProps : FilePropsKey(W, VK);
  End;
End;

Procedure KActivated(W : LongInt);
Begin
  If MenuDepth > 0 Then
    If (W < 0) Or (Wnds^[W].IKind <> ikMenu) Then CloseMenus(0);
End;

{ Fond d'une boite de dialogue d'un programme ; ses controles sont
  redessines ensuite }
Procedure PaintDlgBack(W : LongInt);
Var X1, Y1, X2, Y2, I : LongInt;
Begin
  KClient(W, X1, Y1, X2, Y2);
  FBar(X1, Y1, X2, Y2, cSilver);
  For I := 0 To MaxWnd - 1 Do
    If Wnds^[I].Used And IsChildW(I) And (Wnds^[I].Parent = W) Then
      InvalAll(I, True);
  { les controles internes invalides ci-dessus demandent de repeindre
    le dialogue (InvalW) : ce serait sans fin, et les fenetres filles du
    programme recevraient WM_PAINT en continu (la boucle PeekMessage du
    programme d'installation d'Office ne se vidait jamais) }
  Wnds^[W].KNeedPaint := False;
  { la procedure du dialogue peint ensuite par-dessus le fond (WM_PAINT
    dans sa tache), puis les controles sont redessines (EndPaint) }
  If DlgPaints(W) Then
  Begin
    SetR(Wnds^[W].Upd, 0, 0, Wnds^[W].CR - Wnds^[W].CL,
         Wnds^[W].CB - Wnds^[W].CT);
    Wnds^[W].UpdErase := False;
    If (Wnds^[W].Thread > 0) And (Wnds^[W].Thread < MaxThread) Then
      Threads[Wnds^[W].Thread].PaintReq := True;
  End;
End;

{ Dessiner une fenetre interne de premier niveau }
Procedure KPaint(W : LongInt);
Begin
  If Not Wnds^[W].Used Or (Wnds^[W].Surf.Bits = 0) Then Exit;
  Wnds^[W].KNeedPaint := False;
  SetR(Wnds^[W].Upd, 0, 0, 0, 0);
  NcPaint(W);
  SetTarget(Wnds^[W].Surf, Wnds^[W].X, Wnds^[W].Y);
  Case Wnds^[W].IKind Of
    ikTaskbar : PaintTaskbar(W);
    ikMenu : PaintMenu(W);
    ikMsgBox : PaintMsgBox(W);
    ikExplorer : PaintExplorer(W);
    ikAbout, ikRun, ikShutdown : PaintDialog(W);
    ikSecurity : PaintSecurity(W);
    ikDisplay : PaintDisplay(W);
    ikDateTime : PaintDateTime(W);
    ikVolPop : PaintVolPop(W);
    ikMixer : PaintMixer(W);
    ikAudio : PaintAudio(W);
    ikSysProps : PaintSysProps(W);
    ikVolProps : PaintVolProps(W);
    ikFileProps : PaintFileProps(W);
    ikScanDisk : PaintScanDisk(W);
    ikConProps : PaintConProps(W);
    ikMapDrv : PaintMapDrv(W);
    ikFileDlg : PaintFileDlg(W);
    ikFind : PaintFind(W);
    ikDevProps : PaintDevProps(W);
    ikHelp : PaintHelp(W);
    ikNotepad : PaintNotepad(W);
    ikConsole : PaintConsole(W);
    ikDialog : PaintDlgBack(W);
  End;
  DirtyWnd(W);
End;

{ Console : repeindre seulement les lignes de texte modifiees (sans le
  cadre) et ne recopier que cette bande a l'ecran. Repeindre et recopier
  toute la fenetre a chaque ligne affichee rendait DIR tres lent. }
Procedure ConPaintRows;
Var X1, Y1, X2, Y2 : LongInt;
Begin
  If (ConW < 0) Or Not Wnds^[ConW].Used Or (Wnds^[ConW].Surf.Bits = 0) Then
    Exit;
  SetTarget(Wnds^[ConW].Surf, Wnds^[ConW].X, Wnds^[ConW].Y);
  PaintConsole(ConW);
  If ConPR1 < ConPR0 Then Exit;
  KClient(ConW, X1, Y1, X2, Y2);
  MarkDirty(X1, Y1 + ConPR0 * ConChH, X2 + 1,
            Min(Y2 + 1, Y1 + (ConPR1 + 1) * ConChH));
End;

{ Fenetres internes a repeindre (tache 0) }
Procedure KPaintAll;
Var I : LongInt;
Begin
  If ConRowsDue And (ConW >= 0) And Wnds^[ConW].Used And
     Not Wnds^[ConW].KNeedPaint And Wnds^[ConW].Visible Then ConPaintRows;
  For I := 0 To MaxWnd - 1 Do
    If Wnds^[I].Used And Not IsChildW(I) Then
    Begin
      If Wnds^[I].IKind <> ikNone Then
      Begin
        If Wnds^[I].KNeedPaint Then KPaint(I);
      End
      Else If Wnds^[I].NeedNc Then NcPaint(I);
    End;
  ReadRtc;
  DtTick;
  If RtcMin <> LastMinute Then
  Begin
    LastMinute := RtcMin;
    TaskbarChanged;
  End;
End;

{ ------------------------------------------------------------------ }
{ Controles standard (BUTTON, STATIC, EDIT, LISTBOX, SCROLLBAR...)   }
{   Button : K1 etat (coche), K2 enfonce                             }
{   ListBox : Extra = liste de chaines (bloc), K1 nombre, K2 choix   }
{ ------------------------------------------------------------------ }

Const
  BS_TYPEMASK = $F; BS_CHECKBOX = 2; BS_AUTOCHECKBOX = 3; BS_RADIOBUTTON = 4;
  BS_3STATE = 5; BS_GROUPBOX = 7; BS_AUTORADIOBUTTON = 9; BS_OWNERDRAW = $B;
  BM_GETCHECK = $F0; BM_SETCHECK = $F1; BM_GETSTATE = $F2;
  BN_CLICKED = 0;
  LB_ADDSTRING = $180; LB_RESETCONTENT = $184; LB_SETCURSEL = $186;
  LB_GETCURSEL = $188; LB_GETTEXT = $189; LB_GETTEXTLEN = $18A;
  LB_GETCOUNT = $18B;
  CB_ADDSTRING = $143; CB_GETCURSEL = $147; CB_RESETCONTENT = $14B;
  CB_SETCURSEL = $14E;
  LBItemMax = 2048;
  { LISTBOX : styles dessines par le programme, messages }
  LBS_OWNERDRAWFIXED = $10; LBS_OWNERDRAWVAR = $20; LBS_HASSTRINGS = $40;
  LBS_MULTIPLESEL = $8; LBS_EXTENDEDSEL = $800;
  WM_DRAWITEM = $2B; WM_MEASUREITEM = $2C;

Procedure IconPaint(H, X, Y, CW, CH : LongInt; Gdi : Boolean); Forward;
Procedure BtnOwnerDraw(W : LongInt); Forward;

Procedure DrawCtl0(W : LongInt);
Var S : TSurf; OX, OY, X1, Y1, X2, Y2, Typ, I, A, H : LongInt; Clip : TRect;
    T : String; Fg : LongInt;
Begin
  If Not WndVisible(W) Then Exit;
  { liste ou bouton dessines par le programme : peints dans sa tache
    (WM_PAINT) }
  If CtlOwner(W) And (CurT <> Wnds^[W].Thread) Then
  Begin
    If (Wnds^[W].Thread > 0) And (Wnds^[W].Thread < MaxThread) Then
      Threads[Wnds^[W].Thread].PaintReq := True;
    Exit;
  End;
  If Not WndTarget(W, False, S, OX, OY, Clip) Then Exit;
  SetR(Wnds^[W].Upd, 0, 0, 0, 0);
  SetTarget(S, 0, 0);
  ClipX1 := Clip.L; ClipY1 := Clip.T; ClipX2 := Clip.R - 1;
  ClipY2 := Clip.B - 1;
  X1 := OX; Y1 := OY; X2 := OX + Wnds^[W].W - 1; Y2 := OY + Wnds^[W].H - 1;
  If Wnds^[W].Enabled Then Fg := cBlack Else Fg := cGray;
  T := Wnds^[W].Text;
  I := Pos('&', T);
  If I > 0 Then Delete(T, I, 1);
  Case Wnds^[W].IKind Of
    ikButton :
    Begin
      Typ := Wnds^[W].Style And BS_TYPEMASK;
      If Typ = BS_GROUPBOX Then GroupBox(X1, Y1 + 7, X2, Y2, T)
      Else If (Typ = BS_CHECKBOX) Or (Typ = BS_AUTOCHECKBOX) Or
              (Typ = BS_3STATE) Then
      Begin
        FBar(X1, Y1, X2, Y2, cSilver);
        Sunken(X1, (Y1 + Y2) Div 2 - 6, X1 + 12, (Y1 + Y2) Div 2 + 6, cWhite);
        If Wnds^[W].K1 <> 0 Then
          For I := 0 To 2 Do
            DLine(X1 + 3, (Y1 + Y2) Div 2 - 1 + I, X1 + 5,
                  (Y1 + Y2) Div 2 + 1 + I, cBlack);
        If Wnds^[W].K1 <> 0 Then
          For I := 0 To 2 Do
            DLine(X1 + 5, (Y1 + Y2) Div 2 + 1 + I, X1 + 9,
                  (Y1 + Y2) Div 2 - 3 + I, cBlack);
        OutTxt(X1 + 18, (Y1 + Y2) Div 2 - TxtCH Div 2, T, Fg);
      End
      Else If (Typ = BS_RADIOBUTTON) Or (Typ = BS_AUTORADIOBUTTON) Then
      Begin
        FBar(X1, Y1, X2, Y2, cSilver);
        RadioButton(X1, (Y1 + Y2) Div 2 - 7, T, Wnds^[W].K1 <> 0);
      End
      Else If Typ = BS_OWNERDRAW Then
      Begin
        { dans la tache du programme (voir plus haut) }
        BtnOwnerDraw(W);
        DirtyWnd(W);
        Exit;
      End
      Else
      Begin
        PbOff := Not Wnds^[W].Enabled;
        PushButton(X1, Y1, X2, Y2, T, Wnds^[W].K2 <> 0,
                   (Wnds^[W].Style And 1) <> 0);
        PbOff := False;
      End;
    End;
    ikStatic :
    Begin
      Typ := Wnds^[W].Style And $1F;
      If (Typ = 7) Or (Typ = 8) Or (Typ = 9) Then
        Edge(X1, Y1, X2, Y2, cGray, cWhite)
      Else If Typ = 3 Then
      Begin
        FBar(X1, Y1, X2, Y2, cSilver);
        IconPaint(Wnds^[W].Icon, X1, Y1, 0, 0, False);
      End
      Else
      Begin
        FBar(X1, Y1, X2, Y2, cSilver);
        TxtPitch := StaticPitch(W, T);
        If Wnds^[W].LongTxt <> 0 Then
          WrapZ(X1, Y1, StaticVisW(W), Wnds^[W].LongTxt, Fg, True)
        Else If (Pos(#10, T) > 0) Or (Pos(#13, T) > 0) Then
        Begin
          T := T + #0;
          WrapZ(X1, Y1, StaticVisW(W), LongInt(@T[1]), Fg, True);
        End
        Else If Typ = 1 Then WrapText(X1 + (Wnds^[W].W - TextW(T)) Div 2,
                                      Y1, Wnds^[W].W, T, Fg, True)
        Else WrapText(X1, Y1, StaticVisW(W), T, Fg, True);
        TxtPitch := 0;
      End;
    End;
    ikEdit :
    Begin
      Sunken(X1, Y1, X2, Y2, cWhite);
      If (Wnds^[W].Style And 4) <> 0 Then
      Begin
        { ES_MULTILINE : lignes et retour a la ligne, sans defilement }
        WrapClipY := Y2 - 2;
        If Wnds^[W].LongTxt <> 0 Then
          WrapZ(X1 + 4, Y1 + 3, Wnds^[W].W - 24, Wnds^[W].LongTxt, cBlack,
                True)
        Else
        Begin
          T := T + #0;
          WrapZ(X1 + 4, Y1 + 3, Wnds^[W].W - 24, LongInt(@T[1]), cBlack,
                True);
        End;
        WrapClipY := $7FFFFFFF;
      End
      Else
      Begin
        EdDraw(W, X1, Y1, X2, Y2);
        DirtyWnd(W);
        Exit;
      End;
      If W = FocusWin Then
        VLine(X1 + 4 + TextW(T), Y1 + 3, Y2 - 3, cBlack);
    End;
    ikListBox :
      LbDraw(W, X1, Y1, X2, Y2);
    ikComboBox :
    Begin
      Sunken(X1, Y1, X2, Y2, cWhite);
      A := Wnds^[W].Extra;
      H := TxtCH;
      For I := 0 To Wnds^[W].K1 - 1 Do
        If Y1 + 2 + I * H < Y2 - H Then
        Begin
          If I = Wnds^[W].K2 Then
          Begin
            FBar(X1 + 2, Y1 + 2 + I * H, X2 - 2, Y1 + 1 + (I + 1) * H, cNavy);
            OutTxt(X1 + 4, Y1 + 2 + I * H, PStr(MemL[0:A + I * 4]), cWhite);
          End
          Else
            OutTxt(X1 + 4, Y1 + 2 + I * H, PStr(MemL[0:A + I * 4]), cBlack);
        End;
    End;
    ikScrollBar : SbDraw(W, X1, Y1, X2, Y2);
    ikDialog, ikMdiClient :
      FBar(X1, Y1, X2, Y2, cSilver);
  End;
  DirtyWnd(W);
End;

{ Dessiner un controle : ceux des boites de dialogue (et ceux qui ont
  recu une petite police par WM_SETFONT) avec la police 6x13 }
Procedure DrawCtl(W : LongInt);
Var Sm : Boolean;
Begin
  Sm := TxtSmall;
  TxtSmall := CtlSmall(W);
  DrawCtl0(W);
  TxtSmall := Sm;
End;

{ Liste (LISTBOX, COMBOBOX) : bloc Extra = chaines (LBItemMax), donnees
  des elements (LBItemMax), hauteur d'un element, hauteur mesuree,
  element d'ancrage, puis un octet de selection par element (listes a
  selection multiple) }
Function LbExtra(W : LongInt) : LongInt;
Var H : LongInt;
Begin
  If Wnds^[W].Extra = 0 Then
  Begin
    Wnds^[W].Extra := KAlloc(LBItemMax * 9 + 16);
    If Wnds^[W].Extra <> 0 Then FillMem(Wnds^[W].Extra, LBItemMax * 9 + 16, 0);
  End;
  LbExtra := Wnds^[W].Extra;
End;

{ liste a selection multiple (LBS_MULTIPLESEL ou LBS_EXTENDEDSEL) }
Function LbMulti(W : LongInt) : Boolean;
Begin
  LbMulti := (Wnds^[W].IKind = ikListBox) And
             ((Wnds^[W].Style And (LBS_MULTIPLESEL Or LBS_EXTENDEDSEL))
              <> 0);
End;

{ element I choisi : octet de selection, ou element courant }
Function LbSel(W, I : LongInt) : Boolean;
Begin
  If LbMulti(W) Then
    LbSel := (Wnds^[W].Extra <> 0) And (I >= 0) And (I < Wnds^[W].K1) And
             (Mem[0:Wnds^[W].Extra + LBItemMax * 8 + 16 + I] <> 0)
  Else LbSel := (I >= 0) And (I = Wnds^[W].K2);
End;

{ choisir (On) ou non l'element I, ou tous (I = -1) }
Procedure LbSetSel(W, I : LongInt; On : Boolean);
Var A, K : LongInt;
Begin
  A := LbExtra(W);
  If A = 0 Then Exit;
  For K := 0 To Wnds^[W].K1 - 1 Do
    If (I = -1) Or (K = I) Then Mem[0:A + LBItemMax * 8 + 16 + K] := Ord(On);
End;

{ liste dessinee par le programme (WM_DRAWITEM) }
Function LbOwner(W : LongInt) : Boolean;
Begin
  LbOwner := (Wnds^[W].IKind = ikListBox) And
             ((Wnds^[W].Style And (LBS_OWNERDRAWFIXED Or LBS_OWNERDRAWVAR))
              <> 0);
End;

{ controle dessine par le programme : liste ou bouton BS_OWNERDRAW }
Function CtlOwner(W : LongInt) : Boolean;
Begin
  CtlOwner := LbOwner(W) Or ((Wnds^[W].IKind = ikButton) And
              ((Wnds^[W].Style And BS_TYPEMASK) = BS_OWNERDRAW));
End;

{ boite de dialogue d'un programme : sa procedure recoit WM_PAINT apres
  le fond (panneaux de l'installation d'Office, logos...) }
Function DlgPaints(W : LongInt) : Boolean;
Begin
  DlgPaints := (Wnds^[W].IKind = ikDialog) And (Wnds^[W].DlgProc <> 0);
End;

{ elements a chaine (sinon : une valeur du programme) }
Function LbHasStr(W : LongInt) : Boolean;
Begin
  LbHasStr := Not LbOwner(W) Or ((Wnds^[W].Style And LBS_HASSTRINGS) <> 0);
End;

Function LbData(W, I : LongInt) : LongInt;
Begin
  LbData := 0;
  If (Wnds^[W].Extra <> 0) And (I >= 0) And (I < Wnds^[W].K1) Then
    LbData := MemL[0:Wnds^[W].Extra + LBItemMax * 4 + I * 4];
End;

{ hauteur d'un element : 16, ou celle du programme (WM_MEASUREITEM,
  demande dans sa tache) }
Function LbItemH(W : LongInt) : LongInt;
Var A, H, P : LongInt; Mis : Array[0..5] Of LongInt;
Begin
  If CtlSmall(W) Then LbItemH := 13 Else LbItemH := 16;
  A := LbExtra(W);
  If A = 0 Then Exit;
  H := MemL[0:A + LBItemMax * 8];
  If (MemL[0:A + LBItemMax * 8 + 4] = 0) And LbOwner(W) And
     (CurT = Wnds^[W].Thread) Then
  Begin
    MemL[0:A + LBItemMax * 8 + 4] := 1;
    P := Wnds^[W].Parent;
    If P >= 0 Then
    Begin
      Mis[0] := 2; Mis[1] := Wnds^[W].Id; Mis[2] := 0;
      Mis[3] := Wnds^[W].W; Mis[4] := 16; Mis[5] := 0;
      If CtlSmall(W) Then Mis[4] := 13;
      SendMsgW(P, WM_MEASUREITEM, Wnds^[W].Id, LongInt(@Mis));
      If (Mis[4] > 0) And (Mis[4] < 256) And (H = 0) Then H := Mis[4];
    End;
    MemL[0:A + LBItemMax * 8] := H;
  End;
  If H > 0 Then LbItemH := H;
End;

{ inserer un element a la position I (-1 : a la fin) ; rend sa position }
Function LBInsert(W, I : LongInt; Const S : String; Data : LongInt)
  : LongInt;
Var A, B, K : LongInt;
Begin
  LBInsert := -1;
  A := LbExtra(W);
  If (A = 0) Or (Wnds^[W].K1 >= LBItemMax) Then Exit;
  If (I < 0) Or (I > Wnds^[W].K1) Then I := Wnds^[W].K1;
  B := 0;
  If LbHasStr(W) Then
  Begin
    B := KAlloc(Length(S) + 1);
    PutPStr(B, S, 256);
  End;
  For K := Wnds^[W].K1 DownTo I + 1 Do
  Begin
    MemL[0:A + K * 4] := MemL[0:A + (K - 1) * 4];
    MemL[0:A + LBItemMax * 4 + K * 4] := MemL[0:A + LBItemMax * 4 +
                                              (K - 1) * 4];
    Mem[0:A + LBItemMax * 8 + 16 + K] := Mem[0:A + LBItemMax * 8 + 15 + K];
  End;
  Mem[0:A + LBItemMax * 8 + 16 + I] := 0;
  MemL[0:A + I * 4] := B;
  MemL[0:A + LBItemMax * 4 + I * 4] := Data;
  Inc(Wnds^[W].K1);
  If (Wnds^[W].K2 >= I) And (Wnds^[W].K2 >= 0) Then Inc(Wnds^[W].K2);
  LBInsert := I;
End;

Procedure LBAdd(W : LongInt; S : String);
Begin
  LBInsert(W, -1, S, 0);
End;

Function LBDelete(W, I : LongInt) : LongInt;
Var A, K : LongInt;
Begin
  LBDelete := -1;
  A := Wnds^[W].Extra;
  If (A = 0) Or (I < 0) Or (I >= Wnds^[W].K1) Then Exit;
  If MemL[0:A + I * 4] <> 0 Then KFree(MemL[0:A + I * 4]);
  For K := I To Wnds^[W].K1 - 2 Do
  Begin
    MemL[0:A + K * 4] := MemL[0:A + (K + 1) * 4];
    MemL[0:A + LBItemMax * 4 + K * 4] := MemL[0:A + LBItemMax * 4 +
                                              (K + 1) * 4];
    Mem[0:A + LBItemMax * 8 + 16 + K] := Mem[0:A + LBItemMax * 8 + 17 + K];
  End;
  Dec(Wnds^[W].K1);
  If Wnds^[W].K2 = I Then Wnds^[W].K2 := -1
  Else If Wnds^[W].K2 > I Then Dec(Wnds^[W].K2);
  LBDelete := Wnds^[W].K1;
End;

Procedure LBClear(W : LongInt);
Var I : LongInt;
Begin
  If Wnds^[W].Extra <> 0 Then
    For I := 0 To Wnds^[W].K1 - 1 Do
      If MemL[0:Wnds^[W].Extra + I * 4] <> 0 Then
        KFree(MemL[0:Wnds^[W].Extra + I * 4]);
  If Wnds^[W].Extra <> 0 Then
    FillMem(Wnds^[W].Extra + LBItemMax * 8 + 16, LBItemMax, 0);
  Wnds^[W].K1 := 0; Wnds^[W].K2 := -1;
End;

Procedure Notify(W, Code : LongInt);
Begin
  If (Wnds^[W].Parent >= 0) Then
    PostMsgW(Wnds^[W].Parent, WM_COMMAND, (Code Shl 16) Or
             (Wnds^[W].Id And $FFFF), HwndOf(W));
End;

{ ------------------------------------------------------------------ }
{ Champ de saisie d'une ligne (EDIT) : K1 position du curseur, K2      }
{ ancre de la selection + 1 (0 : aucune), K3 premier caractere        }
{ affiche, K4 longueur maximale (0 : 255)                             }
{ ------------------------------------------------------------------ }

Function EdText(W : LongInt) : String;
Begin
  If Wnds^[W].LongTxt <> 0 Then EdText := PStr(Wnds^[W].LongTxt)
  Else EdText := Wnds^[W].Text;
End;

Procedure EdSet(W : LongInt; Const S : String);
Var T : String;
Begin
  T := S + #0;
  WndSetTextZ(W, LongInt(@T[1]));
End;

Function EdLimit(W : LongInt) : LongInt;
Begin
  If (Wnds^[W].K4 <= 0) Or (Wnds^[W].K4 > 255) Then EdLimit := 255
  Else EdLimit := Wnds^[W].K4;
End;

{ selection [A, B[ ; faux si vide }
Function EdSel(W : LongInt; Var A, B : LongInt) : Boolean;
Begin
  A := Wnds^[W].K1; B := A;
  If Wnds^[W].K2 > 0 Then
  Begin
    A := Min(Wnds^[W].K2 - 1, Wnds^[W].K1);
    B := Max(Wnds^[W].K2 - 1, Wnds^[W].K1);
  End;
  EdSel := B > A;
End;

Procedure EdClamp(W : LongInt);
Var L : LongInt;
Begin
  L := Length(EdText(W));
  If Wnds^[W].K1 < 0 Then Wnds^[W].K1 := 0;
  If Wnds^[W].K1 > L Then Wnds^[W].K1 := L;
  If Wnds^[W].K2 > L + 1 Then Wnds^[W].K2 := L + 1;
  If Wnds^[W].K2 = Wnds^[W].K1 + 1 Then Wnds^[W].K2 := 0;
End;

{ remplace la selection par S (insertion au curseur sans selection) }
Procedure EdReplace(W : LongInt; Const S : String);
Var T, U : String; A, B, N : LongInt;
Begin
  T := EdText(W);
  Dummy := Ord(EdSel(W, A, B));
  U := S;
  N := EdLimit(W) - (Length(T) - (B - A));
  If N < 0 Then N := 0;
  If Length(U) > N Then U := Copy(U, 1, N);
  T := Copy(T, 1, A) + U + Copy(T, B + 1, 255);
  EdSet(W, T);
  Wnds^[W].K1 := A + Length(U);
  Wnds^[W].K2 := 0;
  Notify(W, $300);
End;

Procedure EdCopy(W : LongInt);
Var A, B, Own : LongInt; T : String;
Begin
  If Not EdSel(W, A, B) Then Exit;
  If (Wnds^[W].Style And $20) <> 0 Then Exit;
  T := Copy(EdText(W), A + 1, B - A);
  If ClipBuf <> 0 Then KFree(ClipBuf);
  Own := HeapOwner; HeapOwner := 0;
  ClipBuf := KAlloc(Length(T) + 1);
  HeapOwner := Own;
  ClipLen := 0; ClipFN := 0;
  If ClipBuf = 0 Then Exit;
  PutPStr(ClipBuf, T, Length(T) + 1);
  ClipLen := Length(T);
End;

Procedure EdPaste(W : LongInt);
Var T : String; I : LongInt;
Begin
  If (ClipBuf = 0) Or (ClipLen <= 0) Then Exit;
  T := '';
  I := 0;
  While (I < ClipLen) And (I < 255) And (Mem[0:ClipBuf + I] <> 13) And
        (Mem[0:ClipBuf + I] <> 10) Do
  Begin
    If Mem[0:ClipBuf + I] >= 32 Then T := T + Chr(Mem[0:ClipBuf + I]);
    Inc(I);
  End;
  EdReplace(W, T);
End;

{ touche (WM_KEYDOWN) : deplacements, Maj : selection, Suppr }
Procedure EdKey(W, VK : LongInt);
Var Sh : Boolean; A, B : LongInt; T : String;
Begin
  Sh := (KeyState[$10] And $80) <> 0;
  T := EdText(W);
  If VK = $2E Then
  Begin
    If Not EdSel(W, A, B) Then
    Begin
      If Wnds^[W].K1 >= Length(T) Then Exit;
      Wnds^[W].K2 := Wnds^[W].K1 + 2;
    End;
    EdReplace(W, '');
    InvalAll(W, True);
    Exit;
  End;
  If Not (VK In [$23, $24, $25, $27]) Then Exit;
  If Sh Then
  Begin
    If Wnds^[W].K2 = 0 Then Wnds^[W].K2 := Wnds^[W].K1 + 1;
  End
  Else If EdSel(W, A, B) And (VK In [$25, $27]) Then
  Begin
    If VK = $25 Then Wnds^[W].K1 := A Else Wnds^[W].K1 := B;
    Wnds^[W].K2 := 0;
    InvalAll(W, True);
    Exit;
  End
  Else Wnds^[W].K2 := 0;
  Case VK Of
    $25 : Dec(Wnds^[W].K1);
    $27 : Inc(Wnds^[W].K1);
    $24 : Wnds^[W].K1 := 0;
    $23 : Wnds^[W].K1 := Length(T);
  End;
  EdClamp(W);
  InvalAll(W, True);
End;

Procedure EdChar(W, Ch : LongInt);
Var A, B : LongInt;
Begin
  Case Ch Of
    1 :
    Begin
      Wnds^[W].K2 := 1; Wnds^[W].K1 := Length(EdText(W));
      EdClamp(W);
    End;
    3 : EdCopy(W);
    22 : EdPaste(W);
    24 :
    Begin
      EdCopy(W);
      If EdSel(W, A, B) Then EdReplace(W, '');
    End;
    8 :
    Begin
      If Not EdSel(W, A, B) Then
      Begin
        If Wnds^[W].K1 = 0 Then Exit;
        Wnds^[W].K2 := Wnds^[W].K1;
      End;
      EdReplace(W, '');
    End;
  Else
    If Ch >= 32 Then EdReplace(W, Chr(Ch And 255)) Else Exit;
  End;
  InvalAll(W, True);
End;

{ caractere sous la position X (client) }
Function EdHit(W, X : LongInt) : LongInt;
Begin
  If X < 4 Then X := 4;
  If CtlSmall(W) Then EdHit := Wnds^[W].K3 + (X - 4 + 3) Div 6
  Else EdHit := Wnds^[W].K3 + (X - 4 + 4) Div 8;
End;

{ messages propres au champ d'une ligne ; vrai si traite }
Function EdMsg(W, Msg, WP, LP : LongInt; Var R : LongInt) : Boolean;
Var A, B, X : LongInt;
Begin
  EdMsg := True;
  R := 0;
  X := LP And $FFFF;
  If X >= 32768 Then X := X - 65536;
  Case Msg Of
    WM_KEYDOWN : EdKey(W, WP);
    WM_CHAR : EdChar(W, WP);
    WM_SETFOCUS, WM_KILLFOCUS : InvalAll(W, True);
    WM_LBUTTONDOWN :
    Begin
      Wnds^[W].K1 := EdHit(W, X);
      EdClamp(W);
      Wnds^[W].K2 := Wnds^[W].K1 + 1;
      CaptureWin := W;
      InvalAll(W, True);
    End;
    WM_MOUSEMOVE :
      If CaptureWin = W Then
      Begin
        Wnds^[W].K1 := EdHit(W, X);
        If X > Wnds^[W].W - 4 Then Inc(Wnds^[W].K1);
        EdClamp(W);
        InvalAll(W, True);
      End;
    WM_LBUTTONUP :
    Begin
      If CaptureWin = W Then CaptureWin := -1;
      EdClamp(W);
      InvalAll(W, True);
    End;
    WM_LBUTTONDBLCLK :
    Begin
      Wnds^[W].K2 := 1; Wnds^[W].K1 := Length(EdText(W));
      EdClamp(W);
      InvalAll(W, True);
    End;
    WM_SETTEXT :
    Begin
      WndSetTextA(W, LP);
      Wnds^[W].K1 := Length(EdText(W)); Wnds^[W].K2 := 0;
      Wnds^[W].K3 := 0;
      R := 1;
      InvalAll(W, True);
    End;
    $B0 :
    Begin
      Dummy := Ord(EdSel(W, A, B));
      If WP <> 0 Then MemL[0:WP] := A;
      If LP <> 0 Then MemL[0:LP] := B;
      R := A Or (B Shl 16);
    End;
    $B1 :
    Begin
      A := WP; B := LP;
      If (B < 0) Or (B > Length(EdText(W))) Then B := Length(EdText(W));
      If A < 0 Then
      Begin
        Wnds^[W].K2 := 0;
        Wnds^[W].K1 := B;
      End
      Else
      Begin
        Wnds^[W].K2 := A + 1;
        Wnds^[W].K1 := B;
      End;
      EdClamp(W);
      InvalAll(W, True);
    End;
    $C2 :
    Begin
      If LP <> 0 Then EdReplace(W, PStr(LP));
      InvalAll(W, True);
    End;
    $C5 : Wnds^[W].K4 := WP;
  Else
    EdMsg := False;
  End;
End;

{ dessin : texte defilant, selection (si le champ a le focus), curseur }
Procedure EdDraw(W, X1, Y1, X2, Y2 : LongInt);
Var T, V : String; Vis, A, B, I, Y, C : LongInt; Foc, Sel : Boolean;
Begin
  If Wnds^[W].Enabled Then Sunken(X1, Y1, X2, Y2, cWhite)
  Else Sunken(X1, Y1, X2, Y2, cSilver);
  T := EdText(W);
  If (Wnds^[W].Style And $20) <> 0 Then
    For I := 1 To Length(T) Do T[I] := '*';
  EdClamp(W);
  Vis := (Wnds^[W].W - 8) Div TxtCW;
  If Vis < 1 Then Vis := 1;
  If Wnds^[W].K1 < Wnds^[W].K3 Then Wnds^[W].K3 := Wnds^[W].K1;
  If Wnds^[W].K1 > Wnds^[W].K3 + Vis - 1 Then
    Wnds^[W].K3 := Wnds^[W].K1 - Vis + 1;
  If Wnds^[W].K3 > Max(0, Length(T) - Vis + 1) Then
    Wnds^[W].K3 := Max(0, Length(T) - Vis + 1);
  If Wnds^[W].K3 < 0 Then Wnds^[W].K3 := 0;
  V := Copy(T, Wnds^[W].K3 + 1, Vis);
  Y := Y1 + (Wnds^[W].H - TxtCH) Div 2;
  Foc := W = FocusWin;
  Sel := Foc And EdSel(W, A, B);
  If Wnds^[W].Enabled Then C := cBlack Else C := cGray;
  For I := 1 To Length(V) Do
    If Sel And (Wnds^[W].K3 + I - 1 >= A) And (Wnds^[W].K3 + I - 1 < B)
    Then
    Begin
      FBar(X1 + 4 + (I - 1) * TxtCW, Y, X1 + 3 + I * TxtCW, Y + TxtCH - 1,
           cNavy);
      DrawChar(X1 + 4 + (I - 1) * TxtCW, Y, V[I], cWhite);
    End
    Else DrawChar(X1 + 4 + (I - 1) * TxtCW, Y, V[I], C);
  If Foc Then
    VLine(X1 + 4 + (Wnds^[W].K1 - Wnds^[W].K3) * TxtCW, Y1 + 3, Y2 - 3,
          cBlack);
End;

{ ------------------------------------------------------------------ }
{ Barre de defilement (SCROLLBAR, SBS_VERT = 1) : K1 minimum, K2      }
{ maximum, K3 position, K4 glissement du curseur (0 : aucun, sinon    }
{ decalage + 1) ; HScrollPos : position pendant le glissement         }
{ ------------------------------------------------------------------ }

Function SbVert(W : LongInt) : Boolean;
Begin
  SbVert := (Wnds^[W].Style And 1) <> 0;
End;

{ longueur (le long de la barre) et epaisseur }
Procedure SbDims(W : LongInt; Var L, T : LongInt);
Begin
  If SbVert(W) Then
  Begin
    L := Wnds^[W].H; T := Wnds^[W].W;
  End
  Else
  Begin
    L := Wnds^[W].W; T := Wnds^[W].H;
  End;
  If T > L Div 2 Then T := L Div 2;
  If T < 1 Then T := 1;
End;

Function SbActive(W : LongInt) : Boolean;
Begin
  SbActive := Wnds^[W].Enabled And (Wnds^[W].K2 > Wnds^[W].K1);
End;

{ debut du curseur (le long de la barre) pour la position P }
Function SbThumb(W, P : LongInt) : LongInt;
Var L, T, Tr : LongInt;
Begin
  SbDims(W, L, T);
  Tr := L - 3 * T;
  If (Tr <= 0) Or (Wnds^[W].K2 <= Wnds^[W].K1) Then SbThumb := T
  Else SbThumb := T + ((P - Wnds^[W].K1) * Tr) Div
                      (Wnds^[W].K2 - Wnds^[W].K1);
End;

Procedure SbArrow(X1, Y1, X2, Y2, Dir : LongInt; C : LongInt);
Var Cx, Cy, I : LongInt;
Begin
  Raised(X1, Y1, X2, Y2, False);
  Cx := (X1 + X2) Div 2; Cy := (Y1 + Y2) Div 2;
  For I := 0 To 3 Do
    Case Dir Of
      0 : HLine(Cx - I, Cx + I, Cy - 2 + I, C);
      1 : HLine(Cx - I, Cx + I, Cy + 1 - I, C);
      2 : VLine(Cx - 2 + I, Cy - I, Cy + I, C);
    Else
      VLine(Cx + 1 - I, Cy - I, Cy + I, C);
    End;
End;

Procedure SbDraw(W, X1, Y1, X2, Y2 : LongInt);
Var L, T, P, Th, C : LongInt;
Begin
  SbDims(W, L, T);
  FBar(X1, Y1, X2, Y2, cSilver);
  Dither(X1, Y1, X2, Y2, cWhite, 0);
  If SbActive(W) Then C := cBlack Else C := cGray;
  If Wnds^[W].K4 > 0 Then P := Wnds^[W].HScrollPos Else P := Wnds^[W].K3;
  Th := SbThumb(W, P);
  If SbVert(W) Then
  Begin
    SbArrow(X1, Y1, X2, Y1 + T - 1, 0, C);
    SbArrow(X1, Y2 - T + 1, X2, Y2, 1, C);
    If SbActive(W) Then Raised(X1, Y1 + Th, X2, Y1 + Th + T - 1, False);
  End
  Else
  Begin
    SbArrow(X1, Y1, X1 + T - 1, Y2, 2, C);
    SbArrow(X2 - T + 1, Y1, X2, Y2, 3, C);
    If SbActive(W) Then Raised(X1 + Th, Y1, X1 + Th + T - 1, Y2, False);
  End;
End;

{ WM_VSCROLL / WM_HSCROLL au parent }
Procedure SbSend(W, Code, P : LongInt);
Var M : LongInt;
Begin
  If Wnds^[W].Parent < 0 Then Exit;
  If SbVert(W) Then M := WM_VSCROLL Else M := WM_HSCROLL;
  PostMsgW(Wnds^[W].Parent, M, (Code And $FFFF) Or ((P And $FFFF) Shl 16),
           HwndOf(W));
End;

Function SbMsg(W, Msg, WP, LP : LongInt; Var R : LongInt) : Boolean;
Var L, T, X, Y, A, Th, P : LongInt;
Begin
  SbMsg := True;
  R := 0;
  X := LP And $FFFF; If X >= 32768 Then X := X - 65536;
  Y := (LP Shr 16) And $FFFF; If Y >= 32768 Then Y := Y - 65536;
  If SbVert(W) Then A := Y Else A := X;
  SbDims(W, L, T);
  Case Msg Of
    WM_LBUTTONDOWN, WM_LBUTTONDBLCLK :
      If SbActive(W) Then
      Begin
        Th := SbThumb(W, Wnds^[W].K3);
        If A < T Then SbSend(W, 0, 0)
        Else If A >= L - T Then SbSend(W, 1, 0)
        Else If A < Th Then SbSend(W, 2, 0)
        Else If A >= Th + T Then SbSend(W, 3, 0)
        Else
        Begin
          Wnds^[W].K4 := A - Th + 1;
          Wnds^[W].HScrollPos := Wnds^[W].K3;
          CaptureWin := W;
          InvalAll(W, True);
        End;
      End;
    WM_MOUSEMOVE :
      If (Wnds^[W].K4 > 0) And (CaptureWin = W) Then
      Begin
        P := A - (Wnds^[W].K4 - 1) - T;
        If L - 3 * T > 0 Then
          P := Wnds^[W].K1 + (P * (Wnds^[W].K2 - Wnds^[W].K1) +
               (L - 3 * T) Div 2) Div (L - 3 * T)
        Else P := Wnds^[W].K1;
        If P < Wnds^[W].K1 Then P := Wnds^[W].K1;
        If P > Wnds^[W].K2 Then P := Wnds^[W].K2;
        If P <> Wnds^[W].HScrollPos Then
        Begin
          Wnds^[W].HScrollPos := P;
          InvalAll(W, True);
          SbSend(W, 5, P);
        End;
      End;
    WM_LBUTTONUP :
    Begin
      If Wnds^[W].K4 > 0 Then
      Begin
        Wnds^[W].K4 := 0;
        Wnds^[W].K3 := Wnds^[W].HScrollPos;
        SbSend(W, 4, Wnds^[W].K3);
        InvalAll(W, True);
      End;
      If CaptureWin = W Then CaptureWin := -1;
      SbSend(W, 8, 0);
    End;
    $E0 :
    Begin
      R := Wnds^[W].K3;
      P := WP;
      If P > Wnds^[W].K2 Then P := Wnds^[W].K2;
      If P < Wnds^[W].K1 Then P := Wnds^[W].K1;
      Wnds^[W].K3 := P;
      If LP <> 0 Then InvalAll(W, True);
    End;
    $E1 : R := Wnds^[W].K3;
    $E2, $E6 :
    Begin
      Wnds^[W].K1 := WP; Wnds^[W].K2 := LP;
      If Wnds^[W].K3 > LP Then Wnds^[W].K3 := LP;
      If Wnds^[W].K3 < WP Then Wnds^[W].K3 := WP;
      If (Msg = $E6) Or (LP <> WP) Then InvalAll(W, True);
      R := 1;
    End;
    $E3 :
    Begin
      If WP <> 0 Then MemL[0:WP] := Wnds^[W].K1;
      If LP <> 0 Then MemL[0:LP] := Wnds^[W].K2;
    End;
  Else
    SbMsg := False;
  End;
End;

{ ------------------------------------------------------------------ }
{ Liste (LISTBOX) : K1 nombre d'elements, K2 selection, K3 premier    }
{ element visible ; barre de defilement interne si elle deborde       }
{ ------------------------------------------------------------------ }

Function LbRows(W : LongInt) : LongInt;
Begin
  LbRows := Max(1, (Wnds^[W].H - 4) Div LbItemH(W));
End;

Function LbOver(W : LongInt) : Boolean;
Begin
  LbOver := (Wnds^[W].IKind = ikListBox) And (Wnds^[W].K1 > LbRows(W));
End;

Procedure LbShow(W, I : LongInt);
Var N : LongInt;
Begin
  N := LbRows(W);
  If I < Wnds^[W].K3 Then Wnds^[W].K3 := I;
  If I >= Wnds^[W].K3 + N Then Wnds^[W].K3 := I - N + 1;
  If Wnds^[W].K3 > Max(0, Wnds^[W].K1 - N) Then
    Wnds^[W].K3 := Max(0, Wnds^[W].K1 - N);
  If Wnds^[W].K3 < 0 Then Wnds^[W].K3 := 0;
End;

Function GetDC(H : LongInt) : LongInt; Forward;
Function ReleaseDC(H, Hdc : LongInt) : LongInt; Forward;

{ elements d'une liste dessinee par le programme : WM_DRAWITEM au parent
  (dans la tache du programme), DRAWITEMSTRUCT : type 2 (ODT_LISTBOX),
  identifiant, element, action 1 (tout), etat (1 choisi, 10h focus),
  fenetre, contexte, rectangle, donnee }
Procedure LbItemDraw(W, Hdc, I, R, Act : LongInt);
Var Dis : Array[0..11] Of LongInt; H : LongInt;
Begin
  H := LbItemH(W);
  Dis[0] := 2; Dis[1] := Wnds^[W].Id; Dis[2] := I;
  Dis[3] := Act; Dis[4] := 0;
  If LbSel(W, I) Then Dis[4] := 1;
  If (I = Wnds^[W].K2) And (FocusWin = W) Then Dis[4] := Dis[4] Or $10;
  Dis[5] := HwndOf(W); Dis[6] := Hdc;
  Dis[7] := 2; Dis[8] := 2 + (I - Wnds^[W].K3) * H; Dis[9] := R;
  Dis[10] := Dis[8] + H;
  Dis[11] := LbData(W, I);
  SendMsgW(Wnds^[W].Parent, WM_DRAWITEM, Wnds^[W].Id, LongInt(@Dis));
End;

Procedure LbOwnerDraw(W, R : LongInt);
Var I, N, Hdc : LongInt;
Begin
  If Wnds^[W].Parent < 0 Then Exit;
  N := LbRows(W);
  Hdc := GetDC(HwndOf(W));
  If Hdc = 0 Then Exit;
  For I := 0 To N - 1 Do
    If Wnds^[W].K3 + I < Wnds^[W].K1 Then
      LbItemDraw(W, Hdc, Wnds^[W].K3 + I, R, 1);
  ReleaseDC(HwndOf(W), Hdc);
End;

{ bouton BS_OWNERDRAW : WM_DRAWITEM au parent (ODT_BUTTON 4, action
  ODA_DRAWENTIRE, etat 1 enfonce, 4 inactif, 10h focus) }
Procedure BtnOwnerDraw(W : LongInt);
Var Dis : Array[0..11] Of LongInt; Hdc : LongInt;
Begin
  If Wnds^[W].Parent < 0 Then Exit;
  Hdc := GetDC(HwndOf(W));
  If Hdc = 0 Then Exit;
  Dis[0] := 4; Dis[1] := Wnds^[W].Id; Dis[2] := 0; Dis[3] := 1;
  Dis[4] := 0;
  If Wnds^[W].K2 <> 0 Then Dis[4] := 1;
  If Not Wnds^[W].Enabled Then Dis[4] := Dis[4] Or 4;
  If FocusWin = W Then Dis[4] := Dis[4] Or $10;
  Dis[5] := HwndOf(W); Dis[6] := Hdc;
  Dis[7] := 0; Dis[8] := 0; Dis[9] := Wnds^[W].W; Dis[10] := Wnds^[W].H;
  Dis[11] := 0;
  SendMsgW(Wnds^[W].Parent, WM_DRAWITEM, Wnds^[W].Id, LongInt(@Dis));
  ReleaseDC(HwndOf(W), Hdc);
End;

{ liste dessinee par le programme : comme Windows, prevenir aussitot
  d'un changement de selection (ODA_SELECT) de l'element Sel, et du
  deplacement du curseur de Old vers K2 (ODA_FOCUS) }
Procedure LbChanged(W, Sel, Old : LongInt);
Var Hdc, R, N : LongInt;
Begin
  InvalAll(W, True);
  If Not LbOwner(W) Or (CurT <> Wnds^[W].Thread) Or
     (Wnds^[W].Parent < 0) Then Exit;
  N := LbRows(W);
  R := Wnds^[W].W - 2;
  If LbOver(W) Then R := Wnds^[W].W - 18;
  Hdc := GetDC(HwndOf(W));
  If Hdc = 0 Then Exit;
  If (Sel >= Wnds^[W].K3) And (Sel < Wnds^[W].K3 + N) And
     (Sel < Wnds^[W].K1) Then LbItemDraw(W, Hdc, Sel, R, 2);
  If Old <> Wnds^[W].K2 Then
  Begin
    If (Old >= Wnds^[W].K3) And (Old < Wnds^[W].K3 + N) And
       (Old < Wnds^[W].K1) Then LbItemDraw(W, Hdc, Old, R, 4);
    If (Wnds^[W].K2 >= Wnds^[W].K3) And (Wnds^[W].K2 < Wnds^[W].K3 + N)
       And (Wnds^[W].K2 < Wnds^[W].K1) Then
      LbItemDraw(W, Hdc, Wnds^[W].K2, R, 4);
  End;
  ReleaseDC(HwndOf(W), Hdc);
End;

Procedure LbDraw(W, X1, Y1, X2, Y2 : LongInt);
Var A, I, N, R, Th, Tr : LongInt;
Begin
  Sunken(X1, Y1, X2, Y2, cWhite);
  A := Wnds^[W].Extra;
  N := LbRows(W);
  LbShow(W, Wnds^[W].K3);
  R := X2 - 2;
  If LbOver(W) Then R := X2 - 18;
  ClipX2 := Min(ClipX2, R);
  Th := LbItemH(W);
  If LbOwner(W) Then
  Begin
    If CurT = Wnds^[W].Thread Then LbOwnerDraw(W, R - X1);
  End
  Else
  For I := 0 To N - 1 Do
    If Wnds^[W].K3 + I < Wnds^[W].K1 Then
      If LbSel(W, Wnds^[W].K3 + I) Then
      Begin
        FBar(X1 + 2, Y1 + 2 + I * Th, R, Y1 + 1 + (I + 1) * Th, cNavy);
        OutTxt(X1 + 4, Y1 + 2 + I * Th,
               PStr(MemL[0:A + (Wnds^[W].K3 + I) * 4]), cWhite);
      End
      Else
        OutTxt(X1 + 4, Y1 + 2 + I * Th,
               PStr(MemL[0:A + (Wnds^[W].K3 + I) * 4]), cBlack);
  ClipX2 := X2;
  If Not LbOver(W) Then Exit;
  { barre de defilement verticale, comme Windows 95 }
  FBar(X2 - 17, Y1 + 2, X2 - 2, Y2 - 2, cSilver);
  Dither(X2 - 17, Y1 + 2, X2 - 2, Y2 - 2, cWhite, 0);
  SbArrow(X2 - 17, Y1 + 2, X2 - 2, Y1 + 17, 0, cBlack);
  SbArrow(X2 - 17, Y2 - 17, X2 - 2, Y2 - 2, 1, cBlack);
  Tr := (Y2 - Y1 - 4) - 48;
  If Tr > 0 Then
  Begin
    Th := Y1 + 18 + (Wnds^[W].K3 * Tr) Div Max(1, Wnds^[W].K1 - N);
    Raised(X2 - 17, Th, X2 - 2, Th + 15, False);
  End;
End;

{ clic (ou deplacement) sur l'element I d'une liste a selection
  multiple ; WP : touches (4 Maj, 8 Ctrl) }
Procedure LbClickSel(W, I, WP : LongInt);
Var A, K, F, L : LongInt;
Begin
  A := LbExtra(W);
  If A = 0 Then Exit;
  If (Wnds^[W].Style And LBS_EXTENDEDSEL) = 0 Then
  Begin
    LbSetSel(W, I, Not LbSel(W, I));
    Exit;
  End;
  If (WP And 8) <> 0 Then LbSetSel(W, I, Not LbSel(W, I))
  Else If ((WP And 4) <> 0) Then
  Begin
    F := MemL[0:A + LBItemMax * 8 + 8];
    L := I;
    If F > L Then
    Begin
      K := F; F := L; L := K;
    End;
    LbSetSel(W, -1, False);
    For K := F To L Do LbSetSel(W, K, True);
    Exit;
  End
  Else
  Begin
    LbSetSel(W, -1, False);
    LbSetSel(W, I, True);
  End;
  MemL[0:A + LBItemMax * 8 + 8] := I;
End;

Function LbMsg(W, Msg, WP, LP : LongInt; Var R : LongInt) : Boolean;
Var X, Y, I, N : LongInt;
Begin
  LbMsg := True;
  R := 0;
  X := LP And $FFFF; Y := (LP Shr 16) And $FFFF;
  N := LbRows(W);
  Case Msg Of
    WM_LBUTTONDOWN :
      If LbOver(W) And (X >= Wnds^[W].W - 18) Then
      Begin
        If Y < 18 Then Dec(Wnds^[W].K3)
        Else If Y >= Wnds^[W].H - 18 Then Inc(Wnds^[W].K3)
        Else If Y < Wnds^[W].H Div 2 Then Wnds^[W].K3 := Wnds^[W].K3 - N
        Else Wnds^[W].K3 := Wnds^[W].K3 + N;
        LbShow(W, Wnds^[W].K3);
        InvalAll(W, True);
      End
      Else
      Begin
        I := Wnds^[W].K3 + (Y - 2) Div LbItemH(W);
        If (Y >= 2) And (I >= 0) And (I < Wnds^[W].K1) Then
        Begin
          N := Wnds^[W].K2;
          X := Ord(LbSel(W, I));
          If LbMulti(W) Then LbClickSel(W, I, WP);
          Wnds^[W].K2 := I;
          If Not LbMulti(W) And (N <> I) Then LbChanged(W, N, I);
          If X <> Ord(LbSel(W, I)) Then LbChanged(W, I, N)
          Else LbChanged(W, -1, N);
          Notify(W, 1);
        End;
      End;
    WM_LBUTTONDBLCLK :
      If Not (LbOver(W) And (X >= Wnds^[W].W - 18)) Then Notify(W, 2);
    WM_KEYDOWN :
    Begin
      I := Wnds^[W].K2;
      If (WP = $20) And LbMulti(W) And (I >= 0) Then
      Begin
        LbSetSel(W, I, Not LbSel(W, I));
        InvalAll(W, True);
        Notify(W, 1);
        Exit;
      End;
      Case WP Of
        $26 : Dec(I);
        $28 : Inc(I);
        $21 : I := I - N;
        $22 : I := I + N;
        $24 : I := 0;
        $23 : I := Wnds^[W].K1 - 1;
      Else
        Exit;
      End;
      If I >= Wnds^[W].K1 Then I := Wnds^[W].K1 - 1;
      If I < 0 Then I := 0;
      If Wnds^[W].K1 = 0 Then Exit;
      If LbMulti(W) And ((Wnds^[W].Style And LBS_EXTENDEDSEL) <> 0) Then
        LbClickSel(W, I, 0);
      Wnds^[W].K2 := I;
      LbShow(W, I);
      InvalAll(W, True);
      Notify(W, 1);
    End;
    LB_SETCURSEL :
    Begin
      Wnds^[W].K2 := WP;
      If WP >= 0 Then LbShow(W, WP);
      InvalAll(W, True);
    End;
    $197 :
    Begin
      Wnds^[W].K3 := WP;
      LbShow(W, WP);
      InvalAll(W, True);
    End;
    $18E : R := Wnds^[W].K3;
    { LB_SETSEL (WP choisir, LP element ou -1), LB_GETSEL }
    $185 :
      If Not LbMulti(W) Then R := -1
      Else
      Begin
        I := Wnds^[W].K2;
        N := -1;
        If (LP >= 0) And (LP < Wnds^[W].K1) Then
          If LbSel(W, LP) <> (WP <> 0) Then N := LP;
        LbSetSel(W, LP, WP <> 0);
        If (LP >= 0) And (LP < Wnds^[W].K1) Then Wnds^[W].K2 := LP;
        LbChanged(W, N, I);
      End;
    $187 :
      If (WP < 0) Or (WP >= Wnds^[W].K1) Then R := -1
      Else R := Ord(LbSel(W, WP));
    { LB_GETSELCOUNT, LB_GETSELITEMS }
    $190, $191 :
      If Not LbMulti(W) Then R := -1
      Else
        For I := 0 To Wnds^[W].K1 - 1 Do
          If LbSel(W, I) Then
            If Msg = $190 Then Inc(R)
            Else If R < WP Then
            Begin
              MemL[0:LP + R * 4] := I;
              Inc(R);
            End;
    { LB_SELITEMRANGE (LP : premier, dernier), LB_SELITEMRANGEEX }
    $19B, $183 :
      If Not LbMulti(W) Then R := -1
      Else
      Begin
        If Msg = $19B Then
        Begin
          X := LP And $FFFF; Y := (LP Shr 16) And $FFFF;
          N := Ord(WP <> 0);
        End
        Else
        Begin
          X := WP; Y := LP; N := 1;
          If X > Y Then
          Begin
            X := LP; Y := WP; N := 0;
          End;
        End;
        For I := X To Y Do LbSetSel(W, I, N <> 0);
        InvalAll(W, True);
      End;
    { LB_SETANCHORINDEX, LB_GETANCHORINDEX, LB_SETCARETINDEX,
      LB_GETCARETINDEX }
    $19C : If LbExtra(W) <> 0 Then
             MemL[0:Wnds^[W].Extra + LBItemMax * 8 + 8] := WP;
    $19D : If LbExtra(W) <> 0 Then
             R := MemL[0:Wnds^[W].Extra + LBItemMax * 8 + 8];
    $19E :
      If (WP >= 0) And (WP < Wnds^[W].K1) Then
      Begin
        I := Wnds^[W].K2;
        Wnds^[W].K2 := WP;
        LbShow(W, WP);
        LbChanged(W, -1, I);
      End
      Else R := -1;
    $19F : R := Wnds^[W].K2;
    { LB_INSERTSTRING, LB_DELETESTRING }
    $181 :
    Begin
      If LbHasStr(W) Then R := LBInsert(W, WP, APStr(LP), 0)
      Else R := LBInsert(W, WP, '', LP);
      InvalAll(W, True);
    End;
    $182 :
    Begin
      R := LBDelete(W, WP);
      InvalAll(W, True);
    End;
    { LB_GETITEMDATA, LB_SETITEMDATA }
    $199 :
      If (WP >= 0) And (WP < Wnds^[W].K1) Then R := LbData(W, WP)
      Else R := -1;
    $19A :
      If (WP >= 0) And (WP < Wnds^[W].K1) And (LbExtra(W) <> 0) Then
        MemL[0:Wnds^[W].Extra + LBItemMax * 4 + WP * 4] := LP
      Else R := -1;
    { LB_GETITEMRECT }
    $198 :
      If (WP >= 0) And (WP < Wnds^[W].K1) And (LP <> 0) Then
      Begin
        MemL[0:LP] := 2;
        MemL[0:LP + 4] := 2 + (WP - Wnds^[W].K3) * LbItemH(W);
        MemL[0:LP + 8] := Wnds^[W].W - 2;
        If LbOver(W) Then MemL[0:LP + 8] := Wnds^[W].W - 18;
        MemL[0:LP + 12] := MemL[0:LP + 4] + LbItemH(W);
        R := 1;
      End
      Else R := -1;
    { LB_SETITEMHEIGHT, LB_GETITEMHEIGHT }
    $1A0 :
      If LbExtra(W) <> 0 Then
      Begin
        MemL[0:Wnds^[W].Extra + LBItemMax * 8] := LP And $FFFF;
        MemL[0:Wnds^[W].Extra + LBItemMax * 8 + 4] := 1;
        InvalAll(W, True);
      End;
    $1A1 : R := LbItemH(W);
    { LB_FINDSTRING, LB_FINDSTRINGEXACT (sans chaines : la donnee) }
    $18F, $1A2 :
    Begin
      R := -1;
      For I := 0 To Wnds^[W].K1 - 1 Do
        If R < 0 Then
          If LbHasStr(W) Then
          Begin
            If (Msg = $18F) And (Pos(UpStr(APStr(LP)),
                UpStr(PStr(MemL[0:Wnds^[W].Extra + I * 4]))) = 1) Or
               (UpStr(APStr(LP)) =
                UpStr(PStr(MemL[0:Wnds^[W].Extra + I * 4]))) Then R := I;
          End
          Else If LbData(W, I) = LP Then R := I;
    End;
  Else
    LbMsg := False;
  End;
End;

{ Procedure des controles et des fenetres internes }
{ Boutons radio automatiques : decocher ceux du groupe de W. Le groupe
  (comme Windows) va du frere precedent qui a WS_GROUP (ou du premier)
  au frere suivant qui a WS_GROUP, dans l'ordre de creation }
Function RadioSib(I, W : LongInt) : Boolean;
Begin
  RadioSib := Wnds^[I].Used And (Wnds^[I].Parent = Wnds^[W].Parent) And
              IsChildW(I);
End;

Procedure RadioGroupOff(W : LongInt);
Var I, G : LongInt;
Begin
  G := W;
  I := W - 1;
  While ((Wnds^[G].Style And $20000) = 0) And (I >= 0) Do
  Begin
    If RadioSib(I, W) Then G := I;
    Dec(I);
  End;
  For I := G To MaxWnd - 1 Do
    If RadioSib(I, W) Then
    Begin
      If (I > G) And ((Wnds^[I].Style And $20000) <> 0) Then Exit;
      If (Wnds^[I].IKind = ikButton) And
         ((Wnds^[I].Style And BS_TYPEMASK) = BS_AUTORADIOBUTTON) Then
      Begin
        Wnds^[I].K1 := 0;
        InvalAll(I, True);
      End;
    End;
End;

Function KWndProc(W, Msg, WP, LP : LongInt) : LongInt;
Var Typ, I, N : LongInt; S : String;
Begin
  KWndProc := 0;
  If (Wnds^[W].IKind = ikDialog) And (Wnds^[W].DlgProc <> 0) And
     Not KillingApp Then
  Begin
    I := CallProc(Wnds^[W].DlgProc, HwndOf(W), Msg, WP, LP);
    If I <> 0 Then
    Begin
      If (Msg = WM_CTLCOLORMSGBOX) Or ((Msg > WM_CTLCOLORMSGBOX) And
         (Msg <= WM_CTLCOLORSTATIC)) Or (Msg = WM_INITDIALOG) Then
        KWndProc := I
      Else KWndProc := Wnds^[W].DlgResult;
      Exit;
    End;
    If Not Wnds^[W].Used Then Exit;
    If Msg = WM_CLOSE Then
    Begin
      PostMsgW(W, WM_COMMAND, IDCANCEL, 0);
      Exit;
    End;
    { WM_PAINT non traite : le fond est deja peint par le noyau (le
      redemander repeindrait sans fin) }
    If Msg = WM_PAINT Then
    Begin
      SetR(Wnds^[W].Upd, 0, 0, 0, 0);
      Exit;
    End;
  End;
  { controles : champ d'une ligne, barre de defilement, liste }
  If (Wnds^[W].IKind = ikEdit) And ((Wnds^[W].Style And 4) = 0) Then
    If EdMsg(W, Msg, WP, LP, N) Then
    Begin
      KWndProc := N;
      Exit;
    End;
  If Wnds^[W].IKind = ikScrollBar Then
    If SbMsg(W, Msg, WP, LP, N) Then
    Begin
      KWndProc := N;
      Exit;
    End;
  If Wnds^[W].IKind = ikListBox Then
    If LbMsg(W, Msg, WP, LP, N) Then
    Begin
      KWndProc := N;
      Exit;
    End;
  Case Msg Of
    WM_NCCREATE : KWndProc := 1;
    WM_CREATE :
      If Wnds^[W].IKind In [ikListBox, ikComboBox] Then Wnds^[W].K2 := -1;
    WM_CLOSE :
      If Not IsChildW(W) Then
      Begin
        If Wnds^[W].IKind = ikMsgBox Then MsgBoxEnd(W, IDCANCEL)
        Else If Wnds^[W].IKind = ikShutdown Then DialogAction(W, 1)
        Else If Wnds^[W].IKind = ikNotepad Then KCommand(cmNExit)
        Else If Wnds^[W].IKind = ikFileDlg Then FdClose(False)
        Else DestroyW(W);
      End;
    WM_SETTEXT :
    Begin
      WndSetTextA(W, LP);
      KWndProc := 1;
      If IsChildW(W) Then InvalAll(W, True) Else Wnds^[W].NeedNc := True;
    End;
    WM_GETTEXT :
    Begin
      Begin
        KWndProc := WndGetTextZ(W, LP, WP);
        If AnsiApp Then CvtZ(LP, -1, False);
      End;
    End;
    WM_GETTEXTLENGTH : KWndProc := WndTextLen(W);
    WM_PAINT : If IsChildW(W) Then DrawCtl(W);
    WM_SETFONT : Wnds^[W].Font := WP;
    WM_GETFONT : KWndProc := Wnds^[W].Font;
    WM_ENABLE : InvalAll(W, True);
    { STM_SETICON, STM_GETICON, STM_SETIMAGE, STM_GETIMAGE }
    $170, $172 :
    Begin
      KWndProc := Wnds^[W].Icon;
      If Msg = $170 Then Wnds^[W].Icon := WP Else Wnds^[W].Icon := LP;
      InvalAll(W, True);
    End;
    $171, $173 : KWndProc := Wnds^[W].Icon;
    BM_GETCHECK : KWndProc := Wnds^[W].K1;
    BM_SETCHECK :
    Begin
      Wnds^[W].K1 := WP;
      InvalAll(W, True);
    End;
    BM_GETSTATE : KWndProc := Wnds^[W].K1 Or (Wnds^[W].K2 Shl 2);
    WM_LBUTTONDOWN :
      If Wnds^[W].IKind = ikButton Then
      Begin
        Wnds^[W].K2 := 1;
        CaptureWin := W;
        InvalAll(W, True);
      End
      Else If Wnds^[W].IKind In [ikListBox, ikComboBox] Then
      Begin
        I := ((LP Shr 16) And $FFFF - 2) Div 16;
        If (I >= 0) And (I < Wnds^[W].K1) Then
        Begin
          Wnds^[W].K2 := I;
          InvalAll(W, True);
          Notify(W, 1);
        End;
      End;
    WM_LBUTTONUP :
      If (Wnds^[W].IKind = ikButton) And (Wnds^[W].K2 <> 0) Then
      Begin
        Wnds^[W].K2 := 0;
        If CaptureWin = W Then CaptureWin := -1;
        Typ := Wnds^[W].Style And BS_TYPEMASK;
        If Typ = BS_AUTOCHECKBOX Then Wnds^[W].K1 := 1 - Wnds^[W].K1;
        If Typ = BS_AUTORADIOBUTTON Then
        Begin
          RadioGroupOff(W);
          Wnds^[W].K1 := 1;
        End;
        InvalAll(W, True);
        Notify(W, BN_CLICKED);
      End;
    WM_LBUTTONDBLCLK :
      If Wnds^[W].IKind In [ikListBox, ikComboBox] Then Notify(W, 2);
    WM_CHAR :
      If Wnds^[W].IKind = ikEdit Then
      Begin
        If WP = 8 Then Delete(Wnds^[W].Text, Length(Wnds^[W].Text), 1)
        Else If (WP >= 32) And (Length(Wnds^[W].Text) < 120) Then
          Wnds^[W].Text := Wnds^[W].Text + Chr(WP);
        InvalAll(W, True);
        Notify(W, $300);
      End;
    LB_ADDSTRING, CB_ADDSTRING :
    Begin
      If LbHasStr(W) Then LBAdd(W, APStr(LP))
      Else LBInsert(W, -1, '', LP);
      KWndProc := Wnds^[W].K1 - 1;
      InvalAll(W, True);
    End;
    LB_RESETCONTENT, CB_RESETCONTENT :
    Begin
      LBClear(W);
      InvalAll(W, True);
    End;
    LB_SETCURSEL, CB_SETCURSEL :
    Begin
      Wnds^[W].K2 := WP;
      InvalAll(W, True);
    End;
    LB_GETCURSEL, CB_GETCURSEL : KWndProc := Wnds^[W].K2;
    LB_GETCOUNT, $146 : KWndProc := Wnds^[W].K1;
    LB_GETTEXT, $148 :
      If (WP >= 0) And (WP < Wnds^[W].K1) Then
      Begin
        If Not LbHasStr(W) Then
        Begin
          { liste sans chaines : la donnee de l'element }
          MemL[0:LP] := LbData(W, WP);
          KWndProc := 4;
        End
        Else
        Begin
          S := PStr(MemL[0:Wnds^[W].Extra + WP * 4]);
          If AnsiApp Then CvtStr(S, False);
          PutPStr(LP, S, 256);
          KWndProc := Length(S);
        End;
      End
      Else KWndProc := -1;
    LB_GETTEXTLEN, $149 :
      If (WP >= 0) And (WP < Wnds^[W].K1) Then
        If Not LbHasStr(W) Then KWndProc := 4
        Else KWndProc := StrLenZ(MemL[0:Wnds^[W].Extra + WP * 4])
      Else KWndProc := -1;
  End;
  N := 0;
End;

{ ------------------------------------------------------------------ }
{ Fautes du processeur                                               }
{ ------------------------------------------------------------------ }

Procedure KillApp; Forward;

Procedure KFault(Vec, Frame : LongInt);
Var Eip, Err, V, X : LongInt; Nm, S : String;
Begin
  { exception x87 en attente : effacee (FNCLEX), sinon la prochaine
    instruction du coprocesseur la redeclencherait dans le noyau }
  asm
    db 219,226
  end;
  V := Vec And 255;
  { erreur du coprocesseur (#MF, 16) detectee dans le noyau (FRSTOR,
    FNSAVE...) : elle vient d'un programme, le noyau continue }
  If (V = 16) And (MemL[0:Frame + 44] < $400000) Then
  Begin
    KLog('Exception x87 en attente effacee (EIP=' +
         HexStr(MemL[0:Frame + 44], 8) + ')');
    Exit;
  End;
  If Vec >= 256 Then
  Begin
    Err := MemL[0:Frame + 44];
    Eip := MemL[0:Frame + 48];
  End
  Else
  Begin
    Err := 0;
    Eip := MemL[0:Frame + 44];
  End;
  Case V Of
    0 : Nm := 'Division par zero';
    6 : Nm := 'Code operation invalide';
    13 : Nm := 'Protection generale';
    14 : Nm := 'Faute de page';
    3 : Nm := 'Point d''arret';
    16 : Nm := 'Erreur du coprocesseur (virgule flottante)';
  Else
    Nm := 'Exception ' + IntStr(V);
  End;
  S := Nm + ' EIP=' + HexStr(Eip, 8) + ' CS=' +
       HexStr(MemL[0:Frame + 48 + 4 * Ord(Vec >= 256)], 4)
       + ' ERR=' + HexStr(Err, 4) +
       ' EAX=' + HexStr(MemL[0:Frame + 40], 8) + ' EBX=' +
       HexStr(MemL[0:Frame + 28], 8) + ' ECX=' + HexStr(MemL[0:Frame + 36], 8)
       + ' EDX=' + HexStr(MemL[0:Frame + 32], 8) + ' ESI=' +
       HexStr(MemL[0:Frame + 16], 8) + ' EDI=' + HexStr(MemL[0:Frame + 12], 8)
       + ' EBP=' + HexStr(MemL[0:Frame + 20], 8) + ' ESP=' +
       HexStr(Frame + 56 + 4 * Ord(Vec >= 256), 8);
  If V = 14 Then
  Begin
    asm
      mov eax,cr2
      mov X,eax
    end;
    S := S + ' CR2=' + HexStr(X, 8);
  End;
  KLog('FAUTE (tache ' + IntStr(CurT) + ') ' + S);
  GlDumpRing;
  HeapCheck('faute');
  X := Frame + 56 + 4 * Ord(Vec >= 256);
  Nm := 'Pile :';
  For V := 0 To 11 Do Nm := Nm + ' ' + HexStr(MemL[0:X + V * 4], 8);
  KLog(Nm);
  { sous la pile, puis chaine des cadres EBP (8 niveaux) }
  Nm := 'Sous ESP :';
  For V := 12 DownTo 1 Do Nm := Nm + ' ' + HexStr(MemL[0:X - V * 4], 8);
  KLog(Nm);
  Nm := 'Cadres :';
  Eip := MemL[0:Frame + 20];
  For V := 0 To 7 Do
    If (Eip > $1000) And (Eip < MemTop - 8) Then
    Begin
      Nm := Nm + ' ' + HexStr(Eip, 8) + '>' + HexStr(MemL[0:Eip + 4], 8);
      Eip := MemL[0:Eip];
    End;
  KLog(Nm);
  If CurT >= 0 Then
    KLog('Tache ' + IntStr(CurT) + ' pile ' + HexStr(Threads[CurT].Stack, 8) +
         ' taille ' + HexStr(Threads[CurT].StackSz, 8));
  V := Vec And 255;
  HeapOwner := 0;
  If (CurT > 0) And Threads[CurT].IsApp Then
  Begin
    MsgBoxOpen(L('Erreur', 'Error', 'Fehler', 'Errore', 'Error'), L(
      'Ce programme va '#136'tre arr'#136't'#130' car il a effectu'#130' une '
      + 'op'#130'ration non conforme.',
      'This program has performed an illegal operation and '
      + 'will be shut down.', 'Dieses Programm hat eine ung'#129'ltige ' +
      'Operation durchgef'#129'hrt und wird geschlossen.',
      'Il programma ha eseguito un''operazione non valida e sar'#133' chiuso.',
      'Este programa ha efectuado una operaci'#162'n no v'#160'lida y se ' +
      'apagar'#160'.') + '|' + S, $10);
    KillApp;
    asm
      fninit
    end;
    { reprendre la tache 0 (le cadre de la faute est abandonne) }
    Threads[CurT].State := tsDead;
    X := 0;
    SwSave := LongInt(@X);
    SwNew := Threads[0].Esp;
    SwCr3P := LongInt(@ThrCr3[CurT]);
    SwCr3N := ThrCr3[0];
    ProcCtxSwap(ThrCurP[0]);
    CurT := 0;
    HeapOwner := ThrOwner[0];
    ThreadSetFs(0);
    SwitchCtx;
  End;
  { faute du noyau : ecran bleu }
  CursorErase;
  SetTarget(Back, 0, 0);
  FBar(0, 0, ScrW - 1, ScrH - 1, cNavy);
  OutBold(232, 120, ' Pasdows 95 ', cNavy);
  FBar(230, 118, 330, 136, cSilver);
  OutBold(234, 120, 'Pasdows', cNavy);
  WrapText(40, 170, 560, L('Une erreur fatale s''est produite dans ' +
           'VMM32.VXD. Le syst'#138'me est arr'#136't'#130'.',
           'A fatal exception has occurred in VMM32.VXD. The system is ' +
           'halted.', 'Ein schwerer Ausnahmefehler ist in VMM32.VXD ' +
           'aufgetreten.', 'Errore irreversibile in VMM32.VXD.',
           'Error grave en VMM32.VXD.'), cWhite, True);
  WrapText(40, 230, 560, S, cWhite, True);
  SetR(Dirty, 0, 0, ScrW, ScrH);
  LfbCopy(Dirty);
  HaltCpu;
End;

