{ Entree I du dossier systeme (racine du CD-ROM ou C:\WINDOWS) }
Function SysEntry(I : LongInt; Var Nm : String; Var IsDir : Boolean)
  : Boolean;
Var Lba, Size, Fl, Tm, Idx, K : LongInt;
Begin
  If SysDir = 'D:\' Then
  Begin
    SysEntry := IsoDirEntry(RootLba, RootSize, I, Nm, Lba, Size, Fl, Tm);
    IsDir := (Fl And 2) <> 0;
    Exit;
  End;
  SysEntry := False;
  Idx := 0;
  For K := 0 To I Do
    If Not FatDirEntry(Copy(SysDir, 1, Length(SysDir) - 1), 0, Idx) Then
      Exit;
  Nm := UpStr(FfShort);
  IsDir := (FfAttr And $10) <> 0;
  SysEntry := True;
End;

Procedure DeskBuild;
Var I, Lba, Size, Fl, Tm : LongInt; Nm : String; Dir : Boolean;
Begin
  DeskCnt := 0; ExeCnt := 0;
  DeskAdd(L('Poste de travail', 'My Computer', 'Arbeitsplatz',
            'Risorse del computer', 'Mi PC'), icComputer, cmComputer, '');
  DeskAdd(L('Corbeille', 'Recycle Bin', 'Papierkorb', 'Cestino',
            'Papelera de reciclaje'), icRecycle, cmRecycle, '');
  DeskAdd(L('Lisez-moi', 'Read Me', 'Liesmich', 'Leggimi', 'L'#130'ame'),
          icText, cmReadme, '');
  If PathInfo(CmdPath, Fl, Size, Tm, Lba, I) Then
    DeskAdd(PromptName, icDos, cmPrompt, CmdPath);
  { Paint (APPS\PAINT.PAS) : icone dediee }
  If PathInfo(SysDir + 'PAINT.EXE', Fl, Size, Tm, Lba, I) Then
    DeskAdd('Paint', icPaint, cmPaint, SysDir + 'PAINT.EXE');
  I := 0;
  While SysEntry(I, Nm, Dir) Do
  Begin
    If Not Dir And (Copy(Nm, Length(Nm) - 3, 4) = '.EXE') And
       (Nm <> 'COMMAND.EXE') And (Nm <> 'PAINT.EXE') And
       (ExeCnt < 16) Then
    Begin
      ExePaths[ExeCnt] := SysDir + Nm;
      DeskAdd(Copy(Nm, 1, Length(Nm) - 4), icApp, cmExeBase + ExeCnt,
              SysDir + Nm);
      Inc(ExeCnt);
    End;
    Inc(I);
  End;
End;

Procedure DeskPos(I : LongInt; Var X, Y : LongInt);
Var R : LongInt;
Begin
  { colonnes de icones aussi hautes que le bureau le permet }
  R := (TaskY - 8) Div 72;
  If R < 1 Then R := 1;
  X := 6 + (I Div R) * 84;
  Y := 8 + (I Mod R) * 72;
End;

Procedure SplitLabel(Const S : String; N : LongInt; Var A, B : String);
Var P, K : LongInt;
Begin
  A := S; B := '';
  If Length(S) <= N Then Exit;
  P := 0;
  For K := 1 To Min(N + 1, Length(S)) Do
    If S[K] = ' ' Then P := K;
  If P = 0 Then P := N + 1;
  A := Copy(S, 1, P - 1);
  B := Trim(Copy(S, P, 255));
  If Length(B) > N Then B := Copy(B, 1, N - 3) + '...';
End;

Procedure DrawLabel(X, Y, W : LongInt; Const S : String; Sel : Boolean;
                    Fg : LongInt);
Var A, B : String; K, Y2 : LongInt;
Begin
  SplitLabel(S, W Div 8, A, B);
  If B <> '' Then Y2 := Y + 31 Else Y2 := Y + 15;
  If Sel Then
  Begin
    K := Max(TextW(A), TextW(B));
    FBar(X + (W - K) Div 2 - 2, Y, X + (W + K) Div 2 + 1, Y2, cNavy);
    Fg := cWhite;
  End;
  OutCenter(X, X + W - 1, Y, A, Fg);
  If B <> '' Then OutCenter(X, X + W - 1, Y + 16, B, Fg);
End;

Procedure DeskDraw(R : TRect);
Var I, X, Y : LongInt; T : TRect; Fg : LongInt;
Begin
  SetTarget(Back, 0, 0);
  SetClip(R.L, R.T, R.R - 1, R.B - 1);
  FBar(R.L, R.T, R.R - 1, R.B - 1, DeskColor);
  If DeskColor = cSilver Then Fg := cBlack Else Fg := cWhite;
  For I := 0 To DeskCnt - 1 Do
  Begin
    DeskPos(I, X, Y);
    SetR(T, X, Y, X + 84, Y + 70);
    If RInter(T, T, R) Then
    Begin
      PaintIcon(DeskIco[I], X + 26, Y, 32);
      DrawLabel(X + 2, Y + 35, 80, DeskName[I], DeskSel = I, Fg);
    End;
  End;
  If DimOn Then
  Begin
    SetClip(R.L, R.T, R.R - 1, R.B - 1);
    Dither(R.L, R.T, R.R - 1, R.B - 1, cBlack, 0);
  End;
End;

Function DeskHit(PX, PY : LongInt) : LongInt;
Var I, X, Y : LongInt;
Begin
  DeskHit := -1;
  For I := 0 To DeskCnt - 1 Do
  Begin
    DeskPos(I, X, Y);
    If InRect(PX, PY, X + 22, Y, X + 61, Y + 33) Or
       InRect(PX, PY, X + 4, Y + 35, X + 79, Y + 66) Then
    Begin
      DeskHit := I;
      Exit;
    End;
  End;
End;

Procedure DeskRedraw(I : LongInt);
Var X, Y : LongInt;
Begin
  If I < 0 Then Exit;
  DeskPos(I, X, Y);
  MarkDirty(X, Y, X + 86, Y + 70);
End;

