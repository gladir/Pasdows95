Procedure GetStartupInfoA(P : LongInt);
Begin
  FillMem(P, 68, 0);
  MemL[0:P] := 68;
  MemL[0:P + 44] := 1;
  MemW[0:P + 48] := Procs^[CurProc].Show;
End;

Function GetStdHandle(N : LongInt) : LongInt;
Begin
  If (AppStdOut <> 0) And ((N = -11) Or (N = -12)) Then
  Begin
    GetStdHandle := AppStdOut;
    Exit;
  End;
  If (AppStdIn <> 0) And (N = -10) Then
  Begin
    GetStdHandle := AppStdIn;
    Exit;
  End;
  Case N Of
    -10 : GetStdHandle := HStdIn;
    -11 : GetStdHandle := HStdOut;
    -12 : GetStdHandle := HStdErr;
  Else
    GetStdHandle := INVALID_HANDLE;
  End;
End;

