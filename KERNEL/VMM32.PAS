  CurH = 19;
  CurShape : Array[0..18] Of String[12] = (
    'X           ', 'XX          ', 'XWX         ', 'XWWX        ',
    'XWWWX       ', 'XWWWWX      ', 'XWWWWWX     ', 'XWWWWWWX    ',
    'XWWWWWWWX   ', 'XWWWWWWWWX  ', 'XWWWWWWWWWX ', 'XWWWWWWXXXXX',
    'XWWWXWWX    ', 'XWWXXWWX    ', 'XWX  XWWX   ', 'XX   XWWX   ',
    'X     XWWX  ', '      XWWX  ', '       XX   ');
  WaitShape : Array[0..18] Of String[12] = (
    'XXXXXXXXXXX ', 'XWWWWWWWWWX ', ' XWWWWWWWX  ', ' XWWWWWWWX  ',
    ' XWXWXWXWX  ', ' XWWXWXWWX  ', '  XWWXWWX   ', '   XWWWX    ',
    '    XWX     ', '    XWX     ', '   XWWWX    ', '  XWWWWWX   ',
    ' XWWWXWWWX  ', ' XWWXWXWWX  ', ' XWXWXWXWX  ', ' XWWWWWWWX  ',
    'XWWWWWWWWWX ', 'XXXXXXXXXXX ', '            ');

  StaticRGB : Array[0..19] Of LongInt = (
    $000000, $800000, $008000, $808000, $000080, $800080, $008080,
    $C0C0C0, $C0DCC0, $A6CAF0,
    $FFFBF0, $A0A0A4, $808080, $FF0000, $00FF00, $FFFF00, $0000FF,
    $FF00FF, $00FFFF, $FFFFFF);

Type
  TSurf = Record
    Bits, W, H, Pitch : LongInt;
    Bpp : LongInt;     { 8 (indices), 15 (5-5-5), 16 (5-6-5), 24 ou 32 }
  End;

Var
  Lfb, LfbPitch : LongInt;
  { couleurs directes : l'ecran compose reste en 256 couleurs (Back,
    palette systeme) ; OutPal donne le pixel de la memoire video de
    chaque indice, refaite quand la palette change }
  OutPal    : Array[0..255] Of LongInt;
  OutPalChanged : Boolean;
  RMs, RPs, GMs, GPs, BMs, BPs : LongInt;  { tailles/positions R, V, B }
  { modes VESA (table d'IO.SYS en 0000:0600) }
  VmN       : LongInt;
  VmNum, VmW, VmH, VmBpp, VmPitch, VmLfb : Array[0..MaxVm - 1] Of LongInt;
  VmMask    : Array[0..MaxVm * 6 - 1] Of Byte;
  { VGA 16 couleurs (mode 12h, 4 plans) quand IO.SYS n'a pas trouve de
    mode VESA : l'ecran 256 couleurs (Back) est converti a la copie }
  VgaPlanar : Boolean;
  VgaMapChanged : Boolean;
  VgaMap    : Array[0..255] Of Byte;     { indice -> couleur VGA 0..15 }
  VgaP      : Array[0..319] Of Byte;     { 4 plans de 80 octets }
  VgaTmp    : Array[0..47] Of Byte;
  { VgaTab[K * 256 + I] : bits des 4 plans (un octet par plan) du pixel
    d'indice I en position K (0 = bit 7) d'un octet ; refaite quand
    VgaMap change }
  VgaTab    : Array[0..2047] Of LongInt;
  VgaTabOk  : Boolean;
  Back      : TSurf;
  { format des surfaces composees : 8 (palette systeme) ou celui de la
    carte en couleurs vraies (15, 16, 24, 32) }
  ScrFmt    : LongInt;
  ScrDirect : Boolean;   { ScrFmt est exactement le format de la carte }
  SysPal    : Array[0..767] Of Byte;       { R, G, B (8 bits) }
  SysX      : Array[0..255] Of LongInt;    { la meme en 00RRGGBB }
  PalVer    : LongInt;
  NcKey     : ^TLongArr;  { antememoire RGB -> indice (4096, tas) }
  NcVal     : ^TByteArr;
  NcVer     : ^TLongArr;
  { cible de dessin courante (coordonnees ecran, bornes incluses) }
  DS        : TSurf;
  DOX, DOY  : LongInt;
  ClipX1, ClipY1, ClipX2, ClipY2 : LongInt;
  { pointeur }
  CurX, CurY : LongInt;
  CurShownB  : Boolean;
  CurKind    : LongInt;      { 0 fleche, 1 sablier, 2 personnalise }
  CurHide    : LongInt;      { compteur de ShowCursor }
  CurCustom  : LongInt;      { curseur Win32 (bits AND/XOR 32x32) }
  CurHotX, CurHotY : LongInt;

{ Octets par point d'un format }
Function PxBytes(Bpp : LongInt) : LongInt;
Begin
  Case Bpp Of
    15, 16 : PxBytes := 2;
    24 : PxBytes := 3;
    32 : PxBytes := 4;
  Else
    PxBytes := 1;
  End;
End;

Function SurfNewF(Var S : TSurf; W, H, Bpp : LongInt) : Boolean;
Begin
  S.W := W; S.H := H; S.Bpp := Bpp;
  S.Pitch := (W * PxBytes(Bpp) + 3) And Not 3;
  S.Bits := KAlloc(S.Pitch * H + 16);
  SurfNewF := S.Bits <> 0;
End;

{ Surface au format de l'ecran }
Function SurfNew(Var S : TSurf; W, H : LongInt) : Boolean;
Begin
  If ScrFmt = 0 Then ScrFmt := 8;
  SurfNew := SurfNewF(S, W, H, ScrFmt);
End;

Procedure SurfFree(Var S : TSurf);
Begin
  If S.Bits <> 0 Then KFree(S.Bits);
  S.Bits := 0; S.W := 0; S.H := 0;
End;

{ Remplir N points de 32 ou 16 bits }
Procedure FillL(A, N, V : LongInt);
Begin
  If N <= 0 Then Exit;
  asm
    push edi
    mov edi,A
    mov ecx,N
    mov eax,V
    cld
    rep stosd
    pop edi
  end;
End;

Procedure FillW(A, N, V : LongInt);
Begin
  If N <= 0 Then Exit;
  asm
    push edi
    mov edi,A
    mov ecx,N
    mov eax,V
    cld
    rep stosw
    pop edi
  end;
End;

{ N points de valeur brute V a l'adresse A, au format Bpp }
Procedure FillRaw(A, N, V, Bpp : LongInt);
Var I : LongInt;
Begin
  Case Bpp Of
    32 : FillL(A, N, V);
    15, 16 : FillW(A, N, V);
    24 :
      For I := 0 To N - 1 Do
      Begin
        MemW[0:A + I * 3] := V;
        Mem[0:A + I * 3 + 2] := V Shr 16;
      End;
  Else
    FillMem(A, N, V);
  End;
End;

Procedure PutRaw(A, V, Bpp : LongInt);
Begin
  Case Bpp Of
    32 : MemL[0:A] := V;
    15, 16 : MemW[0:A] := V;
    24 :
    Begin
      MemW[0:A] := V;
      Mem[0:A + 2] := V Shr 16;
    End;
  Else
    Mem[0:A] := V;
  End;
End;

Function GetRaw(A, Bpp : LongInt) : LongInt;
Begin
  Case Bpp Of
    32 : GetRaw := MemL[0:A] And $FFFFFF;
    15, 16 : GetRaw := MemW[0:A];
    24 : GetRaw := MemW[0:A] Or (Mem[0:A + 2] Shl 16);
  Else
    GetRaw := Mem[0:A];
  End;
End;

{ Masque de tous les bits d'un point (ROP, inversion) }
Function RawMask(Bpp : LongInt) : LongInt;
Begin
  Case Bpp Of
    15 : RawMask := $7FFF;
    16 : RawMask := $FFFF;
    24, 32 : RawMask := $FFFFFF;
  Else
    RawMask := 255;
  End;
End;

{ ------------------------------------------------------------------ }
{ Palette systeme                                                    }
{ ------------------------------------------------------------------ }

Const
  { couleurs du pilote VGA de Windows, dans l'ordre de l'interface 16
    couleurs d'IO.SYS (1 bordeaux, 4 marine...) : le logo de demarrage
    qu'IO.SYS laisse a l'ecran garde ses couleurs }
  VgaRGB : Array[0..15] Of LongInt = (
    $000000, $800000, $008000, $808000, $000080, $800080, $008080,
    $C0C0C0, $808080, $FF0000, $00FF00, $FFFF00, $0000FF, $FF00FF,
    $00FFFF, $FFFFFF);

Procedure VgaInit;
Var I, B : LongInt;
Begin
  { attributs : plan i -> registre DAC i ; DAC 0..15 = couleurs VGA }
  B := Port[$3DA];
  For I := 0 To 15 Do
  Begin
    Port[$3C0] := I;
    Port[$3C0] := I;
  End;
  Port[$3C0] := $14;
  Port[$3C0] := 0;
  Port[$3C0] := $20;
  For I := 0 To 15 Do
  Begin
    Port[$3C8] := I;
    Port[$3C9] := ((VgaRGB[I] Shr 16) And 255) Shr 2;
    Port[$3C9] := ((VgaRGB[I] Shr 8) And 255) Shr 2;
    Port[$3C9] := (VgaRGB[I] And 255) Shr 2;
  End;
  { mode d'ecriture 0, sans Set/Reset ni rotation, tous les bits }
  Port[$3CE] := 1; Port[$3CF] := 0;
  Port[$3CE] := 3; Port[$3CF] := 0;
  Port[$3CE] := 5; Port[$3CF] := 0;
  Port[$3CE] := 8; Port[$3CF] := $FF;
  VgaMapChanged := True;
  VgaTabOk := False;
End;

{ Couleur VGA la plus proche de l'entree I de la palette systeme }
Procedure VgaMapSet(I : LongInt);
Var K, Best, D, BestD, DR, DG, DB : LongInt;
Begin
  Best := 0; BestD := $7FFFFFFF;
  For K := 0 To 15 Do
  Begin
    DR := SysPal[I * 3] - ((VgaRGB[K] Shr 16) And 255);
    DG := SysPal[I * 3 + 1] - ((VgaRGB[K] Shr 8) And 255);
    DB := SysPal[I * 3 + 2] - (VgaRGB[K] And 255);
    D := DR * DR + DG * DG + DB * DB;
    If D < BestD Then
    Begin
      BestD := D; Best := K;
    End;
  End;
  If VgaMap[I] <> Best Then
  Begin
    VgaMap[I] := Best;
    VgaMapChanged := True;
    VgaTabOk := False;
  End;
End;

Procedure VgaTabBuild;
Var K, I, C, Bit, V : LongInt;
Begin
  For K := 0 To 7 Do
  Begin
    Bit := $80 Shr K;
    For I := 0 To 255 Do
    Begin
      C := VgaMap[I]; V := 0;
      If (C And 1) <> 0 Then V := V Or Bit;
      If (C And 2) <> 0 Then V := V Or (Bit Shl 8);
      If (C And 4) <> 0 Then V := V Or (Bit Shl 16);
      If (C And 8) <> 0 Then V := V Or (Bit Shl 24);
      VgaTab[K * 256 + I] := V;
    End;
  End;
  VgaTabOk := True;
End;

{ Ecrire la ligne Y, octets B0..B1 (pixels B0*8..B1*8+7), depuis Src :
  pixels 8 bits a partir de B0*8 }
Procedure VgaWriteRow(Y, B0, B1, Src : LongInt);
Var N, TabA, PA, A : LongInt;
Begin
  If B0 < 0 Then B0 := 0;
  If B1 > 79 Then B1 := 79;
  If (B0 > B1) Or (Y < 0) Or (Y >= ScrH) Then Exit;
  If Not VgaTabOk Then VgaTabBuild;
  N := B1 - B0 + 1;
  TabA := LongInt(@VgaTab);
  PA := LongInt(@VgaP);
  { 8 pixels -> 4 octets de plans : 8 consultations de VgaTab (une table
    de 1024 octets par position), en assembleur - la version Pascal
    coutait environ 250 instructions par octet, ce qui laissait l'ecran
    noir de longues secondes au demarrage }
  asm
    push esi
    push edi
    push ebx
    mov esi,Src
    mov edi,PA
    mov ecx,N
    mov ebx,TabA
  @lp:
    movzx eax,byte ptr [esi]
    shl eax,2
    add eax,ebx
    mov edx,[eax]
    movzx eax,byte ptr [esi+1]
    shl eax,2
    add eax,ebx
    or edx,[eax+1024]
    movzx eax,byte ptr [esi+2]
    shl eax,2
    add eax,ebx
    or edx,[eax+2048]
    movzx eax,byte ptr [esi+3]
    shl eax,2
    add eax,ebx
    or edx,[eax+3072]
    movzx eax,byte ptr [esi+4]
    shl eax,2
    add eax,ebx
    or edx,[eax+4096]
    movzx eax,byte ptr [esi+5]
    shl eax,2
    add eax,ebx
    or edx,[eax+5120]
    movzx eax,byte ptr [esi+6]
    shl eax,2
    add eax,ebx
    or edx,[eax+6144]
    movzx eax,byte ptr [esi+7]
    shl eax,2
    add eax,ebx
    or edx,[eax+7168]
    mov [edi],dl
    mov [edi+80],dh
    shr edx,16
    mov [edi+160],dl
    mov [edi+240],dh
    add esi,8
    inc edi
    dec ecx
    jnz @lp
    pop ebx
    pop edi
    pop esi
  end;
  A := Lfb + Y * LfbPitch + B0;
  Port[$3C4] := 2;
  Port[$3C5] := 1;
  MoveMem(PA, A, N);
  Port[$3C5] := 2;
  MoveMem(PA + 80, A, N);
  Port[$3C5] := 4;
  MoveMem(PA + 160, A, N);
  Port[$3C5] := 8;
  MoveMem(PA + 240, A, N);
  Port[$3C5] := $0F;
End;

{ Pixel de la memoire video (couleurs directes) de l'indice I }
Procedure OutPalSet(I : LongInt);
Var R, G, B, V : LongInt;
Begin
  R := SysPal[I * 3]; G := SysPal[I * 3 + 1]; B := SysPal[I * 3 + 2];
  V := ((R Shr (8 - RMs)) Shl RPs) Or ((G Shr (8 - GMs)) Shl GPs) Or
       ((B Shr (8 - BMs)) Shl BPs);
  If OutPal[I] <> V Then
  Begin
    OutPal[I] := V;
    OutPalChanged := True;
  End;
End;

Procedure DacSet(I : LongInt);
Begin
  If VgaPlanar Then
  Begin
    VgaMapSet(I);
    Exit;
  End;
  If ScrBpp > 8 Then
  Begin
    OutPalSet(I);
    Exit;
  End;
  Port[$3C8] := I;
  Port[$3C9] := SysPal[I * 3] Shr 2;
  Port[$3C9] := SysPal[I * 3 + 1] Shr 2;
  Port[$3C9] := SysPal[I * 3 + 2] Shr 2;
End;

Procedure DacAll;
Var I : LongInt;
Begin
  For I := 0 To 255 Do DacSet(I);
End;

Procedure SysPalSet(I, R, G, B : LongInt);
Begin
  SysPal[I * 3] := R; SysPal[I * 3 + 1] := G; SysPal[I * 3 + 2] := B;
  SysX[I] := ((R And 255) Shl 16) Or ((G And 255) Shl 8) Or (B And 255);
End;

{ 20 couleurs statiques, cube 6x6x6 et gris au milieu }
Procedure DefaultPalette;
Var I, R, G, B, V : LongInt;
Begin
  For I := 0 To 9 Do
    SysPalSet(I, (StaticRGB[I] Shr 16) And 255, (StaticRGB[I] Shr 8) And 255,
              StaticRGB[I] And 255);
  For I := 10 To 19 Do
    SysPalSet(236 + I, (StaticRGB[I] Shr 16) And 255,
              (StaticRGB[I] Shr 8) And 255, StaticRGB[I] And 255);
  I := 10;
  For R := 0 To 5 Do
    For G := 0 To 5 Do
      For B := 0 To 5 Do
      Begin
        SysPalSet(I, R * 51, G * 51, B * 51);
        Inc(I);
      End;
  For V := 0 To 19 Do
  Begin
    SysPalSet(I, 10 + V * 12, 10 + V * 12, 10 + V * 12);
    Inc(I);
  End;
  Inc(PalVer);
  DacAll;
End;

{ Indice de la palette systeme le plus proche de R, G, B }
Function NearestIdx(R, G, B : LongInt) : LongInt;
Var Key, H, I, D, BestD, Best, DR, DG, DB : LongInt;
Begin
  Key := (R Shl 16) Or (G Shl 8) Or B;
  H := ((R * 7) Xor (G * 31) Xor (B * 131) Xor (R Shr 3)) And 4095;
  If (NcVer^[H] = PalVer) And (NcKey^[H] = Key) Then
  Begin
    NearestIdx := NcVal^[H];
    Exit;
  End;
  Best := 0; BestD := $7FFFFFFF;
  For I := 0 To 255 Do
  Begin
    DR := SysPal[I * 3] - R; DG := SysPal[I * 3 + 1] - G;
    DB := SysPal[I * 3 + 2] - B;
    D := DR * DR + DG * DG + DB * DB;
    If D < BestD Then
    Begin
      BestD := D; Best := I;
      If D = 0 Then Break;
    End;
  End;
  NcVer^[H] := PalVer; NcKey^[H] := Key; NcVal^[H] := Best;
  NearestIdx := Best;
End;

{ COLORREF (00BBGGRR) -> indice ; PALETTEINDEX (01xxxxxx) direct }
Function ColorIdx(C : LongInt) : LongInt;
Begin
  If (C Shr 24) = 1 Then ColorIdx := C And 255
  Else ColorIdx := NearestIdx(C And 255, (C Shr 8) And 255,
                              (C Shr 16) And 255);
End;

Function IdxColor(I : LongInt) : LongInt;
Begin
  IdxColor := SysPal[I * 3] Or (SysPal[I * 3 + 1] Shl 8) Or
              (SysPal[I * 3 + 2] Shl 16);
End;

{ ------------------------------------------------------------------ }
{ Couleurs vraies : conversions entre 00RRGGBB et les formats         }
{ ------------------------------------------------------------------ }

Const
  CDirect = $1000000;     { couleur directe 00RRGGBB (sinon un indice) }

{ 00RRGGBB -> point brut du format Bpp (8 : indice systeme proche) }
Function XToRaw(X, Bpp : LongInt) : LongInt;
Begin
  Case Bpp Of
    32, 24 : XToRaw := X And $FFFFFF;
    16 : XToRaw := ((X Shr 8) And $F800) Or ((X Shr 5) And $7E0) Or
                   ((X Shr 3) And $1F);
    15 : XToRaw := ((X Shr 9) And $7C00) Or ((X Shr 6) And $3E0) Or
                   ((X Shr 3) And $1F);
  Else
    XToRaw := NearestIdx((X Shr 16) And 255, (X Shr 8) And 255, X And 255);
  End;
End;

{ Point brut du format Bpp -> 00RRGGBB (8 : palette systeme) }
Function RawToX(V, Bpp : LongInt) : LongInt;
Var R, G, B : LongInt;
Begin
  Case Bpp Of
    32, 24 : RawToX := V And $FFFFFF;
    16 :
    Begin
      R := (V Shr 11) And 31; G := (V Shr 5) And 63; B := V And 31;
      RawToX := (((R Shl 3) Or (R Shr 2)) Shl 16) Or
                (((G Shl 2) Or (G Shr 4)) Shl 8) Or ((B Shl 3) Or (B Shr 2));
    End;
    15 :
    Begin
      R := (V Shr 10) And 31; G := (V Shr 5) And 31; B := V And 31;
      RawToX := (((R Shl 3) Or (R Shr 2)) Shl 16) Or
                (((G Shl 3) Or (G Shr 2)) Shl 8) Or ((B Shl 3) Or (B Shr 2));
    End;
  Else
    RawToX := SysX[V And 255];
  End;
End;

{ Couleur (indice ou CDirect) -> point brut du format Bpp }
Function RawOf(C, Bpp : LongInt) : LongInt;
Begin
  If (C And CDirect) <> 0 Then RawOf := XToRaw(C And $FFFFFF, Bpp)
  Else If Bpp = 8 Then RawOf := C And 255
  Else RawOf := XToRaw(SysX[C And 255], Bpp);
End;

{ COLORREF (00BBGGRR ; 01xxxxxx PALETTEINDEX) -> couleur directe }
Function DirOf(C : LongInt) : LongInt;
Begin
  If (C Shr 24) = 1 Then DirOf := C And 255
  Else DirOf := CDirect Or ((C And 255) Shl 16) Or (C And $FF00) Or
                ((C Shr 16) And 255);
End;

{ 00RRGGBB -> COLORREF }
Function XToCr(X : LongInt) : LongInt;
Begin
  XToCr := ((X Shr 16) And 255) Or (X And $FF00) Or ((X And 255) Shl 16);
End;

{ Format des surfaces composees d'apres le mode de la carte : celui de la
  carte si ses composantes sont usuelles, 32 bits sinon (converti a la
  copie) ; 8 bits en 256 couleurs et en VGA 16 couleurs }
Procedure ScrFmtSet;
Begin
  ScrDirect := True;
  If VgaPlanar Or (ScrBpp <= 8) Then ScrFmt := 8
  Else If (ScrBpp = 15) And (RMs = 5) And (RPs = 10) And (GMs = 5) And
          (GPs = 5) And (BMs = 5) And (BPs = 0) Then ScrFmt := 15
  Else If (ScrBpp = 16) And (RMs = 5) And (RPs = 11) And (GMs = 6) And
          (GPs = 5) And (BMs = 5) And (BPs = 0) Then ScrFmt := 16
  Else If (ScrBpp = 24) And (RMs = 8) And (RPs = 16) And (GMs = 8) And
          (GPs = 8) And (BMs = 8) And (BPs = 0) Then ScrFmt := 24
  Else
  Begin
    ScrFmt := 32;
    ScrDirect := (ScrBpp = 32) And (RMs = 8) And (RPs = 16) And
                 (GMs = 8) And (GPs = 8) And (BMs = 8) And (BPs = 0);
  End;
End;

