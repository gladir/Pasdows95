Function StartDocW(Hdc, P : LongInt) : LongInt;
Var D : Array[0..4] Of LongInt; B, C : TZBuf;
Begin
  FillMem(LongInt(@D), 20, 0);
  D[0] := 20;
  If P <> 0 Then
  Begin
    D[1] := WZ(MemL[0:P + 4], B);
    D[2] := WZ(MemL[0:P + 8], C);
  End;
  StartDocW := StartDocA(Hdc, LongInt(@D));
End;

