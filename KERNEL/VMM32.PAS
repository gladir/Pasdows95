Begin
  SysTab0 := L('G'#130'n'#130'ral', 'General', 'Allgemein', 'Generale',
               'General');
End;

Function SysTab1 : String;
Begin
  SysTab1 := L('Gestionnaire de p'#130'riph'#130'riques', 'Device Manager',
