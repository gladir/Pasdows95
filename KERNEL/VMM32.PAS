Var CX1, CY1, CX2, CY2 : LongInt;
Begin
  KClient(W, CX1, CY1, CX2, CY2);
  X1 := CX1 + 18; Y1 := CY1 + 66; X2 := CX2 - 18; Y2 := CY2 - 86;
  Vis := (Y2 - Y1 - 4) Div 18;
End;

{ Boutons Proprietes, Actualiser, Supprimer, Imprimer }
Procedure DmBtn(W, I : LongInt; Var X1, Y1, X2, Y2 : LongInt);
Var CX1, CY1, CX2, CY2 : LongInt;
Begin
  KClient(W, CX1, CY1, CX2, CY2);
