Function MenuNew : LongInt;
Var I : LongInt;
Begin
  MenuNew := 0;
  For I := 0 To MaxMenu - 1 Do
    If Not MenuUsed[I] Then
    Begin
      MenuUsed[I] := True;
      MenuNew := HMenuBase + I * 4;
      Exit;
    End;
End;

Function MenuIdx(H : LongInt) : LongInt;
Begin
  If (H >= HMenuBase) And (H < HMenuBase + MaxMenu * 4) And
     MenuUsed[(H - HMenuBase) Div 4] Then MenuIdx := (H - HMenuBase) Div 4
  Else MenuIdx := -1;
End;

Function CreateMenu : LongInt;
Begin
  CreateMenu := MenuNew;
End;

Function CreatePopupMenu : LongInt;
Begin
  CreatePopupMenu := MenuNew;
End;

{ N-ieme element d'un menu (par position) ; -1 si absent }
Function MItemAt(M, Pos0 : LongInt) : LongInt;
Var I, J, Best, BS, Last : LongInt;
Begin
  MItemAt := -1;
  Last := -1;
  For J := 0 To Pos0 Do
  Begin
    Best := -1; BS := $7FFFFFFF;
    For I := 0 To MaxMenuItem - 1 Do
      If MItemsP^[I].Used And (MItemsP^[I].Menu = M) And
         (MItemsP^[I].Seq > Last)
         And (MItemsP^[I].Seq < BS) Then
      Begin
        Best := I; BS := MItemsP^[I].Seq;
      End;
    If Best < 0 Then Exit;
    Last := BS;
    MItemAt := Best;
  End;
End;

Function MItemFind(M, Id, Flags : LongInt) : LongInt;
Var I : LongInt;
Begin
  If (Flags And MF_BYPOSITION) <> 0 Then
  Begin
    MItemFind := MItemAt(M, Id);
    Exit;
  End;
  MItemFind := -1;
  For I := 0 To MaxMenuItem - 1 Do
    If MItemsP^[I].Used And (MItemsP^[I].Menu = M) And
       (MItemsP^[I].Id = Id) Then
    Begin
      MItemFind := I;
      Exit;
    End;
End;

Function AppendMenuA(H, Flags, Id, Item : LongInt) : LongInt;
Var M, I : LongInt;
Begin
  AppendMenuA := 0;
  M := MenuIdx(H);
  If M < 0 Then Exit;
  For I := 0 To MaxMenuItem - 1 Do
    If Not MItemsP^[I].Used Then
    Begin
      MItemsP^[I].Used := True; MItemsP^[I].Menu := M;
      MItemsP^[I].Flags := Flags; MItemsP^[I].Id := Id;
      Inc(MSeq); MItemsP^[I].Seq := MSeq;
      If ((Flags And (MF_SEPARATOR Or 4 Or $100)) = 0) And (Item <> 0) Then
        MItemsP^[I].Text := Copy(PStr(Item), 1, 63)
      Else MItemsP^[I].Text := '';
      AppendMenuA := 1;
      Exit;
    End;
End;

Function InsertMenuA(H, Pos0, Flags, Id, Item : LongInt) : LongInt;
Begin
  InsertMenuA := AppendMenuA(H, Flags And Not MF_BYPOSITION, Id, Item);
End;

Function ModifyMenuA(H, Pos0, Flags, Id, Item : LongInt) : LongInt;
Var M, I : LongInt;
Begin
  ModifyMenuA := 0;
  M := MenuIdx(H);
  If M < 0 Then Exit;
  I := MItemFind(M, Pos0, Flags);
  If I < 0 Then Exit;
  MItemsP^[I].Flags := Flags And Not MF_BYPOSITION; MItemsP^[I].Id := Id;
  If ((Flags And (MF_SEPARATOR Or 4 Or $100)) = 0) And (Item <> 0) Then
    MItemsP^[I].Text := Copy(PStr(Item), 1, 63);
  ModifyMenuA := 1;
End;

Function DeleteMenu(H, Pos0, Flags : LongInt) : LongInt;
Var M, I : LongInt;
Begin
  DeleteMenu := 0;
  M := MenuIdx(H);
  If M < 0 Then Exit;
  I := MItemFind(M, Pos0, Flags);
  If I < 0 Then Exit;
  MItemsP^[I].Used := False;
  DeleteMenu := 1;
End;

Function RemoveMenu(H, Pos0, Flags : LongInt) : LongInt;
Begin
  RemoveMenu := DeleteMenu(H, Pos0, Flags);
End;

Function DestroyMenu(H : LongInt) : LongInt;
Var M, I : LongInt;
Begin
  DestroyMenu := 0;
  M := MenuIdx(H);
  If M < 0 Then Exit;
  For I := 0 To MaxMenuItem - 1 Do
    If MItemsP^[I].Used And (MItemsP^[I].Menu = M) Then
      MItemsP^[I].Used := False;
  MenuUsed[M] := False;
  DestroyMenu := 1;
End;

Function GetMenuItemCount(H : LongInt) : LongInt;
Var M, I, N : LongInt;
Begin
  M := MenuIdx(H);
  N := 0;
  If M >= 0 Then
    For I := 0 To MaxMenuItem - 1 Do
      If MItemsP^[I].Used And (MItemsP^[I].Menu = M) Then Inc(N);
  If M < 0 Then N := -1;
  GetMenuItemCount := N;
End;

Function GetMenuItemID(H, Pos0 : LongInt) : LongInt;
Var M, I : LongInt;
Begin
  GetMenuItemID := -1;
  M := MenuIdx(H);
  If M < 0 Then Exit;
  I := MItemAt(M, Pos0);
  If (I >= 0) And ((MItemsP^[I].Flags And MF_POPUP) = 0) Then
    GetMenuItemID := MItemsP^[I].Id;
End;

Function GetSubMenu(H, Pos0 : LongInt) : LongInt;
