Const
  MF_POPUP = $10; MF_SEPARATOR = $800; MF_BYPOSITION = $400;
  MF_CHECKED = 8; MF_GRAYED = 1; MF_DISABLED = 2;
  mnW32 = 1000;                  { menus du noyau : mnW32 + menu Win32 }
  cmW32Base = 100000;            { commande : cmW32Base + element }

Type
  TMenuItemR = Record
    Used  : Boolean;
    Menu  : LongInt;
    Flags : LongInt;
    Id    : LongInt;
    Seq   : LongInt;
    Text  : String[63];
  End;
  TMItemArr = Array[0..MaxMenuItem - 1] Of TMenuItemR;
  PMItemArr = ^TMItemArr;

Var
  MenuUsed  : Array[0..MaxMenu - 1] Of Boolean;
  { elements de menu : dans le tas (l'image du noyau doit finir sous
    00400000h, adresse de chargement des programmes Win32) }
  MItemsP   : PMItemArr;
  MSeq      : LongInt;
  MenuOwnerW : LongInt;          { fenetre qui recoit WM_COMMAND }
  MBarW, MBarOpen : LongInt;     { barre de menus deroulee (element) }
  MBarTogW, MBarTog : LongInt;   { menu ferme par le clic courant }
  TrackOn : Boolean;             { TrackPopupMenu en attente }
  TrackRes : LongInt;            { commande choisie }

Function MenuIdx(H : LongInt) : LongInt;
Begin
  If (H >= HMenuBase) And (H < HMenuBase + MaxMenu * 4) And
     MenuUsed[(H - HMenuBase) Div 4] Then MenuIdx := (H - HMenuBase) Div 4
  Else MenuIdx := -1;
End;

{ N-ieme element d'un menu (par position) ; -1 si absent }
Function MItemAt(M, Pos0 : LongInt) : LongInt;
Var I, J, Best, BS, Last : LongInt;
Begin
  MItemAt := -1;
  Last := -1;
  For J := 0 To Pos0 Do
  Begin
    Best := -1; BS := $7FFFFFFF;
    For I := 0 To MaxMenuItem - 1 Do
      If MItemsP^[I].Used And (MItemsP^[I].Menu = M) And
         (MItemsP^[I].Seq > Last)
         And (MItemsP^[I].Seq < BS) Then
      Begin
        Best := I; BS := MItemsP^[I].Seq;
      End;
    If Best < 0 Then Exit;
    Last := BS;
    MItemAt := Best;
  End;
End;

{ Elements d'un menu, dans l'ordre (rend leur nombre) }
Function MItemList(M : LongInt; Var L : Array Of LongInt) : LongInt;
Var I, J, K, N, T : LongInt;
Begin
  N := 0;
  For I := 0 To MaxMenuItem - 1 Do
    If MItemsP^[I].Used And (MItemsP^[I].Menu = M) And (N <= High(L)) Then
    Begin
      L[N] := I;
      Inc(N);
    End;
  For I := 1 To N - 1 Do
  Begin
    T := L[I]; J := I;
    While (J > 0) And (MItemsP^[L[J - 1]].Seq > MItemsP^[T].Seq) Do
    Begin
      L[J] := L[J - 1];
      Dec(J);
    End;
    L[J] := T;
  End;
  MItemList := N;
  K := 0;
End;

{ Texte affiche d'un element : sans les '&' (un '&&' donne '&') }
Function MText(I : LongInt) : String;
Var S, R : String; K : LongInt;
Begin
  S := MItemsP^[I].Text;
  R := '';
  K := 1;
  While K <= Length(S) Do
  Begin
    If S[K] = '&' Then Inc(K);
    If K <= Length(S) Then R := R + S[K];
    Inc(K);
  End;
  MText := R;
End;

{ La fenetre d'un programme a une barre de menus (menu non vide) }
Function HasMenuBar(W : LongInt) : Boolean;
Var M : LongInt;
Begin
  HasMenuBar := False;
  If (W < 0) Or IsChildW(W) Or (Wnds^[W].IKind <> ikNone) Then Exit;
  M := MenuIdx(Wnds^[W].Menu);
  If M < 0 Then Exit;
  HasMenuBar := MItemAt(M, 0) >= 0;
End;

{ Metriques du cadre selon le style }
Procedure CalcNc(W : LongInt);
Var B, T : LongInt;
Begin
  B := 0;
  If (Wnds^[W].Style And WS_THICKFRAME) <> 0 Then B := 4
  Else If ((Wnds^[W].Style And WS_DLGFRAME) <> 0) Or
          ((Wnds^[W].ExStyle And WS_EX_DLGMODALFRAME) <> 0) Then B := 3
  Else If (Wnds^[W].Style And WS_BORDER) <> 0 Then B := 1;
  If (Wnds^[W].ExStyle And WS_EX_CLIENTEDGE) <> 0 Then B := B + 2;
  T := B;
  If (Wnds^[W].Style And WS_CAPTION) = WS_CAPTION Then T := T + 19;
  If HasMenuBar(W) Then T := T + 20;
  Wnds^[W].CL := B; Wnds^[W].CT := T;
  Wnds^[W].CR := Max(B, Wnds^[W].W - B);
  Wnds^[W].CB := Max(T, Wnds^[W].H - B);
End;

{ Position ecran du coin superieur gauche de la fenetre }
Procedure WndScreenPos(W : LongInt; Var X, Y : LongInt);
Var P : LongInt;
Begin
  X := Wnds^[W].X; Y := Wnds^[W].Y;
  If IsChildW(W) Then
  Begin
    P := Wnds^[W].Parent;
    While P >= 0 Do
    Begin
      X := X + Wnds^[P].X + Wnds^[P].CL;
      Y := Y + Wnds^[P].Y + Wnds^[P].CT;
      If Not IsChildW(P) Then Break;
      P := Wnds^[P].Parent;
    End;
  End;
End;

Procedure WndScreenRect(W : LongInt; Var R : TRect);
Var X, Y : LongInt;
Begin
  WndScreenPos(W, X, Y);
  SetR(R, X, Y, X + Wnds^[W].W, Y + Wnds^[W].H);
End;

Procedure ClientScreenOrg(W : LongInt; Var X, Y : LongInt);
Begin
  WndScreenPos(W, X, Y);
  X := X + Wnds^[W].CL;
  Y := Y + Wnds^[W].CT;
End;

Function WndVisible(W : LongInt) : Boolean;
Begin
  WndVisible := False;
  While W >= 0 Do
  Begin
    If Not Wnds^[W].Visible Or Wnds^[W].Min Then Exit;
    If Not IsChildW(W) Then Break;
    W := Wnds^[W].Parent;
  End;
  WndVisible := W >= 0;
End;

{ Cible de dessin d'une fenetre : surface de l'ancetre, origine de la
  zone (client ou fenetre) dans cette surface et decoupage }
Function WndTarget(W : LongInt; Client : Boolean; Var S : TSurf;
                   Var OX, OY : LongInt; Var Clip : TRect) : Boolean;
Var T, X, Y, TX, TY, P, PX, PY : LongInt; R : TRect;
Begin
  WndTarget := False;
  If W < 0 Then Exit;
  T := TopOf(W);
  If (T < 0) Or (Wnds^[T].Surf.Bits = 0) Then Exit;
  S := Wnds^[T].Surf;
  WndScreenPos(W, X, Y);
  TX := Wnds^[T].X; TY := Wnds^[T].Y;
  If Client Then
  Begin
    OX := X - TX + Wnds^[W].CL; OY := Y - TY + Wnds^[W].CT;
    SetR(Clip, OX, OY, X - TX + Wnds^[W].CR, Y - TY + Wnds^[W].CB);
  End
  Else
  Begin
    OX := X - TX; OY := Y - TY;
    SetR(Clip, OX, OY, OX + Wnds^[W].W, OY + Wnds^[W].H);
  End;
  P := W;
  While IsChildW(P) And (Wnds^[P].Parent >= 0) Do
  Begin
    P := Wnds^[P].Parent;
    WndScreenPos(P, PX, PY);
    SetR(R, PX - TX + Wnds^[P].CL, PY - TY + Wnds^[P].CT,
         PX - TX + Wnds^[P].CR, PY - TY + Wnds^[P].CB);
    If Not RInter(Clip, Clip, R) Then SetR(Clip, 0, 0, 0, 0);
  End;
  SetR(R, 0, 0, S.W, S.H);
  If Not RInter(Clip, Clip, R) Then SetR(Clip, 0, 0, 0, 0);
  WndTarget := True;
End;

Procedure DirtyWnd(W : LongInt);
Var R : TRect;
Begin
  If W < 0 Then Exit;
  WndScreenRect(TopOf(W), R);
  MarkDirty(R.L, R.T, R.R, R.B);
End;

{ ------------------------------------------------------------------ }
{ Ordre Z des fenetres de premier niveau                             }
{ ------------------------------------------------------------------ }

Procedure ZRemove(W : LongInt);
Var I, J : LongInt;
Begin
  J := 0;
  For I := 0 To ZCnt - 1 Do
    If ZList[I] <> W Then
    Begin
      ZList[J] := ZList[I];
      Inc(J);
    End;
  ZCnt := J;
End;

{ Fenetre de premier niveau qui couvre tout l'ecran (jeu, diaporama) }
Function ZCovers(W : LongInt) : Boolean;
Begin
  ZCovers := Wnds^[W].Visible And Not IsChildW(W) And
             (Wnds^[W].X <= 0) And (Wnds^[W].Y <= 0) And
             (Wnds^[W].X + Wnds^[W].W >= ScrW) And
             (Wnds^[W].Y + Wnds^[W].H >= ScrH);
End;

{ Comme le shell de Windows : la fenetre mise au premier plan qui
  couvre tout l'ecran passe au-dessus de la barre des taches (toujours
  visible) ; une autre fenetre mise au premier plan la fait revenir }
Procedure ZFullScr(W : LongInt);
Var I, T : LongInt; Low : Boolean;
Begin
  If (ZTaskW < 0) Or (W = ZTaskW) Then Exit;
  If (Wnds^[W].ExStyle And WS_EX_TOPMOST) <> 0 Then Exit;
  If ZCovers(W) Then
  Begin
    ZRemove(W);
    ZList[ZCnt] := W;
    Inc(ZCnt);
    Exit;
  End;
  { la barre est-elle sous une fenetre ordinaire ? }
  T := -1; Low := False;
  For I := 0 To ZCnt - 1 Do
    If ZList[I] = ZTaskW Then T := I
    Else If (T >= 0) And
            ((Wnds^[ZList[I]].ExStyle And WS_EX_TOPMOST) = 0) Then
      Low := True;
  If Not Low Then Exit;
  ZRemove(ZTaskW);
  ZList[ZCnt] := ZTaskW;
  Inc(ZCnt);
  DirtyWnd(ZTaskW);
End;

{ Placer W au sommet (sous les fenetres toujours visibles) }
Procedure ZTop(W : LongInt);
Var I, P : LongInt;
Begin
  ZRemove(W);
  P := ZCnt;
  If (Wnds^[W].ExStyle And WS_EX_TOPMOST) = 0 Then
    While (P > 0) And ((Wnds^[ZList[P - 1]].ExStyle And WS_EX_TOPMOST) <> 0) Do
      Dec(P);
  For I := ZCnt DownTo P + 1 Do ZList[I] := ZList[I - 1];
  ZList[P] := W;
  Inc(ZCnt);
  ZFullScr(W);
End;

Procedure ZBottom(W : LongInt);
Var I : LongInt;
Begin
  ZRemove(W);
  For I := ZCnt DownTo 1 Do ZList[I] := ZList[I - 1];
  ZList[0] := W;
  Inc(ZCnt);
End;

{ Composer une zone de l'ecran : bureau puis fenetres (ordre Z) }
Procedure ComposeRect(R : TRect);
Var I, W, Y, S, D, N, X0, Y0, B : LongInt; WR, X : TRect;
Begin
  DeskDraw(R);
  For I := 0 To ZCnt - 1 Do
  Begin
    W := ZList[I];
    If Wnds^[W].Used And Wnds^[W].Visible And Not Wnds^[W].Min And
       (Wnds^[W].Surf.Bits <> 0) Then
    Begin
      SetR(WR, Wnds^[W].X, Wnds^[W].Y, Wnds^[W].X + Wnds^[W].W,
           Wnds^[W].Y + Wnds^[W].H);
      If RInter(X, R, WR) Then
      Begin
        B := PxBytes(Back.Bpp);
        N := (X.R - X.L) * B;
        X0 := X.L - Wnds^[W].X; Y0 := X.T - Wnds^[W].Y;
        S := Wnds^[W].Surf.Bits + Y0 * Wnds^[W].Surf.Pitch + X0 * B;
        D := Back.Bits + X.T * Back.Pitch + X.L * B;
        For Y := X.T To X.B - 1 Do
        Begin
          MoveMem(S, D, N);
          S := S + Wnds^[W].Surf.Pitch;
          D := D + Back.Pitch;
        End;
      End;
    End;
  End;
End;

{ ------------------------------------------------------------------ }
{ Cadre des fenetres (zone non client), a la maniere de Windows 95   }
{ ------------------------------------------------------------------ }

Function CapButtonCount(W : LongInt) : LongInt;
Begin
  If (Wnds^[W].Style And WS_SYSMENU) = 0 Then CapButtonCount := 0
  Else If (Wnds^[W].Style And (WS_MINIMIZEBOX Or WS_MAXIMIZEBOX)) = 0 Then
    CapButtonCount := 1
  Else CapButtonCount := 3;
End;

{ Bouton B (0 fermer, 1 agrandir, 2 reduire), coord. dans la fenetre }
Procedure CapBtnRect(W, B : LongInt; Var X1, Y1, X2, Y2 : LongInt);
Var Bd : LongInt;
Begin
  Bd := Wnds^[W].CL;
  If (Wnds^[W].ExStyle And WS_EX_CLIENTEDGE) <> 0 Then Bd := Bd - 2;
  X2 := Wnds^[W].W - Bd - 3;
  Y1 := Bd + 2;
  Y2 := Y1 + 13;
  If B >= 1 Then X2 := X2 - 18;
  If B >= 2 Then X2 := X2 - 16;
  X1 := X2 - 15;
End;

{ Ligne superieure de la barre de menus (dans la fenetre) }
Function MBarY(W : LongInt) : LongInt;
Begin
  If (Wnds^[W].ExStyle And WS_EX_CLIENTEDGE) <> 0 Then
    MBarY := Wnds^[W].CT - 22
  Else MBarY := Wnds^[W].CT - 20;
End;

{ Element de la barre de menus sous (OX, OY) (coord. dans la fenetre) ;
  IX : bord gauche de l'element }
Function MBarHit(W, OX, OY : LongInt; Var IX : LongInt) : LongInt;
Var L : Array[0..31] Of LongInt; N, I, X, Y, TW, Bd : LongInt;
Begin
  MBarHit := -1;
  Y := MBarY(W);
  If (OY < Y) Or (OY >= Y + 19) Then Exit;
  Bd := Wnds^[W].CL;
  If (Wnds^[W].ExStyle And WS_EX_CLIENTEDGE) <> 0 Then Bd := Bd - 2;
  N := MItemList(MenuIdx(Wnds^[W].Menu), L);
  X := Bd + 1;
  For I := 0 To N - 1 Do
  Begin
    TW := TextW(MText(L[I])) + 16;
    If X + TW > Wnds^[W].W - Bd Then
    Begin
      X := Bd + 1;
    End;
    If (OX >= X) And (OX < X + TW) Then
    Begin
      MBarHit := L[I];
      IX := X;
      Exit;
    End;
    X := X + TW;
  End;
End;

Procedure NcMenuBar(W, X0, Y0, Bd : LongInt);
Var L : Array[0..31] Of LongInt; N, I, X, Y, TW, C : LongInt; T : String;
Begin
  Y := Y0 + MBarY(W);
  FBar(X0 + Bd, Y, X0 + Wnds^[W].W - Bd - 1, Y + 19, cSilver);
  N := MItemList(MenuIdx(Wnds^[W].Menu), L);
  X := X0 + Bd + 1;
  For I := 0 To N - 1 Do
  Begin
    T := MText(L[I]);
    TW := TextW(T) + 16;
    If X + TW > X0 + Wnds^[W].W - Bd Then Break;
    If (MBarW = W) And (MBarOpen = L[I]) Then
      Edge(X, Y + 1, X + TW - 1, Y + 18, cGray, cWhite);
    If (MItemsP^[L[I]].Flags And 3) <> 0 Then
    Begin
      OutTxt(X + 9, Y + 3, T, cWhite);
      C := cGray;
    End
    Else C := cBlack;
    OutTxt(X + 8, Y + 2, T, C);
    X := X + TW;
  End;
End;

Procedure NcPaint(W : LongInt);
Var Bd, X0, Y0, WW, HH, B, I, X1, Y1, X2, Y2, D : LongInt;
    Active : Boolean; Fg, C : LongInt; T : String;
Begin
  If Wnds^[W].Surf.Bits = 0 Then Exit;
  Wnds^[W].NeedNc := False;
  X0 := Wnds^[W].X; Y0 := Wnds^[W].Y; WW := Wnds^[W].W; HH := Wnds^[W].H;
  SetTarget(Wnds^[W].Surf, X0, Y0);
  Bd := Wnds^[W].CL;
  If (Wnds^[W].ExStyle And WS_EX_CLIENTEDGE) <> 0 Then
  Begin
    Bd := Bd - 2;
    Edge(X0 + Bd, Y0 + Wnds^[W].CT - 2, X0 + WW - Bd - 1, Y0 + HH - Bd - 1,
         cGray, cWhite);
    Edge(X0 + Bd + 1, Y0 + Wnds^[W].CT - 1, X0 + WW - Bd - 2,
         Y0 + HH - Bd - 2, cBlack, cSilver);
  End;
  If Bd >= 2 Then
  Begin
    Edge(X0, Y0, X0 + WW - 1, Y0 + HH - 1, cSilver, cBlack);
    Edge(X0 + 1, Y0 + 1, X0 + WW - 2, Y0 + HH - 2, cWhite, cGray);
    For I := 2 To Bd - 1 Do
      Box(X0 + I, Y0 + I, X0 + WW - 1 - I, Y0 + HH - 1 - I, cSilver);
  End
  Else If Bd = 1 Then Box(X0, Y0, X0 + WW - 1, Y0 + HH - 1, cBlack);
  If HasMenuBar(W) Then NcMenuBar(W, X0, Y0, Bd);
  If (Wnds^[W].Style And WS_CAPTION) = WS_CAPTION Then
  Begin
    Active := (W = ActiveWin);
    If Active Then C := cNavy Else C := cGray;
    If Active Then Fg := cWhite Else Fg := cSilver;
    FBar(X0 + Bd, Y0 + Bd, X0 + WW - Bd - 1, Y0 + Bd + 17, C);
    HLine(X0 + Bd, X0 + WW - Bd - 1, Y0 + Bd + 18, cSilver);
    B := CapButtonCount(W);
    I := 4;
    If (Wnds^[W].Style And WS_SYSMENU) <> 0 Then
    Begin
      If Wnds^[W].IKind <> ikNone Then
        PaintIcon(Wnds^[W].K4, X0 + Bd + 2, Y0 + Bd + 1, 16)
      Else
        PaintIcon(icApp, X0 + Bd + 2, Y0 + Bd + 1, 16);
      I := 21;
    End;
    T := Fit(Wnds^[W].Text, WW - Bd * 2 - I - 4 - 18 * B);
    OutBold(X0 + Bd + I, Y0 + Bd + 1, T, Fg);
    For I := 0 To B - 1 Do
    Begin
      CapBtnRect(W, I, X1, Y1, X2, Y2);
      X1 := X1 + X0; X2 := X2 + X0; Y1 := Y1 + Y0; Y2 := Y2 + Y0;
      Raised(X1, Y1, X2, Y2, (PressWin = W) And (PressBtn = -1 - I));
      If (PressWin = W) And (PressBtn = -1 - I) Then D := 1 Else D := 0;
      X1 := X1 + D; Y1 := Y1 + D;
      Case I Of
        0 :
          For D := 0 To 6 Do
          Begin
            Pix(X1 + 4 + D, Y1 + 3 + D, cBlack);
            Pix(X1 + 5 + D, Y1 + 3 + D, cBlack);
            Pix(X1 + 10 - D, Y1 + 3 + D, cBlack);
            Pix(X1 + 11 - D, Y1 + 3 + D, cBlack);
          End;
        1 :
        Begin
          If (Wnds^[W].Style And WS_MAXIMIZEBOX) <> 0 Then C := cBlack
          Else C := cGray;
          If Wnds^[W].Max Then
          Begin
            Box(X1 + 6, Y1 + 2, X1 + 11, Y1 + 6, C);
            HLine(X1 + 6, X1 + 11, Y1 + 3, C);
            FBar(X1 + 3, Y1 + 5, X1 + 8, Y1 + 10, cSilver);
            Box(X1 + 3, Y1 + 5, X1 + 8, Y1 + 10, C);
            HLine(X1 + 3, X1 + 8, Y1 + 6, C);
          End
          Else
          Begin
            Box(X1 + 3, Y1 + 2, X1 + 11, Y1 + 10, C);
            HLine(X1 + 3, X1 + 11, Y1 + 3, C);
          End;
        End;
      Else
        If (Wnds^[W].Style And WS_MINIMIZEBOX) <> 0 Then C := cBlack
        Else C := cGray;
        FBar(X1 + 4, Y1 + 9, X1 + 9, Y1 + 10, C);
      End;
    End;
  End;
  DirtyWnd(W);
End;

