  For I := 0 To N - 1 Do
    If CallProc(Proc, M, Typ, ResEntId(Root, D + 16 + I * 8, B), Lp) = 0
    Then Exit;
End;

{ appel stdcall a 5 arguments }
Function CallProc5(P, A1, A2, A3, A4, A5 : LongInt) : LongInt;
Var R : LongInt;
Begin
  asm
    mov eax,A5
    push eax
    mov eax,A4
    push eax
    mov eax,A3
    push eax
    mov eax,A2
    push eax
    mov eax,A1
    push eax
    mov eax,P
    call eax
    mov R,eax
  end;
  CallProc5 := R;
End;

