Function ExpIcon(Nm : String; Fl : LongInt) : LongInt;
Var E : String;
Begin
  E := UpStr(Copy(Nm, Pos('.', Nm) + 1, 3));
  If Pos('(D:)', Nm) > 0 Then ExpIcon := icCdrom
  Else If Nm = CplName Then ExpIcon := icControl
  Else If (Pos(':)', Nm) > 0) And (Nm[Length(Nm)] = ')') And
          (Length(Nm) >= 4) And
          (FatVolOf(Copy(Nm, Length(Nm) - 2, 2)) >= 0) And
          (VolType[FatVolOf(Copy(Nm, Length(Nm) - 2, 2))] = NetT) Then
    ExpIcon := icNetDrv
  Else If (Pos(':)', Nm) > 0) And (Nm[Length(Nm)] = ')') Then
    ExpIcon := icHardDisk
  Else If (Fl And 2) <> 0 Then ExpIcon := icFolder
  Else If E = 'EXE' Then ExpIcon := ExeIcon(Nm)
  Else If E = 'COM' Then ExpIcon := icApp
  Else If (E = 'TXT') Or (E = 'BAT') Or (E = 'INI') Or (E = 'SYS') Then
    ExpIcon := icText
  Else If ItemIcon(Nm, Fl) <> icText Then ExpIcon := ItemIcon(Nm, Fl)
  Else ExpIcon := icDocs;
End;

{ ------------------------------------------------------------------ }
{ Explorateur Pasdows : arbre des dossiers a gauche (fenetre a deux     }
{ volets ; arbre dans le bloc Extra de la fenetre). Noeuds : Bureau    }
{ ('*'), Poste de travail (''), lecteurs ('C:'), dossiers ('C:\DIR') ; }
{ F : 1 deplie, 2 sans sous-dossier                                    }
{ ------------------------------------------------------------------ }

Const
  TreeMax = 256;
  TreeRow = 18;

Type
  TTNode = Record
    P : String[79];
    D, F : Byte;
  End;
  TTree = Record
    N, Top, Sel, Vis : LongInt;
    Nd : Array[0..TreeMax - 1] Of TTNode;
  End;
  PTree = ^TTree;

Function ExpTree(W : LongInt) : PTree;
Var T : PTree;
Begin
  Move(Wnds^[W].Extra, T, 4);
  ExpTree := T;
End;

{ Largeur du volet de l'arbre }
Function ExpTreeW(X1, X2 : LongInt) : LongInt;
Begin
  ExpTreeW := Max(110, Min(230, ((X2 - X1) * 2) Div 5));
End;

Function DriveName(D : Char) : String;
Var V : LongInt;
Begin
  V := FatVolOf(D + ':');
  If (V >= 0) And (VolType[V] = NetT) Then DriveName := NdLabel(V)
  Else If V >= 0 Then DriveName := Trim(VolLab^[V] + ' (' + D + ':)')
  Else If D = 'D' Then DriveName := Trim(VolLabel + ' (D:)')
  Else DriveName := '(' + D + ':)';
End;

{ Nom affiche d'un chemin de l'Explorateur }
Function PathTitle(Const P : String) : String;
Begin
  If P = '' Then
    PathTitle := L('Poste de travail', 'My Computer', 'Arbeitsplatz',
                   'Risorse del computer', 'Mi PC')
  Else If P = '*' Then
    PathTitle := L('Bureau', 'Desktop', 'Desktop', 'Desktop', 'Escritorio')
  Else If Length(P) = 2 Then PathTitle := DriveName(P[1])
  Else PathTitle := BaseName(P);
End;

{ Titre de la fenetre : Explorateur Pasdows - dossier (deux volets) ou
  nom du dossier (Poste de travail) }
Procedure ExpTitle(W : LongInt);
Var S : String;
Begin
  If Wnds^[W].Extra <> 0 Then
    S := L('Explorateur Pasdows', 'Pasdows Explorer', 'Pasdows-Explorer',
           'Esplora risorse Pasdows', 'Explorador de Pasdows') + ' - ' +
         PathTitle(Wnds^[W].KS)
  Else S := PathTitle(Wnds^[W].KS);
  Wnds^[W].Text := Copy(S, 1, 127);
  Wnds^[W].NeedNc := True;
  If TaskbarW >= 0 Then KRepaint(TaskbarW);
End;

Procedure TreeIns(T : PTree; At : LongInt; Const P : String; D : LongInt);
Var I : LongInt;
Begin
  If T^.N >= TreeMax Then Exit;
  For I := T^.N - 1 DownTo At Do T^.Nd[I + 1] := T^.Nd[I];
  T^.Nd[At].P := P; T^.Nd[At].D := D; T^.Nd[At].F := 0;
  Inc(T^.N);
  If T^.Sel >= At Then Inc(T^.Sel);
End;

{ Deplier le noeud I : ses sous-dossiers (par ordre alphabetique) ou,
  pour le Poste de travail, les lecteurs }
Procedure TreeExpand(T : PTree; I : LongInt);
Var K, J, N, M, Fl, Size, D : LongInt; Nm, P : String;
    Names : Array[0..63] Of String[40]; Tmp : String[40];
Begin
  If (T^.Nd[I].F And 3) <> 0 Then Exit;
  T^.Nd[I].F := T^.Nd[I].F Or 1;
  P := T^.Nd[I].P;
  If P = '*' Then Exit;
  If (P = 'C:') And (VolN = 0) Then
  Begin
    { disque virtuel en memoire : pas de parcours }
    T^.Nd[I].F := 2;
    Exit;
  End;
  N := 0; K := 0;
  While (N < 64) And ExpEntryP(P, K, Nm, Fl, Size) Do
  Begin
    If (Fl And 2) <> 0 Then
    Begin
      If P = '' Then Names[N] := ExpDrive(K) + ':'
      Else Names[N] := Copy(Nm, 1, 40);
      Inc(N);
    End;
    Inc(K);
  End;
  If P <> '' Then
    For J := 1 To N - 1 Do
    Begin
      Tmp := Names[J]; K := J - 1;
      While (K >= 0) And (UpStr(Names[K]) > UpStr(Tmp)) Do
      Begin
        Names[K + 1] := Names[K];
        Dec(K);
      End;
      Names[K + 1] := Tmp;
    End;
  D := T^.Nd[I].D + 1;
  M := 0;
  For J := 0 To N - 1 Do
    If P = '' Then
    Begin
      TreeIns(T, I + 1 + M, Names[J], D);
      { disque virtuel en memoire : sans dossier a deplier }
      If (Names[J] = 'C:') And (VolN = 0) Then T^.Nd[I + 1 + M].F := 2;
      Inc(M);
    End
    Else If Length(P) + 1 + Length(Names[J]) <= 79 Then
    Begin
      TreeIns(T, I + 1 + M, P + '\' + Names[J], D);
      Inc(M);
    End;
  If M = 0 Then T^.Nd[I].F := 2;
End;

Procedure TreeCollapse(T : PTree; I : LongInt);
Var J, K, D : LongInt;
Begin
  D := T^.Nd[I].D;
  J := I + 1;
  While (J < T^.N) And (T^.Nd[J].D > D) Do Inc(J);
  K := J - I - 1;
  If K > 0 Then
  Begin
    If (T^.Sel > I) And (T^.Sel < J) Then T^.Sel := I
    Else If T^.Sel >= J Then T^.Sel := T^.Sel - K;
    For J := I + 1 To T^.N - 1 - K Do T^.Nd[J] := T^.Nd[J + K];
    T^.N := T^.N - K;
  End;
  T^.Nd[I].F := T^.Nd[I].F And Not 1;
End;

Function TreeFind(T : PTree; Const P : String) : LongInt;
Var I, R : LongInt; U : String;
Begin
  R := -1; U := UpStr(P);
  For I := 0 To T^.N - 1 Do
    If (R < 0) And (UpStr(T^.Nd[I].P) = U) Then R := I;
  TreeFind := R;
End;

{ L'arbre suit le dossier affiche : branches depliees, noeud choisi
  visible }
Procedure TreeSync(W : LongInt);
Var T : PTree; P, Cur, Rest, C : String; I, J, K : LongInt;
Begin
  If Wnds^[W].Extra = 0 Then Exit;
  T := ExpTree(W);
  P := Wnds^[W].KS;
  I := TreeFind(T, '');
  If I < 0 Then Exit;
  If P <> '' Then
  Begin
    TreeExpand(T, I);
    Cur := Copy(P, 1, 2);
    J := TreeFind(T, Cur);
    If J >= 0 Then
    Begin
      I := J;
      Rest := Copy(P, 4, 255);
      While Rest <> '' Do
      Begin
        TreeExpand(T, I);
        K := Pos('\', Rest);
        If K = 0 Then K := Length(Rest) + 1;
        C := Copy(Rest, 1, K - 1);
        Rest := Copy(Rest, K + 1, 255);
        Cur := Cur + '\' + C;
        J := TreeFind(T, Cur);
        If J < 0 Then Rest := ''
        Else I := J;
      End;
    End;
  End;
  T^.Sel := I;
  If T^.Vis < 1 Then T^.Vis := 10;
  If T^.Sel < T^.Top Then T^.Top := T^.Sel;
  If T^.Sel >= T^.Top + T^.Vis Then T^.Top := T^.Sel - T^.Vis + 1;
End;

Procedure TreeInit(W : LongInt);
Var A : LongInt; T : PTree;
Begin
  A := KAlloc(SizeOf(TTree));
  If A = 0 Then Exit;
  Wnds^[W].Extra := A;
  T := ExpTree(W);
  T^.N := 0; T^.Top := 0; T^.Sel := 0; T^.Vis := 10;
  TreeIns(T, 0, '*', 0);
  T^.Nd[0].F := 1;
  TreeIns(T, 1, '', 1);
  TreeExpand(T, 1);
  TreeSync(W);
End;

{ Le noeud R a-t-il un frere apres lui au niveau D ? (traits) }
Function TreeNext(T : PTree; R, D : LongInt) : Boolean;
Var J : LongInt; Res : Boolean;
Begin
  Res := False;
  J := R + 1;
  While (J < T^.N) And (T^.Nd[J].D > D) Do Inc(J);
  If (J < T^.N) And (T^.Nd[J].D = D) Then Res := True;
  TreeNext := Res;
End;

Procedure DotV(X, Y1, Y2 : LongInt);
Var Y : LongInt;
Begin
  Y := Y1;
  While Y <= Y2 Do
  Begin
    If ((X + Y) And 1) = 0 Then Pix(X, Y, cGray);
    Inc(Y);
  End;
End;

Procedure DotH(X1, X2, Y : LongInt);
Var X : LongInt;
Begin
  For X := X1 To X2 Do
    If ((X + Y) And 1) = 0 Then Pix(X, Y, cGray);
End;

Procedure PaintTree(W, X1, Y1, X2, Y2 : LongInt);
Var T : PTree; Vis, R, Y, D, C, K, Ic, Fg, TY, XR, Dr : LongInt;
    Nm, P : String; Sb : Boolean;
Begin
  T := ExpTree(W);
  Sunken(X1, Y1, X2, Y2, cWhite);
  Vis := Max(1, (Y2 - Y1 - 4) Div TreeRow);
  T^.Vis := Vis;
  If T^.Top > Max(0, T^.N - Vis) Then T^.Top := Max(0, T^.N - Vis);
  If T^.Top < 0 Then T^.Top := 0;
  Sb := T^.N > Vis;
  XR := X2 - 2;
  If Sb Then XR := X2 - 19;
  SetClip(X1 + 2, Y1 + 2, XR, Y2 - 2);
  For R := T^.Top To Min(T^.N - 1, T^.Top + Vis - 1) Do
  Begin
    Y := Y1 + 2 + (R - T^.Top) * TreeRow;
    D := T^.Nd[R].D;
    P := T^.Nd[R].P;
    { traits pointilles des niveaux superieurs, puis vers l'icone }
    For K := 1 To D - 1 Do
      If TreeNext(T, R, K) Then
        DotV(X1 + 4 + K * 16 - 8, Y, Y + TreeRow - 1);
    C := X1 + 4 + D * 16 - 8;
    If D >= 1 Then
    Begin
      DotV(C, Y, Y + 8);
      If TreeNext(T, R, D) Then DotV(C, Y + 8, Y + TreeRow - 1);
      DotH(C, C + 7, Y + 8);
      If (T^.Nd[R].F And 2) = 0 Then
      Begin
        { case + / - }
        FBar(C - 4, Y + 4, C + 4, Y + 12, cWhite);
        Box(C - 4, Y + 4, C + 4, Y + 12, cGray);
        HLine(C - 2, C + 2, Y + 8, cBlack);
        If (T^.Nd[R].F And 1) = 0 Then VLine(C, Y + 6, Y + 10, cBlack);
      End;
    End;
    If P = '*' Then Ic := icDisplay
    Else If P = '' Then Ic := icComputer
    Else If Length(P) = 2 Then
    Begin
      Dr := FatVolOf(P);
      If (P[1] = 'D') And (Dr < 0) Then Ic := icCdrom
      Else If (Dr >= 0) And (VolType[Dr] = NetT) Then Ic := icNetDrv
      Else Ic := icHardDisk;
    End
    Else Ic := icFolder;
    PaintIcon(Ic, C + 8, Y + 1, 16);
    Nm := PathTitle(P);
    Fg := cBlack;
    If R = T^.Sel Then
    Begin
      FBar(C + 26, Y, C + 29 + TextW(Nm), Y + 16, cNavy);
      Fg := cWhite;
    End;
    OutTxt(C + 28, Y, Nm, Fg);
  End;
  SetClip(X1, Y1, X2, Y2);
  If Sb Then
  Begin
    FBar(X2 - 17, Y1 + 2, X2 - 2, Y2 - 2, cSilver);
    Raised(X2 - 17, Y1 + 2, X2 - 2, Y1 + 17, False);
    Arrow(X2 - 12, Y1 + 8, 2, cBlack);
    Raised(X2 - 17, Y2 - 17, X2 - 2, Y2 - 2, False);
    Arrow(X2 - 12, Y2 - 11, 1, cBlack);
    TY := Y1 + 18 + (T^.Top * (Y2 - Y1 - 52)) Div Max(1, T^.N - Vis);
    Raised(X2 - 17, TY, X2 - 2, TY + 16, False);
  End;
End;

{ Clic dans l'arbre : case +/- (deplier, replier), defilement ou choix
  du dossier affiche a droite (double-clic : deplie aussi) }
Procedure TreeMouse(W, X, Y, X1, Y1, X2, Y2 : LongInt; Dbl : Boolean);
Var T : PTree; R, D, C : LongInt; P : String;
Begin
  T := ExpTree(W);
  If (T^.N > T^.Vis) And (X >= X2 - 19) Then
  Begin
    If Y < Y1 + 18 Then Dec(T^.Top)
    Else If Y > Y2 - 18 Then Inc(T^.Top)
    Else If Y < (Y1 + Y2) Div 2 Then T^.Top := T^.Top - T^.Vis
    Else T^.Top := T^.Top + T^.Vis;
    If T^.Top > T^.N - T^.Vis Then T^.Top := T^.N - T^.Vis;
    If T^.Top < 0 Then T^.Top := 0;
    KRepaint(W);
    Exit;
  End;
  R := T^.Top + (Y - Y1 - 2) Div TreeRow;
  If (R < 0) Or (R >= T^.N) Then Exit;
  D := T^.Nd[R].D;
  C := X1 + 4 + D * 16 - 8;
  If (D >= 1) And (X >= C - 6) And (X <= C + 6) Then
  Begin
    If (T^.Nd[R].F And 1) <> 0 Then TreeCollapse(T, R)
    Else TreeExpand(T, R);
    KRepaint(W);
    Exit;
  End;
  If Dbl And (D >= 1) Then
  Begin
    If (T^.Nd[R].F And 1) <> 0 Then TreeCollapse(T, R)
    Else TreeExpand(T, R);
  End;
  P := T^.Nd[R].P;
  If P = '*' Then P := '';
  If (P = 'C:') And (VolN = 0) Then
  Begin
    KRepaint(W);
    Exit;
  End;
  T^.Sel := R;
  Wnds^[W].KS := P;
  Wnds^[W].K1 := -1; Wnds^[W].K2 := 0;
  ExpTitle(W);
  KRepaint(W);
End;

Procedure PaintExplorer(W : LongInt);
Var X1, Y1, X2, Y2, CX, CY, TW, I, X, Y, Fl, Size, Cols, N, NSel,
    SelBytes : LongInt;
    Nm, S, S2 : String; Tr : Boolean;
Begin
  NSel := 0; SelBytes := 0;
  KClient(W, X1, Y1, X2, Y2);
  Tr := Wnds^[W].Extra <> 0;
  TW := 0;
  If Tr Then
  Begin
    { en-tetes "Tous les dossiers" et "Contenu de", arbre a gauche }
    TW := ExpTreeW(X1, X2);
    FBar(X1, Y1, X2, Y1 + 21, cSilver);
    Raised(X1, Y1 + 1, X1 + TW, Y1 + 20, False);
    OutTxt(X1 + 4, Y1 + 3, Fit(L('Tous les dossiers', 'All Folders',
           'Alle Ordner', 'Tutte le cartelle', 'Todas las carpetas'),
           TW - 8), cBlack);
    Raised(X1 + TW + 3, Y1 + 1, X2, Y1 + 20, False);
    OutTxt(X1 + TW + 7, Y1 + 3, Fit(L('Contenu de ''', 'Contents of ''',
           'Inhalt von ''', 'Contenuto di ''', 'Contenido de ''') +
           PathTitle(Wnds^[W].KS) + '''', X2 - X1 - TW - 14), cBlack);
    FBar(X1 + TW + 1, Y1 + 22, X1 + TW + 2, Y2 - 22, cSilver);
    PaintTree(W, X1, Y1 + 22, X1 + TW, Y2 - 22);
    SetClip(X1, Y1, X2, Y2);
    CX := X1 + TW + 3; CY := Y1 + 22;
  End
  Else
  Begin
    FBar(X1, Y1, X2, Y1 + 29, cSilver);
    Raised(X1 + 4, Y1 + 4, X1 + 29, Y1 + 26, False);
    PaintIcon(icFolder, X1 + 8, Y1 + 7, 16);
    Arrow(X1 + 13, Y1 + 11, 2, cBlack);
    Sunken(X1 + 36, Y1 + 4, X2 - 4, Y1 + 26, cWhite);
    If Wnds^[W].KS = '' Then
      OutTxt(X1 + 42, Y1 + 7, PathTitle(''), cBlack)
    Else OutTxt(X1 + 42, Y1 + 7, Fit(Wnds^[W].KS, X2 - X1 - 50), cBlack);
    CX := X1; CY := Y1 + 30;
  End;
  Sunken(CX, CY, X2, Y2 - 22, cWhite);
  FBar(X1, Y2 - 21, X2, Y2, cSilver);
  Edge(X1, Y2 - 19, X2, Y2, cGray, cWhite);
  FBar(X1 + 1, Y2 - 18, X2 - 1, Y2 - 1, cSilver);
  Cols := Max(1, (X2 - CX - 8) Div 100);
  SetClip(CX + 2, CY + 2, X2 - 2, Y2 - 24);
  I := 0; N := 0; S := '';
  While ExpEntry(W, I, Nm, Fl, Size) Do
  Begin
    X := CX + 6 + (I Mod Cols) * 100;
    Y := CY + 6 + (I Div Cols) * 70 - Wnds^[W].K2 * 70;
    If (Y > CY - 70) And (Y < Y2) Then
    Begin
      PaintIcon(ExpIcon(Nm, Fl), X + 32, Y, 32);
      DrawLabel(X, Y + 34, 96, Nm, ExpIsSel(W, I), cBlack);
    End;
    If ExpIsSel(W, I) Then
    Begin
      Inc(NSel);
      If (Fl And 2) = 0 Then SelBytes := SelBytes + Size;
    End;
    If I = Wnds^[W].K1 Then
    Begin
      S := Nm;
      If (Fl And 2) = 0 Then S := S + ' : ' + IntStr(Size) + ' ' +
         L('octets', 'bytes', 'Byte', 'byte', 'bytes');
      If (Wnds^[W].KS = '') And VolSpaceSecs(ExpDrive(I), Fl, Size) Then
        S := L('Espace libre : ', 'Free Space: ', 'Freier Speicher: ',
               'Spazio libero: ', 'Espacio libre: ') + SizeShort(Fl) +
             L(', capacit'#130' : ', ', Capacity: ', ', Kapazit'#132't: ',
               ', capacit'#133': ', ', capacidad: ') + SizeShort(Size);
    End;
    Inc(I); Inc(N);
  End;
  SetClip(X1, Y1, X2, Y2);
  If NSel > 1 Then
    S := IntStr(NSel) + ' ' + L('objet(s) s'#130'lectionn'#130'(s)',
         'object(s) selected', 'Objekt(e) markiert', 'oggetti selezionati',
         'objeto(s) seleccionado(s)')
  Else If (Wnds^[W].K1 < 0) Or (NSel = 0) Then
    S := IntStr(N) + ' ' + L('objet(s)', 'object(s)', 'Objekt(e)',
                              'oggetti', 'objeto(s)');
  If Tr Then
  Begin
    { barre d'etat en deux parties : objets, espace libre du lecteur }
    OutTxt(X1 + 4, Y2 - 17, Fit(S, TW - 8), cBlack);
    Edge(X1 + TW + 3, Y2 - 19, X2, Y2, cGray, cWhite);
    S2 := '';
    If (Wnds^[W].KS <> '') And VolSpaceSecs(Wnds^[W].KS[1], Fl, Size) Then
      S2 := L('Espace disque libre : ', 'Disk free space: ',
              'Freier Speicher: ', 'Spazio libero: ',
              'Espacio libre: ') + SizeShort(Fl);
    { plusieurs elements choisis : leur taille }
    If NSel > 1 Then S2 := FpSize(SelBytes);
    OutTxt(X1 + TW + 7, Y2 - 17, Fit(S2, X2 - X1 - TW - 14), cBlack);
  End
  Else
  Begin
    If NSel > 1 Then S := S + ', ' + FpSize(SelBytes);
    OutTxt(X1 + 4, Y2 - 17, Fit(S, X2 - X1 - 8), cBlack);
  End;
End;

Procedure ExpOpenItem(W, I : LongInt);
Var Nm, P, E : String; Fl, Size : LongInt;
Begin
  If Not ExpEntry(W, I, Nm, Fl, Size) Then Exit;
  If Wnds^[W].KS = '' Then
  Begin
    If (I = 0) And (VolN = 0) And (DiskN > 0) Then
    Begin
      { disque dur sans volume FAT : proposer de le formater }
      FmtAskW := MsgBoxOpen(L('Poste de travail', 'My Computer',
        'Arbeitsplatz', 'Risorse del computer', 'Mi PC'), L(
        'Le disque dur (' + IntStr(DiskSecs[0] Div 2048) + ' Mo) n''est ' +
        'pas format'#130'. Voulez-vous le formater en FAT32 ? Toutes ses ' +
        'donn'#130'es seront effac'#130'es.',
        'The hard disk (' + IntStr(DiskSecs[0] Div 2048) + ' MB) is not ' +
        'formatted. Do you want to format it (FAT32)? All data on it ' +
        'will be erased.',
        'Die Festplatte ist nicht formatiert. Jetzt mit FAT32 ' +
        'formatieren? Alle Daten werden gel'#148'scht.',
        'Il disco non '#138' formattato. Formattarlo in FAT32? Tutti i dati ' +
        'verranno cancellati.',
        'El disco no est'#160' formateado. '#168'Desea formatearlo en FAT32? ' +
        'Se borrar'#160'n todos los datos.'), $34);
      Exit;
    End;
    If (I = 0) And (VolN = 0) Then
    Begin
      MsgBoxOpen(L('Poste de travail', 'My Computer', 'Arbeitsplatz',
                   'Risorse del computer', 'Mi PC'), L(
        'C: est un disque virtuel en m'#130'moire (C:\WINDOWS, C:\TEMP).',
        'C: is a virtual RAM disk (C:\WINDOWS, C:\TEMP).',
        'C: ist ein virtuelles RAM-Laufwerk.',
        'C: '#138' un disco virtuale in memoria.',
        'C: es un disco virtual en memoria.'), $40);
      Exit;
    End;
    If (I >= 2) And (ExpDrive(I) = #0) Then
    Begin
      RunExe('CONTROL.EXE', '');
      Exit;
    End;
    If I = 0 Then Wnds^[W].KS := 'C:'
    Else If I = 1 Then Wnds^[W].KS := 'D:'
    Else Wnds^[W].KS := ExpDrive(I) + ':';
  End
  Else
  Begin
    P := Wnds^[W].KS + '\' + Nm;
    If (Fl And 2) <> 0 Then Wnds^[W].KS := P
    Else
    Begin
      { programme, ou document selon son extension (ShellOpen : Aide,
        Lecteur MP3, Paint, Imaging, Navigateur, Bloc-notes) }
      If Not ShellOpen(P, '') Then NoteOpen(P);
      Exit;
    End;
  End;
  Wnds^[W].K1 := -1; Wnds^[W].K2 := 0;
  TreeSync(W);
  ExpTitle(W);
  KRepaint(W);
End;

Procedure ExpUp(W : LongInt);
Var P : LongInt;
Begin
  If Wnds^[W].KS = '' Then Exit;
  If Length(Wnds^[W].KS) <= 2 Then Wnds^[W].KS := ''
  Else
  Begin
    P := Length(Wnds^[W].KS);
    While (P > 0) And (Wnds^[W].KS[P] <> '\') Do Dec(P);
    Wnds^[W].KS := Copy(Wnds^[W].KS, 1, P - 1);
  End;
  Wnds^[W].K1 := -1; Wnds^[W].K2 := 0;
  TreeSync(W);
  ExpTitle(W);
  KRepaint(W);
End;

{ Clic droit dans l'arbre : selectionne le noeud et ouvre son menu
  (Ouvrir, Explorer, Proprietes) }
Procedure TreeRight(W, X, Y, Y1, Y2 : LongInt);
Var T : PTree; R : LongInt;
Begin
  T := ExpTree(W);
  R := T^.Top + (Y - Y1 - 2) Div TreeRow;
  If (R < 0) Or (R >= T^.N) Or (Y > Y2) Then Exit;
  TreeCtxP := T^.Nd[R].P;
  If (TreeCtxP <> '*') And (TreeCtxP <> 'C:') Or (VolN > 0) Then
  Begin
    T^.Sel := R;
    If TreeCtxP = '*' Then Wnds^[W].KS := '' Else Wnds^[W].KS := TreeCtxP;
    Wnds^[W].K1 := -1; Wnds^[W].K2 := 0;
    ExpTitle(W);
    KRepaint(W);
  End;
  ExpCtxW := W;
  CtxTreeComp := TreeCtxP = '';
  CloseMenus(0);
  OpenMenu(0, mnTreeCtx, X, Y, False);
End;

Procedure ExpMouse(W, Msg, X, Y : LongInt);
Var X1, Y1, X2, Y2, CX, CY, TW, Cols, I, Fl, Size : LongInt; Nm : String;
Begin
  If (Msg <> WM_LBUTTONDOWN) And (Msg <> WM_LBUTTONDBLCLK) And
     (Msg <> WM_RBUTTONDOWN) Then Exit;
  X := X + Wnds^[W].X + Wnds^[W].CL; Y := Y + Wnds^[W].Y + Wnds^[W].CT;
  KClient(W, X1, Y1, X2, Y2);
  If Wnds^[W].Extra <> 0 Then
  Begin
    TW := ExpTreeW(X1, X2);
    If InRect(X, Y, X1, Y1 + 22, X1 + TW, Y2 - 22) Then
    Begin
      If Msg <> WM_RBUTTONDOWN Then
        TreeMouse(W, X, Y, X1, Y1 + 22, X1 + TW, Y2 - 22,
                  Msg = WM_LBUTTONDBLCLK)
      Else TreeRight(W, X, Y, Y1 + 22, Y2 - 22);
      Exit;
    End;
    CX := X1 + TW + 3; CY := Y1 + 22;
  End
  Else
  Begin
    If (Msg <> WM_RBUTTONDOWN) And
       InRect(X, Y, X1 + 4, Y1 + 4, X1 + 29, Y1 + 26) Then
    Begin
      ExpUp(W);
      Exit;
    End;
    CX := X1; CY := Y1 + 30;
  End;
  Cols := Max(1, (X2 - CX - 8) Div 100);
  If (X < CX + 6) Or (Y < CY + 6) Then Exit;
  I := ((Y - CY - 6) Div 70 + Wnds^[W].K2) * Cols + (X - CX - 6) Div 100;
  If (X - CX - 6) Div 100 >= Cols Then Exit;
  If Not ExpEntry(W, I, Nm, Fl, Size) Then I := -1;
  If Msg = WM_RBUTTONDOWN Then
  Begin
    { menu contextuel d'un lecteur : Ouvrir, Formater, Proprietes ;
      un element hors de la selection devient le seul choisi }
    If (I < 0) Or Not ExpIsSel(W, I) Then
    Begin
      ExpSelW := -1;
      Wnds^[W].K1 := I;
      KRepaint(W);
    End
    Else If I <> Wnds^[W].K1 Then
    Begin
      Wnds^[W].K1 := I;
      KRepaint(W);
    End;
    ExpCtxW := W; ExpCtxI := I;
    CloseMenus(0);
    CtxNetDrv := #0;
    If (I >= 2) And (Wnds^[W].KS = '') And (ExpDrive(I) <> #0) Then
      If VolType[FatVolOf(ExpDrive(I) + ':')] = NetT Then
        CtxNetDrv := ExpDrive(I);
    If (I >= 0) And (Wnds^[W].KS = '') And (ExpDrive(I) = #0) Then
      RunExe('CONTROL.EXE', '')
    Else If (I >= 0) And (Wnds^[W].KS = '') Then
      OpenMenu(0, mnDrvCtx, X, Y, False)
    Else If Wnds^[W].KS = '' Then
      OpenMenu(0, mnMyComp, X, Y, False)
    Else If Wnds^[W].KS <> '' Then
    Begin
      { dossier : element (Ouvrir, Couper, Copier, Coller, Supprimer,
        Renommer, Selectionner tout, Proprietes) ou fond (Selectionner
        tout, Actualiser, Coller, Nouveau, Proprietes) ; CD-ROM : en
        lecture seule }
      NewWin := W; NewDir := Wnds^[W].KS; CtxPath := '';
      CtxRO := FatVolOf(Wnds^[W].KS) < 0;
      ExpGather(W);
      CtxSelN := OpN;
      If I >= 0 Then
      Begin
        CtxPath := Wnds^[W].KS + '\' + Nm;
        OpenMenu(0, mnIcon, X, Y, False);
      End
      Else OpenMenu(0, mnExpCtx, X, Y, False);
    End;
    Exit;
  End;
  If (Msg = WM_LBUTTONDBLCLK) And (I >= 0) Then ExpOpenItem(W, I)
  Else If (Msg = WM_LBUTTONDOWN) And (Wnds^[W].KS <> '') And (I >= 0) And
          ((KeyState[$11] And $80) <> 0) Then
  Begin
    { Ctrl+clic : ajouter ou retirer l'element }
    ExpSelSet(W, I, Not ExpIsSel(W, I));
    Wnds^[W].K1 := I;
    KRepaint(W);
  End
  Else If (Msg = WM_LBUTTONDOWN) And (Wnds^[W].KS <> '') And (I >= 0) And
          ((KeyState[$10] And $80) <> 0) And (Wnds^[W].K1 >= 0) Then
  Begin
    { Maj+clic : de l'element courant a celui-ci }
    FillMem(LongInt(@ExpSelB), 512, 0);
    ExpSelW := W; ExpSelD := Wnds^[W].KS;
    For Fl := Min(I, Wnds^[W].K1) To Max(I, Wnds^[W].K1) Do
      ExpSelSet(W, Fl, True);
    KRepaint(W);
  End
  Else If (I <> Wnds^[W].K1) Or ExpMulti(W) Then
  Begin
    ExpSelW := -1;
    Wnds^[W].K1 := I;
    KRepaint(W);
  End;
End;

{ ------------------------------------------------------------------ }
{ Bloc-notes (lecture et edition d'un fichier texte)                 }
{   K1 longueur, K2 curseur, K3 premiere ligne affichee, KS nom      }
{ ------------------------------------------------------------------ }

Const
  NoteMax = 60000;

Function NLineStart(B, P : LongInt) : LongInt;
Begin
  While (P > 0) And (Mem[0:B + P - 1] <> 13) Do Dec(P);
  NLineStart := P;
End;

Function NLineEnd(B, P, N : LongInt) : LongInt;
Begin
  While (P < N) And (Mem[0:B + P] <> 13) Do Inc(P);
  NLineEnd := P;
End;

Function KOpenFile(Name : String; Wr : Boolean; Disp : LongInt) : LongInt;
  Forward;
Function KWriteFile(H, Buf, N : LongInt) : LongInt; Forward;
Function CloseHandle(H : LongInt) : LongInt; Forward;
Procedure FdOpen(Mode, Owner : LongInt; Const Dir, Name : String); Forward;

{ Texte du Bloc-notes : CR seul en memoire, CR LF dans les fichiers.
  K1 longueur, K2 position du curseur, K3 debut de la premiere ligne
  affichee ; barre de menus de 20 points en haut de la zone client. }

Function NoteTitle : String;
Begin
  If NotePath = '' Then
    NoteTitle := L('Sans titre', 'Untitled', 'Unbenannt', 'Senza nome',
                   'Sin t'#161'tulo')
  Else NoteTitle := BaseName(NotePath);
End;

Procedure NoteSetTitle(W : LongInt);
Begin
  Wnds^[W].Text := NoteTitle + ' - ' + L('Bloc-notes', 'Notepad', 'Editor',
                  'Blocco note', 'Bloc de notas');
  Wnds^[W].NeedNc := True;
  TaskbarChanged;
End;

{ Charger le fichier Path (vide : nouveau document) }
Procedure NoteLoad(W : LongInt; Path : String);
Var A, Size, R, Wr, B : LongInt; CR : Boolean;
Begin
  B := Wnds^[W].Extra;
  Wnds^[W].K1 := 0; Wnds^[W].K2 := 0; Wnds^[W].K3 := 0;
  NoteSel := -1; NoteLeft := 0; NoteDirty := False;
  NoteUndoOk := False; NoteGroup := False;
  NotePath := '';
  If Path <> '' Then
  Begin
    A := LoadWholeFile(Path, Size);
    If A <> 0 Then
    Begin
      If Size > NoteMax Then Size := NoteMax;
      Wr := 0; CR := False;
      For R := 0 To Size - 1 Do
      Begin
        If Mem[0:A + R] = 13 Then
        Begin
          Mem[0:B + Wr] := 13; Inc(Wr); CR := True;
        End
        Else If Mem[0:A + R] = 10 Then
        Begin
          If Not CR Then Begin Mem[0:B + Wr] := 13; Inc(Wr) End;
          CR := False;
        End
        Else
        Begin
          If (Mem[0:A + R] <> 26) And (Mem[0:A + R] <> 0) Then
          Begin
            Mem[0:B + Wr] := Mem[0:A + R]; Inc(Wr);
          End;
          CR := False;
        End;
      End;
      KFree(A);
      Wnds^[W].K1 := Wr;
      NotePath := FullPath(Path);
    End
    Else
      MsgBoxOpen(L('Bloc-notes', 'Notepad', 'Editor', 'Blocco note',
                   'Bloc de notas'), L('Impossible d''ouvrir ', 'Cannot open ',
                   'Kann nicht '#148'ffnen: ', 'Impossibile aprire ',
                   'No se puede abrir ') + Path, $30);
  End;
  NoteSetTitle(W);
  KRepaint(W);
End;

Procedure NoteOpen(Path : String);
Var W, Own : LongInt;
Begin
  W := KFindKind(ikNotepad);
  If W < 0 Then
  Begin
    W := KCreate(ikNotepad, '', icNotepad, 110, 46, 480, 340,
                 WS_OVERLAPPED Or WS_CAPTION Or WS_SYSMENU Or WS_THICKFRAME
                 Or WS_MINIMIZEBOX Or WS_MAXIMIZEBOX, WS_EX_CLIENTEDGE);
    If W < 0 Then Exit;
    Own := HeapOwner; HeapOwner := 0;
    Wnds^[W].Extra := KAlloc(NoteMax + 16);
    If NoteUndoBuf = 0 Then NoteUndoBuf := KAlloc(NoteMax + 16);
    HeapOwner := Own;
  End;
  NoteLoad(W, Path);
  ShowW(W, True, True);
  ActivateW(W);
End;

{ Ecrire le texte dans Path (CR LF) ; False si impossible }
Function NoteWrite(W : LongInt; Path : String) : Boolean;
Var B, N, T, I, K, H, Own : LongInt; Ok : Boolean;
Begin
  NoteWrite := False; Ok := False;
  B := Wnds^[W].Extra; N := Wnds^[W].K1;
  Own := HeapOwner; HeapOwner := 0;
  T := KAlloc(N * 2 + 16);
  HeapOwner := Own;
  If T = 0 Then Exit;
  K := 0;
  For I := 0 To N - 1 Do
  Begin
    Mem[0:T + K] := Mem[0:B + I]; Inc(K);
    If Mem[0:B + I] = 13 Then
    Begin
      Mem[0:T + K] := 10; Inc(K);
    End;
  End;
  H := KOpenFile(Path, True, 2);
  If H <> INVALID_HANDLE Then
  Begin
    Ok := KWriteFile(H, T, K) = K;
    CloseHandle(H);
  End;
  KFree(T);
  NoteWrite := Ok;
  If Ok Then
  Begin
    NotePath := FullPath(Path);
    NoteDirty := False;
    NoteSetTitle(W);
  End
  Else
    MsgBoxOpen(L('Bloc-notes', 'Notepad', 'Editor', 'Blocco note',
               'Bloc de notas'), L('Impossible d''enregistrer ', 'Cannot ' +
               'save ', 'Kann nicht speichern: ', 'Impossibile salvare ',
               'No se puede guardar ') + Path + L(' (le CD-ROM D: est en ' +
               'lecture seule).', ' (CD-ROM D: is read-only).',
               ' (D: ist schreibgesch'#129'tzt).',
               ' (D: '#138' di sola lettura).',
               ' (D: es de s'#162'lo lectura).'), $30);
End;

Procedure NoteSelRange(W : LongInt; Var A, B : LongInt);
Begin
  A := Min(NoteSel, Wnds^[W].K2); B := Max(NoteSel, Wnds^[W].K2);
End;

{ Copie pour Annuler (debut d'un groupe de modifications) }
Procedure NoteSnap(W : LongInt);
Begin
  If NoteGroup Or (NoteUndoBuf = 0) Then Exit;
  MoveMem(Wnds^[W].Extra, NoteUndoBuf, Wnds^[W].K1);
  NoteUndoLen := Wnds^[W].K1; NoteUndoPos := Wnds^[W].K2;
  NoteUndoOk := True;
End;

Procedure NoteUndo(W : LongInt);
Var I, T, B : LongInt;
Begin
  If Not NoteUndoOk Then Exit;
  B := Wnds^[W].Extra;
  { echange : un second Annuler retablit }
  For I := 0 To Max(NoteUndoLen, Wnds^[W].K1) - 1 Do
  Begin
    T := Mem[0:B + I];
    Mem[0:B + I] := Mem[0:NoteUndoBuf + I];
    Mem[0:NoteUndoBuf + I] := T;
  End;
  T := Wnds^[W].K1; Wnds^[W].K1 := NoteUndoLen; NoteUndoLen := T;
  T := Wnds^[W].K2; Wnds^[W].K2 := Min(NoteUndoPos, Wnds^[W].K1);
  NoteUndoPos := T;
  NoteSel := -1; NoteDirty := True; NoteGroup := False;
End;

{ Supprimer la selection ; True s'il y en avait une }
Function NoteDelSel(W : LongInt) : Boolean;
Var A, B, Bf, N : LongInt;
Begin
  NoteDelSel := False;
  If NoteSel < 0 Then Exit;
  NoteSelRange(W, A, B);
  NoteSel := -1;
  If A = B Then Exit;
  Bf := Wnds^[W].Extra; N := Wnds^[W].K1;
  MoveMem(Bf + B, Bf + A, N - B);
  Wnds^[W].K1 := N - (B - A); Wnds^[W].K2 := A;
  NoteDirty := True;
  NoteDelSel := True;
End;

{ Inserer N caracteres de Src (texte CR LF : les LF sont retires) }
Procedure NoteInsert(W, Src, N : LongInt);
Var I, C, Bf, Len, P : LongInt;
Begin
  Bf := Wnds^[W].Extra;
  For I := 0 To N - 1 Do
  Begin
    C := Mem[0:Src + I];
    If (C = 10) Or (C = 0) Then Continue;
    Len := Wnds^[W].K1; P := Wnds^[W].K2;
    If Len >= NoteMax Then Exit;
    MoveMem(Bf + P, Bf + P + 1, Len - P);
    Mem[0:Bf + P] := C;
    Wnds^[W].K1 := Len + 1; Wnds^[W].K2 := P + 1;
  End;
  NoteDirty := True;
End;

{ Selection vers le presse-papiers (CR -> CR LF) }
Procedure NoteCopy(W : LongInt);
Var A, B, I, K, Own : LongInt;
Begin
  If NoteSel < 0 Then Exit;
  NoteSelRange(W, A, B);
  If ClipBuf <> 0 Then KFree(ClipBuf);
  Own := HeapOwner; HeapOwner := 0;
  ClipBuf := KAlloc((B - A) * 2 + 16);
  HeapOwner := Own;
  ClipLen := 0; ClipFN := 0;
  If ClipBuf = 0 Then Exit;
  K := 0;
  For I := A To B - 1 Do
  Begin
    Mem[0:ClipBuf + K] := Mem[0:Wnds^[W].Extra + I]; Inc(K);
    If Mem[0:Wnds^[W].Extra + I] = 13 Then
    Begin
      Mem[0:ClipBuf + K] := 10; Inc(K);
    End;
  End;
  Mem[0:ClipBuf + K] := 0;
  ClipLen := K;
End;

{ Le curseur reste visible (lignes et colonnes) }
Procedure NoteScroll(W : LongInt);
Var B, N, C, X1, Y1, X2, Y2, Rows, Cols, Ln, P, Col : LongInt;
Begin
  B := Wnds^[W].Extra; N := Wnds^[W].K1; C := Wnds^[W].K2;
  KClient(W, X1, Y1, X2, Y2);
  Rows := Max(1, (Y2 - Y1 - 24 - NoteStH) Div 16);
  Cols := Max(1, (X2 - X1 - 6) Div 8);
  If C < Wnds^[W].K3 Then Wnds^[W].K3 := NLineStart(B, C)
  Else
  Begin
    Ln := 0; P := Wnds^[W].K3;
    While P < NLineStart(B, C) Do
    Begin
      P := NLineEnd(B, P, N) + 1;
      Inc(Ln);
    End;
    While Ln >= Rows Do
    Begin
      Wnds^[W].K3 := NLineEnd(B, Wnds^[W].K3, N) + 1;
      Dec(Ln);
    End;
  End;
  Col := C - NLineStart(B, C);
  If Col < NoteLeft Then NoteLeft := Max(0, Col - 8);
  If Col >= NoteLeft + Cols Then NoteLeft := Col - Cols + 8;
End;

{ Titres de la barre de menus : position X (ecran) du titre I }
Function NoteMenuTitle(I : LongInt) : String;
Begin
  Case I Of
    0 : NoteMenuTitle := L('Fichier', 'File', 'Datei', 'File', 'Archivo');
    1 : NoteMenuTitle := L('Edition', 'Edit', 'Bearbeiten', 'Modifica',
                           'Edici'#162'n');
    2 : NoteMenuTitle := L('Recherche', 'Search', 'Suchen', 'Cerca',
                           'Buscar');
  Else
    NoteMenuTitle := '?';
  End;
End;

Function NoteMenuX(W, I : LongInt) : LongInt;
Var X1, Y1, X2, Y2, K, X : LongInt;
Begin
  KClient(W, X1, Y1, X2, Y2);
  X := X1 + 4;
  For K := 0 To I - 1 Do X := X + TextW(NoteMenuTitle(K)) + 16;
  NoteMenuX := X;
End;

{ Barre d'etat : position du curseur (ligne, colonne) et mode
  Insertion (INS) ou Refrappe (RFP) }
Procedure NoteStatus(W : LongInt);
Var X1, Y1, X2, Y2, B, C, I, Ln, Col, Y, X : LongInt; S : String;
Begin
  KClient(W, X1, Y1, X2, Y2);
  B := Wnds^[W].Extra; C := Wnds^[W].K2;
  Ln := 1;
  For I := 0 To C - 1 Do If Mem[0:B + I] = 13 Then Inc(Ln);
  Col := C - NLineStart(B, C) + 1;
  Y := Y2 - NoteStH + 1;
  FBar(X1, Y, X2, Y2, cSilver);
  HLine(X1, X2, Y, cWhite);
  S := L('Ln ', 'Ln ', 'Z ', 'Ri ', 'L'#161'n ') + IntStr(Ln) + ', ' +
       L('Col ', 'Col ', 'Sp ', 'Col ', 'Col ') + IntStr(Col);
  { cases en creux, a droite : position, puis mode }
  X := X2 - 44;
  Edge(X, Y + 3, X2 - 4, Y2 - 2, cGray, cWhite);
  If NoteOvr Then OutTxt(X + 6, Y + 3, L('RFP', 'OVR', 'UEB', 'SSC', 'SOB'),
                         cBlack)
  Else OutTxt(X + 6, Y + 3, L('INS', 'INS', 'EINF', 'INS', 'INS'), cBlack);
  Edge(X - 4 - (Length(S) * 8 + 12), Y + 3, X - 4, Y2 - 2, cGray, cWhite);
  OutTxt(X - (Length(S) * 8 + 10), Y + 3, S, cBlack);
End;

Procedure PaintNotepad(W : LongInt);
Var X1, Y1, X2, Y2, Rows, Cols, R, CC, B, N, P, E, Q, I, SA, SB, TX, Fg,
    Bg, Ch, MX, M : LongInt;
Begin
  KClient(W, X1, Y1, X2, Y2);
  { barre de menus }
  FBar(X1, Y1, X2, Y1 + 19, cSilver);
  HLine(X1, X2, Y1 + 19, cGray);
  M := -1;
  If (MenuDepth > 0) And (MenuW[0] >= 0) And Wnds^[MenuW[0]].Used Then
    If (Wnds^[MenuW[0]].K1 >= mnNFile) And (Wnds^[MenuW[0]].K1 <= mnNHelp) Then
      M := Wnds^[MenuW[0]].K1 - mnNFile;
  For I := 0 To 3 Do
  Begin
    MX := NoteMenuX(W, I);
    If I = M Then
      Edge(MX - 4, Y1 + 1, MX + TextW(NoteMenuTitle(I)) + 4, Y1 + 18, cGray,
           cWhite);
    OutTxt(MX, Y1 + 2, NoteMenuTitle(I), cBlack);
  End;
  FBar(X1, Y1 + 20, X2, Y2, cWhite);
  B := Wnds^[W].Extra; N := Wnds^[W].K1;
  NoteStatus(W);
  Rows := (Y2 - Y1 - 24 - NoteStH) Div 16;
  Cols := (X2 - X1 - 6) Div 8;
  SA := -1; SB := -1;
  If NoteSel >= 0 Then NoteSelRange(W, SA, SB);
  P := Wnds^[W].K3;
  For R := 0 To Rows - 1 Do
  Begin
    If P > N Then Exit;
    E := NLineEnd(B, P, N);
    Q := P + NoteLeft; CC := 0;
    While (Q < E) And (CC < Cols) Do
    Begin
      Ch := Mem[0:B + Q];
      If Ch < 32 Then Ch := 32;
      TX := X1 + 3 + CC * 8;
      If (Q >= SA) And (Q < SB) Then
      Begin
        FBar(TX, Y1 + 22 + R * 16, TX + 7, Y1 + 37 + R * 16, cNavy);
        Fg := cWhite;
      End
      Else Fg := cBlack;
      DrawChar(TX, Y1 + 22 + R * 16, Chr(Ch), Fg);
      Inc(Q); Inc(CC);
    End;
    { fin de ligne selectionnee }
    If (E >= SA) And (E < SB) And (E - P - NoteLeft >= 0) And
       (E - P - NoteLeft < Cols) Then
      FBar(X1 + 3 + (E - P - NoteLeft) * 8, Y1 + 22 + R * 16,
           X1 + 6 + (E - P - NoteLeft) * 8, Y1 + 37 + R * 16, cNavy);
    If (Wnds^[W].K2 >= P) And (Wnds^[W].K2 <= E) And (W = ActiveWin) Then
    Begin
      CC := Wnds^[W].K2 - P - NoteLeft;
      If (CC >= 0) And (CC <= Cols) Then
        If NoteOvr And (Wnds^[W].K2 < E) Then
        Begin
          { Refrappe : pave inverse sur le caractere }
          TX := X1 + 3 + CC * 8;
          FBar(TX, Y1 + 22 + R * 16, TX + 7, Y1 + 37 + R * 16, cBlack);
          Ch := Mem[0:B + Wnds^[W].K2];
          If Ch < 32 Then Ch := 32;
          DrawChar(TX, Y1 + 22 + R * 16, Chr(Ch), cWhite);
        End
        Else
          VLine(X1 + 3 + CC * 8, Y1 + 22 + R * 16, Y1 + 36 + R * 16,
                cBlack);
    End;
    P := E + 1;
  End;
End;

{ Position du texte sous le point (X, Y) de l'ecran }
Function NoteHit(W, X, Y : LongInt) : LongInt;
Var X1, Y1, X2, Y2, B, N, P, R, Col : LongInt;
Begin
  KClient(W, X1, Y1, X2, Y2);
  B := Wnds^[W].Extra; N := Wnds^[W].K1;
  R := (Y - Y1 - 22) Div 16;
  If Y < Y1 + 22 Then R := 0;
  P := Wnds^[W].K3;
  While (R > 0) And (NLineEnd(B, P, N) < N) Do
  Begin
    P := NLineEnd(B, P, N) + 1;
    Dec(R);
  End;
  Col := (X - X1 - 3 + 4) Div 8 + NoteLeft;
  If Col < 0 Then Col := 0;
  NoteHit := Min(P + Col, NLineEnd(B, P, N));
End;

Procedure NoteMouse(W, Msg, X, Y : LongInt);
Var X1, Y1, X2, Y2, I, MX : LongInt;
Begin
  X := X + Wnds^[W].X + Wnds^[W].CL; Y := Y + Wnds^[W].Y + Wnds^[W].CT;
  KClient(W, X1, Y1, X2, Y2);
  If (Msg = WM_LBUTTONDOWN) And (Y < Y1 + 20) Then
  Begin
    For I := 0 To 3 Do
    Begin
      MX := NoteMenuX(W, I);
      If InRect(X, Y, MX - 4, Y1, MX + TextW(NoteMenuTitle(I)) + 4,
                Y1 + 19) Then
      Begin
        CloseMenus(0);
        OpenMenu(0, mnNFile + I, MX - 4, Y1 + 19, False);
        KRepaint(W);
        Exit;
      End;
    End;
    Exit;
  End;
  If Msg = WM_LBUTTONDOWN Then
  Begin
    Wnds^[W].K2 := NoteHit(W, X, Y);
    NoteSel := Wnds^[W].K2;
    NoteGroup := False;
    CaptureWin := W;
    KRepaint(W);
  End
  Else If (Msg = WM_MOUSEMOVE) And (CaptureWin = W) Then
  Begin
    Wnds^[W].K2 := NoteHit(W, X, Y);
    NoteScroll(W);
    KRepaint(W);
  End
  Else If Msg = WM_LBUTTONUP Then
  Begin
    CaptureWin := -1;
    If NoteSel = Wnds^[W].K2 Then NoteSel := -1;
    KRepaint(W);
  End;
End;

{ Question "enregistrer les modifications ?" puis action Act (0 fermer,
  1 nouveau, 2 ouvrir) ; True si l'action peut avoir lieu tout de suite }
Function NoteAsk(W, Act : LongInt) : Boolean;
Begin
  NoteAsk := True;
  If Not NoteDirty Then Exit;
  NoteAsk := False;
  NoteAskAct := Act;
  NoteAskW := MsgBoxOpen(L('Bloc-notes', 'Notepad', 'Editor', 'Blocco note',
    'Bloc de notas'), L('Le texte du fichier ', 'The text in the ',
    'Der Text in der Datei ', 'Il testo del file ', 'El texto del archivo ') +
    NoteTitle + L(' a '#130't'#130' modifi'#130'.|Voulez-vous enregistrer ' +
    'les modifications'#255'?', ' file has changed.|Do you want to save the ' +
    'changes?', ' wurde ge'#132'ndert.|'#142'nderungen speichern?',
    #138' stato modificato.|Salvare le modifiche?',
    ' ha cambiado.|'#168'Desea guardar los cambios?'), $23);
End;

Procedure NoteDoAct(W, Act : LongInt);
Begin
  Case Act Of
    0 : DestroyW(W);
    1 : NoteLoad(W, '');
  Else
    FdOpen(0, 0, ParentDir(NotePath), '');
  End;
End;

{ Enregistrer (sous un nouveau nom si Ask ou sans nom) puis Act (-1) }
Procedure NoteSave(W : LongInt; Ask : Boolean; Act : LongInt);
Begin
  If Ask Or (NotePath = '') Then
  Begin
    NotePend := Act;
    If NotePath = '' Then FdOpen(1, 0, 'C:', '*.TXT')
    Else FdOpen(1, 0, ParentDir(NotePath), BaseName(NotePath));
    Exit;
  End;
  If NoteWrite(W, NotePath) And (Act >= 0) Then NoteDoAct(W, Act);
End;

{ Reponse a la question d'enregistrement }
Procedure NoteAskEnd(Res : LongInt);
Var W : LongInt;
Begin
  W := KFindKind(ikNotepad);
  If W < 0 Then Exit;
  If Res = IDYES Then NoteSave(W, False, NoteAskAct)
  Else If Res = IDNO Then NoteDoAct(W, NoteAskAct);
End;

Procedure NoteFindNext(W : LongInt; Quiet : Boolean);
Var B, N, P, I, K : LongInt; Ok : Boolean; C1, C2 : Char;
Begin
  If NoteFind = '' Then Exit;
  B := Wnds^[W].Extra; N := Wnds^[W].K1;
  P := Wnds^[W].K2;
  For I := P To N - Length(NoteFind) Do
  Begin
    Ok := True;
    For K := 1 To Length(NoteFind) Do
    Begin
      C1 := Chr(Mem[0:B + I + K - 1]); C2 := NoteFind[K];
      If Not NoteCase Then
      Begin
        C1 := UpCase(C1); C2 := UpCase(C2);
      End;
      If C1 <> C2 Then
      Begin
        Ok := False;
        Break;
      End;
    End;
    If Ok Then
    Begin
      NoteSel := I; Wnds^[W].K2 := I + Length(NoteFind);
      NoteGroup := False;
      NoteScroll(W);
      KRepaint(W);
      Exit;
    End;
  End;
  If Not Quiet Then
    MsgBoxOpen(L('Bloc-notes', 'Notepad', 'Editor', 'Blocco note',
               'Bloc de notas'), L('Impossible de trouver '#174' ',
               'Cannot find "', '"', 'Impossibile trovare "',
               'No se encuentra "') + NoteFind + L(' '#175'.', '".',
               '" nicht gefunden.', '".', '".'), $40);
End;

Procedure NoteKey(W, VK, Ch : LongInt);
Var B, N, C, LS, LE, Col, Old : LongInt; Sh, Ctl : Boolean; T : String;
Begin
  B := Wnds^[W].Extra; N := Wnds^[W].K1; C := Wnds^[W].K2;
  Sh := (KeyState[$10] And $80) <> 0;
  Ctl := (KeyState[$11] And $80) <> 0;
  { raccourcis }
  { Inser : mode Insertion / Refrappe ; Ctrl+Inser copie, Maj+Inser
    colle, Maj+Suppr coupe (comme Windows) }
  If VK = $2D Then
  Begin
    If Ctl Then KCommand(cmNCopy)
    Else If Sh Then KCommand(cmNPaste)
    Else
    Begin
      NoteOvr := Not NoteOvr;
      KRepaint(W);
    End;
    Exit;
  End;
  If (VK = $2E) And Sh And Not Ctl Then
  Begin
    KCommand(cmNCut);
    Exit;
  End;
  If Ctl Then
  Begin
    Case VK Of
      $41 : KCommand(cmNSelAll);
      $43 : KCommand(cmNCopy);
      $58 : KCommand(cmNCut);
      $56 : KCommand(cmNPaste);
      $5A : KCommand(cmNUndo);
      $4E : KCommand(cmNNew);
      $4F : KCommand(cmNOpen);
      $53 : KCommand(cmNSave);
      $46 : KCommand(cmNFind);
    End;
    Exit;
  End;
  If VK = $72 Then
  Begin
    NoteFindNext(W, False);
    Exit;
  End;
  If VK = $74 Then
  Begin
    KCommand(cmNTime);
    Exit;
  End;
  Old := C;
  Case VK Of
    $25, $27, $24, $23, $26, $28, $21, $22 :
    Begin
      Case VK Of
        $25 : If C > 0 Then Dec(C);
        $27 : If C < N Then Inc(C);
        $24 : C := NLineStart(B, C);
        $23 : C := NLineEnd(B, C, N);
        $26, $21 :
        Begin
          LS := NLineStart(B, C); Col := C - LS;
          If LS > 0 Then
          Begin
            LS := NLineStart(B, LS - 1); LE := NLineEnd(B, LS, N);
            C := Min(LS + Col, LE);
          End;
        End;
      Else
        Begin
          LS := NLineStart(B, C); Col := C - LS;
          LE := NLineEnd(B, C, N);
          If LE < N Then
          Begin
            LS := LE + 1; LE := NLineEnd(B, LS, N);
            C := Min(LS + Col, LE);
          End;
        End;
      End;
      If Sh Then
      Begin
        If NoteSel < 0 Then NoteSel := Old;
      End
      Else NoteSel := -1;
      Wnds^[W].K2 := C;
      NoteGroup := False;
    End;
    $2E :
    Begin
      NoteSnap(W); NoteGroup := False;
      If Not NoteDelSel(W) And (C < N) Then
      Begin
        MoveMem(B + C + 1, B + C, N - C - 1);
        Wnds^[W].K1 := N - 1;
        NoteDirty := True;
      End;
    End;
    8 :
    Begin
      NoteSnap(W); NoteGroup := True;
      If Not NoteDelSel(W) And (C > 0) Then
      Begin
        MoveMem(B + C, B + C - 1, N - C);
        Wnds^[W].K1 := N - 1; Wnds^[W].K2 := C - 1;
        NoteDirty := True;
      End;
    End;
  Else
    If (Ch = 13) Or ((Ch >= 32) And (Ch < 256)) Then
    Begin
      NoteSnap(W);
      { Refrappe : le caractere tape remplace celui du curseur (pas la
        fin de ligne) }
      If Not NoteDelSel(W) And NoteOvr And (Ch <> 13) And (C < N) And
         (Mem[0:B + C] <> 13) Then
      Begin
        MoveMem(B + C + 1, B + C, N - C - 1);
        Wnds^[W].K1 := N - 1;
      End;
      NoteGroup := True;
      T := Chr(Ch);
      NoteInsert(W, LongInt(@T[1]), 1);
    End
    Else Exit;
  End;
  NoteScroll(W);
  KRepaint(W);
End;

Procedure NoteCmd(Cmd : LongInt);
Var W, A, B, P : LongInt; T : String;
Begin
  W := KFindKind(ikNotepad);
  If W < 0 Then Exit;
  Case Cmd Of
    cmNNew : If NoteAsk(W, 1) Then NoteDoAct(W, 1);
    cmNOpen : If NoteAsk(W, 2) Then NoteDoAct(W, 2);
    cmNSave : NoteSave(W, False, -1);
    cmNSaveAs : NoteSave(W, True, -1);
    cmNExit : If NoteAsk(W, 0) Then NoteDoAct(W, 0);
    cmNUndo : NoteUndo(W);
    cmNCut :
      If NoteSel >= 0 Then
      Begin
        NoteCopy(W); NoteGroup := False; NoteSnap(W); NoteDelSel(W);
      End;
    cmNCopy : NoteCopy(W);
    cmNPaste :
      If ClipLen > 0 Then
      Begin
        NoteGroup := False; NoteSnap(W); NoteDelSel(W);
        NoteInsert(W, ClipBuf, ClipLen);
      End;
    cmNDel :
    Begin
      NoteGroup := False; NoteSnap(W); NoteDelSel(W);
    End;
    cmNSelAll :
    Begin
      NoteSel := 0; Wnds^[W].K2 := Wnds^[W].K1;
    End;
    cmNTime :
    Begin
      ReadRtc;
      T := Pad2(RtcHour) + ':' + Pad2(RtcMin) + ' ' + Pad2(RtcDay) + '/' +
           Pad2(RtcMonth) + '/' + IntStr(RtcYear);
      NoteGroup := False; NoteSnap(W); NoteDelSel(W);
      NoteInsert(W, LongInt(@T[1]), Length(T));
    End;
    cmNFind :
    Begin
      If (FindW >= 0) And Wnds^[FindW].Used And
         (Wnds^[FindW].IKind = ikFind) Then
        ActivateW(FindW)
      Else
      Begin
        FindW := KCreate(ikFind, L('Rechercher', 'Find', 'Suchen', 'Trova',
                         'Buscar'), icNotepad, Wnds^[W].X + 40, Wnds^[W].Y + 80,
                         380, 130, WS_POPUP Or WS_CAPTION Or WS_SYSMENU,
                         WS_EX_DLGMODALFRAME Or WS_EX_TOOLWINDOW);
        If FindW >= 0 Then
        Begin
          Wnds^[FindW].KS := NoteFind;
          ShowW(FindW, True, True);
        End;
      End;
      Exit;
    End;
    cmNFindNext : NoteFindNext(W, False);
