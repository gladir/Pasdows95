{ Contenu du dossier FdDir : dossiers puis fichiers du type choisi }
Procedure FdRefresh;
Var H, J : LongInt; Fd : Array[0..319] Of Byte; Pat, Nm : String;
    Dir : Boolean;
Begin
  FdN := 0; FdSel := -1; FdTop := 0;
  Pat := FdDir;
  If (Length(Pat) > 0) And (Pat[Length(Pat)] <> '\') Then Pat := Pat + '\';
  Pat := Pat + '*.*' + #0;
  H := FindFirstFileA(LongInt(@Pat[1]), LongInt(@Fd));
  If H = INVALID_HANDLE Then Exit;
  Repeat
    Nm := PStr(LongInt(@Fd) + 44);
    Dir := (MemL[0:LongInt(@Fd)] And $10) <> 0;
    If (Nm <> '.') And (Nm <> '..') And (Nm <> '') And
       (Dir Or MatchMask(UpStr(Nm), UpStr(FdMask))) And (FdN < 200) Then
    Begin
      { insertion triee : dossiers d'abord, puis par nom }
      J := FdN;
      While (J > 0) And ((Dir And Not FdIsDir[J - 1]) Or
            ((Dir = FdIsDir[J - 1]) And (UpStr(Nm) < UpStr(FdNm[J - 1])))) Do
      Begin
        FdNm[J] := FdNm[J - 1]; FdIsDir[J] := FdIsDir[J - 1];
        Dec(J);
      End;
      FdNm[J] := Nm; FdIsDir[J] := Dir;
      Inc(FdN);
    End;
  Until FindNextFileA(H, LongInt(@Fd)) = 0;
  FindClose(H);
End;

{ Mode 0 : Ouvrir, 1 : Enregistrer sous ; Owner 0 : Bloc-notes, 1 :
  programme (GetOpenFileName, attend FdDone) }
Procedure FdOpen(Mode, Owner : LongInt; Const Dir, Name : String);
Var T : String;
Begin
  If (FdW >= 0) And Wnds[FdW].Used And (Wnds[FdW].IKind = ikFileDlg) Then
    DestroyW(FdW);
  FdMode := Mode; FdOwner := Owner;
  FdDir := Dir;
  If FdDir = '' Then FdDir := 'C:';
  If (Length(FdDir) = 3) And (FdDir[3] = '\') Then FdDir := Copy(FdDir, 1, 2);
  FdDone := False; FdOk := False; FdResult := '';
  If Owner = 0 Then
  Begin
    FdFiltN := 2;
    FdFiltDesc[0] := L('Documents texte (*.txt)', 'Text Documents (*.txt)',
                       'Textdateien (*.txt)', 'Documenti di testo (*.txt)',
                       'Documentos de texto (*.txt)');
    FdFiltPat[0] := '*.TXT';
    FdFiltDesc[1] := L('Tous les fichiers (*.*)', 'All Files (*.*)',
                       'Alle Dateien (*.*)', 'Tutti i file (*.*)',
                       'Todos los archivos (*.*)');
    FdFiltPat[1] := '*.*';
    FdFiltI := 0;
    FdDefExt := 'TXT';
    FdTitle := '';
  End;
  If FdFiltN > 0 Then FdMask := FdFiltPat[FdFiltI] Else FdMask := '*.*';
  If (Pos('*', Name) > 0) Or (Pos('?', Name) > 0) Then FdName := ''
  Else FdName := Name;
  FdRefresh;
  If FdTitle <> '' Then T := FdTitle
  Else If Mode = 0 Then T := L('Ouvrir', 'Open', #148'ffnen', 'Apri', 'Abrir')
  Else T := L('Enregistrer sous', 'Save As', 'Speichern unter',
              'Salva con nome', 'Guardar como');
  FdW := KCreate(ikFileDlg, T, icFolder, Max(0, (ScrW - 480) Div 2),
                 Max(0, (TaskY - 310) Div 2), 480, 310,
                 WS_POPUP Or WS_CAPTION Or WS_SYSMENU,
                 WS_EX_DLGMODALFRAME Or WS_EX_TOOLWINDOW);
  If FdW < 0 Then
  Begin
    FdDone := True;
    Exit;
  End;
  ShowW(FdW, True, True);
End;

Procedure FdList(W : LongInt; Var X1, Y1, X2, Y2, Vis : LongInt);
Var CX1, CY1, CX2, CY2 : LongInt;
Begin
  KClient(W, CX1, CY1, CX2, CY2);
  X1 := CX1 + 10; Y1 := CY1 + 40; X2 := CX2 - 10; Y2 := CY1 + 196;
  Vis := (Y2 - Y1 - 4) Div 18;
End;

Procedure PaintFileDlg(W : LongInt);
Var X1, Y1, X2, Y2, LX1, LY1, LX2, LY2, Vis, I, Y, Fg, TY : LongInt;
    T : String;
Begin
  KClient(W, X1, Y1, X2, Y2);
  FBar(X1, Y1, X2, Y2, cSilver);
  If FdMode = 0 Then T := L('Regarder dans :', 'Look in:', 'Suchen in:',
                            'Cerca in:', 'Buscar en:')
  Else T := L('Enregistrer dans :', 'Save in:', 'Speichern in:', 'Salva in:',
              'Guardar en:');
  OutTxt(X1 + 10, Y1 + 12, T, cBlack);
  Sunken(X1 + 166, Y1 + 8, X2 - 44, Y1 + 30, cWhite);
  PaintIcon(icFolder, X1 + 170, Y1 + 11, 16);
  OutTxt(X1 + 190, Y1 + 11, Fit(FdDir + '\', X2 - X1 - 256), cBlack);
  Raised(X2 - 62, Y1 + 10, X2 - 46, Y1 + 28, False);
  Arrow(X2 - 57, Y1 + 17, 1, cBlack);
  { dossier parent }
  Raised(X2 - 38, Y1 + 8, X2 - 10, Y1 + 30, False);
  PaintIcon(icFolder, X2 - 32, Y1 + 11, 16);
  Arrow(X2 - 28, Y1 + 14, 2, cBlack);
  FdList(W, LX1, LY1, LX2, LY2, Vis);
  Sunken(LX1, LY1, LX2, LY2, cWhite);
  For I := FdTop To Min(FdN - 1, FdTop + Vis - 1) Do
  Begin
    Y := LY1 + 3 + (I - FdTop) * 18;
    If FdIsDir[I] Then PaintIcon(icFolder, LX1 + 4, Y, 16)
    Else PaintIcon(icText, LX1 + 4, Y, 16);
    Fg := cBlack;
    If I = FdSel Then
    Begin
      FBar(LX1 + 23, Y, LX1 + 26 + TextW(FdNm[I]), Y + 16, cNavy);
      Fg := cWhite;
    End;
    OutTxt(LX1 + 25, Y, Fit(FdNm[I], LX2 - LX1 - 50), Fg);
  End;
  If FdN > Vis Then
  Begin
    FBar(LX2 - 17, LY1 + 2, LX2 - 2, LY2 - 2, cSilver);
    Raised(LX2 - 17, LY1 + 2, LX2 - 2, LY1 + 17, False);
    Arrow(LX2 - 12, LY1 + 8, 2, cBlack);
    Raised(LX2 - 17, LY2 - 17, LX2 - 2, LY2 - 2, False);
    Arrow(LX2 - 12, LY2 - 11, 1, cBlack);
    TY := LY1 + 18 + (FdTop * (LY2 - LY1 - 52)) Div Max(1, FdN - Vis);
    Raised(LX2 - 17, TY, LX2 - 2, TY + 16, False);
  End;
  OutTxt(X1 + 10, Y1 + 210, L('Nom de fichier :', 'File name:',
         'Dateiname:', 'Nome file:', 'Nombre:'), cBlack);
  Sunken(X1 + 150, Y1 + 206, X2 - 110, Y1 + 228, cWhite);
  OutTxt(X1 + 154, Y1 + 209, Fit(FdName, X2 - X1 - 270), cBlack);
  VLine(X1 + 154 + TextW(Fit(FdName, X2 - X1 - 270)), Y1 + 208, Y1 + 225,
        cBlack);
  OutTxt(X1 + 10, Y1 + 240, L('Type :', 'Files of type:', 'Dateityp:',
         'Tipo:', 'Tipo:'), cBlack);
  Sunken(X1 + 150, Y1 + 236, X2 - 110, Y1 + 258, cWhite);
  If FdFiltN > 0 Then
    OutTxt(X1 + 154, Y1 + 239, Fit(FdFiltDesc[FdFiltI], X2 - X1 - 282),
           cBlack);
  Raised(X2 - 128, Y1 + 238, X2 - 112, Y1 + 256, False);
  Arrow(X2 - 123, Y1 + 245, 1, cBlack);
  For I := 0 To 1 Do
  Begin
    If I = 0 Then
    Begin
      If FdMode = 0 Then T := L('Ouvrir', 'Open', #148'ffnen', 'Apri', 'Abrir')
      Else T := L('Enregistrer', 'Save', 'Speichern', 'Salva', 'Guardar');
    End
    Else T := TxtCancel;
    PushButton(X2 - 100, Y1 + 206 + I * 30, X2 - 10, Y1 + 228 + I * 30, T,
               (PressWin = W) And (PressBtn = I), I = 0);
  End;
End;

Procedure FdClose(Ok : Boolean);
Var W : LongInt;
Begin
  FdOk := Ok; FdDone := True;
  If (FdW >= 0) And Wnds[FdW].Used Then DestroyW(FdW);
  FdW := -1;
  If FdOwner <> 0 Then Exit;
  W := KFindKind(ikNotepad);
  If W < 0 Then Exit;
  If Not Ok Then Exit;
  If FdMode = 0 Then NoteLoad(W, FdResult)
  Else If NoteWrite(W, FdResult) And (NotePend >= 0) Then
    NoteDoAct(W, NotePend);
  NotePend := -1;
End;

{ Ouvrir / Enregistrer : dossier, motif ou fichier }
Procedure FdAccept;
Var N, F : String; Attr, Size, Time, Lba, Ram : LongInt;
Begin
  N := Trim(FdName);
  If (N = '') And (FdSel >= 0) Then N := FdNm[FdSel];
  If N = '' Then Exit;
  If (Pos('*', N) > 0) Or (Pos('?', N) > 0) Then
  Begin
    FdMask := N; FdName := '';
    FdRefresh;
    Exit;
  End;
  If (Pos(':', N) > 0) Or ((Length(N) > 0) And (N[1] = '\')) Then
    F := FullPath(N)
  Else F := FullPath(FdDir + '\' + N);
  If PathInfo(F, Attr, Size, Time, Lba, Ram) And ((Attr And $10) <> 0) Then
  Begin
    FdDir := F;
    If Length(FdDir) = 3 Then FdDir := Copy(FdDir, 1, 2);
    FdName := '';
    FdRefresh;
    Exit;
  End;
  If FdMode = 0 Then
  Begin
    If Not PathInfo(F, Attr, Size, Time, Lba, Ram) Then
    Begin
      MsgBoxOpen(L('Ouvrir', 'Open', #148'ffnen', 'Apri', 'Abrir'), F + '|' +
        L('Fichier introuvable. V'#130'rifiez le nom du fichier.',
        'File not found. Please verify the correct file name was given.',
        'Datei nicht gefunden.', 'File non trovato.',
        'No se encuentra el archivo.'), $30);
      Exit;
    End;
  End
  Else If (Pos('.', BaseName(F)) = 0) And (FdDefExt <> '') Then
    F := F + '.' + FdDefExt;
  FdResult := F;
  FdClose(True);
End;

Procedure FileDlgMouse(W, Msg, X, Y : LongInt);
Var X1, Y1, X2, Y2, LX1, LY1, LX2, LY2, Vis, R, I : LongInt; Dbl : Boolean;
Begin
  X := X + Wnds[W].X + Wnds[W].CL; Y := Y + Wnds[W].Y + Wnds[W].CT;
  KClient(W, X1, Y1, X2, Y2);
  Dbl := Msg = WM_LBUTTONDBLCLK;
  If Dbl Then Msg := WM_LBUTTONDOWN;
  If Msg = WM_LBUTTONDOWN Then
  Begin
    If InRect(X, Y, X1 + 166, Y1 + 8, X2 - 44, Y1 + 30) Then
    Begin
      OpenMenu(0, mnFdDrives, X1 + 166, Y1 + 31, False);
      Exit;
    End;
    If InRect(X, Y, X2 - 38, Y1 + 8, X2 - 10, Y1 + 30) Then
    Begin
      If Length(FdDir) > 2 Then
      Begin
        FdDir := ParentDir(FdDir);
        If Length(FdDir) = 3 Then FdDir := Copy(FdDir, 1, 2);
        FdRefresh;
        KRepaint(W);
      End;
      Exit;
    End;
    If InRect(X, Y, X1 + 150, Y1 + 236, X2 - 110, Y1 + 258) Then
    Begin
      OpenMenu(0, mnFdTypes, X1 + 150, Y1 + 259, False);
      Exit;
    End;
    FdList(W, LX1, LY1, LX2, LY2, Vis);
    If InRect(X, Y, LX1, LY1, LX2, LY2) Then
    Begin
      If (FdN > Vis) And (X >= LX2 - 17) Then
      Begin
        If Y < (LY1 + LY2) Div 2 Then FdTop := Max(0, FdTop - Vis + 1)
        Else FdTop := Min(FdN - Vis, FdTop + Vis - 1);
        KRepaint(W);
        Exit;
      End;
      R := FdTop + (Y - LY1 - 3) Div 18;
      If (R >= 0) And (R < FdN) Then
      Begin
        If (R = FdSel) And (Dbl Or ((FdClickR = R) And
           (Ticks - FdClickT < 700))) Then
        Begin
          FdClickR := -1;
          FdName := FdNm[R];
          FdAccept;
          If (FdW >= 0) And Wnds[FdW].Used Then KRepaint(FdW);
          Exit;
        End;
        FdSel := R; FdClickR := R; FdClickT := Ticks;
        If Not FdIsDir[R] Then FdName := FdNm[R];
        KRepaint(W);
      End;
      Exit;
    End;
  End;
  For I := 0 To 1 Do
    If InRect(X, Y, X2 - 100, Y1 + 206 + I * 30, X2 - 10, Y1 + 228 + I * 30)
    Then
    Begin
      If Msg = WM_LBUTTONDOWN Then
      Begin
        PressWin := W; PressBtn := I; CaptureWin := W;
        KRepaint(W);
      End
      Else If (Msg = WM_LBUTTONUP) And (PressWin = W) And (PressBtn = I)
      Then
      Begin
        PressWin := -1; CaptureWin := -1;
        If I = 0 Then FdAccept Else FdClose(False);
        If (FdW >= 0) And Wnds[FdW].Used Then KRepaint(FdW);
      End;
      Exit;
    End;
  If Msg = WM_LBUTTONUP Then
  Begin
    If PressWin = W Then
    Begin
      PressWin := -1;
      KRepaint(W);
    End;
    CaptureWin := -1;
  End;
End;

Procedure FileDlgKey(W, VK, Ch : LongInt);
Var LX1, LY1, LX2, LY2, Vis : LongInt;
Begin
  FdList(W, LX1, LY1, LX2, LY2, Vis);
  Case VK Of
    $0D : FdAccept;
    $1B : FdClose(False);
    8 : Delete(FdName, Length(FdName), 1);
    $26, $28 :
    Begin
      If VK = $26 Then FdSel := Max(0, FdSel - 1)
      Else FdSel := Min(FdN - 1, FdSel + 1);
      If (FdSel >= 0) And Not FdIsDir[FdSel] Then FdName := FdNm[FdSel];
      If FdSel < FdTop Then FdTop := FdSel;
      If FdSel >= FdTop + Vis Then FdTop := FdSel - Vis + 1;
    End;
  Else
    If (Ch >= 32) And (Ch < 256) And (Length(FdName) < 60) Then
      FdName := FdName + Chr(Ch);
  End;
  If (FdW >= 0) And Wnds[FdW].Used Then KRepaint(FdW);
End;

{ Reorganiser les icones du bureau (Poste de travail et Corbeille
  restent en tete, comme sous Windows 95) : par nom ou par type }
Procedure DeskArrange(ByType : Boolean);
Var I, J, K : LongInt; N, P : String; Swap : Boolean;
Begin
  For I := 2 To DeskCnt - 2 Do
    For J := 2 To DeskCnt - 2 - (I - 2) Do
    Begin
      If ByType And (DeskIco[J] <> DeskIco[J + 1]) Then
        Swap := DeskIco[J] > DeskIco[J + 1]
      Else Swap := UpStr(DeskName[J]) > UpStr(DeskName[J + 1]);
      If Swap Then
      Begin
        N := DeskName[J]; DeskName[J] := DeskName[J + 1];
        DeskName[J + 1] := N;
        P := DeskPath[J]; DeskPath[J] := DeskPath[J + 1];
        DeskPath[J + 1] := P;
        K := DeskIco[J]; DeskIco[J] := DeskIco[J + 1]; DeskIco[J + 1] := K;
        K := DeskCmd[J]; DeskCmd[J] := DeskCmd[J + 1]; DeskCmd[J + 1] := K;
      End;
    End;
  DeskSel := -1;
  MarkAll;
End;

Procedure KCommand(Cmd : LongInt);
Var W : LongInt; Nm : String;
Begin
  If (Cmd >= cmColorBase) And (Cmd < cmColorBase + 64) Then
  Begin
    DispSetDepth(Cmd - cmColorBase);
    Exit;
  End;
  If (Cmd > cmMonthBase) And (Cmd <= cmMonthBase + 12) Then
  Begin
    DtM := Cmd - cmMonthBase; DtDateSet := True;
    If DtD > DaysIn(DtY, DtM) Then DtD := DaysIn(DtY, DtM);
    If DtW >= 0 Then KRepaint(DtW);
    Exit;
  End;
  If (Cmd >= cmNNew) And (Cmd <= cmNAbout) Then
  Begin
    NoteCmd(Cmd);
    Exit;
  End;
  If (Cmd >= cmFdDrive) And (Cmd < cmFdDrive + 26) Then
  Begin
    FdDir := Chr(65 + Cmd - cmFdDrive) + ':';
    FdRefresh;
    If (FdW >= 0) And Wnds[FdW].Used Then KRepaint(FdW);
    Exit;
  End;
  If (Cmd >= cmFdType) And (Cmd < cmFdType + 8) Then
  Begin
    FdFiltI := Cmd - cmFdType;
    FdMask := FdFiltPat[FdFiltI];
    FdRefresh;
    If (FdW >= 0) And Wnds[FdW].Used Then KRepaint(FdW);
    Exit;
  End;
  If (Cmd >= cmTzBase) And (Cmd < cmTzBase + TzCount) Then
  Begin
    DtTz := Cmd - cmTzBase;
    If DtW >= 0 Then KRepaint(DtW);
    Exit;
  End;
  Case Cmd Of
    cmDisplay : DispOpen;
    cmDateTime : DtOpen;
    cmMixer : MixerOpen;
    cmSysProps : SysOpen;
    cmAudioProps : AudioOpen;
    cmAlign : MarkAll;
    cmArrName : DeskArrange(False);
    cmArrType : DeskArrange(True);
    cmIconOpen : If DeskSel >= 0 Then KCommand(DeskCmd[DeskSel]);
    cmComputer, cmExplorer :
    Begin
      W := KCreate(ikExplorer, '', icComputer, 60 + Ticks Mod 40,
                   36 + Ticks Mod 30, 440, 320, WS_OVERLAPPED Or WS_CAPTION Or
                   WS_SYSMENU Or WS_THICKFRAME Or WS_MINIMIZEBOX Or
                   WS_MAXIMIZEBOX, 0);
      If W < 0 Then Exit;
      Wnds[W].K1 := -1;
      If Cmd = cmExplorer Then Wnds[W].KS := 'D:' Else Wnds[W].KS := '';
      If Cmd = cmExplorer Then
      Begin
        Wnds[W].Text := L('Explorateur', 'Exploring', 'Explorer',
                          'Esplora', 'Explorando') + ' - ' + VolLabel;
        Wnds[W].K4 := icExplorer;
      End
      Else
        Wnds[W].Text := L('Poste de travail', 'My Computer', 'Arbeitsplatz',
                          'Risorse del computer', 'Mi PC');
      ShowW(W, True, True);
    End;
    cmNotepad : NoteOpen('');
    cmPrompt : RunExe(CmdPath, '');
    cmPaint :
      If Not RunExe(SysDir + 'PAINT.EXE', '') Then
        MsgBoxOpen('Paint', L('PAINT.EXE est introuvable.',
                   'PAINT.EXE cannot be found.',
                   'PAINT.EXE wurde nicht gefunden.',
                   'Impossibile trovare PAINT.EXE.',
                   'No se encuentra PAINT.EXE.'), $10);
    cmNetwork : NetConfigBox;
    cmReadme : NoteOpen(SysDir + 'LISEZMOI.TXT');
    cmRecycle :
      MsgBoxOpen(L('Corbeille', 'Recycle Bin', 'Papierkorb', 'Cestino',
                   'Papelera'), L('La Corbeille est vide.',
                   'The Recycle Bin is empty.', 'Der Papierkorb ist leer.',
                   'Il Cestino '#138' vuoto.',
                   'La Papelera est'#160' vac'#161'a.'), $40);
    cmHelp :
    Begin
      W := KCreate(ikHelp, L('Aide de Pasdows', 'Pasdows Help',
                   'Pasdows-Hilfe', 'Guida di Pasdows', 'Ayuda de Pasdows'),
                   icHelp, 90, 40, 460, 300, WS_OVERLAPPED Or WS_CAPTION Or
                   WS_SYSMENU Or WS_THICKFRAME Or WS_MINIMIZEBOX Or
                   WS_MAXIMIZEBOX, 0);
      If W >= 0 Then ShowW(W, True, True);
    End;
    cmAbout :
    Begin
      W := KCreate(ikAbout, L('A propos de Pasdows 95', 'About Pasdows 95',
                   'Info '#129'ber Pasdows 95', 'Informazioni su Pasdows 95',
                   'Acerca de Pasdows 95'), icLogo, 115, 100, 410, 240,
                   WS_POPUP Or WS_CAPTION Or WS_SYSMENU, WS_EX_DLGMODALFRAME);
      If W >= 0 Then ShowW(W, True, True);
    End;
    cmRun :
    Begin
      W := KCreate(ikRun, L('Ex'#130'cuter', 'Run', 'Ausf'#129'hren', 'Esegui',
                   'Ejecutar'), icRun, 6, TaskY - 180, 370, 172,
                   WS_POPUP Or WS_CAPTION Or WS_SYSMENU, WS_EX_DLGMODALFRAME);
      If W >= 0 Then ShowW(W, True, True);
    End;
    cmShutdown :
    Begin
      DimOn := True;
      MarkAll;
      W := KCreate(ikShutdown, L('Arr'#136'ter Pasdows', 'Shut Down Pasdows',
                   'Pasdows beenden', 'Chiudi sessione', 'Apagar Pasdows'),
                   icShutdown, 140, 123, 360, 206, WS_POPUP Or WS_CAPTION Or
                   WS_SYSMENU, WS_EX_DLGMODALFRAME Or WS_EX_TOOLWINDOW Or
                   WS_EX_TOPMOST);
      If W >= 0 Then ShowW(W, True, True);
    End;
    cmSafeMode :
      MsgBoxOpen('Pasdows', L(
        'Pour d'#130'marrer en mode sans '#130'chec (interface 16 couleurs '
        + 'd''IO.SYS), red'#130'marrez et appuyez sur F5 ou F8.',
        'To start in safe mode (16-color IO.SYS interface), restart and '
        + 'press F5 or F8.',
        'Neu starten und F5 oder F8 dr'#129'cken.',
        'Riavviare e premere F5 o F8.',
        'Reinicie y pulse F5 o F8.'), $40);
    cmDosMode : DoShutdown(2);
  Else
    If Cmd >= cmExeBase Then RunExe(ExePaths[Cmd - cmExeBase], '')
    Else If Cmd >= cmDocBase Then
    Begin
      If DocFile(Cmd - cmDocBase, Nm) Then NoteOpen(SysDir + Nm);
    End
  End;
End;

Procedure KMouse(W, Msg, X, Y : LongInt);
Var I : LongInt;
Begin
  If VmOn And (W = ConW) And (W >= 0) Then
  Begin
    DosMouseIn(Msg, X, Y);
    Exit;
  End;
  If W < 0 Then
  Begin
    { bureau }
    If (Msg <> WM_LBUTTONDOWN) And (Msg <> WM_RBUTTONDOWN) Then Exit;
    If MenuDepth > 0 Then CloseMenus(0);
    I := DeskHit(X, Y);
    If Msg = WM_RBUTTONDOWN Then
    Begin
      { menu contextuel du bureau ou de l'icone }
      If I <> DeskSel Then
      Begin
        DeskRedraw(DeskSel);
        DeskSel := I;
        DeskRedraw(I);
      End;
      ActivateW(-1);
      LastClickW := -1;
      If I >= 0 Then OpenMenu(0, mnIcon, X, Y, False)
      Else OpenMenu(0, mnDesk, X, Y, False);
      Exit;
    End;
    If (I >= 0) And (I = LastClickW - 10000) And (Ticks - LastClickT < 700)
    Then
    Begin
      LastClickW := -1;
      KCommand(DeskCmd[I]);
      Exit;
    End;
    LastClickW := 10000 + I; LastClickT := Ticks;
    If I <> DeskSel Then
    Begin
      DeskRedraw(DeskSel);
      DeskSel := I;
      DeskRedraw(I);
    End;
    ActivateW(-1);
    Exit;
  End;
  If (MenuDepth > 0) And (Wnds[W].IKind <> ikMenu) And
     (Wnds[W].IKind <> ikVolPop) And (Msg = WM_LBUTTONDOWN) Then
    CloseMenus(0);
  { boites internes : un second clic rapide reste un clic (compteurs,
    curseurs) ; l'arbre du Gestionnaire de peripheriques s'en sert }
  If (Msg = WM_LBUTTONDBLCLK) And (Wnds[W].IKind >= ikDisplay) And
     (Wnds[W].IKind <= ikDevProps) And (Wnds[W].IKind <> ikSysProps) Then
    Msg := WM_LBUTTONDOWN;
  Case Wnds[W].IKind Of
    ikTaskbar : TaskbarMouse(Msg, X, Y);
    ikMenu : MenuMouse(W, Msg, X, Y);
    ikMsgBox : MsgBoxMouse(W, Msg, X, Y);
    ikExplorer : ExpMouse(W, Msg, X, Y);
    ikAbout, ikRun, ikShutdown : DialogMouse(W, Msg, X, Y);
    ikDisplay : DisplayMouse(W, Msg, X, Y);
    ikDateTime : DateTimeMouse(W, Msg, X, Y);
    ikVolPop : VolPopMouse(W, Msg, X, Y);
    ikMixer : MixerMouse(W, Msg, X, Y);
    ikAudio : AudioMouse(W, Msg, X, Y);
    ikSysProps : SysPropsMouse(W, Msg, X, Y);
    ikNotepad : NoteMouse(W, Msg, X, Y);
    ikFileDlg : FileDlgMouse(W, Msg, X, Y);
    ikFind : FindMouse(W, Msg, X, Y);
    ikDevProps : DevPropsMouse(W, Msg, X, Y);
  End;
End;

{ ------------------------------------------------------------------ }
{ Console Win32 (programmes du sous-systeme console, Invite MS-DOS)   }
{ ------------------------------------------------------------------ }
{ Une seule console, 80 x 25, dans une fenetre interne (ikConsole) :
  cellules de 7 x 16 pixels (police 8x16 sans sa 8e colonne, comme la
  fenetre MS-DOS de Windows 95 en 640x480). Les touches frappees
  deviennent des evenements KEY_EVENT (ReadConsoleInput) ou une ligne
  (ReadFile/ReadConsole en mode ligne). }

Const
  ConCols = 80; ConRows = 25;
  ConCW = 7; ConChH = 16;
  ConQMax = 64;
  { couleurs de la console (ordre des attributs : bit 0 bleu, 1 vert,
    2 rouge, 3 intensite) }
  ConRGB : Array[0..15] Of LongInt = (
    $000000, $000080, $008000, $008080, $800000, $800080, $808000,
    $C0C0C0, $808080, $0000FF, $00FF00, $00FFFF, $FF0000, $FF00FF,
    $FFFF00, $FFFFFF);

Var
  ConW : LongInt;                        { fenetre (-1 : aucune) }
  ConCh, ConAt : Array[0..ConCols * ConRows - 1] Of Byte;
  ConX, ConY, ConAttr : LongInt;
  ConInMode : LongInt;                   { modes de l'entree standard }
  ConCurVis : Boolean;
  ConFull : Boolean;                     { tout repeindre }
  ConDLo, ConDHi : LongInt;              { lignes a repeindre }
  ConRowsDue : Boolean;                  { lignes a repeindre seules }
  ConPR0, ConPR1 : LongInt;              { lignes repeintes }
  ConPal : Array[0..15] Of LongInt;      { couleurs -> indices systeme }
  ConPalVer : LongInt;                   { PalVer de ConPal (-1 : a faire) }
  ConLastCY : LongInt;                   { ligne du curseur dessine }
  ConQVk, ConQCh, ConQCtl : Array[0..ConQMax - 1] Of LongInt;
  ConQHead, ConQLen : LongInt;
  ConPend : String;                      { reste d'une ligne lue }
  ConKeep : Boolean;                     { garder la console a la fin du
                                           programme (retour a l'Invite) }
  ConKillReq : Boolean;                  { fenetre fermee : arreter le
                                           programme (tache 0) }
  ConTitle : String[79];
  AppConsole : Boolean;                  { programme du sous-systeme console }
  { programme lance depuis l'Invite (CreateProcessA), puis retour }
  ChainExec, ChainArgs, ChainRet, ChainRetArgs, ChainDir : String;
  ChainObj : LongInt;

{ Mot signe 16 bits (SMALL_RECT, COORD) }
Function ConS16(V : LongInt) : LongInt;
Begin
  V := V And $FFFF;
  If V >= $8000 Then V := V - $10000;
  ConS16 := V;
End;

Procedure ConDirty(R : LongInt);
Begin
  If R < ConDLo Then ConDLo := R;
  If R > ConDHi Then ConDHi := R;
  ConRowsDue := True;
End;

Procedure ConClear;
Var I : LongInt;
Begin
  For I := 0 To ConCols * ConRows - 1 Do
  Begin
    ConCh[I] := 32; ConAt[I] := ConAttr;
  End;
  ConX := 0; ConY := 0;
  ConFull := True;
  ConRowsDue := True;
End;

Procedure ConEnsure;
Var X1, Y1, X2, Y2, DW, DH : LongInt;
Begin
  If ConW >= 0 Then Exit;
  ConAttr := 7; ConInMode := 7; ConCurVis := True;
  ConQHead := 0; ConQLen := 0; ConPend := '';
  ConDLo := 0; ConDHi := ConRows - 1;
  If ConTitle = '' Then
    ConTitle := PromptName;
  ConW := KCreate(ikConsole, ConTitle, icDos, 24, 16, 600, 440,
                  WS_OVERLAPPED Or WS_CAPTION Or WS_SYSMENU Or
                  WS_MINIMIZEBOX, 0);
  If ConW < 0 Then Exit;
  { zone cliente exacte : 80 x 25 cellules }
  KClient(ConW, X1, Y1, X2, Y2);
  DW := ConCols * ConCW - (X2 - X1 + 1);
  DH := ConRows * ConChH - (Y2 - Y1 + 1);
  If (DW <> 0) Or (DH <> 0) Then
    MoveW(ConW, Wnds[ConW].X, Wnds[ConW].Y, Wnds[ConW].W + DW,
          Wnds[ConW].H + DH, False);
  ConClear;
  ShowW(ConW, True, True);
End;

Procedure ConScrollUp;
Var I : LongInt;
Begin
  MoveMem(LongInt(@ConCh) + ConCols, LongInt(@ConCh),
          ConCols * (ConRows - 1));
  MoveMem(LongInt(@ConAt) + ConCols, LongInt(@ConAt),
          ConCols * (ConRows - 1));
  For I := ConCols * (ConRows - 1) To ConCols * ConRows - 1 Do
  Begin
    ConCh[I] := 32; ConAt[I] := ConAttr;
  End;
  ConFull := True;
  ConRowsDue := True;
End;

Procedure ConNewLine;
Begin
  ConDirty(ConY);
  ConX := 0;
  Inc(ConY);
  If ConY >= ConRows Then
  Begin
    ConScrollUp;
    ConY := ConRows - 1;
  End;
  ConDirty(ConY);
End;

{ Un caractere (sortie traitee : CR, LF, BS, TAB, BEL) }
Procedure ConPutC(C : LongInt);
Begin
  Case C Of
    7 : ;
    8 :
      If ConX > 0 Then
      Begin
        Dec(ConX); ConDirty(ConY);
      End;
    9 :
      Repeat
        ConCh[ConY * ConCols + ConX] := 32;
        ConAt[ConY * ConCols + ConX] := ConAttr;
        Inc(ConX);
        If ConX >= ConCols Then ConNewLine;
      Until (ConX Mod 8) = 0;
    10 : ConNewLine;
    13 :
      Begin
        ConX := 0; ConDirty(ConY);
      End;
  Else
    ConCh[ConY * ConCols + ConX] := C And 255;
    ConAt[ConY * ConCols + ConX] := ConAttr;
    ConDirty(ConY);
    Inc(ConX);
    If ConX >= ConCols Then ConNewLine;
  End;
End;

Procedure ConWrite(Buf, N : LongInt);
Var I : LongInt;
Begin
  ConEnsure;
  For I := 0 To N - 1 Do ConPutC(Mem[0:Buf + I]);
End;

Procedure ConWriteS(Const S : String);
Var I : LongInt;
Begin
  For I := 1 To Length(S) Do ConPutC(Ord(S[I]));
End;

{ Une cellule de la console : 16 lignes de 7 pixels (police 8x16 sans
  sa 8e colonne), couleur Fg sur Bg, en A (surface de pas Pitch). En
  assembleur : la version Pascal (112 tests et ecritures par cellule)
  prenait pres de 300 ms pour un ecran sous l'emulateur de DEVENV, et le
  programme console attendait pendant ce temps (DIR, echo du clavier). }
Procedure ConCell(A, F, Pitch, Fg, Bg : LongInt);
Begin
  asm
    push esi
    push edi
    push ebx
    mov eax,Pitch
    sub eax,7
    push eax
    mov edi,A
    mov esi,F
    mov edx,Fg
    mov eax,Bg
    mov dh,al
    mov ecx,16
  @row:
    mov bl,[esi]
    inc esi
    mov al,dh
    test bl,80h
    jz @p1
    mov al,dl
  @p1:
    mov [edi],al
    mov al,dh
    test bl,40h
    jz @p2
    mov al,dl
  @p2:
    mov [edi+1],al
    mov al,dh
    test bl,20h
    jz @p3
    mov al,dl
  @p3:
    mov [edi+2],al
    mov al,dh
    test bl,10h
    jz @p4
    mov al,dl
  @p4:
    mov [edi+3],al
    mov al,dh
    test bl,8
    jz @p5
    mov al,dl
  @p5:
    mov [edi+4],al
    mov al,dh
    test bl,4
    jz @p6
    mov al,dl
  @p6:
    mov [edi+5],al
    mov al,dh
    test bl,2
    jz @p7
    mov al,dl
  @p7:
    mov [edi+6],al
    add edi,7
    add edi,[esp]
    dec ecx
    jnz @row
    pop eax
    pop ebx
    pop edi
    pop esi
  end;
End;

Procedure PaintConsole(W : LongInt);
Var X1, Y1, X2, Y2, R, C, I, A, P, F, Fg, Bg, R0, R1, NC, NR : LongInt;
Begin
  KClient(W, X1, Y1, X2, Y2);
  NC := Min(ConCols, (X2 - X1 + 1) Div ConCW);
  NR := Min(ConRows, (Y2 - Y1 + 1) Div ConChH);
  If ConPalVer <> PalVer Then
  Begin
    For I := 0 To 15 Do
      ConPal[I] := NearestIdx((ConRGB[I] Shr 16) And 255,
                              (ConRGB[I] Shr 8) And 255, ConRGB[I] And 255);
    ConPalVer := PalVer;
  End;
  If ConFull Then
  Begin
    FBar(X1, Y1, X2, Y2, ConPal[0]);
    R0 := 0; R1 := NR - 1;
  End
  Else
  Begin
    If (ConLastCY >= 0) And (ConLastCY < ConDLo) Then ConDLo := ConLastCY;
    If ConLastCY > ConDHi Then ConDHi := ConLastCY;
    R0 := Max(ConDLo, 0); R1 := Min(ConDHi, NR - 1);
  End;
  ConFull := False; ConRowsDue := False;
  ConDLo := ConRows; ConDHi := -1;
  ConPR0 := R0; ConPR1 := R1;
  ConLastCY := ConY;
  For R := R0 To R1 Do
    For C := 0 To NC - 1 Do
    Begin
      I := R * ConCols + C;
      Fg := ConPal[ConAt[I] And 15]; Bg := ConPal[(ConAt[I] Shr 4) And 15];
      F := FontAddr + ConCh[I] * 16;
      A := DS.Bits + (Y1 + R * ConChH - DOY) * DS.Pitch +
           (X1 + C * ConCW - DOX);
      ConCell(A, F, DS.Pitch, Fg, Bg);
      { curseur : soulignement, fenetre active seulement }
      If ConCurVis And (R = ConY) And (C = ConX) And (W = ActiveWin) Then
      Begin
        P := A + 13 * DS.Pitch;
        FillMem(P, ConCW, Fg);
        FillMem(P + DS.Pitch, ConCW, Fg);
      End;
    End;
End;

{ Touche frappee dans la fenetre de la console }
Procedure ConKeyIn(VK, Ch : LongInt);
Var I, Ctl : LongInt;
Begin
  If ConQLen >= ConQMax Then Exit;
  Ctl := 0;
  If (KeyState[$10] And $80) <> 0 Then Ctl := Ctl Or $10;
  If (KeyState[$11] And $80) <> 0 Then Ctl := Ctl Or $08;
  If (KeyState[$12] And $80) <> 0 Then Ctl := Ctl Or $02;
  { Ctrl+lettre : caractere de controle, comme Windows }
  If ((Ctl And $08) <> 0) And (VK >= $41) And (VK <= $5A) Then
    Ch := VK - $40;
  { ENHANCED_KEY, et le code de balayage (wVirtualScanCode) range dans
    les bits 16-23, inutilises par dwControlKeyState (voir ConPutRec) :
    ReadKey en a besoin pour les fleches et les touches de fonction }
  If KeyExt Then Ctl := Ctl Or $100;
  Ctl := Ctl Or ((KeyScan And 255) Shl 16);
  I := (ConQHead + ConQLen) Mod ConQMax;
  ConQVk[I] := VK; ConQCh[I] := Ch And 255; ConQCtl[I] := Ctl;
  Inc(ConQLen);
End;

Procedure ConQPop(Var VK, Ch, Ctl : LongInt);
Begin
  VK := ConQVk[ConQHead]; Ch := ConQCh[ConQHead]; Ctl := ConQCtl[ConQHead];
  ConQHead := (ConQHead + 1) Mod ConQMax;
  Dec(ConQLen);
End;

Procedure KKey(W, Msg, VK, Ch : LongInt);
Var I : LongInt;
Begin
  If W = -1 Then
  Begin
    { raccourcis globaux (avant la fenetre active) }
    If (VK = $5B) Or ((VK = $1B) And ((KeyState[$11] And $80) <> 0)) Then
    Begin
      If MenuDepth > 0 Then CloseMenus(0) Else OpenStartMenu;
      KeyState[$11] := KeyState[$11] And $7F;
      Exit;
    End;
    If MenuDepth > 0 Then
    Begin
      If VK = $1B Then CloseMenus(MenuDepth - 1);
      Exit;
    End;
    If ((KeyState[$12] And $80) <> 0) And (VK = $73) Then
    Begin
      I := ActiveWin;
      If I < 0 Then KCommand(cmShutdown)
      Else If Wnds[I].IKind <> ikNone Then
      Begin
        If Wnds[I].IKind = ikMsgBox Then MsgBoxEnd(I, IDCANCEL)
        Else If Wnds[I].IKind = ikShutdown Then DialogAction(I, 1)
        Else If Wnds[I].IKind = ikNotepad Then KCommand(cmNExit)
        Else If Wnds[I].IKind = ikFileDlg Then FdClose(False)
        Else DestroyW(I);
      End
      Else PostMsgW(I, WM_CLOSE, 0, 0);
      Exit;
    End;
    If ((KeyState[$12] And $80) <> 0) And (VK = 9) Then
    Begin
      For I := 0 To ZCnt - 1 Do
        If IsTaskWin(ZList[I]) And (ZList[I] <> ActiveWin) Then
        Begin
          If Wnds[ZList[I]].Min Then RestoreW(ZList[I])
          Else ActivateW(ZList[I]);
          Exit;
        End;
      Exit;
    End;
    Exit;
  End;
  If W = -2 Then
  Begin
    If (VK = $0D) And (DeskSel >= 0) Then KCommand(DeskCmd[DeskSel]);
    Exit;
  End;
  { programme MS-DOS : touches enfoncees et relachees }
  If VmOn And (W = ConW) Then
  Begin
    DosKeyIn(Msg = WM_KEYUP, VK, Ch);
    Exit;
  End;
  If Msg <> WM_KEYDOWN Then Exit;
  If (Wnds[W].IKind >= ikButton) And (Wnds[W].IKind <= ikMdiClient) Then
  Begin
    I := TopOf(W);
    If (VK = $0D) And (Wnds[I].IKind = ikDialog) Then
      PostMsgW(I, WM_COMMAND, IDOK, 0)
    Else If (VK = $1B) And (Wnds[I].IKind = ikDialog) Then
      PostMsgW(I, WM_COMMAND, IDCANCEL, 0)
    Else If (Ch <> 0) And (Wnds[W].IKind = ikEdit) Then
      KWndProc(W, WM_CHAR, Ch, 0);
    Exit;
  End;
  Case Wnds[W].IKind Of
    ikMsgBox :
      If VK = $0D Then MsgBoxEnd(W, MbId(Wnds[W].K2, 0))
      Else If VK = $1B Then MsgBoxEnd(W, MbId(Wnds[W].K2,
                                       MbCount(Wnds[W].K2) - 1));
    ikRun :
      If VK = $0D Then DialogAction(W, 0)
      Else If VK = $1B Then DialogAction(W, 1)
      Else If VK = 8 Then
      Begin
        Delete(Wnds[W].KS, Length(Wnds[W].KS), 1);
        KRepaint(W);
      End
      Else If (Ch >= 32) And (Length(Wnds[W].KS) < 30) Then
      Begin
        Wnds[W].KS := Wnds[W].KS + Chr(Ch);
        KRepaint(W);
      End;
    ikShutdown :
      If VK = $0D Then DialogAction(W, 0)
      Else If VK = $1B Then DialogAction(W, 1)
      Else If (VK = $26) Or (VK = $28) Then
      Begin
        If VK = $26 Then Wnds[W].K1 := (Wnds[W].K1 + 2) Mod 3
        Else Wnds[W].K1 := (Wnds[W].K1 + 1) Mod 3;
        KRepaint(W);
      End;
    ikAbout : If (VK = $0D) Or (VK = $1B) Then DestroyW(W);
    ikDisplay : DisplayKey(W, VK);
    ikDateTime : DateTimeKey(W, VK);
    ikSysProps : SysPropsKey(W, VK);
    ikFileDlg : FileDlgKey(W, VK, Ch);
    ikFind : FindKey(W, VK, Ch);
    ikDevProps : If (VK = $0D) Or (VK = $1B) Then
                 Begin
                   DestroyW(W);
                   DevPW := -1;
                 End;
    ikNotepad : NoteKey(W, VK, Ch);
    ikConsole : ConKeyIn(VK, Ch);
    ikExplorer :
      If VK = 8 Then ExpUp(W)
      Else If (VK = $0D) And (Wnds[W].K1 >= 0) Then ExpOpenItem(W, Wnds[W].K1);
  End;
End;

Procedure KActivated(W : LongInt);
Begin
  If MenuDepth > 0 Then
    If (W < 0) Or (Wnds[W].IKind <> ikMenu) Then CloseMenus(0);
End;

{ Fond d'une boite de dialogue d'un programme ; ses controles sont
  redessines ensuite }
Procedure PaintDlgBack(W : LongInt);
Var X1, Y1, X2, Y2, I : LongInt;
Begin
  KClient(W, X1, Y1, X2, Y2);
  FBar(X1, Y1, X2, Y2, cSilver);
  For I := 0 To MaxWnd - 1 Do
    If Wnds[I].Used And IsChildW(I) And (Wnds[I].Parent = W) Then
      InvalAll(I, True);
End;

{ Dessiner une fenetre interne de premier niveau }
Procedure KPaint(W : LongInt);
Begin
  If Not Wnds[W].Used Or (Wnds[W].Surf.Bits = 0) Then Exit;
  Wnds[W].KNeedPaint := False;
  SetR(Wnds[W].Upd, 0, 0, 0, 0);
  NcPaint(W);
  SetTarget(Wnds[W].Surf, Wnds[W].X, Wnds[W].Y);
  Case Wnds[W].IKind Of
    ikTaskbar : PaintTaskbar(W);
    ikMenu : PaintMenu(W);
    ikMsgBox : PaintMsgBox(W);
    ikExplorer : PaintExplorer(W);
    ikAbout, ikRun, ikShutdown : PaintDialog(W);
    ikDisplay : PaintDisplay(W);
    ikDateTime : PaintDateTime(W);
    ikVolPop : PaintVolPop(W);
    ikMixer : PaintMixer(W);
    ikAudio : PaintAudio(W);
    ikSysProps : PaintSysProps(W);
    ikFileDlg : PaintFileDlg(W);
    ikFind : PaintFind(W);
    ikDevProps : PaintDevProps(W);
    ikHelp : PaintHelp(W);
    ikNotepad : PaintNotepad(W);
    ikConsole : PaintConsole(W);
    ikDialog : PaintDlgBack(W);
  End;
  DirtyWnd(W);
End;

{ Console : repeindre seulement les lignes de texte modifiees (sans le
  cadre) et ne recopier que cette bande a l'ecran. Repeindre et recopier
  toute la fenetre a chaque ligne affichee rendait DIR tres lent. }
Procedure ConPaintRows;
Var X1, Y1, X2, Y2 : LongInt;
Begin
  If (ConW < 0) Or Not Wnds[ConW].Used Or (Wnds[ConW].Surf.Bits = 0) Then
    Exit;
  SetTarget(Wnds[ConW].Surf, Wnds[ConW].X, Wnds[ConW].Y);
  PaintConsole(ConW);
  If ConPR1 < ConPR0 Then Exit;
  KClient(ConW, X1, Y1, X2, Y2);
  MarkDirty(X1, Y1 + ConPR0 * ConChH, X2 + 1,
            Min(Y2 + 1, Y1 + (ConPR1 + 1) * ConChH));
End;

{ Fenetres internes a repeindre (tache 0) }
Procedure KPaintAll;
Var I : LongInt;
Begin
  If ConRowsDue And (ConW >= 0) And Wnds[ConW].Used And
     Not Wnds[ConW].KNeedPaint And Wnds[ConW].Visible Then ConPaintRows;
  For I := 0 To MaxWnd - 1 Do
    If Wnds[I].Used And Not IsChildW(I) Then
    Begin
      If Wnds[I].IKind <> ikNone Then
      Begin
        If Wnds[I].KNeedPaint Then KPaint(I);
      End
      Else If Wnds[I].NeedNc Then NcPaint(I);
    End;
  ReadRtc;
  DtTick;
  If RtcMin <> LastMinute Then
  Begin
    LastMinute := RtcMin;
    TaskbarChanged;
  End;
End;

{ ------------------------------------------------------------------ }
{ Controles standard (BUTTON, STATIC, EDIT, LISTBOX, SCROLLBAR...)   }
{   Button : K1 etat (coche), K2 enfonce                             }
{   ListBox : Extra = liste de chaines (bloc), K1 nombre, K2 choix   }
{ ------------------------------------------------------------------ }

Const
  BS_TYPEMASK = $F; BS_CHECKBOX = 2; BS_AUTOCHECKBOX = 3; BS_RADIOBUTTON = 4;
  BS_3STATE = 5; BS_GROUPBOX = 7; BS_AUTORADIOBUTTON = 9;
  BM_GETCHECK = $F0; BM_SETCHECK = $F1; BM_GETSTATE = $F2;
  BN_CLICKED = 0;
  LB_ADDSTRING = $180; LB_RESETCONTENT = $184; LB_SETCURSEL = $186;
  LB_GETCURSEL = $188; LB_GETTEXT = $189; LB_GETTEXTLEN = $18A;
  LB_GETCOUNT = $18B;
  CB_ADDSTRING = $143; CB_GETCURSEL = $147; CB_RESETCONTENT = $14B;
  CB_SETCURSEL = $14E;
  LBItemMax = 128;

Procedure DrawCtl(W : LongInt);
Var S : TSurf; OX, OY, X1, Y1, X2, Y2, Typ, I, A : LongInt; Clip : TRect;
    T : String; Fg : LongInt;
Begin
  If Not WndVisible(W) Then Exit;
  If Not WndTarget(W, False, S, OX, OY, Clip) Then Exit;
  SetR(Wnds[W].Upd, 0, 0, 0, 0);
  SetTarget(S, 0, 0);
  ClipX1 := Clip.L; ClipY1 := Clip.T; ClipX2 := Clip.R - 1;
  ClipY2 := Clip.B - 1;
  X1 := OX; Y1 := OY; X2 := OX + Wnds[W].W - 1; Y2 := OY + Wnds[W].H - 1;
  If Wnds[W].Enabled Then Fg := cBlack Else Fg := cGray;
  T := Wnds[W].Text;
  I := Pos('&', T);
  If I > 0 Then Delete(T, I, 1);
  Case Wnds[W].IKind Of
    ikButton :
    Begin
      Typ := Wnds[W].Style And BS_TYPEMASK;
      If Typ = BS_GROUPBOX Then GroupBox(X1, Y1 + 7, X2, Y2, T)
      Else If (Typ = BS_CHECKBOX) Or (Typ = BS_AUTOCHECKBOX) Or
              (Typ = BS_3STATE) Then
      Begin
        FBar(X1, Y1, X2, Y2, cSilver);
        Sunken(X1, (Y1 + Y2) Div 2 - 6, X1 + 12, (Y1 + Y2) Div 2 + 6, cWhite);
        If Wnds[W].K1 <> 0 Then
          For I := 0 To 2 Do
            DLine(X1 + 3, (Y1 + Y2) Div 2 - 1 + I, X1 + 5,
                  (Y1 + Y2) Div 2 + 1 + I, cBlack);
        If Wnds[W].K1 <> 0 Then
          For I := 0 To 2 Do
            DLine(X1 + 5, (Y1 + Y2) Div 2 + 1 + I, X1 + 9,
                  (Y1 + Y2) Div 2 - 3 + I, cBlack);
        OutTxt(X1 + 18, (Y1 + Y2) Div 2 - 8, T, Fg);
      End
      Else If (Typ = BS_RADIOBUTTON) Or (Typ = BS_AUTORADIOBUTTON) Then
      Begin
        FBar(X1, Y1, X2, Y2, cSilver);
        RadioButton(X1, (Y1 + Y2) Div 2 - 7, T, Wnds[W].K1 <> 0);
      End
      Else
        PushButton(X1, Y1, X2, Y2, T, Wnds[W].K2 <> 0,
                   (Wnds[W].Style And 1) <> 0);
    End;
    ikStatic :
    Begin
      Typ := Wnds[W].Style And $1F;
      If (Typ = 7) Or (Typ = 8) Or (Typ = 9) Then
        Edge(X1, Y1, X2, Y2, cGray, cWhite)
      Else If Typ = 3 Then PaintIcon(icApp, X1, Y1, 32)
      Else
      Begin
        FBar(X1, Y1, X2, Y2, cSilver);
        If Typ = 1 Then WrapText(X1 + (Wnds[W].W - TextW(T)) Div 2, Y1,
                                 Wnds[W].W, T, Fg, True)
        Else WrapText(X1, Y1, Wnds[W].W, T, Fg, True);
      End;
    End;
    ikEdit :
    Begin
      Sunken(X1, Y1, X2, Y2, cWhite);
      OutTxt(X1 + 4, Y1 + (Wnds[W].H - 16) Div 2, Fit(T, Wnds[W].W - 8),
             cBlack);
      If W = FocusWin Then
        VLine(X1 + 4 + TextW(T), Y1 + 3, Y2 - 3, cBlack);
    End;
    ikListBox, ikComboBox :
    Begin
      Sunken(X1, Y1, X2, Y2, cWhite);
      A := Wnds[W].Extra;
      For I := 0 To Wnds[W].K1 - 1 Do
        If Y1 + 2 + I * 16 < Y2 - 16 Then
        Begin
          If I = Wnds[W].K2 Then
          Begin
            FBar(X1 + 2, Y1 + 2 + I * 16, X2 - 2, Y1 + 17 + I * 16, cNavy);
            OutTxt(X1 + 4, Y1 + 2 + I * 16, PStr(MemL[0:A + I * 4]), cWhite);
          End
          Else
            OutTxt(X1 + 4, Y1 + 2 + I * 16, PStr(MemL[0:A + I * 4]), cBlack);
        End;
    End;
    ikScrollBar :
    Begin
      FBar(X1, Y1, X2, Y2, cSilver);
      Dither(X1, Y1, X2, Y2, cWhite, 0);
    End;
    ikDialog, ikMdiClient :
      FBar(X1, Y1, X2, Y2, cSilver);
  End;
  DirtyWnd(W);
End;

Procedure LBAdd(W : LongInt; S : String);
Var A : LongInt;
Begin
  If Wnds[W].Extra = 0 Then Wnds[W].Extra := KAlloc(LBItemMax * 4);
  If Wnds[W].K1 >= LBItemMax Then Exit;
  A := KAlloc(Length(S) + 1);
  PutPStr(A, S, 256);
  MemL[0:Wnds[W].Extra + Wnds[W].K1 * 4] := A;
  Inc(Wnds[W].K1);
End;

Procedure LBClear(W : LongInt);
Var I : LongInt;
Begin
  For I := 0 To Wnds[W].K1 - 1 Do KFree(MemL[0:Wnds[W].Extra + I * 4]);
  Wnds[W].K1 := 0; Wnds[W].K2 := -1;
End;

Procedure Notify(W, Code : LongInt);
Begin
  If (Wnds[W].Parent >= 0) Then
    PostMsgW(Wnds[W].Parent, WM_COMMAND, (Code Shl 16) Or
             (Wnds[W].Id And $FFFF), HwndOf(W));
End;

{ Procedure des controles et des fenetres internes }
Function KWndProc(W, Msg, WP, LP : LongInt) : LongInt;
Var Typ, I, N : LongInt; S : String;
Begin
  KWndProc := 0;
  If (Wnds[W].IKind = ikDialog) And (Wnds[W].DlgProc <> 0) And
     Not KillingApp Then
  Begin
    I := CallProc(Wnds[W].DlgProc, HwndOf(W), Msg, WP, LP);
    If I <> 0 Then
    Begin
      If (Msg = WM_CTLCOLORMSGBOX) Or ((Msg > WM_CTLCOLORMSGBOX) And
         (Msg <= WM_CTLCOLORSTATIC)) Or (Msg = WM_INITDIALOG) Then
        KWndProc := I
      Else KWndProc := Wnds[W].DlgResult;
      Exit;
    End;
    If Not Wnds[W].Used Then Exit;
    If Msg = WM_CLOSE Then
    Begin
      PostMsgW(W, WM_COMMAND, IDCANCEL, 0);
      Exit;
    End;
    If Msg = WM_PAINT Then
    Begin
      Wnds[W].KNeedPaint := True;
      Exit;
    End;
  End;
  Case Msg Of
    WM_NCCREATE : KWndProc := 1;
    WM_CREATE :
      If Wnds[W].IKind In [ikListBox, ikComboBox] Then Wnds[W].K2 := -1;
    WM_CLOSE :
      If Not IsChildW(W) Then
      Begin
        If Wnds[W].IKind = ikMsgBox Then MsgBoxEnd(W, IDCANCEL)
        Else If Wnds[W].IKind = ikShutdown Then DialogAction(W, 1)
        Else If Wnds[W].IKind = ikNotepad Then KCommand(cmNExit)
        Else If Wnds[W].IKind = ikFileDlg Then FdClose(False)
        Else DestroyW(W);
      End;
    WM_SETTEXT :
    Begin
      Wnds[W].Text := PStr(LP);
      KWndProc := 1;
      If IsChildW(W) Then InvalAll(W, True) Else Wnds[W].NeedNc := True;
    End;
    WM_GETTEXT :
    Begin
      PutPStr(LP, Wnds[W].Text, WP);
      KWndProc := Min(Length(Wnds[W].Text), Max(0, WP - 1));
    End;
    WM_GETTEXTLENGTH : KWndProc := Length(Wnds[W].Text);
    WM_PAINT : If IsChildW(W) Then DrawCtl(W);
    WM_SETFONT : Wnds[W].Font := WP;
    WM_GETFONT : KWndProc := Wnds[W].Font;
    WM_ENABLE : InvalAll(W, True);
    BM_GETCHECK : KWndProc := Wnds[W].K1;
    BM_SETCHECK :
    Begin
      Wnds[W].K1 := WP;
      InvalAll(W, True);
    End;
    BM_GETSTATE : KWndProc := Wnds[W].K1 Or (Wnds[W].K2 Shl 2);
    WM_LBUTTONDOWN :
      If Wnds[W].IKind = ikButton Then
      Begin
        Wnds[W].K2 := 1;
        CaptureWin := W;
        InvalAll(W, True);
      End
      Else If Wnds[W].IKind In [ikListBox, ikComboBox] Then
      Begin
        I := ((LP Shr 16) And $FFFF - 2) Div 16;
        If (I >= 0) And (I < Wnds[W].K1) Then
        Begin
          Wnds[W].K2 := I;
          InvalAll(W, True);
          Notify(W, 1);
        End;
      End;
    WM_LBUTTONUP :
      If (Wnds[W].IKind = ikButton) And (Wnds[W].K2 <> 0) Then
      Begin
        Wnds[W].K2 := 0;
        If CaptureWin = W Then CaptureWin := -1;
        Typ := Wnds[W].Style And BS_TYPEMASK;
        If Typ = BS_AUTOCHECKBOX Then Wnds[W].K1 := 1 - Wnds[W].K1;
        If Typ = BS_AUTORADIOBUTTON Then
        Begin
          For I := 0 To MaxWnd - 1 Do
            If Wnds[I].Used And (Wnds[I].Parent = Wnds[W].Parent) And
               (Wnds[I].IKind = ikButton) And
               ((Wnds[I].Style And BS_TYPEMASK) = BS_AUTORADIOBUTTON) Then
            Begin
              Wnds[I].K1 := 0;
              InvalAll(I, True);
            End;
          Wnds[W].K1 := 1;
        End;
        InvalAll(W, True);
        Notify(W, BN_CLICKED);
      End;
    WM_LBUTTONDBLCLK :
      If Wnds[W].IKind In [ikListBox, ikComboBox] Then Notify(W, 2);
    WM_CHAR :
      If Wnds[W].IKind = ikEdit Then
      Begin
        If WP = 8 Then Delete(Wnds[W].Text, Length(Wnds[W].Text), 1)
        Else If (WP >= 32) And (Length(Wnds[W].Text) < 120) Then
          Wnds[W].Text := Wnds[W].Text + Chr(WP);
        InvalAll(W, True);
        Notify(W, $300);
      End;
    LB_ADDSTRING, CB_ADDSTRING :
    Begin
      LBAdd(W, PStr(LP));
      KWndProc := Wnds[W].K1 - 1;
      InvalAll(W, True);
    End;
    LB_RESETCONTENT, CB_RESETCONTENT :
    Begin
      LBClear(W);
      InvalAll(W, True);
    End;
    LB_SETCURSEL, CB_SETCURSEL :
    Begin
      Wnds[W].K2 := WP;
      InvalAll(W, True);
    End;
    LB_GETCURSEL, CB_GETCURSEL : KWndProc := Wnds[W].K2;
    LB_GETCOUNT, $146 : KWndProc := Wnds[W].K1;
    LB_GETTEXT, $148 :
      If (WP >= 0) And (WP < Wnds[W].K1) Then
      Begin
        S := PStr(MemL[0:Wnds[W].Extra + WP * 4]);
        PutPStr(LP, S, 256);
        KWndProc := Length(S);
      End
      Else KWndProc := -1;
    LB_GETTEXTLEN, $149 :
      If (WP >= 0) And (WP < Wnds[W].K1) Then
        KWndProc := StrLenZ(MemL[0:Wnds[W].Extra + WP * 4])
      Else KWndProc := -1;
  End;
  N := 0;
End;

