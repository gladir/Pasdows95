  R := GetObjectA(H, 128, LongInt(@A));
  If (R = 60) And (GetObjectType(H) = 6) Then
  Begin
    GetObjectW := 92;
    If Buf = 0 Then Exit;
    If N < 92 Then
    Begin
      GetObjectW := 0;
      Exit;
    End;
    MoveMem(LongInt(@A), Buf, 28);
    PutWStr(Buf + 28, PStr(LongInt(@A) + 28), 32);
    Exit;
  End;
  GetObjectW := GetObjectA(H, N, Buf);
End;

