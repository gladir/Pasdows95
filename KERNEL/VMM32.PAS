{ ------------------------------------------------------------------ }
{ Tas du noyau (blocs avec en-tete de 16 octets)                     }
{   +0 signature  +4 taille totale  +8 proprietaire  +12 reserve     }
{ ------------------------------------------------------------------ }

Const
  HeapUsed = $55534544;
  HeapFree0 = $45455246;

Procedure HeapInit(Start, Stop : LongInt);
Begin
  HeapStart := (Start + 15) And Not 15;
  HeapEnd := Stop And Not 15;
  MemL[0:HeapStart] := HeapFree0;
  MemL[0:HeapStart + 4] := HeapEnd - HeapStart;
  MemL[0:HeapStart + 8] := 0;
  HeapRover := HeapStart;
End;

Function KAllocFrom(Start, Need : LongInt) : LongInt;
Var P, BS : LongInt;
Begin
  KAllocFrom := 0;
  P := Start;
  While P < HeapEnd Do
  Begin
    BS := MemL[0:P + 4];
    If BS <= 0 Then Exit;
    If MemL[0:P] = HeapFree0 Then
    Begin
      While (P + BS < HeapEnd) And (MemL[0:P + BS] = HeapFree0) Do
      Begin
        BS := BS + MemL[0:P + BS + 4];
        MemL[0:P + 4] := BS;
      End;
      If BS >= Need Then
      Begin
        If BS - Need >= 64 Then
        Begin
          MemL[0:P + Need] := HeapFree0;
          MemL[0:P + Need + 4] := BS - Need;
          MemL[0:P + 4] := Need;
        End;
        MemL[0:P] := HeapUsed;
        MemL[0:P + 8] := HeapOwner;
        HeapRover := P;
        KAllocFrom := P + 16;
        Exit;
      End;
    End;
    P := P + BS;
  End;
End;

Function HeapCheck(Tag : String) : Boolean; Forward;

{ Bloc de Size octets (mis a zero) ; 0 si memoire insuffisante }
Function KAlloc(Size : LongInt) : LongInt;
Var Need, A : LongInt;
Begin
  If Size <= 0 Then Size := 1;
  Need := ((Size + 15) And Not 15) + 16;
  A := KAllocFrom(HeapRover, Need);
  If A = 0 Then A := KAllocFrom(HeapStart, Need);
  If A = 0 Then
  Begin
    KLog('KAlloc: memoire epuisee (' + IntStr(Size) + ')');
    HeapCheck('KAlloc');
  End
  Else FillMem(A, Need - 16, 0);
  KAlloc := A;
End;

Procedure KFree(A : LongInt);
Begin
  If (A < HeapStart + 16) Or (A >= HeapEnd) Then Exit;
  If MemL[0:A - 16] <> HeapUsed Then Exit;
  MemL[0:A - 16] := HeapFree0;
  If A - 16 < HeapRover Then HeapRover := A - 16;
End;

Var
  HeapBad : LongInt;

{ Verification du tas : signatures et tailles de tous les blocs ; le
  premier bloc invalide et son predecesseur sont signales une fois }
Function HeapCheck(Tag : String) : Boolean;
Var P, BS, Prev, PrevSz : LongInt;
Begin
  HeapCheck := True;
  P := HeapStart; Prev := HeapStart; PrevSz := 0;
  While P < HeapEnd Do
  Begin
    BS := MemL[0:P + 4];
    If ((MemL[0:P] <> HeapUsed) And (MemL[0:P] <> HeapFree0)) Or
       (BS < 16) Or ((BS And 15) <> 0) Or (P + BS > HeapEnd) Then
    Begin
      If HeapBad <> P Then
        KLog('TAS CORROMPU (' + Tag + ') bloc ' + HexStr(P, 8) + ' : ' +
             HexStr(MemL[0:P], 8) + ' ' + HexStr(BS, 8) + ' ; precedent ' +
             HexStr(Prev, 8) + ' taille ' + HexStr(PrevSz, 8) +
             ' proprietaire ' + IntStr(MemL[0:Prev + 8]));
      HeapBad := P;
      HeapCheck := False;
      Exit;
    End;
    Prev := P; PrevSz := BS;
    P := P + BS;
  End;
End;

Function KSize(A : LongInt) : LongInt;
Begin
  If (A >= HeapStart + 16) And (A < HeapEnd) And
     (MemL[0:A - 16] = HeapUsed) Then
    KSize := MemL[0:A - 12] - 16
  Else
    KSize := 0;
End;

Function KRealloc(A, Size : LongInt) : LongInt;
Var B, Old : LongInt;
Begin
  If A = 0 Then
  Begin
    KRealloc := KAlloc(Size);
    Exit;
  End;
  Old := KSize(A);
  If Old >= Size Then
  Begin
    KRealloc := A;
    Exit;
  End;
  B := KAlloc(Size);
  If B <> 0 Then
  Begin
    MoveMem(A, B, Old);
    KFree(A);
  End;
  KRealloc := B;
End;

{ Liberer tous les blocs d'un proprietaire (fin d'un programme) }
Procedure KFreeOwner(Owner : LongInt);
Var P, BS : LongInt;
Begin
  P := HeapStart;
  While P < HeapEnd Do
  Begin
    BS := MemL[0:P + 4];
    If BS <= 0 Then Exit;
    If (MemL[0:P] = HeapUsed) And (MemL[0:P + 8] = Owner) Then
      MemL[0:P] := HeapFree0;
    P := P + BS;
  End;
  HeapRover := HeapStart;
End;

Function HeapOwnerBytes(Owner : LongInt) : LongInt;
Var P, BS, T : LongInt;
Begin
  T := 0;
  P := HeapStart;
  While P < HeapEnd Do
  Begin
    BS := MemL[0:P + 4];
    If BS <= 0 Then Break;
    If (MemL[0:P] = HeapUsed) And (MemL[0:P + 8] = Owner) Then T := T + BS;
    P := P + BS;
  End;
  HeapOwnerBytes := T;
End;

Function HeapFreeBytes : LongInt;
Var P, BS, T : LongInt;
Begin
  T := 0;
  P := HeapStart;
  While P < HeapEnd Do
  Begin
    BS := MemL[0:P + 4];
    If BS <= 0 Then Break;
    If MemL[0:P] = HeapFree0 Then T := T + BS;
    P := P + BS;
  End;
  HeapFreeBytes := T;
End;

