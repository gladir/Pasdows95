Function CheckMenuItem(H, Id, Flags : LongInt) : LongInt;
Var M, I : LongInt;
Begin
  CheckMenuItem := -1;
  M := MenuIdx(H);
  If M < 0 Then Exit;
  I := MItemFind(M, Id, Flags);
  If I < 0 Then Exit;
  CheckMenuItem := MItemsP^[I].Flags And MF_CHECKED;
  MItemsP^[I].Flags := (MItemsP^[I].Flags And Not MF_CHECKED) Or
                     (Flags And MF_CHECKED);
End;

{ CheckMenuRadioItem : coche Id parmi First..Last (par commande, ou par
  position avec MF_BYPOSITION) }
Function CheckMenuRadioItem(H, First, Last, Id, Flags : LongInt)
  : LongInt;
Var K : LongInt;
Begin
  CheckMenuRadioItem := 0;
  If First > Last Then Exit;
  For K := First To Last Do
    If K = Id Then CheckMenuItem(H, K, (Flags And $400) Or MF_CHECKED)
    Else CheckMenuItem(H, K, Flags And $400);
  CheckMenuRadioItem := 1;
End;

Function EnableMenuItem(H, Id, Flags : LongInt) : LongInt;
Var M, I : LongInt;
Begin
  EnableMenuItem := -1;
  M := MenuIdx(H);
  If M < 0 Then Exit;
  I := MItemFind(M, Id, Flags);
  If I < 0 Then Exit;
  EnableMenuItem := MItemsP^[I].Flags And 3;
  MItemsP^[I].Flags := (MItemsP^[I].Flags And Not 3) Or (Flags And 3);
End;

