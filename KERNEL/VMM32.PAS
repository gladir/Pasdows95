  C := ComNew(0, 12, 192);
  Case V Of
    4 : ComView(C, 0, VtVP1);
    5 : ComView(C, 1, VtVP2);
  Else
    ComView(C, 2, VtVP3);
  End;
  MemL[0:C + 80] := LFl(-1); MemL[0:C + 84] := LFl(1);
  MemL[0:C + 88] := LFl(2); MemL[0:C + 92] := LFl(2);
  MemL[0:C + 100] := LFl(1);
  MemL[0:PP] := C;
  D3_CreateViewport := DD_OK;
End;

