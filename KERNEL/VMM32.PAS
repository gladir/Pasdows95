End;

Function SF_GetClipper(T, PP : LongInt) : LongInt;
Begin
  T := Cor(T);
  SF_GetClipper := DDERR_NOCLIPPERATTACHED;
  If PP = 0 Then Exit;
  MemL[0:PP] := 0;
  If MemL[0:T + 128] = 0 Then Exit;
  MemL[0:PP] := MemL[0:T + 128];
