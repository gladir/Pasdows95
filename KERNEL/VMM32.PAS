{ Table de methodes : VtNew puis VtAdd('nom,nom,...') }
{ Bloc du systeme (garde a la fin du programme) }
Function KAllocSys(N : LongInt) : LongInt;
Var H : LongInt;
Begin
  H := HeapOwner; HeapOwner := 0;
  KAllocSys := KAlloc(N);
  HeapOwner := H;
End;

Function VtNew : LongInt;
Begin
  VtCur := KAllocSys(512);
  VtCnt := 0;
  VtNew := VtCur;
End;

Procedure VtAdd(S : String);
Var P : LongInt; Nm : String;
Begin
  While S <> '' Do
  Begin
    P := Pos(',', S);
    If P > 0 Then
    Begin
      Nm := Copy(S, 1, P - 1); Delete(S, 1, P);
    End
    Else
    Begin
      Nm := S; S := '';
    End;
    Nm := Trim(Nm);
    If Nm = '' Then Continue;
    MemL[0:VtCur + VtCnt * 4] := KernelExport(Nm);
    If MemL[0:VtCur + VtCnt * 4] = 0 Then
      KLog('DirectX : methode absente ' + Nm);
    Inc(VtCnt);
  End;
End;

