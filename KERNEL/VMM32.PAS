{ Modules et ressources (KERNEL32)                                   }
{ ------------------------------------------------------------------ }

{ Module d'une instance (0 : le programme) }
Function AppModule(H : LongInt) : LongInt;
Begin
  If (H = 0) Or (H = -1) Then AppModule := AppBase Else AppModule := H;
End;

Function GetModuleHandleA(P : LongInt) : LongInt;
Var Nm : String; M, I : LongInt;
Begin
  If P = 0 Then
  Begin
    GetModuleHandleA := AppBase;
    Exit;
  End;
  Nm := PStr(P);
  M := FindModule(Nm);
  If M >= 0 Then
  Begin
    GetModuleHandleA := Mods^[M].Base;
    Exit;
  End;
  M := 0;
  Nm := UpStr(BaseName(Nm));
  If Pos('.', Nm) = 0 Then Nm := Nm + '.DLL';
  For I := 0 To SysDllN - 1 Do
    If SysDlls[I] = Nm Then M := HDllBase + I * $10000;
  If M = 0 Then SetErr(126);
  GetModuleHandleA := M;
End;

Function GetModuleFileNameA(H, Buf, N : LongInt) : LongInt;
Var S : String; M : LongInt;
Begin
  If (H = 0) Or (H = AppBase) Then S := AppPath
  Else
  Begin
    M := ModOfBase(H);
    If M >= 0 Then S := Mods^[M].Path
    Else If (H >= HDllBase) And (H < HDllBase + SysDllN * $10000) Then
      S := 'C:\WINDOWS\SYSTEM\' + SysDlls[(H - HDllBase) Div $10000]
    Else S := AppPath;
  End;
  PutPStr(Buf, S, N);
  GetModuleFileNameA := Min(Length(S), N - 1);
End;

Function LoadLibraryA(P : LongInt) : LongInt;
Var Nm : String; M, H : LongInt;
Begin
  Nm := PStr(P);
  H := 0;
  If IsSysDll(Nm) Then H := GetModuleHandleA(P)
  Else
  Begin
    M := LoadPE(Nm, True);
    If M >= 0 Then H := Mods^[M].Base;
  End;
  KLog('LoadLibraryA ' + Nm + ' -> ' + HexStr(H, 8));
  If H = 0 Then SetErr(126);
  LoadLibraryA := H;
End;

Function LoadLibraryExA(P, F, Flags : LongInt) : LongInt;
Begin
  LoadLibraryExA := LoadLibraryA(P);
End;

Function FreeLibrary(H : LongInt) : LongInt;
Begin
  FreeLibrary := 1;
End;

Function GetProcAddress(H, P : LongInt) : LongInt;
Var M, R : LongInt; Nm : String; Ws : Boolean;
Begin
  GetProcAddress := 0;
  M := ModOfBase(H);
  Ws := (M < 0) And (H >= HDllBase) And (H < HDllBase + SysDllN * $10000);
  If Ws Then Ws := IsWsDll(SysDlls[(H - HDllBase) Div $10000]);
  If (P >= 0) And (P < $10000) Then
  Begin
    If M >= 0 Then GetProcAddress := ModuleExport(M, '', P)
    Else If (M < 0) And (H >= HDllBase) And
            (H < HDllBase + SysDllN * $10000) And
            (DXOrdName(SysDlls[(H - HDllBase) Div $10000], P) <> '') Then
      GetProcAddress := KernelExport(DXOrdName(SysDlls[(H - HDllBase) Div
                                     $10000], P))
    Else If Ws And (WsOrdName(P) <> '') Then
      GetProcAddress := KernelExport('WS_' + WsOrdName(P));
    Exit;
  End;
  Nm := PStr(P);
  R := 0;
  If Ws Then R := KernelExport('WS_' + Nm);
  If R = 0 Then
  Begin
    If M >= 0 Then R := ModuleExport(M, Nm, 0)
    Else R := KernelExport(Nm);
  End;
  If (R = 0) And (M < 0) And (Length(Nm) > 1) And (Nm[1] = '_') Then
    R := KernelExport(Copy(Nm, 2, 255));
  If R = 0 Then
  Begin
    KLog('GetProcAddress absent : ' + Nm);
    SetErr(127);
  End;
  GetProcAddress := R;
End;

{ Ressources : repertoire .rsrc (type, nom, langue) }
Function ResDirFind(Base, Dir, Id : LongInt) : LongInt;
Var NNamed, NId, I, E, Nm, S, K : LongInt; U : String; Ok : Boolean;
Begin
  ResDirFind := 0;
  NNamed := MemW[0:Dir + 12]; NId := MemW[0:Dir + 14];
  E := Dir + 16;
  For I := 0 To NNamed + NId - 1 Do
  Begin
    Nm := MemL[0:E + I * 8];
    If (Id >= 0) And (Id < $10000) Then
      Ok := ((Nm And LongInt($80000000)) = 0) And (Nm = Id)
    Else
    Begin
      Ok := False;
      If (Nm And LongInt($80000000)) <> 0 Then
      Begin
        S := Base + (Nm And $7FFFFFFF);
        U := '';
        For K := 0 To MemW[0:S] - 1 Do
          U := U + Chr(UpCh(MemW[0:S + 2 + K * 2] And 255));
        Ok := U = UpStr(PStr(Id));
      End;
    End;
    If Ok Then
    Begin
      ResDirFind := MemL[0:E + I * 8 + 4];
      Exit;
    End;
  End;
End;

{ Entree de donnees (IMAGE_RESOURCE_DATA_ENTRY) ou 0 }
Function ResFind(Module, Name, Typ : LongInt) : LongInt;
Var Pe, Rva, Base, D, E, N, V : LongInt; S : String;
Begin
  ResFind := 0;
  If Module = 0 Then Exit;
  Pe := Module + MemL[0:Module + $3C];
  Rva := MemL[0:Pe + 24 + 112];
  If Rva = 0 Then Exit;
  Base := Module + Rva;
  { "#123" -> 123 }
  If (Name >= $10000) And (Mem[0:Name] = Ord('#')) Then
  Begin
    S := PStr(Name + 1);
    Val(S, N, V);
    If V = 0 Then Name := N;
  End;
  If (Typ >= $10000) And (Mem[0:Typ] = Ord('#')) Then
  Begin
    S := PStr(Typ + 1);
    Val(S, N, V);
    If V = 0 Then Typ := N;
  End;
  E := ResDirFind(Base, Base, Typ);
  If (E And LongInt($80000000)) = 0 Then Exit;
  D := Base + (E And $7FFFFFFF);
  E := ResDirFind(Base, D, Name);
  If (E And LongInt($80000000)) = 0 Then Exit;
  D := Base + (E And $7FFFFFFF);
  { premiere langue }
  If MemW[0:D + 12] + MemW[0:D + 14] = 0 Then Exit;
  E := MemL[0:D + 16 + 4];
  If (E And LongInt($80000000)) <> 0 Then
  Begin
    D := Base + (E And $7FFFFFFF);
    E := MemL[0:D + 16 + 4];
  End;
  ResFind := Base + E;
End;

Function ResData(Module, Entry : LongInt; Var Size : LongInt) : LongInt;
Begin
  Size := MemL[0:Entry + 4];
  ResData := Module + MemL[0:Entry];
End;

Function FindResourceA(Module, Name, Typ : LongInt) : LongInt;
Var R : LongInt;
Begin
  R := ResFind(AppModule(Module), Name, Typ);
  If R = 0 Then SetErr(ErrResNotFound);
  FindResourceA := R;
End;

Function FindResourceExA(Module, Typ, Name, Lang : LongInt) : LongInt;
Begin
  FindResourceExA := FindResourceA(Module, Name, Typ);
End;

Function LoadResource(Module, Res : LongInt) : LongInt;
Var Size : LongInt;
Begin
  If Res = 0 Then LoadResource := 0
  Else LoadResource := ResData(AppModule(Module), Res, Size);
End;

Function LockResource(H : LongInt) : LongInt;
Begin
  LockResource := H;
End;

Function SizeofResource(Module, Res : LongInt) : LongInt;
Begin
  If Res = 0 Then SizeofResource := 0 Else SizeofResource := MemL[0:Res + 4];
End;

Function FreeResource(H : LongInt) : LongInt;
Begin
  FreeResource := 0;
End;

{ ------------------------------------------------------------------ }
{ Exceptions (SEH : chaine FS:[0])                                   }
{ ------------------------------------------------------------------ }

Var
  ExcRec : Array[0..19] Of LongInt;
  ExcCtx : Array[0..203] Of LongInt;

Procedure RaiseException(Code, Flags, N, Args : LongInt);
Var Frame, Handler, R, Disp, I, PD, PC, PR : LongInt;
Begin
  PD := LongInt(@Disp); PC := LongInt(@ExcCtx); PR := LongInt(@ExcRec);
  KLog('RaiseException ' + HexStr(Code, 8));
  FillMem(LongInt(@ExcRec), 80, 0);
  ExcRec[0] := Code; ExcRec[1] := Flags;
  ExcRec[4] := Min(N, 15);
  For I := 0 To ExcRec[4] - 1 Do ExcRec[5 + I] := MemL[0:Args + I * 4];
  Frame := MemL[0:Threads[CurT].Tib];
  While (Frame <> -1) And (Frame <> 0) Do
  Begin
    Handler := MemL[0:Frame + 4];
    Disp := 0;
    R := 1;
    asm
      mov eax,PD
      push eax
      mov eax,PC
      push eax
      mov eax,Frame
      push eax
      mov eax,PR
      push eax
      mov eax,Handler
      call eax
      add esp,16
      mov R,eax
    end;
    If R = 0 Then Exit;
    Frame := MemL[0:Frame];
  End;
  MsgBoxModal(L('Erreur', 'Error', 'Fehler', 'Errore', 'Error'),
              L('Exception non trait'#130'e ', 'Unhandled exception ',
                'Unbehandelte Ausnahme ', 'Eccezione non gestita ',
                'Excepci'#162'n no controlada ') + HexStr(Code, 8), $10);
  ExitProcessK(-1);
End;

{ Deroulement : appeler les gestionnaires jusqu'a TargetFrame }
Procedure RtlUnwind(Frame, Ip, Rec, Ret : LongInt);
Var F, Handler, Disp, R, PD, PC : LongInt;
Begin
  PD := LongInt(@Disp); PC := LongInt(@ExcCtx);
  If Rec = 0 Then
  Begin
    FillMem(LongInt(@ExcRec), 80, 0);
    ExcRec[0] := LongInt($C0000027);
    Rec := LongInt(@ExcRec);
  End;
  MemL[0:Rec + 4] := MemL[0:Rec + 4] Or 2;
  F := MemL[0:Threads[CurT].Tib];
  While (F <> -1) And (F <> 0) And (F <> Frame) Do
  Begin
    Handler := MemL[0:F + 4];
    Disp := 0;
    asm
      mov eax,PD
      push eax
      mov eax,PC
      push eax
      mov eax,F
      push eax
      mov eax,Rec
      push eax
      mov eax,Handler
      call eax
      add esp,16
      mov R,eax
    end;
    F := MemL[0:F];
    MemL[0:Threads[CurT].Tib] := F;
  End;
End;

{ ------------------------------------------------------------------ }
{ Lancement et fin d'un programme                                    }
{ ------------------------------------------------------------------ }

{ Liberer tout ce qui appartient au programme }
Procedure DosStop; Forward;

Procedure NetProcExit(P : LongInt); Forward;

{ Le processus P utilise-t-il la console ? }
Function ProcConsole(P : LongInt) : Boolean;
Begin
  If P = CurProc Then ProcConsole := AppConsole
  Else ProcConsole := Procs^[P].Console;
End;

Function ProcByPid(Pid : LongInt) : LongInt;
Var I : LongInt;
Begin
  ProcByPid := -1;
  For I := 0 To MaxProc - 1 Do
    If Procs^[I].Used And (Procs^[I].Pid = Pid) Then
    Begin
      ProcByPid := I;
      Exit;
    End;
End;

{ Nouveau processus (sans image) ; -1 si la table est pleine }
Function ProcNew(Kind : LongInt) : LongInt;
Var I : LongInt;
Begin
  ProcNew := -1;
  For I := 1 To MaxProc - 1 Do
    If Not Procs^[I].Used Then
    Begin
      FillMem(LongInt(@Procs^[I]), SizeOf(TProc), 0);
      Procs^[I].Used := True;
      Procs^[I].Kind := Kind;
      Procs^[I].Pid := NextPid;
      NextPid := NextPid + 4 * (1 + (Ticks Mod 7));
      Procs^[I].Parent := Procs^[CurProc].Pid;
      Procs^[I].Owner := $100 + I;
      Procs^[I].Obj := -1; Procs^[I].MainT := -1;
      Procs^[I].ExitCode := 259;
      Procs^[I].StartT := Ticks;
      Procs^[I].PrioCls := $20;
      Procs^[I].Show := 1;
      Procs^[I].Cwd := CurDirS;
      Inc(ProcCnt);
      AppRunning := True;
      ProcNew := I;
      Exit;
    End;
End;

{ Liberer tout ce qui appartient au processus P (fin du programme, ou
  TerminateProcess) : fenetres, taches, minuteries, fichiers, objets
  GDI, modules, classes, sons, sockets, DirectX, memoire }
Procedure KillProc(P, Code : LongInt);
Var I, Own, T : LongInt; Me, Cons : Boolean;
Begin
  If (P <= 0) Or (P >= MaxProc) Then Exit;
  If Not Procs^[P].Used Or Procs^[P].Killing Then Exit;
  Procs^[P].Killing := True;
  Procs^[P].ExitCode := Code;
  RegSaveDue := True;
  Own := Procs^[P].Owner;
  Me := ThrProc[CurT] = P;
  Cons := ProcConsole(P);
  KillingApp := True;
  If P = VmProc Then
  Begin
    DosStop;
    VmProc := -1;
  End;
  NetProcExit(P);
  For I := 0 To MaxWnd - 1 Do
  Begin
    T := Wnds^[I].Thread;
    If Wnds^[I].Used And (T > 0) And (T < MaxThread) Then
      If ThrProc[T] = P Then
      Begin
        Wnds^[I].Proc := 0;
        Wnds^[I].IKind := ikStatic;
        DestroyW(I);
      End;
  End;
  For I := 1 To MaxThread - 1 Do
    If Threads[I].Used And (ThrProc[I] = P) Then
    Begin
      MutexAbandon(I);
      If I <> CurT Then Threads[I].State := tsDead;
    End;
  KRefProcExit(P);
  For I := 0 To MaxTimer - 1 Do
  Begin
    T := WTimers[I].Thread;
    If WTimers[I].Used And (T >= 0) And (T < MaxThread) Then
      If ThrProc[T] = P Then WTimers[I].Used := False;
  End;
  For I := 0 To MaxMMTimer - 1 Do
    If MMTimers[I].Used And (MMTimers[I].PrcId = P) Then
      MMTimers[I].Used := False;
  WaveProcExit(P);
  For I := 0 To MaxKObj - 1 Do
    If KObjs^[I].Used And (KObjs^[I].Kind In [koFile, koFind]) And
       (KObjOwner[I] = Own) Then
    Begin
      If KObjs^[I].Kind = koFile Then CloseHandle(KHandle(I))
      Else KObjs^[I].Used := False;
    End;
  For I := 0 To MaxDC - 1 Do
    If Dcs[I].Used And (Gdis^[Dcs[I].Gdi].Owner = Own) Then DcFree(I);
  For I := 0 To MaxGdi - 1 Do
    If Gdis^[I].Used And (Gdis^[I].Owner = Own) Then Gdis^[I].Used := False;
  For I := 0 To MaxVBlk - 1 Do
    If VBlks[I].Used And (VBlks[I].Owner = Own) Then VBlks[I].Used := False;
  For I := 0 To MaxMod - 1 Do
    If Mods^[I].Used And (Mods^[I].PrcId = P) Then Mods^[I].Used := False;
  For I := 0 To MaxClass - 1 Do
    If Classes^[I].Used And (Classes^[I].IKind = ikNone) And
       (Classes^[I].PrcId = P) Then
      Classes^[I].Used := False;
  GlProcDone(P);
  If DXProc = P Then
  Begin
    DXAppDone;
    DDShow := False;
    DXProc := -1;
  End;
  If (CaptureWin >= 0) And (Wnds^[CaptureWin].Used = False) Then
    CaptureWin := -1;
  { programme debogue : EXIT_PROCESS_DEBUG_EVENT ; debogueur : fin }
  If DbgOn And (P = DbgProc) Then
  Begin
    FillMem(LongInt(@DbgEv), 96, 0);
    DbgEv[0] := 5; DbgEv[1] := Procs^[P].Pid; DbgEv[3] := Code;
    DbgProc := -1; DbgStop := False; DbgBusy := False; DbgPend := True;
  End;
  If DbgOn And (P = DbgOwner) Then
  Begin
    DbgOn := False; DbgStop := False;
    If DbgProc > 0 Then KillProc(DbgProc, -1);
  End;
  { objet processus : signale, code de sortie }
  I := Procs^[P].Obj;
  If P = CurProc Then I := AppProcObj;
  If (I >= 0) And KObjs^[I].Used Then
  Begin
    KObjs^[I].F2 := 1;
    KObjs^[I].F3 := Code;
  End;
  { quitter l'espace d'adresses et le contexte du processus avant de
    liberer son repertoire de pages et son image }
  If Me Then
  Begin
    SetCr3(KPd);
    ThrProc[CurT] := 0; ThrCurP[CurT] := 0; ThrPxD[CurT] := 0;
    ThrOwner[CurT] := 0;
    CurProc := 0;
    ProcCtxLoad(0);
  End;
  If WinProc = P Then WinProc := -1;
  RotDropProc(P);
  HeapOwner := 0;
  KFreeOwner(Own);
  HeapOwner := ThrOwner[CurT];
  Procs^[P].Used := False;
  Dec(ProcCnt);
  AppRunning := ProcCnt > 0;
  CurHide := 0;
  CursorErase;
  CursorSetShape(0);
  If ProcCnt = 0 Then DefaultPalette;
  MarkAll;
  KillingApp := False;
  { console : fermee quand plus aucun processus ne l'utilise }
  If Cons And (ConW >= 0) Then
  Begin
    T := 0;
    For I := 1 To MaxProc - 1 Do
      If Procs^[I].Used And ProcConsole(I) Then Inc(T);
    If T = 0 Then
    Begin
      I := ConW;
      ConW := -1;
      DestroyW(I);
    End;
  End;
  KLog('Processus ' + IntStr(Procs^[P].Pid) + ' termine (code ' +
       IntStr(Code) + ')');
End;

{ Fin du processus courant (compatibilite) }
Procedure KillApp;
Begin
  KillProc(ThrProc[CurT], 0);
End;

Procedure ExitProcessK(Code : LongInt);
Var P : LongInt;
Begin
  KLog('ExitProcess(' + IntStr(Code) + ')');
  If (CurT = 0) Or Not Threads[CurT].IsApp Then Exit;
  P := ThrProc[CurT];
  If P <= 0 Then Exit;
  KillProc(P, Code);
  Threads[CurT].State := tsDead;
  KSchedule;
  HaltCpu;
End;

{ Lancer un programme Windows (.EXE du CD-ROM ou du disque virtuel) }
Function IsNeFile(Path : String) : Boolean; Forward;
Function RunNe(Path, Args : String; Show : LongInt) : Boolean; Forward;
Function IsDosFile(Path : String) : Boolean; Forward;
Function RunDos(Path, Args : String) : Boolean; Forward;

{ Lancer le programme Win32 S dans un nouveau processus ; numero du
  processus, -1 en cas d'echec }
Function ProcStart(S, Args, Dir : String; Show : LongInt;
                   Susp : Boolean) : LongInt;
Var P, M, T, Sub, I, Stk : LongInt;
Begin
  ProcStart := -1;
  P := ProcNew(pkWin32);
  If P < 0 Then
  Begin
    KLog('Processus : table pleine');
    Exit;
  End;
  CursorSetShape(1);
  CursorErase; CursorDraw;
  T := -1;
  ProcEnter(P);
  M := LoadPE(S, False);
  If M >= 0 Then
  Begin
    AppBase := Mods^[M].Base;
    AppSize := Mods^[M].Size;
    AppEntry := Mods^[M].Entry;
    AppPath := S;
    AppExcFilter := 0;
    AppErrMode := 0;
    Sub := MemW[0:AppBase + MemL[0:AppBase + $3C] + 24 + 68];
    { pile du fil principal : SizeOfStackReserve de l'en-tete PE (1 a
      16 Mo), entierement allouee car elle n'a pas de page de garde }
    Stk := MemL[0:AppBase + MemL[0:AppBase + $3C] + 24 + 72];
    If Stk < $100000 Then Stk := $100000;
    If Stk > $1000000 Then Stk := $1000000;
    { chemin du programme entre guillemets s'il contient des espaces,
      comme Windows (Word prenait la suite du chemin pour un document) }
    If (Pos(' ', S) > 0) And (S[1] <> '"') Then S := '"' + S + '"';
    If Args <> '' Then S := S + ' ' + Args;
    AppCmd := KAlloc(256);
    PutPStr(AppCmd, S, 256);
    If Dir <> '' Then CurDirS := Dir Else CurDirS := ParentDir(AppPath);
    If Length(CurDirS) = 3 Then CurDirS := Copy(CurDirS, 1, 2);
    I := KObjNew(koProcess);
    If I >= 0 Then
    Begin
      KObjOwner[I] := 0;
      KObjs^[I].F1 := P;
      KObjs^[I].F4 := Procs^[P].Pid;
    End;
    AppProcObj := I;
    Procs^[P].Show := Show;
    KLog('Lancement de ' + S + ' (sous-systeme ' + IntStr(Sub) +
         ', processus ' + IntStr(Procs^[P].Pid) + ')');
    { programme console : la console (fenetre Invite DOS) }
    AppConsole := Sub = 3;
    { STARTF_USESTDHANDLES : sorties dans un fichier, sans console }
    AppStdOut := KNextStd; AppStdIn := KNextIn;
    If KNextStd <> 0 Then AppConsole := False;
    { debogage : INT 3 au point d'entree (premier arret) }
    If KNextDbg <> 0 Then
    Begin
      DbgEntry := AppEntry; DbgEntryB := Mem[0:AppEntry];
      Mem[0:AppEntry] := $CC;
    End;
    If AppConsole Then
    Begin
      If ConW < 0 Then ConTitle := '';
      ConEnsure;
    End;
    T := ThreadNew(AppEntry, 0, Stk, True);
    If (T >= 0) And Susp Then Threads[T].Susp := 1;
    AppMainT := T;
  End;
  ProcLeave;
  CursorSetShape(0);
  If (M < 0) Or (T < 0) Then
  Begin
    KillProc(P, -1);
    If M < 0 Then
      MsgBoxOpen(BaseName(S), L(
        'Ce fichier n''est pas un programme Windows 32 bits valide.',
        'This file is not a valid 32-bit Windows program.',
        'Diese Datei ist kein g'#129'ltiges 32-Bit-Windows-Programm.',
        'Il file non '#138' un programma Windows a 32 bit valido.',
        'Este archivo no es un programa de Windows de 32 bits v'#160'lido.'),
        $10);
    Exit;
  End;
  ProcStart := P;
End;

Function RunExe(Path, Args : String) : Boolean;
Var M, T, Sub : LongInt; S : String;
Begin
  RunExe := False;
  { programme Windows 3.x (NE) : sous-systeme Win16 }
  S := FindModuleFile(Path);
  If (S <> '') And IsNeFile(S) And Not IsDosFile(S) Then
  Begin
    KLog('Lancement de ' + S + ' (Win16)');
    RunExe := RunNe(S, Args, 1);
    Exit;
  End;
  S := FindModuleFile(Path);
  If S = '' Then Exit;
  { programme MS-DOS : machine virtuelle 8086 }
  If IsDosFile(S) Then
  Begin
    RunExe := RunDos(S, Args);
    Exit;
  End;
  RunExe := True;
  ProcStart(S, Args, '', 1, False);
End;

{ ------------------------------------------------------------------ }
{ Lancer un programme depuis un autre (Invite DOS)                  }
{ ------------------------------------------------------------------ }
{ Un seul programme Win32 a la fois : CreateProcessA note le programme
  demande ; quand l'appelant l'attend (WaitForSingleObject), il se
  termine, le programme demande demarre, puis l'appelant est relance
  (l'Invite DOS avec /R : sans banniere, meme console, meme
  repertoire). }

{ ------------------------------------------------------------------ }
{ Debogage Win32 : CreateProcess (DEBUG_PROCESS), WaitForDebugEvent,  }
{ ContinueDebugEvent, Get/SetThreadContext, Read/WriteProcessMemory,  }
{ DebugBreakProcess. Une session a la fois. Les programmes tournent   }
{ en anneau 0 : une faute du programme debogue (INT 3, pas a pas TF,  }
{ exception) arrete sa tache dans Trap, le cadre de la faute restant  }
{ sur sa pile (ses registres) jusqu'a ContinueDebugEvent. Jamais      }
{ d'arret dans le code du noyau (verrous, peinture du bureau).        }
{ ------------------------------------------------------------------ }

{ debut : CREATE_PROCESS_DEBUG_EVENT, tache principale suspendue }
Procedure DbgStart(P : LongInt);
Var T : LongInt;
Begin
  DbgOn := True; DbgProc := P; DbgOwner := CurProc;
  DbgPause := False; DbgStop := False; DbgBusy := False;
  T := Procs^[P].MainT;
  DbgT := T; DbgFrame := 0;
  FillMem(LongInt(@DbgEv), 96, 0);
  DbgEv[0] := 3; DbgEv[1] := Procs^[P].Pid; DbgEv[2] := ThreadId(T);
  DbgEv[4] := KHandle(Procs^[P].Obj);
  If Threads[T].KObj >= 0 Then DbgEv[5] := KHandle(Threads[T].KObj);
  DbgEv[6] := Procs^[P].Base; DbgEv[10] := DbgEntry;
  DbgPend := True;
End;

{ faute de la tache courante (Trap) : True si traitee (reprise) }
Function DbgTrapK(Vec, F : LongInt) : Boolean;
Var E, Eip, Cd, Ad, N : LongInt;
Begin
  DbgTrapK := False;
  If (CurT <= 0) Or (ThrProc[CurT] <> DbgProc) Then Exit;
  E := Vec And 255;
  If Vec >= 256 Then DbgOfs := 4 Else DbgOfs := 0;
  Eip := MemL[0:F + 44 + DbgOfs];
  { dans le noyau : pas a pas poursuivi jusqu'au retour au programme }
  If (Eip >= KImgLo) And (Eip < KImgHi) Then
  Begin
    DbgTrapK := E = 1;
    Exit;
  End;
  FillMem(LongInt(@DbgEv), 96, 0);
  N := 0; Ad := Eip;
  Case E Of
    3 :
      Begin
        Cd := $80000003; Ad := Eip - 1;
        If (DbgEntry <> 0) And (Eip - 1 = DbgEntry) Then
        Begin
          { premier arret : le point d'entree, octet d'origine rendu }
          Mem[0:DbgEntry] := DbgEntryB;
          MemL[0:F + 44] := DbgEntry;
          DbgEntry := 0;
        End;
      End;
    1 :
      Begin
        MemL[0:F + 52] := MemL[0:F + 52] And Not $100;
        If DbgPause Then Cd := $80000003 Else Cd := $80000004;
        DbgPause := False;
      End;
    0 : Cd := LongInt($C0000094);
    4 : Cd := LongInt($C0000095);
    5 : Cd := LongInt($C000008C);
    6 : Cd := LongInt($C000001D);
    16 : Cd := LongInt($C0000090);
    17 : Cd := LongInt($80000002);
    14 :
      Begin
        Cd := LongInt($C0000005); N := 2;
        DbgEv[8] := (MemL[0:F + 44] Shr 1) And 1;
        asm
          mov eax,cr2
          mov N,eax
        end;
        DbgEv[9] := N; N := 2;
      End;
  Else
    Cd := LongInt($C0000005);
  End;
  DbgEv[0] := 1; DbgEv[1] := Procs^[DbgProc].Pid; DbgEv[2] := ThreadId(CurT);
  DbgEv[3] := Cd; DbgEv[6] := Ad; DbgEv[7] := N; DbgEv[23] := 1;
  DbgT := CurT; DbgFrame := F; DbgCont := $10002;
  DbgStop := True; DbgPend := True;
  asm
    sti
  end;
  While DbgStop And DbgOn Do KSleep(5);
  DbgFrame := 0; DbgT := -1;
  { DBG_EXCEPTION_NOT_HANDLED : faute ordinaire (programme arrete) }
  DbgTrapK := (E = 1) Or (E = 3) Or (DbgCont <> LongInt($80010001));
End;

Function WaitForDebugEvent(PEv, Ms : LongInt) : LongInt;
Var T0 : LongInt;
Begin
  WaitForDebugEvent := 0;
  T0 := Ticks;
  Repeat
    If DbgOn And DbgPend And (CurProc = DbgOwner) Then
    Begin
      MoveMem(LongInt(@DbgEv), PEv, 96);
      DbgPend := False; DbgBusy := True;
      WaitForDebugEvent := 1;
      Exit;
    End;
    If (Ms <> -1) And (Ticks - T0 >= Ms) Then Break;
    KSleep(10);
  Until False;
  SetErr(121);
End;

Function ContinueDebugEvent(Pid, Tid, St : LongInt) : LongInt;
Begin
  ContinueDebugEvent := 0;
  If Not DbgOn Or Not DbgBusy Then Exit;
  DbgBusy := False; DbgCont := St;
  Case DbgEv[0] Of
    3 : If DbgT >= 0 Then Threads[DbgT].Susp := 0;
    5 : DbgOn := False;
  Else
    DbgStop := False;
  End;
  ContinueDebugEvent := 1;
End;

Function DebugBreakProcess(H : LongInt) : LongInt;
Begin
  DbgPause := DbgOn;
  DebugBreakProcess := Ord(DbgOn);
End;

Function IsDebuggerPresent : LongInt;
Begin
  IsDebuggerPresent := Ord(DbgOn And (ThrProc[CurT] = DbgProc));
