Function GetSystemMetrics(I : LongInt) : LongInt;
Begin
  If I = 23 Then
  Begin
    GetSystemMetrics := Ord(MouSwap);                 { SM_SWAPBUTTON }
    Exit;
  End;
  Case I Of
    0, 16 : GetSystemMetrics := ScrW;
    1 : GetSystemMetrics := ScrH;
    17 : GetSystemMetrics := TaskY - 19;
    2, 3, 9, 10, 20, 21 : GetSystemMetrics := 16;
    4, 15 : GetSystemMetrics := 18;
    5, 6 : GetSystemMetrics := 1;
    7, 8 : GetSystemMetrics := 3;
    11, 12, 13, 14, 38, 39 : GetSystemMetrics := 32;
    19, 43 : GetSystemMetrics := 2;
    28 : GetSystemMetrics := 112;
    29 : GetSystemMetrics := 27;
    30, 31 : GetSystemMetrics := 18;
    32, 33 : GetSystemMetrics := 4;
    34 : GetSystemMetrics := 112;
    35 : GetSystemMetrics := 27;
    36, 37 : GetSystemMetrics := 4;
    49, 50 : GetSystemMetrics := 16;
    61, 62 : GetSystemMetrics := ScrW;
  Else
    GetSystemMetrics := 0;
  End;
End;

{ LOGFONTA (60 octets) des elements de Windows 95 : MS Sans Serif 8
  points (hauteur -11), gras pour les titres }
Procedure SysLogFont(P, Weight : LongInt);
Begin
  FillMem(P, 60, 0);
  MemL[0:P] := -11;
  MemL[0:P + 16] := Weight;
  PutPStr(P + 28, 'MS Sans Serif', 32);
End;

Function SystemParametersInfoA(Act, Param, PV, WinIni : LongInt) : LongInt;
Var R : TRect;
Begin
  SystemParametersInfoA := 1;
  { souris et clavier (Panneau de configuration) ; SPIF_UPDATEINIFILE :
    dans HKCU\Control Panel }
  Case Act Of
    10, 22, 112 :
    Begin
      If PV <> 0 Then
        Case Act Of
          10 : MemL[0:PV] := KbSpeed;
          22 : MemL[0:PV] := KbDelay;
        Else
          MemL[0:PV] := MouSpd;
        End;
      Exit;
    End;
    11, 23, 32, 33, 113 :
    Begin
      Case Act Of
        11 : KbSpeed := Max(0, Min(Param, 31));
        23 : KbDelay := Max(0, Min(Param, 3));
        32 : If Param <= 0 Then DblMs := 500 Else DblMs := Min(Param, 5000);
        33 : MouSwap := Param <> 0;
      Else
        MouSpd := Max(1, Min(PV, 20));
      End;
      If (Act = 11) Or (Act = 23) Then KbTypematic;
      If (WinIni And 1) <> 0 Then InputSave;
      Exit;
    End;
  End;
  Case Act Of
    48 :
    Begin
      SetR(R, 0, 0, ScrW, TaskY);
      PutRectAt(PV, R);
    End;
    { SPI_GETICONTITLELOGFONT }
    31 : If PV <> 0 Then SysLogFont(PV, 400);
    { SPI_GETNONCLIENTMETRICS : NONCLIENTMETRICSA (340 octets) }
    41 :
      If PV <> 0 Then
      Begin
        FillMem(PV, 340, 0);
        MemL[0:PV] := 340;
        MemL[0:PV + 4] := 1; MemL[0:PV + 8] := 16; MemL[0:PV + 12] := 16;
        MemL[0:PV + 16] := 18; MemL[0:PV + 20] := 18;
        SysLogFont(PV + 24, 700);
        MemL[0:PV + 84] := 12; MemL[0:PV + 88] := 14;
        SysLogFont(PV + 92, 700);
        MemL[0:PV + 152] := 18; MemL[0:PV + 156] := 18;
        SysLogFont(PV + 160, 400);
        SysLogFont(PV + 220, 400);
        SysLogFont(PV + 280, 400);
      End;
  Else
    If PV <> 0 Then
      If (Act And 1) = 0 Then MemL[0:PV] := 0;
  End;
End;

