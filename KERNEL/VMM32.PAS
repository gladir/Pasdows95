Function MulDiv(A, B, C : LongInt) : LongInt;
Var R : Real;
Begin
  If C = 0 Then
  Begin
    MulDiv := -1;
    Exit;
  End;
  R := (A * 1.0) * B / C;
  If R >= 0 Then R := R + 0.5 Else R := R - 0.5;
  MulDiv := Trunc(R);
End;

