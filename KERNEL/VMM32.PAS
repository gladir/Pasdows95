    icChip :
    Begin
      IFrame(7, 7, 24, 24, cBlack);
      For I := 0 To 4 Do
      Begin
        QR(9 + I * 3, 4, 10 + I * 3, 6, cGray);
        QR(9 + I * 3, 25, 10 + I * 3, 27, cGray);
        QR(4, 9 + I * 3, 6, 10 + I * 3, cGray);
        QR(25, 9 + I * 3, 27, 10 + I * 3, cGray);
      End;
    End;
    icDiskCtl :
    Begin
      IFrame(2, 9, 29, 22, cSilver);
      QR(5, 12, 26, 13, cGray);
      QR(5, 17, 26, 18, cGray);
      QR(23, 19, 25, 20, cGreen);
    End;
    icClock :
    Begin
      QD(16, 16, 13, cWhite);
      QC(16, 16, 13, cBlack);
      QL(16, 16, 16, 7, cBlack);
      QL(16, 16, 23, 16, cBlack);
      For I := 0 To 3 Do
        QR(15 + (I Mod 2) * 0, 4, 16, 5, cBlack);
      QR(26, 15, 27, 16, cBlack);
      QR(15, 26, 16, 27, cBlack);
      QR(4, 15, 5, 16, cBlack);
    End;
    icHelp :
    Begin
      IFrame(5, 3, 26, 28, cNavy);
      QR(7, 5, 24, 26, cBlue);
      QR(23, 4, 25, 27, cWhite);
      QR(12, 9, 18, 10, cYellow);
      QR(18, 10, 19, 14, cYellow);
      QR(14, 15, 18, 16, cYellow);
      QR(14, 17, 15, 19, cYellow);
      QR(14, 22, 15, 23, cYellow);
    End;
    icRun :
    Begin
      IFrame(2, 6, 25, 27, cSilver);
      QR(3, 7, 24, 10, cNavy);
      QR(3, 11, 24, 26, cWhite);
      QL(14, 18, 29, 3, cBlack);
      QL(15, 18, 30, 3, cBlack);
      QR(24, 2, 30, 3, cBlack);
      QR(29, 2, 30, 8, cBlack);
    End;
    icShutdown :
    Begin
      IconMonitor(cBlack);
      IFrame(2, 25, 29, 29, cSilver);
      QC(16, 11, 4, cRed);
      QR(15, 5, 16, 11, cRed);
    End;
    icPaint :
    Begin
      QD(16, 17, 13, cSilver);
      QC(16, 17, 13, cBlack);
      QD(10, 12, 3, cRed);
      QD(18, 9, 3, cYellow);
      QD(24, 15, 3, cBlue);
      QD(22, 23, 3, cLime);
      QD(11, 21, 3, cWhite);
      QL(4, 30, 15, 17, cMaroon);
      QL(5, 30, 16, 17, cMaroon);
