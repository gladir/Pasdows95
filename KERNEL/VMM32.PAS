Function lstrcpynA(Dst, Src, N : LongInt) : LongInt;
Var LN : LongInt;
Begin
  If N > 0 Then
  Begin
    LN := Min(StrLenZ(Src), N - 1);
    MoveMem(Src, Dst, LN);
    Mem[0:Dst + LN] := 0;
  End;
  lstrcpynA := Dst;
End;

Function lstrcatA(Dst, Src : LongInt) : LongInt;
