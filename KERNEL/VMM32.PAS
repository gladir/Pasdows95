Begin
  NetPoll;
  If NicBase = 0 Then
  Begin
    MsgBoxOpen(NetTitle, L('Aucune carte r'#130'seau NE2000 n''a ' +
      #130't'#130' d'#130'tect'#130'e. TCP/IP fonctionne seulement en boucle ' +
      'locale ' +
