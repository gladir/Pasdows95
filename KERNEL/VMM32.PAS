      Gc^.S.FogMd := DRound(GlPv(P, 0, Fl));
      If Fl Then Gc^.S.FogMd := DRound(FlM(P));
    End;
    $0B62 : Gc^.S.FogD := GlPv(P, 0, Fl);
    $0B63 : Gc^.S.FogS := GlPv(P, 0, Fl);
    $0B64 : Gc^.S.FogE := GlPv(P, 0, Fl);
    $0B66 : For K := 0 To 3 Do Gc^.S.FogC[K] := GlPc(P, K, Fl);
  End;
End;

