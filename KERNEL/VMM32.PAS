{ DNS (resolveur)                                                      }
{ ------------------------------------------------------------------ }

Function DnsSkipName(P : LongInt) : LongInt;
Var B : LongInt;
Begin
  Repeat
    B := Mem[0:P];
    If B = 0 Then
    Begin
      DnsSkipName := P + 1;
      Exit;
    End;
    If (B And $C0) = $C0 Then
    Begin
      DnsSkipName := P + 2;
      Exit;
    End;
    P := P + 1 + B;
  Until False;
End;

Procedure DnsInput(P, Len : LongInt);
Var QD, AN, I, Q, Typ, RL, E : LongInt;
Begin
  If (Len < 12) Or (NGetW(P) <> DnsId) Then Exit;
  If (Mem[0:P + 3] And 15) <> 0 Then
  Begin
    DnsResult := -2;
    Exit;
  End;
  QD := NGetW(P + 4); AN := NGetW(P + 6);
  Q := P + 12; E := P + Len;
  For I := 1 To QD Do Q := DnsSkipName(Q) + 4;
  For I := 1 To AN Do
  Begin
    If Q >= E Then Break;
    Q := DnsSkipName(Q);
    Typ := NGetW(Q); RL := NGetW(Q + 8);
    If (Typ = 1) And (RL = 4) And (NGetW(Q + 2) = 1) Then
    Begin
      DnsResult := MemL[0:Q + 10];
      Exit;
    End;
    Q := Q + 10 + RL;
  End;
  DnsResult := -2;
End;

{ Nom -> adresse IP ; False si introuvable }
{ fichier HOSTS du dossier systeme (comme C:\WINDOWS\HOSTS de
  Windows 95) : lignes "adresse nom [nom...]", # pour un commentaire }
Function HostsLookup(Const U : String; Var IP : LongInt) : Boolean;
Var B : Array[0..4095] Of Byte; H, N, I, K : LongInt; Ln, Tk, Ad : String;
    Cm : Boolean;
Begin
  HostsLookup := False;
  H := KOpenFile(SysDir + 'HOSTS', False, 3);
  If H = INVALID_HANDLE Then Exit;
  N := 0;
  If Not KReadFile(H, LongInt(@B[0]), 4095, N) Then N := 0;
  CloseHandle(H);
  B[N] := 10;
  Ln := '';
  For I := 0 To N Do
    If (B[I] = 10) Or (B[I] = 13) Then
    Begin
      { decouper la ligne en mots ; le premier est l'adresse }
      Ad := ''; Tk := ''; Cm := False;
      Ln := Ln + ' ';
      For K := 1 To Length(Ln) Do
      Begin
        If Ln[K] = '#' Then Cm := True;
        If Cm Then Continue;
        If (Ln[K] = ' ') Or (Ln[K] = #9) Then
        Begin
          If Tk <> '' Then
          Begin
            If Ad = '' Then Ad := Tk
            Else If (UpStr(Tk) = U) And ParseIp(Ad, IP) Then
            Begin
              HostsLookup := True;
              Exit;
            End;
          End;
          Tk := '';
        End
        Else If Length(Tk) < 255 Then Tk := Tk + Ln[K];
      End;
      Ln := '';
    End
    Else If Length(Ln) < 250 Then Ln := Ln + Chr(B[I]);
End;

Function NetLookup(Name : String; Var IP : LongInt) : Boolean;
Var D, O, I, K, N, T, Try0 : LongInt; Lb : String; U : String;
Begin
  NetLookup := True;
  If ParseIp(Name, IP) Then Exit;
  U := UpStr(Name);
  If (U = 'LOCALHOST') Or (U = '') Then
  Begin
    IP := $0100007F;
    Exit;
  End;
  If HostsLookup(U, IP) Then Exit;
  If (U = 'PASDOWS') And (NetIP <> 0) Then
  Begin
    IP := NetIP;
    Exit;
  End;
  NetLookup := False;
  If (NicBase = 0) Or DnsBusy Then Exit;
  If Not NetReady(5000) Or (NetDns = 0) Then Exit;
  If Not NetResolve(NetDns) Then Exit;
  DnsBusy := True;
  For Try0 := 1 To 3 Do
  Begin
    DnsId := (DnsId + 1) And $FFFF;
    DnsPort := EphemeralPort(2);
    D := NetTx + 42;
    NPutW(D, DnsId); NPutW(D + 2, $0100);
    NPutW(D + 4, 1); NPutW(D + 6, 0); NPutW(D + 8, 0); NPutW(D + 10, 0);
    O := D + 12;
    Lb := Name + '.';
    K := 1;
    For I := 1 To Length(Lb) Do
      If Lb[I] = '.' Then
      Begin
        N := I - K;
        If N > 0 Then
        Begin
          Mem[0:O] := N;
          For T := 0 To N - 1 Do Mem[0:O + 1 + T] := Ord(Lb[K + T]);
          O := O + 1 + N;
        End;
        K := I + 1;
      End;
    Mem[0:O] := 0;
    NPutW(O + 1, 1); NPutW(O + 3, 1);
    O := O + 5;
    DnsResult := 0;
    UdpOut(DnsPort, NetDns, 53, O - D);
    T := Ticks;
    While (DnsResult = 0) And (Ticks - T < 2000) Do NetWait;
    If DnsResult <> 0 Then Break;
  End;
  DnsBusy := False;
  If (DnsResult = 0) Or (DnsResult = -2) Then Exit;
  IP := DnsResult;
  NetLookup := True;
End;

