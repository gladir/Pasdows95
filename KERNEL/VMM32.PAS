  wglSwapLayerBuffers := SwapBuffers(Hdc);
End;

{ fin du processus : contextes et textures oublies (blocs liberes par
  KFreeOwner) }
Procedure GlProcDone(P : LongInt);
Var I : LongInt;
Begin
  If (GlProc <> P) Or (GlProc = 0) Then Exit;
  For I := 0 To 15 Do GlCtx[I] := 0;
  GlSel(0);
  GlTexT := 0;
  GlProc := 0;
  GlScOn := False;
End;

