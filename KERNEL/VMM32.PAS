{ WININIT.INI au demarrage, comme WININIT.EXE de Windows 95 : chaque
  ligne de la section [rename] remplace un fichier qui etait en service
  (DEST=SOURCE) ou le supprime (NUL=FICHIER) ; les programmes
  d'installation et de desinstallation s'en servent (l'amorce d'Office
  y inscrit son dossier temporaire). Le fichier devient WININIT.BAK. }
Procedure WinInitRun;
Var F, Size, I, P, N : LongInt; Ch : Char; InRen : Boolean;
    Ln, L, R, Z1, Z2 : String;
Begin
  If UpStr(SysDir) <> 'C:\WINDOWS\' Then Exit;
  F := LoadWholeFile('C:\WINDOWS\WININIT.INI', Size);
  If F = 0 Then Exit;
  InRen := False; N := 0; I := 0; Ln := '';
  While I <= Size Do
  Begin
    If I < Size Then Ch := Chr(Mem[0:F + I]) Else Ch := #10;
    Inc(I);
    If (Ch = #13) Or (Ch = #10) Then
    Begin
      Ln := Trim(Ln);
      If (Ln <> '') And (Ln[1] = '[') Then InRen := UpStr(Ln) = '[RENAME]'
      Else If InRen And (Ln <> '') And (Ln[1] <> ';') Then
      Begin
        P := Pos('=', Ln);
        If P > 1 Then
        Begin
          L := Trim(Copy(Ln, 1, P - 1));
          R := Trim(Copy(Ln, P + 1, 255));
          Z1 := L + #0; Z2 := R + #0;
          If UpStr(L) = 'NUL' Then DeleteFileA(LongInt(@Z2[1]))
          Else
          Begin
            DeleteFileA(LongInt(@Z1[1]));
            MoveFileA(LongInt(@Z2[1]), LongInt(@Z1[1]));
          End;
          Inc(N);
        End;
      End;
      Ln := '';
    End
    Else If Length(Ln) < 255 Then Ln := Ln + Ch;
  End;
  KFree(F);
  Z1 := 'C:\WINDOWS\WININIT.BAK'#0; Z2 := 'C:\WINDOWS\WININIT.INI'#0;
  DeleteFileA(LongInt(@Z1[1]));
  MoveFileA(LongInt(@Z2[1]), LongInt(@Z1[1]));
  KLog('WININIT.INI : ' + IntStr(N) + ' operation(s)');
End;

Function GetTempFileNameA(PPath, PPre, Uniq, Buf : LongInt) : LongInt;
Var S, P, Pre : String; N, H : LongInt;
Begin
  P := PStr(PPath);
  If (P <> '') And (P[Length(P)] <> '\') Then P := P + '\';
  Pre := Copy(PStr(PPre), 1, 3);
  N := Uniq And $FFFF;
  If N = 0 Then N := (Ticks And $FFF) + 1;
  Repeat
    S := P + Pre + HexStr(N, 4) + '.TMP';
    If Uniq <> 0 Then Break;
    PutPStr(Buf, S, 260);
    If GetFileAttributesA(Buf) = -1 Then
    Begin
      H := KOpenFile(S, True, 2);
      If H <> INVALID_HANDLE Then CloseHandle(H);
      Break;
    End;
    N := (N + 1) And $FFFF;
  Until False;
  PutPStr(Buf, S, 260);
  GetTempFileNameA := N;
End;

Function SearchPathA(PPath, PFile, PExt, N, Buf, PPart : LongInt)
  : LongInt;
Var F, S, D : String; K : LongInt;
Begin
  SearchPathA := 0;
  F := PStr(PFile);
  If (PExt <> 0) And (Pos('.', BaseName(F)) = 0) Then F := F + PStr(PExt);
  For K := 0 To 5 Do
  Begin
    Case K Of
      0 : If PPath <> 0 Then D := PStr(PPath) Else D := ParentDir(AppPath);
      1 : D := CurDirS;
      2 : D := 'C:\WINDOWS\SYSTEM';
      3 : D := 'C:\WINDOWS';
      4 : D := 'D:';
    Else
      D := '';
    End;
    If (Pos('\', F) > 0) Or (Pos(':', F) > 0) Then S := FullPath(F)
    Else If D = '' Then Continue
    Else S := FullPath(D + '\' + F);
    PutPStr(Buf, S, N);
    If GetFileAttributesA(Buf) <> -1 Then
    Begin
      If PPart <> 0 Then
        MemL[0:PPart] := Buf + Length(S) - Length(BaseName(S));
      SearchPathA := Length(S);
      Exit;
    End;
    If (Pos('\', F) > 0) Or (Pos(':', F) > 0) Then Break;
  End;
  If N > 0 Then Mem[0:Buf] := 0;
  SetErr(ErrFileNotFound);
End;

Function SystemTimeToFileTime(St, Ft : LongInt) : LongInt;
Var Dos : LongInt;
Begin
  Dos := ((MemW[0:St] - 1980) Shl 25) Or (MemW[0:St + 2] Shl 21) Or
         (MemW[0:St + 6] Shl 16) Or (MemW[0:St + 8] Shl 11) Or
         (MemW[0:St + 10] Shl 5) Or (MemW[0:St + 12] Div 2);
  DosToFileTime(Dos, Ft);
  SystemTimeToFileTime := 1;
End;

{ Valeurs regionales courantes (francais ou anglais) }
Function GetLocaleInfoA(Lcid, Typ, Buf, N : LongInt) : LongInt;
Var S : String;
Begin
  Case Typ And $FFFF Of
    1 : S := '040C';
    2, 4 : S := 'Francais';
    3 : S := 'FRA';
    5, 6, 7 : S := 'France';
    8 : S := '33';
    $B : S := '850';
    $C : S := ';';
    $E : S := ',';
    $F : S := ' ';
    $14 : S := 'F';
    $15 : S := 'FRF';
    $1D : S := '/';
    $1E : S := ':';
    $1F : S := 'dd/MM/yy';
    $20 : S := 'dddd d MMMM yyyy';
    $21 : S := '1';
    $23 : S := '1';
    $1004 : S := '1252';
    $5A : S := 'FR';
  Else
    S := '0';
  End;
  If Language = _English Then
    Case Typ And $FFFF Of
      1 : S := '0409';
      2, 4 : S := 'English';
      3 : S := 'ENU';
      5, 6, 7 : S := 'United States';
      8 : S := '1';
      $B : S := '437';
      $C, $E : S := ',';
      $D : S := '.';
    End;
  If (Buf <> 0) And (N > 0) Then PutPStr(Buf, S, N);
  GetLocaleInfoA := Length(S) + 1;
End;

{ Projection de fichiers : la vue est une copie du fichier, recrite a
  UnmapViewOfFile / FlushViewOfFile si elle est modifiable }
{ Mappage : F1 fichier (-1 : memoire), F2 taille, F3 protection, F4
  bloc partage (alloue au premier MapViewOfFile, rendu avec l'objet) ;
  toutes les vues d'un mappage (memes processus ou non) partagent ce
  bloc, comme la memoire partagee de Windows 95 }
Function CreateFileMappingA(HFile, Sec, Prot, SzHi, SzLo, Name : LongInt)
  : LongInt;
Var I, Sz : LongInt; S : String;
Begin
  CreateFileMappingA := 0;
  S := '';
  If Name <> 0 Then S := KNameNorm(Name);
  I := KNamed(S);
  If I >= 0 Then
  Begin
    If KObjs^[I].Kind <> koMapping Then
    Begin
      SetErr(6);
      Exit;
    End;
    KRefAdd(I);
    SetErr(183);
    CreateFileMappingA := KHandle(I);
    Exit;
  End;
  I := KObjNew(koMapping);
  If I < 0 Then Exit;
  KObjOwner[I] := 0;
  Sz := SzLo;
  If (Sz = 0) And (HFile <> -1) Then Sz := GetFileSize(HFile, 0);
  KObjs^[I].F1 := HFile;
  KObjs^[I].F2 := Sz;
  KObjs^[I].F3 := Prot;
  KObjs^[I].F4 := 0;
  KObjs^[I].Name := S;
  KRefAdd(I);
  SetErr(0);
  CreateFileMappingA := KHandle(I);
End;

Function OpenFileMappingA(Acc, Inh, Name : LongInt) : LongInt;
Begin
  OpenFileMappingA := KOpenNamed(Name, koMapping);
End;

Function ViewFlush(V : LongInt) : LongInt;
Var I, H, N : LongInt;
Begin
  ViewFlush := 1;
  I := KObjOf(ViewMap[V], koMapping);
  If I < 0 Then Exit;
  H := KObjs^[I].F1;
  If (H = -1) Or ((KObjs^[I].F3 And 4) = 0) Then Exit;
  SetFilePointer(H, ViewOfs[V], 0, 0);
  N := KWriteFile(H, ViewAddr[V], ViewSize[V]);
End;

{ adresse dans une vue de mappage }
Function InView(A : LongInt) : Boolean;
Var V : LongInt;
Begin
  InView := False;
  For V := 0 To MaxView - 1 Do
    If (ViewAddr[V] <> 0) And (A >= ViewAddr[V] And Not 4095) And
       (A < ViewAddr[V] + ViewSize[V]) Then InView := True;
End;

Function MapViewOfFile(HMap, Acc, OfsHi, OfsLo, N : LongInt) : LongInt;
Var I, V, A, Got, K, Own : LongInt;
Begin
  MapViewOfFile := 0;
  I := KObjOf(HMap, koMapping);
  If I < 0 Then Exit;
  V := -1;
  For K := MaxView - 1 DownTo 0 Do
    If ViewAddr[K] = 0 Then V := K;
  If V < 0 Then Exit;
  If KObjs^[I].F4 = 0 Then
  Begin
    { bloc partage : au noyau, rendu avec le mappage ; aligne sur 64 Ko
      comme les vues de Windows (F5 : adresse a liberer) }
    Own := HeapOwner; HeapOwner := 0;
    A := KAlloc(Max(KObjs^[I].F2, 1) + 65536);
    HeapOwner := Own;
    If A = 0 Then Exit;
    KObjs^[I].F5 := A;
    A := (A + 65535) And Not 65535;
    FillMem(A, Max(KObjs^[I].F2, 1), 0);
    If KObjs^[I].F1 <> -1 Then
    Begin
      SetFilePointer(KObjs^[I].F1, 0, 0, 0);
      KReadFile(KObjs^[I].F1, A, KObjs^[I].F2, Got);
    End;
    KObjs^[I].F4 := A;
  End;
  If OfsLo >= KObjs^[I].F2 Then OfsLo := 0;
  If (N = 0) Or (OfsLo + N > KObjs^[I].F2) Then N := KObjs^[I].F2 - OfsLo;
  If N <= 0 Then N := 1;
  ViewAddr[V] := KObjs^[I].F4 + OfsLo; ViewMap[V] := HMap;
  ViewOfs[V] := OfsLo; ViewSize[V] := N;
  MapViewOfFile := ViewAddr[V];
End;

Function FlushViewOfFile(A, N : LongInt) : LongInt;
Var V : LongInt;
Begin
  FlushViewOfFile := 1;
  For V := 0 To MaxView - 1 Do
    If (ViewAddr[V] <> 0) And (A >= ViewAddr[V]) And
       (A < ViewAddr[V] + ViewSize[V]) Then ViewFlush(V);
End;

Function UnmapViewOfFile(A : LongInt) : LongInt;
Var V : LongInt;
Begin
  UnmapViewOfFile := 0;
  For V := 0 To MaxView - 1 Do
    If ViewAddr[V] = A Then
    Begin
      ViewFlush(V);
      ViewAddr[V] := 0;
      UnmapViewOfFile := 1;
    End;
End;

