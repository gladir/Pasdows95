  FillMem(I, SizeOf(TKObjPrArr), 0);
  Move(I, KObjPr, 4);
  Case Mem[0:BootInfo + 3] Mod 5 Of
    1 : Language := _English;
    2 : Language := _Germany;
    3 : Language := _Italian;
    4 : Language := _Spain;
  Else
    Language := _French;
  End;
  OptFlags := MemL[0:BootInfo + $30];
  VideoFromBoot;
  { la boite de progression remplace l'ecran noir des que le mode
