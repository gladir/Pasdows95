Procedure VmDiskFree(D : LongInt);
Var Spc, Bps, Fr, Tot : LongInt;
Begin
  If D = 0 Then D := VmDrive Else D := D - 1;
  If Not VmDriveOk(D) Then
  Begin
    VS(fEax, $FFFF);
    Exit;
  End;
  PutPStr(VmTmp + 400, Chr(65 + D) + ':\', 8);
  If GetDiskFreeSpaceA(VmTmp + 400, VmTmp, VmTmp + 4, VmTmp + 8,
                       VmTmp + 12) = 0 Then
  Begin
    VS(fEax, $FFFF);
    Exit;
  End;
  Spc := MemL[0:VmTmp]; Bps := MemL[0:VmTmp + 4];
  Fr := MemL[0:VmTmp + 8]; Tot := MemL[0:VmTmp + 12];
  { au plus FFFFh grappes (comme MS-DOS 7 sur un grand disque) }
  While ((Tot > $FFFF) Or (Fr > $FFFF)) And (Spc < 128) Do
  Begin
    Spc := Spc * 2; Tot := Tot Div 2; Fr := Fr Div 2;
  End;
  VS(fEax, Spc); VS(fEbx, Min(Fr, $FFFF));
  VS(fEcx, Bps); VS(fEdx, Min(Tot, $FFFF));
End;

Procedure VmIoctl;
Var AL, S, D : LongInt;
Begin
  AL := VRL(fEax);
  VmSetCF(False);
  Case AL Of
    $00, $01, $06, $07, $0A :
    Begin
      S := VmSftOf(VR(fEbx));
      If S < 0 Then
      Begin
        VmFail(6);
        Exit;
      End;
      Case AL Of
        $00 :
          If SftDev[S] = 1 Then VS(fEdx, $80D3)
          Else If SftDev[S] = 2 Then VS(fEdx, $8084)
          Else VS(fEdx, $40 Or (VmDrive And $1F));
        $01 : ;
        $06 :
          If SftDev[S] = 1 Then
          Begin
            VmPumpNative;
            VSL(fEax, $FF * Ord(VmBufHas Or VmLineOk));
          End
          Else If SftDev[S] = 2 Then VSL(fEax, 0)
          Else VSL(fEax, $FF * Ord(SetFilePointer(SftH[S], 0, 0, 1) <
                                   GetFileSize(SftH[S], 0)));
        $07 : VSL(fEax, $FF);
        $0A : VS(fEdx, 0);
      End;
    End;
    $08 :
    Begin
      D := VRL(fEbx);
      If D = 0 Then D := VmDrive Else D := D - 1;
      If Not VmDriveOk(D) Then VmFail(15)
      Else VS(fEax, Ord(D <> 3));
    End;
    $09 :
    Begin
      D := VRL(fEbx);
      If D = 0 Then D := VmDrive Else D := D - 1;
      If Not VmDriveOk(D) Then VmFail(15)
      Else If D = 3 Then VS(fEdx, $1000) Else VS(fEdx, 0);
    End;
    $0B : ;
    $0E, $0F : VSL(fEax, 0);
  Else
    VmFail(1);
  End;
End;

Procedure VmCountry;
Var P : LongInt;
Begin
  P := VmPtr(fDs, fEdx);
  FillMem(P, 34, 0);
  If Language = _English Then MemW[0:P] := 0 Else MemW[0:P] := 1;
  Mem[0:P + 2] := Ord('$');
  Mem[0:P + 7] := Ord(' '); Mem[0:P + 9] := Ord(',');
  Mem[0:P + 11] := Ord('/'); Mem[0:P + 13] := Ord(':');
  Mem[0:P + 16] := 2;
  If Language = _English Then Mem[0:P + 17] := 0 Else Mem[0:P + 17] := 1;
  If Language = _English Then
  Begin
    Mem[0:P + 7] := Ord(','); Mem[0:P + 9] := Ord('.');
  End;
  MemW[0:P + 18] := VmCpmO + 2; MemW[0:P + 20] := VmBios;
  Mem[0:P + 22] := Ord(',');
  VS(fEbx, 1);
  VmSetCF(False);
End;

Procedure VmCountryX;
Var AL, P, I, N : LongInt;
Begin
  AL := VRL(fEax);
  VmSetCF(False);
  Case AL Of
    $01 :
    Begin
      P := VmPtr(fEs, fEdi);
      Mem[0:P] := 1; MemW[0:P + 1] := 38; MemW[0:P + 3] := 1;
      MemW[0:P + 5] := 437;
      MemW[0:VmTmp + 900] := VR(fEdx);
      VS(fEdx, P);
      FillMem(P + 7, 34, 0);
      VS(fEdx, MemW[0:VmTmp + 900]);
      VS(fEcx, 41);
    End;
    $02, $04, $06 :
    Begin
      P := VmPtr(fEs, fEdi);
      Mem[0:P] := AL;
      MemW[0:P + 1] := VmUpO; MemW[0:P + 3] := VmDosSeg;
      VS(fEcx, 5);
    End;
    $07 :
    Begin
      P := VmPtr(fEs, fEdi);
      Mem[0:P] := 7;
      MemW[0:P + 1] := VmDbcsO; MemW[0:P + 3] := VmDosSeg;
      VS(fEcx, 5);
    End;
    $20 : VSL(fEdx, UpCh(VRL(fEdx)));
    $21 :
    Begin
      P := VmPtr(fDs, fEdx);
      For I := 0 To VR(fEcx) - 1 Do Mem[0:P + I] := UpCh(Mem[0:P + I]);
    End;
    $22 :
    Begin
      P := VmPtr(fDs, fEdx);
      N := 0;
      While (N < 65535) And (Mem[0:P + N] <> 0) Do
      Begin
        Mem[0:P + N] := UpCh(Mem[0:P + N]);
        Inc(N);
      End;
    End;
  Else
    VmFail(1);
  End;
End;

{ AH=29h : analyser un nom de fichier vers un FCB }
Procedure VmParseFcb;
Var P, F, I, N, AL : LongInt; S : String;
Begin
  P := VmPtr(fDs, fEsi);
  F := VmPtr(fEs, fEdi);
  AL := VRL(fEax);
  S := '';
  For I := 0 To 127 Do
  Begin
    If Mem[0:P + I] In [0, 13] Then Break;
    S := S + Chr(Mem[0:P + I]);
  End;
  N := Length(S);
  If (AL And 1) <> 0 Then
    While (S <> '') And (S[1] In [' ', #9, ',', ';', '=', ':', '+']) Do
      Delete(S, 1, 1);
  VmFcbName(F, S);
  VS(fEsi, VR(fEsi) + N - Length(S));
  I := 0;
  For N := 1 To 11 Do If Mem[0:F + N] = Ord('?') Then I := 1;
  If (Mem[0:F] <> 0) And Not VmDriveOk(Mem[0:F] - 1) Then I := $FF;
  VSL(fEax, I);
End;

Function DpDos(AH, AL : LongInt) : Boolean; Forward;

{ ------------------------------------------------------------------ }
{ DOS : noms longs de Windows 95 (INT 21h AX=71xxh)                   }
{ ------------------------------------------------------------------ }
{ Les noms longs des volumes FAT (VFAT), NTFS et HPFS sont accessibles
  aux programmes DOS et aux clients DPMI (pointeurs selecteur:decalage
  traduits par VmPtr). Une fonction inconnue rend CF=1 et AX=7100h,
  comme un DOS sans noms longs. }

{ Chemin complet d'un nom long de la machine (casse conservee) }
Function VmLfnPath(Lin : LongInt) : String;
Begin
  VmKeepCase := True;
  VmLfnPath := VmFullPath(PStr(Lin));
  VmKeepCase := False;
End;

{ Chemin dans VmTmp + K (ASCIIZ) }
Procedure VmTmpPut(K : LongInt; Const S : String);
Begin
  PutPStr(VmTmp + K, S, 256);
End;

{ Attributs acceptes (CL : caches, systeme, repertoires permis ; CH :
  attributs exiges) }
Function VmLfAttrOk(A, Allow, Need : LongInt) : Boolean;
Begin
  VmLfAttrOk := ((A And $16 And Not Allow) = 0) And ((A And Need) = Need);
End;

{ FILETIME en Ft -> date et heure du DOS (date en poids fort) }
Function VmFtDos(Ft : LongInt) : LongInt;
Var D, T : LongInt;
Begin
  D := 0; T := 0;
  FileTimeToDosDateTime(Ft, LongInt(@D), LongInt(@T));
  VmFtDos := ((D And $FFFF) Shl 16) Or (T And $FFFF);
End;

{ WIN32_FIND_DATA du noyau (Fd) -> tampon du programme (Dst) }
Procedure VmLfPut(Fd, Dst, Fmt : LongInt);
Var K : LongInt;
Begin
  MoveMem(Fd, Dst, 318);
  MemL[0:Dst] := MemL[0:Fd] And $3F;
  If Fmt = 1 Then
    For K := 0 To 2 Do
    Begin
      MemL[0:Dst + 4 + K * 8] := VmFtDos(Fd + 4 + K * 8);
      MemL[0:Dst + 8 + K * 8] := 0;
    End;
  { nom court seulement s'il differe du nom long }
  If UpStr(PStr(Fd + 304)) = UpStr(PStr(Fd + 44)) Then Mem[0:Dst + 304] := 0;
End;

{ Recherche suivante d'une entree K de VmLfH ; True si trouve }
Function VmLfStep(K, Dst : LongInt; First : Boolean) : Boolean;
Var Fd, Ok : LongInt;
Begin
  VmLfStep := False;
  Fd := VmTmp + 512;
  If First Then Ok := 1 Else Ok := FindNextFileA(VmLfH[K], Fd);
  While Ok <> 0 Do
  Begin
    If VmLfAttrOk(MemL[0:Fd] And $3F, VmLfAttr[K] And $FF,
                  (VmLfAttr[K] Shr 8) And $FF) Then
    Begin
      VmLfPut(Fd, Dst, VmLfFmt[K]);
      VmLfStep := True;
      Exit;
    End;
    Ok := FindNextFileA(VmLfH[K], Fd);
  End;
End;

{ Nom court de base (sans ~n) d'un nom long : 8.3 ou 11 caracteres }
Function VmLfnShort(S : String; Fcb : Boolean) : String;
Var B, E, T : String; I, P : LongInt;
Begin
  S := UpStr(S);
  T := '';
  For I := 1 To Length(S) Do If S[I] <> ' ' Then T := T + S[I];
  While (Length(T) > 0) And (T[1] = '.') Do Delete(T, 1, 1);
  P := Length(T);
  While (P > 0) And (T[P] <> '.') Do Dec(P);
  If P > 0 Then
  Begin
    B := Copy(T, 1, P - 1); E := Copy(T, P + 1, 255);
  End
  Else
  Begin
    B := T; E := '';
  End;
  T := '';
  For I := 1 To Length(B) Do
    If (B[I] <> '.') And (Length(T) < 8) Then
      If Valid83Ch(B[I]) Then T := T + B[I] Else T := T + '_';
  B := T;
  T := '';
  For I := 1 To Length(E) Do
    If Length(T) < 3 Then
      If Valid83Ch(E[I]) Then T := T + E[I] Else T := T + '_';
  E := T;
  If Fcb Then
  Begin
    While Length(B) < 8 Do B := B + ' ';
    While Length(E) < 3 Do E := E + ' ';
    VmLfnShort := B + E;
  End
  Else If E <> '' Then VmLfnShort := B + '.' + E
  Else VmLfnShort := B;
End;

{ Repertoire courant d'un lecteur (X:\...) }
Function VmCurDirOf(D : LongInt) : String;
Begin
  If VmDir[D] = '' Then VmCurDirOf := Chr(65 + D) + ':\'
  Else VmCurDirOf := Chr(65 + D) + ':' + VmDir[D];
End;

{ AX=716Ch : ouverture ou creation etendue }
Procedure VmLfnOpen(Path : String);
Var A, Disp, Act, S, H, Mode, Fl : LongInt;
Begin
  Mode := VR(fEbx) And $FF;
  Fl := VR(fEdx);
  VmTmpPut(0, Path);
  A := GetFileAttributesA(VmTmp);
  If (A <> -1) And (VmDevName(Path) = 0) Then
  Begin
    If (A And $10) <> 0 Then
    Begin
      VmFail(5);
      Exit;
    End;
    If (Fl And 3) = 0 Then
    Begin
      VmFail(80);
      Exit;
    End;
    If (Fl And 2) <> 0 Then
    Begin
      Disp := 2; Act := 3;
    End
    Else
    Begin
      Disp := 3; Act := 1;
    End;
  End
  Else If VmDevName(Path) <> 0 Then
  Begin
    Disp := 3; Act := 1;
  End
  Else If (Fl And $10) <> 0 Then
  Begin
    Disp := 1; Act := 2;
  End
  Else
  Begin
    If GetFileAttributesA(VmTmp) = -1 Then
    Begin
      PutPStr(VmTmp + 256, ParentDir(Path), 256);
      If (Length(ParentDir(Path)) > 3) And
         (GetFileAttributesA(VmTmp + 256) = -1) Then VmFail(3)
      Else VmFail(2);
    End;
    Exit;
  End;
  S := VmOpen(Path, Mode, Disp);
  If S < 0 Then
  Begin
    VmFail(VmLastErr);
    Exit;
  End;
  If (Mode And $80) <> 0 Then SftMode[S] := SftMode[S] Or $80;
  H := VmHNew(S);
  If H < 0 Then
  Begin
    SftRelease(S);
    VmFail(4);
    Exit;
  End;
  { attributs du nouveau fichier (lecture seule, cache, systeme) }
  If (Act = 2) And ((VR(fEcx) And 7) <> 0) Then
    SetFileAttributesA(VmTmp, VR(fEcx) And $27);
  VS(fEax, H);
  VS(fEcx, Act);
End;

{ AX=7143h : attributs et dates d'un fichier (BL) }
Procedure VmLfnAttr(Path : String);
Var A, H, Fd, T, Sub : LongInt;
Begin
  VmTmpPut(0, Path);
  Sub := VRL(fEbx);
  A := GetFileAttributesA(VmTmp);
  If A = -1 Then
  Begin
    VmFail(VmErrOf(2));
    Exit;
  End;
  Fd := VmTmp + 512;
  Case Sub Of
    0 :
    Begin
      If A = $80 Then A := 0;
      VS(fEcx, A And $37);
    End;
    1 : If SetFileAttributesA(VmTmp, VR(fEcx) And $27) = 0 Then
          VmFail(VmErrOf(5));
    2, 4, 6, 8 :
    Begin
      H := FindFirstFileA(VmTmp, Fd);
      If H = INVALID_HANDLE Then
      Begin
        VmFail(2);
        Exit;
      End;
      FindClose(H);
      Case Sub Of
        2 :
        Begin
          VS(fEax, MemL[0:Fd + 32]); VS(fEdx, MemL[0:Fd + 32] Shr 16);
        End;
        4 :
        Begin
          T := VmFtDos(Fd + 20);
          VS(fEcx, T); VS(fEdi, T Shr 16);
        End;
        6 :
        Begin
          T := VmFtDos(Fd + 12);
          VS(fEdi, T Shr 16);
        End;
      Else
        T := VmFtDos(Fd + 4);
        VS(fEcx, T); VS(fEdi, T Shr 16); VS(fEsi, 0);
      End;
    End;
    3, 5, 7 :
    Begin
      If (A And $10) <> 0 Then Exit;
      If Sub = 5 Then DosDateTimeToFileTime(VR(fEdi), 0, VmTmp + 256)
      Else DosDateTimeToFileTime(VR(fEdi), VR(fEcx), VmTmp + 256);
      H := KOpenFile(Path, True, 3);
      If H = INVALID_HANDLE Then
      Begin
        VmFail(VmErrOf(5));
        Exit;
      End;
      Case Sub Of
        3 : SetFileTime(H, 0, 0, VmTmp + 256);
        5 : SetFileTime(H, 0, VmTmp + 256, 0);
      Else
        SetFileTime(H, VmTmp + 256, 0, 0);
      End;
      CloseHandle(H);
    End;
  Else
    VmFail(1);
  End;
End;

{ AX=7141h : supprimer (SI=1 : jokers, CL/CH attributs) }
Procedure VmLfnDelete(Path : String);
Var H, Fd, Ok, N, Allow, Need : LongInt; Dir, F : String;
Begin
  VmTmpPut(0, Path);
  If VR(fEsi) <> 1 Then
  Begin
    If DeleteFileA(VmTmp) = 0 Then VmFail(VmErrOf(2));
    Exit;
  End;
  Allow := VRL(fEcx); Need := VRH(fEcx);
  Dir := ParentDir(Path);
  If (Dir <> '') And (Dir[Length(Dir)] <> '\') Then Dir := Dir + '\';
  Fd := VmTmp + 512;
  H := FindFirstFileA(VmTmp, Fd);
  If H = INVALID_HANDLE Then
  Begin
    VmFail(2);
    Exit;
  End;
  N := 0;
  Ok := 1;
  While Ok <> 0 Do
  Begin
    F := PStr(Fd + 44);
    If ((MemL[0:Fd] And $10) = 0) And
       VmLfAttrOk(MemL[0:Fd] And $3F, Allow, Need) Then
    Begin
      VmTmpPut(256, Dir + F);
      If DeleteFileA(VmTmp + 256) <> 0 Then Inc(N);
    End;
    Ok := FindNextFileA(H, Fd);
  End;
  FindClose(H);
  If N = 0 Then VmFail(2);
End;

{ AX=71A6h : informations d'un fichier ouvert (BY_HANDLE_FILE_INFO) }
Procedure VmLfnInfo;
Var S, I, B, A : LongInt;
Begin
  S := VmSftOf(VR(fEbx));
  If S < 0 Then
  Begin
    VmFail(6);
    Exit;
  End;
  B := VmPtr(fDs, fEdx);
  FillMem(B, 52, 0);
  If SftDev[S] <> 0 Then Exit;
  I := KObjOf(SftH[S], koFile);
  A := $20;
  If I >= 0 Then
  Begin
    PutPStr(VmTmp, KObjs^[I].Name, 256);
    A := GetFileAttributesA(VmTmp);
    If (A = -1) Or (A = $80) Then A := $20;
  End;
  MemL[0:B] := A And $37;
  GetFileTime(SftH[S], B + 4, B + 12, B + 20);
  MemL[0:B + 28] := $12345678;
  MemL[0:B + 32] := 0;
  MemL[0:B + 36] := GetFileSize(SftH[S], 0);
  MemL[0:B + 40] := 1;
  MemL[0:B + 44] := 0; MemL[0:B + 48] := S;
End;

{ AX=71A0h : informations du volume }
Procedure VmLfnVolume;
Var P, D, Mc, Fl, N : LongInt; R, Fs : String;
Begin
  P := VmPtr(fDs, fEdx);
  R := PStr(P);
  If (Length(R) >= 1) And (UpCase(R[1]) In ['A'..'Z']) Then
    D := Ord(UpCase(R[1])) - 65
  Else D := VmDrive;
  If Not VmDriveOk(D) Then
  Begin
    VmFail(15);
    Exit;
  End;
  VmTmpPut(0, Chr(65 + D) + ':\');
  Mc := 255; Fl := 0;
  FillMem(VmTmp + 256, 32, 0);
  If GetVolumeInformationA(VmTmp, 0, 0, 0, LongInt(@Mc), LongInt(@Fl),
                           VmTmp + 256, 32) = 0 Then
  Begin
    VmFail(15);
    Exit;
  End;
  Fs := PStr(VmTmp + 256);
  If Fs = '' Then Fs := 'FAT';
  N := VR(fEcx);
  If N > 0 Then PutPStr(VmPtr(fEs, fEdi), Fs, N);
  { recherche sans tenir compte de la casse, casse conservee, Unicode,
    fonctions des noms longs }
  If Mc > 12 Then VS(fEbx, $4006) Else VS(fEbx, $4000);
  VS(fEcx, Mc);
  VS(fEdx, Mc + 5);
End;

Procedure VmLfn(AL : LongInt);
Var P, K, H, Fd, T, D : LongInt; Path, R : String;
Begin
  VmSetCF(False);
  Case AL Of
    $0D : ;
    $39, $3A :
    Begin
      Path := VmLfnPath(VmPtr(fDs, fEdx));
      VmTmpPut(0, Path);
      If AL = $39 Then K := CreateDirectoryA(VmTmp, 0)
      Else K := RemoveDirectoryA(VmTmp);
      If K = 0 Then VmFail(VmErrOf(5));
    End;
    $3B :
    Begin
      Path := VmLfnPath(VmPtr(fDs, fEdx));
      { le DOS garde le chemin court du repertoire courant }
      If Not PathConv(Path, False, R) Or Not VmChDir(R) Then VmFail(3);
    End;
    $41 : VmLfnDelete(VmLfnPath(VmPtr(fDs, fEdx)));
    $43 : VmLfnAttr(VmLfnPath(VmPtr(fDs, fEdx)));
    $47 :
    Begin
      D := VRL(fEdx);
      If D = 0 Then D := VmDrive Else D := D - 1;
      If Not VmDriveOk(D) Then
      Begin
        VmFail(15);
        Exit;
      End;
      Path := VmCurDirOf(D);
      If Not PathConv(Path, True, R) Then R := Path;
      PutPStr(VmPtr(fDs, fEsi), Copy(R, 4, 255), 260);
    End;
    $4E :
    Begin
      Path := VmLfnPath(VmPtr(fDs, fEdx));
      VmTmpPut(0, Path);
      Fd := VmTmp + 512;
      H := FindFirstFileA(VmTmp, Fd);
      If H = INVALID_HANDLE Then
      Begin
        PutPStr(VmTmp + 256, ParentDir(Path), 256);
        If (Length(ParentDir(Path)) = 3) Or
           ((GetFileAttributesA(VmTmp + 256) <> -1) And
            ((GetFileAttributesA(VmTmp + 256) And $10) <> 0)) Then
          VmFail(18)
        Else VmFail(3);
        Exit;
      End;
      K := VmLfNext;
      VmLfNext := (VmLfNext + 1) Mod VmMaxFind;
      If VmLfH[K] <> 0 Then FindClose(VmLfH[K]);
      VmLfH[K] := H;
      VmLfAttr[K] := VR(fEcx);
      VmLfFmt[K] := VR(fEsi) And 1;
      If VmLfStep(K, VmPtr(fEs, fEdi), True) Then
      Begin
        VS(fEax, K + 1);
        VS(fEcx, 0);
      End
      Else
      Begin
        FindClose(H);
        VmLfH[K] := 0;
        VmFail(18);
      End;
    End;
    $4F :
    Begin
      K := VR(fEbx) - 1;
      If (K < 0) Or (K >= VmMaxFind) Or (VmLfH[K] = 0) Then
      Begin
        VmFail(6);
        Exit;
      End;
      VmLfFmt[K] := VR(fEsi) And 1;
      If VmLfStep(K, VmPtr(fEs, fEdi), False) Then VS(fEcx, 0)
      Else VmFail(18);
    End;
    $A1 :
    Begin
      K := VR(fEbx) - 1;
      If (K < 0) Or (K >= VmMaxFind) Or (VmLfH[K] = 0) Then VmFail(6)
      Else
      Begin
        FindClose(VmLfH[K]);
        VmLfH[K] := 0;
      End;
    End;
    $56 :
    Begin
      VmTmpPut(0, VmLfnPath(VmPtr(fDs, fEdx)));
      VmTmpPut(256, VmLfnPath(VmPtr(fEs, fEdi)));
      If MoveFileA(VmTmp, VmTmp + 256) = 0 Then VmFail(VmErrOf(5));
    End;
    $60 :
    Begin
      Path := VmLfnPath(VmPtr(fDs, fEsi));
      Case VRL(fEcx) Of
        0 : R := Path;
        1, 2 :
          If Not PathConv(Path, VRL(fEcx) = 2, R) Then
          Begin
            PutPStr(VmTmp, ParentDir(Path), 256);
            If (Length(ParentDir(Path)) > 3) And
               (GetFileAttributesA(VmTmp) = -1) Then VmFail(3)
            Else VmFail(2);
            Exit;
          End;
      Else
        VmFail(1);
        Exit;
      End;
      PutPStr(VmPtr(fEs, fEdi), R, 261);
    End;
    $6C, $A9 : VmLfnOpen(VmLfnPath(VmPtr(fDs, fEsi)));
    $A0 : VmLfnVolume;
    $A6 : VmLfnInfo;
    $A7 :
      If VRL(fEbx) = 0 Then
      Begin
        T := VmFtDos(VmPtr(fDs, fEsi));
        VS(fEcx, T); VS(fEdx, T Shr 16); VSH(fEbx, 0);
      End
      Else If VRL(fEbx) = 1 Then
        DosDateTimeToFileTime(VR(fEdx), VR(fEcx), VmPtr(fEs, fEdi))
      Else VmFail(1);
    $A8 :
    Begin
      R := VmLfnShort(PStr(VmPtr(fDs, fEsi)), VRH(fEdx) = 0);
      P := VmPtr(fEs, fEdi);
      If VRH(fEdx) = 0 Then
        For K := 1 To 11 Do Mem[0:P + K - 1] := Ord(R[K])
      Else PutPStr(P, R, 13);
    End;
  Else
    VmFail($7100);
  End;
End;

Procedure VmInt21;
Var AH, AL, S, H, N, R, P, D, T, Max : LongInt; Path : String;
Begin
  AH := VRH(fEax); AL := VRL(fEax);
  If VmTrace Then
  Begin
    If AH In [$39..$3D, $41, $43, $4B, $4E, $56, $5A, $5B] Then
      Path := ' "' + Copy(PStr(VmPtr(fDs, fEdx)), 1, 60) + '"'
    Else Path := '';
    KLog('INT 21h ' + VmRegStr + ' de ' +
         HexStr(VmGetW(VR(fSs), VR(fEsp) + 2), 4) + ':' +
         HexStr(VmGetW(VR(fSs), VR(fEsp)), 4) + Path);
  End;
  If Not (AH In [$33, $50, $51, $59, $62, $64]) And Not VmPM Then
    VmDosSave;
  { client DPMI : fonctions propres au mode protege }
  If VmPM And DpDos(AH, AL) Then Exit;
  VmSetCF(False);
  Case AH Of
    $00 : VmTerminate(0, False, 0);
    $01 :
    Begin
      N := VmGetCh;
      VSL(fEax, N);
      If N <> 0 Then VmConOut(N);
    End;
    $02 : VmConOut(VRL(fEdx));
    $03 : VSL(fEax, 0);
    $04, $05 : ;
    $06 :
      If VRL(fEdx) = $FF Then
      Begin
        VmPumpNative;
        If (VmPendScan >= 0) Or VmBufHas Then
        Begin
          VSL(fEax, VmGetCh);
          VmSetZF(False);
        End
        Else
        Begin
          VSL(fEax, 0);
          VmSetZF(True);
          VmIdle;
        End;
      End
      Else VmConOut(VRL(fEdx));
    $07, $08 : VSL(fEax, VmGetCh);
    $09 :
    Begin
      P := VmPtr(fDs, fEdx);
      N := 0;
      While (Mem[0:P + N] <> Ord('$')) And (N < 65535) Do
      Begin
        VmConOut(Mem[0:P + N]);
        Inc(N);
      End;
      VSL(fEax, Ord('$'));
    End;
    $0A :
    Begin
      P := VmPtr(fDs, fEdx);
      Path := VmReadLine(Max(Mem[0:P] - 1, 0));
      Mem[0:P + 1] := Length(Path);
      For N := 1 To Length(Path) Do Mem[0:P + 1 + N] := Ord(Path[N]);
      Mem[0:P + 2 + Length(Path)] := 13;
    End;
    $0B :
    Begin
      VmPumpNative;
      VSL(fEax, $FF * Ord(VmBufHas Or (VmPendScan >= 0)));
      If Not VmBufHas Then VmIdle;
    End;
    $0C :
    Begin
      While VmBufHas Do VmBufPop;
      VmPendScan := -1;
      If AL In [1, 6, 7, 8, $0A] Then
      Begin
        VS(fEax, (AL Shl 8) Or VRL(fEdx));
        VmInt21;
        Exit;
      End;
    End;
    $0D : FatFlush;
    $0E :
    Begin
      If VmDriveOk(VRL(fEdx)) Then
      Begin
        VmDrive := VRL(fEdx);
        CurDirS := Chr(65 + VmDrive) + ':' + VmDir[VmDrive];
        If Length(CurDirS) = 3 Then CurDirS := Copy(CurDirS, 1, 2);
      End;
      VSL(fEax, 26);
    End;
    $0F..$17, $21..$24, $27, $28 : VSL(fEax, $FF);
    $18, $1D, $1E, $20 : VSL(fEax, 0);
    $19 : VSL(fEax, VmDrive);
    $1A :
    Begin
      VmDta := (VR(fDs) Shl 16) Or VR(fEdx);
      VmDtaPM := VmPM;
      VmDtaLin := VmPtr(fDs, fEdx);
    End;
    $1B, $1C :
    Begin
      D := VRL(fEdx);
      If AH = $1B Then D := 0;
      VmDiskFree(D);
      If VR(fEax) <> $FFFF Then
      Begin
        VS(fEdx, VR(fEdx));
        Mem[0:VmLin(VmDosSeg, $1F0)] := $F8;
        VSeg(fDs, VmDosSeg); VS(fEbx, $1F0);
      End
      Else VSL(fEax, $FF);
    End;
    $1F, $32 : VSL(fEax, $FF);
    $25 : MemL[0:VmRam + AL * 4] := (VR(fDs) Shl 16) Or VR(fEdx);
    $26 :
    Begin
      D := VR(fEdx);
      MoveMem(VmLin(VmCurPsp, 0), VmLin(D, 0), 256);
      MemW[0:VmLin(D, 2)] := MemW[0:VmLin(VmCurPsp, 2)];
    End;
    $29 : VmParseFcb;
    $2A :
    Begin
      GetLocalTime(VmTmp);
      VS(fEcx, MemW[0:VmTmp]);
      VS(fEdx, (MemW[0:VmTmp + 2] Shl 8) Or MemW[0:VmTmp + 6]);
      VSL(fEax, MemW[0:VmTmp + 4]);
    End;
    $2B, $2D : VSL(fEax, 0);
    $2C :
    Begin
      GetLocalTime(VmTmp);
      VS(fEcx, (MemW[0:VmTmp + 8] Shl 8) Or MemW[0:VmTmp + 10]);
      VS(fEdx, (MemW[0:VmTmp + 12] Shl 8) Or ((Ticks Div 10) Mod 100));
    End;
    $2E : VmVerify := AL And 1;
    $2F :
    Begin
      VSeg(fEs, VmDta Shr 16);
      VS(fEbx, VmDta);
    End;
    $30 :
    Begin
      VS(fEax, $0007);
      If AL = 1 Then VS(fEbx, $0000) Else VS(fEbx, $FF00);
      VS(fEcx, 0);
    End;
    $31 : VmTerminate(AL, True, VR(fEdx));
    $33 :
      Case AL Of
        0 : VSL(fEdx, VmBreak);
        1 : VmBreak := VRL(fEdx) And 1;
        2 :
        Begin
          N := VmBreak; VmBreak := VRL(fEdx) And 1; VSL(fEdx, N);
        End;
        5 : VSL(fEdx, 3);
        6 :
        Begin
          VS(fEbx, $0007); VS(fEdx, $1000);
        End;
      Else
        VSL(fEax, $FF);
      End;
    $34 :
    Begin
      VSeg(fEs, VmDosSeg);
      VS(fEbx, 0);
    End;
    $35 :
    Begin
      N := MemL[0:VmRam + AL * 4];
      VSeg(fEs, N Shr 16);
      VS(fEbx, N);
    End;
    $36 : VmDiskFree(VRL(fEdx));
    $37 :
      If AL = 0 Then
      Begin
        VSL(fEdx, Ord('/'));
        VSL(fEax, 0);
      End
      Else VSL(fEax, 0);
    $38 : If AL = 0 Then VmCountry Else VmSetCF(False);
    $39, $3A :
    Begin
      VmPathAt(VmPtr(fDs, fEdx), 0);
      If AH = $39 Then N := CreateDirectoryA(VmTmp, 0)
      Else N := RemoveDirectoryA(VmTmp);
      If N = 0 Then VmFail(VmErrOf(5));
    End;
    $3B : If Not VmChDir(PStr(VmPtr(fDs, fEdx))) Then VmFail(3);
    $3C : VmOpenH(VmPathAt(VmPtr(fDs, fEdx), 0), 2, 2);
    $5B : VmOpenH(VmPathAt(VmPtr(fDs, fEdx), 0), 2, 1);
    $3D : VmOpenH(VmPathAt(VmPtr(fDs, fEdx), 0), AL, 3);
    $5A :
    Begin
      P := VmPtr(fDs, fEdx);
      Path := PStr(P);
      If (Path <> '') And Not (Path[Length(Path)] In ['\', ':']) Then
        Path := Path + '\';
      Repeat
        Inc(VmFindCnt);
        S := VmOpen(VmFullPath(Path + 'PD' + HexStr(Ticks + VmFindCnt, 6)),
                    2, 1);
      Until (S >= 0) Or (VmLastErr <> 80);
      If S < 0 Then VmFail(VmLastErr)
      Else
      Begin
        PutPStr(P, Path + 'PD' + HexStr(Ticks + VmFindCnt, 6), 128);
        H := VmHNew(S);
        If H < 0 Then
        Begin
          SftRelease(S);
          VmFail(4);
        End
        Else VS(fEax, H);
      End;
    End;
    $3E :
    Begin
      If VmSftOf(VR(fEbx)) < 0 Then VmFail(6) Else VmHClose(VR(fEbx));
    End;
    $3F :
    Begin
      S := VmSftOf(VR(fEbx));
      If S < 0 Then VmFail(6)
      Else If SftDev[S] = 1 Then VS(fEax, VmConRead(VmPtr(fDs, fEdx),
                                                     VR(fEcx)))
      Else If SftDev[S] = 2 Then VS(fEax, 0)
      Else If KReadFile(SftH[S], VmPtr(fDs, fEdx), VR(fEcx), N) Then
        VS(fEax, N)
      Else VmFail(5);
    End;
    $40 :
    Begin
      S := VmSftOf(VR(fEbx));
      N := VR(fEcx);
      If S < 0 Then VmFail(6)
      Else If SftDev[S] = 1 Then
      Begin
        P := VmPtr(fDs, fEdx);
        For R := 0 To N - 1 Do VmConOut(Mem[0:P + R]);
        VS(fEax, N);
      End
      Else If SftDev[S] = 2 Then VS(fEax, N)
      Else If (SftMode[S] And 3) = 0 Then VmFail(5)
      Else If N = 0 Then
      Begin
        SetEndOfFile(SftH[S]);
        VS(fEax, 0);
      End
      Else
      Begin
        R := KWriteFile(SftH[S], VmPtr(fDs, fEdx), N);
        If R < 0 Then VmFail(5) Else VS(fEax, R);
      End;
    End;
    $41 :
    Begin
      VmPathAt(VmPtr(fDs, fEdx), 0);
      If DeleteFileA(VmTmp) = 0 Then VmFail(VmErrOf(2));
    End;
    $42 :
    Begin
      S := VmSftOf(VR(fEbx));
      If S < 0 Then VmFail(6)
      Else If SftDev[S] <> 0 Then VS(fEax, 0)
      Else If AL > 2 Then VmFail(1)
      Else
      Begin
        R := SetFilePointer(SftH[S], (VR(fEcx) Shl 16) Or VR(fEdx), 0, AL);
        If R = -1 Then VmFail(25)
        Else
        Begin
          VS(fEax, R);
          VS(fEdx, R Shr 16);
        End;
      End;
    End;
    $43 :
    Begin
      VmPathAt(VmPtr(fDs, fEdx), 0);
      If AL = 0 Then
      Begin
        R := GetFileAttributesA(VmTmp);
        If R = -1 Then VmFail(VmErrOf(2))
        Else
        Begin
          If R = $80 Then R := 0;
          VS(fEcx, R And $3F);
          VS(fEax, R And $3F);
        End;
      End
      Else If AL = 1 Then
      Begin
        If GetFileAttributesA(VmTmp) = -1 Then VmFail(2)
        Else SetFileAttributesA(VmTmp, VR(fEcx));
      End
      Else VmFail(1);
    End;
    $44 : VmIoctl;
    $45 :
    Begin
      S := VmSftOf(VR(fEbx));
      If S < 0 Then VmFail(6)
      Else
      Begin
        H := VmHNew(S);
        If H < 0 Then VmFail(4)
        Else
        Begin
          Inc(SftRef[S]);
          VS(fEax, H);
        End;
      End;
    End;
    $46 :
    Begin
      S := VmSftOf(VR(fEbx));
      If (S < 0) Or (VmJft(VR(fEcx)) = 0) Then VmFail(6)
      Else
      Begin
        VmHClose(VR(fEcx));
        Mem[0:VmJft(VR(fEcx))] := S;
        Inc(SftRef[S]);
      End;
    End;
    $47 :
    Begin
      D := VRL(fEdx);
      If D = 0 Then D := VmDrive Else D := D - 1;
      If Not VmDriveOk(D) Then VmFail(15)
      Else
      Begin
        PutPStr(VmPtr(fDs, fEsi), Copy(VmDir[D], 2, 66), 64);
        VS(fEax, $0100);
      End;
    End;
    $48 :
    Begin
      N := McbAlloc(VR(fEbx), VmCurPsp, Max);
      If N = 0 Then
      Begin
        VmFail(8);
        VS(fEbx, Max);
      End
      Else VS(fEax, N);
    End;
    $49 : If McbValid(VR(fEs)) Then McbFree(VR(fEs)) Else VmFail(9);
    $4A :
      If Not McbValid(VR(fEs)) Then VmFail(9)
      Else If Not McbResize(VR(fEs), VR(fEbx), Max) Then
      Begin
        VmFail(8);
        VS(fEbx, Max);
      End
      Else If VR(fEs) = VmCurPsp Then
        MemW[0:VmLin(VmCurPsp, 2)] := VmCurPsp + VR(fEbx);
    $4B : VmExec;
    $4C : VmTerminate(AL, False, 0);
    $4D :
    Begin
      VS(fEax, VmRetCode);
      VmRetCode := 0;
    End;
    $4E, $4F :
    Begin
      If VmDtaPM Then P := VmDtaLin Else P := VmLin(VmDta Shr 16, VmDta);
      VmFindStep(P, AH = $4E);
    End;
    $50 : VmCurPsp := VR(fEbx);
    $51, $62 : VS(fEbx, VmCurPsp);
    $52 :
    Begin
      VSeg(fEs, VmDosSeg);
      VS(fEbx, VmLolO);
    End;
    $54 : VSL(fEax, VmVerify);
    $55 :
    Begin
      D := VR(fEdx);
      VmMakePsp(D, VR(fEsi) - D, MemW[0:VmLin(VmCurPsp, $2C)], VmCurPsp,
                '');
      MoveMem(VmLin(VmCurPsp, $80), VmLin(D, $80), 128);
      VmCurPsp := D;
    End;
    $56 :
    Begin
      VmPathAt(VmPtr(fDs, fEdx), 0);
      VmPathAt(VmPtr(fEs, fEdi), 256);
      If MoveFileA(VmTmp, VmTmp + 256) = 0 Then VmFail(VmErrOf(5));
    End;
    $57 :
    Begin
      S := VmSftOf(VR(fEbx));
      If (S < 0) Or (SftDev[S] <> 0) Then
      Begin
        If S < 0 Then VmFail(6);
      End
      Else If AL = 0 Then
      Begin
        D := 0; T := 0;
        If GetFileTime(SftH[S], 0, 0, VmTmp) <> 0 Then
          FileTimeToDosDateTime(VmTmp, LongInt(@D), LongInt(@T));
        VS(fEcx, T); VS(fEdx, D);
      End
      Else If AL = 1 Then
      Begin
        DosDateTimeToFileTime(VR(fEdx), VR(fEcx), VmTmp);
        SetFileTime(SftH[S], 0, 0, VmTmp);
      End
      Else VmFail(1);
    End;
    $58 :
      Case AL Of
        0 : VS(fEax, VmStrat);
        1 : VmStrat := VR(fEbx);
        2 : VSL(fEax, 0);
        3 : ;
      Else
        VmFail(1);
      End;
    $59 :
    Begin
      VS(fEax, VmLastErr);
      VS(fEbx, $0D01);
      VSH(fEcx, 1);
    End;
    $5C : ;
    $60 :
    Begin
      Path := VmFullPath(PStr(VmPtr(fDs, fEsi)));
      PutPStr(VmPtr(fEs, fEdi), Path, 128);
    End;
    $63 :
    Begin
      VSeg(fDs, VmDosSeg);
      VS(fEsi, VmDbcsO);
      VSL(fEax, 0);
    End;
    $65 : VmCountryX;
    $66 :
    Begin
      VS(fEbx, 437);
      VS(fEdx, 437);
    End;
    $67 :
    Begin
      N := VR(fEbx);
      P := VmLin(VmCurPsp, 0);
      If N <= MemW[0:P + $32] Then
      Begin
        If N < 20 Then N := 20;
      End
      Else
      Begin
        D := McbAlloc((N + 15) Shr 4, VmCurPsp, Max);
        If D = 0 Then VmFail(8)
        Else
        Begin
          FillMem(VmLin(D, 0), N, $FF);
          MoveMem(VmLin(MemW[0:P + $36], MemW[0:P + $34]), VmLin(D, 0),
                  MemW[0:P + $32]);
          MemW[0:P + $32] := N;
          MemW[0:P + $34] := 0; MemW[0:P + $36] := D;
        End;
      End;
    End;
    $68, $6A :
    Begin
      S := VmSftOf(VR(fEbx));
      If S < 0 Then VmFail(6)
      Else If SftDev[S] = 0 Then FlushFileBuffers(SftH[S]);
    End;
    $69 :
      If AL = 0 Then
      Begin
        P := VmPtr(fDs, fEdx);
        MemW[0:P] := 0; MemL[0:P + 2] := $1995095;
        PutPStr(VmTmp + 800, 'NO NAME    FAT16   ', 20);
        MoveMem(VmTmp + 800, P + 6, 19);
      End;
    $6C :
    Begin
      Path := VmPathAt(VmPtr(fDs, fEsi), 0);
      D := VR(fEdx);
      If GetFileAttributesA(VmTmp) <> -1 Then
      Begin
        Case D And 3 Of
          1 :
          Begin
            N := 3; R := 1;
          End;
          2 :
          Begin
            N := 2; R := 3;
          End;
        Else
          N := 0;
        End;
      End
      Else If (D And $10) <> 0 Then
      Begin
        N := 1; R := 2;
      End
      Else N := -1;
      If N = 0 Then VmFail(80)
      Else If N < 0 Then VmFail(2)
      Else
      Begin
        VmOpenH(Path, VRL(fEbx), N);
        If (MemL[0:VmF + fFl] And 1) = 0 Then VS(fEcx, R);
      End;
    End;
    $71 : VmLfn(AL);
    $73 : VmFail($7300);
  Else
    VmFail(1);
  End;
End;

{ ------------------------------------------------------------------ }
{ Souris (INT 33h) : pointeur texte dans la console                  }
{ ------------------------------------------------------------------ }

Procedure VmMouReset;
Var I : LongInt;
Begin
  VmMouShow := -1;
  VmMouMinX := 0; VmMouMaxX := 639; VmMouMinY := 0; VmMouMaxY := 199;
  { plage verticale du mode video (ecran graphique de 350 ou 480 lignes) }
  If VmGfx And (VgH > 200) Then VmMouMaxY := VgH - 1;
  VmMouX := 320; VmMouY := (VmMouMaxY + 1) Div 2;
  VmMouMask := 0; VmMouSeg := 0; VmMouOfs := 0; VmMouEv := 0;
  VmMouMkX := 0; VmMouMkY := 0;
  For I := 0 To 2 Do
  Begin
    VmMouPress[I] := 0; VmMouRel[I] := 0;
  End;
End;

Procedure VmMouClip;
Begin
  If VmMouX < VmMouMinX Then VmMouX := VmMouMinX;
  If VmMouX > VmMouMaxX Then VmMouX := VmMouMaxX;
  If VmMouY < VmMouMinY Then VmMouY := VmMouMinY;
  If VmMouY > VmMouMaxY Then VmMouY := VmMouMaxY;
End;

{ Evenement de la souris dans la console (tache 0) : X, Y relatifs a
  la zone client }
Procedure DosMouseAt(Msg, NX, NY : LongInt);
Var B, Ev, I : LongInt;
Begin
  Ev := 0;
  If (NX <> VmMouX) Or (NY <> VmMouY) Then
  Begin
    VmMouMkX := VmMouMkX + (NX - VmMouX);
    VmMouMkY := VmMouMkY + (NY - VmMouY) * 2;
    VmMouX := NX; VmMouY := NY;
    VmMouClip;
    Ev := 1;
  End;
  B := VmMouBtn;
  Case Msg Of
    WM_LBUTTONDOWN, WM_LBUTTONDBLCLK :
    Begin
      B := B Or 1; Ev := Ev Or 2; I := 0;
    End;
    WM_LBUTTONUP :
    Begin
      B := B And Not 1; Ev := Ev Or 4; I := 0;
    End;
    WM_RBUTTONDOWN :
    Begin
      B := B Or 2; Ev := Ev Or 8; I := 1;
    End;
    WM_RBUTTONUP :
    Begin
      B := B And Not 2; Ev := Ev Or $10; I := 1;
    End;
  Else
    I := -1;
  End;
  If I >= 0 Then
  Begin
    If (Ev And $0A) <> 0 Then
    Begin
      Inc(VmMouPress[I]);
      VmMouPX[I] := VmMouX; VmMouPY[I] := VmMouY;
    End
    Else
    Begin
      Inc(VmMouRel[I]);
      VmMouRX[I] := VmMouX; VmMouRY[I] := VmMouY;
    End;
  End;
  VmMouBtn := B;
  VmMouEv := VmMouEv Or Ev;
End;

Procedure DosMouseIn(Msg, X, Y : LongInt);
Begin
  If Not VmOn Then Exit;
  DosMouseAt(Msg, Max(0, Min(79, X Div ConCW)) * 8,
             Max(0, Min(24, Y Div ConChH)) * 8);
End;

{ Ecran graphique plein ecran : coordonnees du pointeur de Pasdows dans
  la surface (640 de large ; 200 lignes doublees) }
Procedure DosMouseScr(Msg : LongInt);
Var X, Y : LongInt;
Begin
  X := CurX - ((ScrW - Min(DDW, ScrW)) Div 2 And Not 7);
  Y := CurY - (ScrH - Min(DDH, ScrH)) Div 2;
  If VgH <= 200 Then Y := Y Div 2;
  DosMouseAt(Msg, Max(0, Min(639, X)), Max(0, Min(VgH - 1, Y)));
End;

{ Appeler le gestionnaire d'evenements du programme (fonction 0Ch) }
Function VmMouCall : Boolean;
Var Ev : LongInt;
Begin
  VmMouCall := False;
  Ev := VmMouEv And VmMouMask;
  If (Ev = 0) Or (VmMouBusy <> 0) Or ((VmMouSeg = 0) And (VmMouOfs = 0))
  Then
  Begin
    If VmMouBusy = 0 Then VmMouEv := 0;
    Exit;
  End;
  VmMouEv := 0;
  MoveMem(VmF, LongInt(@VmMouSave), 68);
  VmMouBusy := 1 + Ord(VmIF);
  VS(fEax, Ev); VS(fEbx, VmMouBtn); VS(fEcx, VmMouX); VS(fEdx, VmMouY);
  VS(fEsi, VmMouMkX); VS(fEdi, VmMouMkY);
  VmPush(VmBios); VmPush(VmMRetO);
  VmGoto(VmMouSeg, VmMouOfs);
  VmIF := False;
  VmMouCall := True;
End;

Procedure VmInt33;
Var AX, B : LongInt;
Begin
  AX := VR(fEax);
  Case AX Of
    $00, $21 :
    Begin
      VmMouReset;
      VS(fEax, $FFFF);
      VS(fEbx, 2);
    End;
    $01 : If VmMouShow < 0 Then Inc(VmMouShow);
    $02 : Dec(VmMouShow);
    $03 :
    Begin
      VS(fEbx, VmMouBtn); VS(fEcx, VmMouX); VS(fEdx, VmMouY);
      VmIdle;
    End;
    $04 :
    Begin
      VmMouX := VR(fEcx) And Not 7; VmMouY := VR(fEdx) And Not 7;
      VmMouClip;
    End;
    $05, $06 :
    Begin
      B := VR(fEbx);
      If B > 2 Then B := 0;
      VS(fEax, VmMouBtn);
      If AX = 5 Then
      Begin
        VS(fEbx, VmMouPress[B]); VS(fEcx, VmMouPX[B]);
        VS(fEdx, VmMouPY[B]);
        VmMouPress[B] := 0;
      End
      Else
      Begin
        VS(fEbx, VmMouRel[B]); VS(fEcx, VmMouRX[B]);
        VS(fEdx, VmMouRY[B]);
        VmMouRel[B] := 0;
      End;
    End;
    $07 :
    Begin
      VmMouMinX := Min(VR(fEcx), VR(fEdx));
      VmMouMaxX := Max(VR(fEcx), VR(fEdx));
      VmMouClip;
    End;
    $08 :
    Begin
      VmMouMinY := Min(VR(fEcx), VR(fEdx));
      VmMouMaxY := Max(VR(fEcx), VR(fEdx));
      VmMouClip;
    End;
    $0B :
    Begin
      VS(fEcx, VmMouMkX); VS(fEdx, VmMouMkY);
      VmMouMkX := 0; VmMouMkY := 0;
    End;
    $0C :
    Begin
      VmMouMask := VR(fEcx); VmMouSeg := VR(fEs); VmMouOfs := VR(fEdx);
    End;
    $14 :
    Begin
      B := VmMouMask; VmMouMask := VR(fEcx); VS(fEcx, B);
      B := VmMouSeg; VmMouSeg := VR(fEs); VSeg(fEs, B);
      B := VmMouOfs; VmMouOfs := VR(fEdx); VS(fEdx, B);
    End;
    $15 : VS(fEbx, 16);
    $1B :
    Begin
      VS(fEbx, 50); VS(fEcx, 50); VS(fEdx, 50);
    End;
    $1D, $1E : VS(fEbx, 0);
    $24 :
    Begin
      VS(fEbx, $0626); VS(fEcx, $0400);
    End;
    $26 :
    Begin
      VS(fEbx, 0); VS(fEcx, 639); VS(fEdx, 199);
    End;
  End;
End;

{ ------------------------------------------------------------------ }
{ Multiplexage (INT 2Fh) et ports d'E/S                              }
{ ------------------------------------------------------------------ }

Procedure VmInt2F;
Var AX : LongInt;
Begin
  AX := VR(fEax);
  Case AX Of
    $1600 : VSL(fEax, 0);
    $1680 :
    Begin
      VSL(fEax, 0);
      KSleep(1);
    End;
    $1689 : KSleep(1);
    $4300 : VSL(fEax, $80);
    $4310 :
    Begin
      VSeg(fEs, VmBios); VS(fEbx, VmXmsO);
    End;
    $1687 :
    Begin
      { serveur DPMI : 32 bits, processeur 486, version 0.90 }
      VS(fEax, 0); VS(fEbx, 1); VSL(fEcx, 4); VS(fEdx, $005A);
      VS(fEsi, $100); VSeg(fEs, VmBios); VS(fEdi, VmDpmiO);
    End;
    $4A01, $4A02 :
    Begin
      VS(fEbx, 0);
      VSeg(fEs, $FFFF); VS(fEdi, $FFFF);
    End;
    $1A00, $B700, $1100, $0800, $AD00, $1000 : VSL(fEax, 0);
  End;
End;

Function VmIn(Port : LongInt) : LongInt;
Var V : LongInt;
Begin
  V := $FF;
  Case Port Of
    $20 : V := 0;
    $21 : V := VmPicMask;
    $A0, $A1 : V := 0;
    $40 :
    Begin
      If VmPitMode = 0 Then
      Begin
        VmPitLatch := (VmPitDiv - ((Ticks * 1193 + VmPitAcc) Mod VmPitDiv))
                      And $FFFF;
        VmPitMode := 1;
        V := VmPitLatch And $FF;
      End
      Else
      Begin
        V := (VmPitLatch Shr 8) And $FF;
        VmPitMode := 0;
      End;
    End;
    $60 : V := VmPort60;
    $61 :
    Begin
      VmPort61 := VmPort61 Xor $10;
      V := VmPort61;
    End;
    $64 : V := $1C;
    $3C1 : V := VgAc[VgAcI And 31];
    $3C4 : V := VgSeqI;
    $3C5 : V := VgSeq[VgSeqI And 7];
    $3CE : V := VgGcI;
    $3CF : If VgGcI <= 8 Then V := VgGc[VgGcI];
    $3C9 :
    Begin
      V := VmDac[VmDacRd Mod 768];
      VmDacRd := (VmDacRd + 1) Mod 768;
    End;
    $3CC : V := $67;
    $3D5 :
      Case VmCrtIdx Of
        $0A : V := Mem[0:VmBda($61)];
        $0B : V := Mem[0:VmBda($60)];
        $0E, $0F :
        Begin
          V := Mem[0:VmBda($51)] * 80 + Mem[0:VmBda($50)];
          If VmCrtIdx = $0E Then V := V Shr 8 Else V := V And $FF;
        End;
      Else
        V := 0;
      End;
    $3D4 : V := VmCrtIdx;
    $3DA, $3BA :
    Begin
      VmRetr := VmRetr Xor 9;
      VmAttrFF := 0;
      V := VmRetr;
    End;
  End;
  VmIn := V;
End;

Procedure VmOut(Port, V : LongInt);
Var P : LongInt;
Begin
  V := V And $FF;
  If VmTrace And ((Port = $3C5) Or (Port = $3D5) Or (Port = $3CF) Or
     (Port = $3C2) Or (Port = $20) Or (Port = $43) Or (Port = $40)) Then
    KLog('OUT ' + HexStr(Port, 3) + ' [' + HexStr(VgSeqI * Ord(Port = $3C5) +
         VmCrtIdx * Ord(Port = $3D5) + VgGcI * Ord(Port = $3CF), 2) +
         '] = ' + HexStr(V, 2));
  Case Port Of
    $20 :
      If V = $20 Then
      Begin
        If (VmIsr And 1) <> 0 Then VmIsr := VmIsr And Not 1
        Else VmIsr := VmIsr And Not 2;
      End
      Else If (V And $F8) = $60 Then VmIsr := VmIsr And Not (1 Shl (V And 7));
    $21 : VmPicMask := V;
    $43 :
      If (V And $C0) = 0 Then
      Begin
        If (V And $30) = 0 Then VmPitMode := 0
        Else VmPitMode := 2;
      End;
    $40 :
      If VmPitMode = 2 Then
      Begin
        VmPitLo := V;
        VmPitMode := 3;
      End
      Else If VmPitMode = 3 Then
      Begin
        VmPitDiv := VmPitLo Or (V Shl 8);
        If VmPitDiv = 0 Then VmPitDiv := 65536;
        If VmPitDiv < 1193 Then VmPitDiv := 1193;
        VmPitMode := 0;
      End;
    $61 : VmPort61 := V;
    $3D4 : VmCrtIdx := V;
    $3D5 :
      Case VmCrtIdx Of
        $0A : Mem[0:VmBda($61)] := V;
        $0B : Mem[0:VmBda($60)] := V;
        $0E, $0F :
        Begin
          P := Mem[0:VmBda($51)] * 80 + Mem[0:VmBda($50)];
          If VmCrtIdx = $0E Then P := (P And $FF) Or (V Shl 8)
          Else P := (P And $FF00) Or V;
          If P < 2000 Then VmSetCur(0, P Mod 80, P Div 80);
        End;
        $0C, $0D :
        Begin
          If VmCrtIdx = $0C Then VgStart := (VgStart And $FF) Or (V Shl 8)
          Else VgStart := (VgStart And $FF00) Or V;
          VgDLo := 0; VgDHi := VgH - 1;
        End;
      End;
    $3C7 :
    Begin
      VmDacRd := V * 3;
    End;
    $3C8 :
    Begin
      VmDacIdx := V * 3;
    End;
    $3C9 :
    Begin
      VmDac[VmDacIdx Mod 768] := V And $3F;
      VmDacIdx := (VmDacIdx + 1) Mod 768;
      VgPalDirty := True;
    End;
    $3C0 :
    Begin
      If VmAttrFF = 0 Then VgAcI := V And $1F
      Else If VgAcI <= 20 Then
      Begin
        VgAc[VgAcI] := V;
        VgPalDirty := True;
      End;
      VmAttrFF := VmAttrFF Xor 1;
    End;
    $3C4 : VgSeqI := V;
    $3C5 : VgSeq[VgSeqI And 7] := V;
    $3CE : VgGcI := V;
    $3CF : If VgGcI <= 8 Then VgGc[VgGcI] := V;
  End;
End;

{ ------------------------------------------------------------------ }
{ Moniteur : fautes du mode V86                                      }
{ ------------------------------------------------------------------ }

Procedure VmCrash(Const Why : String);
Var S, B : String; I : LongInt;
Begin
  S := HexStr(VR(fCs), 4) + ':' + HexStr(VR(fEip), 4);
  KLog('DOS : ' + Why + ' en ' + S);
  B := '';
  For I := -8 To 7 Do
    B := B + HexStr(Mem[0:VmLin(VR(fCs), VR(fEip) + I)], 2) + ' ';
  KLog('  ' + VmRegStr);
  KLog('  code ' + B);
  VmConStr(#13#10 + 'Pasdows : ' + Why + ' en ' + S + #13#10);
  VmTerminate(255, False, 0);
End;

Function VmCode(Cs, Ip : LongInt) : LongInt;
Begin
  VmCode := Mem[0:VmLin(Cs, Ip)];
End;

{ ------------------------------------------------------------------ }
{ Emulation des instructions qui accedent a la memoire video a plans }
{ ------------------------------------------------------------------ }
{ Defaut de page en A0000h-AFFFFh : l'instruction est decodee (prefixes,
  ModRM 16 et 32 bits) et executee ici, ses acces a la memoire video
  passant par VgRead et VgWrite : MOV, XCHG, operations arithmetiques
  et logiques (indicateurs calcules), TEST, NOT, NEG, INC, DEC,
  decalages et rotations, instructions de chaines (MOVS, STOS, LODS,
  CMPS, SCAS, avec REP). }

Var
  XSz : LongInt;                 { taille de l'operande (1, 2, 4) }

Function XRd8(Lin : LongInt) : LongInt;
Begin
  Lin := Lin And $FFFFF;
  If VgPlanar And (Lin >= $A0000) And (Lin < $B0000) Then
    XRd8 := VgRead(Lin - $A0000)
  Else XRd8 := Mem[0:VmRam + Lin];
End;

Procedure XWr8(Lin, V : LongInt);
Begin
  Lin := Lin And $FFFFF;
  If VgPlanar And (Lin >= $A0000) And (Lin < $B0000) Then
    VgWrite(Lin - $A0000, V)
  Else Mem[0:VmRam + Lin] := V;
End;

Function XRd(Lin, Sz : LongInt) : LongInt;
Var K, R : LongInt;
Begin
  R := 0;
  For K := 0 To Sz - 1 Do R := R Or (XRd8(Lin + K) Shl (K * 8));
  XRd := R;
End;

Procedure XWr(Lin, V, Sz : LongInt);
Var K : LongInt;
Begin
  For K := 0 To Sz - 1 Do XWr8(Lin + K, V Shr (K * 8));
End;

Function XMask(Sz : LongInt) : LongInt;
Begin
  If Sz = 1 Then XMask := $FF
  Else If Sz = 2 Then XMask := $FFFF
  Else XMask := -1;
End;

{ Registre general I (0 AX/AL ... 7 DI/BH) de taille Sz }
Function XGetR(I, Sz : LongInt) : LongInt;
Const Ofs : Array[0..7] Of LongInt = (fEax, fEcx, fEdx, fEbx, fEsp, fEbp,
                                      fEsi, fEdi);
Begin
  If Sz = 1 Then
  Begin
    If I < 4 Then XGetR := Mem[0:VmF + Ofs[I]]
    Else XGetR := Mem[0:VmF + Ofs[I - 4] + 1];
  End
  Else XGetR := MemL[0:VmF + Ofs[I]] And XMask(Sz);
End;

Procedure XSetR(I, Sz, V : LongInt);
Const Ofs : Array[0..7] Of LongInt = (fEax, fEcx, fEdx, fEbx, fEsp, fEbp,
                                      fEsi, fEdi);
Begin
  If Sz = 1 Then
  Begin
    If I < 4 Then Mem[0:VmF + Ofs[I]] := V
    Else Mem[0:VmF + Ofs[I - 4] + 1] := V;
  End
  Else If Sz = 2 Then VS(Ofs[I], V)
  Else MemL[0:VmF + Ofs[I]] := V;
End;

Function XParity(V : LongInt) : Boolean;
Var K, N : LongInt;
Begin
  N := 0;
  For K := 0 To 7 Do If ((V Shr K) And 1) <> 0 Then Inc(N);
  XParity := (N And 1) = 0;
End;

{ CF, PF, AF, ZF, SF, OF du resultat R }
Procedure XSetFl(R, Sz : LongInt; Cf, Ovf, Af : Boolean);
Var F : LongInt;
Begin
  R := R And XMask(Sz);
  F := MemL[0:VmF + fFl] And Not $8D5;
  If Cf Then F := F Or 1;
  If XParity(R) Then F := F Or 4;
  If Af Then F := F Or $10;
  If R = 0 Then F := F Or $40;
  If ((R Shr (Sz * 8 - 1)) And 1) <> 0 Then F := F Or $80;
  If Ovf Then F := F Or $800;
  MemL[0:VmF + fFl] := F;
End;

Function XCf : LongInt;
Begin
  XCf := MemL[0:VmF + fFl] And 1;
End;

{ a < b en non signe (32 bits) }
Function XULess(A, B : LongInt) : Boolean;
Begin
  XULess := (A Xor LongInt($80000000)) < (B Xor LongInt($80000000));
End;

{ ADD OR ADC SBB AND SUB XOR CMP }
Function XAlu(Op, A, B, Sz : LongInt) : LongInt;
Var R, M, S, C : LongInt; Cf, Ovf : Boolean;
Begin
  M := XMask(Sz);
  S := 1 Shl (Sz * 8 - 1);
  A := A And M; B := B And M;
  C := 0;
  Case Op Of
    0, 2 :
    Begin
      If Op = 2 Then C := XCf;
      R := (A + B + C) And M;
      If Sz = 4 Then Cf := XULess(R, A) Or ((C = 1) And (R = A))
      Else Cf := A + B + C > M;
      Ovf := ((A Xor R) And (B Xor R) And S) <> 0;
      XSetFl(R, Sz, Cf, Ovf, ((A Xor B Xor R) And $10) <> 0);
    End;
    3, 5, 7 :
    Begin
      If Op = 3 Then C := XCf;
      R := (A - B - C) And M;
      If Sz = 4 Then Cf := XULess(A, B) Or ((C = 1) And (A = B))
      Else Cf := A < B + C;
      Ovf := ((A Xor B) And (A Xor R) And S) <> 0;
      XSetFl(R, Sz, Cf, Ovf, ((A Xor B Xor R) And $10) <> 0);
    End;
  Else
    Case Op Of
      1 : R := A Or B;
      4 : R := A And B;
    Else
      R := A Xor B;
    End;
    XSetFl(R, Sz, False, False, False);
  End;
  XAlu := R And M;
End;

{ Decalages et rotations (C0, C1, D0-D3) }
Function XShift(Op, V, Cnt, Sz : LongInt) : LongInt;
Var M, Bits, K, B, F : LongInt; Cf : Boolean;
Begin
  M := XMask(Sz);
  Bits := Sz * 8;
  V := V And M;
  Cnt := Cnt And 31;
  If Cnt = 0 Then
  Begin
    XShift := V;
    Exit;
  End;
  Cf := XCf <> 0;
  For K := 1 To Cnt Do
  Begin
    B := (V Shr (Bits - 1)) And 1;
    Case Op Of
      0 :
      Begin
        V := ((V Shl 1) Or B) And M; Cf := B <> 0;
      End;
      1 :
      Begin
        Cf := (V And 1) <> 0;
        V := ((V Shr 1) And (M Shr 1)) Or (Ord(Cf) Shl (Bits - 1));
      End;
      2 :
      Begin
        V := ((V Shl 1) Or Ord(Cf)) And M; Cf := B <> 0;
      End;
      3 :
      Begin
        F := Ord(Cf);
        Cf := (V And 1) <> 0;
        V := ((V Shr 1) And (M Shr 1)) Or (F Shl (Bits - 1));
      End;
      4, 6 :
      Begin
        Cf := B <> 0; V := (V Shl 1) And M;
      End;
      5 :
      Begin
        Cf := (V And 1) <> 0; V := (V Shr 1) And (M Shr 1);
      End;
    Else
      Cf := (V And 1) <> 0;
      V := ((V Shr 1) And (M Shr 1)) Or (B Shl (Bits - 1));
    End;
  End;
  If Op < 4 Then
  Begin
    F := MemL[0:VmF + fFl] And Not $801;
    If Cf Then F := F Or 1;
    If ((V Shr (Bits - 1)) And 1) <> Ord(Cf) Then F := F Or $800;
    MemL[0:VmF + fFl] := F;
  End
  Else XSetFl(V, Sz, Cf, ((V Shr (Bits - 1)) And 1) <> Ord(Cf), False);
  XShift := V;
End;

Function XImm(Cs, Ip : LongInt; Var N : LongInt; Sz : LongInt) : LongInt;
Var V, K : LongInt;
Begin
  V := 0;
  For K := 0 To Sz - 1 Do V := V Or (VmCode(Cs, Ip + N + K) Shl (K * 8));
  N := N + Sz;
  XImm := V;
End;

{ Operande memoire du ModRM : adresse lineaire de la machine, ou -1 pour
  un registre (Rm). N avance sur le ModRM et le deplacement. }
Function XModRM(Cs, Ip : LongInt; Var N, Rg, Rm : LongInt;
                SegO : LongInt; A32 : Boolean) : LongInt;
Var B, Md, Ea, D, Sg, Sib, Bs, Ix : LongInt;
Begin
  B := VmCode(Cs, Ip + N); Inc(N);
  Md := B Shr 6; Rg := (B Shr 3) And 7; Rm := B And 7;
  If Md = 3 Then
  Begin
    XModRM := -1;
    Exit;
  End;
  Sg := fDs;
  If Not A32 Then
  Begin
    Case Rm Of
      0 : Ea := VR(fEbx) + VR(fEsi);
      1 : Ea := VR(fEbx) + VR(fEdi);
      2 :
      Begin
        Ea := VR(fEbp) + VR(fEsi); Sg := fSs;
      End;
      3 :
      Begin
        Ea := VR(fEbp) + VR(fEdi); Sg := fSs;
      End;
      4 : Ea := VR(fEsi);
      5 : Ea := VR(fEdi);
      6 :
        If Md = 0 Then
        Begin
          Ea := VmCode(Cs, Ip + N) Or (VmCode(Cs, Ip + N + 1) Shl 8);
          N := N + 2;
        End
        Else
        Begin
          Ea := VR(fEbp); Sg := fSs;
        End;
    Else
      Ea := VR(fEbx);
    End;
    If Md = 1 Then
    Begin
      D := VmCode(Cs, Ip + N); Inc(N);
      If D >= $80 Then D := D - 256;
      Ea := Ea + D;
    End
    Else If Md = 2 Then
    Begin
      Ea := Ea + (VmCode(Cs, Ip + N) Or (VmCode(Cs, Ip + N + 1) Shl 8));
      N := N + 2;
    End;
    Ea := Ea And $FFFF;
  End
  Else
  Begin
    { adressage 32 bits (prefixe 67h) }
    If Rm = 4 Then
    Begin
      Sib := VmCode(Cs, Ip + N); Inc(N);
      Bs := Sib And 7; Ix := (Sib Shr 3) And 7;
      If (Bs = 5) And (Md = 0) Then
      Begin
        Ea := XImm(Cs, Ip, N, 4);
      End
      Else
      Begin
        Ea := XGetR(Bs, 4);
        If (Bs = 4) Or (Bs = 5) Then Sg := fSs;
      End;
      If Ix <> 4 Then Ea := Ea + (XGetR(Ix, 4) Shl (Sib Shr 6));
    End
    Else If (Rm = 5) And (Md = 0) Then
    Begin
      Ea := XImm(Cs, Ip, N, 4);
    End
    Else
    Begin
      Ea := XGetR(Rm, 4);
      If Rm = 5 Then Sg := fSs;
    End;
    If Md = 1 Then
    Begin
      D := VmCode(Cs, Ip + N); Inc(N);
      If D >= $80 Then D := D - 256;
      Ea := Ea + D;
    End
    Else If Md = 2 Then
    Begin
      Ea := Ea + XImm(Cs, Ip, N, 4);
    End;
  End;
  If SegO >= 0 Then Sg := SegO;
  XModRM := ((VR(Sg) Shl 4) + Ea) And $FFFFF;
End;

{ Instruction de chaine : MOVS, STOS, LODS, CMPS, SCAS }
Procedure XString(Op, Sz, SegO, Rep : LongInt; A32 : Boolean);
Var Cnt, Si, Di, SB, D, V, W, M, Cx : LongInt; Go : Boolean;
Begin
  If A32 Then M := -1 Else M := $FFFF;
  If (MemL[0:VmF + fFl] And $400) <> 0 Then D := -Sz Else D := Sz;
  If SegO < 0 Then SegO := fDs;
  Cx := fEcx;
  If Rep <> 0 Then Cnt := MemL[0:VmF + Cx] And M Else Cnt := 1;
  Si := MemL[0:VmF + fEsi] And M;
  Di := MemL[0:VmF + fEdi] And M;
  SB := VR(SegO) Shl 4;
  Go := True;
  While Go And (Cnt <> 0) Do
  Begin
    Case Op Of
      $A4, $A5 : XWr((VR(fEs) Shl 4) + Di, XRd(SB + Si, Sz), Sz);
      $AA, $AB : XWr((VR(fEs) Shl 4) + Di, MemL[0:VmF + fEax], Sz);
      $AC, $AD : XSetR(0, Sz, XRd(SB + Si, Sz));
      $A6, $A7 :
      Begin
        V := XRd(SB + Si, Sz); W := XRd((VR(fEs) Shl 4) + Di, Sz);
        XAlu(7, V, W, Sz);
      End;
      $AE, $AF :
      Begin
        W := XRd((VR(fEs) Shl 4) + Di, Sz);
        XAlu(7, XGetR(0, Sz), W, Sz);
      End;
    End;
    If Op In [$A4, $A5, $AC, $AD, $A6, $A7] Then Si := (Si + D) And M;
    If Op In [$A4, $A5, $AA, $AB, $A6, $A7, $AE, $AF] Then
      Di := (Di + D) And M;
    Dec(Cnt);
    If (Rep <> 0) And (Op In [$A6, $A7, $AE, $AF]) Then
    Begin
      If (Rep = $F3) And ((MemL[0:VmF + fFl] And $40) = 0) Then Go := False;
      If (Rep = $F2) And ((MemL[0:VmF + fFl] And $40) <> 0) Then Go := False;
    End;
  End;
  If A32 Then
  Begin
    MemL[0:VmF + fEsi] := Si; MemL[0:VmF + fEdi] := Di;
    If Rep <> 0 Then MemL[0:VmF + Cx] := Cnt;
  End
  Else
  Begin
    VS(fEsi, Si); VS(fEdi, Di);
    If Rep <> 0 Then VS(Cx, Cnt);
  End;
End;

{ Defaut de page : instruction a emuler ; False si inconnue }
Function VgFault : Boolean;
Var Cs, Ip, N, Op, SegO, Rep, Sz, Rg, Rm, A, V, W, R : LongInt;
    O32, A32 : Boolean;
Begin
  VgFault := False;
  Cs := VR(fCs); Ip := VR(fEip);
  N := 0; SegO := -1; Rep := 0; O32 := False; A32 := False;
  Repeat
    Op := VmCode(Cs, Ip + N);
    Inc(N);
    Case Op Of
      $26 : SegO := fEs; $2E : SegO := fCs; $36 : SegO := fSs;
      $3E : SegO := fDs; $64 : SegO := fFs; $65 : SegO := fGs;
      $66 : O32 := True;
      $67 : A32 := True;
      $F2, $F3 : Rep := Op;
      $F0 : ;
    Else
      Break;
    End;
  Until N > 14;
  If O32 Then Sz := 4 Else Sz := 2;
  If (Op < $40) And ((Op And 7) < 4) Then
  Begin
    { ALU r/m, r et r, r/m }
    If (Op And 1) = 0 Then Sz := 1;
    A := XModRM(Cs, Ip, N, Rg, Rm, SegO, A32);
    If A < 0 Then Exit;
    If (Op And 2) = 0 Then
    Begin
      R := XAlu((Op Shr 3) And 7, XRd(A, Sz), XGetR(Rg, Sz), Sz);
      If ((Op Shr 3) And 7) <> 7 Then XWr(A, R, Sz);
    End
    Else
    Begin
      R := XAlu((Op Shr 3) And 7, XGetR(Rg, Sz), XRd(A, Sz), Sz);
      If ((Op Shr 3) And 7) <> 7 Then XSetR(Rg, Sz, R);
    End;
  End
  Else
    Case Op Of
      $88, $89, $8A, $8B, $86, $87, $84, $85 :
      Begin
        If (Op And 1) = 0 Then Sz := 1;
        A := XModRM(Cs, Ip, N, Rg, Rm, SegO, A32);
        If A < 0 Then Exit;
        Case Op Of
          $88, $89 : XWr(A, XGetR(Rg, Sz), Sz);
          $8A, $8B : XSetR(Rg, Sz, XRd(A, Sz));
          $86, $87 :
          Begin
            V := XRd(A, Sz);
            XWr(A, XGetR(Rg, Sz), Sz);
            XSetR(Rg, Sz, V);
          End;
        Else
          XAlu(4, XRd(A, Sz), XGetR(Rg, Sz), Sz);
        End;
      End;
      $C6, $C7 :
      Begin
        If Op = $C6 Then Sz := 1;
        A := XModRM(Cs, Ip, N, Rg, Rm, SegO, A32);
        If A < 0 Then Exit;
        XWr(A, XImm(Cs, Ip, N, Sz), Sz);
      End;
      $80, $81, $83 :
      Begin
        If Op = $80 Then Sz := 1;
        A := XModRM(Cs, Ip, N, Rg, Rm, SegO, A32);
        If A < 0 Then Exit;
        If Op = $83 Then
        Begin
          W := VmCode(Cs, Ip + N); Inc(N);
          If W >= $80 Then W := W - 256;
        End
        Else W := XImm(Cs, Ip, N, Sz);
        R := XAlu(Rg, XRd(A, Sz), W, Sz);
        If Rg <> 7 Then XWr(A, R, Sz);
      End;
      $F6, $F7 :
      Begin
        If Op = $F6 Then Sz := 1;
        A := XModRM(Cs, Ip, N, Rg, Rm, SegO, A32);
        If A < 0 Then Exit;
        V := XRd(A, Sz);
        Case Rg Of
          0, 1 : XAlu(4, V, XImm(Cs, Ip, N, Sz), Sz);
          2 : XWr(A, Not V, Sz);
          3 : XWr(A, XAlu(5, 0, V, Sz), Sz);
        Else
          Exit;
        End;
      End;
      $FE, $FF :
      Begin
        If Op = $FE Then Sz := 1;
        A := XModRM(Cs, Ip, N, Rg, Rm, SegO, A32);
        If (A < 0) Or (Rg > 1) Then Exit;
        V := XRd(A, Sz);
        W := MemL[0:VmF + fFl] And 1;
        If Rg = 0 Then R := XAlu(0, V, 1, Sz) Else R := XAlu(5, V, 1, Sz);
        MemL[0:VmF + fFl] := (MemL[0:VmF + fFl] And Not 1) Or W;
        XWr(A, R, Sz);
      End;
      $C0, $C1, $D0, $D1, $D2, $D3 :
      Begin
        If Op In [$C0, $D0, $D2] Then Sz := 1;
        A := XModRM(Cs, Ip, N, Rg, Rm, SegO, A32);
        If A < 0 Then Exit;
        If Op In [$C0, $C1] Then
        Begin
          W := VmCode(Cs, Ip + N); Inc(N);
        End
        Else If Op In [$D2, $D3] Then W := VRL(fEcx)
        Else W := 1;
        XWr(A, XShift(Rg, XRd(A, Sz), W, Sz), Sz);
      End;
      $A0..$A3 :
      Begin
        If Op In [$A0, $A2] Then Sz := 1;
        If A32 Then W := XImm(Cs, Ip, N, 4) Else W := XImm(Cs, Ip, N, 2);
        If SegO < 0 Then SegO := fDs;
        A := ((VR(SegO) Shl 4) + W) And $FFFFF;
        If Op < $A2 Then XSetR(0, Sz, XRd(A, Sz))
        Else XWr(A, XGetR(0, Sz), Sz);
      End;
      $A4..$A7, $AA..$AF :
      Begin
        If (Op And 1) = 0 Then Sz := 1;
        XString(Op, Sz, SegO, Rep, A32);
      End;
    Else
      Exit;
    End;
  MemL[0:VmF + fEip] := (Ip + N) And $FFFF;
  VgFault := True;
End;

{ Instructions d'E/S : IN, OUT, INS, OUTS }
Procedure VmPortOp(Op, Cs, Ip, N : LongInt; O32, Rep : Boolean);
Var Port, Sz, Cnt, I, V, Di, Si, K : LongInt;
Begin
  If Op In [$E4..$E7] Then
  Begin
    Port := VmCode(Cs, Ip + N);
    Inc(N);
  End
  Else Port := VR(fEdx);
  If Op In [$E4, $E6, $EC, $EE, $6C, $6E] Then Sz := 1
  Else If O32 Then Sz := 4 Else Sz := 2;
  Case Op Of
    $E4, $E5, $EC, $ED :
    Begin
      V := 0;
      For K := 0 To Sz - 1 Do V := V Or (VmIn(Port + K) Shl (K * 8));
      If Sz = 1 Then VSL(fEax, V)
      Else If Sz = 2 Then VS(fEax, V)
      Else MemL[0:VmF + fEax] := V;
    End;
    $E6, $E7, $EE, $EF :
    Begin
      V := MemL[0:VmF + fEax];
      For K := 0 To Sz - 1 Do VmOut(Port + K, V Shr (K * 8));
    End;
    $6C, $6D, $6E, $6F :
    Begin
      If Rep Then Cnt := VR(fEcx) Else Cnt := 1;
      For I := 1 To Cnt Do
      Begin
        If Op In [$6C, $6D] Then
        Begin
          Di := VR(fEdi);
          For K := 0 To Sz - 1 Do
            Mem[0:VmLin(VR(fEs), Di + K)] := VmIn(Port + K);
          If (MemL[0:VmF + fFl] And $400) <> 0 Then VS(fEdi, Di - Sz)
          Else VS(fEdi, Di + Sz);
        End
        Else
        Begin
          Si := VR(fEsi);
          For K := 0 To Sz - 1 Do
            VmOut(Port + K, Mem[0:VmLin(VR(fDs), Si + K)]);
          If (MemL[0:VmF + fFl] And $400) <> 0 Then VS(fEsi, Si - Sz)
          Else VS(fEsi, Si + Sz);
        End;
      End;
      If Rep Then VS(fEcx, 0);
    End;
  End;
  MemL[0:VmF + fEip] := (Ip + N) And $FFFF;
End;

Function VmHostRm(Ip : LongInt) : Boolean; Forward;

{ Faute de protection generale : instruction sensible a emuler }
Procedure VmGp;
Var Cs, Ip, N, Op, V : LongInt; O32, Rep : Boolean;
Begin
  Cs := VR(fCs); Ip := VR(fEip);
  N := 0; O32 := False; Rep := False;
  Repeat
    Op := VmCode(Cs, Ip + N);
    Inc(N);
    Case Op Of
      $66 : O32 := True;
      $F2, $F3 : Rep := True;
      $26, $2E, $36, $3E, $64, $65, $67, $F0 : ;
    Else
      Break;
    End;
  Until N > 14;
  Case Op Of
    $CD :
    Begin
      V := VmCode(Cs, Ip + N);
      MemL[0:VmF + fEip] := (Ip + N + 1) And $FFFF;
      VmInt(V);
    End;
    $CC :
    Begin
      MemL[0:VmF + fEip] := (Ip + N) And $FFFF;
      VmInt(3);
    End;
    $CE :
    Begin
      MemL[0:VmF + fEip] := (Ip + N) And $FFFF;
      If (MemL[0:VmF + fFl] And $800) <> 0 Then VmInt(4);
    End;
    $CF :
    Begin
      If O32 Then
      Begin
        V := VmPop; VmPop;
        VmGoto(VmPop, V); VmPop;
        V := VmPop; VmPop;
        VmLoadFlags(V);
      End
      Else
      Begin
        V := VmPop; VmGoto(VmPop, V);
        VmLoadFlags(VmPop);
      End;
    End;
    $9C :
    Begin
      MemL[0:VmF + fEip] := (Ip + N) And $FFFF;
      If O32 Then VmPush(0);
      VmPush(VmVFlags);
    End;
    $9D :
    Begin
      MemL[0:VmF + fEip] := (Ip + N) And $FFFF;
      V := VmPop;
      If O32 Then VmPop;
      VmLoadFlags(V);
    End;
    $FA :
    Begin
      MemL[0:VmF + fEip] := (Ip + N) And $FFFF;
      VmIF := False;
    End;
    $FB :
    Begin
      MemL[0:VmF + fEip] := (Ip + N) And $FFFF;
      VmIF := True;
    End;
    $F4 :
      If (Cs = VmBios) And (Ip >= VmStubO) And (Ip < VmStubO + 256) Then
        VmService(Ip - VmStubO)
      Else If (Cs = VmBios) And (Ip = VmExitO) Then VmQuit(VmRetCode)
      Else If (Cs = VmBios) And (Ip = VmMRetO) Then
      Begin
        MoveMem(LongInt(@VmMouSave), VmF, 68);
        VmIF := VmMouBusy = 2;
        VmMouBusy := 0;
      End
      Else If VmIsShell(Cs, Ip) Then VmShell
      Else If (Cs = VmBios) And VmHostRm(Ip) Then
      Else If (Cs = VmBios) And (Ip = VmCpmO) Then
      Begin
        { CALL 5 : fonction CL du DOS, puis retour a l'appelant }
        VmPop;
        V := VmPop;
        VmGoto(V, VmPop);
        VSH(fEax, VRL(fEcx));
        VmPush(VmVFlags); VmPush(VR(fCs)); VmPush(VR(fEip));
        VmService($21);
      End
      Else
      Begin
        MemL[0:VmF + fEip] := (Ip + N) And $FFFF;
        If VmIF Then
          While Not VmIrqPending And (VmMouEv And VmMouMask = 0) Do
            KSleep(1);
      End;
    $E4..$E7, $EC..$EF, $6C..$6F : VmPortOp(Op, Cs, Ip, N, O32, Rep);
  Else
    VmCrash('instruction ' + HexStr(Op, 2) + 'h non geree');
  End;
End;

{ Unite Crt de Turbo Pascal 7 (et 6) : l'etalonnage de Delay divise
  par 55 le nombre de tours de boucle d'un top d'horloge (NOT AX, NOT
  DX, MOV CX,55, DIV CX) ; sur un processeur rapide le quotient depasse
  16 bits et le programme s'arretait sur l'erreur 200 (Division by
  zero). Le quotient est ici limite a FFFFh, comme le font les
  correctifs de l'unite Crt. }
Function VmCrtFix : Boolean;
Var Cs, Ip, I : LongInt;
Const Pat : Array[0..8] Of Byte = ($F7, $D0, $F7, $D2, $B9, $37, $00,
                                   $F7, $F1);
Begin
  VmCrtFix := False;
  Cs := VR(fCs); Ip := VR(fEip);
  For I := 0 To 8 Do
    If VmCode(Cs, Ip - 7 + I) <> Pat[I] Then Exit;
  VS(fEax, $FFFF);
  VS(fEdx, 0);
  MemL[0:VmF + fEip] := (Ip + 2) And $FFFF;
  VmCrtFix := True;
End;

{ Selecteur de segment valide pour l'anneau 3 (sinon 0) }
Function VmSelOk(S : LongInt) : LongInt;
Begin
  S := S And $FFFF;
  If ((S And 7) = 7) And SelValid(S) Then VmSelOk := S
  Else If (S And $FFF8) = $40 Then VmSelOk := S
  Else VmSelOk := 0;
End;

{ Cadre des souches (EDI en F) -> contexte VmCtx }
Procedure VmLoadCtx(F : LongInt);
Begin
  MoveMem(F, LongInt(@VmCtx), 32);
  If (MemL[0:F + 56] And $20000) <> 0 Then
  Begin
    VmPM := False;
    MoveMem(F + 48, LongInt(@VmCtx) + 32, 36);
  End
  Else
  Begin
    VmPM := True;
    MoveMem(F + 64, LongInt(@VmCtx) + 32, 20);
    VmCtx[13] := MemL[0:F + 40] And $FFFF;
    VmCtx[14] := MemL[0:F + 44] And $FFFF;
    VmCtx[15] := MemL[0:F + 36] And $FFFF;
    VmCtx[16] := MemL[0:F + 32] And $FFFF;
  End;
End;

{ Contexte -> cadre de sortie, selon le mode (V86 ou anneau 3) }
Procedure VmStoreCtx(F : LongInt);
Var Fl : LongInt;
Begin
  MoveMem(LongInt(@VmCtx), F, 32);
  Fl := (VmCtx[10] And $FFFFF And Not $27000) Or $202;
  If VmPM Then
  Begin
    MemL[0:F + 32] := VmSelOk(VmCtx[16]);
    MemL[0:F + 36] := VmSelOk(VmCtx[15]);
    MemL[0:F + 40] := VmSelOk(VmCtx[13]);
    MemL[0:F + 44] := VmSelOk(VmCtx[14]);
    FillMem(F + 48, 16, 0);
    MemL[0:F + 64] := VmCtx[8];
    MemL[0:F + 68] := VmCtx[9] And $FFFF;
    MemL[0:F + 72] := Fl;
    MemL[0:F + 76] := VmCtx[11];
    MemL[0:F + 80] := VmCtx[12] And $FFFF;
    VmPad := 16;
    If VmTrace And False Then
      KLog('PM : ' + HexStr(MemL[0:F + 64], 8) + ' ' +
           HexStr(MemL[0:F + 68], 8) + ' ' + HexStr(MemL[0:F + 72], 8) +
           ' ' + HexStr(MemL[0:F + 76], 8) + ' ' + HexStr(MemL[0:F + 80], 8) +
           ' ds ' + HexStr(MemL[0:F + 44], 4) + ' es ' +
           HexStr(MemL[0:F + 40], 4) + ' F=' + HexStr(F, 8));
  End
  Else
  Begin
    FillMem(F + 32, 16, 0);
    MemL[0:F + 48] := VmCtx[8] And $FFFF;
    MemL[0:F + 52] := VmCtx[9] And $FFFF;
    MemL[0:F + 56] := Fl Or $20000;
    MemL[0:F + 60] := VmCtx[11] And $FFFF;
    MemL[0:F + 64] := VmCtx[12] And $FFFF;
    MemL[0:F + 68] := VmCtx[13] And $FFFF;
    MemL[0:F + 72] := VmCtx[14] And $FFFF;
    MemL[0:F + 76] := VmCtx[15] And $FFFF;
    MemL[0:F + 80] := VmCtx[16] And $FFFF;
    VmPad := 0;
  End;
End;

Procedure VmPmTrap; Forward;
Procedure VmPostTrap; Forward;

{ Point d'entree des souches : faute ou trappe du mode V86, ou du
  client DPMI en anneau 3 }
Procedure V86Trap(F : LongInt);
Begin
  VmLoadCtx(F);
  VmF := LongInt(@VmCtx);
  asm
    sti
  end;
  If VmPM Then VmPmTrap
  Else
    Case VmVec Of
      0 : If Not VmCrtFix Then VmInt(0);
      13 : VmGp;
      14 :
        If Not (VgPlanar And (GetCr2 >= $A0000) And (GetCr2 < $B0000) And
                VgFault) Then
          VmCrash('acces a la memoire hors de la machine (' +
                  HexStr(GetCr2, 8) + ')');
      6 : VmCrash('code d''operation invalide');
      7, 10, 11, 12, 16, 17 : VmCrash('exception ' + IntStr(VmVec));
    Else
      VmInt(VmVec);
    End;
  VmPostTrap;
  asm
    cli
  end;
  VmStoreCtx(F);
End;

{ ------------------------------------------------------------------ }
{ Memoire etendue XMS 3.0 (pilote HIMEM.SYS)                         }
{ ------------------------------------------------------------------ }
{ INT 2Fh AX=4300h annonce le pilote, AX=4310h donne son point d'entree
  (F000:VmXmsO, un HLT appele par CALL FAR). Les blocs (EMB) sont pris
  dans le tas du noyau ; leur adresse lineaire (verrouillage, fonction
  0Ch) est aussi leur adresse physique. Pas de HMA ni d'UMB : la zone
  haute de la machine est occupee par le noyau, et le DOS est en bas. }

Const
  XmsMax = 32;
  XmsCapKB = 16384;              { 16 Mo au plus pour la machine }

Var
  XmsLin, XmsKB, XmsLck : Array[0..XmsMax - 1] Of LongInt;  { KB -1 : libre }

Procedure XmsReset;
Var I : LongInt;
Begin
  For I := 0 To XmsMax - 1 Do
  Begin
    XmsKB[I] := -1; XmsLin[I] := 0; XmsLck[I] := 0;
  End;
End;

Function XmsUsedKB : LongInt;
Var I, N : LongInt;
Begin
  N := 0;
  For I := 0 To XmsMax - 1 Do If XmsKB[I] > 0 Then N := N + XmsKB[I];
  XmsUsedKB := N;
End;

{ Memoire libre pour les blocs : le plafond, et ce que le tas peut
  donner en gardant 8 Mo au systeme }
Function XmsFreeKB : LongInt;
Var N : LongInt;
Begin
  N := XmsCapKB - XmsUsedKB;
  If N > HeapFreeBytes Div 1024 - 8192 Then N := HeapFreeBytes Div 1024 - 8192;
  If N < 0 Then N := 0;
  XmsFreeKB := N;
End;

Function XmsHandle(H : LongInt) : LongInt;
Begin
  H := (H And $FFFF) - 1;
  If (H >= 0) And (H < XmsMax) And (XmsKB[H] >= 0) Then XmsHandle := H
  Else XmsHandle := -1;
End;

Function XmsAlloc(KB : LongInt; Var H : LongInt) : LongInt;
Var I, A, Own : LongInt;
Begin
  XmsAlloc := $A1;
  H := -1;
  For I := 0 To XmsMax - 1 Do
    If XmsKB[I] < 0 Then
    Begin
      H := I;
      Break;
    End;
  If H < 0 Then Exit;
  XmsAlloc := $A0;
  If KB > XmsFreeKB Then Exit;
  A := 0;
  If KB > 0 Then
  Begin
    Own := HeapOwner; HeapOwner := VmOwner;
    A := KAlloc(KB * 1024);
    HeapOwner := Own;
    If A = 0 Then Exit;
  End;
  XmsKB[H] := KB; XmsLin[H] := A; XmsLck[H] := 0;
  XmsAlloc := 0;
End;

{ Adresse (noyau) de l'octet Ofs d'un bloc (H = 0 : Seg:Ofs de la
  machine) ; 0 si hors du bloc }
Function XmsAddr(H, Ofs, Len : LongInt) : LongInt;
Var K : LongInt;
Begin
  XmsAddr := 0;
  If H = 0 Then
  Begin
    XmsAddr := VmLin(Ofs Shr 16, Ofs And $FFFF);
    Exit;
  End;
  K := XmsHandle(H);
  If K < 0 Then Exit;
  If (Ofs < 0) Or (Len < 0) Or (Ofs + Len > XmsKB[K] * 1024) Then Exit;
  XmsAddr := XmsLin[K] + Ofs;
End;

Procedure XOk;
Begin
  VS(fEax, 1);
End;

Procedure XFail(E : LongInt);
Begin
  VS(fEax, 0);
  VSL(fEbx, E);
End;

{ Appel du pilote : AH = fonction ; AX = 1 succes, 0 et BL = erreur }
Procedure VmXms;
Var AH, K, H, N, P, Len, Src, Dst, A, B : LongInt;
Begin
  AH := VRH(fEax);
  Case AH Of
    $00 :
    Begin
      VS(fEax, $0300); VS(fEbx, $0301); VS(fEdx, 0);
    End;
    $01, $02 : XFail($91);
    $03, $04, $05, $06 :
    Begin
      XOk; VSL(fEbx, 0);
    End;
    $07 :
    Begin
      XOk; VSL(fEbx, 0);
    End;
    $08, $88 :
    Begin
      N := XmsFreeKB;
      If AH = $08 Then
      Begin
        VS(fEax, Min(N, $FFFF)); VS(fEdx, Min(N, $FFFF));
      End
      Else
      Begin
        MemL[0:VmF + fEax] := N; MemL[0:VmF + fEdx] := N;
        MemL[0:VmF + fEcx] := HeapEnd - 1;
      End;
      If N = 0 Then VSL(fEbx, $A0) Else VSL(fEbx, 0);
    End;
    $09, $89 :
    Begin
      If AH = $09 Then N := VR(fEdx) Else N := MemL[0:VmF + fEdx];
      K := XmsAlloc(N, H);
      If K <> 0 Then XFail(K)
      Else
      Begin
        XOk; VS(fEdx, H + 1);
      End;
    End;
    $0A :
    Begin
      K := XmsHandle(VR(fEdx));
      If K < 0 Then XFail($A2)
      Else If XmsLck[K] > 0 Then XFail($AB)
      Else
      Begin
        If XmsLin[K] <> 0 Then KFree(XmsLin[K]);
        XmsKB[K] := -1; XmsLin[K] := 0;
        XOk;
      End;
    End;
    $0B :
    Begin
      { DS:SI : longueur, poignee source, decalage, poignee but, decalage }
      P := VmPtr(fDs, fEsi);
      Len := MemL[0:P];
      Src := XmsAddr(MemW[0:P + 4], MemL[0:P + 6], Len);
      Dst := XmsAddr(MemW[0:P + 10], MemL[0:P + 12], Len);
      If (Len And 1) <> 0 Then XFail($A7)
      Else If (MemW[0:P + 4] <> 0) And (XmsHandle(MemW[0:P + 4]) < 0) Then
        XFail($A3)
      Else If (MemW[0:P + 10] <> 0) And (XmsHandle(MemW[0:P + 10]) < 0) Then
        XFail($A5)
      Else If Src = 0 Then XFail($A4)
      Else If Dst = 0 Then XFail($A6)
      Else
      Begin
        MoveMem(Src, Dst, Len);
        XOk;
      End;
    End;
    $0C :
    Begin
      K := XmsHandle(VR(fEdx));
      If K < 0 Then XFail($A2)
      Else
      Begin
        Inc(XmsLck[K]);
        XOk;
        VS(fEdx, XmsLin[K] Shr 16); VS(fEbx, XmsLin[K]);
      End;
    End;
    $0D :
    Begin
      K := XmsHandle(VR(fEdx));
      If K < 0 Then XFail($A2)
      Else If XmsLck[K] = 0 Then XFail($AA)
      Else
      Begin
        Dec(XmsLck[K]);
        XOk;
      End;
    End;
    $0E, $8E :
    Begin
      K := XmsHandle(VR(fEdx));
      If K < 0 Then XFail($A2)
      Else
      Begin
        N := 0;
        For H := 0 To XmsMax - 1 Do If XmsKB[H] < 0 Then Inc(N);
        XOk;
        VSH(fEbx, XmsLck[K]);
        If AH = $0E Then
        Begin
          VSL(fEbx, N); VS(fEdx, XmsKB[K]);
        End
        Else
        Begin
          VS(fEcx, N); MemL[0:VmF + fEdx] := XmsKB[K];
        End;
      End;
    End;
    $0F, $8F :
    Begin
      K := XmsHandle(VR(fEdx));
      If AH = $0F Then N := VR(fEbx) Else N := MemL[0:VmF + fEbx];
      If K < 0 Then XFail($A2)
      Else If XmsLck[K] > 0 Then XFail($AB)
      Else If N - XmsKB[K] > XmsFreeKB Then XFail($A0)
      Else
      Begin
        A := 0;
        If N > 0 Then
        Begin
          B := HeapOwner; HeapOwner := VmOwner;
          A := KAlloc(N * 1024);
          HeapOwner := B;
        End;
        If (N > 0) And (A = 0) Then XFail($A0)
        Else
        Begin
          If (A <> 0) And (XmsLin[K] <> 0) Then
            MoveMem(XmsLin[K], A, Min(N, XmsKB[K]) * 1024);
          If XmsLin[K] <> 0 Then KFree(XmsLin[K]);
          XmsLin[K] := A; XmsKB[K] := N;
          XOk;
        End;
      End;
    End;
    $10 :
    Begin
      XFail($B1); VS(fEdx, 0);
    End;
    $11, $12 : XFail($B2);
  Else
    XFail($80);
  End;
End;

{ ------------------------------------------------------------------ }
{ Memoire paginee EMS 4.0 (LIM, pilote EMM386)                       }
{ ------------------------------------------------------------------ }
{ Le cadre de pages de 64 Ko est en E000h (4 pages physiques de 16 Ko).
  Les pages logiques sont prises dans un bloc de 4 Mo du tas ; projeter
  une page (fonctions 44h, 50h, restauration des contextes) change
  simplement les 4 entrees de la table de pages de la machine : aucune
  copie, et le programme voit directement la page. Le nom du pilote
  (EMMXXXX0) est dans l'en-tete de peripherique en F000:000Ah, ou pointe
  le vecteur 67h, et s'ouvre comme fichier (peripherique). }

Const
  EmsPages = 256;                { 4 Mo }
  EmsHMax = 64;
  EmsFrame = $E000;

Type
  TEmsNmArr = Array[0..EmsHMax - 1] Of String[8];
  PEmsNmArr = ^TEmsNmArr;

Var
  EmsPool, EmsPoolBlk : LongInt;
  EmsPgH, EmsPgL : Array[0..EmsPages - 1] Of LongInt;   { H -1 : libre }
  EmsHUsed : Array[0..EmsHMax - 1] Of Boolean;
  EmsHName : PEmsNmArr;                    { alloue dans le tas }
  EmsHSaved : Array[0..EmsHMax - 1] Of Boolean;
  EmsSvH, EmsSvL : Array[0..EmsHMax * 4 - 1] Of LongInt;
  EmsMapH, EmsMapL : Array[0..3] Of LongInt;

Procedure EmsReset;
Var I : LongInt;
Begin
  EmsPool := 0; EmsPoolBlk := 0;
  For I := 0 To EmsPages - 1 Do EmsPgH[I] := -1;
  For I := 0 To EmsHMax - 1 Do
  Begin
    EmsHUsed[I] := False; EmsHName^[I] := ''; EmsHSaved[I] := False;
  End;
  EmsHUsed[0] := True;               { poignee du systeme }
  For I := 0 To 3 Do
  Begin
    EmsMapH[I] := -1; EmsMapL[I] := -1;
  End;
End;

{ Bloc des pages logiques, au premier besoin }
Function EmsPoolOk : Boolean;
Var Own : LongInt;
Begin
  If EmsPool = 0 Then
  Begin
    Own := HeapOwner; HeapOwner := VmOwner;
    EmsPoolBlk := KAlloc(EmsPages * 16384 + 4096);
    HeapOwner := Own;
    If EmsPoolBlk <> 0 Then EmsPool := (EmsPoolBlk + 4095) And Not 4095;
  End;
  EmsPoolOk := EmsPool <> 0;
End;

Function EmsFree : LongInt;
Var I, N : LongInt;
Begin
  N := 0;
  For I := 0 To EmsPages - 1 Do If EmsPgH[I] < 0 Then Inc(N);
  EmsFree := N;
End;

Function EmsCount(H : LongInt) : LongInt;
Var I, N : LongInt;
Begin
  N := 0;
  For I := 0 To EmsPages - 1 Do If EmsPgH[I] = H Then Inc(N);
  EmsCount := N;
End;

{ Page du bloc qui porte la page logique L de la poignee H (-1) }
Function EmsFind(H, L : LongInt) : LongInt;
Var I : LongInt;
Begin
  EmsFind := -1;
  For I := 0 To EmsPages - 1 Do
    If (EmsPgH[I] = H) And (EmsPgL[I] = L) Then
    Begin
      EmsFind := I;
      Exit;
    End;
End;

Function EmsHOk(H : LongInt) : Boolean;
Begin
  EmsHOk := (H >= 0) And (H < EmsHMax) And EmsHUsed[H];
End;

{ Projeter la page physique P (0-3) : pages de la machine E0h + 4 P }
Procedure EmsSetMap(P, H, L : LongInt);
Var I, K, A : LongInt;
Begin
  K := -1;
  If H >= 0 Then K := EmsFind(H, L);
  If K < 0 Then
  Begin
    H := -1; L := -1;
  End;
  EmsMapH[P] := H; EmsMapL[P] := L;
  For I := 0 To 3 Do
  Begin
    If K >= 0 Then A := EmsPool + K * 16384 + I * 4096
    Else A := VmRam + $E0000 + (P * 4 + I) * 4096;
    MemL[0:VmPt + ($E0 + P * 4 + I) * 4] := A Or 7;
  End;
End;

Function EmsAllocP(H, N : LongInt) : Boolean;
Var I, L : LongInt;
Begin
  EmsAllocP := False;
  If (N > EmsFree) Or Not EmsPoolOk Then Exit;
  L := EmsCount(H);
  For I := 0 To EmsPages - 1 Do
    If (N > 0) And (EmsPgH[I] < 0) Then
    Begin
      EmsPgH[I] := H; EmsPgL[I] := L;
      FillMem(EmsPool + I * 16384, 16384, 0);
      Inc(L); Dec(N);
    End;
  EmsAllocP := True;
End;

{ Adresse (noyau) d'une region de la fonction 57h (Typ 0 : memoire
  conventionnelle Seg:Ofs ; 1 : poignee H, page L, decalage Ofs) }
Function EmsRegion(Typ, H, Ofs, Seg, Len : LongInt; Var Err : LongInt)
  : LongInt;
Var K : LongInt;
Begin
  EmsRegion := 0;
  If Typ = 0 Then
  Begin
    EmsRegion := VmLin(Seg, Ofs);
    Exit;
  End;
  If Not EmsHOk(H) Or (H = 0) Then
  Begin
    Err := $83;
    Exit;
  End;
  If Ofs >= 16384 Then
  Begin
    Err := $95;
    Exit;
  End;
  K := EmsFind(H, Seg);
  If (K < 0) Or (Seg * 16384 + Ofs + Len > EmsCount(H) * 16384) Then
  Begin
    Err := $93;
    Exit;
  End;
  EmsRegion := -1;
End;

{ Copier N octets entre memoire conventionnelle et pages logiques }
Procedure EmsCopy(STyp, SH, SOfs, SSeg, DTyp, DH, DOfs, DSeg, N : LongInt;
                  Xchg : Boolean);
Var A, B, K, C, T : LongInt;
Begin
  While N > 0 Do
  Begin
    C := N;
    If STyp = 1 Then
    Begin
      K := EmsFind(SH, SSeg);
      A := EmsPool + K * 16384 + SOfs;
      C := Min(C, 16384 - SOfs);
    End
    Else A := VmLin(SSeg, SOfs);
    If DTyp = 1 Then
    Begin
      K := EmsFind(DH, DSeg);
      B := EmsPool + K * 16384 + DOfs;
      C := Min(C, 16384 - DOfs);
    End
    Else B := VmLin(DSeg, DOfs);
    If STyp = 0 Then C := Min(C, $10000 - SOfs);
    If DTyp = 0 Then C := Min(C, $10000 - DOfs);
    If Xchg Then
      For K := 0 To C - 1 Do
      Begin
        T := Mem[0:A + K]; Mem[0:A + K] := Mem[0:B + K]; Mem[0:B + K] := T;
      End
    Else MoveMem(A, B, C);
    N := N - C;
    SOfs := SOfs + C; DOfs := DOfs + C;
    If STyp = 1 Then
      If SOfs >= 16384 Then
      Begin
        SOfs := SOfs - 16384; Inc(SSeg);
      End;
    If STyp = 0 Then
      If SOfs >= $10000 Then
      Begin
        SOfs := SOfs - 16; Inc(SSeg);
      End;
    If DTyp = 1 Then
      If DOfs >= 16384 Then
      Begin
        DOfs := DOfs - 16384; Inc(DSeg);
      End;
    If DTyp = 0 Then
      If DOfs >= $10000 Then
      Begin
        DOfs := DOfs - 16; Inc(DSeg);
      End;
  End;
End;

Procedure VmInt67;
Var AH, AL, H, L, P, I, N, K, E : LongInt;
Begin
  AH := VRH(fEax); AL := VRL(fEax);
  E := 0;
  Case AH Of
    $40 : ;
    $41 : VS(fEbx, EmsFrame);
    $42 :
    Begin
      VS(fEbx, EmsFree); VS(fEdx, EmsPages);
    End;
    $43, $5A :
    Begin
      N := VR(fEbx);
      If (AH = $43) And (N = 0) Then E := $89
      Else If N > EmsPages Then E := $87
      Else If N > EmsFree Then E := $88
      Else
      Begin
        H := -1;
        For I := 1 To EmsHMax - 1 Do
          If Not EmsHUsed[I] Then
          Begin
            H := I;
            Break;
          End;
        If H < 0 Then E := $85
        Else If Not EmsAllocP(H, N) Then E := $88
        Else
        Begin
          EmsHUsed[H] := True; EmsHName^[H] := ''; EmsHSaved[H] := False;
          VS(fEdx, H);
        End;
      End;
    End;
    $44 :
    Begin
      H := VR(fEdx); L := VR(fEbx);
      If Not EmsHOk(H) Then E := $83
      Else If AL > 3 Then E := $8B
      Else If (L <> $FFFF) And (EmsFind(H, L) < 0) Then E := $8A
      Else If L = $FFFF Then EmsSetMap(AL, -1, -1)
      Else EmsSetMap(AL, H, L);
    End;
    $45 :
    Begin
      H := VR(fEdx);
      If Not EmsHOk(H) Then E := $83
      Else If EmsHSaved[H] Then E := $86
      Else
      Begin
        For I := 0 To 3 Do If EmsMapH[I] = H Then EmsSetMap(I, -1, -1);
        For I := 0 To EmsPages - 1 Do If EmsPgH[I] = H Then EmsPgH[I] := -1;
        If H <> 0 Then EmsHUsed[H] := False;
        EmsHName^[H] := '';
      End;
    End;
    $46 : VSL(fEax, $40);
    $47, $48 :
    Begin
      H := VR(fEdx);
      If Not EmsHOk(H) Then E := $83
      Else If AH = $47 Then
      Begin
        If EmsHSaved[H] Then E := $8D
        Else
        Begin
          For I := 0 To 3 Do
          Begin
            EmsSvH[H * 4 + I] := EmsMapH[I]; EmsSvL[H * 4 + I] := EmsMapL[I];
          End;
          EmsHSaved[H] := True;
        End;
      End
      Else If Not EmsHSaved[H] Then E := $8E
      Else
      Begin
        For I := 0 To 3 Do EmsSetMap(I, EmsSvH[H * 4 + I], EmsSvL[H * 4 + I]);
        EmsHSaved[H] := False;
      End;
    End;
    $4B :
    Begin
      N := 0;
      For I := 0 To EmsHMax - 1 Do If EmsHUsed[I] Then Inc(N);
      VS(fEbx, N);
    End;
    $4C :
      If Not EmsHOk(VR(fEdx)) Then E := $83
      Else VS(fEbx, EmsCount(VR(fEdx)));
    $4D :
    Begin
      P := VmPtr(fEs, fEdi);
      N := 0;
      For I := 0 To EmsHMax - 1 Do
        If EmsHUsed[I] Then
        Begin
          MemW[0:P + N * 4] := I; MemW[0:P + N * 4 + 2] := EmsCount(I);
          Inc(N);
        End;
      VS(fEbx, N);
    End;
    $4E, $4F :
    Begin
      { contexte : 4 x (poignee, page) ; 4Fh : nombre de pages en tete }
      K := 16;
      If AH = $4F Then K := 18;
      Case AL Of
        0 :
        Begin
          If AH = $4E Then P := VmPtr(fEs, fEdi) Else P := VmPtr(fEs, fEdi);
          If AH = $4F Then
          Begin
            MemW[0:P] := 4; P := P + 2;
          End;
          For I := 0 To 3 Do
          Begin
            MemW[0:P + I * 4] := EmsMapH[I] And $FFFF;
            MemW[0:P + I * 4 + 2] := EmsMapL[I] And $FFFF;
          End;
        End;
        1 :
        Begin
          P := VmPtr(fDs, fEsi);
          If AH = $4F Then P := P + 2;
          For I := 0 To 3 Do
          Begin
            H := MemW[0:P + I * 4]; L := MemW[0:P + I * 4 + 2];
            If H = $FFFF Then H := -1;
            EmsSetMap(I, H, L);
          End;
        End;
        2 :
          If AH = $4E Then
          Begin
            P := VmPtr(fEs, fEdi);
            For I := 0 To 3 Do
            Begin
              MemW[0:P + I * 4] := EmsMapH[I] And $FFFF;
              MemW[0:P + I * 4 + 2] := EmsMapL[I] And $FFFF;
            End;
            P := VmPtr(fDs, fEsi);
            For I := 0 To 3 Do
            Begin
              H := MemW[0:P + I * 4]; L := MemW[0:P + I * 4 + 2];
              If H = $FFFF Then H := -1;
              EmsSetMap(I, H, L);
            End;
          End
          Else VSL(fEax, K);
        3 : VSL(fEax, K);
      Else
        E := $8F;
      End;
    End;
    $50 :
    Begin
      H := VR(fEdx);
      P := VmPtr(fDs, fEsi);
      If Not EmsHOk(H) Then E := $83
      Else If AL > 1 Then E := $8F
      Else
        For I := 0 To VR(fEcx) - 1 Do
        Begin
          L := MemW[0:P + I * 4]; K := MemW[0:P + I * 4 + 2];
          If AL = 1 Then K := (K - EmsFrame) Div $400;
          If (K < 0) Or (K > 3) Then E := $8B
          Else If L = $FFFF Then EmsSetMap(K, -1, -1)
          Else If EmsFind(H, L) < 0 Then E := $8A
          Else EmsSetMap(K, H, L);
        End;
    End;
    $51 :
    Begin
      H := VR(fEdx); N := VR(fEbx);
      If Not EmsHOk(H) Then E := $83
      Else
      Begin
        K := EmsCount(H);
        If N > K Then
        Begin
          If Not EmsAllocP(H, N - K) Then E := $88;
        End
        Else
        Begin
          For I := 0 To EmsPages - 1 Do
            If (EmsPgH[I] = H) And (EmsPgL[I] >= N) Then EmsPgH[I] := -1;
          For I := 0 To 3 Do
            If (EmsMapH[I] = H) And (EmsMapL[I] >= N) Then
              EmsSetMap(I, -1, -1);
        End;
        VS(fEbx, EmsCount(H));
      End;
    End;
    $52 :
      If Not EmsHOk(VR(fEdx)) Then E := $83
      Else If AL = 0 Then VSL(fEax, 0)
      Else If AL = 1 Then
      Begin
        If VRL(fEbx) <> 0 Then E := $91;
      End
      Else If AL = 2 Then VSL(fEax, 0)
      Else E := $8F;
    $53 :
    Begin
      H := VR(fEdx);
      If Not EmsHOk(H) Then E := $83
      Else If AL = 0 Then
      Begin
        P := VmPtr(fEs, fEdi);
        FillMem(P, 8, 0);
        For I := 1 To Length(EmsHName^[H]) Do
          Mem[0:P + I - 1] := Ord(EmsHName^[H][I]);
      End
      Else If AL = 1 Then
      Begin
        P := VmPtr(fDs, fEsi);
        EmsHName^[H] := '';
        For I := 0 To 7 Do
          If Mem[0:P + I] <> 0 Then
            EmsHName^[H] := EmsHName^[H] + Chr(Mem[0:P + I]);
      End
      Else E := $8F;
    End;
    $54 :
      Case AL Of
        0 :
        Begin
          P := VmPtr(fEs, fEdi);
          N := 0;
          For I := 0 To EmsHMax - 1 Do
            If EmsHUsed[I] Then
            Begin
              MemW[0:P + N * 10] := I;
              FillMem(P + N * 10 + 2, 8, 0);
              For K := 1 To Length(EmsHName^[I]) Do
                Mem[0:P + N * 10 + 1 + K] := Ord(EmsHName^[I][K]);
              Inc(N);
            End;
          VSL(fEax, N);
        End;
        1 :
        Begin
          P := VmPtr(fDs, fEsi);
          E := $A0;
          For I := 1 To EmsHMax - 1 Do
            If EmsHUsed[I] And (EmsHName^[I] <> '') And
               (EmsHName^[I] = PStrN(P, 8)) Then
            Begin
              VS(fEdx, I);
              E := 0;
            End;
        End;
        2 : VS(fEbx, EmsHMax);
      Else
        E := $8F;
      End;
    $57 :
    Begin
      { DS:SI : longueur (dword), source (type, poignee, decalage,
        segment ou page), but (idem) }
      P := VmPtr(fDs, fEsi);
      N := MemL[0:P];
      If N > $100000 Then E := $96
      Else If (EmsRegion(Mem[0:P + 4], MemW[0:P + 5], MemW[0:P + 7],
                         MemW[0:P + 9], N, E) <> 0) And
              (EmsRegion(Mem[0:P + 11], MemW[0:P + 12], MemW[0:P + 14],
                         MemW[0:P + 16], N, E) <> 0) Then
      Begin
          EmsCopy(Mem[0:P + 4], MemW[0:P + 5], MemW[0:P + 7], MemW[0:P + 9],
                  Mem[0:P + 11], MemW[0:P + 12], MemW[0:P + 14],
                  MemW[0:P + 16], N, AL = 1);
      End;
    End;
    $58 :
    Begin
      If AL = 0 Then
      Begin
        P := VmPtr(fEs, fEdi);
        For I := 0 To 3 Do
        Begin
          MemW[0:P + I * 4] := EmsFrame + I * $400;
          MemW[0:P + I * 4 + 2] := I;
        End;
      End;
      VS(fEcx, 4);
    End;
    $59 :
      If AL = 1 Then
      Begin
        VS(fEbx, EmsFree); VS(fEdx, EmsPages);
      End
      Else E := $A4;
    $5B : If AL = 0 Then
          Begin
            VSL(fEbx, 0); VSeg(fEs, 0); VS(fEdi, 0);
          End
          Else E := $8F;
    $5C : ;
    $5D : E := $A4;
  Else
    E := $84;
  End;
  VSH(fEax, E);
End;

{ ------------------------------------------------------------------ }
{ Serveur DPMI 0.9 (mode protege des programmes DOS)                 }
{ ------------------------------------------------------------------ }
{ INT 2Fh AX=1687h annonce le serveur et donne son point d'entree
  (F000:VmDpmiO). Le client (16 ou 32 bits) passe en mode protege dans
  la meme tache : son code tourne en anneau 3 avec des selecteurs de la
  LDT du noyau (ceux de Win16), sous le repertoire de pages de la
  machine (le premier megaoctet est celui de la machine, la memoire
  allouee par 0501h est prise dans le tas). Le contexte de registres du
  moniteur passe d'un mode a l'autre : une interruption logicielle sans
  gestionnaire en mode protege est reflechie en mode reel (pile reelle
  du serveur, retour par F000:VmRmRetO), comme 0300h-0302h ; les
  rappels en mode reel (0303h), la commutation brute (0306h) et les
  gestionnaires d'exceptions (0202h/0203h) passent par de petites
  souches HLT du segment de code du serveur (anneau 3). Les
  interruptions materielles virtuelles (horloge, clavier) vont aux
  gestionnaires installes en mode protege, sinon au mode reel. }

Const
  VmXmsO = $0260;           { F000 : point d'entree XMS (HLT) }
  VmDpmiO = $0261;          { entree en mode protege (HLT) }
  VmRmRetO = $0262;         { fin d'une interruption reflechie (HLT) }
  VmRawPmO = $0263;         { commutation brute reel -> protege (HLT) }
  VmRetfO = $0264;          { RETF (sauvegarde d'etat, 0305h) }
  VmCbO = $0270;            { 16 rappels en mode reel (HLT) }
  VmPmDefO = $0400;         { gestionnaires par defaut (HLT) }
  VmExcRetO = $0500;        { fin d'un gestionnaire d'exception }
  VmCbRetO = $0501;         { fin d'un rappel (IRET du client) }
  VmRawRmO = $0502;         { commutation brute protege -> reel }
  VmIrqRetO = $0503;        { fin d'une interruption materielle }
  VmExcDefO = $0504;        { gestionnaire d'exception par defaut }
  VmPmRetfO = $0505;        { RETF en mode protege }
  VmVendorO = $0506;        { API du fournisseur 'MS-DOS' (CALL FAR) }
  DpOwner = $DD;            { proprietaire des selecteurs du client }
  VmSvMax = 16;
  VmSvW = 23;               { mots par contexte sauve }

Var
  VmDpmi : Boolean;
  VmDpmiPsp, VmDpmiEnv, VmHostCs : LongInt;
  VmPmVSel, VmPmVOfs : Array[0..255] Of LongInt;
  VmExcSel, VmExcOfs : Array[0..31] Of LongInt;
  VmRmStk, VmRmSp : LongInt;
  VmPmStkSel, VmPmStkLin, VmPmStkTop, VmCbStkSel : LongInt;
  VmSv : Array[0..VmSvMax * VmSvW - 1] Of LongInt;
  VmSvN : LongInt;
  VmMbLin, VmMbSize, VmMbBlk : Array[0..63] Of LongInt;
  VmCbUsed : Array[0..15] Of Boolean;
  VmCbPSel, VmCbPOfs, VmCbSSel, VmCbSOfs : Array[0..15] Of LongInt;
  VmSgSeg, VmSgSel : Array[0..63] Of LongInt;
  VmSgN : LongInt;
  VmIrqSv : Array[0..47] Of LongInt;
  VmIrqVec : Array[0..15] Of LongInt;  { vecteur de chaque niveau }
  { gestionnaires en cours par IRQ (0-15) : une IRQ n'est pas redonnee
    tant que son gestionnaire n'est pas termine (les tics en retard de
    l'horloge emulee arriveraient sinon en rafale, imbriques) }
  VmIrqAct : Array[0..15] Of LongInt;
  VmIrqN : LongInt;
  VmHwRefl : Boolean;           { reflexion d'une interruption materielle }
  VmLdtSel : LongInt;           { alias de la LDT (API 'MS-DOS' 0100h) }

{ ------------------------- descripteurs ---------------------------- }

Function VmDescI(Sel : LongInt) : LongInt;
Begin
  VmDescI := -1;
  If (Sel And 4) = 0 Then Exit;
  Sel := (Sel Shr 3) And $1FFF;
  If (Sel > 0) And (Sel < LdtMax) And LdtUsed[Sel] Then VmDescI := Sel;
End;

{ Acc : octet d'acces (bits 0-7) et drapeaux G, D/B, AVL (bits 12-15) }
Procedure VmDescSet(I, Base, Limit, Acc : LongInt);
Var G : LongInt;
Begin
  G := Acc And $8000;
  If (Limit < 0) Or (Limit > $FFFFF) Then
  Begin
    Limit := (Limit Shr 12) And $FFFFF;
    G := $8000;
  End
  Else If G <> 0 Then Limit := Limit Shr 12;
  Ldt^[I * 2] := (Limit And $FFFF) Or ((Base And $FFFF) Shl 16);
  Ldt^[I * 2 + 1] := ((Base Shr 16) And $FF) Or ((Acc And $FF) Shl 8) Or
                    (Limit And $F0000) Or ((Acc And $7000) Shl 8) Or
                    (G Shl 8) Or (Base And LongInt($FF000000));
End;

Function VmDescAcc(I : LongInt) : LongInt;
Begin
  VmDescAcc := ((Ldt^[I * 2 + 1] Shr 8) And $FF) Or
               ((Ldt^[I * 2 + 1] Shr 8) And $F000);
End;

{ Selecteurs du client (proprietaire DpOwner) }
Function VmSelNew(N, Base, Limit, Acc : LongInt) : LongInt;
Var S, I : LongInt;
Begin
  S := SelAlloc(N);
  VmSelNew := S;
  If S = 0 Then Exit;
  For I := 0 To N - 1 Do
  Begin
    GOwner^[(S Shr 3) + I] := DpOwner;
    VmDescSet((S Shr 3) + I, Base + I * $10000, Limit, Acc);
  End;
End;

Function VmSelOwn(S : LongInt) : Boolean;
Var I : LongInt;
Begin
  I := VmDescI(S);
  VmSelOwn := (I > 0) And (GOwner^[I] = DpOwner);
End;

{ Adresse (noyau) d'une adresse lineaire du client : le premier Mo est
  celui de la machine }
Function VmLK(L : LongInt) : LongInt;
Begin
  If (L >= 0) And (L < $100000) Then VmLK := VmRam + L Else VmLK := L;
End;

Function VmPmLin(Sel, Ofs : LongInt) : LongInt;
Begin
  VmPmLin := VmLK(SelBase(Sel And $FFFF) + Ofs);
End;

Function VmSelBig(Sel : LongInt) : Boolean;
Var I : LongInt;
Begin
  I := VmDescI(Sel);
  VmSelBig := (I > 0) And ((Ldt^[I * 2 + 1] And $400000) <> 0);
End;

{ (E)DI, (E)SI, (E)DX selon la taille du client }
Function VmOfsR(R : LongInt) : LongInt;
Begin
  If Vm32 Then VmOfsR := MemL[0:VmF + R] Else VmOfsR := VR(R);
End;

Function VmPmPtr(SegR, OfsR : LongInt) : LongInt;
Begin
  VmPmPtr := VmPmLin(VR(SegR), VmOfsR(OfsR));
End;

{ ------------------------ pile du client --------------------------- }

Procedure VmPmPush(V, Sz : LongInt);
Var Sp : LongInt;
Begin
  If VmSelBig(VR(fSs)) Then Sp := MemL[0:VmF + fEsp] - Sz
  Else Sp := (VR(fEsp) - Sz) And $FFFF;
  If VmSelBig(VR(fSs)) Then MemL[0:VmF + fEsp] := Sp Else VS(fEsp, Sp);
  If Sz = 4 Then MemL[0:VmPmLin(VR(fSs), Sp)] := V
  Else MemW[0:VmPmLin(VR(fSs), Sp)] := V And $FFFF;
End;

Function VmPmPop(Sz : LongInt) : LongInt;
Var Sp : LongInt;
Begin
  If VmSelBig(VR(fSs)) Then Sp := MemL[0:VmF + fEsp]
  Else Sp := VR(fEsp);
  If Sz = 4 Then VmPmPop := MemL[0:VmPmLin(VR(fSs), Sp)]
  Else VmPmPop := MemW[0:VmPmLin(VR(fSs), Sp)];
  If VmSelBig(VR(fSs)) Then MemL[0:VmF + fEsp] := Sp + Sz
  Else VS(fEsp, Sp + Sz);
End;

Function VmPmSz : LongInt;
Begin
  If Vm32 Then VmPmSz := 4 Else VmPmSz := 2;
End;

Procedure VmPmGo(Sel, Ofs : LongInt);
Begin
  VSeg(fCs, Sel);
  If Vm32 Then MemL[0:VmF + fEip] := Ofs
  Else MemL[0:VmF + fEip] := Ofs And $FFFF;
End;

{ FLAGS du client (IF virtuel) }
Function VmPmFlags : LongInt;
Begin
  VmPmFlags := (MemL[0:VmF + fFl] And $0DD5) Or 2 Or (Ord(VmIF) * $200);
End;

{ --------------------- contextes sauves ---------------------------- }
{ mots 0-17 : registres ; 18 : sorte (1 interruption, 2 appel 0300h, 3
  rappel, 4 exception) ; 19 : auxiliaire ; 20 : IF virtuel ; 21 : mode }

Procedure VmSave(Kind, Aux : LongInt);
Var B : LongInt;
Begin
  If VmSvN >= VmSvMax Then
  Begin
    VmCrash('DPMI : trop de changements de mode imbriques');
    Exit;
  End;
  B := VmSvN * VmSvW;
  MoveMem(LongInt(@VmCtx), LongInt(@VmSv[B]), 72);
  VmSv[B + 18] := Kind; VmSv[B + 19] := Aux;
  VmSv[B + 20] := Ord(VmIF); VmSv[B + 21] := Ord(VmPM);
  Inc(VmSvN);
End;

{ Passer au mode reel sur la pile reelle du serveur (registres generaux
  gardes) }
Procedure VmToRm;
Begin
  VmPM := False;
  VSeg(fDs, 0); VSeg(fEs, 0); VSeg(fFs, 0); VSeg(fGs, 0);
  VSeg(fSs, VmRmStk);
  VmRmSp := VmRmSp - 256;
  MemL[0:VmF + fEsp] := VmRmSp + 256;
  MemL[0:VmF + fFl] := MemL[0:VmF + fFl] And Not $100;
End;

{ Interruption N reflechie en mode reel ; PopFr : un cadre IRET du
  client est a retirer au retour (gestionnaire par defaut atteint) }
{ IRQ (0-15) d'un vecteur d'interruption materielle ; -1 sinon }
Function VmIrqIdx(N : LongInt) : LongInt;
Begin
  If (N >= 8) And (N <= $0F) Then VmIrqIdx := N - 8
  Else If (N >= $70) And (N <= $77) Then VmIrqIdx := N - $70 + 8
  Else VmIrqIdx := -1;
End;

Procedure VmReflect(N : LongInt; PopFr : Boolean);
Var V, A, K : LongInt;
Begin
  { interruption materielle (IRQ, horloge 1Ch) arrivee en mode protege :
    le code interrompu retrouve tous ses registres ; une interruption
    logicielle rend les registres du mode reel }
  A := Ord(PopFr);
  If VmHwRefl Or ((VmIrqN > 0) And (((N >= 8) And (N <= $0F)) Or
     (N = $1C) Or ((N >= $70) And (N <= $77)))) Then A := A Or 2;
  VmHwRefl := False;
  VmSave(1, A);
  K := VmIrqIdx(N);
  VmSv[(VmSvN - 1) * VmSvW + 22] := K;
  If ((A And 2) <> 0) And (K >= 0) Then Inc(VmIrqAct[K]);
  VmToRm;
  VmPush(VmVFlags); VmPush(VmBios); VmPush(VmRmRetO);
  VmIF := False;
  V := MemL[0:VmRam + N * 4];
  VmGoto(V Shr 16, V And $FFFF);
  If V = (LongInt(VmBios) Shl 16) + VmStubO + N Then VmService(N);
End;

{ Retour au mode protege (F000:VmRmRetO atteint en mode reel) }
Procedure VmRmReturn;
Var B, K, L, Fl, I : LongInt; R : Array[0..17] Of LongInt;
Begin
  Dec(VmSvN);
  B := VmSvN * VmSvW;
  K := VmSv[B + 18];
  MoveMem(LongInt(@VmCtx), LongInt(@R), 72);
  VmRmSp := VmRmSp + 256;
  MoveMem(LongInt(@VmSv[B]), LongInt(@VmCtx), 72);
  VmIF := VmSv[B + 20] <> 0;
  VmPM := VmSv[B + 21] <> 0;
  Fl := R[10];
  If K = 1 Then
  Begin
    { interruption logicielle : registres generaux et indicateurs du
      resultat ; materielle (bit 1) : registres du code interrompu }
    If (VmSv[B + 19] And 2) = 0 Then
    Begin
      For I := 0 To 7 Do
        If I <> 3 Then VmCtx[I] := R[I];
      VmCtx[10] := (VmCtx[10] And Not $8D5) Or (Fl And $8D5);
    End
    Else If (VmSv[B + 22] >= 0) And (VmIrqAct[VmSv[B + 22]] > 0) Then
      Dec(VmIrqAct[VmSv[B + 22]]);
    If (VmSv[B + 19] And 1) <> 0 Then
    Begin
      { IRET du cadre empile par le client }
      L := VmPmPop(VmPmSz);
      I := VmPmPop(VmPmSz);
      VmPmGo(I, L);
      L := VmPmPop(VmPmSz);
      VmIF := (L And $200) <> 0;
      VmCtx[10] := (VmCtx[10] And $8D5) Or (L And $500) Or $202;
    End;
  End
  Else If K = 2 Then
  Begin
    { 0300h-0302h : registres reels ecrits dans la structure }
    L := VmSv[B + 19];
    MemL[0:L] := R[0]; MemL[0:L + 4] := R[1]; MemL[0:L + 8] := R[2];
    MemL[0:L + 16] := R[4]; MemL[0:L + 20] := R[5];
    MemL[0:L + 24] := R[6]; MemL[0:L + 28] := R[7];
    MemW[0:L + 32] := Fl And $FFFF;
    MemW[0:L + 34] := R[13]; MemW[0:L + 36] := R[14];
    MemW[0:L + 38] := R[15]; MemW[0:L + 40] := R[16];
    MemW[0:L + 42] := R[8]; MemW[0:L + 44] := R[9];
    MemW[0:L + 46] := R[11]; MemW[0:L + 48] := R[12];
    VmSetCF(False);
  End;
End;

{ ---------------------- entree en mode protege --------------------- }

Function DpSegSel(Seg : LongInt) : LongInt;
Var I : LongInt;
Begin
  For I := 0 To VmSgN - 1 Do
    If VmSgSeg[I] = Seg Then
    Begin
      DpSegSel := VmSgSel[I];
      Exit;
    End;
  I := VmSelNew(1, Seg * 16, $FFFF, $F2);
  If (I <> 0) And (VmSgN < 64) Then
  Begin
    VmSgSeg[VmSgN] := Seg; VmSgSel[VmSgN] := I;
    Inc(VmSgN);
  End;
  DpSegSel := I;
End;

{ CALL FAR F000:VmDpmiO : AX bit 0 = client 32 bits }
Procedure DpEnter;
Var Ip, Cs, Max, I, Own, CsS, DsS, SsS, Ps, En : LongInt;
Begin
  Ip := VmPop; Cs := VmPop;
  VmGoto(Cs, Ip);
  If VmDpmi Then
  Begin
    VmSetCF(True);
    VS(fEax, $8011);
    Exit;
  End;
  Vm32 := (VR(fEax) And 1) <> 0;
  VmSgN := 0; VmSvN := 0; VmIrqN := 0;
  FillMem(LongInt(@VmIrqAct), SizeOf(VmIrqAct), 0);
  For I := 0 To 63 Do VmMbBlk[I] := 0;
  For I := 0 To 15 Do VmCbUsed[I] := False;
  { pile reelle du serveur : les 4 Ko (SI = 100h paragraphes) donnes
    par le client dans ES ; pile protegee de 8 Ko }
  VmRmStk := VR(fEs);
  If VmRmStk = 0 Then VmRmStk := McbAlloc(256, VmCurPsp, Max);
  Own := HeapOwner; HeapOwner := VmOwner;
  VmPmStkLin := KAlloc(8192);
  HeapOwner := Own;
  If (VmRmStk = 0) Or (VmPmStkLin = 0) Then
  Begin
    VmSetCF(True);
    VS(fEax, $8012);
    Exit;
  End;
  VmRmSp := 4096 - 16;
  VmPmStkTop := 8192 - 16;
  I := $40FA * Ord(Vm32) + $FA * Ord(Not Vm32);
  VmHostCs := VmSelNew(1, $F0000, $FFFF, I);
  VmPmStkSel := VmSelNew(1, VmPmStkLin, 8191, $F2 Or ($4000 * Ord(Vm32)));
  VmCbStkSel := VmSelNew(1, 0, $FFFF, $F2);
  CsS := VmSelNew(1, Cs * 16, $FFFF, $FA);
  DsS := DpSegSel(VR(fDs));
  If VR(fSs) = VR(fDs) Then SsS := DsS
  Else SsS := VmSelNew(1, VR(fSs) * 16, $FFFF, $F2);
  Ps := VmSelNew(1, VmCurPsp * 16, $FF, $F2);
  VmDpmiEnv := MemW[0:VmLin(VmCurPsp, $2C)];
  En := VmSelNew(1, VmDpmiEnv * 16, $FFFF, $F2);
  If (VmHostCs = 0) Or (CsS = 0) Or (SsS = 0) Or (Ps = 0) Then
  Begin
    VmSetCF(True);
    VS(fEax, $8011);
    Exit;
  End;
  MemW[0:VmLin(VmCurPsp, $2C)] := En;
  VmPspSel := Ps;
  { alias de la LDT : ses pages deviennent accessibles a l'anneau 3 }
  VmLdtSel := VmSelNew(1, LongInt(Ldt), LdtMax * 8 - 1, $F2);
  For I := LongInt(Ldt) Shr 12 To (LongInt(Ldt) + LdtMax * 8 - 1) Shr 12 Do
    If I < 1024 Then MemL[0:VmPt + I * 4] := (I Shl 12) Or 7;
  For I := 0 To 255 Do
  Begin
    VmPmVSel[I] := VmHostCs; VmPmVOfs[I] := VmPmDefO + I;
  End;
  For I := 0 To 31 Do
  Begin
    VmExcSel[I] := 0; VmExcOfs[I] := 0;
  End;
  VmDpmiPsp := VmCurPsp;
  VmDpmi := True;
  VmPM := True;
  VSeg(fCs, CsS); MemL[0:VmF + fEip] := Ip;
  VSeg(fSs, SsS); MemL[0:VmF + fEsp] := VR(fEsp);
  VSeg(fDs, DsS); VSeg(fEs, Ps); VSeg(fFs, 0); VSeg(fGs, 0);
  VmSetCF(False);
  KLog('DPMI : client ' + IntStr(16 + 16 * Ord(Vm32)) + ' bits, PSP ' +
       HexStr(VmDpmiPsp, 4) + ' CS=' + HexStr(CsS, 4) + ' DS=' +
       HexStr(DsS, 4) + ' SS=' + HexStr(SsS, 4) + ' ES=' + HexStr(Ps, 4) +
       ' ' + HexStr(Ldt^[(CsS Shr 3) * 2], 8) + ' ' +
       HexStr(Ldt^[(CsS Shr 3) * 2 + 1], 8));
End;

{ Fin du client : selecteurs, memoire, rappels }
Procedure DpEnd;
Var I : LongInt;
Begin
  If Not VmDpmi Then Exit;
  For I := 1 To LdtMax - 1 Do
    If LdtUsed[I] And (GOwner^[I] = DpOwner) Then SelFree((I Shl 3) Or 7, 1);
  For I := 0 To 63 Do
    If VmMbBlk[I] <> 0 Then
    Begin
      KFree(VmMbBlk[I]);
      VmMbBlk[I] := 0;
    End;
  If VmPmStkLin <> 0 Then KFree(VmPmStkLin);
  VmPmStkLin := 0;
  If VmRam <> 0 Then
    For I := LongInt(Ldt) Shr 12 To (LongInt(Ldt) + LdtMax * 8 - 1) Shr 12
    Do
      If (I >= 272) And (I < 1024) Then MemL[0:VmPt + I * 4] := (I Shl 12) Or 3;
  If VmRam <> 0 Then MemW[0:VmLin(VmDpmiPsp, $2C)] := VmDpmiEnv;
  VmDpmi := False;
  VmSvN := 0; VmIrqN := 0;
  VmPM := False;
  KLog('DPMI : fin du client');
End;

{ ----------------------- services INT 31h -------------------------- }

Procedure DpFail(E : LongInt);
Begin
  VS(fEax, E);
  VmSetCF(True);
End;

{ 0300h-0302h : appel en mode reel avec la structure ES:(E)DI }
Procedure DpRmCall(Fn : LongInt);
Var L, Sp, Ss, N, V, Src, IntN : LongInt;
Begin
  IntN := VRL(fEbx);
  L := VmPmPtr(fEs, fEdi);
  N := VR(fEcx);
  Src := VmPmLin(VR(fSs), VmOfsR(fEsp));
  If Not VmSelBig(VR(fSs)) Then Src := VmPmLin(VR(fSs), VR(fEsp));
  VmSetCF(False);
  VmSave(2, L);
  VmPM := False;
  MemL[0:VmF + fEdi] := MemL[0:L]; MemL[0:VmF + fEsi] := MemL[0:L + 4];
  MemL[0:VmF + fEbp] := MemL[0:L + 8];
  MemL[0:VmF + fEbx] := MemL[0:L + 16]; MemL[0:VmF + fEdx] := MemL[0:L + 20];
  MemL[0:VmF + fEcx] := MemL[0:L + 24]; MemL[0:VmF + fEax] := MemL[0:L + 28];
  VmLoadFlags(MemW[0:L + 32]);
  VSeg(fEs, MemW[0:L + 34]); VSeg(fDs, MemW[0:L + 36]);
  VSeg(fFs, MemW[0:L + 38]); VSeg(fGs, MemW[0:L + 40]);
  Sp := MemW[0:L + 46]; Ss := MemW[0:L + 48];
  VmRmSp := VmRmSp - 256;
  If (Sp = 0) And (Ss = 0) Then
  Begin
    Ss := VmRmStk; Sp := VmRmSp + 256;
  End;
  VSeg(fSs, Ss); MemL[0:VmF + fEsp] := Sp;
  { parametres copies de la pile protegee }
  If N > 0 Then
  Begin
    Sp := (Sp - N * 2) And $FFFF;
    VS(fEsp, Sp);
    MoveMem(Src, VmLin(Ss, Sp), N * 2);
  End;
  If Fn <> $0301 Then VmPush(VmVFlags);
  VmPush(VmBios); VmPush(VmRmRetO);
  If Fn = $0300 Then
  Begin
    VmIF := False;
    V := MemL[0:VmRam + IntN * 4];
    VmGoto(V Shr 16, V And $FFFF);
    If V = (LongInt(VmBios) Shl 16) + VmStubO + IntN Then VmService(IntN);
  End
  Else VmGoto(MemW[0:L + 44], MemW[0:L + 42]);
End;

Procedure DpMemInfo;
Var P, F : LongInt;
Begin
  P := VmPmPtr(fEs, fEdi);
  FillMem(P, 48, $FF);
  F := HeapFreeBytes - 8 * 1048576;
  If F < 0 Then F := 0;
  MemL[0:P] := F;
  MemL[0:P + 4] := F Div 4096; MemL[0:P + 8] := F Div 4096;
  MemL[0:P + $0C] := (HeapEnd - HeapStart) Div 4096;
  MemL[0:P + $10] := F Div 4096; MemL[0:P + $14] := F Div 4096;
  MemL[0:P + $18] := (HeapEnd - HeapStart) Div 4096;
  MemL[0:P + $1C] := F Div 4096;
  MemL[0:P + $20] := 0;
End;

Function DpMemNew(Size : LongInt; Var H : LongInt) : Boolean;
Var I, A, Own : LongInt;
Begin
  DpMemNew := False;
  H := -1;
  For I := 0 To 63 Do
    If VmMbBlk[I] = 0 Then
    Begin
      H := I;
      Break;
    End;
  If (H < 0) Or (Size <= 0) Or (Size > HeapFreeBytes - 8 * 1048576) Then
    Exit;
  { pages entieres, comme les serveurs DPMI : les extenseurs (DOS/4GW)
    se servent de la fin de la derniere page }
  Size := (Size + 4095) And Not 4095;
  Own := HeapOwner; HeapOwner := VmOwner;
  A := KAlloc(Size + 4096);
  HeapOwner := Own;
  If A = 0 Then Exit;
  FillMem(A, Size + 4096, 0);
  VmMbBlk[H] := A;
  VmMbLin[H] := (A + 4095) And Not 4095;
  VmMbSize[H] := Size;
  DpMemNew := True;
End;

Procedure DpCall;
Var AX, I, S, B, L, N, P, Max, H, K, Acc : LongInt;
Begin
  AX := VR(fEax);
  VmSetCF(False);
  Case AX Of
    $0000 :
    Begin
      N := VR(fEcx);
      If N = 0 Then N := 1;
      S := VmSelNew(N, 0, 0, $F2);
      If S = 0 Then DpFail($8011) Else VS(fEax, S);
    End;
    $0001 :
      If Not VmSelOwn(VR(fEbx)) Then DpFail($8022)
      Else SelFree(VR(fEbx), 1);
    $0002 :
    Begin
      S := DpSegSel(VR(fEbx));
      If S = 0 Then DpFail($8011) Else VS(fEax, S);
    End;
    $0003 : VS(fEax, 8);
    $0006 :
      If VmDescI(VR(fEbx)) < 0 Then DpFail($8022)
      Else
      Begin
        B := SelBase(VR(fEbx));
        VS(fEcx, B Shr 16); VS(fEdx, B);
      End;
    $0007, $0008, $0009 :
    Begin
      I := VmDescI(VR(fEbx));
      If (I < 0) Or Not VmSelOwn(VR(fEbx)) Then DpFail($8022)
      Else
      Begin
        B := SelBase(VR(fEbx)); L := SelLimit(VR(fEbx));
        Acc := VmDescAcc(I);
        If AX = $0007 Then B := (VR(fEcx) Shl 16) Or VR(fEdx)
        Else If AX = $0008 Then
        Begin
          L := (VR(fEcx) Shl 16) Or VR(fEdx);
          Acc := Acc And Not $8000;
          If (L < 0) Or (L > $FFFFF) Then
          Begin
            If (L And $FFF) <> $FFF Then
            Begin
              DpFail($8021);
              Exit;
            End;
            Acc := Acc Or $8000;
          End;
        End
        Else
        Begin
          K := VR(fEcx);
          If ((K And $60) <> $60) Or ((K And $10) = 0) Then
          Begin
            DpFail($8021);
            Exit;
          End;
          Acc := (K And $FF) Or (((K Shr 8) And $D0) Shl 8);
        End;
        If (Acc And $8000) <> 0 Then
          VmDescSet(I, B, (L And LongInt($FFFFF000)) Or $FFF, Acc)
        Else VmDescSet(I, B, L, Acc);
      End;
    End;
    $000A :
    Begin
      I := VmDescI(VR(fEbx));
      If I < 0 Then DpFail($8022)
      Else
      Begin
        S := VmSelNew(1, 0, 0, $F2);
        If S = 0 Then DpFail($8011)
        Else
        Begin
          Ldt^[(S Shr 3) * 2] := Ldt^[I * 2];
          Ldt^[(S Shr 3) * 2 + 1] := (Ldt^[I * 2 + 1] And Not $0F00) Or $0200;
          VS(fEax, S);
        End;
      End;
    End;
    $000B :
    Begin
      I := VmDescI(VR(fEbx));
      If I < 0 Then DpFail($8022)
      Else
      Begin
        P := VmPmPtr(fEs, fEdi);
        MemL[0:P] := Ldt^[I * 2]; MemL[0:P + 4] := Ldt^[I * 2 + 1];
      End;
    End;
    $000C :
    Begin
      I := VmDescI(VR(fEbx));
      P := VmPmPtr(fEs, fEdi);
      If (I < 0) Or Not VmSelOwn(VR(fEbx)) Then DpFail($8022)
      Else If ((MemL[0:P + 4] And $8000) <> 0) And
              (((MemL[0:P + 4] And $6000) <> $6000) Or
               ((MemL[0:P + 4] And $1000) = 0)) Then DpFail($8021)
      Else
      Begin
        Ldt^[I * 2] := MemL[0:P]; Ldt^[I * 2 + 1] := MemL[0:P + 4];
      End;
    End;
    $0100 :
    Begin
      N := VR(fEbx);
      S := McbAlloc(N, VmDpmiPsp, Max);
      If S = 0 Then
      Begin
        DpFail(8); VS(fEbx, Max);
      End
      Else
      Begin
        K := (N * 16 + $FFFF) Div $10000;
        If K = 0 Then K := 1;
        I := VmSelNew(K, S * 16, N * 16 - 1, $F2);
        If I = 0 Then
        Begin
          McbFree(S);
          DpFail($8011);
        End
        Else
        Begin
          For P := 0 To K - 1 Do
            VmDescSet((I Shr 3) + P, S * 16 + P * $10000,
                      Min(N * 16 - P * $10000 - 1, $FFFF), $F2);
          VS(fEax, S); VS(fEdx, I);
        End;
      End;
    End;
    $0101, $0102 :
    Begin
      I := VmDescI(VR(fEdx));
      If (I < 0) Or Not VmSelOwn(VR(fEdx)) Then DpFail($8022)
      Else
      Begin
        S := SelBase(VR(fEdx)) Div 16;
        K := (SelLimit(VR(fEdx)) + $10000) Div $10000;
        If AX = $0101 Then
        Begin
          McbFree(S);
          SelFree(VR(fEdx), K);
        End
        Else
        Begin
          N := VR(fEbx);
          If ((N * 16 + $FFFF) Div $10000 > K) Or
             Not McbResize(S, N, Max) Then
          Begin
            DpFail(8); VS(fEbx, Max);
          End
          Else
            VmDescSet(I, S * 16, Min(N * 16 - 1, $FFFF), $F2);
        End;
      End;
    End;
    $0200 :
    Begin
      L := MemL[0:VmRam + VRL(fEbx) * 4];
      VS(fEcx, L Shr 16); VS(fEdx, L);
    End;
    $0201 : MemL[0:VmRam + VRL(fEbx) * 4] := (VR(fEcx) Shl 16) Or VR(fEdx);
    $0202 :
    Begin
      I := VRL(fEbx) And 31;
      If VmExcSel[I] = 0 Then
      Begin
        VS(fEcx, VmHostCs); MemL[0:VmF + fEdx] := VmExcDefO;
      End
      Else
      Begin
        VS(fEcx, VmExcSel[I]); MemL[0:VmF + fEdx] := VmExcOfs[I];
      End;
    End;
    $0203 :
    Begin
      I := VRL(fEbx) And 31;
      If (VR(fEcx) = VmHostCs) And (VmOfsR(fEdx) = VmExcDefO) Then
        VmExcSel[I] := 0
      Else
      Begin
        VmExcSel[I] := VR(fEcx); VmExcOfs[I] := VmOfsR(fEdx);
      End;
    End;
    $0204 :
    Begin
      I := VRL(fEbx);
      VS(fEcx, VmPmVSel[I]);
      If Vm32 Then MemL[0:VmF + fEdx] := VmPmVOfs[I]
      Else VS(fEdx, VmPmVOfs[I]);
    End;
    $0205 :
    Begin
      I := VRL(fEbx);
      VmPmVSel[I] := VR(fEcx); VmPmVOfs[I] := VmOfsR(fEdx);
    End;
    $0300, $0301, $0302 : DpRmCall(AX);
    $0303 :
    Begin
      K := -1;
      For I := 0 To 15 Do
        If Not VmCbUsed[I] Then
        Begin
          K := I;
          Break;
        End;
      If K < 0 Then DpFail($8015)
      Else
      Begin
        VmCbUsed[K] := True;
        VmCbPSel[K] := VR(fDs); VmCbPOfs[K] := VmOfsR(fEsi);
        VmCbSSel[K] := VR(fEs); VmCbSOfs[K] := VmOfsR(fEdi);
        VS(fEcx, VmBios); VS(fEdx, VmCbO + K);
      End;
    End;
    $0304 :
    Begin
      K := VR(fEdx) - VmCbO;
      If (VR(fEcx) <> VmBios) Or (K < 0) Or (K > 15) Then DpFail($8024)
      Else VmCbUsed[K] := False;
    End;
    $0305 :
    Begin
      VS(fEax, 0);
      VS(fEbx, VmBios); VS(fEcx, VmRetfO);
      VS(fEsi, VmHostCs); MemL[0:VmF + fEdi] := VmPmRetfO;
    End;
    $0306 :
    Begin
      VS(fEbx, VmBios); VS(fEcx, VmRawPmO);
      VS(fEsi, VmHostCs); MemL[0:VmF + fEdi] := VmRawRmO;
    End;
    $0400 :
    Begin
      VS(fEax, $005A); VS(fEbx, 1); VS(fEcx, 4); VS(fEdx, $0870);
    End;
    $0500 : DpMemInfo;
    $0501 :
    Begin
      N := (VR(fEbx) Shl 16) Or VR(fEcx);
      If Not DpMemNew(N, H) Then DpFail($8012)
      Else
      Begin
        VS(fEbx, VmMbLin[H] Shr 16); VS(fEcx, VmMbLin[H]);
        VS(fEsi, 0); VS(fEdi, H + 1);
      End;
    End;
    $0502 :
    Begin
      H := ((VR(fEsi) Shl 16) Or VR(fEdi)) - 1;
      If (H < 0) Or (H > 63) Or (VmMbBlk[H] = 0) Then DpFail($8023)
      Else
      Begin
        KFree(VmMbBlk[H]);
        VmMbBlk[H] := 0;
      End;
    End;
    $0503 :
    Begin
      H := ((VR(fEsi) Shl 16) Or VR(fEdi)) - 1;
      N := (VR(fEbx) Shl 16) Or VR(fEcx);
      If (H < 0) Or (H > 63) Or (VmMbBlk[H] = 0) Then DpFail($8023)
      Else If Not DpMemNew(N, K) Then DpFail($8012)
      Else
      Begin
        MoveMem(VmMbLin[H], VmMbLin[K], Min(N, VmMbSize[H]));
        KFree(VmMbBlk[H]);
        VmMbBlk[H] := VmMbBlk[K]; VmMbLin[H] := VmMbLin[K];
        VmMbSize[H] := VmMbSize[K];
        VmMbBlk[K] := 0;
        VS(fEbx, VmMbLin[H] Shr 16); VS(fEcx, VmMbLin[H]);
      End;
    End;
    $0600, $0601, $0602, $0603, $0702, $0703, $0801 : ;
    $0604 :
    Begin
      VS(fEbx, 0); VS(fEcx, 4096);
    End;
    $0800 :
    Begin
      L := (VR(fEbx) Shl 16) Or VR(fEcx);
      If (L >= 0) And (L < $100000) Then DpFail($8021);
    End;
    $0900 :
    Begin
      VSL(fEax, Ord(VmIF)); VmIF := False;
    End;
    $0901 :
    Begin
      VSL(fEax, Ord(VmIF)); VmIF := True;
    End;
    $0902 : VSL(fEax, Ord(VmIF));
    $0A00 :
      If PStrN(VmPmPtr(fDs, fEsi), 7) = 'MS-DOS' Then
      Begin
        VSeg(fEs, VmHostCs); MemL[0:VmF + fEdi] := VmVendorO;
      End
      Else DpFail($8001);
  Else
    DpFail($8001);
  End;
End;

{ ----------------------- interruptions ----------------------------- }

Procedure VmPmDefault(N : LongInt; Frame : Boolean); Forward;
Procedure VmPmIret; Forward;

Function VmPmDef(N : LongInt) : Boolean;
Begin
  VmPmDef := (VmPmVSel[N] = VmHostCs) And (VmPmVOfs[N] = VmPmDefO + N);
End;

{ Interruption N vers le client : gestionnaire installe (cadre IRET ;
  materielle : retour par VmIrqRetO pour retablir IF), sinon reflexion
  en mode reel }
Procedure VmPmDeliver(N : LongInt; Hw : Boolean);
Var Sz : LongInt;
Begin
  If VmPmDef(N) Then
  Begin
    VmHwRefl := Hw;
    VmPmDefault(N, False);
    VmHwRefl := False;
    Exit;
  End;
  Sz := VmPmSz;
  If Hw Then
  Begin
    If VmIrqN >= 16 Then Exit;
    VmIrqSv[VmIrqN * 3] := VR(fCs);
    VmIrqSv[VmIrqN * 3 + 1] := MemL[0:VmF + fEip];
    VmIrqSv[VmIrqN * 3 + 2] := MemL[0:VmF + fFl];
    VmIrqVec[VmIrqN] := N;
    Inc(VmIrqN);
    If VmIrqIdx(N) >= 0 Then Inc(VmIrqAct[VmIrqIdx(N)]);
    VmPmPush(VmPmFlags, Sz); VmPmPush(VmHostCs, Sz); VmPmPush(VmIrqRetO, Sz);
    VmIF := False;
  End
  Else
  Begin
    VmPmPush(VmPmFlags, Sz); VmPmPush(VR(fCs), Sz);
    VmPmPush(MemL[0:VmF + fEip], Sz);
  End;
  MemL[0:VmF + fFl] := MemL[0:VmF + fFl] And Not $100;
  VmPmGo(VmPmVSel[N], VmPmVOfs[N]);
End;

{ Gestionnaire par defaut du serveur pour l'interruption N : INT 31h
  (services DPMI), INT 21h (DOS, pointeurs traduits), INT 2Fh 1686h et
  168Ah ; les autres sont reflechies en mode reel. Frame : un cadre IRET
  du client est sur sa pile (gestionnaire chaine). }
Procedure VmPmDefault(N : LongInt; Frame : Boolean);
Var T : String; Spec : Boolean;
Begin
  Spec := (N = $31) Or (N = $21) Or
          ((N = $2F) And ((VR(fEax) = $1686) Or (VR(fEax) = $168A)));
  If Not Spec Then
  Begin
    VmReflect(N, Frame);
    Exit;
  End;
  If Frame Then VmPmIret;
  If N = $21 Then VmInt21
  Else If N = $31 Then
  Begin
    If VmTrace Then T := 'INT 31h ' + VmRegStr;
    DpCall;
    If VmTrace Then
      KLog(T + ' -> CF=' + IntStr(MemL[0:VmF + fFl] And 1) + ' AX=' +
           HexStr(VR(fEax), 4) + ' BX=' + HexStr(VR(fEbx), 4) + ' CX=' +
           HexStr(VR(fEcx), 4) + ' DX=' + HexStr(VR(fEdx), 4));
  End
  Else If VR(fEax) = $1686 Then VS(fEax, 0)
  Else If PStrN(VmPmPtr(fDs, fEsi), 7) = 'MS-DOS' Then
  Begin
    VSL(fEax, 0);
    VSeg(fEs, VmHostCs); MemL[0:VmF + fEdi] := VmVendorO;
  End;
End;

{ INT N execute par le client (EIP apres l'instruction) }
Procedure VmPmSoftInt(N : LongInt);
Begin
  VmPmDeliver(N, False);
End;

Function VmPmCode(Ofs : LongInt) : LongInt;
Begin
  VmPmCode := Mem[0:VmPmLin(VR(fCs), Ofs)];
End;

{ Exception du client : son gestionnaire (0203h) sur la pile du
  serveur, ou fin du programme }
Procedure VmPmExc(V : LongInt);
Var Sz, Sp, P : LongInt;
Begin
  If (V < 32) And (VmExcSel[V] <> 0) And (VmPmStkTop > 1024) Then
  Begin
    If VmTrace Then
      KLog('PM exception ' + HexStr(V, 2) + ' code ' + HexStr(VmErrCode, 4) +
           ' en ' + HexStr(VR(fCs), 4) + ':' +
           HexStr(MemL[0:VmF + fEip], 8) + ' ' + VmRegStr + ' octets ' +
           HexStr(VmPmCode(MemL[0:VmF + fEip]), 2) + ' ' +
           HexStr(VmPmCode(MemL[0:VmF + fEip] + 1), 2) + ' ' +
           HexStr(VmPmCode(MemL[0:VmF + fEip] + 2), 2) + ' ' +
           HexStr(VmPmCode(MemL[0:VmF + fEip] + 3), 2));
    Sz := VmPmSz;
    Sp := VmPmStkTop - 8 * Sz;
    VmPmStkTop := VmPmStkTop - 1024;
    P := VmPmStkLin + Sp;
    If Sz = 4 Then
    Begin
      MemL[0:P] := VmExcRetO; MemL[0:P + 4] := VmHostCs;
      MemL[0:P + 8] := VmErrCode; MemL[0:P + 12] := MemL[0:VmF + fEip];
      MemL[0:P + 16] := VR(fCs); MemL[0:P + 20] := VmPmFlags;
      MemL[0:P + 24] := MemL[0:VmF + fEsp]; MemL[0:P + 28] := VR(fSs);
    End
    Else
    Begin
      MemW[0:P] := VmExcRetO; MemW[0:P + 2] := VmHostCs;
      MemW[0:P + 4] := VmErrCode; MemW[0:P + 6] := VR(fEip);
      MemW[0:P + 8] := VR(fCs); MemW[0:P + 10] := VmPmFlags;
      MemW[0:P + 12] := VR(fEsp); MemW[0:P + 14] := VR(fSs);
    End;
    VSeg(fSs, VmPmStkSel); MemL[0:VmF + fEsp] := Sp;
    VmPmGo(VmExcSel[V], VmExcOfs[V]);
    Exit;
  End;
  If V In [0, 1, 3, 4, 5, 7] Then
  Begin
    VmPmDeliver(V, False);
    Exit;
  End;
  KLog('DPMI : exception ' + HexStr(V, 2) + 'h code ' +
       HexStr(VmErrCode, 4) + ' en ' + HexStr(VR(fCs), 4) + ':' +
       HexStr(MemL[0:VmF + fEip], 8) + ' ' + VmRegStr);
  Sz := MemL[0:VmF + fEip];
  For P := 0 To 9 Do
    VmConStr(HexStr(VmPmCode(Sz + P), 2) + ' ');
  VmConStr(#13#10'DPMI : exception ' + HexStr(V, 2) + 'h en ' +
           HexStr(VR(fCs), 4) + ':' + HexStr(MemL[0:VmF + fEip], 8) +
           #13#10);
  VmPM := False;
  VmTerminate(255, False, 0);
End;

{ Rappel en mode reel (CALL FAR F000:VmCbO + K) : procedure protegee
  du client avec DS:(E)SI = pile reelle, ES:(E)DI = structure }
Procedure DpCallback(K : LongInt);
Var L, Sz : LongInt;
Begin
  If Not VmCbUsed[K] Or (VmPmStkTop <= 1024) Then
  Begin
    VmCrash('DPMI : rappel ' + IntStr(K) + ' invalide');
    Exit;
  End;
  L := VmPmLin(VmCbSSel[K], VmCbSOfs[K]);
  MemL[0:L] := MemL[0:VmF + fEdi]; MemL[0:L + 4] := MemL[0:VmF + fEsi];
  MemL[0:L + 8] := MemL[0:VmF + fEbp]; MemL[0:L + 12] := 0;
  MemL[0:L + 16] := MemL[0:VmF + fEbx]; MemL[0:L + 20] := MemL[0:VmF + fEdx];
  MemL[0:L + 24] := MemL[0:VmF + fEcx]; MemL[0:L + 28] := MemL[0:VmF + fEax];
  MemW[0:L + 32] := VmVFlags;
  MemW[0:L + 34] := VR(fEs); MemW[0:L + 36] := VR(fDs);
  MemW[0:L + 38] := VR(fFs); MemW[0:L + 40] := VR(fGs);
  MemW[0:L + 42] := VR(fEip); MemW[0:L + 44] := VR(fCs);
  MemW[0:L + 46] := VR(fEsp); MemW[0:L + 48] := VR(fSs);
  VmSave(3, K);
  VmDescSet(VmCbStkSel Shr 3, VR(fSs) * 16, $FFFF, $F2);
  VmPM := True;
  VSeg(fDs, VmCbStkSel); MemL[0:VmF + fEsi] := VR(fEsp);
  VSeg(fEs, VmCbSSel[K]); MemL[0:VmF + fEdi] := VmCbSOfs[K];
  VSeg(fFs, 0); VSeg(fGs, 0);
  VSeg(fSs, VmPmStkSel); MemL[0:VmF + fEsp] := VmPmStkTop;
  VmPmStkTop := VmPmStkTop - 1024;
  Sz := VmPmSz;
  VmPmPush(VmPmFlags, Sz); VmPmPush(VmHostCs, Sz); VmPmPush(VmCbRetO, Sz);
  VmIF := False;
  VmPmGo(VmCbPSel[K], VmCbPOfs[K]);
End;

{ HLT d'une souche du serveur en mode reel (F000:Ip) ; False si ce
  n'en est pas une }
Function VmHostRm(Ip : LongInt) : Boolean;
Var V : LongInt;
Begin
  If VmTrace And (Ip <> VmRmRetO) Then
    KLog('RM souche ' + HexStr(Ip, 4) + ' ' + VmRegStr);
  VmHostRm := True;
  If Ip = VmXmsO Then
  Begin
    VmXms;
    V := VmPop; VmGoto(VmPop, V);
  End
  Else If Ip = VmDpmiO Then DpEnter
  Else If (Ip = VmRmRetO) And (VmSvN > 0) Then VmRmReturn
  Else If (Ip >= VmCbO) And (Ip < VmCbO + 16) And VmDpmi Then
    DpCallback(Ip - VmCbO)
  Else If (Ip = VmRawPmO) And VmDpmi Then
  Begin
    VmPM := True;
    VSeg(fDs, VR(fEax)); VSeg(fEs, VR(fEcx)); VSeg(fSs, VR(fEdx));
    If Vm32 Then MemL[0:VmF + fEsp] := MemL[0:VmF + fEbx]
    Else MemL[0:VmF + fEsp] := VR(fEbx);
    VSeg(fFs, 0); VSeg(fGs, 0);
    VmPmGo(VR(fEsi), VmOfsR(fEdi));
  End
  Else VmHostRm := False;
End;

{ IRET d'un cadre empile par le client (indicateurs du resultat
  gardes) }
Procedure VmPmIret;
Var Ip, Cs, Fl, Sz : LongInt;
Begin
  Sz := VmPmSz;
  Ip := VmPmPop(Sz); Cs := VmPmPop(Sz); Fl := VmPmPop(Sz);
  VmPmGo(Cs, Ip);
  VmIF := (Fl And $200) <> 0;
  MemL[0:VmF + fFl] := (MemL[0:VmF + fFl] And $8D5) Or (Fl And $500) Or $202;
End;

{ Memoire DOS en selecteurs (0100h et INT 21h 48h) : Sel ou 0 }
Function DpDosAlloc(N : LongInt; Var Seg, Max : LongInt) : LongInt;
Var K, I, P : LongInt;
Begin
  DpDosAlloc := 0;
  Seg := McbAlloc(N, VmDpmiPsp, Max);
  If Seg = 0 Then Exit;
  K := (N * 16 + $FFFF) Div $10000;
  If K = 0 Then K := 1;
  I := VmSelNew(K, Seg * 16, N * 16 - 1, $F2);
  If I = 0 Then
  Begin
    McbFree(Seg);
    Exit;
  End;
  For P := 0 To K - 1 Do
    VmDescSet((I Shr 3) + P, Seg * 16 + P * $10000,
              Min(N * 16 - P * $10000 - 1, $FFFF), $F2);
  DpDosAlloc := I;
End;

{ EXEC demande en mode protege : chemin, bloc de parametres, ligne de
  commande et FCB recopies dans la pile reelle du serveur, puis INT 21h
  en mode reel (le retour du programme revient en mode protege) }
Procedure DpExec;
Var Pb, B, T, V, I : LongInt; Path : String;
Begin
  Path := PStr(VmPtr(fDs, fEdx));
  Pb := VmPtr(fEs, fEbx);
  B := VmLin(VmRmStk, 0);
  PutPStr(B, Path, 128);
  V := MemW[0:Pb];
  If (V And 4) <> 0 Then V := SelBase(V) Shr 4;
  MemW[0:B + 128] := V;
  MemL[0:B + 130] := (VmRmStk Shl 16) Or 144;
  MemL[0:B + 134] := (VmRmStk Shl 16) Or 272;
  MemL[0:B + 138] := (VmRmStk Shl 16) Or 288;
  FillMem(B + 144, 160, 0);
  Mem[0:B + 145] := 13;
  T := MemL[0:Pb + 2];
  If T <> 0 Then MoveMem(VmPmLin(T Shr 16, T And $FFFF), B + 144, 128);
  For I := 0 To 1 Do
  Begin
    T := MemL[0:Pb + 6 + I * 4];
    If (T <> 0) And (T <> -1) Then
      MoveMem(VmPmLin(T Shr 16, T And $FFFF), B + 272 + I * 16, 16);
  End;
  VmSave(1, 0);
  VmToRm;
  VSeg(fDs, VmRmStk); VS(fEdx, 0);
  VSeg(fEs, VmRmStk); VS(fEbx, 128);
  VS(fEax, $4B00);
  VmPush(VmVFlags); VmPush(VmBios); VmPush(VmRmRetO);
  VmIF := False;
  V := MemL[0:VmRam + $21 * 4];
  VmGoto(V Shr 16, V And $FFFF);
  If V = (LongInt(VmBios) Shl 16) + VmStubO + $21 Then VmService($21);
End;

{ INT 21h en mode protege : fonctions propres aux extensions MS-DOS
  (vecteurs, memoire et PSP en selecteurs, EXEC) ; False : la fonction
  ordinaire (pointeurs traduits par VmPtr) }
Function DpDos(AH, AL : LongInt) : Boolean;
Var S, Max, Seg, K : LongInt;
Begin
  DpDos := True;
  VmSetCF(False);
  Case AH Of
    $25 :
    Begin
      VmPmVSel[AL] := VR(fDs); VmPmVOfs[AL] := VmOfsR(fEdx);
    End;
    $35 :
    Begin
      VSeg(fEs, VmPmVSel[AL]);
      If Vm32 Then MemL[0:VmF + fEbx] := VmPmVOfs[AL]
      Else VS(fEbx, VmPmVOfs[AL]);
    End;
    $2F :
    Begin
      If VmDtaPM Then VSeg(fEs, VmDta Shr 16)
      Else VSeg(fEs, DpSegSel(VmDta Shr 16));
      If Vm32 Then MemL[0:VmF + fEbx] := VmDta And $FFFF
      Else VS(fEbx, VmDta);
    End;
    $34, $52 :
    Begin
      VSeg(fEs, DpSegSel(VmDosSeg));
      If AH = $34 Then VS(fEbx, 0) Else VS(fEbx, VmLolO);
    End;
    $63 :
    Begin
      VSeg(fDs, DpSegSel(VmDosSeg)); VS(fEsi, VmDbcsO); VSL(fEax, 0);
    End;
    $48 :
    Begin
      S := DpDosAlloc(VR(fEbx), Seg, Max);
      If S = 0 Then
      Begin
        VmFail(8); VS(fEbx, Max);
      End
      Else VS(fEax, S);
    End;
    $49, $4A :
      If Not VmSelOwn(VR(fEs)) Then VmFail(9)
      Else
      Begin
        Seg := SelBase(VR(fEs)) Div 16;
        K := (SelLimit(VR(fEs)) + $10000) Div $10000;
        If AH = $49 Then
        Begin
          McbFree(Seg);
          SelFree(VR(fEs), K);
          VSeg(fEs, 0);
        End
        Else If ((VR(fEbx) * 16 + $FFFF) Div $10000 > K) Or
                Not McbResize(Seg, VR(fEbx), Max) Then
        Begin
          VmFail(8); VS(fEbx, Max);
        End
        Else
          VmDescSet(VR(fEs) Shr 3, Seg * 16, Min(VR(fEbx) * 16 - 1, $FFFF),
                    $F2);
      End;
    $4B : If AL = 0 Then DpExec Else VmFail(1);
    $50 : If (VR(fEbx) And 4) <> 0 Then
            VmCurPsp := SelBase(VR(fEbx)) Shr 4
          Else VmCurPsp := VR(fEbx);
    $51, $62 :
      If VmCurPsp = VmDpmiPsp Then VS(fEbx, VmPspSel)
      Else VS(fEbx, DpSegSel(VmCurPsp));
  Else
    DpDos := False;
  End;
End;

{ HLT d'une souche du serveur en mode protege }
Procedure VmHostPm(Ip : LongInt);
Var Sz, P, B, L, I : LongInt;
Begin
  If VmTrace And (Ip <> VmPmDefO + $21) And (Ip <> VmPmDefO + $31) Then
    KLog('PM souche ' + HexStr(Ip, 4) + ' ' + VmRegStr);
  Sz := VmPmSz;
  If (Ip >= VmPmDefO) And (Ip < VmPmDefO + 256) Then
    VmPmDefault(Ip - VmPmDefO, True)
  Else If Ip = VmVendorO Then
  Begin
    { API 'MS-DOS' : 0100h = alias de la LDT ; puis RETF }
    If VR(fEax) = $0100 Then
    Begin
      VS(fEax, VmLdtSel); VmSetCF(False);
    End
    Else VmSetCF(True);
    P := VmPmPop(Sz); B := VmPmPop(Sz);
    VmPmGo(B, P);
  End
  Else If Ip = VmIrqRetO Then
  Begin
    If VmIrqN > 0 Then
    Begin
      Dec(VmIrqN);
      I := VmIrqIdx(VmIrqVec[VmIrqN]);
      If (I >= 0) And (VmIrqAct[I] > 0) Then Dec(VmIrqAct[I]);
      VSeg(fCs, VmIrqSv[VmIrqN * 3]);
      MemL[0:VmF + fEip] := VmIrqSv[VmIrqN * 3 + 1];
      MemL[0:VmF + fFl] := VmIrqSv[VmIrqN * 3 + 2];
    End;
    VmIF := True;
  End
  Else If Ip = VmExcRetO Then
  Begin
    { RETF du gestionnaire : SS:ESP sur le code d'erreur }
    P := VmPmLin(VR(fSs), MemL[0:VmF + fEsp]);
    If Not VmSelBig(VR(fSs)) Then P := VmPmLin(VR(fSs), VR(fEsp));
    VmPmStkTop := VmPmStkTop + 1024;
    If Sz = 4 Then
    Begin
      VSeg(fCs, MemL[0:P + 8]); MemL[0:VmF + fEip] := MemL[0:P + 4];
      L := MemL[0:P + 12];
      MemL[0:VmF + fEsp] := MemL[0:P + 16]; VSeg(fSs, MemL[0:P + 20]);
    End
    Else
    Begin
      VSeg(fCs, MemW[0:P + 4]); MemL[0:VmF + fEip] := MemW[0:P + 2];
      L := MemW[0:P + 6];
      MemL[0:VmF + fEsp] := MemW[0:P + 8]; VSeg(fSs, MemW[0:P + 10]);
    End;
    VmIF := (L And $200) <> 0;
    MemL[0:VmF + fFl] := (L And $DD5) Or $202;
  End
  Else If Ip = VmCbRetO Then
  Begin
    { IRET du rappel : ES:(E)DI = structure des registres reels }
    P := VmPmPtr(fEs, fEdi);
    Dec(VmSvN);
    VmPmStkTop := VmPmStkTop + 1024;
    VmPM := False;
    MemL[0:VmF + fEdi] := MemL[0:P]; MemL[0:VmF + fEsi] := MemL[0:P + 4];
    MemL[0:VmF + fEbp] := MemL[0:P + 8];
    MemL[0:VmF + fEbx] := MemL[0:P + 16]; MemL[0:VmF + fEdx] := MemL[0:P + 20];
    MemL[0:VmF + fEcx] := MemL[0:P + 24]; MemL[0:VmF + fEax] := MemL[0:P + 28];
    VmLoadFlags(MemW[0:P + 32]);
    VSeg(fEs, MemW[0:P + 34]); VSeg(fDs, MemW[0:P + 36]);
    VSeg(fFs, MemW[0:P + 38]); VSeg(fGs, MemW[0:P + 40]);
    VmGoto(MemW[0:P + 44], MemW[0:P + 42]);
    VSeg(fSs, MemW[0:P + 48]); MemL[0:VmF + fEsp] := MemW[0:P + 46];
  End
  Else If Ip = VmRawRmO Then
  Begin
    VmPM := False;
    B := VR(fEsi); L := VR(fEdi);
    VSeg(fDs, VR(fEax)); VSeg(fEs, VR(fEcx)); VSeg(fSs, VR(fEdx));
    MemL[0:VmF + fEsp] := VR(fEbx);
    VSeg(fFs, 0); VSeg(fGs, 0);
    VmGoto(B, L);
  End
  Else If Ip = VmExcDefO Then
  Begin
    { un gestionnaire d'exception a rappele celui du serveur }
    VmPmStkTop := VmPmStkTop + 1024;
    VmPmExc(13);
  End
  Else VmPmExc(13);
End;

{ Faute de protection generale du client : INT n, CLI, STI, HLT, IN,
  OUT ; sinon exception }
Procedure VmGpPM;
Var Ip, N, Op, V, K, Sz, Port : LongInt; O32, Big : Boolean;
Begin
  Ip := MemL[0:VmF + fEip];
  Big := VmSelBig(VR(fCs));
  If Not Big Then Ip := Ip And $FFFF;
  N := 0; O32 := Big;
  Repeat
    Op := VmPmCode(Ip + N);
    Inc(N);
    Case Op Of
      $66 : O32 := Not Big;
      $26, $2E, $36, $3E, $64, $65, $67, $F0, $F2, $F3 : ;
    Else
      Break;
    End;
  Until N > 14;
  Case Op Of
    $CD :
    Begin
      V := VmPmCode(Ip + N);
      MemL[0:VmF + fEip] := Ip + N + 1;
      VmPmSoftInt(V);
    End;
    $CC, $CE :
    Begin
      MemL[0:VmF + fEip] := Ip + N;
      If Op = $CC Then VmPmSoftInt(3)
      Else If (MemL[0:VmF + fFl] And $800) <> 0 Then VmPmSoftInt(4);
    End;
    $FA, $FB :
    Begin
      MemL[0:VmF + fEip] := Ip + N;
      VmIF := Op = $FB;
    End;
    $F4 :
      If VR(fCs) = VmHostCs Then VmHostPm(Ip)
      Else
      Begin
        MemL[0:VmF + fEip] := Ip + N;
        If VmIF Then
          While Not VmIrqPending Do KSleep(1);
      End;
    $E4..$E7, $EC..$EF :
    Begin
      If Op In [$E4..$E7] Then
      Begin
        Port := VmPmCode(Ip + N);
        Inc(N);
      End
      Else Port := VR(fEdx);
      If Op In [$E4, $E6, $EC, $EE] Then Sz := 1
      Else If O32 Then Sz := 4 Else Sz := 2;
      If Op In [$E4, $E5, $EC, $ED] Then
      Begin
        V := 0;
        For K := 0 To Sz - 1 Do V := V Or (VmIn(Port + K) Shl (K * 8));
        If Sz = 1 Then VSL(fEax, V)
        Else If Sz = 2 Then VS(fEax, V)
        Else MemL[0:VmF + fEax] := V;
      End
      Else
        For K := 0 To Sz - 1 Do
          VmOut(Port + K, MemL[0:VmF + fEax] Shr (K * 8));
      MemL[0:VmF + fEip] := Ip + N;
    End;
  Else
    VmPmExc(13);
  End;
End;

{ Faute ou trappe du client en mode protege }
Procedure VmPmTrap;
Begin
  If VmTrace And (VmVec <> $131) And (VmVec <> 13) Then
    KLog('PM trappe ' + HexStr(VmVec, 3) + ' en ' + HexStr(VR(fCs), 4) +
         ':' + HexStr(MemL[0:VmF + fEip], 8) + ' err ' +
         HexStr(VmErrCode, 4) + ' ' + VmRegStr);
  If VmVec >= $100 Then VmPmSoftInt(VmVec - $100)
  Else If VmVec = 13 Then VmGpPM
  Else VmPmExc(VmVec);
End;

{ Interruptions virtuelles vers le client en mode protege }
Procedure VmCheckIrqPM;
Begin
  If Not VmIF Then Exit;
  VmTimeUpd;
  If (VmTickDue > 0) And ((VmPicMask And 1) = 0) And
     ((VmIsr And 1) = 0) And (VmIrqAct[0] = 0) Then
  Begin
    Dec(VmTickDue);
    VmIsr := VmIsr Or 1;
    VmPmDeliver(8, True);
    Exit;
  End;
  If (VmKqHead <> VmKqTail) And ((VmPicMask And 2) = 0) And
     ((VmIsr And 3) = 0) And (VmIrqAct[1] = 0) Then
  Begin
    VmCurKey := VmKq[VmKqHead];
    VmKqHead := (VmKqHead + 1) Mod VmKqMax;
    VmPort60 := (VmCurKey Shr 16) And $FF;
    VmIsr := VmIsr Or 2;
    VmPmDeliver(9, True);
  End;
End;

{ Interruption d'horloge du noyau pendant le code du client (cadre B de
  l'interruption, sans changement de mode) }
Procedure VmTickPM(B : LongInt);
Var T : LongInt;
Begin
  VmF := B;
  If Not VmIF Then Exit;
  VmTimeUpd;
  If (VmTickDue > 0) And ((VmPicMask And 1) = 0) And
     ((VmIsr And 1) = 0) And (VmIrqAct[0] = 0) Then
  Begin
    If Not VmPmDef(8) Then
    Begin
      Dec(VmTickDue);
      VmIsr := VmIsr Or 1;
      VmPmDeliver(8, True);
      Exit;
    End
    Else If VmVecDefault(8) And VmVecDefault($1C) Then
    Begin
      Dec(VmTickDue);
      T := MemL[0:VmBda($6C)] + 1;
      If T >= $1800B0 Then
      Begin
        T := 0;
        Mem[0:VmBda($70)] := 1;
      End;
      MemL[0:VmBda($6C)] := T;
    End
    Else
    Begin
      { gestionnaire du mode reel (pilote, extenseur) : l'horloge lui
        est reflechie meme si le client tourne dans une boucle sans
        appel au systeme }
      Dec(VmTickDue);
      VmIsr := VmIsr Or 1;
      VmPmDeliver(8, True);
      Exit;
    End;
  End;
  If (VmKqHead <> VmKqTail) And ((VmPicMask And 2) = 0) And
     ((VmIsr And 3) = 0) And (VmIrqAct[1] = 0) Then
  Begin
    If Not VmPmDef(9) Or Not VmVecDefault(9) Then
    Begin
      VmCurKey := VmKq[VmKqHead];
      VmKqHead := (VmKqHead + 1) Mod VmKqMax;
      VmPort60 := (VmCurKey Shr 16) And $FF;
      VmIsr := VmIsr Or 2;
      VmPmDeliver(9, True);
    End
    Else If VmVecDefault(9) Then
    Begin
      VmCurKey := VmKq[VmKqHead];
      VmKqHead := (VmKqHead + 1) Mod VmKqMax;
      If (VmCurKey And $2000000) <> 0 Then VmBufPush(VmCurKey And $FFFF);
      VmCurKey := 0;
    End;
  End;
End;

{ Apres chaque faute : retours en mode protege, interruptions }
Procedure VmPostTrap;
Var K : LongInt;
Begin
  For K := 1 To 2 Do
  Begin
    While (Not VmPM) And (VmSvN > 0) And (VR(fCs) = VmBios) And
          (VR(fEip) = VmRmRetO) Do VmRmReturn;
    If K = 2 Then Exit;
    If VmPM Then
    Begin
      If VmIF And (VmMouEv And VmMouMask <> 0) And (VmMouBusy = 0) And
         ((VmMouSeg <> 0) Or (VmMouOfs <> 0)) Then
      Begin
        { gestionnaire de la souris (mode reel) appele depuis le mode
          protege : passage par le mode reel }
        VmSave(1, 0);
        VmToRm;
        VmGoto(VmBios, VmRmRetO);
        VmMouCall;
      End
      Else VmCheckIrqPM;
    End
    Else If VmIF And (VmMouEv <> 0) Then
    Begin
      If Not VmMouCall Then VmCheckIrq;
    End
    Else VmCheckIrq;
  End;
End;

{ Services du BIOS et du DOS de la machine (IRET a la fin) }
Procedure VmService(N : LongInt);
Var V : LongInt;
Begin
  VmNoIret := False;
  Case N Of
    $00 :
    Begin
      VmConStr(#13#10'Divide overflow'#13#10);
      VmTerminate(255, False, 0);
    End;
    $06 : VmCrash('code d''operation invalide');
    $08 : VmInt08;
    $09 : VmInt09;
    $10 : VmInt10;
    $11 : VS(fEax, MemW[0:VmBda($10)]);
    $12 : VS(fEax, MemW[0:VmBda($13)]);
    $13 : VmInt13;
    $14 : VSH(fEax, $80);
    $15 : VmInt15;
    $16 : VmInt16;
    $17 : VSH(fEax, $90);
    $1A : VmInt1A;
    $20 : VmTerminate(0, False, 0);
    $21 : VmInt21;
    $24 : VSL(fEax, 3);
    $25, $26 :
    Begin
      { lecture et ecriture absolues : erreur ; le mot des indicateurs
        reste sur la pile (RETF) }
      VS(fEax, $0208);
      VmSetCF(True);
      V := VmPop; VmGoto(VmPop, V);
      VmPush(VmVFlags);
      VmNoIret := True;
    End;
    $27 : VmTerminate(0, True, (VR(fEdx) + 15) Shr 4);
    $28 : VmIdle;
    $29 : VmTty(VRL(fEax));
    $2A : VSH(fEax, 0);
    $2F : VmInt2F;
    $33 : VmInt33;
    $67 : VmInt67;
    $0A..$0F, $70..$77 : ;
  End;
  If Not VmNoIret Then VmIretRet;
End;

{ ------------------------------------------------------------------ }
{ Creation de la machine, ecran de la console, lancement et fin      }
{ ------------------------------------------------------------------ }

Function VmSetup : Boolean;
Var I, A, D, Own, EnvP, S, Z : LongInt; E : String;
Begin
  VmSetup := False;
  If Not PagingInit Then Exit;
  VmBuildStubs;
  Own := HeapOwner;
  HeapOwner := 0;
  If VmTmp = 0 Then VmTmp := KAlloc(1024);
  HeapOwner := VmOwner;
  VmRamBlk := KAlloc($100000 + 4096);
  VmPgBlk := KAlloc(3 * 4096);
  HeapOwner := Own;
  If (VmRamBlk = 0) Or (VmPgBlk = 0) Or (VmTmp = 0) Then Exit;
  VmRam := (VmRamBlk + 4095) And Not 4095;
  FillMem(VmRam, $100000, 0);
  { pages : 0-FFFFFh -> le bloc ; zone haute (HMA) en lecture seule ;
    le reste du premier 4 Mo au noyau seulement }
  VmPd := (VmPgBlk + 4095) And Not 4095;
  VmPt := VmPd + 4096;
  MoveMem(KPd, VmPd, 4096);
  MemL[0:VmPd] := VmPt Or 7;
  For I := 0 To 255 Do MemL[0:VmPt + I * 4] := (VmRam + I * 4096) Or 7;
  For I := 256 To 271 Do MemL[0:VmPt + I * 4] := (I * 4096) Or 5;
  For I := 272 To 1023 Do MemL[0:VmPt + I * 4] := (I * 4096) Or 3;
  { table des interruptions : un HLT par vecteur }
  For I := 0 To 255 Do
    MemL[0:VmRam + I * 4] := (LongInt(VmBios) Shl 16) + VmStubO + I;
  MemL[0:VmRam + $1F * 4] := (LongInt(VmBios) Shl 16) + VmFont8H;
  MemL[0:VmRam + $43 * 4] := (LongInt(VmBios) Shl 16) + VmFontO;
  MemL[0:VmRam + $1D * 4] := (LongInt(VmBios) Shl 16) + $0300;
  MemL[0:VmRam + $1E * 4] := (LongInt(VmBios) Shl 16) + $0300;
  MemL[0:VmRam + $41 * 4] := (LongInt(VmBios) Shl 16) + $0300;
  MemL[0:VmRam + $46 * 4] := (LongInt(VmBios) Shl 16) + $0300;
  { BIOS : souches, tables, police }
  A := VmRam + $F0000;
  FillMem(A + VmStubO, 256, $F4);
  Mem[0:A + VmExitO] := $F4; Mem[0:A + VmCpmO] := $F4;
  Mem[0:A + VmMRetO] := $F4; Mem[0:A + VmCpmO + 2] := $CB;
  MemW[0:A + VmCfgO] := 8; Mem[0:A + VmCfgO + 2] := $FC;
  Mem[0:A + VmCfgO + 3] := 1; Mem[0:A + VmCfgO + 5] := $70;
  Mem[0:A + VmFuncO] := $FF; Mem[0:A + VmFuncO + 1] := $E0;
  Mem[0:A + VmFuncO + 2] := $0F; Mem[0:A + VmFuncO + 7] := 7;
  Mem[0:A + VmFuncO + 8] := 2; Mem[0:A + VmFuncO + 9] := 8;
  For I := 0 To 7 Do
  Begin
    Mem[0:A + VmEgaO + I] := I;
    Mem[0:A + VmEgaO + 8 + I] := $38 + I;
  End;
  Mem[0:A + VmEgaO + 6] := $14;
  MoveMem(FontAddr, A + VmFontO, 4096);
  { polices 8x8 et 8x14 tirees de la 8x16 (lignes reunies deux a deux,
    ou sans la premiere et la derniere) }
  For I := 0 To 255 Do
  Begin
    For S := 0 To 7 Do
    Begin
      D := Mem[0:FontAddr + I * 16 + S * 2] Or
           Mem[0:FontAddr + I * 16 + S * 2 + 1];
      If I < 128 Then Mem[0:A + VmFont8O + I * 8 + S] := D
      Else Mem[0:A + VmFont8H + (I - 128) * 8 + S] := D;
    End;
    For S := 0 To 13 Do
      Mem[0:A + VmFont14O + I * 14 + S] := Mem[0:FontAddr + I * 16 + S + 1];
  End;
  Mem[0:A + $FFF0] := $EA; MemW[0:A + $FFF1] := $E05B;
  MemW[0:A + $FFF3] := VmBios;
  PutPStr(A + $FFF5, '11/14/95', 9);
  Mem[0:A + $FFFE] := $FC;
  { zone de donnees du BIOS }
  MemW[0:VmBda($10)] := $0026;
  MemW[0:VmBda($13)] := 640;
  MemW[0:VmBda($1A)] := $1E; MemW[0:VmBda($1C)] := $1E;
  MemW[0:VmBda($80)] := $1E; MemW[0:VmBda($82)] := $3E;
  VgPlanes := 0; VgShadow := 0; VgPlanar := False; VgShown := False;
  VgMode := 3; VgStart := 0;
  VgTables;
  { XMS, EMS, DPMI : souches HLT du serveur, nom du pilote EMS }
  VmDpmi := False; VmPM := False; VmSvN := 0;
  XmsReset; EmsReset;
  FillMem(A + VmXmsO, $20, $F4);
  FillMem(A + VmPmDefO, $106, $F4);
  Mem[0:A + VmRetfO] := $CB; Mem[0:A + VmPmRetfO] := $CB;
  PutPStr(A + $0A, 'EMMXXXX0', 9);
  VmSetMode($83);
  MemW[0:VmBda($63)] := $3D4;
  Mem[0:VmBda($65)] := $29; Mem[0:VmBda($66)] := $30;
  Mem[0:VmBda($75)] := 1;
  Mem[0:VmBda($87)] := $60; Mem[0:VmBda($88)] := $09;
  Mem[0:VmBda($89)] := $11; Mem[0:VmBda($8A)] := $0B;
  Mem[0:VmBda($96)] := $10;
  ReadRtc;
  S := RtcHour * 3600 + RtcMin * 60 + RtcSec;
  MemL[0:VmBda($6C)] := S * 18 + (S * 2065) Div 10000;
  { donnees du DOS : liste des listes, peripherique NUL, tables }
  D := VmLin(VmDosSeg, 0);
  MemW[0:D + VmLolO - 2] := VmFirstMcb;
  MemL[0:D + VmLolO] := -1; MemL[0:D + VmLolO + 4] := -1;
  MemW[0:D + VmLolO + $10] := 512;
  Mem[0:D + VmLolO + $20] := 2; Mem[0:D + VmLolO + $21] := 26;
  MemL[0:D + VmLolO + $22] := -1;
  MemW[0:D + VmLolO + $26] := $8004;
  PutPStr(D + VmLolO + $2C, 'NUL     ', 9);
  MemW[0:D + VmUpO] := 128;
  For I := 0 To 127 Do Mem[0:D + VmUpO + 2 + I] := 128 + I;
  { premier bloc : PSP racine, puis son environnement }
  E := 'COMSPEC=C:\COMMAND.COM';
  EnvP := (EnvLen + Length(E) + 24 + 15) Shr 4;
  Z := VmRootEnv + EnvP;
  Mem[0:McbA(VmFirstMcb)] := Ord('M');
  MemW[0:McbA(VmFirstMcb) + 1] := VmRootPsp;
  MemW[0:McbA(VmFirstMcb) + 3] := $10;
  PutPStr(McbA(VmFirstMcb) + 8, 'COMMAND', 8);
  Mem[0:McbA(VmRootEnv - 1)] := Ord('M');
  MemW[0:McbA(VmRootEnv - 1) + 1] := VmRootPsp;
  MemW[0:McbA(VmRootEnv - 1) + 3] := EnvP;
  Mem[0:McbA(Z)] := Ord('Z');
  MemW[0:McbA(Z) + 1] := 0;
  MemW[0:McbA(Z) + 3] := $9FFF - Z;
  { variables du systeme ; COMSPEC : l'interpreteur de la machine }
  A := VmLin(VmRootEnv, 0);
  I := 0; S := 0;
  While (S < EnvLen) And (EnvBlk[S] <> 0) Do
  Begin
    E := PStr(LongInt(@EnvBlk) + S);
    If UpStr(Copy(E, 1, 8)) <> 'COMSPEC=' Then
    Begin
      PutPStr(A + I, E, 256);
      I := I + Length(E) + 1;
    End;
    S := S + StrLenZ(LongInt(@EnvBlk) + S) + 1;
  End;
  E := 'COMSPEC=C:\COMMAND.COM';
  PutPStr(A + I, E, 64);
  I := I + Length(E) + 1;
  Mem[0:A + I] := 0;
  MemW[0:A + I + 1] := 1;
  PutPStr(A + I + 3, 'C:\COMMAND.COM', 16);
  { fichiers : CON (0-2), AUX et PRN (NUL) }
  For I := 0 To VmMaxSft - 1 Do SftRef[I] := 0;
  SftDev[0] := 1; SftRef[0] := 3; SftMode[0] := 2;
  SftDev[1] := 2; SftRef[1] := 1; SftMode[1] := 2;
  SftDev[2] := 2; SftRef[2] := 1; SftMode[2] := 2;
  VmMakePsp(VmRootPsp, $10, VmRootEnv, 0, '');
  A := VmLin(VmRootPsp, 0);
  MemW[0:A + $16] := VmRootPsp;
  Mem[0:A + $18] := 0; Mem[0:A + $19] := 0; Mem[0:A + $1A] := 0;
  Mem[0:A + $1B] := 1; Mem[0:A + $1C] := 2;
  MemL[0:A + $0A] := (LongInt(VmBios) Shl 16) + VmExitO;
  MemL[0:VmRam + $22 * 4] := MemL[0:A + $0A];
  VmCurPsp := VmRootPsp;
  VmDta := (VmRootPsp Shl 16) Or $80; VmDtaPM := False;
  For I := 0 To VmMaxFind - 1 Do VmFindH[I] := 0;
  { lecteurs : repertoire courant du lecteur courant }
  For I := 0 To 25 Do VmDir[I] := '';
  VmDrive := Ord(UpCase(CurDirS[1])) - 65;
  If (VmDrive < 0) Or (VmDrive > 25) Then VmDrive := 2;
  VmDir[VmDrive] := Copy(CurDirS, 3, 66);
  { horloge, clavier, souris }
  VmPitDiv := 65536; VmPitAcc := 0; VmTickDue := 0; VmPitMode := 0;
  VmLastMs := Ticks;
  VmPicMask := 0; VmIsr := 0;
  VmKqHead := 0; VmKqTail := 0; VmCurKey := 0; VmPort60 := 0;
  VmPort61 := 0; VmRetr := 0;
  VmMouReset; VmMouBusy := 0; VmMouBtn := 0;
  VmStrat := 0; VmBreak := 0; VmVerify := 0; VmLastErr := 0;
  VmPendScan := -1; VmLineOk := False; VmLine := ''; VmRetCode := 0;
  VmIdleN := 0; VmFlHi := 0;
  VmTrace := EnvFind('DOSTRACE', I);
  { ecran : le contenu de la console }
  For I := 0 To ConCols * ConRows - 1 Do
    MemW[0:VmRam + $B8000 + I * 2] := (ConAt[I] Shl 8) Or ConCh[I];
  VmSetCur(0, ConX, ConY);
  VmSetup := True;
End;

{ Recopier l'ecran de la machine dans la console (tache 0) }
Procedure DosPoll;
Var I, A, C, At, Cell, X, Y, Pg : LongInt; Vis : Boolean;
Begin
  If Not VmOn Or (ConW < 0) Or (VmRam = 0) Then Exit;
  VmShiftUpd;
  If VmGfx Then
  Begin
    { plein ecran tant que la console est la fenetre active (Alt+Tab
      ramene au bureau, comme Windows 95) }
    If (ActiveWin = ConW) And Not VgShown Then VgShow(True)
    Else If (ActiveWin <> ConW) And VgShown Then VgShow(False);
    VgRender;
    Exit;
  End;
  Pg := VmPage;
  A := VmScrA(Pg);
  Cell := -1;
  If VmMouShow >= 0 Then Cell := (VmMouY Div 8) * 80 + VmMouX Div 8;
  For I := 0 To ConCols * ConRows - 1 Do
  Begin
    C := Mem[0:A + I * 2];
    At := Mem[0:A + I * 2 + 1];
    If VmBlink Then At := At And $7F;
    If I = Cell Then At := At Xor $77;
    If (C <> ConCh[I]) Or (At <> ConAt[I]) Then
    Begin
      ConCh[I] := C;
      ConAt[I] := At;
      ConDirty(I Div ConCols);
    End;
  End;
  VmGetCur(Pg, X, Y);
  If X > ConCols - 1 Then X := ConCols - 1;
  If Y > ConRows - 1 Then Y := ConRows - 1;
  Vis := (Mem[0:VmBda($61)] And $20) = 0;
  If (X <> ConX) Or (Y <> ConY) Or (Vis <> ConCurVis) Then
  Begin
    ConDirty(ConY);
    ConX := X; ConY := Y;
    ConCurVis := Vis;
    ConDirty(Y);
  End;
End;

{ Fin de la machine (KillApp) : fichiers fermes, memoire rendue par
  KFreeOwner }
Procedure DosStop;
Var I : LongInt;
Begin
  If Not VmOn Then Exit;
  DosPoll;
  VmOn := False;
  For I := 0 To VmMaxSft - 1 Do
  Begin
    If (SftRef[I] > 0) And (SftDev[I] = 0) Then CloseHandle(SftH[I]);
    SftRef[I] := 0;
  End;
  For I := 0 To VmMaxFind - 1 Do
    If VmFindH[I] <> 0 Then
    Begin
      FindClose(VmFindH[I]);
      VmFindH[I] := 0;
    End;
  If VmT > 0 Then ThrCr3[VmT] := KPd;
  DpEnd;
  VgShow(False);
  VgPlanes := 0; VgShadow := 0; VgPlanar := False; VgMode := 3;
  VgVbeBlk := 0;
  VmGfx := False;
  VmRam := 0;
  VmT := -1;
  { titre de la console d'avant le programme }
  If (ConW >= 0) And (ConTitle <> '') Then
  Begin
    Wnds^[ConW].Text := ConTitle;
    KRepaint(ConW);
    TaskbarChanged;
  End;
  ConCurVis := True;
  ConAttr := 7;
  KLog('DOS : fin de la machine virtuelle');
End;

{ Tache de la machine : charger le programme puis l'executer }
Function DosMain(P : LongInt) : LongInt;
Var Err, Psp, Cs, Ip, Ss, Sp : LongInt;
Begin
  DosMain := 0;
  Err := VmLoad(VmProg, VmArgs, 0, 0, 0, 0, Psp, Cs, Ip, Ss, Sp);
  If Err <> 0 Then
  Begin
    VmConStr(L('Impossible de lancer ', 'Cannot run ', 'Kann nicht ',
               'Impossibile eseguire ', 'No se puede ejecutar ') +
             VmProg + ' (' + IntStr(Err) + ')'#13#10);
    KLog('DOS : chargement de ' + VmProg + ' impossible (' + IntStr(Err) +
         ')');
    ExitProcessK(Err);
    Exit;
  End;
  MemL[0:VmLin(Psp, $0A)] := (LongInt(VmBios) Shl 16) + VmExitO;
  VmTopPsp := Psp;
  VmCurPsp := Psp;
  VmDta := (Psp Shl 16) Or $80; VmDtaPM := False;
  FillMem(LongInt(@VmImg), SizeOf(VmImg), 0);
  VmImg[fEip Div 4] := Ip; VmImg[fCs Div 4] := Cs;
  VmImg[fFl Div 4] := $20202;
  VmImg[fEsp Div 4] := Sp; VmImg[fSs Div 4] := Ss;
  VmImg[fEs Div 4] := Psp; VmImg[fDs Div 4] := Psp;
  VmImg[fEcx Div 4] := $FF; VmImg[fEdx Div 4] := Psp;
  VmImg[fEsi Div 4] := Ip; VmImg[fEdi Div 4] := Sp;
  VmImg[fEbp Div 4] := $091C;
  VmIF := True;
  VmLastMs := Ticks;
  KLog('DOS : execution de ' + VmProg + ' en ' + HexStr(Cs, 4) + ':' +
       HexStr(Ip, 4) + ', PSP ' + HexStr(Psp, 4));
  VmRun;
  KLog('DOS : ' + VmProg + ' termine (code ' + IntStr(VmExitCode) + ')');
  ExitProcessK(VmExitCode);
End;

{ Programme MS-DOS : .COM, ou MZ sans en-tete PE ni NE }
Function IsDosFile(Path : String) : Boolean;
Var H, Got, L : LongInt; B : Array[0..63] Of Byte; Ext : String;
Begin
  IsDosFile := False;
  Ext := UpStr(Copy(Path, Length(Path) - 3, 4));
  If (Ext <> '.EXE') And (Ext <> '.COM') Then Exit;
  H := KOpenFile(Path, False, 3);
  If H = INVALID_HANDLE Then Exit;
  FillMem(LongInt(@B), 64, 0);
  KReadFile(H, LongInt(@B), 64, Got);
  If (Got >= 2) And (((B[0] = $4D) And (B[1] = $5A)) Or
                     ((B[0] = $5A) And (B[1] = $4D))) Then
  Begin
    IsDosFile := True;
    L := MemL[0:LongInt(@B) + $3C];
    If (Got = 64) And (L >= 64) And (L < GetFileSize(H, 0) - 4) Then
    Begin
      SetFilePointer(H, L, 0, 0);
      FillMem(LongInt(@B), 64, 0);
      KReadFile(H, LongInt(@B), 64, Got);
      { PE ou NE de Windows ; un NE pour OS/2 (systeme cible 1, comme
        les programmes DPMI 16 bits de Borland, charges par RTM) se
        lance par son talon MS-DOS }
      If (Got >= 4) And (B[1] = $45) And ((B[0] = $50) Or
         ((B[0] = $4E) And (B[$36] <> 1))) Then
        IsDosFile := False;
    End;
  End
  Else IsDosFile := Ext = '.COM';
  CloseHandle(H);
End;

{ Lancer un programme MS-DOS dans la console }
Function RunDos(Path, Args : String) : Boolean;
Var T, P : LongInt; S : String;
Begin
  RunDos := True;
  KLog('Lancement de ' + Path + ' (MS-DOS)');
  If ChainDir <> '' Then CurDirS := ChainDir
  Else CurDirS := ParentDir(Path);
  If Length(CurDirS) = 3 Then CurDirS := Copy(CurDirS, 1, 2);
  S := BaseName(Path);
  If Pos('.', S) > 0 Then S := Copy(S, 1, Pos('.', S) - 1);
  If ConW < 0 Then ConTitle := S;
  ConEnsure;
  If ConW >= 0 Then
  Begin
    Wnds^[ConW].Text := S;
    KRepaint(ConW);
    TaskbarChanged;
  End;
  If VmOn Or (VmProc >= 0) Then
  Begin
    MsgBoxOpen(S, L('Un programme MS-DOS est d'#130'j'#133' en cours.',
      'An MS-DOS program is already running.',
      'Ein MS-DOS-Programm wird bereits ausgef'#129'hrt.',
      'Un programma MS-DOS '#138' gi'#133' in esecuzione.',
      'Ya se est'#160' ejecutando un programa de MS-DOS.'), $30);
    Exit;
  End;
  P := ProcNew(pkDos);
  If P < 0 Then Exit;
  ProcEnter(P);
  AppConsole := True;
  AppPath := Path;
  AppBase := 0;
  VmOwner := Procs^[P].Owner;
  VmProc := P;
  If Not VmSetup Then
  Begin
    ProcLeave;
    VmProc := -1;
    KillProc(P, -1);
    MsgBoxOpen(S, L('Impossible de creer la machine virtuelle MS-DOS.',
      'Cannot create the MS-DOS virtual machine.',
      'Die virtuelle MS-DOS-Maschine kann nicht erstellt werden.',
      'Impossibile creare la macchina virtuale MS-DOS.',
      'No se puede crear la m'#160'quina virtual de MS-DOS.'), $10);
    Exit;
  End;
  If Args <> '' Then VmArgs := ' ' + Args Else VmArgs := '';
  VmProg := Path;
  VmOn := True;
  AppProcObj := KObjNew(koProcess);
  If AppProcObj >= 0 Then
  Begin
    KObjOwner[AppProcObj] := 0;
    KObjs^[AppProcObj].F1 := P;
    KObjs^[AppProcObj].F4 := Procs^[P].Pid;
  End;
  T := ThreadNew(LongInt(@DosMain), 0, $10000, True);
  VmT := T;
  AppMainT := T;
  ProcLeave;
  If T < 0 Then
  Begin
    KillProc(P, -1);
    Exit;
  End;
End;

{ ==================================================================== }
{ Partie 18 - VirtualBox : VMMDev (Guest Additions), souris integree,  }
{             pointeur dessine par l'hote et taille de l'ecran          }
{ ==================================================================== }

{ Sous VirtualBox, le peripherique VMMDev (PCI 80EE:CAFE) est l'interface
  des Guest Additions : le systeme invite ecrit dans son port (BAR0)
  l'adresse physique d'une requete (en-tete de 24 octets : taille,
  version 10001h, type, code de retour, puis les donnees), traitee aussitot
  par l'hote. Pasdows :
    - se presente (ReportGuestInfo2 et ReportGuestInfo : Windows 95),
      annonce qu'il sait changer la taille de son ecran (capacite
      GRAPHICS : menu "Ajuster automatiquement la taille de l'ecran" et
      "Ecran virtuel, Redimensionner en ...") ;
    - souris integree : il declare la souris absolue ; quand l'hote la
      veut aussi, la position (0..FFFFh) est lue par GetMouseStatus a
      chaque paquet PS/2 (l'hote en envoie un, sans deplacement, a chaque
      mouvement ; les boutons restent sur le PS/2) et regulierement ;
    - pointeur : sa forme (masque ET de 1 bit, couleurs de 32 bits) est
      donnee a l'hote, qui le dessine a la place du pointeur de Pasdows :
      un seul pointeur a l'ecran, sans retard ; si l'hote ne peut pas
      (MOUSE_HOST_CANNOT_HWPOINTER) ou si l'integration est coupee (la
      souris est alors capturee), Pasdows dessine le sien ;
    - les demandes de changement d'affichage de l'hote (evenement
      DISPLAY_CHANGE_REQUEST, scrute par AcknowledgeEvents) donnent une
      largeur, une hauteur et une profondeur quelconques, appliquees
      aussitot par l'interface VBE DISPI de la carte VBoxVGA (80EE:BEEF).
  Les requetes se font interruptions masquees (un seul tampon). }

Const
  VbReqVer = $10001;
  VbMCanAbs = 1; VbMHostAbs = 2; VbMNoHw = 8;
  VbEvMouseCaps = 1; VbEvDisplay = 4;

Var
  VbReq, VbFeat, VbVer : LongInt;
  VbPtrSum, VbNextPoll, VbNextEv : LongInt;

{ Requete de type T (Size octets) preparee en VbReq + 24 ; code rc }
Function VbCall(T, Size : LongInt) : LongInt;
Var R, P, A : LongInt;
Begin
  P := VbPort; A := VbReq;
  MemL[0:A] := Size; MemL[0:A + 4] := VbReqVer; MemL[0:A + 8] := T;
  MemL[0:A + 12] := -1; MemL[0:A + 16] := 0; MemL[0:A + 20] := 0;
  asm
    mov edx,P
    mov eax,A
    out dx,eax
  end;
  R := MemL[0:A + 12];
  VbCall := R;
End;

{ Les requetes et le tampon ne doivent pas etre interrompus }
Function VbCli : LongInt;
Var F : LongInt;
Begin
  asm
    pushfd
    pop eax
    mov F,eax
    cli
  end;
  VbCli := F;
End;

Procedure VbSti(F : LongInt);
Begin
  If (F And $200) <> 0 Then
    asm
      sti
    end;
End;

{ Capacites de la souris (hote et invite) et position absolue }
Function VbMouseStatus(Var X, Y : LongInt) : Boolean;
Var F : LongInt;
Begin
  VbMouseStatus := False;
  If VbPort = 0 Then Exit;
  F := VbCli;
  FillMem(VbReq + 24, 12, 0);
  If VbCall(1, 36) = 0 Then
  Begin
    VbFeat := MemL[0:VbReq + 24];
    X := MemL[0:VbReq + 28]; Y := MemL[0:VbReq + 32];
    VbMouseStatus := True;
  End;
  VbSti(F);
End;

{ Etat de l'integration : souris absolue, pointeur de l'hote }
Procedure VbMouseUpdate;
Var X, Y : LongInt; Was : Boolean;
Begin
  If Not VbMouseStatus(X, Y) Then Exit;
  Was := VbHwPtr;
  VbAbs := MouOk And ((VbFeat And VbMHostAbs) <> 0);
  If VbAbs And ((VbFeat And VbMNoHw) = 0) Then
  Begin
    If Not Was Then
    Begin
      CursorErase;
      VbHwPtr := True;
      VbPtrSum := -1;
      VbPtrSync;
    End;
  End
  Else If Was Then
  Begin
    VbHwPtr := False;
    VbPtrSum := -1;
    CursorDraw;
  End;
End;

{ Position absolue de l'hote en pixels }
Function VbMousePos(Var X, Y : LongInt) : Boolean;
Var PX, PY : LongInt;
Begin
  VbMousePos := False;
  If Not VbAbs Then Exit;
  If Not VbMouseStatus(PX, PY) Then Exit;
  If (VbFeat And VbMHostAbs) = 0 Then
  Begin
    VbMouseUpdate;
    Exit;
  End;
  PX := PX And $FFFF; PY := PY And $FFFF;
  X := (PX * ScrW) Shr 16; Y := (PY * ScrH) Shr 16;
  If X > ScrW - 1 Then X := ScrW - 1;
  If Y > ScrH - 1 Then Y := ScrH - 1;
  VbMousePos := True;
End;

{ Donner a l'hote la forme du pointeur (CurMap : 1 noir, 2 blanc, 3
  inverse) si elle a change, ou le cacher }
Procedure VbPtrSync;
Var Sum, X, Y, V, W, H, Ab, AndSz, Xa, F, Size : LongInt; Vis : Boolean;
Begin
  If (VbPort = 0) Or Not VbHwPtr Then Exit;
  W := CurW; H := CurHh;
  If W > 32 Then W := 32;
  If H > 32 Then H := 32;
  Sum := 0; Vis := False;
  For Y := 0 To H - 1 Do
    For X := 0 To W - 1 Do
    Begin
      V := CurMap[Y * 32 + X];
      If V <> 0 Then Vis := True;
      Sum := (Sum * 31 + V + X * 3 + Y) And $FFFFFF;
    End;
  If CurHide < 0 Then Vis := False;
  Sum := (Sum * 7 + W * 131 + H * 17 + CurHotX * 5 + CurHotY) And $3FFFFFFF;
  If Not Vis Then Sum := $40000000;
  If Sum = VbPtrSum Then Exit;
  VbPtrSum := Sum;
  F := VbCli;
  FillMem(VbReq + 24, 24, 0);
  If Not Vis Then
  Begin
    VbCall(3, 48);                               { invisible }
    VbSti(F);
    Exit;
  End;
  Ab := (W + 7) Div 8;
  AndSz := (Ab * H + 3) And Not 3;
  Xa := VbReq + 44 + AndSz;
  FillMem(VbReq + 44, AndSz + W * H * 4, 0);
  For Y := 0 To H - 1 Do
    For X := 0 To W - 1 Do
    Begin
      V := CurMap[Y * 32 + X];
      If (V = 0) Or (V = 3) Then
        Mem[0:VbReq + 44 + Y * Ab + X Shr 3] :=
          Mem[0:VbReq + 44 + Y * Ab + X Shr 3] Or ($80 Shr (X And 7));
      If (V = 2) Or (V = 3) Then MemL[0:Xa + (Y * W + X) * 4] := $FFFFFF;
    End;
  MemL[0:VbReq + 24] := 1 Or 4;                  { VISIBLE, SHAPE }
  MemL[0:VbReq + 28] := CurHotX; MemL[0:VbReq + 32] := CurHotY;
  MemL[0:VbReq + 36] := W; MemL[0:VbReq + 40] := H;
  Size := 44 + AndSz + W * H * 4;
  If Size < 48 Then Size := 48;
  VbCall(3, Size);
  VbSti(F);
End;

{ Demande de changement d'affichage de l'hote : appliquee par DISPI }
Procedure VbDisplayChange;
Var F, W, H, B, D, Rc : LongInt;
Begin
  F := VbCli;
  FillMem(VbReq + 24, 20, 0);
  MemL[0:VbReq + 36] := VbEvDisplay;             { evenement acquitte }
  Rc := VbCall(54, 44);
  If Rc <> 0 Then
  Begin
    FillMem(VbReq + 24, 16, 0);
    MemL[0:VbReq + 36] := VbEvDisplay;
    Rc := VbCall(51, 40);
    MemL[0:VbReq + 40] := 0;
  End;
  W := MemL[0:VbReq + 24]; H := MemL[0:VbReq + 28];
  B := MemL[0:VbReq + 32]; D := MemL[0:VbReq + 40];
  VbSti(F);
  If (Rc <> 0) Or (D <> 0) Or (W <= 0) Or (H <= 0) Then Exit;
  If (B <> 8) And (B <> 15) And (B <> 16) And (B <> 24) And (B <> 32) Then
    B := DispCurBpp;
  If B = 4 Then B := 8;
  If W < 640 Then W := 640;
  If H < 480 Then H := 480;
  KLog('VirtualBox : affichage demande ' + IntStr(W) + 'x' + IntStr(H) +
       'x' + IntStr(B));
  If (W = ScrW) And (H = ScrH) And (B = ScrBpp) Then Exit;
  If Not KSetModeWH(W, H, B) Then
    KLog('VirtualBox : mode refuse par la carte');
End;

{ Scrutation (ProcessInput) : evenements de l'hote, position }
Procedure VbPoll;
Var F, Ev : LongInt;
Begin
  If VbPort = 0 Then Exit;
  If Ticks - VbNextEv < 0 Then Exit;
  VbNextEv := Ticks + 200;
  F := VbCli;
  MemL[0:VbReq + 24] := 0;
  If VbCall(41, 28) = 0 Then Ev := MemL[0:VbReq + 24] Else Ev := 0;
  VbSti(F);
  If (Ev And VbEvMouseCaps) <> 0 Then VbMouseUpdate;
  If (Ev And VbEvDisplay) <> 0 Then VbDisplayChange;
  { l'integration peut aussi changer sans evenement (Hote+I) }
  If (Ev And VbEvMouseCaps) = 0 Then
    If Ticks - VbNextPoll >= 0 Then
    Begin
      VbNextPoll := Ticks + 1000;
      VbMouseUpdate;
    End;
End;

Procedure VbInit;
Var Bus, Dev, Id, Bar, Cmd, F, I, HO : LongInt; S : String;
Begin
  VbPort := 0; VbAbs := False; VbHwPtr := False; VbGfx := False;
  VbNextPoll := 0; VbNextEv := 0; VbPtrSum := -1;
  For Bus := 0 To 3 Do
    For Dev := 0 To 31 Do
    Begin
      Id := PciRead(Bus, Dev, 0, 0);
      If Id = LongInt($BEEF80EE) Then VbGfx := True;
      If (Id = LongInt($CAFE80EE)) And (VbPort = 0) Then
      Begin
        Bar := PciRead(Bus, Dev, 0, $10);
        If (Bar And 1) <> 0 Then
        Begin
          Cmd := PciRead(Bus, Dev, 0, 4);
          PciWrite(Bus, Dev, 0, 4, (Cmd And $FFFF) Or 7);
          VbPort := Bar And $FFFC;
          VbMmio := PciRead(Bus, Dev, 0, $14) And LongInt($FFFFFFF0);
          VbIrq := PciRead(Bus, Dev, 0, $3C) And 255;
        End;
      End;
    End;
  { VBoxVGA : largeurs quelconques (sinon multiples de 8) }
  If VbGfx And DispiOk Then
  Begin
    DispiW(0, $BE02);
    If DispiR(0) = $BE02 Then
      KLog('VirtualBox : VBoxVGA, largeurs quelconques');
  End;
  If VbPort = 0 Then Exit;
  HO := HeapOwner; HeapOwner := 0;
  VbReq := KAlloc(8192 + 16);
  HeapOwner := HO;
  If VbReq = 0 Then
  Begin
    VbPort := 0;
    Exit;
  End;
  VbReq := (VbReq + 15) And Not 15;
  F := VbCli;
  { ReportGuestInfo2 : version et nom des "Additions" }
  FillMem(VbReq + 24, 144, 0);
  MemW[0:VbReq + 24] := 6; MemW[0:VbReq + 26] := 1;
  S := 'Pasdows 95';
  For I := 1 To Length(S) Do Mem[0:VbReq + 39 + I] := Ord(S[I]);
  VbCall(58, 168);
  { ReportGuestInfo : interface 1.4, Windows 95 }
  MemL[0:VbReq + 24] := $00010004; MemL[0:VbReq + 28] := $21000;
  I := VbCall(50, 32);
  If I <> 0 Then
  Begin
    VbSti(F);
    KLog('VirtualBox : VMMDev en ' + HexStr(VbPort, 4) +
         'h refuse ReportGuestInfo (' + IntStr(I) + ')');
    VbPort := 0;
    Exit;
  End;
  { pilote actif, capacite GRAPHICS (changement de taille), etat }
  MemL[0:VbReq + 24] := 20; MemL[0:VbReq + 28] := 50;
  MemL[0:VbReq + 32] := 0;
  VbCall(59, 36);
  MemL[0:VbReq + 24] := 4; MemL[0:VbReq + 28] := 0;
  If VbCall(56, 32) <> 0 Then
  Begin
    MemL[0:VbReq + 24] := 4;
    VbCall(55, 28);
  End;
  MemL[0:VbReq + 24] := 1100; MemL[0:VbReq + 28] := 50;
  MemL[0:VbReq + 32] := 0;
  VbCall(59, 36);
  { evenements : changement d'affichage, capacites de la souris }
  MemL[0:VbReq + 24] := VbEvDisplay Or VbEvMouseCaps;
  MemL[0:VbReq + 28] := 0;
  VbCall(42, 32);
  { souris absolue }
  If MouOk Then
  Begin
    MemL[0:VbReq + 24] := VbMCanAbs;
    MemL[0:VbReq + 28] := 0; MemL[0:VbReq + 32] := 0;
    VbCall(2, 36);
  End;
  { version de l'hote }
  FillMem(VbReq + 24, 16, 0);
  If VbCall(4, 40) = 0 Then
    VbVer := (MemW[0:VbReq + 24] Shl 16) Or MemW[0:VbReq + 26]
  Else VbVer := 0;
  VbSti(F);
  KLog('VirtualBox : VMMDev en ' + HexStr(VbPort, 4) + 'h (IRQ ' +
       IntStr(VbIrq) + '), hote ' + IntStr(VbVer Shr 16) + '.' +
       IntStr(VbVer And $FFFF) + ', carte VBoxVGA ' + IntStr(Ord(VbGfx)));
  VbMouseUpdate;
End;

{ ==================================================================== }
{ Partie 19 - VMware Workstation : backdoor, souris vmmouse, carte      }
{             SVGA II et canal RPC des VMware Tools                     }
{ ==================================================================== }

{ Sous VMware, une instruction IN sur le port 5658h avec EAX = 564D5868h
  ("VMXh") est une "backdoor" traitee par l'hyperviseur (ECX = commande).
  Pasdows s'en sert pour :
    - la souris absolue (vmmouse, commandes 39 a 41) : la souris PS/2
      ne fait plus que signaler les evenements, lus dans la file de la
      backdoor par paquets de 4 mots (boutons, X et Y de 0 a FFFFh,
      molette) ;
    - le canal RPC des VMware Tools (commande 30) : le canal TCLO recoit
      les commandes de l'hote ("reset", "ping", "Capabilities_Register",
      "Resolution_Set largeur hauteur" : ajustement de l'ecran a la
      fenetre de VMware) et le canal RPCI annonce la version des Tools et
      leurs capacites (resolution_set, resolution_server toolbox).
  La carte VMware SVGA II (PCI 15AD:0405) remplace le mode VESA : ports
  d'index et de valeur (BAR0), memoire d'image (BAR1, en 32 bits par
  point) et FIFO de commandes (BAR2) : UPDATE pour chaque zone modifiee
  de l'ecran, DEFINE_CURSOR pour le pointeur, dessine par l'hote (un seul
  pointeur), modes de taille quelconque sans redemarrer. }

Const
  BdMagic = $564D5868;
  BdPort = $5658;
  SvIdx = 0; SvVal = 1;
  SvCapCursor = $20;

Var
  BdA, BdB, BdC, BdD, BdSi, BdDi : LongInt;
  VwVer, VwType : LongInt;
  { canal RPC }
  RpcCh, RpcC1, RpcC2 : LongInt;
  RpcBuf : LongInt;
  RpcLen : LongInt;
  TcCh, TcC1, TcC2 : LongInt;      { canal TCLO ouvert (TcCh >= 0) }
  TcReply : String;
  TcNext, TcFails : LongInt;
  TcCapsDone : Boolean;
  { SVGA }
  SvFifo, SvFifoSz, SvMaxW, SvMaxH, SvCurSum : LongInt;
  SvDL, SvDT, SvDR, SvDB : LongInt;  { zone a mettre a jour }
  VmmNext : LongInt;

{ Appel de la backdoor avec BdB..BdDi ; resultats dans Bd* }
Procedure BdCall;
Var A, B, C, D, S, I : LongInt;
Begin
  B := BdB; C := BdC; D := BdD; S := BdSi; I := BdDi;
  asm
    push ebx
    push esi
    push edi
    push ebp
    mov eax,564D5868h
    mov ebx,B
    mov ecx,C
    mov edx,D
    mov esi,S
    mov edi,I
    push ebp
    in eax,dx
    pop ebp
    mov A,eax
    mov B,ebx
    mov C,ecx
    mov D,edx
    mov S,esi
    mov I,edi
    pop ebp
    pop edi
    pop esi
    pop ebx
  end;
  BdA := A; BdB := B; BdC := C; BdD := D; BdSi := S; BdDi := I;
End;

Procedure BdCmd(Cmd, B : LongInt);
Begin
  BdB := B; BdC := Cmd; BdD := BdPort; BdSi := 0; BdDi := 0;
  BdCall;
End;

{ VMware (ou un hyperviseur qui imite sa backdoor, comme QEMU) }
Function VwDetect : Boolean;
Begin
  BdCmd(10, -1);
  VwDetect := BdB = BdMagic;
  VwVer := BdA; VwType := BdC;
End;

{ ------------------------------------------------------------------ }
{ Souris vmmouse                                                       }
{ ------------------------------------------------------------------ }

Function VmmInit : Boolean;
Begin
  VmmInit := False;
  BdCmd(41, $45414552);                          { activer, lire l'ID }
  BdCmd(40, 0);
  If ((BdA And LongInt($FFFF0000)) = LongInt($FFFF0000)) Or
     ((BdA And $FFFF) < 1) Then Exit;
  BdCmd(39, 1);
  If BdA <> $3442554A Then Exit;
  BdCmd(41, $53424152);                          { absolue }
  VmmInit := True;
End;

{ Mots en attente dans la file (-1 : souris coupee par l'hote, retour a
  la souris PS/2) }
Function VmmCount : LongInt;
Begin
  BdCmd(40, 0);
  If (BdA And LongInt($FFFF0000)) = LongInt($FFFF0000) Then
  Begin
    KLog('VMware : souris absolue coupee, retour a la souris PS/2');
    VmmOn := False;
    VmmCount := -1;
    Exit;
  End;
  VmmCount := BdA And $FFFF;
End;

{ Un paquet de 4 mots : boutons, X, Y (absolus de 0 a FFFFh, ou
  deplacement si le bit 16 des boutons est mis), molette }
Procedure VmmPacket(Var X, Y, Btn : LongInt);
Var F : LongInt;
Begin
  BdCmd(39, 4);
  F := BdA;
  If (F And $10000) <> 0 Then
  Begin
    X := X + BdB; Y := Y + BdC;
  End
  Else
  Begin
    X := ((BdB And $FFFF) * ScrW) Shr 16;
    Y := ((BdC And $FFFF) * ScrH) Shr 16;
  End;
  If X < 0 Then X := 0;
  If Y < 0 Then Y := 0;
  If X > ScrW - 1 Then X := ScrW - 1;
  If Y > ScrH - 1 Then Y := ScrH - 1;
  Btn := 0;
  If (F And $20) <> 0 Then Btn := Btn Or 1;
  If (F And $10) <> 0 Then Btn := Btn Or 2;
  If (F And $08) <> 0 Then Btn := Btn Or 4;
End;

{ ------------------------------------------------------------------ }
{ Canal RPC (GuestRPC) : ouvrir, envoyer, recevoir                     }
{ ------------------------------------------------------------------ }

Function RpcOpen(Proto : LongInt; Var Ch, C1, C2 : LongInt) : Boolean;
Begin
  RpcOpen := False;
  BdB := Proto Or LongInt($80000000); BdC := 30; BdD := BdPort;
  BdSi := 0; BdDi := 0;
  BdCall;
  If ((BdC Shr 16) And 1) = 0 Then Exit;
  Ch := (BdD Shr 16) And $FFFF; C1 := BdSi; C2 := BdDi;
  RpcOpen := True;
End;

Procedure RpcSet(Ch, C1, C2, Sub, B : LongInt);
Begin
  BdB := B; BdC := 30 Or (Sub Shl 16); BdD := BdPort Or (Ch Shl 16);
  BdSi := C1; BdDi := C2;
  BdCall;
End;

Procedure RpcClose(Ch, C1, C2 : LongInt);
Begin
  RpcSet(Ch, C1, C2, 6, 0);
End;

Function RpcSend(Ch, C1, C2 : LongInt; Const S : String) : Boolean;
Var I, K, V : LongInt;
Begin
  RpcSend := False;
  RpcSet(Ch, C1, C2, 1, Length(S));
  If ((BdC Shr 16) And 1) = 0 Then Exit;
  I := 1;
  While I <= Length(S) Do
  Begin
    V := 0;
    For K := 0 To 3 Do
      If I + K <= Length(S) Then V := V Or (Ord(S[I + K]) Shl (K * 8));
    RpcSet(Ch, C1, C2, 2, V);
    If ((BdC Shr 16) And 1) = 0 Then Exit;
    I := I + 4;
  End;
  RpcSend := True;
End;

{ Message recu dans RpcBuf (RpcLen octets, 1 Ko au plus garde) ; False
  si le canal est en erreur }
Function RpcRecv(Ch, C1, C2 : LongInt) : Boolean;
Var N, I, K : LongInt;
Begin
  RpcRecv := False;
  RpcLen := 0;
  RpcSet(Ch, C1, C2, 3, 0);
  If ((BdC Shr 16) And 1) = 0 Then Exit;
  RpcRecv := True;
  If ((BdC Shr 16) And 2) = 0 Then Exit;         { rien a lire }
  N := BdB;
  I := 0;
  While I < N Do
  Begin
    RpcSet(Ch, C1, C2, 4, 1);
    If ((BdC Shr 16) And 1) = 0 Then
    Begin
      RpcRecv := False;
      Exit;
    End;
    For K := 0 To 3 Do
      If (I + K < N) And (I + K < 1024) Then
        Mem[0:RpcBuf + I + K] := (BdB Shr (K * 8)) And $FF;
    I := I + 4;
  End;
  If N > 1024 Then RpcLen := 1024 Else RpcLen := N;
  RpcSet(Ch, C1, C2, 5, 1);
End;

Function RpcStr : String;
Var S : String; I : LongInt;
Begin
  S := '';
  For I := 0 To Min(RpcLen, 255) - 1 Do S := S + Chr(Mem[0:RpcBuf + I]);
  RpcStr := S;
End;

{ Commande RPCI (vers l'hote) ; reponse dans RpcStr ("1 ..." : succes) }
Function RpciCmd(Const S : String) : Boolean;
Var Ch, C1, C2 : LongInt;
Begin
  RpciCmd := False;
  If Not RpcOpen($49435052, Ch, C1, C2) Then Exit;
  If RpcSend(Ch, C1, C2, S) Then
    If RpcRecv(Ch, C1, C2) Then
      RpciCmd := (RpcLen > 0) And (Mem[0:RpcBuf] = Ord('1'));
  RpcClose(Ch, C1, C2);
End;

{ Capacites des Tools de Pasdows : changement de resolution }
Procedure VwCaps;
Begin
  RpciCmd('tools.set.version 2147483647');
  RpciCmd('tools.capability.resolution_set 1');
  RpciCmd('tools.capability.resolution_server toolbox 1');
  RpciCmd('tools.capability.resolution_min 640 480');
  TcCapsDone := True;
End;

{ "Resolution_Set L H" : nouvelle taille de l'ecran }
Function VwResolution(S : String) : String;
Var P, W, H, E : LongInt; A : String;
Begin
  VwResolution := 'ERROR Invalid arguments';
  S := Trim(S);
  P := Pos(' ', S);
  If P = 0 Then Exit;
  A := Copy(S, 1, P - 1); Delete(S, 1, P);
  Val(A, W, E);
  If E <> 0 Then Exit;
  Val(Trim(S), H, E);
  If E <> 0 Then Exit;
  If W < 640 Then W := 640;
  If H < 480 Then H := 480;
  KLog('VMware : resolution demandee ' + IntStr(W) + 'x' + IntStr(H));
  VwResolution := 'OK ';
  If (W = ScrW) And (H = ScrH) Then Exit;
  If Not KSetModeWH(W, H, 32) Then
  Begin
    KLog('VMware : resolution refusee');
    VwResolution := 'ERROR Resolution not supported';
  End;
End;

{ Canal TCLO : envoyer la reponse precedente, lire et traiter les
  commandes de l'hote ; scrute depuis ProcessInput }
Procedure VwTcloPoll;
Var Cmd : String; N : LongInt;
Begin
  If RpcBuf = 0 Then Exit;
  If Ticks - TcNext < 0 Then Exit;
  TcNext := Ticks + 100;
  If TcCh < 0 Then
  Begin
    If TcFails > 5 Then Exit;
    If Not RpcOpen($4F4C4354, TcCh, TcC1, TcC2) Then
    Begin
      TcCh := -1;
      Inc(TcFails);
      TcNext := Ticks + 2000;
      Exit;
    End;
    TcReply := '';
    KLog('VMware : canal TCLO des Tools ouvert');
  End;
  N := 0;
  Repeat
    If Not RpcSend(TcCh, TcC1, TcC2, TcReply) Or
       Not RpcRecv(TcCh, TcC1, TcC2) Then
    Begin
      RpcClose(TcCh, TcC1, TcC2);
      TcCh := -1;
      Exit;
    End;
    TcReply := '';
    If RpcLen = 0 Then Break;
    Cmd := RpcStr;
    If Cmd = 'reset' Then TcReply := 'OK ATR toolbox'
    Else If Cmd = 'ping' Then TcReply := 'OK '
    Else If Copy(Cmd, 1, 21) = 'Capabilities_Register' Then
    Begin
      VwCaps;
      TcReply := 'OK ';
    End
    Else If Copy(Cmd, 1, 15) = 'Resolution_Set ' Then
      TcReply := VwResolution(Copy(Cmd, 16, 255))
    Else If (Copy(Cmd, 1, 11) = 'Set_Option ') Or
            (Copy(Cmd, 1, 16) = 'Time_Synchronize') Or
            (Copy(Cmd, 1, 21) = 'vmx.capability.unified') Then
      TcReply := 'OK '
    Else TcReply := 'ERROR Unknown command';
    Inc(N);
  Until N >= 8;
End;

{ ------------------------------------------------------------------ }
{ Carte VMware SVGA II                                                 }
{ ------------------------------------------------------------------ }

Function SvR(I : LongInt) : LongInt;
Var P, V : LongInt;
Begin
  P := SvPort;
  asm
    mov edx,P
    mov eax,I
    out dx,eax
    inc edx
    in eax,dx
    mov V,eax
  end;
  SvR := V;
End;

Procedure SvW(I, V : LongInt);
Var P : LongInt;
Begin
  P := SvPort;
  asm
    mov edx,P
    mov eax,I
    out dx,eax
    inc edx
    mov eax,V
    out dx,eax
  end;
End;

{ Un mot dans la FIFO (attente de l'hote si elle est pleine) }
Procedure SvPut(V : LongInt);
Var Nx, N : LongInt;
Begin
  Nx := MemL[0:SvFifo + 8];
  If (Nx + 4 = MemL[0:SvFifo + 12]) Or
     ((Nx = MemL[0:SvFifo + 4] - 4) And
      (MemL[0:SvFifo + 12] = MemL[0:SvFifo])) Then
  Begin
    SvW(21, 1);                                  { SYNC }
    N := 0;
    While (SvR(22) <> 0) And (N < 1000000) Do Inc(N);
  End;
  MemL[0:SvFifo + Nx] := V;
  If Nx = MemL[0:SvFifo + 4] - 4 Then Nx := MemL[0:SvFifo]
  Else Nx := Nx + 4;
  MemL[0:SvFifo + 8] := Nx;
End;

{ Zone de l'ecran a envoyer a l'hote (UPDATE) }
Procedure SvAdd(L, T, R, B : LongInt);
Begin
  If Not SvOn Then Exit;
  If L < 0 Then L := 0;
  If T < 0 Then T := 0;
  If R > ScrW Then R := ScrW;
  If B > ScrH Then B := ScrH;
  If (L >= R) Or (T >= B) Then Exit;
  If SvDR <= SvDL Then
  Begin
    SvDL := L; SvDT := T; SvDR := R; SvDB := B;
  End
  Else
  Begin
    If L < SvDL Then SvDL := L;
    If T < SvDT Then SvDT := T;
    If R > SvDR Then SvDR := R;
    If B > SvDB Then SvDB := B;
  End;
End;

Procedure SvFlush;
Begin
  If Not SvOn Or (SvDR <= SvDL) Then Exit;
  SvPut(1);                                      { UPDATE }
  SvPut(SvDL); SvPut(SvDT); SvPut(SvDR - SvDL); SvPut(SvDB - SvDT);
  SvDL := 0; SvDR := 0;
End;

{ Mode W x H en 32 bits ; memoire d'image, pas et composantes }
Function SvSetMode(W, H : LongInt) : Boolean;
Var Rm, Gm, Bm : LongInt;
Begin
  SvSetMode := False;
  If (W > SvMaxW) Or (H > SvMaxH) Then Exit;
  SvW(2, W); SvW(3, H); SvW(7, 32);
  SvW(1, 1);                                     { ENABLE }
  If (SvR(2) <> W) Or (SvR(3) <> H) Then Exit;
  SvFb := SvR(13) + SvR(14);
  SvSetMode := True;
End;

{ Composantes du mode SVGA (masques -> tailles et positions) }
Procedure SvMasks(A : LongInt);
Var I, M, S, N : LongInt;
Begin
  For I := 0 To 2 Do
  Begin
    M := SvR(9 + I);
    S := 0; N := 0;
    If M = 0 Then
      Case I Of
        0 : M := $FF0000;
        1 : M := $FF00;
      Else
        M := $FF;
      End;
    While (S < 32) And ((M And (1 Shl S)) = 0) Do Inc(S);
    While (S + N < 32) And ((M And (1 Shl (S + N))) <> 0) Do Inc(N);
    Mem[0:A + I * 2] := N; Mem[0:A + I * 2 + 1] := S;
  End;
End;

{ Pointeur : forme (DEFINE_CURSOR, masques de 1 bit) si elle a change,
  position et visibilite }
Procedure SvPtrSync;
Var Sum, X, Y, V, W, H, Wd, A, Xr : LongInt; Vis : Boolean;
Begin
  If Not SvHwPtr Then Exit;
  W := CurW; H := CurHh;
  If W > 32 Then W := 32;
  If H > 32 Then H := 32;
  Sum := 0; Vis := False;
  For Y := 0 To H - 1 Do
    For X := 0 To W - 1 Do
    Begin
      V := CurMap[Y * 32 + X];
      If V <> 0 Then Vis := True;
      Sum := (Sum * 31 + V + X * 3 + Y) And $FFFFFF;
    End;
  If CurHide < 0 Then Vis := False;
  Sum := (Sum * 7 + W * 131 + H * 17 + CurHotX * 5 + CurHotY) And
         $3FFFFFFF;
  If Vis And (Sum <> SvCurSum) Then
  Begin
    SvCurSum := Sum;
    SvPut(19);                                   { DEFINE_CURSOR }
    SvPut(1); SvPut(CurHotX); SvPut(CurHotY); SvPut(W); SvPut(H);
    SvPut(1); SvPut(1);                          { masques de 1 bit }
    For Wd := 0 To 1 Do
      For Y := 0 To H - 1 Do
      Begin
        A := 0;
        For X := 0 To W - 1 Do
        Begin
          V := CurMap[Y * 32 + X];
          If Wd = 0 Then Xr := Ord((V = 0) Or (V = 3))     { ET }
          Else Xr := Ord((V = 2) Or (V = 3));              { OU exclusif }
          If Xr <> 0 Then
            A := A Or (1 Shl ((X And Not 7) + 7 - (X And 7)));
        End;
        SvPut(A);
      End;
    SvW(21, 1);
  End;
  SvW(24, 1);
  SvW(25, CurX); SvW(26, CurY);
  SvW(27, Ord(Vis));
End;

{ Prendre la main sur l'ecran : mode SVGA de meme taille en 32 bits }
Procedure SvInit;
Var Bus, Dev, Id, Bar, Cmd, K : LongInt; Z : Array[0..5] Of Byte;
Begin
  SvOn := False; SvHwPtr := False; SvPort := 0; SvCurSum := -1;
  SvDL := 0; SvDR := 0;
  For Bus := 0 To 3 Do
    For Dev := 0 To 31 Do
      If SvPort = 0 Then
      Begin
        Id := PciRead(Bus, Dev, 0, 0);
        If Id = $040515AD Then
        Begin
          Bar := PciRead(Bus, Dev, 0, $10);
          If (Bar And 1) <> 0 Then
          Begin
            Cmd := PciRead(Bus, Dev, 0, 4);
            PciWrite(Bus, Dev, 0, 4, (Cmd And $FFFF) Or 7);
            SvPort := Bar And $FFFC;
          End;
        End;
      End;
  If SvPort = 0 Then Exit;
  SvW(0, LongInt($90000002));                    { SVGA_ID_2 }
  If SvR(0) <> LongInt($90000002) Then
  Begin
    KLog('VMware : carte SVGA sans interface SVGA_ID_2');
    SvPort := 0;
    Exit;
  End;
  If VgaPlanar Or (ScrBpp < 8) Then
  Begin
    KLog('VMware : carte SVGA II laissee en VGA 16 couleurs');
    Exit;
  End;
  SvCaps := SvR(17);
  SvMaxW := SvR(4); SvMaxH := SvR(5);
  If SvMaxW <= 0 Then SvMaxW := 1920;
  If SvMaxH <= 0 Then SvMaxH := 1440;
  SvFifo := SvR(18); SvFifoSz := SvR(19);
  If (SvFifo = 0) Or (SvFifoSz < 16384) Then
  Begin
    SvPort := 0;
    Exit;
  End;
  If Not SvSetMode(ScrW, ScrH) Then
  Begin
    KLog('VMware : mode SVGA ' + IntStr(ScrW) + 'x' + IntStr(ScrH) +
         ' refuse');
    SvW(1, 0);
    SvPort := 0;
    Exit;
  End;
  { FIFO : registres MIN, MAX, NEXT_CMD, STOP }
  MemL[0:SvFifo] := 16;
  MemL[0:SvFifo + 4] := SvFifoSz;
  MemL[0:SvFifo + 8] := 16;
  MemL[0:SvFifo + 12] := 16;
  SvW(20, 1);                                    { CONFIG_DONE }
  SvOn := True;
  { le reste du noyau ecrit en 32 bits dans la memoire d'image }
  Lfb := SvFb;
  ScrBpp := 32; ScrBytes := 4;
  LfbPitch := SvR(12);
  SvMasks(LongInt(@Z));
  VideoMasks(LongInt(@Z));
  FillMem(LongInt(@OutPal), SizeOf(OutPal), $FF);
  DacAll;
  OutPalChanged := False;
  { tampon de l'ecran au format de la carte SVGA }
  ScrFmtSet;
  SurfFree(Back);
  SurfNew(Back, ScrW, ScrH);
  SvHwPtr := (SvCaps And SvCapCursor) <> 0;
  SvFull1 := 1; SvFull2 := 2;
  KLog('VMware : carte SVGA II en ' + HexStr(SvPort, 4) + 'h, image ' +
       HexStr(SvFb, 8) + 'h, FIFO ' + HexStr(SvFifo, 8) + 'h (' +
       IntStr(SvFifoSz Div 1024) + ' Ko), maximum ' + IntStr(SvMaxW) + 'x' +
       IntStr(SvMaxH) + ', capacites ' + HexStr(SvCaps, 8) +
       ', pointeur materiel ' + IntStr(Ord(SvHwPtr)));
End;

