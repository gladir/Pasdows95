    Wnds^[W].K1 := Res;
    Wnds^[W].DlgEnded := True;
    ShowW(W, False, False);
    NoteAskEnd(Res);
    Exit;
  End;
  If (W = RebootAskW) And (RebootAskW >= 0) Then
  Begin
    RebootAskW := -1;
    If Res = IDYES Then
    Begin
      Wnds^[W].K1 := Res;
      Wnds^[W].DlgEnded := True;
      ShowW(W, False, False);
      DoShutdown(1);
    End;
  End;
  If (W = FmtAskW) And (FmtAskW >= 0) Then
  Begin
    FmtAskW := -1;
    If Res = IDYES Then FormatDisk0;
  End;
  If (W = DelAskW) And (DelAskW >= 0) Then
  Begin
    DelAskW := -1;
    If Res = IDYES Then CtxDelete;
  End;
  If (W = PasteAskW) And (PasteAskW >= 0) Then
  Begin
    PasteAskW := -1;
    Wnds^[W].K1 := Res;
    Wnds^[W].DlgEnded := True;
    ShowW(W, False, False);
    PasteAnswer(Res);
    Exit;
  End;
  Wnds^[W].K1 := Res;
  Wnds^[W].DlgEnded := True;
  ShowW(W, False, False);
End;

Procedure MsgBoxMouse(W, Msg, X, Y : LongInt);
Var I, X1, Y1, X2, Y2 : LongInt;
Begin
  X := X + Wnds^[W].X + Wnds^[W].CL; Y := Y + Wnds^[W].Y + Wnds^[W].CT;
  For I := 0 To MbCount(Wnds^[W].K2) - 1 Do
  Begin
    MbBtnRect(W, I, X1, Y1, X2, Y2);
    If InRect(X, Y, X1, Y1, X2, Y2) Then
    Begin
      If Msg = WM_LBUTTONDOWN Then
      Begin
        PressWin := W; PressBtn := I;
        CaptureWin := W;
        KRepaint(W);
      End
      Else If (Msg = WM_LBUTTONUP) And (PressWin = W) And (PressBtn = I)
      Then
      Begin
        PressWin := -1; CaptureWin := -1;
        MsgBoxEnd(W, MbId(Wnds^[W].K2, I));
      End;
      Exit;
    End;
  End;
  If Msg = WM_LBUTTONUP Then
  Begin
    If PressWin = W Then
    Begin
      PressWin := -1;
      KRepaint(W);
    End;
    CaptureWin := -1;
  End;
End;

{ Boite de message modale (bloque la tache appelante) }
Function MsgBoxModal(Title, Text : String; Typ : LongInt) : LongInt;
Var W, R : LongInt;
Begin
  W := MsgBoxOpen(Title, Text, Typ);
  If W < 0 Then
  Begin
    MsgBoxModal := IDCANCEL;
    Exit;
  End;
  If CurT = 0 Then
  Begin
    MsgBoxModal := 0;
    Exit;
  End;
  While Not Wnds^[W].DlgEnded Do KYield;
  R := Wnds^[W].K1;
  If W = MbLongW Then
  Begin
    KFree(MbLongP);
    MbLongW := -1; MbLongP := 0;
  End;
  DestroyW(W);
  MsgBoxModal := R;
End;

Function ModalBlocked(T : LongInt) : Boolean;
Var I : LongInt;
Begin
  ModalBlocked := False;
  If (T < 0) Or (Wnds^[T].IKind = ikTaskbar) Or (Wnds^[T].IKind = ikMenu) Then
    Exit;
  For I := 0 To MaxWnd - 1 Do
    If Wnds^[I].Used And Wnds^[I].Visible And (I <> T) And
       ((Wnds^[I].IKind = ikMsgBox) Or (Wnds^[I].IKind = ikShutdown)) Then
    Begin
      ModalBlocked := True;
      Exit;
    End;
End;

{ ------------------------------------------------------------------ }
{ Poste de travail / Explorateur (K1 selection, KS chemin du CD)     }
{ ------------------------------------------------------------------ }

Procedure NoteOpen(Path : String); Forward;

Function ExpDirLba(W : LongInt; Var Lba, Size : LongInt) : Boolean;
Var Fl, Tm : LongInt;
Begin
  ExpDirLba := IsoLookup(Copy(Wnds^[W].KS, 3, 255), Lba, Size, Fl, Tm);
End;

Var
  ExpCW, ExpCI, ExpCIdx : LongInt;      { parcours FAT en cours }
  ExpCS : String[127];
  ExpCtxW, ExpCtxI : LongInt;           { lecteur du menu contextuel }
  TreeCtxP : String[79];                { noeud du menu de l'arbre }

{ Lettre du lecteur I de la liste du Poste de travail }
{ Volume de l'element I (>= 2) du Poste de travail : les volumes apres
  C: qui ont une lettre (un lecteur reseau deconnecte n'en a plus) ;
  -1 au-dela (Panneau de configuration) }
Function ExpVolAt(I : LongInt) : LongInt;
Var V : LongInt;
Begin
  ExpVolAt := -1;
  I := I - 2;
  For V := 1 To VolN - 1 Do
    If VolLetter[V] >= 65 Then
    Begin
      If I = 0 Then
      Begin
        ExpVolAt := V;
        Exit;
      End;
      Dec(I);
    End;
End;

Function CplName : String;
Begin
  CplName := L('Panneau de configuration', 'Control Panel',
               'Systemsteuerung', 'Pannello di controllo', 'Panel de control');
End;

Function ExpDrive(I : LongInt) : Char;
Begin
  If I <= 0 Then ExpDrive := 'C'
  Else If I = 1 Then ExpDrive := 'D'
  Else If ExpVolAt(I) >= 0 Then ExpDrive := Chr(VolLetter[ExpVolAt(I)])
  Else ExpDrive := #0;
End;

{ Espace libre et capacite d'un lecteur, en secteurs de 512 octets }
Function VolSpaceSecs(D : Char; Var FreeS, TotS : LongInt) : Boolean;
Var V, Fr, Tot, Spc : LongInt;
Begin
  FreeS := 0; TotS := 0;
  V := FatVolOf(D + ':');
  If V >= 0 Then
  Begin
    FatSpace(V, Fr, Tot, Spc);
    FreeS := Fr * Spc; TotS := Tot * Spc;
  End
  Else If D = 'C' Then
  Begin
    { disque virtuel en memoire }
    FreeS := HeapFreeBytes Div 512; TotS := MemTop Div 512;
  End
  Else If D = 'D' Then TotS := CdVolBlocks * 4;
  If FreeS > TotS Then FreeS := TotS;
  VolSpaceSecs := TotS > 0;
End;

{ Taille courte : Ko, Mo ou Go (deux decimales) }
Function SizeShort(Secs : LongInt) : String;
Var G : LongInt; S : String;
Begin
  If Secs < 2048 Then
    S := IntStr(Secs Div 2) + L(' Ko', ' KB', ' KB', ' KB', ' KB')
  Else If Secs < 2097152 Then
    S := IntStr(Secs Div 2048) + L(' Mo', ' MB', ' MB', ' MB', ' MB')
  Else
  Begin
    G := Round(Secs / 20971.52);
    S := IntStr(G Mod 100);
    If Length(S) < 2 Then S := '0' + S;
    S := IntStr(G Div 100) + L(',', '.', ',', ',', ',') + S +
         L(' Go', ' GB', ' GB', ' GB', ' GB');
  End;
  SizeShort := S;
End;

{ Nombre d'octets de Secs secteurs, avec separateur des milliers (au-dela
  de 2 Go : calcul en deux parties de six chiffres) }
Function BytesStr(Secs : LongInt) : String;
Var A, Lo, Hi, I : LongInt; R, T, Sep : String;
Begin
  A := Secs Div 1000000;
  Lo := (Secs Mod 1000000) * 512;
  Hi := A * 512 + Lo Div 1000000;
  Lo := Lo Mod 1000000;
  If Hi > 0 Then
  Begin
    T := IntStr(Lo);
    While Length(T) < 6 Do T := '0' + T;
    R := IntStr(Hi) + T;
  End
  Else R := IntStr(Lo);
  Sep := L(' ', ',', '.', '.', '.');
  T := '';
  For I := 1 To Length(R) Do
  Begin
    T := T + R[I];
    If ((Length(R) - I) Mod 3 = 0) And (I < Length(R)) Then T := T + Sep;
  End;
  BytesStr := T + L(' octets', ' bytes', ' Byte', ' byte', ' bytes');
End;

{ Entree I du dossier Path ('' : les lecteurs du Poste de travail) }
Function ExpEntryP(Const Path : String; I : LongInt; Var Nm : String;
                   Var Fl, Size : LongInt) : Boolean;
Var DL, DS, Lba, Tm, V, Idx, K : LongInt; Ok : Boolean;
Begin
  ExpEntryP := False;
  If Path = '' Then
  Begin
    { lecteurs : C:, D: (CD-ROM), puis les autres volumes FAT }
    Fl := 2; Size := 0;
    If I = 0 Then
    Begin
      If VolN > 0 Then Nm := Trim(VolLab^[0] + ' (C:)') Else Nm := '(C:)';
      ExpEntryP := True;
    End
    Else If I = 1 Then
    Begin
      Nm := VolLabel + ' (D:)'; ExpEntryP := True;
    End
    Else If ExpVolAt(I) >= 0 Then
    Begin
      V := ExpVolAt(I);
      If VolType[V] = NetT Then Nm := NdLabel(V)
      Else Nm := Trim(VolLab^[V] + ' (' + Chr(VolLetter[V]) + ':)');
      ExpEntryP := True;
    End
    Else If (I = 2) Or (ExpVolAt(I - 1) >= 0) Then
    Begin
      { apres les lecteurs, comme Windows 95 }
      Nm := CplName; Fl := 0;
      ExpEntryP := True;
    End;
    Exit;
  End;
  If FatVolOf(Path) >= 0 Then
  Begin
    { volume FAT : reprendre le parcours precedent si possible }
    If (ExpCW = 1) And (ExpCS = Path) And (ExpCI < I) Then
    Begin
      K := ExpCI; Idx := ExpCIdx;
    End
    Else
    Begin
      K := -1; Idx := 0;
    End;
    Ok := True;
    While Ok And (K < I) Do
    Begin
      Ok := FatDirEntry(Path, 0, Idx);
      Inc(K);
    End;
    If Not Ok Then
    Begin
      ExpCW := -1;
      Exit;
    End;
    ExpCW := 1; ExpCS := Path; ExpCI := I; ExpCIdx := Idx;
    Nm := FfName; Size := FfSize;
    If (FfAttr And $10) <> 0 Then Fl := 2 Else Fl := 0;
    ExpEntryP := True;
    Exit;
  End;
  If Not IsoLookup(Copy(Path, 3, 255), DL, DS, Fl, Tm) Then Exit;
  ExpEntryP := IsoDirEntry(DL, DS, I, Nm, Lba, Size, Fl, Tm);
End;

Function ExpEntry(W, I : LongInt; Var Nm : String; Var Fl, Size : LongInt)
  : Boolean;
Begin
  ExpEntry := ExpEntryP(Wnds^[W].KS, I, Nm, Fl, Size);
End;

{ Selection multiple de l'Explorateur (Ctrl+clic, Maj+clic,
  Selectionner tout) : une fenetre et un dossier a la fois (ExpSelW,
  ExpSelD, ExpSelB) ; sinon l'element K1 seul. K1 est aussi l'element
  courant (point de depart de Maj+clic). }
Function ExpMulti(W : LongInt) : Boolean;
Begin
  ExpMulti := (W >= 0) And (ExpSelW = W) And (ExpSelD = Wnds^[W].KS);
End;

Function ExpIsSel(W, I : LongInt) : Boolean;
Begin
  If (I < 0) Or (I >= 4096) Then ExpIsSel := False
  Else If ExpMulti(W) Then
    ExpIsSel := (ExpSelB[I Shr 3] And (1 Shl (I And 7))) <> 0
  Else ExpIsSel := I = Wnds^[W].K1;
End;

Procedure ExpSelSet(W, I : LongInt; On : Boolean);
Var K : LongInt;
Begin
  If Not ExpMulti(W) Then
  Begin
    FillMem(LongInt(@ExpSelB), 512, 0);
    ExpSelW := W; ExpSelD := Wnds^[W].KS;
    K := Wnds^[W].K1;
    If (K >= 0) And (K < 4096) Then
      ExpSelB[K Shr 3] := ExpSelB[K Shr 3] Or (1 Shl (K And 7));
  End;
  If (I < 0) Or (I >= 4096) Then Exit;
  If On Then ExpSelB[I Shr 3] := ExpSelB[I Shr 3] Or (1 Shl (I And 7))
  Else ExpSelB[I Shr 3] := ExpSelB[I Shr 3] And ($FF Xor (1 Shl (I And 7)));
End;

{ Tous les elements du dossier choisis (Selectionner tout, Ctrl+A) }
Procedure ExpSelectAll(W : LongInt);
Var I, Fl, Sz : LongInt; Nm : String;
Begin
  If Wnds^[W].KS = '' Then Exit;
  FillMem(LongInt(@ExpSelB), 512, 0);
  ExpSelW := W; ExpSelD := Wnds^[W].KS;
  I := 0;
  While (I < 4096) And ExpEntry(W, I, Nm, Fl, Sz) Do
  Begin
    ExpSelB[I Shr 3] := ExpSelB[I Shr 3] Or (1 Shl (I And 7));
    Inc(I);
  End;
  If (Wnds^[W].K1 < 0) And (I > 0) Then Wnds^[W].K1 := 0;
  KRepaint(W);
End;

{ Elements choisis de l'Explorateur W : chemins dans OpP^ (OpN) }
Procedure ExpGather(W : LongInt);
Var I, Fl, Sz : LongInt; Nm : String;
Begin
  OpN := 0;
  If Wnds^[W].KS = '' Then Exit;
  I := 0;
  While (OpN < MaxOp) And ExpEntry(W, I, Nm, Fl, Sz) Do
  Begin
    If ExpIsSel(W, I) Then
    Begin
      OpP^[OpN] := Wnds^[W].KS + '\' + Nm;
      Inc(OpN);
    End;
    Inc(I);
  End;
End;

{ Icone d'un programme du systeme (nom du fichier .EXE) }
