{ Ecran : zone modifiee, recopie vers la memoire video, pointeur     }
{ ------------------------------------------------------------------ }

Var
  Dirty   : TRect;
  CurMap  : Array[0..1023] Of Byte;  { 0 transparent 1 noir 2 blanc 3 inv. }
  CurW, CurHh : LongInt;

Procedure ComposeRect(R : TRect); Forward;

Procedure MarkDirty(X1, Y1, X2, Y2 : LongInt);
Var R : TRect;
Begin
  SetR(R, Max(X1, 0), Max(Y1, 0), Min(X2, ScrW), Min(Y2, ScrH));
  RUnion(Dirty, R);
End;

Procedure MarkAll;
Begin
  SetR(Dirty, 0, 0, ScrW, ScrH);
End;

{ N pixels de 256 couleurs (Src) vers la memoire video en couleurs
  directes (Dst), par OutPal, en assembleur }
Procedure ConvRow16(Src, Dst, N : LongInt);
Var T : LongInt;
Begin
  If N <= 0 Then Exit;
  T := LongInt(@OutPal);
  asm
    push esi
    push edi
    push ebx
    mov esi,Src
    mov edi,Dst
    mov ecx,N
    mov ebx,T
  @c16:
    movzx eax,byte ptr [esi]
    inc esi
    shl eax,2
    add eax,ebx
    mov eax,[eax]
    mov [edi],ax
    add edi,2
    dec ecx
    jnz @c16
    pop ebx
    pop edi
    pop esi
  end;
End;

Procedure ConvRow24(Src, Dst, N : LongInt);
Var T : LongInt;
Begin
  If N <= 0 Then Exit;
  T := LongInt(@OutPal);
  asm
    push esi
    push edi
    push ebx
    mov esi,Src
    mov edi,Dst
    mov ecx,N
    mov ebx,T
  @c24:
    movzx eax,byte ptr [esi]
    inc esi
    shl eax,2
    add eax,ebx
    mov eax,[eax]
    mov [edi],ax
    shr eax,16
    mov [edi+2],al
    add edi,3
    dec ecx
    jnz @c24
    pop ebx
    pop edi
    pop esi
  end;
End;

Procedure ConvRow32(Src, Dst, N : LongInt);
Var T : LongInt;
Begin
  If N <= 0 Then Exit;
  T := LongInt(@OutPal);
  asm
    push esi
    push edi
    push ebx
    mov esi,Src
    mov edi,Dst
    mov ecx,N
    mov ebx,T
  @c32:
    movzx eax,byte ptr [esi]
    inc esi
    shl eax,2
    add eax,ebx
    mov eax,[eax]
    mov [edi],eax
    add edi,4
    dec ecx
    jnz @c32
    pop ebx
    pop edi
    pop esi
  end;
End;

{ Ligne de N pixels (indices) vers l'adresse D de la memoire video }
Procedure OutRow(S, D, N : LongInt);
Begin
  Case ScrBpp Of
    15, 16 : ConvRow16(S, D, N);
    24 : ConvRow24(S, D, N);
    32 : ConvRow32(S, D, N);
  Else
    MoveMem(S, D, N);
  End;
End;

{ 00RRGGBB -> valeur de la memoire video (composantes de la carte) }
Function LfbOfX(X : LongInt) : LongInt;
Begin
  LfbOfX := ((((X Shr 16) And 255) Shr (8 - RMs)) Shl RPs) Or
            ((((X Shr 8) And 255) Shr (8 - GMs)) Shl GPs) Or
            (((X And 255) Shr (8 - BMs)) Shl BPs);
End;

{ Ligne de N points du tampon compose en couleurs vraies (S, format
  ScrFmt) vers la memoire video : copie directe quand le format est
  celui de la carte, conversion depuis 32 bits sinon }
Procedure OutRowTC(S, D, N : LongInt);
Var I, V : LongInt;
Begin
  If ScrDirect Then
  Begin
    MoveMem(S, D, N * PxBytes(ScrFmt));
    Exit;
  End;
  For I := 0 To N - 1 Do
  Begin
    V := LfbOfX(MemL[0:S + I * 4]);
    Case ScrBytes Of
      2 : MemW[0:D + I * 2] := V;
      3 :
      Begin
        MemW[0:D + I * 3] := V;
        Mem[0:D + I * 3 + 2] := V Shr 16;
      End;
    Else
      MemL[0:D + I * 4] := V;
    End;
  End;
End;

{ Valeur brute V (format de la carte) en (X, Y) de la memoire video }
Procedure OutRaw(X, Y, V : LongInt);
Var A : LongInt;
Begin
  A := Lfb + Y * LfbPitch + X * ScrBytes;
  Case ScrBytes Of
    2 : MemW[0:A] := V;
    3 :
    Begin
      MemW[0:A] := V;
      Mem[0:A + 2] := V Shr 16;
    End;
    4 : MemL[0:A] := V;
  Else
    Mem[0:A] := V;
  End;
End;

{ Un pixel d'indice C en (X, Y) de la memoire video }
Procedure OutPix(X, Y, C : LongInt);
Var A, V : LongInt;
Begin
  A := Lfb + Y * LfbPitch + X * ScrBytes;
  If ScrBpp <= 8 Then
  Begin
    Mem[0:A] := C;
    Exit;
  End;
  V := OutPal[C And 255];
  Case ScrBytes Of
    2 : MemW[0:A] := V;
    3 :
    Begin
      MemW[0:A] := V;
      Mem[0:A + 2] := V Shr 16;
    End;
  Else
    MemL[0:A] := V;
  End;
End;

Procedure DXPresent; Forward;
Procedure DXScrRows(Y0, Y1 : LongInt); Forward;

{ Recopier une zone du tampon dans la memoire video }
Procedure LfbCopy(R : TRect);
Var Y, S, D, N : LongInt;
Begin
  If DDShow And DXOn Then
  Begin
    DXScrRows(R.T, R.B);
    Exit;
  End;
  If R.L < 0 Then R.L := 0;
  If R.T < 0 Then R.T := 0;
  If R.R > ScrW Then R.R := ScrW;
  If R.B > ScrH Then R.B := ScrH;
  If (R.L >= R.R) Or (R.T >= R.B) Then Exit;
  If VgaPlanar Then
  Begin
    For Y := R.T To R.B - 1 Do
      VgaWriteRow(Y, R.L Shr 3, (R.R - 1) Shr 3,
                  Back.Bits + Y * Back.Pitch + (R.L And Not 7));
    Exit;
  End;
  N := R.R - R.L;
  S := Back.Bits + R.T * Back.Pitch + R.L * PxBytes(Back.Bpp);
  D := Lfb + R.T * LfbPitch + R.L * ScrBytes;
  For Y := R.T To R.B - 1 Do
  Begin
    If Back.Bpp = 8 Then OutRow(S, D, N) Else OutRowTC(S, D, N);
    S := S + Back.Pitch;
    D := D + LfbPitch;
  End;
  If SvOn Then SvAdd(R.L, R.T, R.R, R.B);
End;

{ VirtualBox (partie 18) : VMMDev present, souris absolue, pointeur
  dessine par l'hote }
Var
  VbPort  : LongInt;
  VbIrq, VbMmio : LongInt;
  VbAbs   : Boolean;
  VbHwPtr : Boolean;
  VbGfx   : Boolean;                 { carte VBoxVGA (80EE:BEEF) }
  { VMware (partie 19) : backdoor, souris absolue, carte SVGA II }
  VwOn, VwReal, VmmOn : Boolean;
  SvOn, SvHwPtr : Boolean;
  SvPort, SvCaps, SvFb : LongInt;
  SvFull1, SvFull2 : LongInt;          { mises a jour completes prevues }

Procedure VbPtrSync; Forward;
Procedure SvPtrSync; Forward;
Procedure SvAdd(L, T, R, B : LongInt); Forward;
Procedure SvFlush; Forward;
Function VbMousePos(Var X, Y : LongInt) : Boolean; Forward;
Procedure VbPoll; Forward;

{ Forme du pointeur : fleche (0), sablier (1) }
Procedure CursorSetShape(K : LongInt);
Var R, I : LongInt; Ch : Char;
Begin
  FillMem(LongInt(@CurMap), 1024, 0);
  For R := 0 To CurH - 1 Do
    For I := 1 To 12 Do
    Begin
      If K = 1 Then Ch := WaitShape[R][I] Else Ch := CurShape[R][I];
      If Ch = 'X' Then CurMap[R * 32 + I - 1] := 1
      Else If Ch = 'W' Then CurMap[R * 32 + I - 1] := 2;
    End;
  CurW := 12; CurHh := CurH;
  If K = 1 Then
  Begin
    CurHotX := 5; CurHotY := 9;
  End
  Else
  Begin
    CurHotX := 0; CurHotY := 0;
  End;
  CurKind := K;
End;

Procedure CursorRect(Var R : TRect);
Begin
  SetR(R, CurX - CurHotX, CurY - CurHotY, CurX - CurHotX + CurW,
       CurY - CurHotY + CurHh);
End;

{ Pointeur en VGA 16 couleurs : ligne recomposee (fond de Back puis
  pointeur) dans VgaTmp, puis ecrite dans les 4 plans }
Procedure CursorDrawVga;
Var X, Y, PX, PY, V, X0, B0, B1, I : LongInt;
Begin
  X0 := CurX - CurHotX;
  B0 := X0; If B0 < 0 Then B0 := 0;
  B0 := B0 Shr 3;
  B1 := X0 + CurW - 1; If B1 > ScrW - 1 Then B1 := ScrW - 1;
  If B1 < 0 Then Exit;
  B1 := B1 Shr 3;
  For Y := 0 To CurHh - 1 Do
  Begin
    PY := CurY - CurHotY + Y;
    If (PY >= 0) And (PY < ScrH) Then
    Begin
      For I := 0 To (B1 - B0 + 1) * 8 - 1 Do
        VgaTmp[I] := Mem[0:Back.Bits + PY * Back.Pitch + B0 * 8 + I];
      For X := 0 To CurW - 1 Do
      Begin
        PX := X0 + X;
        V := CurMap[Y * 32 + X];
        If (V <> 0) And (PX >= B0 * 8) And (PX < (B1 + 1) * 8) Then
        Begin
          If V = 1 Then VgaTmp[PX - B0 * 8] := cBlack
          Else If V = 2 Then VgaTmp[PX - B0 * 8] := cWhite
          Else VgaTmp[PX - B0 * 8] := VgaTmp[PX - B0 * 8] Xor 255;
        End;
      End;
      VgaWriteRow(PY, B0, B1, LongInt(@VgaTmp));
    End;
  End;
  CurShownB := True;
End;

Procedure CursorDraw;
Var X, Y, PX, PY, V, A : LongInt;
Begin
  If VbHwPtr Or SvHwPtr Then
  Begin
    { VirtualBox ou VMware dessine le pointeur (forme donnee a l'hote) }
    If VbHwPtr Then VbPtrSync Else SvPtrSync;
    CurShownB := False;
    Exit;
  End;
  If CurHide < 0 Then Exit;
  If VgaPlanar Then
  Begin
    CursorDrawVga;
    Exit;
  End;
  For Y := 0 To CurHh - 1 Do
  Begin
    PY := CurY - CurHotY + Y;
    If (PY >= 0) And (PY < ScrH) Then
      For X := 0 To CurW - 1 Do
      Begin
        PX := CurX - CurHotX + X;
        V := CurMap[Y * 32 + X];
        If (V <> 0) And (PX >= 0) And (PX < ScrW) Then
        Begin
          If V = 1 Then OutPix(PX, PY, cBlack)
          Else If V = 2 Then OutPix(PX, PY, cWhite)
          Else If Back.Bpp = 8 Then
            OutPix(PX, PY, Mem[0:Back.Bits + PY * Back.Pitch + PX] Xor 255)
          Else
            OutRaw(PX, PY, LfbOfX(RawToX(GetRaw(Back.Bits + PY * Back.Pitch +
                   PX * PxBytes(Back.Bpp), Back.Bpp), Back.Bpp) Xor $FFFFFF));
        End;
      End;
  End;
  CurShownB := True;
  If SvOn Then
  Begin
    SvAdd(CurX - CurHotX, CurY - CurHotY, CurX - CurHotX + CurW,
          CurY - CurHotY + CurHh);
    SvFlush;
  End;
End;

Procedure CursorErase;
Var R : TRect;
Begin
  If VbHwPtr Then VbPtrSync;
  If SvHwPtr Then SvPtrSync;
  If Not CurShownB Then Exit;
  CursorRect(R);
  LfbCopy(R);
  CurShownB := False;
  If SvOn Then SvFlush;
End;

Procedure CursorMoveTo(X, Y : LongInt);
Begin
  If (X = CurX) And (Y = CurY) And CurShownB Then Exit;
  CursorErase;
  CurX := X; CurY := Y;
  CursorDraw;
End;

{ Composer la zone modifiee et l'afficher }
Procedure FlushScreen0;
Var R, C, I : TRect; Y, X0, Y0, Z : LongInt;
Begin
  { VGA 16 couleurs ou couleurs directes : palette changee, tout l'ecran
    a reconvertir }
  { (en couleurs vraies, l'ecran compose ne depend pas de la palette) }
  If (ScrBpp > 8) And OutPalChanged And (Back.Bpp > 8) And Not DDShow Then
    OutPalChanged := False;
  If (VgaPlanar And VgaMapChanged) Or ((ScrBpp > 8) And OutPalChanged) Then
  Begin
    VgaMapChanged := False;
    OutPalChanged := False;
    If DDShow Then DDDirty := True
    Else If (Dirty.L <= 0) And (Dirty.T <= 0) And (Dirty.R >= ScrW) And
            (Dirty.B >= ScrH) Then
      { tout l'ecran va etre recompose et converti juste apres }
    Else
    Begin
      SetR(R, 0, 0, ScrW, ScrH);
      LfbCopy(R);
      If CurShownB Then CursorDraw;
    End;
  End;
  { DirectDraw en mode exclusif : la surface primaire occupe l'ecran,
    centree sur fond noir quand l'ecran est plus grand que son mode }
  If DDShow And DXOn Then
  Begin
    DXPresent;
    SetR(Dirty, 0, 0, 0, 0);
    Exit;
  End;
  If DDShow Then
  Begin
    X0 := ((ScrW - Min(DDW, ScrW)) Div 2) And Not 7;
    Y0 := (ScrH - Min(DDH, ScrH)) Div 2;
    If Not DDCleared Then
    Begin
      DDCleared := True;
      If (X0 > 0) Or (Y0 > 0) Then
      Begin
        Z := KAlloc(ScrW + 16);
        If Z <> 0 Then
        Begin
          For Y := 0 To ScrH - 1 Do
            If VgaPlanar Then VgaWriteRow(Y, 0, (ScrW - 1) Shr 3, Z)
            Else OutRow(Z, Lfb + Y * LfbPitch, ScrW);
          KFree(Z);
        End;
      End;
    End;
    If DDDirty Then
      For Y := 0 To Min(DDH, ScrH) - 1 Do
        If VgaPlanar Then
          VgaWriteRow(Y0 + Y, X0 Shr 3, (X0 + Min(DDW, ScrW) - 1) Shr 3,
                      DDBuf + Y * DDW)
        Else
          OutRow(DDBuf + Y * DDW, Lfb + (Y0 + Y) * LfbPitch + X0 * ScrBytes,
                 Min(DDW, ScrW));
    DDDirty := False;
    SetR(Dirty, 0, 0, 0, 0);
    Exit;
  End;
  If (Dirty.L >= Dirty.R) Or (Dirty.T >= Dirty.B) Then Exit;
  R := Dirty;
  SetR(Dirty, 0, 0, 0, 0);
  ComposeRect(R);
  CursorRect(C);
  If RInter(I, R, C) Then
  Begin
    LfbCopy(R);
    CursorDraw;
  End
  Else
    LfbCopy(R);
End;

{ Composer et afficher ; VMware SVGA : zones modifiees envoyees a
  l'hote (UPDATE) }
Procedure FlushScreen;
Var D : Boolean;
Begin
  D := DDShow And (DDDirty Or Not DDCleared);
  FlushScreen0;
  If SvOn Then
  Begin
    If D Then SvAdd(0, 0, ScrW, ScrH);
    SvFlush;
  End;
End;

{ ==================================================================== }
{ Partie 5 - Taches cooperatives, synchronisation, files de messages   }
{ ==================================================================== }
{ La tache 0 est celle du noyau (peripheriques, bureau, composition de
  l'ecran) ; elle est toujours prete. Les taches des programmes Win32
  cedent le processeur dans les fonctions bloquantes. Chaque tache a un
  TIB (segment FS) : +0 chaine SEH, +4 sommet de pile, +8 limite,
  +18h adresse du TIB, +20h processus, +24h tache, +2Ch TLS. }

Const
  tsReady = 0; tsSleep = 1; tsWait = 2; tsMsg = 3; tsDead = 4;
  TlsSlots = 64;

Type
  TThread = Record
    Used     : Boolean;
    Esp      : LongInt;
    Stack    : LongInt;
    StackSz  : LongInt;
    Tib      : LongInt;
    State    : LongInt;
    WakeAt   : LongInt;
    WaitH    : LongInt;
    LastErr  : LongInt;
    QHead, QTail : LongInt;
    QuitFlag : Boolean;
    QuitCode : LongInt;
    Start, Param : LongInt;
    ExitCode : LongInt;
    KObj     : LongInt;
    IsApp    : Boolean;
    PaintReq : Boolean;
    Susp     : LongInt;                 { compteur de SuspendThread }
    WaitN    : LongInt;                 { attente de WaitN objets (0 : un) }
    WaitAll  : Boolean;
    WaitMsg  : Boolean;                 { ... ou d'un message }
    PulseH   : LongInt;                 { evenement pulse pendant l'attente }
    Abandon  : Boolean;                 { mutex abandonne obtenu }
  End;

  TMsgRec = Record
    Hwnd, Msg, WP, LP, Time, X, Y : LongInt;
  End;

  TMMTimer = Record
    Used : Boolean;
    Delay, Next, Proc, User, Flags : LongInt;
    PrcId : LongInt;              { processus de la fonction de rappel }
  End;

Type
  TMsgQArr = Array[0..MaxThread * MaxQueue - 1] Of TMsgRec;
  PMsgQArr = ^TMsgQArr;
  TWaitArr = Array[0..MaxThread * 64 - 1] Of LongInt;
  PWaitArr = ^TWaitArr;

Var
  Threads  : Array[0..MaxThread - 1] Of TThread;
  MsgQ     : PMsgQArr;        { alloue dans le tas }
  WaitHs   : PWaitArr;        { objets attendus (64 par tache) }
  CurT     : LongInt;
  FpuArea  : Array[0..MaxThread * 112 - 1] Of Byte;
  { par tache : pile de l'anneau 0 pour le code 16 bits (TSS.ESP0),
    proprietaire des blocs memoire (1 Win32, 2 Win16), tache Win16 }
  ThrEsp0  : Array[0..MaxThread - 1] Of LongInt;
  ThrOwner : Array[0..MaxThread - 1] Of LongInt;
  ThrW16   : Array[0..MaxThread - 1] Of Boolean;
  TssBase  : LongInt;
  SwSave   : LongInt;
  SwNew    : LongInt;
  NextTid  : LongInt;
  MMTimers : Array[0..MaxMMTimer - 1] Of TMMTimer;
  InMMTimer : Boolean;
  AppRunning : Boolean;
  TlsUsed  : Array[0..TlsSlots - 1] Of Boolean;
  { pagination (machine virtuelle DOS) : CR3 de chaque tache et
    repertoire de pages du noyau (0 : pas de pagination) }
  ThrCr3   : Array[0..MaxThread - 1] Of LongInt;
  KPd      : LongInt;
  SwCr3P, SwCr3N : LongInt;
  VmOn     : Boolean;           { machine virtuelle DOS en cours }
  VmT      : LongInt;           { sa tache }

{ ------------------------------------------------------------------ }
{ Processus                                                          }
{ ------------------------------------------------------------------ }
{ Chaque programme Win32 (et la machine virtuelle MS-DOS) est un
  processus : ses taches, ses modules, ses blocs du tas (proprietaire
  100h + numero), ses objets GDI et ses poignees lui appartiennent et
  sont liberes a sa fin. Comme sous Windows 95, l'image du programme
  est privee et le reste est partage : chaque processus a son propre
  repertoire de pages, qui ne differe de celui du noyau que dans la
  fenetre des images (4 Mo a ExeTop) ; le premier programme y est
  charge en identite (memoire physique de la fenetre), les suivants dans
  des pages du tas placees a leur adresse preferee par des tables de
  pages de 4 Ko. Le processus 0 est le systeme (noyau, bureau, Win16).
  Les variables App* et CurDirS forment le contexte du processus
  courant : l'ordonnanceur les range et les recharge quand il passe a une
  tache d'un autre processus. }

Const
  MaxProc = 32;
  pkSystem = 0; pkWin32 = 1; pkDos = 2;

Type
  TProc = Record
    Used     : Boolean;
    Kind     : LongInt;
    Pid      : LongInt;
    Parent   : LongInt;           { identifiant du processus parent }
    Owner    : LongInt;           { proprietaire de ses blocs du tas }
    Pd       : LongInt;           { repertoire de pages (0 : du noyau) }
    Obj      : LongInt;           { objet processus (poignees, attente) }
    Killing  : Boolean;
    ExitCode : LongInt;
    StartT   : LongInt;           { Ticks au lancement }
    CpuMs    : LongInt;           { temps des taches terminees (ms) }
    KrnMs    : LongInt;
    PrioCls  : LongInt;
    Show     : LongInt;           { nCmdShow du lancement }
    { contexte (variables globales quand il s'execute) }
    Base, Size, Entry, Cmd, Env, StdOut, ErrMode, ExcFilter : LongInt;
    StdIn : LongInt;
    MainT    : LongInt;
    Console  : Boolean;
    Path     : String[127];
    Cwd      : String[127];
  End;

  TProcArr = Array[0..MaxProc - 1] Of TProc;
  PProcArr = ^TProcArr;

Var
  Procs    : PProcArr;         { alloue dans le tas }
  CurProc  : LongInt;           { processus du contexte courant }
  ProcCnt  : LongInt;           { processus Win32 et DOS en cours }
  ThrProc  : Array[0..MaxThread - 1] Of LongInt;   { processus de la tache }
  ThrCurP  : Array[0..MaxThread - 1] Of LongInt;   { contexte en cours }
  ThrPxD   : Array[0..MaxThread - 1] Of LongInt;   { appels imbriques }
  PxProc, PxOwn, PxCr3 : Array[0..MaxThread * 4 - 1] Of LongInt;
  WinProc  : LongInt;           { processus en identite dans la fenetre }
  NextPid  : LongInt;
  DXProc   : LongInt;           { processus qui utilise DirectX }
  VmOwner  : LongInt;           { proprietaire des blocs de la VM DOS }
  VmProc   : LongInt;
  { contexte du processus courant }
  AppBase, AppSize, AppEntry : LongInt;
  AppPath    : String[127];
  AppCmd     : LongInt;     { ligne de commande ASCIIZ }
  AppEnv     : LongInt;     { bloc d'environnement }
  AppStdOut, AppStdIn : LongInt;
  AppErrMode : LongInt;
  AppExcFilter : LongInt;
  AppProcObj : LongInt;
  AppMainT  : LongInt;
  AppConsole : Boolean;                  { programme du sous-systeme console }

Var
  ThrCpu   : Array[0..MaxThread - 1] Of LongInt;   { ms de la tache }
  ProcsOk  : Boolean;
  PeakCommit : LongInt;

{ Une milliseconde de l'horloge : au repos, ou a la tache courante et a
  son processus (le processus 0 compte le noyau et le bureau) }
Procedure CpuTick;
Var P : LongInt;
Begin
  If InIdle Then
  Begin
    Inc(IdleMs);
    Exit;
  End;
  Inc(BusyMs);
  If (CurT < 0) Or (CurT >= MaxThread) Then Exit;
  Inc(ThrCpu[CurT]);
  P := ThrProc[CurT];
  If ProcsOk And (P >= 0) And (P < MaxProc) Then
    Procs^[P].CpuMs := Procs^[P].CpuMs + 1;
End;

Procedure ProcCtxSave(P : LongInt);
Begin
  If (P < 0) Or (P >= MaxProc) Then Exit;
  Procs^[P].Base := AppBase; Procs^[P].Size := AppSize;
  Procs^[P].Entry := AppEntry; Procs^[P].Cmd := AppCmd;
  Procs^[P].Env := AppEnv; Procs^[P].StdOut := AppStdOut;
  Procs^[P].StdIn := AppStdIn;
  Procs^[P].ErrMode := AppErrMode; Procs^[P].ExcFilter := AppExcFilter;
  Procs^[P].Obj := AppProcObj; Procs^[P].MainT := AppMainT;
  Procs^[P].Console := AppConsole;
  Procs^[P].Path := AppPath; Procs^[P].Cwd := CurDirS;
End;

Procedure ProcCtxLoad(P : LongInt);
Begin
  If (P < 0) Or (P >= MaxProc) Then Exit;
  AppBase := Procs^[P].Base; AppSize := Procs^[P].Size;
  AppEntry := Procs^[P].Entry; AppCmd := Procs^[P].Cmd;
  AppEnv := Procs^[P].Env; AppStdOut := Procs^[P].StdOut;
  AppStdIn := Procs^[P].StdIn;
  AppErrMode := Procs^[P].ErrMode; AppExcFilter := Procs^[P].ExcFilter;
  AppProcObj := Procs^[P].Obj; AppMainT := Procs^[P].MainT;
  AppConsole := Procs^[P].Console;
  AppPath := Procs^[P].Path;
  If Procs^[P].Cwd <> '' Then CurDirS := Procs^[P].Cwd;
End;

{ Passer au contexte du processus P (variables globales) }
Procedure ProcCtxSwap(P : LongInt);
Begin
  If P = CurProc Then Exit;
  ProcCtxSave(CurProc);
  ProcCtxLoad(P);
  CurProc := P;
End;

Function Cr3Now : LongInt;
Var V : LongInt;
Begin
  V := 0;
  If KPd <> 0 Then
    asm
      mov eax,cr3
      mov V,eax
    end;
  Cr3Now := V;
End;

{ True si l'adresse lineaire A est presente dans l'espace courant }
Function LinOk(A : LongInt) : Boolean;
Var D, E : LongInt;
Begin
  LinOk := False;
  D := Cr3Now And Not 4095;
  If D = 0 Then
  Begin
    LinOk := (A >= 0) And (A < MemTop);
    Exit;
  End;
  E := MemL[0:D + ((A Shr 22) And 1023) * 4];
  If (E And 1) = 0 Then Exit;
  If (E And $80) <> 0 Then
  Begin
    LinOk := True;
    Exit;
  End;
  E := MemL[0:(E And Not 4095) + ((A Shr 12) And 1023) * 4];
  LinOk := (E And 1) <> 0;
End;

Procedure SetCr3(V : LongInt);
Begin
  If (KPd = 0) Or (V = 0) Then Exit;
  asm
    mov eax,V
    mov cr3,eax
  end;
End;

{ Repertoire de pages du processus P }
Function ProcCr3(P : LongInt) : LongInt;
Begin
  If (P > 0) And (P < MaxProc) And Procs^[P].Used And (Procs^[P].Pd <> 0) Then
    ProcCr3 := Procs^[P].Pd
  Else ProcCr3 := KPd;
End;

Function ProcOfThread(T : LongInt) : LongInt;
Begin
  If (T < 0) Or (T >= MaxThread) Then ProcOfThread := 0
  Else ProcOfThread := ThrProc[T];
End;

{ Executer du code du processus P depuis une tache d'un autre processus
  (procedure de fenetre, minuterie, fonction de rappel) : son espace
  d'adresses et son contexte, jusqu'a ProcLeave. False si rien a faire }
Function ProcEnter(P : LongInt) : Boolean;
Var D : LongInt;
Begin
  ProcEnter := False;
  If (P < 0) Or (P >= MaxProc) Or (P = CurProc) Then Exit;
  If Not Procs^[P].Used Then Exit;
  D := ThrPxD[CurT];
  If D >= 4 Then Exit;
  PxProc[CurT * 4 + D] := CurProc;
  PxOwn[CurT * 4 + D] := ThrOwner[CurT];
  PxCr3[CurT * 4 + D] := Cr3Now;
  ThrPxD[CurT] := D + 1;
  ProcCtxSwap(P);
  ThrCurP[CurT] := P;
  If P > 0 Then ThrOwner[CurT] := Procs^[P].Owner;
  HeapOwner := ThrOwner[CurT];
  SetCr3(ProcCr3(P));
  ProcEnter := True;
End;

Procedure ProcLeave;
Var D : LongInt;
Begin
  D := ThrPxD[CurT] - 1;
  If D < 0 Then Exit;
  ThrPxD[CurT] := D;
  ProcCtxSwap(PxProc[CurT * 4 + D]);
  ThrCurP[CurT] := CurProc;
  ThrOwner[CurT] := PxOwn[CurT * 4 + D];
  HeapOwner := ThrOwner[CurT];
  SetCr3(PxCr3[CurT * 4 + D]);
End;

Procedure VmTick(B : LongInt); Forward;

Function ThreadId(T : LongInt) : LongInt;
Begin
  ThreadId := $100 + T * 4;
End;

Function ThreadOfId(Id : LongInt) : LongInt;
Begin
  If (Id < $100) Or (Id >= $100 + MaxThread * 4) Then ThreadOfId := -1
  Else ThreadOfId := (Id - $100) Div 4;
End;

Procedure ThreadSetFs(T : LongInt);
Begin
  SetFsBase(Threads[T].Tib);
End;

Function NewTib(T, StackTop, StackSz : LongInt) : LongInt;
Var A : LongInt;
Begin
  A := KAlloc(4096 + TlsSlots * 4);
  MemL[0:A] := -1;
  MemL[0:A + 4] := StackTop;
  MemL[0:A + 8] := StackTop - StackSz;
  MemL[0:A + $18] := A;
  MemL[0:A + $20] := $50;
  MemL[0:A + $24] := ThreadId(T);
  MemL[0:A + $2C] := A + 4096;
  NewTib := A;
End;

{ Changement de contexte vers SwNew (sauvegarde dans [SwSave]) ; avec
  la pagination, CR3 de la tache quittee range en [SwCr3P] et celui de
  la nouvelle (SwCr3N) charge avant de passer sur sa pile : la pile de
  la tache 0 (sous 90000h) n'existe qu'avec les pages du noyau }
Procedure SwitchCtx;
Begin
  asm
    pushad
    pushfd
    cli
    mov eax,SwSave
    mov [eax],esp
    mov eax,KPd
    or eax,eax
    jz @nopg
    mov edx,SwCr3P
    mov eax,cr3
    mov [edx],eax
    mov eax,SwCr3N
    mov cr3,eax
  @nopg:
    mov esp,SwNew
    popfd
    popad
  end;
End;

Function ObjSignaled(H : LongInt; Consume : Boolean) : Boolean; Forward;
Function WaitReady(T : LongInt; Consume : Boolean) : LongInt; Forward;
Function MsgPending(T : LongInt) : Boolean; Forward;
Procedure RunMMTimers; Forward;

Function ThreadRunnable(T : LongInt) : Boolean;
Begin
  ThreadRunnable := False;
  If Not Threads[T].Used Then Exit;
  If Threads[T].Susp > 0 Then Exit;
  Case Threads[T].State Of
    tsReady : ThreadRunnable := True;
    tsSleep : ThreadRunnable := Ticks >= Threads[T].WakeAt;
    tsWait :
      ThreadRunnable := (WaitReady(T, False) >= 0) Or
                        ((Threads[T].WakeAt >= 0) And
                         (Ticks >= Threads[T].WakeAt));
    tsMsg :
      ThreadRunnable := MsgPending(T) Or
                        ((Threads[T].WakeAt >= 0) And
                         (Ticks >= Threads[T].WakeAt));
  End;
End;

{ Passer a la tache suivante prete (tourniquet) }
{ Selecteur de FS/GS encore chargeable : GDT, ou LDT utilise et
  present (la LDT est definie plus loin, partie Win16) }
Function KSelLive(Sel : LongInt) : Boolean; Forward;

Procedure KSchedule;
Var I, N, A, Sfs, Sgs : LongInt;
Begin
  N := -1;
  For I := 1 To MaxThread Do
    If ThreadRunnable((CurT + I) Mod MaxThread) Then
    Begin
      N := (CurT + I) Mod MaxThread;
      Break;
    End;
  If (N < 0) Or (N = CurT) Then Exit;
  { etat du coprocesseur de la tache quittee (FNSAVE reinitialise) }
  A := LongInt(@FpuArea) + CurT * 112;
  asm
    mov eax,A
    fnsave [eax]
  end;
  SwSave := LongInt(@Threads[CurT].Esp);
  SwNew := Threads[N].Esp;
  SwCr3P := LongInt(@ThrCr3[CurT]);
  SwCr3N := ThrCr3[N];
  ProcCtxSwap(ThrCurP[N]);
  CurT := N;
  HeapOwner := ThrOwner[N];
  If TssBase <> 0 Then MemL[0:TssBase + 4] := ThrEsp0[N];
  ThreadSetFs(N);
  SliceStart := Ticks;
  { FS et GS de la tache (selecteurs d'un client DPMI en anneau 3,
    interrompu par l'horloge) : rendus a son retour }
  asm
    xor eax,eax
    mov ax,fs
    mov Sfs,eax
    mov ax,gs
    mov Sgs,eax
  end;
  SwitchCtx;
  { un selecteur de la LDT libere entre-temps (autre tache) : nul }
  If Not KSelLive(Sfs) Then Sfs := 0;
  If Not KSelLive(Sgs) Then Sgs := 0;
  asm
    mov eax,Sfs
    mov fs,ax
    mov eax,Sgs
    mov gs,ax
  end;
  HeapOwner := ThrOwner[CurT];
  A := LongInt(@FpuArea) + CurT * 112;
  { FNCLEX : une exception x87 laissee en attente par une tache arretee
    (faute #MF d'un programme) ne doit pas se declencher ici, dans le
    noyau (FRSTOR attend les exceptions en attente) }
  asm
    db 219,226
    mov eax,A
    frstor [eax]
  end;
End;

{ Fin de l'interruption d'horloge : une tache Win32 qui execute son
  propre code (jamais le noyau) depuis plus de 20 ms cede le processeur,
  comme sous Windows 95 (multitache preemptif des fils Win32) }
Procedure TimerTail;
Var F, Eip : LongInt;
Begin
  asm
    mov eax,[ebp]
    mov F,eax
  end;
  { code d'un programme DOS (mode V86) : interruptions virtuelles }
  If VmOn And (CurT = VmT) And (((MemL[0:F + 52] And $20000) <> 0) Or
     ((MemL[0:F + 48] And 3) = 3)) Then
    VmTick(F + 12);
  Eip := MemL[0:F + 44];
  If DbgPause And DbgOn And (CurT > 0) And (ThrProc[CurT] = DbgProc) And
     ((Eip < KImgLo) Or (Eip >= KImgHi)) Then
    MemL[0:F + 52] := MemL[0:F + 52] Or $100;
  If (CurT <= 0) Or (Ticks - SliceStart < 20) Then Exit;
  If Not Threads[CurT].IsApp Then Exit;
  { code 16 bits (anneau 3) : toujours preemptible }
  If (MemL[0:F + 48] And 3) <> 3 Then
    If (Eip >= KImgLo) And (Eip < KImgHi) Then Exit;
  KSchedule;
End;

{ Ceder le processeur (la tache reste prete) }
Procedure KYield;
Begin
  Threads[CurT].State := tsReady;
  KSchedule;
End;

{ Un programme qui enchaine les appels systeme longs passe presque tout
  son temps dans le noyau, ou l'horloge ne le preempte pas (TimerTail) :
  l'ecran, la souris et le clavier n'etaient plus servis (SCANDISK sur
  un disque de 2 Go ; le Defragmenteur, qui se poste un message par
  fichier deplace). Sa tranche de 20 ms ecoulee, il cede le processeur a
  l'entree de ces appels, ou rien n'est encore tenu : ReadFile,
  WriteFile, CreateFileA, FindFirstFileA, FindNextFileA,
  DeviceIoControl, et GetMessageA quand un message attend deja. }
Procedure AppYield;
Begin
  If (CurT > 0) And Threads[CurT].IsApp And (Ticks - SliceStart >= 20) Then
  Begin
    KYield;
    SliceStart := Ticks;
  End;
End;

{ Bloquer la tache courante jusqu'a ce qu'elle redevienne executable }
Procedure KBlock;
Begin
  While Not ThreadRunnable(CurT) Do
  Begin
    If CurT = 0 Then
    Begin
      Threads[0].State := tsReady;
      Exit;
    End;
    KSchedule;
  End;
  Threads[CurT].State := tsReady;
End;

Procedure KSleep(Ms : LongInt);
Begin
  If CurT = 0 Then
  Begin
    KDelay(Ms);
    Exit;
  End;
  Threads[CurT].State := tsSleep;
  Threads[CurT].WakeAt := Ticks + Ms;
  KBlock;
End;

Procedure ExitThreadK(Code : LongInt); Forward;

{ Point d'entree d'une nouvelle tache (atteint par le RET de SwitchCtx) }
Procedure ThreadStartup;
Var S, P, R : LongInt;
Begin
  S := Threads[CurT].Start;
  P := Threads[CurT].Param;
  asm
    sti
    mov eax,P
    push eax
    mov eax,S
    call eax
    mov R,eax
  end;
  ExitThreadK(R);
End;

{ Creer une tache (Start(Param), convention stdcall) ; indice ou -1 }
Function ThreadNew(Start, Param, StackSz : LongInt; IsApp : Boolean)
  : LongInt;
Var T, I, Top, FP : LongInt;
Begin
  ThreadNew := -1;
  T := -1;
  For I := 1 To MaxThread - 1 Do
    If Not Threads[I].Used Then
    Begin
      T := I;
      Break;
    End;
  If T < 0 Then Exit;
  If StackSz < 65536 Then StackSz := 65536;
  If StackSz > 16777216 Then StackSz := 16777216;
  { pile et TIB au noyau : liberes par ReapThreads seulement. Rendus
    par KFreeOwner a la fin du programme, ils pouvaient etre realloues
    (memoire du programme suivant) puis liberes une seconde fois par
    ReapThreads. }
  I := HeapOwner; HeapOwner := 0;
  Threads[T].Stack := KAlloc(StackSz);
  If Threads[T].Stack <> 0 Then
    Threads[T].Tib := NewTib(T, (Threads[T].Stack + StackSz - 64) And
                             Not 15, StackSz);
  HeapOwner := I;
  If Threads[T].Stack = 0 Then Exit;
  Threads[T].Used := True;
  Threads[T].StackSz := StackSz;
  Top := (Threads[T].Stack + StackSz - 64) And Not 15;
  Threads[T].State := tsReady;
  Threads[T].WakeAt := -1;
  Threads[T].WaitH := 0;
  Threads[T].LastErr := 0;
  Threads[T].QHead := 0; Threads[T].QTail := 0;
  Threads[T].QuitFlag := False;
  Threads[T].Start := Start;
  Threads[T].Param := Param;
  Threads[T].ExitCode := 259;
  Threads[T].Susp := 0;
  Threads[T].IsApp := IsApp;
  ThrOwner[T] := Ord(IsApp);
  ThrProc[T] := 0; ThrCurP[T] := 0; ThrPxD[T] := 0;
  ThrCpu[T] := 0;
  If IsApp And (CurProc > 0) Then
  Begin
    { tache d'un programme : celle de son processus }
    ThrProc[T] := CurProc; ThrCurP[T] := CurProc;
    ThrOwner[T] := Procs^[CurProc].Owner;
  End;
  ThrW16[T] := False;
  ThrEsp0[T] := (Threads[T].Stack + StackSz - 64) And Not 15;
  ThrCr3[T] := ProcCr3(ThrProc[T]);
  Threads[T].PaintReq := False;
  Threads[T].KObj := KObjNew(koThread);
  If Threads[T].KObj >= 0 Then KObjs^[Threads[T].KObj].F1 := T;
  { cadre initial : EFLAGS, PUSHAD, puis EBP -> [0, ThreadStartup] }
  FP := Top - 16;
  MemL[0:FP] := 0;
  MemL[0:FP + 4] := LongInt(@ThreadStartup);
  Threads[T].Esp := FP - 64;
  MemL[0:Threads[T].Esp] := $202;
  For I := 1 To 8 Do MemL[0:Threads[T].Esp + I * 4] := 0;
  MemL[0:Threads[T].Esp + 12] := FP;
  ThreadNew := T;
End;

Procedure RotDropProc(P : LongInt); Forward;

Procedure KillProc(P, Code : LongInt); Forward;
Procedure MutexAbandon(T : LongInt); Forward;

Procedure ExitThreadK(Code : LongInt);
Var P, I, N : LongInt;
Begin
  Threads[CurT].ExitCode := Code;
  Threads[CurT].State := tsDead;
  MutexAbandon(CurT);
  If CurT = 0 Then Exit;
  { derniere tache d'un processus : fin du processus }
  P := ThrProc[CurT];
  If (P > 0) And Procs^[P].Used And Not Procs^[P].Killing Then
  Begin
    N := 0;
    For I := 1 To MaxThread - 1 Do
      If Threads[I].Used And (ThrProc[I] = P) And
         (Threads[I].State <> tsDead) Then Inc(N);
    If N = 0 Then KillProc(P, Code);
  End;
  KSchedule;
End;

{ Liberer les taches terminees (appele par la tache 0) }
Procedure ReapThreads;
Var I : LongInt;
Begin
  For I := 1 To MaxThread - 1 Do
    If Threads[I].Used And (Threads[I].State = tsDead) And (I <> CurT) Then
    Begin
      KFree(Threads[I].Stack);
      KFree(Threads[I].Tib);
      Threads[I].Used := False;
      If Threads[I].KObj >= 0 Then
        KObjs^[Threads[I].KObj].F2 := 1;    { tache terminee : signalee }
    End;
End;

Procedure ThreadInit0;
Begin
  Threads[0].Used := True;
  Threads[0].StackSz := $80000;
  Threads[0].Tib := NewTib(0, KStackTop, $80000);
  Threads[0].State := tsReady;
  Threads[0].KObj := -1;
  Threads[0].IsApp := False;
  CurT := 0;
  ThreadSetFs(0);
End;

