                   'General');
    1 : VpTab := L('Outils', 'Tools', 'Extras', 'Strumenti',
                   'Herramientas');
  Else
    VpTab := L('Partage', 'Sharing', 'Freigabe', 'Condivisione',
               'Compartir');
  End;
