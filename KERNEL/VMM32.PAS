Function GetVolumeInformationA(PRoot, PVol, VolSize, PSerial, PMaxComp,
  PFlags, PFs, FsSize : LongInt) : LongInt;
Var D : String; V : LongInt;
Begin
  If PRoot <> 0 Then D := UpStr(PStr(PRoot)) Else D := CurDirS;
  V := FatVolOf(Copy(D, 1, 1) + ':');
  If V >= 0 Then
  Begin
    { volume FAT : noms longs, casse conservee, Unicode sur le disque }
    If PVol <> 0 Then PutPStr(PVol, VolLab^[V], VolSize);
    If PSerial <> 0 Then MemL[0:PSerial] := VolSerial[V];
    If PMaxComp <> 0 Then MemL[0:PMaxComp] := 255;
    If PFlags <> 0 Then MemL[0:PFlags] := 6;
    If PFs <> 0 Then
      If VolType[V] = 32 Then PutPStr(PFs, 'FAT32', FsSize)
      Else If VolType[V] = NtfsT Then PutPStr(PFs, 'NTFS', FsSize)
      Else If VolType[V] = HpfsT Then PutPStr(PFs, 'HPFS', FsSize)
      Else If VolType[V] = NetT Then PutPStr(PFs, 'NTFS', FsSize)
      Else PutPStr(PFs, 'FAT', FsSize);
    If (PFlags <> 0) And (VolType[V] = NtfsT) Then MemL[0:PFlags] := $1F;
    If (PFlags <> 0) And (VolType[V] = HpfsT) Then MemL[0:PFlags] := 3;
    If (PMaxComp <> 0) And (VolType[V] = HpfsT) Then MemL[0:PMaxComp] := 254;
  End
  Else If (D <> '') And (D[1] = 'C') Then
  Begin
    { disque en memoire : noms longs (VFAT), casse conservee }
    If PVol <> 0 Then PutPStr(PVol, 'PASDOWS', VolSize);
    If PSerial <> 0 Then MemL[0:PSerial] := $19951995;
    If PMaxComp <> 0 Then MemL[0:PMaxComp] := 255;
    If PFlags <> 0 Then MemL[0:PFlags] := 2;
    If PFs <> 0 Then PutPStr(PFs, 'FAT', FsSize);
  End
  Else
  Begin
    If PVol <> 0 Then PutPStr(PVol, VolLabel, VolSize);
    If PSerial <> 0 Then MemL[0:PSerial] := $19950824;
    If PMaxComp <> 0 Then MemL[0:PMaxComp] := 12;
    If PFlags <> 0 Then MemL[0:PFlags] := 0;
    If PFs <> 0 Then PutPStr(PFs, 'CDFS', FsSize);
  End;
  GetVolumeInformationA := 1;
End;

{ Changer le nom (etiquette) du volume V. FAT : secteur d'amorce (et sa
  copie en FAT32) et entree de la racine (attribut 08h) ; NTFS : attribut
  $VOLUME_NAME de $Volume ; HPFS : secteur d'amorce }
Function VolSetLabel(V : LongInt; Lab : String) : Boolean;
Var A, B, K, Sec, Fat32, Free0, I, R, P : LongInt; S, T : String;
    Done : Boolean;
Begin
  VolSetLabel := False;
  If (V < 0) Or (V >= VolN) Then Exit;
  Lab := Trim(Copy(Lab, 1, 11));
  If VolType[V] = NetT Then Exit;
  If VolType[V] = NtfsT Then
  Begin
    If NvRO[V] <> 0 Then Exit;
    R := KAlloc(4096);
    If R = 0 Then Exit;
    If NtReadRec(V, 3, R) Then
    Begin
      P := NtAttr(V, R, $60, '');
      If P = 0 Then P := NtAddRes(V, R, $60, '', Length(Lab) * 2)
      Else If NtResSetLen(V, R, P, Length(Lab) * 2) Then
        P := NtAttr(V, R, $60, '')
      Else P := 0;
      If P <> 0 Then
      Begin
        For I := 1 To Length(Lab) Do
          MemW[0:NtResVal(P) + (I - 1) * 2] := Ord(Lab[I]);
        If NtWriteRec(V, 3, R) Then
        Begin
          VolLab^[V] := Lab;
          VolSetLabel := True;
        End;
      End;
    End;
    KFree(R);
    Exit;
  End;
  S := UpStr(Lab);
  While Length(S) < 11 Do S := S + ' ';
  If VolType[V] = HpfsT Then
  Begin
    If HvRO[V] <> 0 Then Exit;
    A := KAlloc(512);
    If A = 0 Then Exit;
    If HpRd(V, 0, 1, A) Then
    Begin
      For I := 0 To 10 Do Mem[0:A + 43 + I] := Ord(S[I + 1]);
      If HpWr(V, 0, 1, A) Then
      Begin
        VolLab^[V] := Trim(S);
        VolSetLabel := True;
      End;
    End;
    KFree(A);
    Exit;
  End;
  { FAT12, FAT16, FAT32 : secteur d'amorce (signature etendue 29h) }
  Fat32 := Ord(VolType[V] = 32);
  If Lab = '' Then T := 'NO NAME    ' Else T := S;
  A := VSec(V, 0);
  If FatIoErr Then
  Begin
    FatIoErr := False;
    Exit;
  End;
  If Mem[0:A + 38 + 28 * Fat32] = $29 Then
  Begin
    For I := 0 To 10 Do Mem[0:A + 43 + 28 * Fat32 + I] := Ord(T[I + 1]);
    VPut(V, 0);
    K := MemW[0:A + 50];
    If (Fat32 = 1) And (K > 0) And (K < VolRsvd[V]) Then
    Begin
      B := VSec(V, K);
      If (MemW[0:B + 510] = $AA55) And (Mem[0:B + 66] = $29) Then
      Begin
        For I := 0 To 10 Do Mem[0:B + 71 + I] := Ord(T[I + 1]);
        VPut(V, K);
      End;
    End;
  End;
  { entree d'etiquette de la racine : modifiee, effacee ou creee }
  Free0 := -1; K := 0; Done := False;
  Repeat
    A := DirEnt(V, RootOf(V), K, Sec, False);
    If A = 0 Then Break;
    If Mem[0:A] = 0 Then Break;
    If Mem[0:A] = $E5 Then
    Begin
      If Free0 < 0 Then Free0 := K;
    End
    Else If (Mem[0:A + 11] And $1F) = 8 Then
    Begin
      If Lab = '' Then Mem[0:A] := $E5
      Else For I := 0 To 10 Do Mem[0:A + I] := Ord(S[I + 1]);
      MemL[0:A + 22] := DosNow;
      VPut(V, Sec);
      Done := True;
      Break;
    End;
    Inc(K);
  Until K > 65535;
  If Not Done And (Lab <> '') Then
  Begin
    If Free0 < 0 Then Free0 := K;
    A := DirEnt(V, RootOf(V), Free0, Sec, True);
    If A = 0 Then Exit;
    FillMem(A, 32, 0);
    For I := 0 To 10 Do Mem[0:A + I] := Ord(S[I + 1]);
    Mem[0:A + 11] := 8;
    MemL[0:A + 22] := DosNow;
    VPut(V, Sec);
  End;
  If FatIoErr Then
  Begin
    FatIoErr := False;
    Exit;
  End;
  VolLab^[V] := Trim(S);
  VolSetLabel := True;
End;

Function SetVolumeLabelA(PRoot, PName : LongInt) : LongInt;
Var D, N : String; V : LongInt;
Begin
  If PRoot <> 0 Then D := UpStr(PStr(PRoot)) Else D := CurDirS;
  N := '';
  If PName <> 0 Then N := PStr(PName);
  V := FatVolOf(Copy(D, 1, 1) + ':');
  If (V >= 0) And VolSetLabel(V, N) Then SetVolumeLabelA := 1
  Else
  Begin
    SetErr(5);
    SetVolumeLabelA := 0;
  End;
End;

{ Recherche : F1 position, F2 0 = CD, 1 = disque virtuel ; Name chemin
  du repertoire, Mask masque }
Function FindStep(I, P : LongInt) : Boolean;
Var Nm : String; Lba, Size, Fl, Tm, DL, DS, Attr, R, Idx : LongInt;
Begin
  FindStep := False;
  If KObjs^[I].F2 = 2 Then
  Begin
    { volume FAT : noms longs et noms courts }
    Idx := KObjs^[I].F1;
    While FatDirEntry(KObjs^[I].Name, 0, Idx) Do
    Begin
      KObjs^[I].F1 := Idx;
      If MatchMask(UpStr(FfName), KObjs^[I].Mask) Or
         MatchMask(UpStr(FfShort), KObjs^[I].Mask) Then
      Begin
        FillMem(P, 318, 0);
        Attr := FfAttr And $37;
        If Attr = 0 Then Attr := $80;
        MemL[0:P] := Attr;
        DosToFileTime(FfTime, P + 4);
        DosToFileTime(FfTime, P + 12);
        DosToFileTime(FfTime, P + 20);
        If (FfAttr And $10) = 0 Then MemL[0:P + 32] := FfSize;
        PutPStr(P + 44, FfName, 260);
        If FfShort <> FfName Then PutPStr(P + 304, FfShort, 14);
        FindStep := True;
        Exit;
      End;
    End;
    KObjs^[I].F1 := Idx;
    Exit;
  End;
  If KObjs^[I].F2 = 0 Then
  Begin
    If Copy(KObjs^[I].Name, 1, 2) = 'D:' Then
      If IsoLookup(Copy(KObjs^[I].Name, 3, 255), DL, DS, Fl, Tm) Then
        While IsoDirEntry(DL, DS, KObjs^[I].F1, Nm, Lba, Size, Fl, Tm) Do
        Begin
          Inc(KObjs^[I].F1);
          If MatchMask(Nm, KObjs^[I].Mask) Then
          Begin
            FillMem(P, 318, 0);
            If (Fl And 2) <> 0 Then Attr := $11 Else Attr := $21;
            MemL[0:P] := Attr;
            DosToFileTime(Tm, P + 4);
            DosToFileTime(Tm, P + 12);
            DosToFileTime(Tm, P + 20);
            MemL[0:P + 32] := Size;
            PutPStr(P + 44, Nm, 260);
            PutPStr(P + 304, Nm, 14);
            FindStep := True;
            Exit;
          End;
        End;
    KObjs^[I].F2 := 1;
    KObjs^[I].F1 := 0;
  End;
  While KObjs^[I].F1 < MaxRam Do
  Begin
    R := KObjs^[I].F1;
    Inc(KObjs^[I].F1);
    If RamFiles[R].Used And (ParentDir(RamFiles[R].Path) = KObjs^[I].Name)
       And MatchMask(BaseName(RamFiles[R].Path), KObjs^[I].Mask) Then
    Begin
      FillMem(P, 318, 0);
      MemL[0:P] := RamFiles[R].Attr;
      DosToFileTime(RamFiles[R].Time, P + 20);
      MemL[0:P + 32] := RamFiles[R].Size;
      PutPStr(P + 44, BaseName(RamFiles[R].Path), 260);
      FindStep := True;
      Exit;
    End;
  End;
End;

Function FindFirstFileA(PName, P : LongInt) : LongInt;
Var I : LongInt; S : String;
Begin
  AppYield;
  FindFirstFileA := INVALID_HANDLE;
  I := KObjNew(koFind);
  If I < 0 Then Exit;
  S := FullPath(PStr(PName));
  KObjs^[I].Name := ParentDir(S);
  If Length(KObjs^[I].Name) = 3 Then
    KObjs^[I].Name := Copy(KObjs^[I].Name, 1, 3);
  KObjs^[I].Mask := Copy(BaseName(S), 1, 63);
  If Length(KObjs^[I].Name) = 3 Then
    KObjs^[I].Name := Copy(KObjs^[I].Name, 1, 2) + '\';
  If KObjs^[I].Name = 'D:\' Then KObjs^[I].Name := 'D:';
  If FatVolOf(KObjs^[I].Name) >= 0 Then KObjs^[I].F2 := 2;
  If FindStep(I, P) Then FindFirstFileA := KHandle(I)
  Else
  Begin
    KObjs^[I].Used := False;
    SetErr(ErrFileNotFound);
  End;
End;

Function FindNextFileA(H, P : LongInt) : LongInt;
Var I : LongInt;
Begin
  AppYield;
  FindNextFileA := 0;
  I := KObjOf(H, koFind);
  If I < 0 Then Exit;
  If FindStep(I, P) Then FindNextFileA := 1 Else SetErr(ErrNoMoreFiles);
End;

Function FindClose(H : LongInt) : LongInt;
Var I : LongInt;
Begin
  I := KObjOf(H, koFind);
  If I >= 0 Then KObjs^[I].Used := False;
  FindClose := 1;
End;

