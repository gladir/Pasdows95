{ Sauvegarde du registre dans C:\WINDOWS\PASDOWS.REG (Pasdows installe
  sur le disque dur) : 'PREG', puis les cles (indice, parent, nom) et
  les valeurs (cle, type, taille, nom, donnees). Les indices sont gardes
  (les poignees des cles en dependent). }
Const
  RegFile = 'C:\WINDOWS\PASDOWS.REG';

Procedure RegSave;
Var H, B, O, I, L, Cap : LongInt; S : String;

  Procedure Need(N : LongInt);
  Var B2 : LongInt;
  Begin
    If O + N <= Cap Then Exit;
    While O + N > Cap Do Cap := Cap * 2;
    B2 := KAlloc(Cap);
    If B2 <> 0 Then MoveMem(B, B2, O);
    KFree(B);
    B := B2;
  End;

  Procedure PutL(V : LongInt);
  Begin
    Need(4);
    If B = 0 Then Exit;
    MemL[0:B + O] := V;
    O := O + 4;
  End;

  Procedure PutS(Const T : String);
  Begin
    Need(Length(T) + 2);
    If B = 0 Then Exit;
    Mem[0:B + O] := Length(T);
    If Length(T) > 0 Then MoveMem(LongInt(@T[1]), B + O + 1, Length(T));
    O := O + Length(T) + 1;
  End;

Begin
  If Not RegDirty Or (UpStr(SysDir) <> 'C:\WINDOWS\') Then Exit;
  RegDirty := False;
  Cap := 65536;
  B := KAlloc(Cap);
  If B = 0 Then Exit;
  O := 0;
  PutL($47455250);
  For I := 6 To MaxRK - 1 Do
    If RKUsed^[I] And (B <> 0) Then
    Begin
      PutL(I); PutL(RKPar^[I]); PutS(RKName(I));
    End;
  PutL(-1);
  For I := 0 To MaxRV - 1 Do
    If RVUsed^[I] And (B <> 0) Then
    Begin
      L := RVSize^[I];
      PutL(RVKey^[I]); PutL(RVType^[I]); PutL(L);
      PutS(RVName(I));
      Need(L);
      If (B <> 0) And (L > 0) Then MoveMem(RVData^[I], B + O, L);
      O := O + L;
    End;
  PutL(-1);
  If B = 0 Then Exit;
  S := RegFile;
  H := KOpenFile(S, True, 2);
  If H <> INVALID_HANDLE Then
  Begin
    KWriteFile(H, B, O);
    CloseHandle(H);
  End;
  KFree(B);
End;

Procedure RegLoad;
Var F, Size, O, I, P, K, T, L : LongInt; Nm : String;

  Function GetL : LongInt;
  Begin
    If O + 4 <= Size Then GetL := MemL[0:F + O] Else GetL := -1;
    O := O + 4;
  End;

  Function GetS : String;
  Var N : LongInt; R : String;
  Begin
    R := '';
    If O < Size Then
    Begin
      N := Mem[0:F + O];
      If O + 1 + N <= Size Then
      Begin
        R[0] := Chr(N);
        If N > 0 Then MoveMem(F + O + 1, LongInt(@R[1]), N);
      End;
      O := O + N + 1;
    End;
    GetS := R;
  End;

Begin
  If UpStr(SysDir) <> 'C:\WINDOWS\' Then Exit;
  F := LoadWholeFile(RegFile, Size);
  If F = 0 Then Exit;
  O := 0;
  If GetL = $47455250 Then
  Begin
    { cles }
    Repeat
      I := GetL;
      If (I < 6) Or (I >= MaxRK) Then Break;
      P := GetL;
      Nm := GetS;
      If Not RKUsed^[I] Then
      Begin
        RKUsed^[I] := True; RKPar^[I] := P; RKNameP^[I] := RegStrNew(Nm);
      End;
    Until O >= Size;
    { valeurs (RegSetK remplace celles de RegInit) }
    Repeat
      K := GetL;
      If (K < 0) Or (K >= MaxRK) Then Break;
      T := GetL; L := GetL;
      Nm := GetS;
      If (L < 0) Or (O + L > Size) Then Break;
      If RKUsed^[K] Then RegSetK(K, Nm, T, F + O, L);
      O := O + L;
    Until O >= Size;
  End;
  KFree(F);
  RegDirty := False;
  KLog('Registre : ' + RegFile + ' charge');
End;

Function ShFolder(Csidl : LongInt) : String;
Var B : Array[0..259] Of Char; W, R, Part : String; K : LongInt;
Begin
  B[0] := #0;
  GetWindowsDirectoryA(LongInt(@B), 256);
  W := PStr(LongInt(@B));
  If W = '' Then W := 'C:\WINDOWS';
  Case Csidl And $FF Of
    0, $10, $19 : R := W + '\Desktop';
    2, $17 : R := W + '\Start Menu\Programs';
    5 : R := 'C:\My Documents';
    6, $1F : R := W + '\Favorites';
    7, $18 : R := W + '\Start Menu\Programs\StartUp';
    8 : R := W + '\Recent';
    9 : R := W + '\SendTo';
    $0B, $16 : R := W + '\Start Menu';
    $13 : R := W + '\NetHood';
    $14 : R := W + '\Fonts';
    $15 : R := W + '\ShellNew';
    $1A, $1C, $23 : R := W + '\Application Data';
    $20 : R := W + '\Temporary Internet Files';
    $21 : R := W + '\Cookies';
    $22 : R := W + '\History';
    $24 : R := W;
    $25, $29 : R := W + '\SYSTEM';
    $26 : R := 'C:\Program Files';
    $2B : R := 'C:\Program Files\Common Files';
  Else
    R := '';
  End;
  { creer le chemin, dossier par dossier }
  If R <> '' Then
    For K := 4 To Length(R) + 1 Do
      If (K > Length(R)) Or (R[K] = '\') Then
      Begin
        Part := Copy(R, 1, K - 1) + #0;
        CreateDirectoryA(LongInt(@Part[1]), 0);
      End;
  ShFolder := R;
End;

Const
  PidlMagic = $4C445050;                 { 'PPDL' : liste d'un chemin }

{ ITEMIDLIST d'un chemin : cb, marque, chemin ASCIIZ, puis cb = 0 }
Function PidlOf(Const Path : String) : LongInt;
Var A, N : LongInt;
Begin
  N := 2 + 4 + Length(Path) + 1;
  A := KAlloc(N + 2);
  PidlOf := A;
  If A = 0 Then Exit;
  MemW[0:A] := N;
  MemL[0:A + 2] := PidlMagic;
  PutPStr(A + 6, Path, Length(Path) + 1);
  MemW[0:A + N] := 0;
End;

