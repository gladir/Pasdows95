{ ------------------------------------------------------------------ }
{ Affichage : nombre de couleurs et zone d'ecran (modes VESA)         }
{ ------------------------------------------------------------------ }
{ IO.SYS choisit le mode au demarrage d'apres la preference du CMOS
  (7Ah bits par point, 7Bh signature 5Ah, 7Ch largeur / 8, 7Dh hauteur
  / 8). Avec l'interface VBE de Bochs/QEMU/VirtualBox (ports 1CEh/1CFh,
  dite DISPI), le mode change tout de suite, sans redemarrer ; sinon,
  comme Windows 95 pour le nombre de couleurs, le nouveau mode prend
  effet au redemarrage. L'ecran reste compose en 256 couleurs (palette
  systeme) et converti vers la profondeur de la memoire video. }

Procedure DispiW(Idx, V : LongInt);
Begin
  PortW[$1CE] := Idx;
  PortW[$1CF] := V;
End;

Function DispiR(Idx : LongInt) : LongInt;
Begin
  PortW[$1CE] := Idx;
  DispiR := PortW[$1CF];
End;

Procedure DispiDetect;
Var V : LongInt;
Begin
  V := DispiR(0);
  DispiOk := (V >= $B0C0) And (V <= $B0CF);
  If DispiOk Then KLog('Ecran : interface VBE DISPI ' + HexStr(V, 4));
End;

{ Mode W x H en B bits par point, memoire lineaire (DISPI) }
Function DispiSet(W, H, B : LongInt) : Boolean;
Begin
  DispiW(4, 0);
  DispiW(1, W); DispiW(2, H); DispiW(3, B);
  DispiW(5, 0);
  DispiW(6, W); DispiW(7, H);
  DispiW(8, 0); DispiW(9, 0);
  DispiW(4, $41);
  DispiSet := (DispiR(1) = W) And (DispiR(2) = H) And (DispiR(3) = B);
End;

{ Indice du mode VESA W x H x B dans la table d'IO.SYS (-1) }
Function VmFind(W, H, B : LongInt) : LongInt;
Var I : LongInt;
Begin
  VmFind := -1;
  For I := 0 To VmN - 1 Do
    If (VmW[I] = W) And (VmH[I] = H) And (VmBpp[I] = B) Then
    Begin
      VmFind := I;
      Exit;
    End;
End;

{ Passer au mode I de la table, sans redemarrer : nouvel ecran, barre
  des taches et fenetres agrandies a la nouvelle taille, fenetres
  ramenees dans l'ecran, WM_DISPLAYCHANGE aux programmes }
Function KSetMode(I : LongInt) : Boolean;
Var W, X, Y : LongInt;
Begin
  KSetMode := False;
  If (I < 0) Or (I >= VmN) Or Not DispiOk Then Exit;
  If Not DispiSet(VmW[I], VmH[I], VmBpp[I]) Then Exit;
  CurShownB := False;
  ScrW := VmW[I]; ScrH := VmH[I]; ScrBpp := VmBpp[I];
  ScrBytes := (ScrBpp + 7) Div 8;
  TaskY := ScrH - TaskH;
  ScrMode := VmNum[I];
  VideoMasks(LongInt(@VmMask) + I * 6);
  VgaPlanar := False;
  LfbPitch := ScrW * ScrBytes;
  If VmLfb[I] <> 0 Then Lfb := VmLfb[I];
  SurfFree(Back);
  SurfNew(Back, ScrW, ScrH);
  FillMem(LongInt(@OutPal), SizeOf(OutPal), $FF);
  DacAll;
  OutPalChanged := False;
  DDCleared := False;
  If TaskbarW >= 0 Then MoveW(TaskbarW, 0, TaskY, ScrW, TaskH, True);
  For W := 0 To MaxWnd - 1 Do
    If Wnds[W].Used And Not IsChildW(W) And (W <> TaskbarW) Then
    Begin
      If Wnds[W].Max Then
        MoveW(W, -Wnds[W].CL, -Wnds[W].CL, ScrW + 2 * Wnds[W].CL,
              TaskY + 2 * Wnds[W].CL, True)
      Else
      Begin
        X := Wnds[W].X; Y := Wnds[W].Y;
        If X + 60 > ScrW Then X := Max(0, ScrW - Wnds[W].W);
        If Y + 30 > TaskY Then Y := Max(0, TaskY - Wnds[W].H);
        If (X <> Wnds[W].X) Or (Y <> Wnds[W].Y) Then
          MoveW(W, X, Y, Wnds[W].W, Wnds[W].H, True);
      End;
      If Wnds[W].IKind = ikNone Then
        PostMsgW(W, $7E, 8, (ScrH Shl 16) Or ScrW);  { WM_DISPLAYCHANGE }
    End;
  If CurX >= ScrW Then CurX := ScrW - 1;
  If CurY >= ScrH Then CurY := ScrH - 1;
  TaskbarChanged;
  MarkAll;
  KLog('Ecran : ' + IntStr(ScrW) + 'x' + IntStr(ScrH) + 'x' +
       IntStr(ScrBpp) + ' (mode ' + HexStr(ScrMode, 3) + ')');
  KSetMode := True;
End;

Function DispCurBpp : LongInt;
Begin
  If VgaPlanar Then DispCurBpp := 4 Else DispCurBpp := ScrBpp;
End;

{ Rectangles de la boite (coordonnees ecran) }
Procedure DispRects(W : LongInt; Var CX, GY, GX1, GX2, SX1, SX2 : LongInt);
Var X1, Y1, X2, Y2 : LongInt;
Begin
  KClient(W, X1, Y1, X2, Y2);
  CX := (X1 + X2) Div 2;
  GY := Y1 + 196;
  GX1 := X1 + 16; GX2 := CX + 30;
  SX1 := CX + 66; SX2 := X2 - 32;
End;

{ Couleur de l'arc-en-ciel a la position T (0..255) }
Function SpectrumIdx(T : LongInt; Q : Boolean) : LongInt;
Var R, G, B, S, F : LongInt;
Begin
  S := (T * 6) Div 256; F := ((T * 6) Mod 256);
  Case S Of
    0 : Begin R := 255; G := F; B := 0 End;
    1 : Begin R := 255 - F; G := 255; B := 0 End;
    2 : Begin R := 0; G := 255; B := F End;
    3 : Begin R := 0; G := 255 - F; B := 255 End;
    4 : Begin R := F; G := 0; B := 255 End;
  Else
    Begin R := 255; G := 0; B := 255 - F End;
  End;
  If Q Then
  Begin
    { 16 couleurs : composantes 0, 128 ou 255 }
    If R > 170 Then R := 255 Else If R > 64 Then R := 128 Else R := 0;
    If G > 170 Then G := 255 Else If G > 64 Then G := 128 Else G := 0;
    If B > 170 Then B := 255 Else If B > 64 Then B := 128 Else B := 0;
  End;
  SpectrumIdx := NearestIdx(R, G, B);
End;

Procedure PaintDisplay(W : LongInt);
Var X1, Y1, X2, Y2, CX, MY, GY, GX1, GX2, SX1, SX2, I, PX, BX1, BY1,
    BX2, BY2 : LongInt; T : String;
Begin
  KClient(W, X1, Y1, X2, Y2);
  FBar(X1, Y1, X2, Y2, cSilver);
  DispRects(W, CX, GY, GX1, GX2, SX1, SX2);
  { onglet Parametres et son panneau }
  Edge(X1 + 6, Y2 - 40, X2 - 6, Y2 - 40, cSilver, cBlack);
  Edge(X1 + 6, Y1 + 26, X2 - 6, Y2 - 40, cWhite, cBlack);
  Edge(X1 + 7, Y1 + 27, X2 - 7, Y2 - 41, cSilver, cGray);
  FBar(X1 + 8, Y1 + 6, X1 + 108, Y1 + 27, cSilver);
  HLine(X1 + 8, X1 + 106, Y1 + 5, cWhite);
  VLine(X1 + 6, Y1 + 7, Y1 + 26, cWhite);
  VLine(X1 + 107, Y1 + 7, Y1 + 26, cBlack);
  VLine(X1 + 106, Y1 + 7, Y1 + 26, cGray);
  OutTxt(X1 + 18, Y1 + 9, L('Param'#138'tres', 'Settings', 'Einstellungen',
         'Impostazioni', 'Configuraci'#162'n'), cBlack);
  { moniteur }
  MY := Y1 + 40;
  Edge(CX - 86, MY, CX + 86, MY + 124, cWhite, cBlack);
  FBar(CX - 85, MY + 1, CX + 85, MY + 123, cSilver);
  Sunken(CX - 74, MY + 10, CX + 74, MY + 112, DeskColor);
  FBar(CX - 72, MY + 102, CX + 72, MY + 110, cSilver);
  FBar(CX - 70, MY + 104, CX - 56, MY + 108, cGray);
  FBar(CX - 34, MY + 30, CX + 40, MY + 84, cSilver);
  Edge(CX - 34, MY + 30, CX + 40, MY + 84, cWhite, cBlack);
  FBar(CX - 32, MY + 32, CX + 38, MY + 39, cNavy);
  FBar(CX - 30, MY + 42, CX + 36, MY + 82, cWhite);
  Edge(CX - 30, MY + 125, CX + 30, MY + 133, cWhite, cBlack);
  Edge(CX - 54, MY + 134, CX + 54, MY + 140, cWhite, cBlack);
  { palette de couleurs }
  GroupBox(GX1, GY, GX2, GY + 104, L('Palette de couleurs', 'Color palette',
           'Farbpalette', 'Tavolozza dei colori', 'Paleta de colores'));
  Sunken(GX1 + 10, GY + 20, GX2 - 10, GY + 43, cWhite);
  OutTxt(GX1 + 15, GY + 24, DepthName(Wnds[W].K1), cBlack);
  Raised(GX2 - 28, GY + 22, GX2 - 12, GY + 41, False);
  Arrow(GX2 - 23, GY + 30, 1, cBlack);
  Sunken(GX1 + 10, GY + 56, GX2 - 10, GY + 76, cWhite);
  For I := GX1 + 12 To GX2 - 12 Do
    VLine(I, GY + 58, GY + 74,
          SpectrumIdx(((I - GX1 - 12) * 255) Div Max(1, GX2 - GX1 - 24),
                      Wnds[W].K1 = 4));
  { zone d'ecran }
  GroupBox(CX + 42, GY, X2 - 16, GY + 104, L('Zone d'''#130'cran',
           'Desktop area', 'Desktop-Bereich', 'Area dello schermo',
           #160'rea de la pantalla'));
  OutTxt(CX + 54, GY + 20, L('Moins', 'Less', 'Weniger', 'Meno', 'Menos'),
         cBlack);
  T := L('Plus', 'More', 'Mehr', 'Pi'#151, 'M'#160's');
  OutTxt(X2 - 28 - TextW(T), GY + 20, T, cBlack);
  Sunken(SX1, GY + 46, SX2, GY + 50, cSilver);
  If ResN > 1 Then
    PX := SX1 + (Wnds[W].K2 * (SX2 - SX1)) Div (ResN - 1)
  Else PX := SX1;
  Raised(PX - 5, GY + 38, PX + 5, GY + 60, False);
  T := IntStr(ResW[Wnds[W].K2]) + L(' par ', ' by ', ' x ', ' x ', ' por ') +
       IntStr(ResH[Wnds[W].K2]) + L(' pixels', ' pixels', ' Pixel',
       ' pixel', ' p'#161'xeles');
  OutCenter(CX + 42, X2 - 16, GY + 72, T, cBlack);
  { boutons }
  For I := 0 To 2 Do
  Begin
    DlgBtnRect(W, I, 3, BX1, BY1, BX2, BY2);
    Case I Of
      0 : T := TxtOk;
      1 : T := TxtCancel;
    Else
      T := L('Appliquer', 'Apply', #154'bernehmen', 'Applica', 'Aplicar');
    End;
    PushButton(BX1, BY1, BX2, BY2, T, (PressWin = W) And (PressBtn = I),
               I = 0);
  End;
End;

Procedure DispOpen;
Var I, X, Y : LongInt;
Begin
  If (DispW >= 0) And Wnds[DispW].Used And
     (Wnds[DispW].IKind = ikDisplay) Then
  Begin
    ActivateW(DispW);
    Exit;
  End;
  DispDepths;
  X := Max(0, (ScrW - 460) Div 2); Y := Max(0, (TaskY - 384) Div 2);
  DispW := KCreate(ikDisplay, L('Propri'#130't'#130's de Affichage',
                   'Display Properties', 'Eigenschaften von Anzeige',
                   'Propriet'#133' - Schermo', 'Propiedades de Pantalla'),
                   icDisplay, X, Y, 460, 384,
                   WS_POPUP Or WS_CAPTION Or WS_SYSMENU, WS_EX_DLGMODALFRAME);
  If DispW < 0 Then Exit;
  Wnds[DispW].K1 := DispCurBpp;
  DispRes(Wnds[DispW].K1);
  Wnds[DispW].K2 := 0;
  For I := 0 To ResN - 1 Do
    If (ResW[I] = ScrW) And (ResH[I] = ScrH) Then Wnds[DispW].K2 := I;
  Wnds[DispW].K3 := 0;
  ShowW(DispW, True, True);
End;

{ Nouvelle profondeur choisie : garder la zone d'ecran si possible }
Procedure DispSetDepth(B : LongInt);
Var I, OW, OH, K : LongInt;
Begin
  If (DispW < 0) Or Not Wnds[DispW].Used Then Exit;
  DispRes(Wnds[DispW].K1);
  OW := ResW[Wnds[DispW].K2]; OH := ResH[Wnds[DispW].K2];
  Wnds[DispW].K1 := B;
  DispRes(B);
  K := 0;
  For I := 0 To ResN - 1 Do
    If ResW[I] * ResH[I] <= OW * OH Then K := I;
  Wnds[DispW].K2 := K;
  KRepaint(DispW);
End;

{ Appliquer : changement immediat (DISPI) ou au redemarrage }
Procedure DispApply(W : LongInt);
Var B, RW, RH, I : LongInt;
Begin
  B := Wnds[W].K1;
  DispRes(B);
  RW := ResW[Wnds[W].K2]; RH := ResH[Wnds[W].K2];
  If (B = DispCurBpp) And (RW = ScrW) And (RH = ScrH) Then Exit;
  CmosWrite($7A, B);
  CmosWrite($7C, RW Div 8);
  CmosWrite($7D, RH Div 8);
  CmosWrite($7B, $5A);
  I := VmFind(RW, RH, B);
  If (B <> 4) And KSetMode(I) Then
  Begin
    { la boite reste centree dans le nouvel ecran }
    MoveW(W, Max(0, (ScrW - Wnds[W].W) Div 2),
          Max(0, (TaskY - Wnds[W].H) Div 2), Wnds[W].W, Wnds[W].H, True);
    Exit;
  End;
  RebootAskW := MsgBoxOpen(L('Modification des param'#138'tres syst'#138'me',
    'System Settings Change', 'Ge'#132'nderte Systemeinstellungen',
    'Modifica impostazioni di sistema',
    'Cambio de configuraci'#162'n del sistema'),
    L('Vous devez red'#130'marrer l''ordinateur pour que les nouveaux ' +
      'param'#138'tres prennent effet.|Voulez-vous red'#130'marrer ' +
      'maintenant ?',
      'You must restart your computer before the new settings will ' +
      'take effect.|Do you want to restart your computer now?',
      'Die neuen Einstellungen werden erst nach einem Neustart ' +
      'wirksam.|Jetzt neu starten?',
      'Le nuove impostazioni avranno effetto al riavvio.|' +
      'Riavviare il computer adesso?',
      'Debe reiniciar el equipo para que la nueva configuraci'#162'n ' +
      'tenga efecto.|'#168'Desea reiniciar ahora?'), $24);
End;

Procedure DispAction(W, B : LongInt);
Begin
  Case B Of
    0 :
    Begin
      DestroyW(W);
      DispW := -1;
      DispApply(W);
    End;
    1 :
    Begin
      DestroyW(W);
      DispW := -1;
    End;
  Else
    DispApply(W);
    KRepaint(W);
  End;
End;

Procedure DispSlide(W, X : LongInt);
Var CX, GY, GX1, GX2, SX1, SX2, K : LongInt;
Begin
  DispRects(W, CX, GY, GX1, GX2, SX1, SX2);
  If ResN <= 1 Then K := 0
  Else K := ((X - SX1) * (ResN - 1) + (SX2 - SX1) Div 2) Div (SX2 - SX1);
  If K < 0 Then K := 0;
  If K > ResN - 1 Then K := ResN - 1;
  If K <> Wnds[W].K2 Then
  Begin
    Wnds[W].K2 := K;
    KRepaint(W);
  End;
End;

Procedure DisplayMouse(W, Msg, X, Y : LongInt);
Var I, CX, GY, GX1, GX2, SX1, SX2, BX1, BY1, BX2, BY2 : LongInt;
Begin
  X := X + Wnds[W].X + Wnds[W].CL; Y := Y + Wnds[W].Y + Wnds[W].CT;
  DispRects(W, CX, GY, GX1, GX2, SX1, SX2);
  DispRes(Wnds[W].K1);
  If Wnds[W].K3 = 1 Then
  Begin
    { curseur de la zone d'ecran tire a la souris }
    DispSlide(W, X);
    If Msg = WM_LBUTTONUP Then
    Begin
      Wnds[W].K3 := 0;
      CaptureWin := -1;
    End;
    Exit;
  End;
  If Msg = WM_LBUTTONDOWN Then
  Begin
    If InRect(X, Y, GX1 + 10, GY + 20, GX2 - 10, GY + 43) Then
    Begin
      DispDepths;
      OpenMenu(0, mnColors, GX1 + 10, GY + 44, False);
      Exit;
    End;
    If InRect(X, Y, SX1 - 8, GY + 34, SX2 + 8, GY + 64) Then
    Begin
      Wnds[W].K3 := 1;
      CaptureWin := W;
      DispSlide(W, X);
      Exit;
    End;
  End;
  For I := 0 To 2 Do
  Begin
    DlgBtnRect(W, I, 3, BX1, BY1, BX2, BY2);
    If InRect(X, Y, BX1, BY1, BX2, BY2) Then
    Begin
      If Msg = WM_LBUTTONDOWN Then
      Begin
        PressWin := W; PressBtn := I; CaptureWin := W;
        KRepaint(W);
      End
      Else If (Msg = WM_LBUTTONUP) And (PressWin = W) And (PressBtn = I)
      Then
      Begin
        PressWin := -1; CaptureWin := -1;
        DispAction(W, I);
      End;
      Exit;
    End;
  End;
  If Msg = WM_LBUTTONUP Then
  Begin
    If PressWin = W Then
    Begin
      PressWin := -1;
      KRepaint(W);
    End;
    CaptureWin := -1;
  End;
End;

Procedure DisplayKey(W, VK : LongInt);
Begin
  DispRes(Wnds[W].K1);
  If VK = $0D Then DispAction(W, 0)
  Else If VK = $1B Then DispAction(W, 1)
  Else If (VK = $25) And (Wnds[W].K2 > 0) Then
  Begin
    Dec(Wnds[W].K2);
    KRepaint(W);
  End
  Else If (VK = $27) And (Wnds[W].K2 < ResN - 1) Then
  Begin
    Inc(Wnds[W].K2);
    KRepaint(W);
  End;
End;

{ ------------------------------------------------------------------ }
{ Proprietes de Date/Heure (clic sur l'horloge de la barre des taches) }
{ ------------------------------------------------------------------ }
{ Comme celle de WINDOWS95-0 et de Windows 95 : onglets Date et heure
  (mois, annee, calendrier, horloge analogique, heure/minute/seconde)
  et Fuseau horaire (liste, carte du monde, heure d'ete). OK et
  Appliquer ecrivent l'horloge temps reel (CMOS) ; le fuseau est garde
  dans le CMOS (79h : numero + 1, bit 7 = sans heure d'ete). }

Function DaysIn(Y, M : LongInt) : LongInt;
Begin
  Case M Of
    4, 6, 9, 11 : DaysIn := 30;
    2 : If (Y Mod 4 = 0) And ((Y Mod 100 <> 0) Or (Y Mod 400 = 0)) Then
          DaysIn := 29 Else DaysIn := 28;
  Else
    DaysIn := 31;
  End;
End;

{ Fuseau horaire du systeme (CMOS 79h), Est (Canada) par defaut }
Procedure TzLoad;
Var V : LongInt;
Begin
  V := CmosRead($79);
  If ((V And $7F) >= 1) And ((V And $7F) <= TzCount) Then
  Begin
    TzCur := (V And $7F) - 1;
    TzDst := (V And $80) = 0;
  End
  Else
  Begin
    TzCur := 5; TzDst := True;
  End;
End;

{ Lire l'heure du systeme dans la boite (sauf ce qui a ete modifie) }
Procedure DtSync;
Begin
  ReadRtc;
  If Not DtTimeSet Then
  Begin
    DtH := RtcHour; DtMi := RtcMin; DtS := RtcSec;
  End;
  If Not DtDateSet Then
  Begin
    DtY := RtcYear; DtM := RtcMonth; DtD := RtcDay;
  End;
End;

Procedure DtOpen;
Begin
  If (DtW >= 0) And Wnds[DtW].Used And (Wnds[DtW].IKind = ikDateTime) Then
  Begin
    ActivateW(DtW);
    Exit;
  End;
  DtTab := 0; DtPress := -1;
  DtTimeSet := False; DtDateSet := False;
  DtTz := TzCur; DtDst := TzDst;
  DtSync;
  DtW := KCreate(ikDateTime, L('Propri'#130't'#130's de Date/Heure',
                 'Date/Time Properties', 'Eigenschaften von Datum/Uhrzeit',
                 'Propriet'#133' - Data/ora', 'Propiedades de Fecha y hora'),
                 icDisplay, Max(0, (ScrW - 450) Div 2),
                 Max(0, (TaskY - 362) Div 2), 450, 362,
                 WS_POPUP Or WS_CAPTION Or WS_SYSMENU, WS_EX_DLGMODALFRAME);
  If DtW >= 0 Then ShowW(DtW, True, True);
End;

{ Compteur heure (0), minute (1) ou seconde (2) : zone du nombre et
  boutons + (haut) et - (bas), coordonnees ecran }
Procedure DtSpinRect(W, K : LongInt; Var X1, Y1, X2, Y2 : LongInt);
Var CX1, CY1, CX2, CY2 : LongInt;
Begin
  KClient(W, CX1, CY1, CX2, CY2);
  X1 := CX1 + 244 + K * 62; Y1 := CY1 + 214;
  X2 := X1 + 40; Y2 := Y1 + 20;
End;

{ Cellule (Lig, Col) du calendrier }
Procedure DtCell(W, Lig, Col : LongInt; Var X1, Y1 : LongInt);
Var CX1, CY1, CX2, CY2 : LongInt;
Begin
  KClient(W, CX1, CY1, CX2, CY2);
  X1 := CX1 + 28 + Col * 27; Y1 := CY1 + 116 + Lig * 19;
End;

{ Aiguille de l'horloge : position P (0..59) du cadran, longueur R,
  epaisseur E }
Procedure ClkHand(CX, CY, P, R, E, C : LongInt);
Var X, Y, K : LongInt;
Begin
  X := CX + (R * ClkSin[P Mod 60]) Div 1000;
  Y := CY - (R * ClkSin[(P + 15) Mod 60]) Div 1000;
  For K := -E To E Do
  Begin
    DLine(CX + K, CY, X, Y, C);
    DLine(CX, CY + K, X, Y, C);
  End;
End;

Procedure PaintClock(CX, CY, R, H, M, S : LongInt);
Var I, X, Y : LongInt;
Begin
  Disc(CX + 2, CY + 2, R, cGray);
  Disc(CX, CY, R, cWhite);
  Circ(CX, CY, R, cBlack);
  For I := 0 To 59 Do
  Begin
    X := CX + ((R - 5) * ClkSin[I]) Div 1000;
    Y := CY - ((R - 5) * ClkSin[(I + 15) Mod 60]) Div 1000;
    If I Mod 5 = 0 Then Disc(X, Y, 2, cNavy) Else Pix(X, Y, cGray);
  End;
  OutTxt(CX - 8, CY - R + 9, '12', cBlack);
  OutTxt(CX + R - 22, CY - 8, '3', cBlack);
  OutTxt(CX - 4, CY + R - 27, '6', cBlack);
  OutTxt(CX - R + 14, CY - 8, '9', cBlack);
  ClkHand(CX, CY, (H Mod 12) * 5 + M Div 12, (R * 5) Div 10, 1, cBlack);
  ClkHand(CX, CY, M, (R * 8) Div 10, 0, cBlack);
  ClkHand(CX, CY, S, (R * 85) Div 100, 0, cRed);
  Disc(CX, CY, 3, cBlack);
End;

Procedure PaintSpin(X1, Y1, X2, Y2, V : LongInt; PUp, PDn : Boolean);
Begin
  Sunken(X1, Y1, X2, Y2, cWhite);
  OutTxt(X1 + 8, Y1 + 2, Pad2(V), cBlack);
  Raised(X2 + 2, Y1, X2 + 13, Y1 + 9, PUp);
  Arrow(X2 + 4, Y1 + 3, 2, cBlack);
  Raised(X2 + 2, Y1 + 11, X2 + 13, Y2, PDn);
  Arrow(X2 + 4, Y1 + 13, 1, cBlack);
End;

Procedure CheckBox(X, Y : LongInt; Const S : String; On : Boolean);
Begin
  Sunken(X, Y + 1, X + 12, Y + 13, cWhite);
  If On Then
  Begin
    DLine(X + 3, Y + 6, X + 5, Y + 9, cBlack);
    DLine(X + 3, Y + 7, X + 5, Y + 10, cBlack);
    DLine(X + 5, Y + 9, X + 9, Y + 4, cBlack);
    DLine(X + 5, Y + 10, X + 9, Y + 5, cBlack);
  End;
  OutTxt(X + 18, Y, S, cBlack);
End;

{ Onglet I : rectangle (coordonnees ecran) }
Procedure DtTabRect(W, I : LongInt; Var X1, Y1, X2, Y2 : LongInt);
Var CX1, CY1, CX2, CY2 : LongInt;
Begin
  KClient(W, CX1, CY1, CX2, CY2);
  Y1 := CY1 + 4; Y2 := CY1 + 26;
  If I = 0 Then
  Begin
    X1 := CX1 + 6; X2 := CX1 + 128;
  End
  Else
  Begin
    X1 := CX1 + 130; X2 := CX1 + 252;
  End;
End;

Procedure PaintDateTime(W : LongInt);
Var X1, Y1, X2, Y2, I, J, D, F, N, TX1, TY1, TX2, TY2, BX1, BY1, BX2,
    BY2, Ocean, Land, OceanH, LandH, Z0, Z1, C, MW : LongInt; T : String;
    Ch : Char;
Begin
  KClient(W, X1, Y1, X2, Y2);
  FBar(X1, Y1, X2, Y2, cSilver);
  { panneau et onglets }
  Edge(X1 + 6, Y1 + 26, X2 - 6, Y2 - 40, cWhite, cBlack);
  Edge(X1 + 7, Y1 + 27, X2 - 7, Y2 - 41, cSilver, cGray);
  For I := 0 To 1 Do
  Begin
    DtTabRect(W, I, TX1, TY1, TX2, TY2);
    If I = DtTab Then
    Begin
      TY1 := TY1 - 2;
      FBar(TX1, TY1, TX2, TY2 + 1, cSilver);
    End;
    HLine(TX1 + 2, TX2 - 2, TY1, cWhite);
    VLine(TX1, TY1 + 2, TY2, cWhite);
    Pix(TX1 + 1, TY1 + 1, cWhite);
    VLine(TX2, TY1 + 2, TY2, cBlack);
    VLine(TX2 - 1, TY1 + 1, TY2, cGray);
    If I = 0 Then
      T := L('Date et heure', 'Date & Time', 'Datum & Uhrzeit',
             'Data e ora', 'Fecha y hora')
    Else
      T := L('Fuseau horaire', 'Time Zone', 'Zeitzone', 'Fuso orario',
             'Zona horaria');
    OutCenter(TX1, TX2, TY1 + 4, T, cBlack);
  End;
  If DtTab = 0 Then
  Begin
    { date : mois, annee, calendrier }
    GroupBox(X1 + 16, Y1 + 44, X1 + 222, Y1 + 264, 'Date');
    Sunken(X1 + 26, Y1 + 62, X1 + 136, Y1 + 84, cWhite);
    OutTxt(X1 + 30, Y1 + 65, MonthName(DtM), cBlack);
    Raised(X1 + 118, Y1 + 64, X1 + 134, Y1 + 82, False);
    Arrow(X1 + 123, Y1 + 71, 1, cBlack);
    PaintSpin(X1 + 144, Y1 + 62, X1 + 196, Y1 + 84, 0, DtPress = 10,
              DtPress = 11);
    FBar(X1 + 147, Y1 + 65, X1 + 194, Y1 + 81, cWhite);
    OutTxt(X1 + 152, Y1 + 65, IntStr(DtY), cBlack);
    Sunken(X1 + 26, Y1 + 92, X1 + 216, Y1 + 254, cWhite);
    T := L('DLMMJVS', 'SMTWTFS', 'SMDMDFS', 'DLMMGVS', 'DLMXJVS');
    For J := 0 To 6 Do
    Begin
      DtCell(W, 0, J, TX1, TY1);
      FBar(TX1 - 2, Y1 + 95, TX1 + 24, Y1 + 112, cGray);
      OutTxt(TX1 + 8, Y1 + 96, T[J + 1], cWhite);
    End;
    F := DayOfWeek(DtY, DtM, 1);
    N := DaysIn(DtY, DtM);
    If DtD > N Then DtD := N;
    For D := 1 To N Do
    Begin
      I := (D - 1 + F) Div 7; J := (D - 1 + F) Mod 7;
      DtCell(W, I, J, TX1, TY1);
      T := IntStr(D);
      If D = DtD Then
      Begin
        FBar(TX1, TY1, TX1 + 23, TY1 + 17, cNavy);
        OutCenter(TX1, TX1 + 23, TY1 + 1, T, cWhite);
      End
      Else OutCenter(TX1, TX1 + 23, TY1 + 1, T, cBlack);
    End;
    { heure : horloge et compteurs }
    GroupBox(X1 + 232, Y1 + 44, X2 - 16, Y1 + 264,
             L('Heure', 'Time', 'Uhrzeit', 'Ora', 'Hora'));
    PaintClock((X1 + 232 + X2 - 16) Div 2, Y1 + 130, 64, DtH, DtMi, DtS);
    For I := 0 To 2 Do
    Begin
      DtSpinRect(W, I, TX1, TY1, TX2, TY2);
      Case I Of
        0 : Begin T := L('Heure', 'Hour', 'Std.', 'Ore', 'Hora'); N := DtH;
            End;
        1 : Begin T := 'Min'; N := DtMi; End;
      Else
        Begin T := L('Sec', 'Sec', 'Sek', 'Sec', 'Seg'); N := DtS; End;
      End;
      OutTxt(TX1, TY1 - 18, T, cBlack);
      PaintSpin(TX1, TY1, TX2, TY2, N, DtPress = I * 2,
                DtPress = I * 2 + 1);
    End;
    T := L('Fuseau horaire actuel : ', 'Current time zone: ', 'Zeitzone: ',
           'Fuso orario: ', 'Zona horaria: ');
    OutTxt(X1 + 16, Y1 + 272, T + Fit(TzName(DtTz), X2 - X1 - 24 - TextW(T)),
           cBlack);
  End
  Else
  Begin
    { fuseau horaire : liste et carte du monde }
    Sunken(X1 + 16, Y1 + 40, X2 - 16, Y1 + 62, cWhite);
    OutTxt(X1 + 21, Y1 + 43, Fit(TzName(DtTz), X2 - X1 - 60), cBlack);
    Raised(X2 - 34, Y1 + 42, X2 - 18, Y1 + 60, False);
    Arrow(X2 - 29, Y1 + 49, 1, cBlack);
    Sunken(X1 + 16, Y1 + 70, X2 - 16, Y1 + 252, cNavy);
    MW := X2 - X1 - 37;
    Ocean := NearestIdx(0, 64, 160); Land := NearestIdx(0, 144, 0);
    OceanH := NearestIdx(64, 128, 224); LandH := NearestIdx(160, 224, 64);
    { colonnes du fuseau : 15 degres par heure = 2,5 colonnes }
    Z0 := 30 + (TzOfs[DtTz] * 25 - 375) Div 600;
    Z1 := Z0 + 2;
    For I := 0 To 17 Do
      For J := 0 To 59 Do
      Begin
        Ch := WorldMap[I][J + 1];
        If (J >= Z0) And (J <= Z1) Then
        Begin
          If Ch = '#' Then C := LandH Else C := OceanH;
        End
        Else If Ch = '#' Then C := Land Else C := Ocean;
        FBar(X1 + 19 + (J * MW) Div 60, Y1 + 73 + I * 10,
             X1 + 18 + ((J + 1) * MW) Div 60, Y1 + 82 + I * 10, C);
      End;
    CheckBox(X1 + 16, Y1 + 262, L('Ajuster automatiquement pour l''heure ' +
             'd'''#130't'#130, 'Automatically adjust for daylight saving',
             'Sommerzeit automatisch anpassen', 'Ora legale automatica',
             'Ajustar para horario de verano'), DtDst);
  End;
  For I := 0 To 2 Do
  Begin
    DlgBtnRect(W, I, 3, BX1, BY1, BX2, BY2);
    Case I Of
      0 : T := TxtOk;
      1 : T := TxtCancel;
    Else
      T := L('Appliquer', 'Apply', #154'bernehmen', 'Applica', 'Aplicar');
    End;
    PushButton(BX1, BY1, BX2, BY2, T, (PressWin = W) And (PressBtn = I),
               I = 0);
  End;
End;

{ Appliquer : horloge temps reel et fuseau horaire }
Procedure DtApply;
Var V : LongInt;
Begin
  ReadRtc;
  If DtTimeSet Or DtDateSet Then
  Begin
    If Not DtTimeSet Then
    Begin
      DtH := RtcHour; DtMi := RtcMin; DtS := RtcSec;
    End;
    WriteRtc(DtY, DtM, DtD, DtH, DtMi, DtS);
    KLog('Date/Heure : ' + IntStr(DtY) + '-' + Pad2(DtM) + '-' + Pad2(DtD) +
         ' ' + Pad2(DtH) + ':' + Pad2(DtMi) + ':' + Pad2(DtS));
  End;
  TzCur := DtTz; TzDst := DtDst;
  V := DtTz + 1;
  If Not DtDst Then V := V Or $80;
  CmosWrite($79, V);
  DtTimeSet := False; DtDateSet := False;
  LastMinute := -1;
  TaskbarChanged;
End;

{ Compteur K (0..5 heure+, heure-, minute+...) }
Procedure DtStep(K : LongInt);
Var D : LongInt;
Begin
  If K Mod 2 = 0 Then D := 1 Else D := -1;
  Case K Div 2 Of
    0 : DtH := (DtH + D + 24) Mod 24;
    1 : DtMi := (DtMi + D + 60) Mod 60;
  Else
    DtS := (DtS + D + 60) Mod 60;
  End;
  DtTimeSet := True;
End;

Procedure DateTimeMouse(W, Msg, X, Y : LongInt);
Var I, J, X1, Y1, X2, Y2, CX1, CY1, CX2, CY2, D, F : LongInt;
Begin
  X := X + Wnds[W].X + Wnds[W].CL; Y := Y + Wnds[W].Y + Wnds[W].CT;
  KClient(W, CX1, CY1, CX2, CY2);
  If (Msg = WM_LBUTTONUP) And (DtPress >= 0) Then
  Begin
    DtPress := -1;
    CaptureWin := -1;
    KRepaint(W);
  End;
  If Msg = WM_LBUTTONDOWN Then
  Begin
    For I := 0 To 1 Do
    Begin
      DtTabRect(W, I, X1, Y1, X2, Y2);
      If InRect(X, Y, X1, Y1, X2, Y2) Then
      Begin
        DtTab := I;
        KRepaint(W);
        Exit;
      End;
    End;
    If DtTab = 0 Then
    Begin
      { mois : liste deroulante ; annee : compteur }
      If InRect(X, Y, CX1 + 26, CY1 + 62, CX1 + 136, CY1 + 84) Then
      Begin
        OpenMenu(0, mnMonths, CX1 + 26, CY1 + 85, False);
        Exit;
      End;
      If InRect(X, Y, CX1 + 198, CY1 + 62, CX1 + 209, CY1 + 84) Then
      Begin
        If Y <= CY1 + 71 Then
        Begin
          If DtY < 2099 Then Inc(DtY);
          DtPress := 10;
        End
        Else
        Begin
          If DtY > 2000 Then Dec(DtY);
          DtPress := 11;
        End;
        DtDateSet := True;
        CaptureWin := W;
        KRepaint(W);
        Exit;
      End;
      { jour du calendrier }
      F := DayOfWeek(DtY, DtM, 1);
      For D := 1 To DaysIn(DtY, DtM) Do
      Begin
        I := (D - 1 + F) Div 7; J := (D - 1 + F) Mod 7;
        DtCell(W, I, J, X1, Y1);
        If InRect(X, Y, X1, Y1, X1 + 23, Y1 + 17) Then
        Begin
          DtD := D; DtDateSet := True;
          KRepaint(W);
          Exit;
        End;
      End;
      { compteurs heure, minute, seconde }
      For I := 0 To 2 Do
      Begin
        DtSpinRect(W, I, X1, Y1, X2, Y2);
        If InRect(X, Y, X2 + 2, Y1, X2 + 13, Y2) Then
        Begin
          If Y <= Y1 + 9 Then J := I * 2 Else J := I * 2 + 1;
          DtStep(J);
          DtPress := J;
          CaptureWin := W;
          KRepaint(W);
          Exit;
        End;
      End;
    End
    Else
    Begin
      If InRect(X, Y, CX1 + 16, CY1 + 40, CX2 - 16, CY1 + 62) Then
      Begin
        OpenMenu(0, mnTz, CX1 + 16, CY1 + 63, False);
        Exit;
      End;
      If InRect(X, Y, CX1 + 16, CY1 + 262, CX2 - 16, CY1 + 276) Then
      Begin
        DtDst := Not DtDst;
        KRepaint(W);
        Exit;
      End;
      { clic sur la carte : fuseau le plus proche de la longitude }
      If InRect(X, Y, CX1 + 19, CY1 + 73, CX2 - 19, CY1 + 252) Then
      Begin
        D := (((X - CX1 - 19) * 60) Div (CX2 - CX1 - 37)) * 24 - 720;
        J := 0;
        For I := 1 To TzCount - 1 Do
          If Abs(TzOfs[I] - D) < Abs(TzOfs[J] - D) Then J := I;
        DtTz := J;
        KRepaint(W);
        Exit;
      End;
    End;
  End;
  For I := 0 To 2 Do
  Begin
    DlgBtnRect(W, I, 3, X1, Y1, X2, Y2);
    If InRect(X, Y, X1, Y1, X2, Y2) Then
    Begin
      If Msg = WM_LBUTTONDOWN Then
      Begin
        PressWin := W; PressBtn := I; CaptureWin := W;
        KRepaint(W);
      End
      Else If (Msg = WM_LBUTTONUP) And (PressWin = W) And (PressBtn = I)
      Then
      Begin
        PressWin := -1; CaptureWin := -1;
        If I <> 1 Then DtApply;
        If I = 2 Then KRepaint(W)
        Else
        Begin
          DestroyW(W);
          DtW := -1;
        End;
      End;
      Exit;
    End;
  End;
  If Msg = WM_LBUTTONUP Then
  Begin
    If PressWin = W Then
    Begin
      PressWin := -1;
      KRepaint(W);
    End;
    CaptureWin := -1;
  End;
End;

Procedure DateTimeKey(W, VK : LongInt);
Begin
  If VK = $0D Then
  Begin
    DtApply;
    DestroyW(W);
    DtW := -1;
  End
  Else If VK = $1B Then
  Begin
    DestroyW(W);
    DtW := -1;
  End
  Else If VK = 9 Then
  Begin
    DtTab := 1 - DtTab;
    KRepaint(W);
  End;
End;

{ Chaque seconde (tache 0) : l'horloge de la boite suit l'heure }
Procedure DtTick;
Begin
  If (DtW < 0) Or Not Wnds[DtW].Used Or (Wnds[DtW].IKind <> ikDateTime) Then
    Exit;
  If DtTimeSet Or (DtTab <> 0) Then Exit;
  If RtcSec = DtSec Then Exit;
  DtSec := RtcSec;
  DtSync;
  KRepaint(DtW);
End;

{ ------------------------------------------------------------------ }
{ Volume : icone de la barre des taches, reglage rapide, Controle du  }
{ volume (mixeur) et Proprietes de Multimedia (Audio)                 }
{ ------------------------------------------------------------------ }

Function TrayVolOn : Boolean;
Begin
  TrayVolOn := TrayVol And (SbOk Or OplOk);
End;

Function MixName(I : LongInt) : String;
Begin
  Case I Of
    0 : MixName := L('Contr'#147'le du volume', 'Volume Control',
                     'Lautst'#132'rke', 'Controllo volume',
                     'Control de volumen');
    1 : MixName := 'Wave';
    2 : MixName := 'MIDI';
    3 : MixName := L('CD audio', 'CD Audio', 'Audio-CD', 'CD audio',
                     'CD de audio');
  Else
    MixName := L('Ligne', 'Line In', 'Line-In', 'Linea', 'L'#161'nea');
  End;
End;

Function MixVol(I : LongInt) : LongInt;
Begin
  MixVol := Max(MixVolL[I], MixVolR[I]);
End;

{ Balance -100 (gauche) .. 100 (droite) }
Function MixBal(I : LongInt) : LongInt;
Var V : LongInt;
Begin
  V := MixVol(I);
  If V = 0 Then MixBal := 0
  Else MixBal := ((MixVolR[I] - MixVolL[I]) * 100) Div V;
End;

Procedure MixSet(I, V, B : LongInt);
Begin
  V := Max(0, Min(255, V)); B := Max(-100, Min(100, B));
  If B >= 0 Then
  Begin
    MixVolR[I] := V; MixVolL[I] := (V * (100 - B)) Div 100;
  End
  Else
  Begin
    MixVolL[I] := V; MixVolR[I] := (V * (100 + B)) Div 100;
  End;
  SndApplyVol;
End;

{ Curseur vertical (X : axe, Y1..Y2 : course, V : 0..255) }
Procedure VSlider(X, Y1, Y2, V : LongInt);
Var I, TY : LongInt;
Begin
  For I := 0 To 8 Do
    HLine(X + 12, X + 15, Y1 + (I * (Y2 - Y1)) Div 8, cBlack);
  Sunken(X - 2, Y1 - 2, X + 2, Y2 + 2, cBlack);
  TY := Y2 - (V * (Y2 - Y1)) Div 255;
  Raised(X - 10, TY - 4, X + 10, TY + 4, False);
  HLine(X - 7, X + 7, TY, cGray);
End;

{ Curseur horizontal (balance -100..100) }
Procedure HSlider(X1, X2, Y, V : LongInt);
Var TX : LongInt;
Begin
  Sunken(X1 - 2, Y - 2, X2 + 2, Y + 2, cBlack);
  TX := X1 + ((V + 100) * (X2 - X1)) Div 200;
  Raised(TX - 4, Y - 8, TX + 4, Y + 8, False);
End;

{ Reglage rapide (clic sur l'icone) : volume general et Muet, ferme
  comme un menu (clic ailleurs) }
Procedure VolPopOpen;
Var W : LongInt;
Begin
  CloseMenus(0);
  W := KCreate(ikVolPop, '', 0, ScrW - 84, TaskY - 152, 80, 150, WS_POPUP,
               WS_EX_TOPMOST Or WS_EX_TOOLWINDOW);
  If W < 0 Then Exit;
  Wnds[W].K1 := 0; Wnds[W].K2 := -1;
  MenuW[0] := W; MenuDepth := 1;
  ShowW(W, True, False);
  ZTop(W);
End;

Procedure PaintVolPop(W : LongInt);
Var X, Y, WW, HH : LongInt;
Begin
  X := Wnds[W].X; Y := Wnds[W].Y; WW := Wnds[W].W; HH := Wnds[W].H;
  Edge(X, Y, X + WW - 1, Y + HH - 1, cSilver, cBlack);
  Edge(X + 1, Y + 1, X + WW - 2, Y + HH - 2, cWhite, cGray);
  FBar(X + 2, Y + 2, X + WW - 3, Y + HH - 3, cSilver);
  OutCenter(X, X + WW - 1, Y + 6, 'Volume', cBlack);
  VSlider(X + 34, Y + 30, Y + 112, MixVol(0));
  CheckBox(X + 12, Y + 126, L('Muet', 'Mute', 'Stumm', 'Muto', 'Silencio'),
           MixMute[0]);
End;

Procedure VolSlideTo(W, Y, Y1, Y2, Line : LongInt);
Begin
  MixSet(Line, ((Y2 - Y) * 255) Div Max(1, Y2 - Y1), MixBal(Line));
  KRepaint(W);
  If (MixW0 >= 0) And Wnds[MixW0].Used Then KRepaint(MixW0);
End;

Procedure VolPopMouse(W, Msg, X, Y : LongInt);
Begin
  X := X + Wnds[W].X; Y := Y + Wnds[W].Y;
  If Msg = WM_LBUTTONDOWN Then
  Begin
    If InRect(X, Y, Wnds[W].X + 20, Wnds[W].Y + 22, Wnds[W].X + 48,
              Wnds[W].Y + 120) Then
    Begin
      Wnds[W].K2 := 0; CaptureWin := W;
      VolSlideTo(W, Y, Wnds[W].Y + 30, Wnds[W].Y + 112, 0);
    End
    Else If Y >= Wnds[W].Y + 122 Then
    Begin
      MixMute[0] := Not MixMute[0];
      SndApplyVol;
      KRepaint(W); TaskbarChanged;
      If (MixW0 >= 0) And Wnds[MixW0].Used Then KRepaint(MixW0);
    End;
  End
  Else If (Msg = WM_MOUSEMOVE) And (Wnds[W].K2 = 0) Then
    VolSlideTo(W, Y, Wnds[W].Y + 30, Wnds[W].Y + 112, 0)
  Else If Msg = WM_LBUTTONUP Then
  Begin
    Wnds[W].K2 := -1; CaptureWin := -1;
  End;
End;

{ Controle du volume : une colonne par source (general, Wave, MIDI,
  CD audio, ligne) : balance, volume, Muet }
Procedure MixerOpen;
Begin
  If (MixW0 >= 0) And Wnds[MixW0].Used And (Wnds[MixW0].IKind = ikMixer) Then
  Begin
    ActivateW(MixW0);
    Exit;
  End;
  MixW0 := KCreate(ikMixer, MixName(0), icSpeaker, Max(0, (ScrW - 520) Div 2),
                   Max(0, (TaskY - 300) Div 2), 520, 300,
                   WS_OVERLAPPED Or WS_CAPTION Or WS_SYSMENU Or
                   WS_MINIMIZEBOX, 0);
  If MixW0 < 0 Then Exit;
  Wnds[MixW0].K2 := -1;
  ShowW(MixW0, True, True);
End;

Procedure MixCol(W, I : LongInt; Var X1, Y1, X2, Y2 : LongInt);
Var CX1, CY1, CX2, CY2 : LongInt;
Begin
  KClient(W, CX1, CY1, CX2, CY2);
  X1 := CX1 + 4 + I * ((CX2 - CX1 - 8) Div MixLines);
  X2 := X1 + (CX2 - CX1 - 8) Div MixLines - 4;
  Y1 := CY1 + 4; Y2 := CY2 - 22;
End;

Procedure PaintMixer(W : LongInt);
Var X1, Y1, X2, Y2, I, CX : LongInt; T : String;
Begin
  KClient(W, X1, Y1, X2, Y2);
  FBar(X1, Y1, X2, Y2, cSilver);
  For I := 0 To MixLines - 1 Do
  Begin
    MixCol(W, I, X1, Y1, X2, Y2);
    If I > 0 Then
    Begin
      VLine(X1 - 3, Y1, Y2, cGray); VLine(X1 - 2, Y1, Y2, cWhite);
    End;
    If I = 0 Then
      T := L('G'#130'n'#130'ral', 'Master', 'Gesamt', 'Generale', 'General')
    Else T := MixName(I);
    OutCenter(X1, X2, Y1 + 4, Fit(T, X2 - X1), cBlack);
    CX := (X1 + X2) Div 2;
    OutTxt(X1 + 6, Y1 + 30, 'Balance :', cBlack);
    OutTxt(X1 + 4, Y1 + 50, 'G', cBlack);
    OutTxt(X2 - 10, Y1 + 50, 'D', cBlack);
    HSlider(X1 + 18, X2 - 18, Y1 + 58, MixBal(I));
    OutTxt(X1 + 6, Y1 + 78, 'Volume :', cBlack);
    VSlider(CX - 4, Y1 + 104, Y2 - 40, MixVol(I));
    If I = 0 Then
      T := L('Tout muet', 'Mute all', 'Alles stumm', 'Disattiva tutto',
             'Silenciar todo')
    Else T := L('Muet', 'Mute', 'Stumm', 'Muto', 'Silencio');
    CheckBox(X1 + 6, Y2 - 22, T, MixMute[I]);
  End;
  KClient(W, X1, Y1, X2, Y2);
  HLine(X1, X2, Y2 - 20, cGray); HLine(X1, X2, Y2 - 19, cWhite);
  If SbOk Then T := SbName Else T := L('Synth'#130'tiseur FM (OPL2)',
                                       'FM Synthesizer (OPL2)', 'OPL2', 'OPL2',
                                       'OPL2');
  OutTxt(X1 + 6, Y2 - 16, T, cBlack);
End;

Procedure MixerMouse(W, Msg, X, Y : LongInt);
Var I, X1, Y1, X2, Y2, CX, K : LongInt;
Begin
  X := X + Wnds[W].X + Wnds[W].CL; Y := Y + Wnds[W].Y + Wnds[W].CT;
  K := Wnds[W].K2;
  If (Msg = WM_MOUSEMOVE) And (K >= 0) Then
  Begin
    MixCol(W, K Mod 10, X1, Y1, X2, Y2);
    If K >= 10 Then
      MixSet(K Mod 10, MixVol(K Mod 10),
             ((X - X1 - 18) * 200) Div Max(1, X2 - X1 - 36) - 100)
    Else
      MixSet(K, ((Y2 - 40 - Y) * 255) Div Max(1, Y2 - 40 - Y1 - 104),
             MixBal(K));
    KRepaint(W);
    TaskbarChanged;
    Exit;
  End;
  If Msg = WM_LBUTTONUP Then
  Begin
    Wnds[W].K2 := -1; CaptureWin := -1;
    Exit;
  End;
  If Msg <> WM_LBUTTONDOWN Then Exit;
  For I := 0 To MixLines - 1 Do
  Begin
    MixCol(W, I, X1, Y1, X2, Y2);
    CX := (X1 + X2) Div 2;
    If InRect(X, Y, X1 + 6, Y2 - 24, X2, Y2 - 6) Then
    Begin
      MixMute[I] := Not MixMute[I];
      SndApplyVol;
      KRepaint(W); TaskbarChanged;
      Exit;
    End;
    If InRect(X, Y, X1 + 10, Y1 + 48, X2 - 10, Y1 + 68) Then
    Begin
      Wnds[W].K2 := 10 + I; CaptureWin := W;
      MixerMouse(W, WM_MOUSEMOVE, X - Wnds[W].X - Wnds[W].CL,
                 Y - Wnds[W].Y - Wnds[W].CT);
      Exit;
    End;
    If InRect(X, Y, CX - 16, Y1 + 96, CX + 12, Y2 - 32) Then
    Begin
      Wnds[W].K2 := I; CaptureWin := W;
      MixerMouse(W, WM_MOUSEMOVE, X - Wnds[W].X - Wnds[W].CL,
                 Y - Wnds[W].Y - Wnds[W].CT);
      Exit;
    End;
  End;
End;

{ Proprietes de Multimedia, onglet Audio : peripheriques de lecture
  (Wave et MIDI), volume et icone de la barre des taches }
Procedure AudioOpen;
Begin
  If (AudW >= 0) And Wnds[AudW].Used And (Wnds[AudW].IKind = ikAudio) Then
  Begin
    ActivateW(AudW);
    Exit;
  End;
  AudW := KCreate(ikAudio, L('Propri'#130't'#130's de Multim'#130'dia',
                  'Multimedia Properties', 'Eigenschaften von Multimedia',
