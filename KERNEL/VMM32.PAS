{ Procedure par defaut des fenetres                                  }
{ ------------------------------------------------------------------ }

Function DefWindowProcA(H, Msg, WP, LP : LongInt) : LongInt;
Var W, Hdc, C : LongInt;
Begin
  DefWindowProcA := 0;
  W := WndOf(H);
  If W < 0 Then Exit;
  Case Msg Of
    WM_NCCREATE : DefWindowProcA := 1;
    WM_CLOSE : DestroyW(W);
    WM_PAINT :
    Begin
      { BeginPaint/EndPaint : envoie WM_ERASEBKGND si necessaire }
      C := KAlloc(64);
      If C <> 0 Then
      Begin
        BeginPaint(H, C);
        EndPaint(H, C);
        KFree(C);
      End;
      SetR(Wnds^[W].Upd, 0, 0, 0, 0);
      Wnds^[W].UpdErase := False;
    End;
    WM_ERASEBKGND :
    Begin
      EraseBkgnd(W, WP);
      DefWindowProcA := 1;
    End;
    WM_SETTEXT :
    Begin
      WndSetTextA(W, LP);
      Wnds^[W].NeedNc := True;
      TaskbarChanged;
      DefWindowProcA := 1;
    End;
    WM_GETTEXT :
    Begin
      Begin
        DefWindowProcA := WndGetTextZ(W, LP, WP);
        If AnsiApp Then CvtZ(LP, -1, False);
      End;
    End;
    WM_GETTEXTLENGTH : DefWindowProcA := WndTextLen(W);
    WM_SYSCOMMAND : SysCommand(TopOf(W), WP);
    WM_SYSKEYDOWN :
      If WP = $73 Then PostMsgW(TopOf(W), WM_CLOSE, 0, 0);
    WM_SETCURSOR :
    Begin
      C := Classes^[Wnds^[W].Cls].Cursor;
      If C <> 0 Then SetCursor(C);
      DefWindowProcA := Ord(C <> 0);
    End;
    WM_MOUSEACTIVATE : DefWindowProcA := 1;
    WM_NCHITTEST : DefWindowProcA := 1;
    WM_ACTIVATE :
      { message poste apres l'activation : un enfant qui a deja recu le
        focus (SetFocus apres ShowWindow) le garde ; sinon le dernier
        enfant qui l'avait, sinon la fenetre }
      If (WP And $FFFF) <> 0 Then
      Begin
        C := Wnds^[W].FocusChild - 1;
        If (FocusWin >= 0) And Wnds^[FocusWin].Used And
           IsChildW(FocusWin) And (TopOf(FocusWin) = W) Then
        Else If (C >= 0) And Wnds^[C].Used And IsChildW(C) And
                (TopOf(C) = W) And WndVisible(C) Then SetFocusW(C)
        Else SetFocusW(W);
      End;
    WM_CTLCOLORMSGBOX..WM_CTLCOLORSTATIC :
    Begin
      SetBkColor(WP, $C0C0C0);
      DefWindowProcA := GdiH(KBrushOf(16));
    End;
    WM_QUERYNEWPALETTE : DefWindowProcA := 0;
    WM_SHOWWINDOW : ;
  End;
  Hdc := 0;
End;

Function DefFrameProcA(H, HC, Msg, WP, LP : LongInt) : LongInt;
Begin
  DefFrameProcA := DefWindowProcA(H, Msg, WP, LP);
End;

Function DefMDIChildProcA(H, Msg, WP, LP : LongInt) : LongInt;
Begin
  DefMDIChildProcA := DefWindowProcA(H, Msg, WP, LP);
End;

Function CallWindowProcA(P, H, Msg, WP, LP : LongInt) : LongInt;
Var W : LongInt;
Begin
  CallWindowProcA := 0;
  If (P >= KProcToken) And (P < KProcToken + 64) Then
  Begin
    W := WndOf(H);
    If W >= 0 Then CallWindowProcA := KWndProc(W, Msg, WP, LP);
    Exit;
  End;
  If P <> 0 Then CallWindowProcA := CallProc(P, H, Msg, WP, LP);
End;

{ ------------------------------------------------------------------ }
{ Boites de dialogue (modeles DLGTEMPLATE et DLGTEMPLATEEX)          }
{ ------------------------------------------------------------------ }

{ unites de dialogue -> points (base 6 x 13 : 1,5 et 1,625 point) }
Function DluX(V : LongInt) : LongInt;
Begin
  If V >= 0 Then DluX := (V * 6 + 2) Div 4
  Else DluX := -((-V * 6 + 2) Div 4);
End;

Function DluY(V : LongInt) : LongInt;
Begin
  If V >= 0 Then DluY := (V * 13 + 4) Div 8
  Else DluY := -((-V * 13 + 4) Div 8);
End;

{ Element sz_Or_Ord : chaine ou ordinal ; rend l'adresse suivante }
Function Sx16(V : LongInt) : LongInt;
Begin
  V := V And $FFFF;
  If V >= 32768 Then V := V - 65536;
  Sx16 := V;
End;

{ Texte Unicode (ASCIIZ large) d'une ressource vers la fenetre W, meme
  au-dela de 254 caracteres }
Procedure WndSetTextW(W, A : LongInt);
Var N, B, I, H : LongInt; An : Boolean;
Begin
  N := 0;
  While MemW[0:A + N * 2] <> 0 Do Inc(N);
  H := HeapOwner; HeapOwner := 0;
  B := KAlloc(N + 1);
  HeapOwner := H;
  If B = 0 Then Exit;
  An := AnsiApp;
  For I := 0 To N - 1 Do Mem[0:B + I] := Ord(UniOem(MemW[0:A + I * 2], An));
  Mem[0:B + N] := 0;
  WndSetTextZ(W, B);
  KFree(B);
End;

Function SzOrOrd(A : LongInt; Var S : String; Var Ord0 : LongInt)
  : LongInt;
Var C : LongInt; An : Boolean;
Begin
  S := ''; Ord0 := 0;
  C := MemW[0:A];
  If C = 0 Then
  Begin
    SzOrOrd := A + 2;
    Exit;
  End;
  If C = $FFFF Then
  Begin
    Ord0 := MemW[0:A + 2];
    SzOrOrd := A + 4;
    Exit;
  End;
  An := AnsiApp;
  While MemW[0:A] <> 0 Do
  Begin
    If Length(S) < 254 Then S := S + UniOem(MemW[0:A], An);
    A := A + 2;
  End;
  SzOrOrd := A + 2;
End;

Function DlgCreate(Inst, T, Parent, Proc, Lp : LongInt) : LongInt;
Var Ex, Style, N, X, Y, CX, CY, A, I, Ord0, Cls, W, C, B, TT, Id,
    IStyle, IEx, Focus, CC : LongInt; Ext : Boolean; S, Title, ClsN : String;
    P, TA, DFont : LongInt; IcoN : String;
Begin
  DlgCreate := -1;
  Ext := MemL[0:T] = LongInt($FFFF0001);
  If Ext Then
  Begin
    Ex := MemL[0:T + 8]; Style := MemL[0:T + 12]; N := MemW[0:T + 16];
    X := Sx16(MemW[0:T + 18]); Y := Sx16(MemW[0:T + 20]);
    CX := MemW[0:T + 22]; CY := MemW[0:T + 24];
    A := T + 26;
  End
  Else
  Begin
    Style := MemL[0:T]; Ex := MemL[0:T + 4]; N := MemW[0:T + 8];
    X := Sx16(MemW[0:T + 10]); Y := Sx16(MemW[0:T + 12]);
    CX := MemW[0:T + 14]; CY := MemW[0:T + 16];
    A := T + 18;
  End;
  A := SzOrOrd(A, S, Ord0);            { menu }
  A := SzOrOrd(A, ClsN, Ord0);         { classe }
  A := SzOrOrd(A, Title, Ord0);        { titre }
  If (Style And $40) <> 0 Then
  Begin
    If Ext Then A := A + 6 Else A := A + 2;
    A := SzOrOrd(A, S, Ord0);
  End;
  Cls := KClass[ikDialog];
  If ClsN <> '' Then
  Begin
    C := ClassFind(ClsN);
    If C >= 0 Then Cls := C;
  End;
  NcSize(Style, Ex, False, B, TT);
  CX := DluX(CX) + 2 * B; CY := DluY(CY) + TT + B;
  If ((Style And $800) <> 0) Or (Parent = 0) Then
  Begin
    X := (ScrW - CX) Div 2; Y := (TaskY - CY) Div 2;
  End
  Else
  Begin
    W := WndOf(Parent);
    If W >= 0 Then
    Begin
      ClientScreenOrg(W, I, C);
      X := DluX(X) + I; Y := DluY(Y) + C;
    End
    Else
    Begin
      X := DluX(X); Y := DluY(Y);
    End;
  End;
  W := CreateW(Ex, Cls, Title, (Style And Not WS_VISIBLE) And
               Not WS_CHILD, X, Y, CX, CY, WndOf(Parent), 0, Inst, Lp);
  If W < 0 Then Exit;
  Wnds^[W].Proc := 0;
  Wnds^[W].IKind := ikDialog;
  Wnds^[W].DlgProc := Proc;
  Wnds^[W].Thread := CurT;
  Wnds^[W].K4 := icApp;
  Focus := -1;
  For I := 0 To N - 1 Do
  Begin
    A := (A + 3) And Not 3;
    If Ext Then
    Begin
      IEx := MemL[0:A + 4]; IStyle := MemL[0:A + 8];
      X := Sx16(MemW[0:A + 12]); Y := Sx16(MemW[0:A + 14]);
      CX := MemW[0:A + 16]; CY := MemW[0:A + 18]; Id := MemL[0:A + 20];
      A := A + 24;
    End
    Else
    Begin
      IStyle := MemL[0:A]; IEx := MemL[0:A + 4];
      X := Sx16(MemW[0:A + 8]); Y := Sx16(MemW[0:A + 10]);
      CX := MemW[0:A + 12]; CY := MemW[0:A + 14]; Id := MemW[0:A + 16];
      A := A + 18;
    End;
    A := SzOrOrd(A, ClsN, Ord0);
    If Ord0 <> 0 Then
    Begin
      ClsN := '';
      CC := -1;
      Case Ord0 Of
        $80 : CC := KClass[ikButton];
        $81 : CC := KClass[ikEdit];
        $82 : CC := KClass[ikStatic];
        $83 : CC := KClass[ikListBox];
        $84 : CC := KClass[ikScrollBar];
        $85 : CC := KClass[ikComboBox];
      End;
    End
    Else CC := ClassFind(ClsN);
    TA := A;
    A := SzOrOrd(A, S, Ord0);
    If S <> '' Then KLog('  dialogue "' + Title + '" : ' + Copy(S, 1, 70));
    P := MemW[0:A];
    A := A + 2 + P;
    If CC < 0 Then CC := KClass[ikStatic];
    C := CreateW(IEx, CC, S, (IStyle Or WS_CHILD) And Not WS_VISIBLE,
                 DluX(X), DluY(Y), DluX(X + CX) - DluX(X),
                 DluY(Y + CY) - DluY(Y), W, Id, Inst, 0);
    If C >= 0 Then
    Begin
      If (Length(S) >= 127) And (MemW[0:TA] <> $FFFF) Then
        WndSetTextW(C, TA);
      If (IStyle And WS_VISIBLE) <> 0 Then Wnds^[C].Visible := True;
      If (IStyle And WS_DISABLED) <> 0 Then Wnds^[C].Enabled := False;
      { statique SS_ICON : l'icone nommee (ou numerotee) du modele }
      If (CC = KClass[ikStatic]) And ((IStyle And $1F) = 3) Then
        If MemW[0:TA] = $FFFF Then
          Wnds^[C].Icon := LoadIconA(Inst, MemW[0:TA + 2])
        Else If S <> '' Then
        Begin
          IcoN := S + #0;
          Wnds^[C].Icon := LoadIconA(Inst, LongInt(@IcoN[1]));
        End;
      If (Focus < 0) And ((IStyle And $10000) <> 0) Then Focus := C;
    End;
  End;
  { police du dialogue (MS Sans Serif 8, rendue en 6x13) : WM_GETFONT
    du dialogue et de ses controles }
  IcoN := 'MS Sans Serif'#0;
  DFont := CreateFontA(-11, 0, 0, 0, 400, 0, 0, 0, 0, 0, 0, 0, 0,
                       LongInt(@IcoN[1]));
  Wnds^[W].Font := DFont;
  For I := 0 To MaxWnd - 1 Do
    If Wnds^[I].Used And (Wnds^[I].Parent = W) And (Wnds^[I].Font = 0) Then
      Wnds^[I].Font := DFont;
  If Proc <> 0 Then
    If CallProc(Proc, HwndOf(W), WM_INITDIALOG, HwndOf(Focus), Lp) <> 0 Then
      If Focus >= 0 Then SetFocusW(Focus);
  If Wnds^[W].Used And ((Style And WS_VISIBLE) <> 0) Then ShowW(W, True, True);
  Wnds^[W].KNeedPaint := True;
  DlgCreate := W;
End;

