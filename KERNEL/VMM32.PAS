  DV_CreateEB := DDERR_INVALIDPARAMS;
  If (PDesc = 0) Or (PP = 0) Then Exit;
  N := MemL[0:PDesc + 12];
  If (N <= 0) Or (N > 16 * 1024 * 1024) Then Exit;
  C := ComNew(0, 15, 128);
  ComView(C, 0, VtEB);
  MemL[0:C + 64] := N;
  MemL[0:C + 68] := KAlloc(N + 16);
  FillMem(MemL[0:C + 68], N, 0);
  MemL[0:C + 72] := MemL[0:PDesc + 8];
  MemL[0:C + 76] := 48;
  MemL[0:PP] := C;
