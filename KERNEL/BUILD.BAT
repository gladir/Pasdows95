@ECHO OFF
REM BUILD.BAT - Construit Pasdows 95 et le CD-ROM amorcable IMAGE\PASDOWS.ISO
REM (a lancer depuis le dossier KERNEL, Free Pascal dans le PATH)
REM   WPC -CW95IO IO.PAS IO.SYS        IO.SYS amorcable (El Torito)
REM   WPC -CVMM32 VMM32.PAS VMM32.VXD  noyau 32 bits et API Win32
REM   WPC -CW32 ..\EXEMPLES\*.PAS      exemples de programmes Windows 95
REM Tous les fichiers de IMAGE\CDROM sont copies sur le CD-ROM.
IF NOT EXIST ..\BUILD\NUL MD ..\BUILD
IF NOT EXIST ..\BUILD\CD\NUL MD ..\BUILD\CD
ECHO == Outils (Free Pascal)
fpc -O1 -FE..\BUILD ..\TOOLS\WPC.PAS
IF ERRORLEVEL 1 GOTO ERREUR
fpc -FE..\BUILD ..\TOOLS\MAKEISO.PAS
IF ERRORLEVEL 1 GOTO ERREUR
ECHO == Contenu du CD-ROM
DEL /Q ..\BUILD\CD\*.* > NUL
COPY ..\IMAGE\CDROM\*.* ..\BUILD\CD > NUL
ECHO == IO.SYS (WPC -CW95IO)
..\BUILD\WPC -CW95IO IO.PAS ..\BUILD\CD\IO.SYS
IF ERRORLEVEL 1 GOTO ERREUR
ECHO == VMM32.VXD (WPC -CVMM32)
..\BUILD\WPC -CVMM32 VMM32.PAS ..\BUILD\CD\VMM32.VXD
IF ERRORLEVEL 1 GOTO ERREUR
ECHO == Exemples Win32 (WPC -CW32)
FOR %%F IN (..\EXEMPLES\*.PAS) DO ..\BUILD\WPC -CW32 %%F ..\BUILD\CD\%%~nF.EXE
FOR %%F IN (..\EXEMPLES\*.PAS) DO COPY ..\BUILD\CD\%%~nF.EXE ..\IMAGE\CDROM > NUL
ECHO == CD-ROM amorcable
..\BUILD\MAKEISO ..\IMAGE\PASDOWS.ISO /BOOT:..\BUILD\CD\IO.SYS /LABEL:PASDOWS95 ..\BUILD\CD\*.*
IF ERRORLEVEL 1 GOTO ERREUR
COPY ..\BUILD\CD\IO.SYS ..\IMAGE\CDROM > NUL
COPY ..\BUILD\CD\VMM32.VXD ..\IMAGE\CDROM > NUL
ECHO Termine : ..\IMAGE\PASDOWS.ISO
GOTO FIN
:ERREUR
ECHO Erreur de compilation.
:FIN
