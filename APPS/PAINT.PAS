Procedure OcDecodeError(Reason: String);
Begin
  OcrFailed := True;
End;

Function OcReadBin: Integer;
Begin
  If OcInPos >= OcInLen Then
  Begin
    {$I-}
    BlockRead(OcBinFile, OcInBuf, SizeOf(OcInBuf), OcInLen);
    {$I+}
    If IOResult <> 0 Then OcInLen := 0;
    OcInPos := 0;
    If OcInLen = 0 Then
    Begin
      OcReadBin := -1;
      Exit;
    End;
  End;
  OcReadBin := OcInBuf[OcInPos];
  Inc(OcInPos);
  Inc(OcBinPosition);
End;

Function OcNeedByte: Byte;
Var
  OcValue: Integer;
Begin
  OcValue := OcReadBin;
  If OcValue < 0 Then OcDecodeError('fin de fichier image inattendue.');
  OcNeedByte := OcValue;
End;

Procedure OcSkipBytes(OcCount: Longint);
Var
  OcDummy: Byte;
Begin
  While OcCount > 0 Do
  Begin
    OcDummy := OcNeedByte;
    Dec(OcCount);
  End;
End;

Function OcReadBE16: Integer;
Var
  OcHigh: Integer;
Begin
  OcHigh := OcNeedByte;
  OcReadBE16 := OcHigh * 256 + OcNeedByte;
End;

Function OcReadBE32: Longint;
Var
  OcValue: Longint;
  OcI: Integer;
Begin
  OcValue := 0;
  For OcI := 1 To 4 Do
    OcValue := (OcValue Shl 8) Or OcNeedByte;
  OcReadBE32 := OcValue;
End;

Function OcReadLE32: Longint;
Var
  OcValue: Longint;
  OcI: Integer;
Begin
  OcValue := 0;
  For OcI := 0 To 3 Do
    OcValue := OcValue Or (Longint(OcNeedByte) Shl (8 * OcI));
  OcReadLE32 := OcValue;
End;

Function OcReadLE16: Integer;
Var
  OcLow: Integer;
Begin
  OcLow := OcNeedByte;
  OcReadLE16 := OcLow + OcNeedByte * 256;
End;

Function OcGrayOf(Red, Green, Blue: Integer): Integer;
Begin
  OcGrayOf := (77 * Longint(Red) + 150 * Longint(Green) + 29 * Longint(Blue)) Div 256;
End;

{ Memoire de tas disponible (Turbo Pascal) ; Free Pascal alloue a la demande. }
Function OcAvailableMemory: Longint;
Begin
{$IFDEF FPC}
  OcAvailableMemory := MaxLongint;
{$ELSE}
  OcAvailableMemory := MaxAvail;
{$ENDIF}
End;

Procedure OcSetImageSize(NewWidth, NewHeight: Longint);
Var
  OcRow: Integer;
Begin
  If (NewWidth < 1) Or (NewWidth > OcMaxImageWidth) Then
    OcDecodeError('largeur invalide (maximum 32000 pixels).');
  If (NewHeight < 1) Or (NewHeight > OcMaxImageHeight) Then
    OcDecodeError('hauteur invalide (maximum 16000 pixels).');
  If NewWidth * NewHeight > 67108864 Then OcDecodeError('image trop grande.');
  If OcImage <> Nil Then OcDecodeError('en-tete d''image en double.');
  OcImageWidth := NewWidth;
  OcImageHeight := NewHeight;
  If OcAvailableMemory < NewHeight * SizeOf(OcPImageRow) Then
    OcDecodeError('memoire insuffisante pour l''image.');
  GetMem(OcImage, Word(NewHeight * SizeOf(OcPImageRow)));
  For OcRow := 1 To OcImageHeight Do
  Begin
    If OcAvailableMemory < NewWidth Then
      OcDecodeError('memoire insuffisante pour l''image.');
    GetMem(OcImage^[OcRow], Word(NewWidth));
    FillChar(OcImage^[OcRow]^, Word(NewWidth), 255);
  End;
End;

{ Le pixel est fusionne sur du blanc selon son opacite, puis garde en niveau de gris. }
Procedure OcPutPixel(PixelX, PixelY, Gray, Alpha: Integer);
Begin
  If (PixelX < 1) Or (PixelX > OcImageWidth) Or
     (PixelY < 1) Or (PixelY > OcImageHeight) Then Exit;
  If Alpha < 255 Then
    Gray := (Longint(Gray) * Alpha + 255 * Longint(255 - Alpha)) Div 255;
  If Gray < 0 Then Gray := 0;
  If Gray > 255 Then Gray := 255;
  OcImage^[PixelY]^[PixelX] := Gray;
End;

{ Normalisation : l'image devient une carte de couverture d'encre    }
{ (0 = fond, 15 = encre pleine), quelle que soit la polarite.        }
{ ------------------------------------------------------------------ }

Procedure OcNormalizeImage;
Var
  OcX, OcY: Integer;
  OcHistogram: Array[0..255] Of Longint;
  OcLookup: Array[0..255] Of Byte;
  OcRow: OcPImageRow;
  OcPixel, OcBackground, OcForeground, OcSpan, OcLevel: Integer;
  OcDarkCount, OcLightCount, OcTotal, OcAccumulated: Longint;
  OcDarkText: Boolean;
Begin
  FillChar(OcHistogram, SizeOf(OcHistogram), 0);
  For OcY := 1 To OcImageHeight Do
  Begin
    OcRow := OcImage^[OcY];
    For OcX := 1 To OcImageWidth Do
      Inc(OcHistogram[OcRow^[OcX]]);
  End;

  OcBackground := 0;
  For OcPixel := 1 To 255 Do
    If OcHistogram[OcPixel] > OcHistogram[OcBackground] Then OcBackground := OcPixel;

  OcDarkCount := 0;
  OcLightCount := 0;
  For OcPixel := 0 To 255 Do
    If OcPixel < OcBackground - 20 Then
      Inc(OcDarkCount, OcHistogram[OcPixel])
    Else If OcPixel > OcBackground + 20 Then
      Inc(OcLightCount, OcHistogram[OcPixel]);
  OcDarkText := OcDarkCount >= OcLightCount;

  { Teinte du texte : 2e centile des pixels du cote du texte. }
  If OcDarkText Then
  Begin
    OcTotal := OcDarkCount;
    OcForeground := OcBackground - 20;
    OcAccumulated := 0;
    For OcPixel := 0 To OcBackground - 21 Do
    Begin
      Inc(OcAccumulated, OcHistogram[OcPixel]);
      If OcAccumulated * 100 >= OcTotal * 2 Then
      Begin
        OcForeground := OcPixel;
        Break;
      End;
    End;
  End
  Else
  Begin
    OcTotal := OcLightCount;
    OcForeground := OcBackground + 20;
    OcAccumulated := 0;
    For OcPixel := 255 Downto OcBackground + 21 Do
    Begin
      Inc(OcAccumulated, OcHistogram[OcPixel]);
      If OcAccumulated * 100 >= OcTotal * 2 Then
      Begin
        OcForeground := OcPixel;
        Break;
      End;
    End;
  End;
  OcSpan := Abs(OcBackground - OcForeground);
  If OcSpan < 1 Then OcSpan := 1;

  For OcPixel := 0 To 255 Do
  Begin
    If OcDarkText Then
      OcLevel := OcBackground - OcPixel
    Else
      OcLevel := OcPixel - OcBackground;
    If OcLevel <= 0 Then
      OcLookup[OcPixel] := 0
    Else
    Begin
      OcLevel := (OcLevel * 15 + OcSpan Div 2) Div OcSpan;
      If OcLevel > 15 Then OcLevel := 15;
      OcLookup[OcPixel] := OcLevel;
    End;
  End;

  For OcY := 1 To OcImageHeight Do
  Begin
    OcRow := OcImage^[OcY];
    For OcX := 1 To OcImageWidth Do
      OcRow^[OcX] := OcLookup[OcRow^[OcX]];
  End;
End;

