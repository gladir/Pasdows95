End;

{ ---- images : [largeur][hauteur] (2 x LongInt) puis les pixels ---- }
Function ImageSize(X1, Y1, X2, Y2: Integer): LongInt;
Begin
 ImageSize := 8 + LongInt(Abs(X2 - X1) + 1) * (Abs(Y2 - Y1) + 1);
End;

Procedure GetImage(X1, Y1, X2, Y2: Integer; Var BitMap);
Var P: PByte; W, H, X, Y, SX, SY: LongInt;
Begin
 W := X2 - X1 + 1; H := Y2 - Y1 + 1;
 P := @BitMap;
 Move(W, P^, 4); Move(H, (P + 4)^, 4);
 P := P + 8;
 For Y := 0 To H - 1 Do
  For X := 0 To W - 1 Do
  Begin
   SX := X1 + PdwVP.X1 + X; SY := Y1 + PdwVP.Y1 + Y;
   If (SX >= 0) And (SY >= 0) And (SX < PdwW) And (SY < PdwH) Then
    P^ := (PdwBits + (SY * PdwW + SX))^
   Else P^ := 0;
   Inc(P);
  End;
End;

Procedure PutImage(X, Y: Integer; Var BitMap; BitBlt: Word);
Var P: PByte; W, H, I, J: LongInt;
Begin
 P := @BitMap;
 Move(P^, W, 4); Move((P + 4)^, H, 4);
 P := P + 8;
 For J := 0 To H - 1 Do
  For I := 0 To W - 1 Do
  Begin
   If BitBlt = XORPut Then
    PdwPlot(X + PdwVP.X1 + I, Y + PdwVP.Y1 + J, P^, XORPut)
   Else
    PdwPlot(X + PdwVP.X1 + I, Y + PdwVP.Y1 + J, P^, CopyPut);
   Inc(P);
  End;
End;

{ ---- palette (composantes 0..255) ---- }
Procedure SetRGBPalette(ColorNum, Red, Green, Blue: Integer);
Begin
 If (ColorNum < 0) Or (ColorNum > 255) Then Exit;
 PdwBmiRec.Colors[ColorNum] := (LongWord(Red And 255) Shl 16) Or
  (LongWord(Green And 255) Shl 8) Or LongWord(Blue And 255);
 PdwMark(0, 0, PdwW - 1, PdwH - 1);
End;

