Function OcClockHundredths: Longint;
Var
  OcH, OcM, OcS, OcS100: Word;
Begin
  GetTime(OcH, OcM, OcS, OcS100);
  OcClockHundredths := ((Longint(OcH) * 60 + OcM) * 60 + OcS) * 100 + OcS100;
End;

Function OcElapsedText: String;
Var
  OcElapsed: Longint;
  OcA, OcB: String;
Begin
  OcElapsed := OcClockHundredths - OcStartTime;
  If OcElapsed < 0 Then Inc(OcElapsed, 8640000);
  Str(OcElapsed Div 100, OcA);
  Str((OcElapsed Mod 100) Div 10, OcB);
  OcElapsedText := OcA + ',' + OcB + ' s';
End;

