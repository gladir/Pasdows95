End;

Procedure GetModeRange(GraphDriver: Integer; Var LoMode, HiMode: Integer);
Begin
 LoMode := m640x480;
 HiMode := mMaxScreen;
End;

Procedure PdwSetTitle(Const S: String);
Begin
 PdwTitle := S + #0;
 If PdwWnd <> 0 Then PdwSetWindowText(PdwWnd, @PdwTitle[1]);
End;

Procedure InitGraph(Var GraphDriver, GraphMode: Integer;
 Const PathToDriver: String);
Var WC: TPdwWndClass; R: TPdwRect; SW, SH, I, V, ExSt: LongInt;
    Inst: LongWord; ClsName: String;
Begin
 Assign(StdErr, '');
 Rewrite(StdErr);
 PdwResult := grOk;
 SW := PdwGetSystemMetrics(0);
 SH := PdwGetSystemMetrics(1);
 { fenetre de 640 x 480 (-maxscreen : la taille de l ecran) ; si elle
   ne tient pas dans le bureau avec son cadre, plein ecran sans cadre
   (PAINT est dessine pour un ecran d au moins 640 x 480) }
 PdwW := 640; PdwH := 480;
 If GraphMode = mMaxScreen Then Begin PdwW := SW; PdwH := SH End;
 PdwStyle := $00CA0000;
 R.L := 0; R.T := 0; R.R := PdwW; R.B := PdwH;
 PdwAdjustWindowRect(R, PdwStyle, 0);
 If (R.R - R.L > SW) Or (R.B - R.T > SH - 28) Then
 Begin
  PdwStyle := LongInt($80000000);
  If PdwW > SW Then PdwW := SW;
  If PdwH > SH Then PdwH := SH;
 End;
 PdwW := PdwW And Not 3;
 GetMem(PdwBits, PdwW * PdwH);
 If PdwBits = Nil Then Begin PdwResult := -1; Exit End;
 FillChar(PdwBits^, PdwW * PdwH, 0);
 FillChar(PdwBmiRec, SizeOf(PdwBmiRec), 0);
 PdwBmiRec.Size := 40;
 PdwBmiRec.Width := PdwW;
 PdwBmiRec.Height := -PdwH;
 PdwBmiRec.Planes := 1;
 PdwBmiRec.BitCount := 8;
 PdwBmiRec.ClrUsed := 256;
 { palette initiale : EGA puis gris et cube 6 x 6 x 6 }
 For I := 0 To 15 Do PdwBmiRec.Colors[I] := PdwEga[I];
 For I := 16 To 31 Do
 Begin
  V := (I - 16) * 17;
  PdwBmiRec.Colors[I] := (LongWord(V) Shl 16) Or (LongWord(V) Shl 8) Or
   LongWord(V);
 End;
 For I := 32 To 247 Do
  PdwBmiRec.Colors[I] := (LongWord(((I - 32) Div 36) * 51) Shl 16) Or
   (LongWord((((I - 32) Div 6) Mod 6) * 51) Shl 8) Or
   LongWord(((I - 32) Mod 6) * 51);
 PdwVP.X1 := 0; PdwVP.Y1 := 0; PdwVP.X2 := PdwW - 1; PdwVP.Y2 := PdwH - 1;
 PdwVP.Clip := True;
 PdwColor := White; PdwFillColor := White; PdwFillStyle := SolidFill;
 PdwLineStyle := SolidLn; PdwLinePat := $FFFF; PdwThick := NormWidth;
 PdwWrite := CopyPut;
 Inst := PdwGetModuleHandle(Nil);
 ClsName := 'PasdowsPaint'#0;
 FillChar(WC, SizeOf(WC), 0);
 WC.Style := 3;
 WC.WndProc := @PdwWndProc;
 WC.Instance := Inst;
 WC.Cursor := PdwLoadCursor(0, Pointer(32512));
 WC.Icon := PdwLoadIcon(0, Pointer(32512));
 WC.ClassName := @ClsName[1];
 PdwRegisterClass(WC);
 R.L := 0; R.T := 0; R.R := PdwW; R.B := PdwH;
 If PdwStyle <> LongInt($80000000) Then PdwAdjustWindowRect(R, PdwStyle, 0);
 PdwTitle := 'Sans titre - Paint'#0;
 { centree dans le bureau (au-dessus de la barre des taches) }
 I := (SW - (R.R - R.L)) Div 2; If I < 0 Then I := 0;
 V := (SH - 28 - (R.B - R.T)) Div 2; If V < 0 Then V := 0;
 { plein ecran : au-dessus de la barre des taches (WS_EX_TOPMOST) }
 If PdwStyle = LongInt($80000000) Then ExSt := 8 Else ExSt := 0;
 PdwWnd := PdwCreateWindow(ExSt, @ClsName[1], @PdwTitle[1], PdwStyle,
  I, V, R.R - R.L, R.B - R.T, 0, 0, Inst, Nil);
 If PdwWnd = 0 Then Begin PdwResult := -1; Exit End;
 PdwShowWindow(PdwWnd, 5);
 PdwUpdateWindow(PdwWnd);
 PdwDC := PdwGetDC(PdwWnd);
 GraphDriver := D8bit;
End;

Procedure CloseGraph;
Begin
 If PdwWnd = 0 Then Exit;
 PdwReleaseDC(PdwWnd, PdwDC);
 PdwDestroyWindow(PdwWnd);
 PdwWnd := 0; PdwDC := 0;
 PdwPump;
End;

