 Used:=0;Failed:=False;Stride:=(CanvasImageW+7) Div 8;
 W(1);W(779);W(8);W(2);W(372);W(372);W(CanvasImageW);W(CanvasImageH);
 B(Ord('X'));B(Ord('I'));B(Ord('M'));B(Ord('G'));W(0);
