{ comparaison d octets (FPC) : <0, 0, >0 }
Function CompareByte(Const A; Const B; N: LongInt): LongInt;
Var PA, PB: PByte; I: LongInt;
Begin
 CompareByte := 0;
 PA := @A; PB := @B;
 For I := 0 To N - 1 Do
  If PA[I] <> PB[I] Then
  Begin
   CompareByte := LongInt(PA[I]) - LongInt(PB[I]);
   Exit;
  End;
End;

{ zone de l ecran a recopier dans la fenetre }
Procedure PdwMark(X1, Y1, X2, Y2: LongInt);
Begin
 If X1 < 0 Then X1 := 0;
 If Y1 < 0 Then Y1 := 0;
 If X2 >= PdwW Then X2 := PdwW - 1;
 If Y2 >= PdwH Then Y2 := PdwH - 1;
 If (X1 > X2) Or (Y1 > Y2) Then Exit;
 If Not PdwDirty Then
 Begin
  PdwDX1 := X1; PdwDY1 := Y1; PdwDX2 := X2; PdwDY2 := Y2;
  PdwDirty := True;
  Exit;
 End;
 If X1 < PdwDX1 Then PdwDX1 := X1;
 If Y1 < PdwDY1 Then PdwDY1 := Y1;
 If X2 > PdwDX2 Then PdwDX2 := X2;
 If Y2 > PdwDY2 Then PdwDY2 := Y2;
End;

{ recopier la zone modifiee de l image dans la fenetre }
Procedure PdwFlush;
Begin
 If (Not PdwDirty) Or (PdwDC = 0) Then Exit;
 PdwSetDIBits(PdwDC, PdwDX1, PdwDY1, PdwDX2 - PdwDX1 + 1,
  PdwDY2 - PdwDY1 + 1, PdwDX1, PdwDY1, 0, PdwH, PdwBits, PdwBmiRec, 0);
 PdwDirty := False;
End;

Procedure PdwPush(C: Char);
Begin
 If ((PdwKTail + 1) And 255) = PdwKHead Then Exit;
 PdwKeys[PdwKTail] := C;
 PdwKTail := (PdwKTail + 1) And 255;
End;

{ touche non caractere : #0 + code de balayage (comme Crt.ReadKey) }
Procedure PdwKeyDown(VK: LongInt; Alt: Boolean);
Var S: LongInt;
Begin
 S := 0;
 Case VK Of
  $25: S := 75;  $26: S := 72;  $27: S := 77;  $28: S := 80;
  $21: S := 73;  $22: S := 81;  $23: S := 79;  $24: S := 71;
  $2D: S := 82;  $2E: S := 83;
  $70..$79: S := 59 + VK - $70;
  $7A: S := 133; $7B: S := 134;
 End;
 If Alt Then
 Begin
  If VK = $73 Then S := 107
  Else If (VK >= $41) And (VK <= $5A) Then S := PdwAltScan[VK - $41];
 End;
 If S <> 0 Then
 Begin
  PdwPush(#0);
  PdwPush(Chr(S));
 End;
End;

{ WM_PAINT : toute l image }
Procedure PdwPaintNow(H: LongWord);
Var PS: TPdwPaint; DC: LongWord;
Begin
 DC := PdwBeginPaint(H, PS);
 PdwSetDIBits(DC, 0, 0, PdwW, PdwH, 0, 0, 0, PdwH, PdwBits, PdwBmiRec, 0);
 PdwEndPaint(H, PS);
End;

Function PdwWndProc(H, Msg: LongWord; WP, LP: LongInt): LongInt; stdcall;
Begin
 PdwWndProc := 0;
 Case Msg Of
  $000F:
  Begin
   PdwPaintNow(H);
  End;
  $0014: PdwWndProc := 1;
  $0200, $0201, $0202, $0204, $0205, $0207, $0208:
  Begin
   PdwMX := SmallInt(LP And $FFFF);
   PdwMY := SmallInt((LP Shr 16) And $FFFF);
   PdwMB := 0;
   If (WP And 1) <> 0 Then PdwMB := PdwMB Or 1;
   If (WP And 2) <> 0 Then PdwMB := PdwMB Or 2;
   If (WP And 16) <> 0 Then PdwMB := PdwMB Or 4;
   { un clic bref (appui et relachement entre deux lectures) reste vu }
   If Msg = $0201 Then PdwMBLatch := PdwMBLatch Or 1;
   If Msg = $0204 Then PdwMBLatch := PdwMBLatch Or 2;
   If Msg = $0207 Then PdwMBLatch := PdwMBLatch Or 4;
   If (Msg = $0201) Or (Msg = $0204) Or (Msg = $0207) Then PdwSetCapture(H)
   Else If PdwMB = 0 Then PdwReleaseCapture;
  End;
  $0100: PdwKeyDown(WP, False);
  $0104: PdwKeyDown(WP, True);
  $0102: PdwPush(Chr(WP And 255));
  $0106: ;
  $0010:
  Begin
   PdwPush(#0);
   PdwPush(#107);
  End;
  $0002: PdwPostQuitMessage(0);
 Else
  PdwWndProc := PdwDefWindowProc(H, Msg, WP, LP);
 End;
End;

{ messages en attente, puis mise a jour de la fenetre }
Procedure PdwPump;
Var M: TPdwMsg;
Begin
 While PdwPeekMessage(M, 0, 0, 0, 1) <> 0 Do
 Begin
  PdwTranslateMessage(M);
  PdwDispatchMessage(M);
 End;
 PdwFlush;
End;

{ ---- Crt ---- }
Function KeyPressed: Boolean;
Begin
 PdwPump;
 KeyPressed := PdwKHead <> PdwKTail;
End;

Function ReadKey: Char;
Begin
 While Not KeyPressed Do PdwSleep(10);
 ReadKey := PdwKeys[PdwKHead];
 PdwKHead := (PdwKHead + 1) And 255;
End;

Procedure Delay(Ms: Word);
Begin
 PdwPump;
 PdwSleep(Ms);
End;

