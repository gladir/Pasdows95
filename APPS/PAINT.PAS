Function OcFloorInt(OcValue: Real): Integer;
Var
  OcWhole: Integer;
Begin
  OcWhole := Trunc(OcValue);
  If OcValue < OcWhole Then Dec(OcWhole);
  OcFloorInt := OcWhole;
End;

Function OcCeilInt(OcValue: Real): Integer;
Var
  OcWhole: Integer;
Begin
  OcWhole := Trunc(OcValue);
  If OcValue > OcWhole Then Inc(OcWhole);
  OcCeilInt := OcWhole;
End;

