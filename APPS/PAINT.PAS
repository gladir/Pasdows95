Const
 VtLoadedModel:AnsiString='';
Var
 VtPerson,VtGarmentFile,VtPromptText:AnsiString;
 VtGarment:Boolean;
 VtScene:VtTScene;
 VtNet:VtTSegModel;
 VtImg,VtGImg:VtTImage;
 VtErr,VtModelPath,VtConfigPath,VtMsg:AnsiString;
 VtEdits:VtTEditArray;
 VtGarmentEdits:Array of LongInt;
 VtGKind,VtI,VtJ,VtJpegQ,VtNOk,VtNFail,VtSide:LongInt;
 VtT0,VtT1:Double;
 VtG:VtTGarment;
 VtP:VtTRecolor;
 VtKind:LongInt;
 VtEd:^VtTEdit;
 VtTmp:PSingle;
 VtOutName:AnsiString;
 VtKindMask:LongWord;
 VtToG:Boolean;
 VtParsed:Boolean;
 VtN:LongInt;
 VtUsed:Boolean;
 VtDummy:LongWord;
 VtNeedFeet,VtNeedPants,VtNeedSkirt:Boolean;
 VtCnt0,VtNeedL,VtNeedR,VtNeedB:LongInt;

Procedure VtDie(Const VtS:AnsiString);
Begin
 VtFatal(VtS);
End;

Procedure VtProcessScene;
Begin
 VxCancelled:=False;
 ReturnNilIfGrowHeapFails:=True;
 VtStartMs:=VtNowMsF;
 VtPerson:=VtPos_[0];
 VtGarmentFile:='';VtGarment:=False;
 VtPromptText:=VtOptPrompt;
 VtI:=1;
 If(Length(VtPos_)>1)Then Begin
  If VtFileExistsP(VtPos_[1])or(VtIsImageName(VtPos_[1])and(Pos(' ',VtPos_[1])=0))
    Then Begin
   VtGarmentFile:=VtPos_[1];VtGarment:=True;VtI:=2;
  End;
 End;
 { les mots restants forment la demande en langage naturel }
 If VtPromptText='' Then Begin
  For VtJ:=VtI to High(VtPos_)do Begin
   If VtPromptText<>'' Then VtPromptText:=VtPromptText+' ';
   VtPromptText:=VtPromptText+VtPos_[VtJ];
  End;
 End;
 If(not VtGarment)and(VtPromptText='')Then
   VtDie('indiquez une image de v'#136'tement ou une demande avec -prompt');
 VtGKind:=VtParseKind(VtOptType);
 If VtGKind<0 Then VtDie('type de v'#136'tement inconnu : '+VtOptType+
   ' (haut, bas, jupe, robe, tout, chaussures, chapeau, lunettes, sac, '#130+
   'charpe, ceinture)');
 If VtOptSeed<0 Then VtOptSeed:=VtMakeSeed and $7FFFFFFF;
 VtRngSeed(LongWord(VtOptSeed));
 VtOutName:=VtOptOut;
 If VtOutName='' Then VtOutName:=VtPathNoExt(VtPerson)+'_vton.png';
 Case VtOptQuality of
  1:VtJpegQ:=80;
  2:VtJpegQ:=88;
  3:VtJpegQ:=92;
  Else VtJpegQ:=96;
 End;
 VtGNThreads:=VtCpuCount;
 If VtOptThreads>0 Then VtGNThreads:=VtOptThreads;
 If VtGNThreads>VtMaxThreads Then VtGNThreads:=VtMaxThreads;
 If VtVerbose Then Begin
  VtDetail('VTON '+VtVersionStr);
  VtDetail('personne : '+VtPerson);
  If VtGarment Then VtDetail('v'#136'tement : '+VtGarmentFile);
  If VtPromptText<>'' Then VtDetail('demande : '+VtPromptText);
  VtDetail('qualit'#130' '+VtIStr(VtOptQuality)+', graine '+VtIStr(VtOptSeed)
    +', fils de calcul '+VtIStr(VtGNThreads));
 End;
 { demande en langage naturel }
 SetLength(VtEdits,0);
 If VtPromptText<>'' Then Begin
  If not VtInterpret(VtPromptText,VtEdits,VtErr)Then VtDie(VtErr);
  For VtI:=0 to High(VtEdits)do VtDetail('interpr'#130'tation : '+
    VtDescribeEdit(VtEdits[VtI]));
 End;
 { photo de la personne }
 If not VxPersonImage(VtImg,VtErr)Then VtDie(VtErr);
 VtDetail('photo '+VtIStr(VtImg.W)+'x'+VtIStr(VtImg.VtH));
 VtSceneFromImage(VtImg,VtOptMaxSize,VtScene);
 VtImgFree(VtImg);
 If (VtScene.W<64)or(VtScene.VtH<64)Then
   VtDie('la photo est trop petite (64 pixels minimum)');
 If VtVerbose Then VtDetail('image de travail '+VtIStr(VtScene.W)+'x'+VtIStr(VtScene.VtH));
 { GPU }
 If not VtOptCpu Then Begin
  VtErr:='';
  If VtGpuSetup(VtOptDevice,VtErr)Then VtInfo('GPU : '+VtGpuName+' (Direct3D 11)')
  Else Begin
   If VtOptGpu Then VtWarn('GPU indisponible ('+VtErr+') : calcul sur le processeur');
   If(not VtOptGpu)and VtVerbose Then VtDetail('GPU non utilis'#130' : '+VtErr);
  End;
 End;
 { analyse de la personne }
 VtT0:=VtNowMsF;
 If VtOptParsing<>'' Then Begin
  If not VtParseFromLabels(VtScene,VtOptParsing,VtErr)Then VtDie(VtErr);
  If VtOptQuality>=2 Then VtSceneRefine(VtScene);
 End
  Else Begin
   If not VtResolveModel(VtOptModel,VtModelPath,VtConfigPath,VtErr)Then VtDie(VtErr);
   If VtModelPath<>VtLoadedModel Then Begin
    VtInfo('Chargement du mod'#138'le '+VtPathLastPart(VtModelPath)+' ...');
    If not VtStLoad(VtModelPath,VtErr)Then VtDie(VtErr);
    If not VtSegBuild(VtNet,VtConfigPath)Then VtDie(VtSegErr);
    VtLoadedModel:=VtModelPath;
   End;
   VtDetail(VtIStr(VtStN)+' tenseurs, '+VtIStr(VtNet.NumLabels)+
     ' classes, d'#130'codeur '+VtIStr(VtNet.Dec));
   Case VtOptQuality of
    1:VtSide:=256;
    2:VtSide:=384;
    3:VtSide:=512;
    Else VtSide:=768;
   End;
   If VtOptSize>0 Then VtSide:=VtOptSize;
   VtDumpPath:=VtOptDump;
   VtInfo('Analyse de la personne ...');
   VtParseWithNet(VtScene,VtNet,VtSide,VtOptQuality>=2);
    End;
 VtDetail('analyse termin'#130'e en '+VtFStr((VtNowMsF-VtT0)/1000.0,1)+' s');
 For VtI:=0 to VtNumCat-1 do Begin
  VtN:=VtCatArea(VtScene,LongWord(1)shl VtI);
  If(VtN>0)and VtVerbose and(VtI<>VtcBg)Then VtDetail('  '+VtPadRight(VtCatNames[VtI],12)+
    VtFStr(100.0*VtN/(Int64(VtScene.W)*VtScene.VtH),1)+' %');
 End;
 If VtOptSaveParsing<>'' Then Begin
  VtParsingToImage(VtScene,VtImg);
  If not VtImgSave(VtOptSaveParsing,VtImg,90)Then
    VtWarn('impossible d''enregistrer '+VtOptSaveParsing);
  VtImgFree(VtImg);
 End;
 { scene : le corps coupe doit montrer ses pieds pour se tenir sur la plateforme
   }
 For VtI:=0 to High(VtEdits)do If(VtEdits[VtI].Action=eaScene)
   or((VtEdits[VtI].Action=eaPose2)and((VtEdits[VtI].Poses and VtFeetPoses)<>0))Then Begin
  VtCnt0:=0;
  For VtJ:=0 to VtScene.W-1 do If VtScene.Cat[VtcBg][Int64(VtScene.VtH-1)*VtScene.W+
    VtJ]<128 Then Inc(VtCnt0);
  If(VtCnt0>=VtScene.W div 50)and(VtCatArea(VtScene,VtmsShoes)<Int64(VtScene.W)*VtScene.VtH
    div 2000)Then Begin
   SetLength(VtEdits,Length(VtEdits)+1);
   For VtJ:=High(VtEdits)downto 1 do VtEdits[VtJ]:=VtEdits[VtJ-1];
   VtClearEdit(VtEdits[0]);
   VtEdits[0].Action:=eaAdd;VtEdits[0].Target:=VtmsShoes;VtEdits[0].VtKind:=gkShoes;
     VtEdits[0].Noun:='souliers';
   VtInfo('corps coup'#130' : pantalon et souliers ajout'#130's pour poser la '+
     'personne sur la plateforme');
  End;
  Break;
 End;
 { bas du corps : prolongement de l'image si le corps est coupe par le cadre }
 VtNeedFeet:=False;VtNeedPants:=False;VtNeedSkirt:=False;
 For VtI:=0 to High(VtEdits)do Begin
  If(VtEdits[VtI].Action=eaRecolor)and VtEdits[VtI].Put and((VtEdits[VtI].Target and(VtmsPants
    or VtmsSkirt or VtmsShoes))<>0)and
    (VtCatArea(VtScene,VtEdits[VtI].Target)<Int64(VtScene.W)*VtScene.VtH div 2000)Then
      VtEdits[VtI].Action:=eaAdd;
  If VtEdits[VtI].Action=eaAdd Then Begin
   If(VtEdits[VtI].Target and VtmsShoes)<>0 Then VtNeedFeet:=True;
   If(VtEdits[VtI].Target and VtmsPants)<>0 Then VtNeedPants:=True;
   If(VtEdits[VtI].Target and VtmsSkirt)<>0 Then VtNeedSkirt:=True;
  End;
 End;
 If VtNeedFeet or VtNeedPants or VtNeedSkirt Then Begin
  { des souliers sans pantalon ni jupe : un pantalon neutre est ajoute }
  If VtNeedFeet and not VtNeedPants and not VtNeedSkirt and
    (VtCatArea(VtScene,VtmsPants or VtmsSkirt or VtmsDress)<Int64(VtScene.W)*VtScene.VtH
      div 2000)Then Begin
   SetLength(VtEdits,Length(VtEdits)+1);
   For VtJ:=High(VtEdits)downto 1 do VtEdits[VtJ]:=VtEdits[VtJ-1];
   VtClearEdit(VtEdits[0]);
   VtEdits[0].Action:=eaAdd;VtEdits[0].Target:=VtmsPants;VtEdits[0].VtKind:=gkBottom;
     VtEdits[0].Noun:='pantalon';
   VtNeedPants:=True;
   VtInfo('pantalon neutre ajout'#130' pour accompagner les chaussures');
  End;
  If VtExtendBody(VtScene,VtNeedFeet,VtNeedPants,VtNeedSkirt,VtMsg)Then Begin
   If VtMsg<>'' Then VtInfo(VtMsg);
  End
   Else Begin
    VtWarn(VtMsg);
    For VtI:=0 to High(VtEdits)do
     If(VtEdits[VtI].Action=eaAdd)and((VtEdits[VtI].Target and(VtmsPants or VtmsSkirt
       or VtmsShoes))<>0)Then VtEdits[VtI].Action:=VteaNone;
   End;
 End;
 VtNOk:=0;VtNFail:=0;
 SetLength(VtGarmentEdits,Length(VtEdits));
 For VtI:=0 to High(VtEdits)do Begin
  VtGarmentEdits[VtI]:=0;
  If VtGarment and(VtEdits[VtI].Action=eaTryOn)Then VtGarmentEdits[VtI]:=1;
  { -type designe la cible quand la demande ne la precise pas }
  If(not VtGarment)and(VtGKind<>VtgkNone)and(VtEdits[VtI].Target=0)and(not
    VtEdits[VtI].HasSrc)Then Begin
   VtKindSets(VtGKind,VtKindMask,VtDummy,VtDummy);
   VtEdits[VtI].Target:=VtKindMask;VtEdits[VtI].VtKind:=VtGKind;
  End;
 End;
 { essayage d'un vetement fourni }
 If VtGarment Then Begin
  VtKind:=VtGKind;
  If VtKind=VtgkNone Then
   For VtI:=0 to High(VtEdits)do
    If(VtKind=VtgkNone)and(VtEdits[VtI].VtKind in[gkTop,gkBottom,gkSkirt,gkDress,
      gkShoes,gkHat,gkGlasses,VtgkBag,gkScarf,gkBelt,gkFull])Then
      VtKind:=VtEdits[VtI].VtKind
    Else If(VtKind=VtgkNone)and(VtEdits[VtI].VtKind=gkAll)Then VtKind:=gkFull;
  If not VtImgLoad(VtGarmentFile,VtGImg,VtErr)Then VtDie(VtErr);
  If not VtGarmentFromImage(VtGImg,VtG,VtErr)Then VtDie(VtErr);
  VtImgFree(VtGImg);
  If VtKind=VtgkNone Then Begin
   If VtG.VtH>1.25*VtG.W Then Begin
    VtKind:=gkFull;
    VtInfo('type de v'#136'tement d'#130'duit de la forme : tenue compl'#138'te '+
      '(utilisez -type pour pr'#130'ciser)');
   End
    Else Begin
     VtKind:=gkTop;
     VtInfo('type de v'#136'tement non pr'#130'cis'#130' : "haut" suppos'#130' '+
       '(utilisez -type)');
    End;
  End;
  VtDetail('v'#136'tement '+VtIStr(VtG.W)+'x'+VtIStr(VtG.VtH)+' : '+VtG.Note);
  { retouches de la demande qui concernent le vetement lui-meme }
  VtKindSets(VtKind,VtKindMask,VtDummy,VtDummy);
  For VtI:=0 to High(VtEdits)do Begin
   VtEd:=@VtEdits[VtI];
   VtToG:=(VtEd^.Action=eaRecolor)and((VtEd^.Target=0)or((VtEd^.Target and VtKindMask)
     <>0)or(VtEd^.VtKind=VtKind));
   If VtToG Then Begin
    VtGarmentEdits[VtI]:=1;
    VtBuildRecolor(VtEd^,VtP,0,0,VtG.W,VtG.VtH,VtKind in[gkBottom,gkSkirt]);
    VtTmp:=VtAllocF(Int64(VtG.W)*VtG.VtH);
    For VtN:=0 to Int64(VtG.W)*VtG.VtH-1 do VtTmp[VtN]:=VtSmoothStep(0.25,0.75,VtG.Mask[VtN]);
    If VtRecolorRegion(VtG.Rgb,VtG.W,VtG.VtH,VtTmp,VtP)Then
      VtInfo('  v'#136'tement recolor'#130+' ('+VtEd^.DstName+')')
    Else VtWarn('v'#136'tement trop petit pour '#136'tre recolor'#130);
    FreeMem(VtTmp);
   End;
  End;
  { mannequin : l'image est agrandie (cotes et bas) pour montrer toute la tenue,
    jusqu'aux pieds }
  VtMannequinNeed(VtScene,VtG,VtKind,VtNeedL,VtNeedR,VtNeedB);
  If VtNeedL>3*VtScene.W Then VtNeedL:=3*VtScene.W;
  If VtNeedR>3*VtScene.W Then VtNeedR:=3*VtScene.W;
  If VtNeedB>3*VtScene.VtH Then VtNeedB:=3*VtScene.VtH;
  If(VtNeedL>0)or(VtNeedR>0)or(VtNeedB>0)Then Begin
   VtGrowEdges(VtScene,VtNeedL,0,VtNeedR,VtNeedB);
   VtInfo('image agrandie ('+VtIStr(VtNeedL)+' px '#133' gauche, '+VtIStr(VtNeedR)
     +' '#133' droite, '+VtIStr(VtNeedB)+' en bas) pour voir la tenue en entier');
  End;
  VtInfo('Pose du v'#136'tement ('+VtGarmentKindName(VtKind)+') ...');
  If VtTryOnGarment(VtScene,VtG,VtKind,VtOptQuality,VtMsg)Then Begin
   VtInfo('  '+VtMsg);
   Inc(VtNOk);
  End
   Else Begin
    VtWarn(VtMsg);
    Inc(VtNFail);
   End;
  VtGarmentFree(VtG);
 End;
 { poses et situations (expression, bras, decor) }
 For VtI:=0 to High(VtEdits)do
  If VtEdits[VtI].Action=eaPose2 Then Begin
   VtInfo('Pose : '+VtDescribeEdit(VtEdits[VtI]));
   VtApplyPoses(VtScene,VtEdits[VtI].Poses,0,VtNOk,VtNFail);
  End;
 { retouches sur la scene }
 For VtI:=0 to High(VtEdits)do Begin
  If VtGarmentEdits[VtI]<>0 Then Continue;
  If VtEdits[VtI].Action=VteaNone Then Begin Inc(VtNFail);Continue;End;
  If VtEdits[VtI].Action=eaTryOn Then Begin
   VtWarn('"essayer" demande une image de v'#136'tement (deuxi'#138'me argument)')
     ;
   Inc(VtNFail);
   Continue;
  End;
  { ? mettre un chapeau ? alors qu'il n'y en a pas : on l'ajoute }
  If(VtEdits[VtI].Action=eaRecolor)and VtEdits[VtI].Put and((VtEdits[VtI].Target
    and(VtmsHat or VtmsScarf or VtmsGlasses or VtmsBelt))<>0)and
    (VtCatArea(VtScene,VtEdits[VtI].Target)<Int64(VtScene.W)*VtScene.VtH div 2000)Then
      VtEdits[VtI].Action:=eaAdd;
  If(VtEdits[VtI].Action=eaPose2)or(VtEdits[VtI].Action=eaImage)
    or(VtEdits[VtI].Action=eaBg)Then Continue;
  VtInfo('Retouche : '+VtDescribeEdit(VtEdits[VtI]));
  If(VtEdits[VtI].Action=eaRemove)and(VtEdits[VtI].Jewel<>0)Then Begin
   VtWarn('le retrait de bijoux n''est pas pris en charge');Inc(VtNFail);Continue;
  End;
  If(VtEdits[VtI].Action=eaAdd)and(VtEdits[VtI].Jewel<>0)Then Begin
   VtInfo('Ajout de bijoux ...');
   If VtAddJewelry(VtScene,VtEdits[VtI],VtMsg)Then Inc(VtNOk)Else Begin VtWarn(VtMsg);
     Inc(VtNFail);End;
   Continue;
  End;
  If VtEdits[VtI].Action=eaStyle Then Continue;
  If VtEdits[VtI].Action=eaScene Then Continue;
  If VtEdits[VtI].Action=eaMaterial Then Begin
   VtInfo('Mati'#138're : '+VtDescribeEdit(VtEdits[VtI]));
   If VtApplyMaterial(VtScene,VtEdits[VtI],VtMsg)Then Inc(VtNOk)Else Begin VtWarn(VtMsg);
     Inc(VtNFail);End;
   Continue;
  End;
  If VtEdits[VtI].Action=eaSkin Then Begin
   VtInfo('Peau : '+VtDescribeEdit(VtEdits[VtI]));
   If VtApplySkin(VtScene,VtEdits[VtI],VtMsg)Then Inc(VtNOk)Else Begin VtWarn(VtMsg);Inc(VtNFail)
     ;End;
   Continue;
  End;
  { sourire demande (seul ou avec d'autres retouches dans la meme clause) }
  If VtEdits[VtI].Expr<>0 Then Begin
   If VtApplySmile(VtScene,VtMsg)Then Inc(VtNOk)Else Begin VtWarn(VtMsg);Inc(VtNFail);End;
   If VtEdits[VtI].Action=eaFace Then Continue;
  End;
  If VtEdits[VtI].Action=eaPose Then Begin
   If VtArmsDown(VtScene,VtMsg)Then Inc(VtNOk)Else Begin VtWarn(VtMsg);Inc(VtNFail);End;
   Continue;
  End;
  If VtEdits[VtI].Action=eaHair Then Begin
   If VtApplyHair(VtScene,VtEdits[VtI].HairStyle,VtEdits[VtI],VtMsg)Then Begin
     VtInfo('  coiffure modifi'#130'e');Inc(VtNOk);End
   Else Begin VtWarn(VtMsg);Inc(VtNFail);End;
  End
  Else If VtEdits[VtI].Action=eaAdd Then Begin
   If VtAddAccessory(VtScene,VtEdits[VtI],VtOptQuality,VtMsg)Then Begin VtInfo('  '+VtMsg);
     Inc(VtNOk);End
   Else Begin VtWarn(VtMsg);Inc(VtNFail);End;
  End
  Else If VtApplyEdit(VtScene,VtEdits[VtI],VtMsg)Then Inc(VtNOk)
  Else Begin VtWarn(VtMsg);Inc(VtNFail);End;
 End;
 { situations : decors dessines autour de la personne }
 For VtI:=0 to High(VtEdits)do
  If VtEdits[VtI].Action=eaPose2 Then VtApplyPoses(VtScene,VtEdits[VtI].Poses,1,VtNOk,VtNFail);
 { scene : decor genere autour de la personne }
 For VtI:=0 to High(VtEdits)do
  If VtEdits[VtI].Action=eaScene Then Begin
   VtInfo('Sc'#138'ne : carrousel');
   If VtApplyCarousel(VtScene,VtMsg)Then Inc(VtNOk)Else Begin VtWarn(VtMsg);Inc(VtNFail);End;
  End;
 { image entiere et arriere-plan, dans l'ordre de la demande }
 For VtI:=0 to High(VtEdits)do Begin
  If VtEdits[VtI].Action=eaBg Then Begin
   VtInfo('Arri'#138're-plan : '+VtDescribeEdit(VtEdits[VtI]));
   If VtApplyBackground(VtScene,VtEdits[VtI],VtMsg)Then Inc(VtNOk)Else Begin VtWarn(VtMsg);
     Inc(VtNFail);End;
  End
  Else If VtEdits[VtI].Action=eaImage Then Begin
   VtInfo('Image : '+VtDescribeEdit(VtEdits[VtI]));
   If VtApplyImageOp(VtScene,VtEdits[VtI],VtMsg)Then Inc(VtNOk)Else Begin VtWarn(VtMsg);
     Inc(VtNFail);End;
  End;
 End;
 { le style de l'image s'applique en dernier, sur le resultat des autres
   retouches }
 For VtI:=0 to High(VtEdits)do
  If VtEdits[VtI].Action=eaStyle Then Begin
   VtInfo('Style : '+VtDescribeEdit(VtEdits[VtI]));
   If VtApplyStyle(VtScene,VtEdits[VtI].Style,VtMsg)Then Inc(VtNOk)Else Begin VtWarn(VtMsg);
     Inc(VtNFail);End;
  End;
 If VtNOk=0 Then VtDie('aucune retouche n''a pu '#136'tre appliqu'#130'e');
 VtSceneToImage(VtScene,VtImg);
 VxStoreResult(VtImg);
 If VtOutAlpha<>Nil Then Begin
  If VtOutAlphaN=Int64(VtScene.W)*VtScene.VtH Then Begin
   VtImg.Alpha:=PByte(VtAllocBytes(VtOutAlphaN));
   Move(VtOutAlpha^,VtImg.Alpha^,VtOutAlphaN);
   If VtPathExt(VtOutName)<>'.png' Then Begin
    VtWarn('la transparence demande un fichier PNG : '+VtOutName+
      ' devient '+VtPathNoExt(VtOutName)+'.png');
    VtOutName:=VtPathNoExt(VtOutName)+'.png';
   End;
  End;
  FreeMem(VtOutAlpha);VtOutAlpha:=Nil;
 End;
 If not VtImgSave(VtOutName,VtImg,VtJpegQ)Then VtDie('impossible d''enregistrer '+
   VtOutName);
 VtImgFree(VtImg);
 VtInfo('R'#130'sultat : '+VtOutName+' ('+VtIStr(VtScene.W)+'x'+VtIStr(VtScene.VtH)+', '+
   VtFStr((VtNowMsF-VtStartMs)/1000.0,1)+' s)');
 If VtVerbose and(VtGpuCalls>0)Then VtDetail('GPU : '+VtIStr(VtGpuCalls)
   +' produits matriciels, '+VtHumanBytes(VtGpuBytes)+' transf'#130'r'#130's');
 VxFails:=VtNFail;
 VtSceneFree(VtScene);
End;


{ Execution du moteur : les erreurs (Fatal, annulation) sont des exceptions }
Function VxRun(Var Err: AnsiString): Boolean;
Var Err2: String;
Begin
 VxRun := False;
 Err := '';
 VxMsg := '';
 Try
  VtProcessScene;
  VxRun := True;
 Except
  Err := VxMsg;
  If Err = '' Then Begin
   Err := 'Erreur interne du moteur.';
   {$IFNDEF WPC}
   If RaiseList <> Nil Then Begin
    Str(PtrUInt(RaiseList^.Addr),Err2);
    Err := Err+' '+RaiseList^.FObject.ClassName+' @'+Err2;
   End;
   {$ENDIF}
  End;
 End;
End;

{$MODESWITCH EXCEPTIONS-}{$MODESWITCH CLASS-}
{$IFDEF FPC}{$POP}{$ENDIF}

Const
 VU_KINDS = 12;
 VU_KIND: Array[0..VU_KINDS-1] of String[12] = ('auto','haut','bas','jupe','robe',
  'tout','chaussures','chapeau','lunettes','sac','echarpe','ceinture');
 VU_KINDNAME: Array[0..VU_KINDS-1] of String[28] = ('Automatique','Haut (chandail...)',
  'Bas (pantalon)','Jupe','Robe','Tenue complete','Chaussures','Chapeau','Lunettes',
  'Sac','Echarpe','Ceinture');

Type
 TVuState = Record
  X, Y: Integer;
  Garment, Prompt: String[200];
  Kind, Quality, Focus: Integer;
  UseGpu, HasResult, ShowAfter: Boolean;
  Done, Dirty, Run, Apply: Boolean;
  Status: String[80];
  GarmEdit, Browse, KindM, KindLabel, KindP, PromptEdit: TRect;
  QualM, QualTrack, QualP, GpuBox, PrevBox: TRect;
  GenButton, ApplyButton, CloseButton: TRect;
  PaletteData: TPEState;
  MX, MY, MB, PreviousButtons: Integer;
 End;

Function VuOutFile: String;
Var
 N: String;
Begin
 N := ScTempFile;
 VuOutFile := Copy(N,1,Length(N)-12)+'PAINTVTN.PNG';
End;

Procedure VuLayout(Var D: TVuState);
Begin
 D.X := (ScreenWidth-BR_W) Div 2;
 D.Y := (ScreenHeight-BR_H) Div 2;
 PERect(D.GarmEdit,D.X+12,D.Y+70,196,20);
 PERect(D.Browse,D.X+216,D.Y+68,84,24);
 PERect(D.KindM,D.X+12,D.Y+116,24,22);
 PERect(D.KindLabel,D.X+42,D.Y+116,216,22);
 PERect(D.KindP,D.X+264,D.Y+116,24,22);
 PERect(D.PromptEdit,D.X+12,D.Y+164,288,20);
 PERect(D.QualM,D.X+12,D.Y+270,24,20);
 PERect(D.QualTrack,D.X+42,D.Y+270,216,20);
 PERect(D.QualP,D.X+264,D.Y+270,24,20);
 PERect(D.GpuBox,D.X+12,D.Y+298,288,20);
 PERect(D.PrevBox,D.X+316,D.Y+50,288,200);
 PERect(D.GenButton,D.X+12,D.Y+340,160,25);
 PERect(D.ApplyButton,D.X+184,D.Y+340,120,25);
 PERect(D.CloseButton,D.X+316,D.Y+340,108,25);
End;

Procedure VuEdit(Const R: TRect; Const S: String; Focused: Boolean);
Var
 T: String;
 Max: Integer;
Begin
 PEFill(R,White);
 PEBevel(R,True);
 Max := (R.Right-R.Left-8) Div 8;
 T := S;
 If Focused Then T := T+'_';
 If Length(T) > Max Then T := Copy(T,Length(T)-Max+1,Max);
 SetColor(Black);
 OutTextXY(R.Left+4,R.Top+6,T);
End;

Procedure VuDrawPreview(Const D: TVuState);
Var
 R: TRect;
 W, H, DW, DH, X, Y, SX, SY, L, T: Integer;
 C: TRGBColor;
 P: PByte;
 UseRes: Boolean;
Begin
 R := D.PrevBox;
 PEFill(R,LightGray);
 PEBevel(R,True);
 UseRes := D.ShowAfter And (VxPrevPx <> Nil);
 If UseRes Then Begin
  W := VxPrevW;
  H := VxPrevH;
 End
 Else Begin
  If Not PGHasImage Then Exit;
  W := CanvasImageW;
  H := CanvasImageH;
 End;
 RFFitSize(W,H,280,192,DW,DH);
 L := R.Left+(R.Right-R.Left+1-DW) Div 2;
 T := R.Top+(R.Bottom-R.Top+1-DH) Div 2;
 For Y := 0 To DH-1 Do Begin
  SY := Min(H-1,(LongInt(Y)*H+H Div 2) Div DH);
  For X := 0 To DW-1 Do Begin
   SX := Min(W-1,(LongInt(X)*W+W Div 2) Div DW);
   If UseRes Then Begin
    P := VxPrevPx;
    Inc(P,(LongInt(SY)*W+SX)*3);
    C := PERGB(P^,PByte(PtrUInt(P)+1)^,PByte(PtrUInt(P)+2)^);
    PutPixel(L+X,T+Y,PEDisplayColor(C));
   End
   Else If PGReadRGB(SX,SY,C) Then
    PutPixel(L+X,T+Y,PEDisplayColor(C));
  End;
 End;
 SetColor(DarkGray);
 Rectangle(L-1,T-1,L+DW,T+DH);
End;

Procedure VuDraw(Var D: TVuState);
Var
 R: TRect;
 S: String;
 I: Integer;
Begin
 PEHideMouse;
 SetWriteMode(CopyPut);
 SetLineStyle(SolidLn,0,NormWidth);
 PERect(R,D.X,D.Y,BR_W,BR_H);
 PEFill(R,LightGray);
 PEBevel(R,False);
 SetFillStyle(SolidFill,Blue);
 Bar(D.X+3,D.Y+3,D.X+BR_W-4,D.Y+21);
 SetColor(White);
 OutTextXY(D.X+9,D.Y+7,'Fusionner des vetements - PAINT');
 OutTextXY(D.X+BR_W-18,D.Y+7,'X');
 PELabel(D.X+12,D.Y+33,'Photo : l''image courante du canevas');
 PELabel(D.X+12,D.Y+52,'Vetement a essayer (facultatif) :');
 VuEdit(D.GarmEdit,D.Garment,D.Focus = 0);
 PEButton(D.Browse,'Parcourir',False);
 PELabel(D.X+12,D.Y+98,'Type de vetement :');
 PEButton(D.KindM,'<',False);
 PEButton(D.KindP,'>',False);
 PEFill(D.KindLabel,White);
 PEBevel(D.KindLabel,True);
 PELabel(D.KindLabel.Left+6,D.KindLabel.Top+7,VU_KINDNAME[D.Kind]);
 PELabel(D.X+12,D.Y+146,'Demande (prompt) :');
 VuEdit(D.PromptEdit,D.Prompt,D.Focus = 1);
 SetColor(DarkGray);
 OutTextXY(D.X+12,D.Y+190,'Ex. : Change le chandail en bleu');
 OutTextXY(D.X+12,D.Y+206,'Mets une robe a pois');
 OutTextXY(D.X+12,D.Y+222,'Enleve le chapeau');
 OutTextXY(D.X+12,D.Y+238,'Ou en anglais : make it red');
 Case D.Quality Of
  1: S := 'Rapide';
  2: S := 'Normal';
  3: S := 'Eleve';
 Else S := 'Maximal'; End;
 PELabel(D.X+12,D.Y+252,'Qualite : '+S);
 BLSlider(D.QualM,D.QualTrack,D.QualP,D.Quality-1,3);
 BRCheckBox(D.GpuBox,D.UseGpu,'Utiliser le GPU (Direct3D 11)');
 If D.HasResult Then
  PELabel(D.X+316,D.Y+33,'APERCU (clic = comparer)')
 Else
  PELabel(D.X+316,D.Y+33,'APERCU (photo courante)');
 If D.HasResult Then Begin
  If D.ShowAfter Then PELabel(D.X+560,D.Y+33,'APRES')
  Else PELabel(D.X+560,D.Y+33,'AVANT');
 End;
 VuDrawPreview(D);
 VxLogX := D.X+316;
 VxLogY := D.Y+262;
 VxDrawLog;
 PEButton(D.GenButton,'Generer l''apercu',False);
 PEButton(D.ApplyButton,'Appliquer',False);
 If Not D.HasResult Then Begin
  PEFill(D.ApplyButton,LightGray);
  PEBevel(D.ApplyButton,False);
  SetColor(DarkGray);
  OutTextXY(D.ApplyButton.Left+(120-TextWidth('Appliquer')) Div 2,
            D.ApplyButton.Top+8,'Appliquer');
 End;
 PEButton(D.CloseButton,'Fermer',False);
 If D.Status <> '' Then Begin
  SetColor(DarkGray);
  OutTextXY(D.X+316,D.Y+329,Copy(D.Status,1,36));
 End;
 PEShowMouse;
 D.Dirty := False;
End;

Procedure VuKey(Var D: TVuState; K: Char);
Var
 L: Integer;
Begin
 If D.Focus = 0 Then Begin
  If K = #8 Then Begin
   L := Length(D.Garment);
   If L > 0 Then D.Garment := Copy(D.Garment,1,L-1);
  End
  Else If (K >= ' ') And (Length(D.Garment) < 199) Then
   D.Garment := D.Garment+K;
 End
 Else Begin
  If K = #8 Then Begin
   L := Length(D.Prompt);
   If L > 0 Then D.Prompt := Copy(D.Prompt,1,L-1);
  End
  Else If (K >= ' ') And (Length(D.Prompt) < 199) Then
   D.Prompt := D.Prompt+K;
 End;
 D.Dirty := True;
End;

Procedure VuKeyboard(Var D: TVuState);
Var
 K: Char;
Begin
 K := ReadKey;
 If K = #0 Then Begin
  K := ReadKey;
  Exit;
 End;
 Case K Of
  #27: D.Done := True;
  #9: Begin D.Focus := 1-D.Focus; D.Dirty := True; End;
  #13: If D.Focus = 0 Then Begin D.Focus := 1; D.Dirty := True; End
       Else D.Run := True;
 Else VuKey(D,K); End;
End;

Procedure VuMouse(Var D: TVuState);
Var
 Pressed: Boolean;
 Name: String;
Begin
 GetMouseStateLocal(D.MX,D.MY,D.MB);
 Pressed := ((D.MB And 1) <> 0) And ((D.PreviousButtons And 1) = 0);
 If (D.MB And 1) <> 0 Then
  If PEInside(D.MX,D.MY,D.QualTrack) Then Begin
   D.Quality := PEClamp(1+((D.MX-D.QualTrack.Left-2)*3*2+
                (D.QualTrack.Right-D.QualTrack.Left-4)) Div
                (2*(D.QualTrack.Right-D.QualTrack.Left-4)),1,4);
   D.Dirty := True;
  End;
 If Pressed Then Begin
  D.Status := '';
  If (D.MX >= D.X+BR_W-24) And (D.MX <= D.X+BR_W-4) And
     (D.MY >= D.Y+3) And (D.MY <= D.Y+21) Then
   D.Done := True
  Else If PEInside(D.MX,D.MY,D.CloseButton) Then
   D.Done := True
  Else If PEInside(D.MX,D.MY,D.GenButton) Then
   D.Run := True
  Else If PEInside(D.MX,D.MY,D.ApplyButton) Then Begin
   If D.HasResult Then Begin
    D.Apply := True;
    D.Done := True;
   End;
  End
  Else If PEInside(D.MX,D.MY,D.GarmEdit) Then Begin
   D.Focus := 0; D.Dirty := True;
  End
  Else If PEInside(D.MX,D.MY,D.PromptEdit) Then Begin
   D.Focus := 1; D.Dirty := True;
  End
  Else If PEInside(D.MX,D.MY,D.Browse) Then Begin
   PEShowMouse;
   Name := '';
   If OpenImageDialog(Name) Then
    D.Garment := Copy(Name,1,200);
   D.Dirty := True;
  End
  Else If PEInside(D.MX,D.MY,D.KindM) Then Begin
   D.Kind := (D.Kind+VU_KINDS-1) Mod VU_KINDS; D.Dirty := True;
  End
  Else If PEInside(D.MX,D.MY,D.KindP) Then Begin
   D.Kind := (D.Kind+1) Mod VU_KINDS; D.Dirty := True;
  End
  Else If PEInside(D.MX,D.MY,D.QualM) Then Begin
   D.Quality := PEClamp(D.Quality-1,1,4); D.Dirty := True;
  End
  Else If PEInside(D.MX,D.MY,D.QualP) Then Begin
   D.Quality := PEClamp(D.Quality+1,1,4); D.Dirty := True;
  End
  Else If PEInside(D.MX,D.MY,D.GpuBox) Then Begin
   D.UseGpu := Not D.UseGpu; D.Dirty := True;
  End
  Else If PEInside(D.MX,D.MY,D.PrevBox) Then Begin
   If D.HasResult Then Begin
    D.ShowAfter := Not D.ShowAfter; D.Dirty := True;
   End;
  End;
 End;
 D.PreviousButtons := D.MB;
End;

Procedure VuGenerate(Var D: TVuState);
Var
 Err: AnsiString;
 I, MX, MY, MB: Integer;
 Ok: Boolean;
Begin
 For I := 0 To 3 Do VxLog[I] := '';
 VxLogX := D.X+316;
 VxLogY := D.Y+262;
 VxDrawLog;
 VxCancelRect := D.GenButton;
 { attendre le relachement du clic qui a lance la generation : sinon la
   premiere note du moteur le prend pour un clic sur Annuler }
 Repeat
  GetMouseStateLocal(MX,MY,MB);
 Until (MB And 1) = 0;
 PEHideMouse;
 PEButton(D.GenButton,'Annuler (Echap)',False);
 PEShowMouse;
 VtOptOut := VuOutFile;
 VtOptType := VU_KIND[D.Kind];
 VtOptModel := '';
 VtOptPrompt := VtCp437ToUtf8(D.Prompt);
 VtOptParsing := '';
 VtOptSaveParsing := '';
 VtOptDump := '';
 VtOptQuality := D.Quality;
 VtOptCpu := Not D.UseGpu;
 VtOptGpu := D.UseGpu;
 VtOptSeed := -1;
 VtOptThreads := 0;
 VtOptDevice := -1;
 VtOptMaxSize := 1024;
 VtOptSize := 0;
 VtVerbose := True;
 VtQuiet := False;
 SetLength(VtPos_,1);
 VtPos_[0] := 'canevas';
 If D.Garment <> '' Then Begin
  SetLength(VtPos_,2);
  VtPos_[1] := D.Garment;
 End;
 VxFails := 0;
 VxLastWarn := '';
 Ok := VxRun(Err);
 If Ok Then Begin
  D.HasResult := True;
  D.ShowAfter := True;
  If VxFails > 0 Then
   D.Status := 'Apercu pret (certaines retouches ont echoue).'
  Else
   D.Status := 'Apercu pret : Appliquer pour l''importer.';
 End
 Else Begin
  D.Status := Copy(Err,1,76);
 End;
 D.PreviousButtons := 1;
 D.Dirty := True;
End;

Procedure VtonDialog;
Var
 D: TVuState;
 Name, Msg: String;
 Backup: PHistoryData;
 Metadata: TImageBuffer;
 OldZoom, OldX, OldY: Integer;
 F: File;
Begin
 If Not PGHasImage Then Begin
  ShowMessage('Fusionner des vetements','Aucune image a traiter.');
  Exit;
 End;
 MenuActive := False;
 RedrawInterface;
 FillChar(D,SizeOf(D),0);
 D.Quality := 2;
 D.Focus := 1;
 D.Kind := 0;
 D.Garment := '';
 D.Prompt := '';
 VuLayout(D);
 PEInitialize(D.PaletteData);
 PEHideMouse;
 PEBuildDisplayPalette;
 PEShowMouse;
 GetMouseStateLocal(D.MX,D.MY,D.PreviousButtons);
 D.Dirty := True;
 While Not D.Done Do Begin
  If D.Dirty Then VuDraw(D);
  If KeyPressed Then VuKeyboard(D);
  If Not D.Done Then VuMouse(D);
  If D.Run Then Begin
   D.Run := False;
   VuGenerate(D);
  End;
  Delay(10);
 End;
 If VxPrevPx <> Nil Then Begin
  FreeMem(VxPrevPx);
  VxPrevPx := Nil;
 End;
 Repeat
  GetMouseStateLocal(D.MX,D.MY,D.MB);
  If (D.MB And 1) <> 0 Then Delay(10);
 Until (D.MB And 1) = 0;
 OldMouseButtons := 0;
 MouseButtons := 0;
 Name := VuOutFile;
 PEHideMouse;
 PERestoreHardware(D.PaletteData);
 PEShowMouse;
 RedrawInterface;
 If D.Apply Then Begin
  AddSnapshotToHistory(TOOL_PICKER);
  Backup := SaveFullSnapshot;
  If Backup = Nil Then
   ShowMessage('Fusionner des vetements','Impossible de proteger l''image courante.')
  Else Begin
   Metadata := ImageBuffer;
   OldZoom := ZoomLevel; OldX := ZOriginX; OldY := ZOriginY;
   If LoadImage(Name) Then Begin
    ZoomLevel := 100; ZOriginX := 0; ZOriginY := 0;
    SelectionActive := False;
    ImageBuffer.FileName := '';
    ImageBuffer.Modified := True;
   End
   Else Begin
    RestoreFullSnapshot(Backup); ImageBuffer := Metadata;
    ZoomLevel := OldZoom; ZOriginX := OldX; ZOriginY := OldY;
    ShowMessage('Fusionner des vetements','Le resultat n''a pas pu etre charge.');
   End;
   FreeHistoryData(Backup);
  End;
  RedrawInterface;
 End;
 Assign(F,Name);
 {$I-} Erase(F); {$I+}
 If IOResult <> 0 Then;
End;


Procedure OpenImageCommand;
Var Name: String; Backup: PHistoryData; Metadata: TImageBuffer;
    OldZoom,OldX,OldY: Integer; Item: PHistoryItem;
Begin
 Name:='';
 If Not OpenImageDialog(Name) Then Exit;
 If Not ConfirmDiscardChanges Then Exit;
 Backup:=SaveFullSnapshot;
 If Backup=Nil Then Begin ShowMessage('Ouvrir','Impossible de proteger l''image courante.'); Exit; End;
 Metadata:=ImageBuffer; OldZoom:=ZoomLevel; OldX:=ZOriginX; OldY:=ZOriginY;
 If LoadImage(Name) Then Begin
  While UndoList<>Nil Do Begin
   Item:=UndoList; UndoList:=Item^.Next;
   FreeHistoryData(PHistoryData(Item^.Data)); Dispose(Item);
  End;
  While RedoList<>Nil Do Begin
   Item:=RedoList; RedoList:=Item^.Next;
   FreeHistoryData(PHistoryData(Item^.Data)); Dispose(Item);
  End;
  UndoCount:=0; RedoCount:=0; ImageBuffer.Modified:=False;
  ZoomLevel:=100; ZOriginX:=0; ZOriginY:=0;
  SelectionActive:=False;
 End Else Begin
  RestoreFullSnapshot(Backup); ImageBuffer:=Metadata;
  ZoomLevel:=OldZoom; ZOriginX:=OldX; ZOriginY:=OldY;
  RedrawInterface;
  ShowMessage('Ouvrir','Fichier invalide, format non reconnu ou lecture impossible. Image conservee.');
 End;
 FreeHistoryData(Backup); RedrawInterface;
End;


{ Construction temporaire d'un polygone : aucun pixel du document n'est
  modifie avant validation. Une seule entree Annuler pour la forme complete. }
Procedure PolygonPaint;
Var I,X,Y: Integer; Previous: ViewPortType;
Begin
 If (PolygonCount=0) Or (CurrentTool<>TOOL_POLYGON) Then Exit;
 ZBeginView(Previous); SetWriteMode(XORPut); SetColor(White);
 SetLineStyle(SolidLn,0,NormWidth);
 For I:=1 To PolygonCount-1 Do
  Line(ZViewX(PolygonX[I-1]),ZViewY(PolygonY[I-1]),ZViewX(PolygonX[I]),ZViewY(PolygonY[I]));
 If PolygonHover Then Begin
  SetLineStyle(DottedLn,0,NormWidth);
  Line(ZViewX(PolygonX[PolygonCount-1]),ZViewY(PolygonY[PolygonCount-1]),
       ZViewX(PolygonMouseX),ZViewY(PolygonMouseY));
  If PolygonCount>=2 Then Line(ZViewX(PolygonMouseX),ZViewY(PolygonMouseY),ZViewX(PolygonX[0]),ZViewY(PolygonY[0]));
 End;
 SetLineStyle(SolidLn,0,NormWidth);
 For I:=0 To PolygonCount-1 Do Begin
  X:=ZViewX(PolygonX[I]); Y:=ZViewY(PolygonY[I]);
  Rectangle(X-2,Y-2,X+2,Y+2);
 End;
 SetWriteMode(CopyPut); ZEndView(Previous);
End;

Procedure PolygonPreview;
Begin
 PolygonPaint;
 PolygonOverlayValid:=(PolygonCount>0) And (CurrentTool=TOOL_POLYGON);
End;

Procedure ErasePolygonPreview;
Begin
 If PolygonOverlayValid Then PolygonPaint;
 PolygonOverlayValid:=False;
End;

Procedure PolygonCancel;
Begin
 If PolygonCount=0 Then Exit;
 PolygonCount:=0; PolygonHover:=False; RedrawInterface;
End;

Procedure PolygonFinish;
Var I,J,K,Count,MinY,MaxY,Y,SwapX: Integer;
    Crossings: Array[0..255] Of Integer; CX: LongInt;
Begin
 If PolygonCount<3 Then Begin PolygonCancel; Exit; End;
 AddSnapshotToHistory(TOOL_POLYGON);
 If FillStyle>0 Then Begin
  MinY:=PolygonY[0]; MaxY:=MinY;
  For I:=1 To PolygonCount-1 Do Begin MinY:=Min(MinY,PolygonY[I]); MaxY:=Max(MaxY,PolygonY[I]); End;
  { Remplissage pair/impair, sommets superieurs exclus pour eviter de
    compter deux fois une intersection commune a deux aretes. }
  For Y:=MinY To MaxY Do Begin
   Count:=0; J:=PolygonCount-1;
   For I:=0 To PolygonCount-1 Do Begin
    If ((PolygonY[I]<=Y) And (PolygonY[J]>Y)) Or
       ((PolygonY[J]<=Y) And (PolygonY[I]>Y)) Then Begin
     CX:=PolygonX[I]+LongInt(Y-PolygonY[I])*(PolygonX[J]-PolygonX[I]) Div (PolygonY[J]-PolygonY[I]);
     Crossings[Count]:=CX; Inc(Count);
    End;
    J:=I;
   End;
   For I:=1 To Count-1 Do Begin
    SwapX:=Crossings[I]; K:=I-1;
    While K>=0 Do Begin
     If Crossings[K]<=SwapX Then Break;
     Crossings[K+1]:=Crossings[K]; Dec(K);
    End;
    Crossings[K+1]:=SwapX;
   End;
   I:=0;
   While I+1<Count Do Begin ZLine(Crossings[I]-CanvasX,Y-CanvasY,Crossings[I+1]-CanvasX,Y-CanvasY,CurrentColor); Inc(I,2); End;
  End;
 End;
 J:=PolygonCount-1;
 For I:=0 To PolygonCount-1 Do Begin ZLine(PolygonX[J]-CanvasX,PolygonY[J]-CanvasY,PolygonX[I]-CanvasX,PolygonY[I]-CanvasY,CurrentColor); J:=I; End;
 ImageBuffer.Modified:=True;
 PolygonCount:=0; PolygonHover:=False; RedrawInterface;
End;

Function PolygonNear(X,Y,PX,PY: Integer): Boolean;
Begin
 PolygonNear:=(Abs(LongInt(X)-PX)*ZoomLevel<=500) And (Abs(LongInt(Y)-PY)*ZoomLevel<=500);
End;

Procedure PolygonClick(X,Y: Integer);
Var Now,Elapsed: LongInt;
Begin
 Now:=ToolTipClock; Elapsed:=Now-PolygonLastClick;
 If Elapsed<0 Then Inc(Elapsed,8640000);
 If PolygonCount>=3 Then Begin
  If PolygonNear(X,Y,PolygonX[0],PolygonY[0]) Or
     ((Elapsed<45) And PolygonNear(X,Y,PolygonX[PolygonCount-1],PolygonY[PolygonCount-1])) Then Begin
   PolygonFinish; Exit;
  End;
 End;
 If PolygonCount>0 Then
  If (X=PolygonX[PolygonCount-1]) And (Y=PolygonY[PolygonCount-1]) Then Exit;
 If PolygonCount>=256 Then Exit;
 PolygonX[PolygonCount]:=X; PolygonY[PolygonCount]:=Y; Inc(PolygonCount);
 PolygonMouseX:=X; PolygonMouseY:=Y; PolygonHover:=True; PolygonLastClick:=Now;
 EraseSelection; SelectionActive:=False; RedrawInterface;
End;


{ Proprietes du document : informations calculees et metadonnees persistantes.
  Les changements restent locaux jusqu'a Appliquer/OK/Enregistrer. }
Procedure ImagePropertiesDialog;
Var Draft: TPaintMetadata; Editor: POFState; X,Y,W,H,Tab,Focus,I,J,MX,MY,B,Prev,Used: Integer;
    Colors: Array[0..255] Of Boolean; R: SearchRec; DT: DateTime; Preview: TRect;
    DiskSize,N: LongInt; Stamp,Attributes,Notice,S,T: String; K,E: Char;
    Done,Dirty,Exists,Changed,Saved: Boolean;
 Function Editable(Index: Integer): Boolean;
 Begin
  Editable:=(ImageBuffer.Format=FMT_PNG) Or ((ImageBuffer.Format=FMT_GIF) And (Index=5));
 End;
 Function FieldName(Index: Integer): String;
 Begin
  Case Index Of
   0: FieldName:='Titre'; 1: FieldName:='Auteur'; 2: FieldName:='Copyright';
   3: FieldName:='Logiciel'; 4: FieldName:='Description'; 5: FieldName:='Note (GIF/PNG)';
  Else FieldName:=''; End;
 End;
 Function YesNo(Value: Boolean): String;
 Begin If Value Then YesNo:='Oui' Else YesNo:='Non'; End;
 Procedure StoreField;
 Begin If (Tab=1) And (Focus<6) And Editable(Focus) Then Draft.Values[Focus]:=Editor^.Name; End;
 Procedure SetFocus(Value: Integer);
 Begin
  StoreField; Focus:=Value;
  If Focus<6 Then Begin
   Editor^.Name:=Draft.Values[Focus]; Editor^.Cursor:=Length(Editor^.Name); Editor^.Anchor:=Editor^.Cursor;
  End;
  Dirty:=True;
 End;
 Procedure FileDetails;
 Begin
  DiskSize:=0; Stamp:='Non enregistre'; Attributes:=''; Exists:=False;
  If ImageBuffer.FileName='' Then Exit;
  FindFirst(ImageBuffer.FileName,AnyFile,R);
  If DosError=0 Then Begin
   Exists:=True; DiskSize:=R.Size; UnpackTime(R.Time,DT);
   Stamp:=APTwoDigits(DT.Day)+'/'+APTwoDigits(DT.Month)+'/'+IntToStr(DT.Year)+' '+APTwoDigits(DT.Hour)+':'+APTwoDigits(DT.Min);
   If (R.Attr And ReadOnly)<>0 Then Attributes:='Lecture seule ' Else Attributes:='Accessible en ecriture ';
   If (R.Attr And Hidden)<>0 Then Attributes:=Attributes+' / cache';
  End;
  {$IFDEF FPC}FindClose(R);{$ENDIF}
 End;
 Function Apply: Boolean;
 Begin
  Apply:=False; StoreField;
  Changed:=CompareByte(Draft,ImageBuffer.Metadata,SizeOf(Draft))<>0;
  If Draft.Limited Then Begin
   If PromptYesNoCancel('Remplacement des textes importes',
    'Certains textes depassent 255 caracteres ou Latin-1. Remplacer par les champs affiches ?')<>1 Then Begin Dirty:=True; Exit; End;
   Draft.Limited:=False; Changed:=True;
  End;
  If Changed Then Begin ImageBuffer.Metadata:=Draft; ImageBuffer.Modified:=True; End;
  Notice:='Champs appliques au document. Enregistrer pour les ecrire dans le fichier.';
  Apply:=True; Dirty:=True;
 End;
 Procedure Activate(Button: Integer);
 Begin
  Case Button Of
   0: If Apply Then Done:=True;
   1: Apply;
   2: Done:=True;
   3: If Apply Then Begin
    Saved:=SaveCurrentImage; FileDetails;
    If Saved Then Notice:='Fichier enregistre avec les champs disponibles dans ce format.';
    Dirty:=True;
   End;
   4: Begin
    ShowMessage('Textes et enregistrement','PNG : titre, auteur, droits, logiciel, description et commentaire. GIF : commentaire seul.');
    ShowMessage('Edition','255 caracteres Latin-1 par champ. Tab, fleches, Ctrl+A/C/X/V. Appliquer ne modifie pas encore le fichier.');
    Dirty:=True;
   End;
  End;
 End;
 Procedure KeyValue(Row: Integer; Const LabelText,Value: String);
 Begin
  SetColor(DarkGray); OutTextXY(X+14,Y+82+Row*22,LabelText);
  SetColor(Black); OutTextXY(X+168,Y+82+Row*22,OFShort(Value,W-390));
 End;
 Procedure Field(Index: Integer);
 Var XX,YY,WW,Offset,Lo,Hi,LeftPos,RightPos,Caret: Integer; Value: String;
 Begin
  XX:=X+158; YY:=Y+124+Index*39; WW:=W-174;
  SetColor(Black); OutTextXY(X+12,YY+7,FieldName(Index));
  If Editable(Index) Then SetFillStyle(SolidFill,White) Else SetFillStyle(SolidFill,LightGray);
  Bar(XX,YY,XX+WW,YY+23);
  If Focus=Index Then SetColor(Blue) Else SetColor(DarkGray); Rectangle(XX,YY,XX+WW,YY+23);
  Value:=Draft.Values[Index]; If Focus=Index Then Value:=Editor^.Name;
  { Les sauts de ligne importes restent stockes, mais se lisent sur une ligne. }
  For Caret:=1 To Length(Value) Do If Value[Caret]<' ' Then Value[Caret]:=' ';
  Offset:=0;
  If Focus=Index Then While TextWidth(Copy(Value,Offset+1,Editor^.Cursor-Offset))+12>WW Do Inc(Offset);
  SetColor(Black); If Not Editable(Index) Then SetColor(DarkGray);
  OutTextXY(XX+5,YY+7,OFShort(Copy(Value,Offset+1,255),WW-12));
  If (Focus=Index) And Editable(Index) Then Begin
   Lo:=Min(Editor^.Cursor,Editor^.Anchor); Hi:=Max(Editor^.Cursor,Editor^.Anchor);
   LeftPos:=XX+5+TextWidth(Copy(Value,Offset+1,Max(0,Lo-Offset)));
   RightPos:=Min(XX+WW-4,XX+5+TextWidth(Copy(Value,Offset+1,Max(0,Hi-Offset))));
   If (Hi>Lo) And (RightPos>LeftPos) Then Begin
    SetFillStyle(SolidFill,LightBlue); Bar(LeftPos,YY+4,RightPos,YY+19);
    SetColor(Black); OutTextXY(LeftPos,YY+7,OFShort(Copy(Value,Max(Lo,Offset)+1,Hi-Max(Lo,Offset)),RightPos-LeftPos));
   End;
   Caret:=XX+5+TextWidth(Copy(Value,Offset+1,Editor^.Cursor-Offset));
   SetColor(Black); Line(Caret,YY+4,Caret,YY+19);
  End;
 End;
 Procedure DrawPreview;
 Var PW,PH,PX,PY,L,T: Integer;
 Begin
  PERect(Preview,X+W-200,Y+80,184,154); RFChecker(Preview); PEBevel(Preview,True);
  If Not PGHasImage Then Exit;
  RFFitSize(CanvasImageW,CanvasImageH,176,146,PW,PH);
  L:=Preview.Left+(184-PW) Div 2; T:=Preview.Top+(154-PH) Div 2;
  For PY:=0 To PH-1 Do For PX:=0 To PW-1 Do
   PutPixel(L+PX,T+PY,ZImagePixel((LongInt(PX)*CanvasImageW) Div PW,(LongInt(PY)*CanvasImageH) Div PH));
 End;
 Procedure Draw;
 Var I: Integer;
 Begin
  HideMouse; SetFillStyle(SolidFill,LightGray); Bar(X,Y,X+W,Y+H);
  SetColor(DarkGray); Rectangle(X,Y,X+W,Y+H);
  SetFillStyle(SolidFill,Blue); Bar(X+1,Y+1,X+W-1,Y+24);
  SetColor(White); OutTextXY(X+12,Y+8,'Proprietes de l''image');
  OFButton(X+12,Y+32,150,'Informations',Tab=0); OFButton(X+168,Y+32,150,'Metadonnees',Tab=1);
  If Tab=0 Then Begin
   S:=OFBase(ImageBuffer.FileName); If S='' Then S:='Sans titre';
   KeyValue(0,'Nom',S); KeyValue(1,'Format source',APFormatName(ImageBuffer.Format));
   KeyValue(2,'Dimensions',IntToStr(ImageBuffer.Width)+' x '+IntToStr(ImageBuffer.Height)+' px');
   KeyValue(3,'Profondeur source',IntToStr(ImageBuffer.BitDepth)+' bits / pixel');
   KeyValue(4,'Canevas PAINT','8 bits indexes / 256 entrees');
   KeyValue(5,'Couleurs utilisees',IntToStr(Used));
   KeyValue(6,'Transparence',YesNo(ImageBuffer.HasTransparency));
   KeyValue(7,'Modifications',YesNo(ImageBuffer.Modified));
   If Exists Then KeyValue(8,'Taille sur disque',STMemoryText(DiskSize)+' ('+IntToStr(DiskSize)+' octets)')
   Else KeyValue(8,'Taille sur disque','Fichier absent / nouveau');
   KeyValue(9,'Memoire des pixels',STMemoryText(LongInt(CanvasImageW)*CanvasImageH));
   KeyValue(10,'Date du fichier',Stamp); KeyValue(11,'Acces',Attributes);
   DrawPreview;
   SetColor(Black); OutTextXY(X+W-198,Y+244,'Apercu du document');
   OutTextXY(X+W-198,Y+270,'Exports : 32 formats disponibles');
   OutTextXY(X+W-198,Y+288,'GIF : note uniquement');
   OutTextXY(X+W-198,Y+306,'PNG : six champs texte');
   If ImageBuffer.HasHotspot Then Begin
    OutTextXY(X+W-198,Y+324,'Point chaud : '+
     IntToStr(ImageBuffer.HotspotX)+', '+IntToStr(ImageBuffer.HotspotY));
    OutTextXY(X+W-198,Y+342,'Images CUR : '+
     IntToStr(ImageBuffer.CursorImages));
   End;
   OutTextXY(X+12,Y+354,'Chemin : '+OFShort(ImageBuffer.FileName,W-100));
  End Else Begin
   SetColor(Black);
   If ImageBuffer.Format=FMT_PNG Then S:='PNG : les six champs sont lus et enregistres dans le fichier.'
   Else If ImageBuffer.Format=FMT_GIF Then S:='GIF : seule la note / le commentaire peut etre modifie.'
   Else S:='Lecture seule pour ce format. Enregistrez en PNG pour editer ces champs.';
   OutTextXY(X+12,Y+78,OFShort(S,W-24));
   If Draft.Limited Then Begin SetColor(Red); S:='Textes longs / Unicode : remplacement soumis a confirmation.'; End
   Else Begin SetColor(DarkGray); S:='255 caracteres par champ. Ctrl+A/C/X/V : selection et presse-papiers.'; End;
   OutTextXY(X+12,Y+100,OFShort(S,W-24));
   For I:=0 To 5 Do Field(I);
  End;
  SetColor(DarkGray); OutTextXY(X+12,Y+H-65,OFShort(Notice,W-24));
  For I:=0 To 4 Do Begin
   Case I Of 0:S:='OK'; 1:S:='Appliquer'; 2:S:='Annuler'; 3:S:='Enregistrer'; 4:S:='Aide'; End;
   OFButton(X+12+I*((W-24) Div 5),Y+H-40,(W-34) Div 5,S,Focus=I+6);
  End;
  ShowMouse; Dirty:=False;
 End;
Begin
 Editor:=POFState(JDAllocate(SizeOf(TOFState))); If Editor=Nil Then Exit;
 FillChar(Editor^,SizeOf(TOFState),0); Draft:=ImageBuffer.Metadata;
 X:=10; W:=Min(760,ScreenWidth-20); H:=Min(520,ScreenHeight-20);
 X:=(ScreenWidth-W) Div 2; Y:=(ScreenHeight-H) Div 2;
 Tab:=0; Focus:=6; Done:=False; Dirty:=True; Used:=0;
 FillChar(Colors,SizeOf(Colors),0);
 If CanvasImage<>Nil Then For N:=0 To LongInt(CanvasImageW)*CanvasImageH-1 Do Colors[PPNBytes(CanvasImage)^[N]]:=True;
 For I:=0 To 255 Do If Colors[I] Then Inc(Used);
 FileDetails; Notice:='F1 : informations   F2 : metadonnees   Echap : annuler';
 GetMouseStateLocal(MX,MY,Prev);
 Repeat
  If Dirty Then Draw;
  If KeyPressed Then Begin
   K:=ReadKey; E:=#0; If K=#0 Then E:=ReadKey;
   If K=#27 Then Done:=True
   Else If (K=#0) And (E In [#59,#60]) Then Begin StoreField; Tab:=Ord(E)-59; SetFocus(6); End
   Else If K=#9 Then Begin
    J:=Focus;
    Repeat J:=(J+1) Mod 11; Until (J>=6) Or ((Tab=1) And Editable(J));
    SetFocus(J);
   End Else If K=#13 Then Begin If Focus>=6 Then Activate(Focus-6) Else Activate(0); End
   Else If (K=' ') And (Focus>=6) Then Activate(Focus-6)
   Else If (Tab=1) And (Focus<6) And (Editable(Focus) Or (K In [#1,#3])) Then Begin OFEdit(Editor^,K,E); Dirty:=True; End;
  End;
  GetMouseStateLocal(MX,MY,B);
  If ((B And 1)<>0) And ((Prev And 1)=0) Then Begin
   If (MY>=Y+32) And (MY<=Y+54) Then Begin
    If (MX>=X+12) And (MX<=X+162) Then Begin StoreField; Tab:=0; SetFocus(6); End;
    If (MX>=X+168) And (MX<=X+318) Then Begin StoreField; Tab:=1; SetFocus(6); End;
   End;
   If Tab=1 Then For J:=0 To 5 Do
    If (MX>=X+158) And (MX<=X+W-16) And (MY>=Y+124+J*39) And (MY<=Y+147+J*39) Then SetFocus(J);
   If (MY>=Y+H-40) And (MY<=Y+H-18) And (MX>=X+12) And (MX<X+W-12) Then Begin
    J:=(MX-X-12) Div ((W-24) Div 5); If J<=4 Then Begin SetFocus(J+6); Activate(J); End;
   End;
  End;
  Prev:=B; Delay(10);
 Until Done;
 FreeMem(Editor,SizeOf(TOFState)); RedrawInterface;
End;

Procedure HandleMenuClick(MenuIndex, ItemIndex: Integer);
Var
 NewName: String;
 Fmt: Byte;
 InfoMsg: String;
 NewW, NewH, ValErr: Integer;
Begin
 PolygonCancel;
 Case MenuIndex of
  MENU_FILE: Begin
   Case ItemIndex of
    0: Begin { Nouveau }
     AddSnapshotToHistory(TOOL_PENCIL);
     { Reinitialiser la palette aux 16 couleurs VGA standard. Si une image
       avait ete chargee, sa palette restait active et etait sauvegardee
       avec la nouvelle image. }
     InitImage;
     InitPalette;
     ActivePaletteSlot := 0;
     PEInstallDocumentPalette;
     If Not ZPrepareBuffer(ImageBuffer.Width,ImageBuffer.Height,BackgroundColor) Then Begin
      ShowMessage('Nouveau','Memoire insuffisante.'); Exit;
     End;
     ClearImage;
     If (CanvasImage <> Nil) and (CanvasImageW > 0) and (CanvasImageH > 0) Then
      FillChar(CanvasImage^, CanvasImageW * CanvasImageH, BackgroundColor);
     ImageBuffer.FileName := '';
     ImageBuffer.Modified := False;
     DrawStatusBar;
    End;
    1: OpenImageCommand; { Ouvrir : explorateur graphique Pascal }
    2: Begin SaveCurrentImage; End;
    3: Begin SaveAsCurrentImage; End;
    5: ScanImportCommand; { Importer depuis un scanner (WIA) }
    6: Begin { Imprimer }
     ShowMessage('Imprimer', 'Impression non disponible.');
    End;
    8: ImagePropertiesDialog; { Proprietes detaillees et textes persistants }
    10: If ConfirmDiscardChanges Then Running := False; { Quitter }
   End;
  End;
  MENU_EDIT: Begin
   Case ItemIndex of
    0: Undo;
    1: Redo;
    3: Begin { Couper }
    End;
    4: Begin { Copier }
    End;
    5: Begin { Coller }
    End;
    6: Begin { Effacer sélection }
     If SelectionActive Then Begin
      AddSnapshotToHistory(TOOL_SELECT);
      EraseSelection;
      DrawRectangle(SelectionRect.Left,SelectionRect.Top,
                    SelectionRect.Right,SelectionRect.Bottom,BackgroundColor,True);
      SelectionActive := False;
      ImageBuffer.Modified := True;
     End;
    End;
    8: Begin { Tout sélectionner }
     SelectionActive := True;
     SelectionRect.Left := CanvasX;
     SelectionRect.Top := CanvasY;
     SelectionRect.Right := CanvasX + ImageBuffer.Width - 1;
     SelectionRect.Bottom := CanvasY + ImageBuffer.Height - 1;
    End;
   End;
  End;
  MENU_VIEW: Begin
   Case ItemIndex of
    0: Begin { Barre d'outils }
     Menus[MENU_VIEW].Items[0].Checked := Not Menus[MENU_VIEW].Items[0].Checked;
    End;
    1: Begin { Barre de couleurs }
     Menus[MENU_VIEW].Items[1].Checked := Not Menus[MENU_VIEW].Items[1].Checked;
    End;
    2: Begin { Barre d'état }
     Menus[MENU_VIEW].Items[2].Checked := Not Menus[MENU_VIEW].Items[2].Checked;
    End;
    4: Begin ZZoomStep(True); End;
    5: Begin ZZoomStep(False); End;
    7: Begin { Plein écran }
    End;
   End;
  End;
  MENU_IMAGE: Begin
   Case ItemIndex of
    0: Begin { Retourner/Pivoter : choix visuel et apercu avant/apres }
     FlipRotateDialog;
    End;
    1: Begin { Etirer/Incliner : reglages visuels, filtres RVB et apercus }
     StretchSkewDialog;
    End;
    2: Begin AddSnapshotToHistory(TOOL_PENCIL); InvertColors; End;
    4: Begin { Redimensionner : dialogue visuel dedie }
     ResizeImageDialog;
    End;
    5: Begin { Rogner }
     If SelectionActive Then Begin
      AddSnapshotToHistory(TOOL_PENCIL);
      CropImage;
     End
     Else
      ShowMessage('Rogner',
                  'Selectionnez d''abord une zone avec l''outil Selection.');
    End;
    7: Begin { Attributs : statistiques, graphiques et rapport }
     ImageAttributesDialog;
    End;
    9: Begin AddSnapshotToHistory(TOOL_PENCIL); ClearImage; End;
   End;
  End;
  MENU_COLORS: Begin
   Case ItemIndex of
    0: Begin { Modifier palette }
     EditPaintPalette;
    End;
    1: Begin { Obtenir couleurs }
     ObtainPaintColors;
    End;
   End;
  End;
  MENU_TOOLS: Begin
   Case ItemIndex of
    0: RemoveBackgroundDialog;
    1: BlurBackgroundDialog;
    2: OcrDialog;
    3: VtonDialog;
   End;
  End;
  MENU_HELP: Begin
   Case ItemIndex of
    0: Begin { Aide }
    End;
    1: Begin { À propos }
      Str(VERSION_MAJOR, InfoMsg);
      Str(VERSION_MINOR, NewName);
      ShowMessage('A propos de PAINT',
            PROGRAM_NAME + #10 +
            'Version : ' + InfoMsg + '.' + NewName + #10 +
            'Auteur : Sylvain Maltais' + #10 +
            'Creation du produit : 2024' + #10 +
            'Copyright (c) 2026 Sylvain Maltais' + #10 +
            'Licence : MIT (voir LICENSE)' + #10 +
            'Contact : support@gladir.com' + #10 +
            'www.gladir.com/clonedraw');
    End;
   End;
  End;
 End;

 MenuActive := False;
 RedrawInterface;
End;

Procedure HandleToolbarClick(X, Y: Integer);
Var
 ToolIndex: Integer;
 ToolsPerRow: Integer;
 ToolX, ToolY: Integer;
Begin
 ToolsPerRow := 2;
 ToolX := (X - 5) div 23;
 ToolY := (Y - MENUBAR_HEIGHT - 5) div 23;

 If (ToolX >= 0) and (ToolX < ToolsPerRow) and (ToolY >= 0) and (ToolY < 8) Then Begin
  ToolIndex := ToolY * ToolsPerRow + ToolX;
  If (ToolIndex >= 0) and (ToolIndex <= 14) Then Begin
   If CurrentTool<>ToolIndex Then PolygonCancel;
   CurrentTool := ToolIndex;
   DrawToolbar;
  End;
 End;
End;

Procedure HandleColorClick(X, Y: Integer);
Var
 PaletteY: Integer;
 ColorBoxSize: Integer;
 ColorIndex: Integer;
 ColorX, ColorY: Integer;
Begin
 PaletteY := ScreenHeight - STATUSBAR_HEIGHT - COLORBAR_HEIGHT;
 ColorBoxSize := 16;

 { Vérifier si le clic est dans la palette }
 If (X >= 50) and (Y >= PaletteY + 5) Then Begin
  ColorX := (X - 50) div (ColorBoxSize + 2);
  ColorY := (Y - PaletteY - 5) div (ColorBoxSize + 2);

  If (ColorX >= 0) and (ColorX < 14) and (ColorY >= 0) and (ColorY < 2) Then Begin
   ColorIndex := ColorY * 14 + ColorX;
   If ColorIndex < 28 Then Begin
   ActivePaletteSlot := ColorIndex;
    If (MouseButtons and 1) <> 0 Then
     CurrentColor := StandardPalette[ColorIndex]
    Else If (MouseButtons and 2) <> 0 Then
     BackgroundColor := StandardPalette[ColorIndex];
    DrawColorPalette;
   End;
  End;
 End;
End;

Procedure HandleCanvasClick(X, Y: Integer);
Begin
 If CurrentTool=TOOL_POLYGON Then Begin PolygonClick(X,Y); Exit; End;
 If Drawing Then Exit;
 If CurrentTool In [TOOL_ERASER,TOOL_FILL,TOOL_PENCIL,TOOL_BRUSH,
                    TOOL_AIRBRUSH,TOOL_LINE,TOOL_RECT,TOOL_ELLIPSE,TOOL_ROUNDRECT] Then
  AddSnapshotToHistory(CurrentTool);
 If (CurrentTool<>TOOL_SELECT) And (CurrentTool<>TOOL_MAGNIFY) And
    (CurrentTool<>TOOL_PICKER) Then Begin EraseSelection; SelectionActive:=False; End;

 Case CurrentTool of
  TOOL_SELECT: Begin
   { Effacer les anciennes "marching ants" si presentes. }
   EraseSelection;
   SelectionActive := True;
   SelectionRect.Left := X;
   SelectionRect.Top := Y;
   SelectionRect.Right := X;
   SelectionRect.Bottom := Y;
   Drawing := True;
   StartX := X;
   StartY := Y;
   RubberValid := False;
  End;
  TOOL_ERASER: Begin
   Drawing := True;
   EraseTool(X, Y);
  End;
  TOOL_FILL: Begin
   FloodFillArea(X,Y,CurrentColor,ZImagePixel(X-CanvasX,Y-CanvasY));
  End;
  TOOL_PICKER: Begin
   ColorPicker(X, Y);
  End;
  TOOL_MAGNIFY: Begin
   ZSetZoom(ZoomLevel*2,CanvasX+ZViewX(X),CanvasY+ZViewY(Y));
  End;
  TOOL_PENCIL: Begin
   Drawing := True;
   DrawPixel(X, Y, CurrentColor);
  End;
  TOOL_BRUSH: Begin
   Drawing := True;
   DrawWithBrush(X, Y, CurrentColor);
  End;
  TOOL_AIRBRUSH: Begin
   Drawing := True;
   DrawWithAirbrush(X, Y, CurrentColor);
  End;
  TOOL_TEXT: Begin
   TextX := X;
   TextY := Y;
   TextInsertMode := True;
   TextInput := '';
   TextPrevW := 0;
   TextPrevH := 0;
   DrawTextPreview;
  End;
  TOOL_LINE, TOOL_RECT, TOOL_ELLIPSE, TOOL_ROUNDRECT, TOOL_CURVE: Begin
   Drawing := True;
   StartX := X;
   StartY := Y;
   EndX := X;
   EndY := Y;
   PreviewValid := False;
  End;
 End;
End;

Procedure HandleCanvasDrag(X, Y: Integer);
Begin
 If Not Drawing Then Exit;

 Case CurrentTool of
  TOOL_SELECT: Begin
   { Effacer le rectangle precedent (XOR) puis dessiner le nouveau. }
   If RubberValid Then
    XorRubberRect(RubberL, RubberT, RubberR, RubberB);
   SelectionRect.Right := X;
   SelectionRect.Bottom := Y;
   RubberL := SelectionRect.Left;
   RubberT := SelectionRect.Top;
   RubberR := X;
   RubberB := Y;
   XorRubberRect(RubberL, RubberT, RubberR, RubberB);
   RubberValid := True;
  End;
  TOOL_ERASER: Begin
   EraseTool(X, Y);
  End;
  TOOL_PENCIL: Begin
   DrawLine(ZEventX(OldMouseX),ZEventY(OldMouseY),X,Y,CurrentColor);
  End;
  TOOL_BRUSH: Begin
   DrawWithBrush(X, Y, CurrentColor);
  End;
  TOOL_AIRBRUSH: Begin
   DrawWithAirbrush(X, Y, CurrentColor);
  End;
  TOOL_LINE, TOOL_RECT, TOOL_ELLIPSE, TOOL_ROUNDRECT: Begin
   { Effacer l'aperçu précédent et dessiner le nouveau }
   If PreviewValid Then
    XorPreviewShape(PreviewTool, PreviewL, PreviewT, PreviewR, PreviewB);
   EndX := X;
   EndY := Y;
   PreviewTool := CurrentTool;
   PreviewL := StartX;
   PreviewT := StartY;
   PreviewR := X;
   PreviewB := Y;
   XorPreviewShape(PreviewTool, PreviewL, PreviewT, PreviewR, PreviewB);
   PreviewValid := True;
  End;
 End;
End;

Procedure HandleCanvasRelease(X, Y: Integer);
Var
 CenterX, CenterY, RadiusX, RadiusY: Integer;
Begin
 If (CurrentTool=TOOL_POLYGON) And (PolygonCount=1) Then Begin
  If Not PolygonNear(X,Y,PolygonX[0],PolygonY[0]) Then PolygonClick(X,Y);
  Exit;
 End;
 If Not Drawing Then Exit;
 Drawing := False;

 { Effacer l'apercu XOR des formes (ligne/rect/ellipse/rectarrondi). }
 If PreviewValid Then Begin
  XorPreviewShape(PreviewTool, PreviewL, PreviewT, PreviewR, PreviewB);
  PreviewValid := False;
 End;

 Case CurrentTool of
  TOOL_SELECT: Begin
   { Effacer le dernier rectangle XOR temporaire. }
   If RubberValid Then Begin
    XorRubberRect(RubberL, RubberT, RubberR, RubberB);
    RubberValid := False;
   End;
   SelectionRect.Right := X;
   SelectionRect.Bottom := Y;
   { Normaliser le rectangle de sélection }
   If SelectionRect.Left > SelectionRect.Right Then Begin
    CenterX := SelectionRect.Left;
    SelectionRect.Left := SelectionRect.Right;
    SelectionRect.Right := CenterX;
   End;
   If SelectionRect.Top > SelectionRect.Bottom Then Begin
    CenterX := SelectionRect.Top;
    SelectionRect.Top := SelectionRect.Bottom;
    SelectionRect.Bottom := CenterX;
   End;
   AntsPhase := 0;
   AntsCounter := 0;
   AntsValid := False;
   DrawSelection;
  End;
  TOOL_LINE: Begin
   DrawLine(StartX, StartY, X, Y, CurrentColor);
  End;
  TOOL_RECT: Begin
   DrawRectangle(StartX, StartY, X, Y, CurrentColor, FillStyle > 0);
  End;
  TOOL_ELLIPSE: Begin
   CenterX := (StartX + X) div 2;
   CenterY := (StartY + Y) div 2;
   RadiusX := Abs(X - StartX) div 2;
   RadiusY := Abs(Y - StartY) div 2;
   DrawEllipse(CenterX, CenterY, RadiusX, RadiusY, CurrentColor, FillStyle > 0);
  End;
  TOOL_ROUNDRECT: Begin
   DrawRoundRectShape(StartX, StartY, X, Y, 10, 10, CurrentColor, FillStyle > 0);
  End;
 End;
 If CurrentTool<>TOOL_SELECT Then RedrawInterface;
End;

{ --- Menu : hit-test et navigation (inspire de DEV-COOLS\DEVENV.PAS) --- }

Function MenuBarHitTest(MX, MY: Integer): Integer;
Var
 I, X1, X2: Integer;
Begin
 MenuBarHitTest := -1;
 If MY >= MENUBAR_HEIGHT Then Exit;
 For I := 0 to 6 do Begin
  X1 := Menus[I].X - 2;
  X2 := Menus[I].X + TextWidth(Menus[I].Title) + 2;
  If (MX >= X1) and (MX <= X2) Then Begin
   MenuBarHitTest := I;
   Exit;
  End;
 End;
End;

Function MenuItemHitTest(MX, MY, MenuIdx: Integer): Integer;
Var
 Idx, Top, Bot: Integer;
Begin
 MenuItemHitTest := -1;
 If (MenuIdx < 0) or (MenuIdx > MENU_HELP) Then Exit;
 Top := MENUBAR_HEIGHT;
 Bot := Top + Menus[MenuIdx].ItemCount * 18 + 4;
 If (MX < Menus[MenuIdx].X) or
    (MX > Menus[MenuIdx].X + Menus[MenuIdx].Width) or
    (MY < Top) or (MY > Bot) Then Exit;
 Idx := (MY - Top - 2) div 18;
 If (Idx < 0) or (Idx >= Menus[MenuIdx].ItemCount) Then Exit;
 MenuItemHitTest := Idx;
End;

Procedure MenuNextItem(Step: Integer);
{ Step = +1 (suivant) ou -1 (precedent), saute les separateurs. }
Var
 N, I: Integer;
Begin
 If (ActiveMenu < 0) or (ActiveMenu > 6) Then Exit;
 N := Menus[ActiveMenu].ItemCount;
 If N <= 0 Then Exit;
 If ActiveMenuItem < 0 Then Begin
  If Step > 0 Then ActiveMenuItem := -1
  Else ActiveMenuItem := N;
 End;
 For I := 1 to N do Begin
  ActiveMenuItem := ActiveMenuItem + Step;
  If ActiveMenuItem < 0 Then ActiveMenuItem := N - 1;
  If ActiveMenuItem >= N Then ActiveMenuItem := 0;
  If Not Menus[ActiveMenu].Items[ActiveMenuItem].Separator Then Exit;
 End;
End;

Procedure MenuSwitch(NewMenu: Integer);
Begin
 If (NewMenu < 0) or (NewMenu > 6) then Exit;
 ActiveMenu := NewMenu;
 ActiveMenuItem := -1;
 RedrawInterface;
End;

Procedure HandleMouseEvent;
Var
 NewButtons: Integer;
 ButtonPressed: Boolean;
 BarHit, ItemHit: Integer;
Begin
 GetMouseStateLocal(MouseX, MouseY, MouseButtons);
 If MouseButtons<>0 Then ResetToolTip;
 UpdateToolTip;

 { Detection de front montant du bouton gauche (evite la repetition
   d'action tant que l'utilisateur maintient le bouton enfonce). }
 ButtonPressed := ((MouseButtons and 1) <> 0) and ((OldMouseButtons and 1) = 0);

 { Survol : si un menu est ouvert, suivre la souris pour changer de menu
   ou mettre en evidence l'element sous le pointeur. }
 If MenuActive and ((MouseX <> OldMouseX) or (MouseY <> OldMouseY)) Then Begin
  BarHit := MenuBarHitTest(MouseX, MouseY);
  If (BarHit >= 0) and (BarHit <> ActiveMenu) Then Begin
   MenuSwitch(BarHit);
  End Else Begin
   ItemHit := MenuItemHitTest(MouseX, MouseY, ActiveMenu);
   If ItemHit <> ActiveMenuItem Then Begin
    ActiveMenuItem := ItemHit;
    DrawMenu(ActiveMenu);
   End;
  End;
 End;

 If (PolygonCount>0) And ((MouseButtons And 2)<>0) And ((OldMouseButtons And 2)=0) Then
  PolygonFinish;
 If ButtonPressed Then Begin
  If MenuBarHitTest(MouseX,MouseY)>=0 Then PolygonCancel;
  BarHit := MenuBarHitTest(MouseX, MouseY);
  If BarHit >= 0 Then Begin
   { Clic sur la barre de menu : ouvrir/basculer/fermer }
   If MenuActive and (ActiveMenu = BarHit) Then Begin
    MenuActive := False;
    RedrawInterface;
   End Else Begin
    MenuActive := True;
    ActiveMenu := BarHit;
    ActiveMenuItem := -1;
    RedrawInterface;
   End;
  End
  Else If MenuActive Then Begin
   { Clic dans un menu deroulant ouvert }
   ItemHit := MenuItemHitTest(MouseX, MouseY, ActiveMenu);
   If ItemHit >= 0 Then Begin
    If Not Menus[ActiveMenu].Items[ItemHit].Separator Then Begin
     ActiveMenuItem := ItemHit;
     HandleMenuClick(ActiveMenu, ItemHit);
     MenuActive := False;
     RedrawInterface;
    End;
   End Else Begin
    { Clic ailleurs : fermer le menu }
    MenuActive := False;
    RedrawInterface;
   End;
  End
  Else If (MouseX < TOOLBAR_WIDTH) and (MouseY > MENUBAR_HEIGHT) and
          (MouseY < ScreenHeight - STATUSBAR_HEIGHT - COLORBAR_HEIGHT) Then Begin
   HandleToolbarClick(MouseX, MouseY);
  End
  Else If (MouseY >= ScreenHeight - STATUSBAR_HEIGHT - COLORBAR_HEIGHT) and
          (MouseY < ScreenHeight - STATUSBAR_HEIGHT) Then Begin
   HandleColorClick(MouseX, MouseY);
  End
  Else If (MouseX >= CanvasX) and (MouseX < CanvasX + CanvasWidth) and
          (MouseY >= CanvasY) and (MouseY < CanvasY + CanvasHeight) Then Begin
   If ZHitCanvas(MouseX,MouseY) Then HandleCanvasClick(ZEventX(MouseX),ZEventY(MouseY));
  End;
 End
 Else If ((MouseButtons and 1) <> 0) and Drawing Then Begin
  { Bouton maintenu : continuer le trace sur le canvas }
  If (MouseX >= CanvasX) and (MouseX < CanvasX + CanvasWidth) and
     (MouseY >= CanvasY) and (MouseY < CanvasY + CanvasHeight) Then
   HandleCanvasDrag(ZEventX(MouseX),ZEventY(MouseY));
 End
 Else If ((MouseButtons and 1) = 0) and ((OldMouseButtons and 1) <> 0) Then Begin
  { Bouton relache (front descendant) }
  If Drawing Then
   HandleCanvasRelease(ZEventX(Min(CanvasX+ZDisplayWidth-1,Max(CanvasX,MouseX))),
                       ZEventY(Min(CanvasY+ZDisplayHeight-1,Max(CanvasY,MouseY))));
 End;

 { Apercu du prochain segment, meme sans bouton enfonce. }
 If (PolygonCount>0) And ((MouseX<>OldMouseX) Or (MouseY<>OldMouseY)) Then Begin
  HideMouse; ErasePolygonPreview;
  PolygonHover:=ZHitCanvas(MouseX,MouseY);
  If PolygonHover Then Begin PolygonMouseX:=ZEventX(MouseX); PolygonMouseY:=ZEventY(MouseY); End;
  PolygonPreview; ShowMouse;
 End;
 { Mise a jour de la barre d'etat si la souris a bouge }
 If (MouseX <> OldMouseX) or (MouseY <> OldMouseY) Then Begin
  DrawStatusBar;
  OldMouseX := MouseX;
  OldMouseY := MouseY;
 End;
 OldMouseButtons := MouseButtons;
End;

Procedure HandleKeyboardEvent;
Var
 Key: Char;
 ExtKey: Char;
Begin
 If Not KeyPressed Then Exit;
 ResetToolTip;

 Key := ReadKey;
 If PolygonCount>0 Then Begin
  Case Key Of
   #13: Begin PolygonFinish; Exit; End;
   #27,#26: Begin PolygonCancel; Exit; End;
   #8: Begin
    Dec(PolygonCount); RedrawInterface; Exit;
   End;
  End;
 End;

 { Touche étendue }
 If Key = #0 Then Begin
  ExtKey := ReadKey;
  { Navigation clavier dans un menu ouvert (inspire de DEVENV.PAS) }
  If MenuActive Then Begin
   Case ExtKey of
    #72: Begin { Fleche haut : item precedent }
     MenuNextItem(-1);
     RedrawInterface;
     Exit;
    End;
    #80: Begin { Fleche bas : item suivant }
     MenuNextItem(+1);
     RedrawInterface;
     Exit;
    End;
    #75: Begin { Fleche gauche : menu precedent }
     MenuSwitch((ActiveMenu + 6) mod 7);
     Exit;
    End;
    #77: Begin { Fleche droite : menu suivant }
     MenuSwitch((ActiveMenu + 1) mod 7);
     Exit;
    End;
   End;
  End;
  Case ExtKey of
   #59: Begin { F1 - Aide }
   End;
   #60: Begin { F2 }
   End;
   #68: If ConfirmDiscardChanges Then Running := False; { F10 - Quitter }
   #107: If ConfirmDiscardChanges Then Running := False; { Alt+F4 - Quitter }
   #33: Begin { Alt+F - Menu Fichier }
    MenuActive := True;
    ActiveMenu := MENU_FILE;
    ActiveMenuItem := -1;
    RedrawInterface;
   End;
   #50: Begin { Alt+M - Menu Modifier }
    MenuActive := True;
    ActiveMenu := MENU_EDIT;
    ActiveMenuItem := -1;
    RedrawInterface;
   End;
   #30: Begin { Alt+A - Menu Affichage }
    MenuActive := True;
    ActiveMenu := MENU_VIEW;
    ActiveMenuItem := -1;
    RedrawInterface;
   End;
   #23: Begin { Alt+I - Menu Image }
    MenuActive := True;
    ActiveMenu := MENU_IMAGE;
    ActiveMenuItem := -1;
    RedrawInterface;
   End;
   #46: Begin { Alt+C - Menu Couleurs }
    MenuActive := True;
    ActiveMenu := MENU_COLORS;
    ActiveMenuItem := -1;
    RedrawInterface;
   End;
   #24: Begin { Alt+O - Menu Outils }
    MenuActive := True;
    ActiveMenu := MENU_TOOLS;
    ActiveMenuItem := -1;
    RedrawInterface;
   End;
   #53: Begin { Alt+? (touche /) - Menu Aide }
    MenuActive := True;
    ActiveMenu := MENU_HELP;
    ActiveMenuItem := -1;
    RedrawInterface;
   End;
   #75: ZPan(-Max(1,CanvasWidth*100 Div ZoomLevel Div 8),0);
   #77: ZPan(Max(1,CanvasWidth*100 Div ZoomLevel Div 8),0);
   #73: ZPan(0,-Max(1,CanvasHeight*100 Div ZoomLevel Div 2));
   #81: ZPan(0,Max(1,CanvasHeight*100 Div ZoomLevel Div 2));
   #71: ZPan(-ZOriginX,-ZOriginY);
   #72: Begin { Fleche haut : deplacement de la vue agrandie }
    If ZoomLevel<>100 Then Begin ZPan(0,-Max(1,CanvasHeight*100 Div ZoomLevel Div 8)); Exit; End;
    If BrushSize < 50 Then Inc(BrushSize);
    DrawToolbar;
   End;
   #80: Begin { Fleche bas : deplacement de la vue agrandie }
    If ZoomLevel<>100 Then Begin ZPan(0,Max(1,CanvasHeight*100 Div ZoomLevel Div 8)); Exit; End;
    If BrushSize > 1 Then Dec(BrushSize);
    DrawToolbar;
   End;
  End;
 End
 Else Begin
  { Validation au clavier d'un item de menu ouvert }
  If MenuActive and (Key = #13) Then Begin
   If (ActiveMenuItem >= 0) and
      (ActiveMenuItem < Menus[ActiveMenu].ItemCount) and
      (Not Menus[ActiveMenu].Items[ActiveMenuItem].Separator) Then Begin
    HandleMenuClick(ActiveMenu, ActiveMenuItem);
    MenuActive := False;
    RedrawInterface;
   End;
   Exit;
  End;
  { Raccourcis Ctrl+lettre (codes ASCII 1..26) }
  If Not TextInsertMode Then Begin
   Case Key of
    #15: Begin HandleMenuClick(MENU_FILE,1); Exit; End; { Ctrl+O }
    #19: Begin HandleMenuClick(MENU_FILE,2); Exit; End; { Ctrl+S }
    #23: Begin HandleMenuClick(MENU_IMAGE,4); Exit; End; { Ctrl+W }
    #26: Begin Undo; Exit; End;          { Ctrl+Z }
    #25: Begin Redo; Exit; End;          { Ctrl+Y }
   End;
  End;
  { Mode saisie de texte }
  If TextInsertMode Then Begin
   If Key = #13 Then Begin { Entrée }
    ErasePreviewText;
    AddSnapshotToHistory(TOOL_TEXT);
    DrawText(TextX, TextY, TextInput, CurrentColor);
    TextInsertMode := False;
    TextInput := '';
    RedrawInterface;
   End
   Else If Key = #27 Then Begin { Échap }
    ErasePreviewText;
    TextInsertMode := False;
    TextInput := '';
   End
   Else If Key = #8 Then Begin { Retour arrière }
    If Length(TextInput) > 0 Then
     Delete(TextInput, Length(TextInput), 1);
    DrawTextPreview;
   End
   Else Begin
    TextInput := TextInput + Key;
    DrawTextPreview;
   End;
  End
  Else Begin
   { Raccourcis clavier - implémentation simplifiée }
   Case UpCase(Key) of
    '+': ZZoomStep(True);
    '-': ZZoomStep(False);
    'Q': If ConfirmDiscardChanges Then Running := False; { Quitter rapidement }
    #27: Begin { Échap }
     If MenuActive Then Begin
      MenuActive := False;
      RedrawInterface;
     End
     Else If SelectionActive Then Begin
      SelectionActive := False;
      RedrawInterface;
     End;
    End;
   End;
  End;
 End;
End;

{ Procédure principale }

Procedure Initialize;
Begin
 { Initialiser le générateur de nombres aléatoires }
 Randomize;

 { Initialiser les graphiques }
 InitGraphics;

 { Initialiser la souris }
 {$IFDEF FPC}
 InitMouse;
 {$ELSE}
 InitMouse;
 {$ENDIF}

 { Initialiser les composants de l'application }
 InitPalette;
 InitMenus;
 InitImage;
 PEInstallDocumentPalette;
 InitTools;
 InitHistory;

 { Variables d'état }
 Running := True;
 PolygonCount:=0; PolygonHover:=False;
 ToolTipVisible:=False; ToolTipCandidate:=-1;
 MenuActive := False;
 ActiveMenu := -1;
 ActiveMenuItem := -1;
 SelectionActive := False;
 Drawing := False;
 TextInsertMode := False;
 { Allouer un buffer de canvas blanc par defaut. Sans ce buffer,
   SyncCanvasImage est un no-op et chaque RedrawInterface (declenche
   par AddToHistory apres un trace ligne/rect/ellipse/etc.) efface
   le dessin de l'ecran (page blanche apparente). }
 CanvasImageW := ImageBuffer.Width;
 CanvasImageH := ImageBuffer.Height;
 GetMem(CanvasImage, LongInt(CanvasImageW) * LongInt(CanvasImageH));
 FillChar(CanvasImage^, LongInt(CanvasImageW) * LongInt(CanvasImageH), White);
 RubberValid := False;
 AntsPhase := 0;
 AntsCounter := 0;
 AntsValid := False;
 PreviewValid := False;

 { Dessiner l'interface }
 RedrawInterface;

 { Afficher la souris }
 {$IFDEF FPC}
 ShowMouse;
 {$ELSE}
 ShowMouse;
 {$ENDIF}
End;

Procedure Cleanup;
Var
 Tmp: PHistoryItem;
Begin
 { Masquer la souris }
 {$IFDEF FPC}
 HideMouse;
 {$ELSE}
 HideMouse;
 {$ENDIF}

 { Libérer le buffer de pixels du canvas }
 If CanvasImage <> Nil Then Begin
  FreeMem(CanvasImage, CanvasImageW * CanvasImageH);
  CanvasImage := Nil;
 End;

 { Libérer l'historique avec les données }
 While UndoList <> Nil do Begin
  Tmp := UndoList;
  UndoList := UndoList^.Next;
  FreeHistoryData(PHistoryData(Tmp^.Data));
  Dispose(Tmp);
 End;

 While RedoList <> Nil do Begin
  Tmp := RedoList;
  RedoList := RedoList^.Next;
  FreeHistoryData(PHistoryData(Tmp^.Data));
  Dispose(Tmp);
 End;

 { Fermer le mode graphique }
 CloseGraph;
End;

Procedure MainLoop;
Begin
 While Running do Begin
  HandleMouseEvent;
  HandleKeyboardEvent;
  { Animation "marching ants" : ~1 seconde par phase (Delay(10) x 100). }
  If SelectionActive And (Not Drawing) And (Not MenuActive) And (Not ToolTipVisible) Then Begin
   Inc(AntsCounter);
   If AntsCounter >= 100 Then Begin
    AntsCounter := 0;
    ToggleAnts;
   End;
  End;
  Delay(10);
 End;
End;

Var
 ArgI: Integer;
 FileArg: String;

{ Point d'entrée du programme }
BEGIN
 {$IFDEF FPC}
  {$IFDEF WINDOWS}
   SetUseACP(False);
  {$ENDIF}
 {$ENDIF}
 { Initialiser la langue }
 Language:=_French;
 TmpLanguage:=GetEnv('LANGUAGE');
 If TmpLanguage<>''Then Begin
  If TmpLanguage[1]='"'Then TmpLanguage:=Copy(TmpLanguage,2,255);
  If StrToUpper(Copy(TmpLanguage,1,2))='EN'Then Language:=_English Else
  If StrToUpper(Copy(TmpLanguage,1,2))='GR'Then Language:=_Germany Else
  If StrToUpper(Copy(TmpLanguage,1,2))='IT'Then Language:=_Italian Else
  If StrToUpper(Copy(TmpLanguage,1,2))='SP'Then Language:=_Spain Else
  If(StrToUpper(Copy(TmpLanguage,1,2))='SQ')or
    (StrToUpper(Copy(TmpLanguage,1,3))='ALB')Then Language:=_Albanian Else
  If(StrToUpper(Copy(TmpLanguage,1,2))='PT')or
    (StrToUpper(Copy(TmpLanguage,1,3))='PRT')Then Language:=_Portuguese Else
  If(StrToUpper(Copy(TmpLanguage,1,2))='SE')or
    (StrToUpper(Copy(TmpLanguage,1,3))='SWE')Then Language:=_Swedish Else
  If(StrToUpper(Copy(TmpLanguage,1,2))='DK')or
    (StrToUpper(Copy(TmpLanguage,1,3))='DNK')Then Language:=_Danish Else
  If(StrToUpper(Copy(TmpLanguage,1,2))='JP')or
    (StrToUpper(Copy(TmpLanguage,1,3))='JPN')Then Language:=_Japanese;
 End;
 MaxScreen := False;
 FileArg := '';
 For ArgI := 1 To ParamCount Do Begin
  If (StrToUpper(ParamStr(ArgI)) = '-MAXSCREEN') Or (StrToUpper(ParamStr(ArgI)) = '/MAXSCREEN') Then
   MaxScreen := True
  Else If (FileArg = '') And (Copy(ParamStr(ArgI),1,1) <> '-') And (Copy(ParamStr(ArgI),1,1) <> '/') Then
   FileArg := ParamStr(ArgI);
 End;
 If (ParamStr(1) = '/?') or (ParamStr(1) = '--help') or (ParamStr(1) = '-h') Then Begin
  WriteLn('PAINT: Cette commande permet de laner le programme de dessin Bitamp (Paint).');
  WriteLn;
  WriteLn('Syntaxe: PAINT [-maxscreen] [fichier.bmp|gif|png|jpg|xbm|wpg|lbm|hdr|fax|exr|' +
  'dng|bgx|dds|dcm|apng|arw|cr2|ppm|dib|cur|pcx|msp|tif|mac|pas]');
  WriteLn;
  WriteLn('Options:');
  WriteLn('  -maxscreen           Utilise la resolution maximale disponible.');
  WriteLn;
  WriteLn('Fonctionnalit'+#130+'s:');
  WriteLn(' - Interface graphique compl'+#138+'te avec menus et barre d''outils');
  WriteLn(' - Support de la souris (Int 33h / PtcMouse)');
  WriteLn(' - Outils de dessin: Crayon, Pinceau, A'+#130+'rographe, Ligne, Rectangle, Ellipse...');
  WriteLn(' - Formats: BMP, GIF, PNG, JPEG, XBM, WPG, LBM (ILBM/PBM), HDR (' +
  'RGBE), FAX (G3 1D), EXR, DNG, BGX, DDS, DCM, APNG, ARW, CR2, PPM');
  WriteLn(' - Support de la transparence pour GIF et PNG');
  WriteLn(' - Redimensionnement et rognage d''image');
  WriteLn(' - Support de 2 a 32 bits de profondeur de couleur');
  WriteLn(' - Historique Annuler/Retablir');
  WriteLn;
  WriteLn('Raccourcis clavier:');
  WriteLn(' Ctrl+N  Nouveau fichier');
  WriteLn(' Ctrl+O  Ouvrir fichier');
  WriteLn(' Ctrl+S  Enregistrer');
  WriteLn(' Ctrl+Z  Annuler');
  WriteLn(' Ctrl+Y  Retablir');
  WriteLn(' Ctrl+A  Tout selectionner');
  WriteLn(' +/-     Zoom avant/arriere');
  WriteLn(' Echap   Annuler operation en cours');
  WriteLn(' F10     Quitter');
 End
 Else Begin
  Initialize;

  { Charger un fichier si spécifié en ligne de commande }
  If FileArg <> '' Then Begin
   { L'interface est déjà dessinée par Initialize ; LoadImage trace les pixels
     dans le canvas. Ne PAS rappeler RedrawInterface ici, sinon les pixels
     du BMP/GIF/etc. sont effacés avant même d'être visibles. }
   If LoadImage(FileArg) Then
    DrawStatusBar
   Else
    ShowMessage('Erreur de chargement',
                'Impossible de charger : ' + FileArg);
  End;

  MainLoop;
  Cleanup;
 End;
END.
