{ ---- Graph : primitives sur l image 8 bits ---- }

{ point absolu (coordonnees ecran), ecrete par l ecran et la fenetre
  de vue ; Mode : CopyPut ou XORPut }
Procedure PdwPlot(X, Y, C, Mode: LongInt);
Var P: PByte;
Begin
 If (X < 0) Or (Y < 0) Or (X >= PdwW) Or (Y >= PdwH) Then Exit;
 If PdwVP.Clip Then
  If (X < PdwVP.X1) Or (X > PdwVP.X2) Or (Y < PdwVP.Y1) Or
     (Y > PdwVP.Y2) Then Exit;
 P := PdwBits + (Y * PdwW + X);
 If Mode = XORPut Then P^ := P^ Xor Byte(C)
 Else P^ := Byte(C);
 PdwMark(X, Y, X, Y);
End;

{ ligne horizontale pleine (coordonnees ecran) }
Procedure PdwHLine(X1, X2, Y, C: LongInt);
Var T: LongInt;
Begin
 If X1 > X2 Then Begin T := X1; X1 := X2; X2 := T End;
 If (Y < 0) Or (Y >= PdwH) Then Exit;
 If PdwVP.Clip Then
 Begin
  If (Y < PdwVP.Y1) Or (Y > PdwVP.Y2) Then Exit;
  If X1 < PdwVP.X1 Then X1 := PdwVP.X1;
  If X2 > PdwVP.X2 Then X2 := PdwVP.X2;
 End;
 If X1 < 0 Then X1 := 0;
 If X2 >= PdwW Then X2 := PdwW - 1;
 If X1 > X2 Then Exit;
 FillChar((PdwBits + (Y * PdwW + X1))^, X2 - X1 + 1, Byte(C));
 PdwMark(X1, Y, X2, Y);
End;

Procedure PutPixel(X, Y: Integer; Color: Word);
Begin
