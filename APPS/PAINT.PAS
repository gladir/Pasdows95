{ repertoire ou sont ranges les modeles telecharges }
Function VtCacheDir:AnsiString;
Var
 D:AnsiString;
Begin
 D:=GetEnv('VTON_CACHE');
 If D='' Then Begin
  {$IFDEF WINDOWS}
  D:=GetEnv('LOCALAPPDATA');
  If D='' Then D:='.';
  D:=D+'\vton';
  {$ELSE}
  D:=GetEnv('XDG_CACHE_HOME');
  If D='' Then Begin
   D:=VtHomeDir;
   If D='' Then D:='.';
   D:=D+'/.cache';
  End;
  D:=D+'/vton';
  {$ENDIF}
 End;
 While(Length(D)>1)and(D[Length(D)]in['/','\'])do Delete(D,Length(D),1);
 Result:=D;
End;

