Procedure OcSelectFont(OcFontNo: Integer);
Var
  OcI: Integer;
Begin
  OcCurrentFont := OcFontNo;
  Case OcFontNo Of
    OcFontSegoe:
    Begin
      OcFontWidth := OcPRowBuffer(@OcSegoeWidth);
      OcFontHeight := OcPRowBuffer(@OcSegoeHeight);
      OcFontLeft := OcPShortArray(@OcSegoeLeft);
      OcFontTop := OcPShortArray(@OcSegoeTop);
      OcFontAdvance := OcPWordArray(@OcSegoeAdvance);
      OcFontBits := OcPWordArray(@OcSegoeBits);
      OcFontSpace := OcSegoeSpace;
    End;
    OcFontArial:
    Begin
      OcFontWidth := OcPRowBuffer(@OcArialWidth);
      OcFontHeight := OcPRowBuffer(@OcArialHeight);
      OcFontLeft := OcPShortArray(@OcArialLeft);
      OcFontTop := OcPShortArray(@OcArialTop);
      OcFontAdvance := OcPWordArray(@OcArialAdvance);
      OcFontBits := OcPWordArray(@OcArialBits);
      OcFontSpace := OcArialSpace;
    End;
    OcFontConsolas:
    Begin
      OcFontWidth := OcPRowBuffer(@OcConsolasWidth);
      OcFontHeight := OcPRowBuffer(@OcConsolasHeight);
      OcFontLeft := OcPShortArray(@OcConsolasLeft);
      OcFontTop := OcPShortArray(@OcConsolasTop);
      OcFontAdvance := OcPWordArray(@OcConsolasAdvance);
      OcFontBits := OcPWordArray(@OcConsolasBits);
      OcFontSpace := OcConsolasSpace;
    End;
  Else
    OcFontWidth := OcPRowBuffer(@OcYuGothicWidth);
    OcFontHeight := OcPRowBuffer(@OcYuGothicHeight);
    OcFontLeft := OcPShortArray(@OcYuGothicLeft);
    OcFontTop := OcPShortArray(@OcYuGothicTop);
    OcFontAdvance := OcPWordArray(@OcYuGothicAdvance);
    OcFontBits := OcPWordArray(@OcYuGothicBits);
    OcFontSpace := OcYuGothicSpace;
  End;
  OcFontOffset[0] := 0;
  For OcI := 0 To OcGlyphCount - 1 Do
    OcFontOffset[OcI + 1] := OcFontOffset[OcI] +
      (OcFontWidth^[OcI] * OcFontHeight^[OcI] + 7) Div 8;
  OcExactOffset[0] := 0;
  For OcI := 0 To OcGlyphCount * 4 - 1 Do
    OcExactOffset[OcI + 1] := OcExactOffset[OcI] + OcExactWidth[OcI] * OcExactHeight[OcI];
  OcKanaOffset[0] := 0;
  For OcI := 0 To OcKanaCount - 1 Do
    OcKanaOffset[OcI + 1] := OcKanaOffset[OcI] + (OcKanaWidth[OcI] * OcKanaHeight[OcI] + 7) Div 8;
End;

{ Acces uniforme aux caracteres latins (par police) puis aux kana (communs). }
Function OcGlyphCodeOf(OcG: Integer): Integer;
Begin
  If OcG < OcGlyphCount Then OcGlyphCodeOf := OcGlyphCode[OcG] Else OcGlyphCodeOf := OcKanaCode[OcG - OcGlyphCount];
End;

Function OcGlyphWidthOf(OcG: Integer): Integer;
Begin
  If OcG < OcGlyphCount Then OcGlyphWidthOf := OcFontWidth^[OcG] Else OcGlyphWidthOf := OcKanaWidth[OcG - OcGlyphCount];
End;

Function OcGlyphHeightOf(OcG: Integer): Integer;
Begin
  If OcG < OcGlyphCount Then OcGlyphHeightOf := OcFontHeight^[OcG] Else OcGlyphHeightOf := OcKanaHeight[OcG - OcGlyphCount];
End;

Function OcGlyphLeftOf(OcG: Integer): Integer;
Begin
  If OcG < OcGlyphCount Then OcGlyphLeftOf := OcFontLeft^[OcG] Else OcGlyphLeftOf := OcKanaLeft[OcG - OcGlyphCount];
End;

Function OcGlyphTopOf(OcG: Integer): Integer;
Begin
  If OcG < OcGlyphCount Then OcGlyphTopOf := OcFontTop^[OcG] Else OcGlyphTopOf := OcKanaTop[OcG - OcGlyphCount];
End;

Function OcGlyphAdvanceOf(OcG: Integer): Integer;
Begin
  If OcG < OcGlyphCount Then OcGlyphAdvanceOf := OcFontAdvance^[OcG] Else OcGlyphAdvanceOf := 1024;
End;

Function OcMasterBit(Glyph, OcIndex: Integer): Integer;
Var
  OcBytePosition: Longint;
  OcValue: Word;
Begin
  If Glyph >= OcGlyphCount Then
  Begin
    OcBytePosition := OcKanaOffset[Glyph - OcGlyphCount] + (OcIndex Shr 3);
    OcValue := OcKanaBits[OcBytePosition Shr 1];
  End
  Else
  Begin
    OcBytePosition := OcFontOffset[Glyph] + (OcIndex Shr 3);
    OcValue := OcFontBits^[OcBytePosition Shr 1];
  End;
  If (OcBytePosition And 1) <> 0 Then OcValue := OcValue Shr 8;
  OcMasterBit := (OcValue Shr (7 - (OcIndex And 7))) And 1;
End;

Procedure OcFreeTemplates;
Var
  OcI: Integer;
Begin
  For OcI := 0 To OcTemplateCount - 1 Do
  Begin
    If OcTemplates[OcI].OcPixels <> Nil Then
      FreeMem(OcTemplates[OcI].OcPixels, OcTemplates[OcI].PixelSize);
    OcTemplates[OcI].OcPixels := Nil;
    OcTemplates[OcI].OcWidth := 0;
    OcTemplates[OcI].OcHeight := 0;
  End;
End;

{ Une lettre accentuee n'existe que dans les langues qui l'utilisent. }
Function OcLanguageAllows(Glyph: Integer): Boolean;
Begin
  If Glyph >= OcGlyphCount Then
    OcLanguageAllows := (OcLanguageMask And OcLangJapanese) <> 0
  Else
    OcLanguageAllows := (OcGlyphLanguage[Glyph] And OcLanguageMask) <> 0;
End;

Procedure OcAssignExtra(OcIndex, OcG, OcFontNo: Integer);
Begin
  { Un trait vertical (i, l, I, !, |, 1) ne se chevauche jamais : ce serait un doublon. }
  OcTemplates[OcIndex].Stem := OcGlyphCodeOf(OcG) In [33, 49, 73, 105, 108, 124];
  OcTemplates[OcIndex].Root := Sqrt(OcTemplates[OcIndex].Squares);
  { Caracteres rares dans le texte courant : on les prefere moins. }
  Case OcGlyphCodeOf(OcG) Of
    33, 93, 124: OcTemplates[OcIndex].Extra := OcRarePenalty;
    91: OcTemplates[OcIndex].Extra := OcRarePenalty Div 2;
    49:
      If OcFontNo = OcFontSegoe Then
        OcTemplates[OcIndex].Extra := OcRarePenalty
      Else
        OcTemplates[OcIndex].Extra := 0;
    128..2047: OcTemplates[OcIndex].Extra := OcAccentPenalty;
    12288..12543: OcTemplates[OcIndex].Extra := OcKanaPenalty;
  Else
    OcTemplates[OcIndex].Extra := 0;
  End;
End;

{ Gabarits exacts de Segoe UI 13,33 px (caracteres latins). }
Procedure OcLoadExactTemplates(OcG: Integer);
Var
  OcPhase, OcIndex, OcJ, OcValue: Integer;
  OcPosition, OcStart: Longint;
Begin
  For OcPhase := 0 To 3 Do
  Begin
    OcIndex := OcG * 4 + OcPhase;
    If OcCoarseScoring And ((OcPhase And 1) <> 0) Then Continue;
    OcStart := OcExactOffset[OcIndex];
    OcTemplates[OcIndex].OcWidth := OcExactWidth[OcIndex];
    OcTemplates[OcIndex].OcHeight := OcExactHeight[OcIndex];
    OcTemplates[OcIndex].Top := OcExactTop[OcIndex];
    OcTemplates[OcIndex].Pen := OcExactPen[OcIndex];
    OcTemplates[OcIndex].Advance := (Longint(OcGlyphAdvanceOf(OcG)) * OcExactEm * 4 + 51200) Div 102400;
    OcTemplates[OcIndex].PixelSize := OcTemplates[OcIndex].OcWidth * OcTemplates[OcIndex].OcHeight;
    GetMem(OcTemplates[OcIndex].OcPixels, OcTemplates[OcIndex].PixelSize);
    OcTemplates[OcIndex].Squares := 0;
    For OcJ := 0 To OcTemplates[OcIndex].PixelSize - 1 Do
    Begin
      OcPosition := OcStart + OcJ;
      OcValue := (OcExactData[OcPosition Shr 2] Shr ((OcPosition And 3) * 4)) And 15;
      OcTemplates[OcIndex].OcPixels^[OcJ] := OcValue;
      Inc(OcTemplates[OcIndex].Squares, OcValue * OcValue);
    End;
    OcAssignExtra(OcIndex, OcG, OcFontSegoe);
  End;
End;

Function OcClampTo(OcValue, OcLow, OcHigh: Integer): Integer;
Begin
  If OcValue < OcLow Then OcValue := OcLow;
  If OcValue > OcHigh Then OcValue := OcHigh;
  OcClampTo := OcValue;
End;

{ Derive les gabarits (4 positions de sous-pixel) de la police maitre,
  a la taille Em100 / 100 pixels d'em : couverture de chaque pixel cible
  par l'image maitre, sur 16 niveaux. }
Procedure OcBuildTemplates(OcFontNo, Em100, Glyphs: Integer);
Var
  OcG, OcPhase, OcI, OcJ, OcI0, OcI1, OcJ0, OcJ1, OcRows, OcCols, OcMW, OcMH, OcXL, OcYT: Integer;
  OcA0, OcA1, OcB0, OcB1, OcCA0, OcCA1, OcCB0, OcCB1, OcTotal, OcValue, OcIndex: Integer;
  OcMinR, OcMaxR, OcMinC, OcMaxC, OcR, OcC, OcPosition: Integer;
  OcScale, OcShift: Real;
Begin
  OcFreeTemplates;
  OcSelectFont(OcFontNo);
  OcScale := Em100 / 100 / OcMasterEm;
  FillChar(OcSat, SizeOf(OcSat), 0);
  For OcG := 0 To Glyphs - 1 Do
  Begin
    { Les lettres accentuees n'existent que dans les langues demandees. }
    If (OcG >= OcUnaccentedCount) And (Not OcLanguageAllows(OcG)) Then Continue;
    If OcCoarseScoring And ((OcLanguageMask And OcLangJapanese) = 0) Then
      If Not (((OcGlyphCodeOf(OcG) >= Ord('a')) And (OcGlyphCodeOf(OcG) <= Ord('z'))) Or
              ((OcGlyphCodeOf(OcG) >= Ord('0')) And (OcGlyphCodeOf(OcG) <= Ord('9')))) Then Continue;
    If OcUseExact And (OcFontNo = OcFontSegoe) And (Em100 = OcExactEm) And (OcG < OcGlyphCount) Then
    Begin
      OcLoadExactTemplates(OcG);
      Continue;
    End;
    OcMW := OcGlyphWidthOf(OcG);
    OcMH := OcGlyphHeightOf(OcG);
    OcXL := OcGlyphLeftOf(OcG);
    OcYT := OcGlyphTopOf(OcG);
    For OcR := 0 To OcMH - 1 Do
      For OcC := 0 To OcMW - 1 Do
        OcSat[OcR + 1, OcC + 1] := OcSat[OcR, OcC + 1] + OcSat[OcR + 1, OcC] - OcSat[OcR, OcC] +
                             OcMasterBit(OcG, OcR * OcMW + OcC);

    For OcPhase := 0 To 3 Do
    Begin
      OcIndex := OcG * 4 + OcPhase;
      { Les kana sont larges : deux positions de sous-pixel suffisent. }
      If ((OcG >= OcGlyphCount) Or OcCoarseScoring) And ((OcPhase And 1) <> 0) Then Continue;
      OcShift := OcPhase / 4;
      OcI0 := OcFloorInt(OcShift + OcXL * OcScale) - 1;
      OcI1 := OcCeilInt(OcShift + (OcXL + OcMW) * OcScale) + 1;
      OcJ0 := OcFloorInt(-OcYT * OcScale) - 1;
      OcJ1 := OcCeilInt((OcMH - OcYT) * OcScale) + 1;
      OcRows := OcJ1 - OcJ0;
      OcCols := OcI1 - OcI0;
      If OcRows * OcCols > SizeOf(OcScratch) Then
      Begin
        
        OcrFailed := True; Exit;
      End;
      For OcJ := 0 To OcRows - 1 Do
      Begin
        OcA0 := Round((OcJ0 + OcJ) / OcScale + OcYT);
        OcA1 := Round((OcJ0 + OcJ + 1) / OcScale + OcYT);
        If OcA1 <= OcA0 Then OcA1 := OcA0 + 1;
        OcCA0 := OcClampTo(OcA0, 0, OcMH);
        OcCA1 := OcClampTo(OcA1, 0, OcMH);
        For OcI := 0 To OcCols - 1 Do
        Begin
          OcB0 := Round((OcI0 + OcI - OcShift) / OcScale - OcXL);
          OcB1 := Round((OcI0 + OcI + 1 - OcShift) / OcScale - OcXL);
          If OcB1 <= OcB0 Then OcB1 := OcB0 + 1;
          OcCB0 := OcClampTo(OcB0, 0, OcMW);
          OcCB1 := OcClampTo(OcB1, 0, OcMW);
          OcValue := 0;
          If (OcCA1 > OcCA0) And (OcCB1 > OcCB0) Then
          Begin
            OcTotal := OcSat[OcCA1, OcCB1] - OcSat[OcCA0, OcCB1] - OcSat[OcCA1, OcCB0] + OcSat[OcCA0, OcCB0];
            OcValue := Round(15 * OcTotal / ((OcA1 - OcA0) * (OcB1 - OcB0)));
            If OcValue > 15 Then OcValue := 15;
          End;
          OcScratch[OcJ * OcCols + OcI] := OcValue;
        End;
      End;

      OcMinR := OcRows;
      OcMaxR := -1;
      OcMinC := OcCols;
      OcMaxC := -1;
      For OcJ := 0 To OcRows - 1 Do
        For OcI := 0 To OcCols - 1 Do
          If OcScratch[OcJ * OcCols + OcI] >= 1 Then
          Begin
            If OcJ < OcMinR Then OcMinR := OcJ;
            If OcJ > OcMaxR Then OcMaxR := OcJ;
            If OcI < OcMinC Then OcMinC := OcI;
            If OcI > OcMaxC Then OcMaxC := OcI;
          End;

      If OcMaxR < 0 Then Continue;
      OcTemplates[OcIndex].OcWidth := OcMaxC - OcMinC + 1;
      OcTemplates[OcIndex].OcHeight := OcMaxR - OcMinR + 1;
      OcTemplates[OcIndex].Top := -(OcJ0 + OcMinR);
      OcTemplates[OcIndex].Pen := Round(4 * (OcShift - (OcI0 + OcMinC)));
      OcTemplates[OcIndex].Advance := (Longint(OcGlyphAdvanceOf(OcG)) * Em100 * 4 + 51200) Div 102400;
      OcTemplates[OcIndex].PixelSize := OcTemplates[OcIndex].OcWidth * OcTemplates[OcIndex].OcHeight;
      GetMem(OcTemplates[OcIndex].OcPixels, OcTemplates[OcIndex].PixelSize);
      OcTemplates[OcIndex].Squares := 0;
      OcPosition := 0;
      For OcJ := OcMinR To OcMaxR Do
        For OcI := OcMinC To OcMaxC Do
        Begin
          OcValue := OcScratch[OcJ * OcCols + OcI];
          OcTemplates[OcIndex].OcPixels^[OcPosition] := OcValue;
          Inc(OcTemplates[OcIndex].Squares, OcValue * OcValue);
          Inc(OcPosition);
        End;

      OcAssignExtra(OcIndex, OcG, OcFontNo);
    End;
  End;
  OcTemplateLimit := Glyphs * 4;
End;

Function OcRowSum(OcNumber: Integer): Longint;
Var
  OcRow: OcPImageRow;
  OcColumn: Integer;
  OcSum: Longint;
Begin
  OcRow := OcImage^[OcNumber];
  OcSum := 0;
  For OcColumn := 1 To OcImageWidth Do
    Inc(OcSum, OcRow^[OcColumn]);
  OcRowSum := OcSum;
End;

{ Prepare les sommes par colonne de la bande de lignes Top..Bottom. }
Procedure OcPrepareLine(Top, Bottom: Integer);
Var
  OcRow: OcPImageRow;
  OcColumn, OcNumber, OcValue: Integer;
Begin
  FillChar(OcColumnMax^, OcImageWidth, 0);
  FillChar(OcColumnSquares^, Word(OcImageWidth * SizeOf(Longint)), 0);
  For OcNumber := Top To Bottom Do
  Begin
    OcRow := OcImage^[OcNumber];
    For OcColumn := 1 To OcImageWidth Do
    Begin
      OcValue := OcRow^[OcColumn];
      If OcValue > OcColumnMax^[OcColumn - 1] Then OcColumnMax^[OcColumn - 1] := OcValue;
      Inc(OcColumnSquares^[OcColumn - 1], OcValue * OcValue);
    End;
  End;
  OcPrefixSquares^[0] := 0;
  For OcColumn := 0 To OcImageWidth - 1 Do
    OcPrefixSquares^[OcColumn + 1] := OcPrefixSquares^[OcColumn] + OcColumnSquares^[OcColumn];
End;

{ Meilleur decoupage de la ligne pour une ligne de base donnee. Un gabarit
  peut mordre de 1 ou 2 colonnes sur le precedent (crenage, ex. Tr). }
Function OcMatchLine(OcBase: Integer): Longint;
Var
  OcColumn, OcStart, OcOverlap, OcIndex, OcWidth, OcHeight, OcTopRow, OcRows, OcCols, OcPosition, OcFinish: Integer;
  OcCost, OcSum, OcPenalty, OcEnergy: Longint;
  OcGap: Real;
  OcRow: OcPImageRow;
  OcPixels: OcPRowBuffer;
Begin
  { Borne superieure de depart : ne rien reconnaitre du tout (colonnes sautees).
    Elle permet d'ecarter tres tot les gabarits qui ne peuvent pas faire mieux. }
  OcBestCost^[0] := 0;
  OcBackX^[0] := 0;
  OcBackT^[0] := 0;
  OcBackS^[0] := 0;
  For OcColumn := 1 To OcImageWidth + 7 Do
  Begin
    If OcColumn <= OcImageWidth Then
      OcBestCost^[OcColumn] := OcPrefixSquares^[OcColumn] * OcSkipFactor
    Else
      OcBestCost^[OcColumn] := OcInfinity;
    OcBackX^[OcColumn] := OcColumn - 1;
    OcBackT^[OcColumn] := 0;
    OcBackS^[OcColumn] := 0;
  End;

  For OcColumn := 0 To OcImageWidth - 1 Do
  Begin
    OcCost := OcBestCost^[OcColumn] + OcColumnSquares^[OcColumn] * OcSkipFactor;
    If OcCost < OcBestCost^[OcColumn + 1] Then
    Begin
      OcBestCost^[OcColumn + 1] := OcCost;
      OcBackX^[OcColumn + 1] := OcColumn;
      OcBackT^[OcColumn + 1] := 0;
    End;

    For OcOverlap := 0 To OcMaxOverlapUsed Do
    Begin
      OcStart := OcColumn - OcOverlap;
      If OcStart < 0 Then Break;
      If (OcColumnMax^[OcStart] >= OcInkLevel) Or
         ((OcStart + 1 < OcImageWidth) And (OcColumnMax^[OcStart + 1] >= OcInkLevel)) Then
        For OcIndex := 0 To OcTemplateLimit - 1 Do
        Begin
          { Pas de crenage pour les kana. }
          If (OcOverlap > 0) And (OcIndex >= OcGlyphCount * 4) Then Break;
          OcWidth := OcTemplates[OcIndex].OcWidth;
          If (OcWidth <= OcOverlap) Or (OcStart + OcWidth > OcImageWidth) Then Continue;
          If (OcOverlap > 0) And OcTemplates[OcIndex].Stem Then Continue;
          OcHeight := OcTemplates[OcIndex].OcHeight;
          OcTopRow := OcBase - OcTemplates[OcIndex].Top + 1;
          If (OcTopRow < 1) Or (OcTopRow + OcHeight - 1 > OcImageHeight) Then Continue;
          OcFinish := OcStart + OcWidth;
          OcPenalty := OcGlyphPenalty + OcOverlap * OcOverlapPenalty + OcTemplates[OcIndex].Extra;

          { Elagage 1 : le cout ne peut pas etre inferieur a la penalite. }
          If OcBestCost^[OcColumn] + OcPenalty >= OcBestCost^[OcFinish] Then Continue;

          { Elagage 2 (Cauchy-Schwarz) : la somme des produits est au plus
            racine(energie du gabarit x energie de l'image), d'ou un cout
            minimal (racine(E gabarit) - racine(E image))^2. }
          OcEnergy := OcPrefixSquares^[OcFinish] - OcPrefixSquares^[OcStart];
          OcGap := OcTemplates[OcIndex].Root - Sqrt(OcEnergy + OcEnergy Div 8 + 64);
          If OcGap > 0 Then
            If OcBestCost^[OcColumn] + OcPenalty + OcGap * OcGap >= OcBestCost^[OcFinish] Then Continue;

          OcSum := 0;
          OcPosition := 0;
          OcPixels := OcTemplates[OcIndex].OcPixels;
          For OcRows := 0 To OcHeight - 1 Do
          Begin
            OcRow := OcImage^[OcTopRow + OcRows];
            For OcCols := 1 To OcWidth Do
            Begin
              OcSum := OcSum + OcRow^[OcStart + OcCols] * OcPixels^[OcPosition];
              Inc(OcPosition);
            End;
          End;
          OcCost := OcBestCost^[OcColumn] + OcTemplates[OcIndex].Squares - 2 * OcSum + OcEnergy + OcPenalty;
          If OcCost < OcBestCost^[OcFinish] Then
          Begin
            OcBestCost^[OcFinish] := OcCost;
            OcBackX^[OcFinish] := OcColumn;
            OcBackS^[OcFinish] := OcStart;
            OcBackT^[OcFinish] := OcIndex + 1;
          End;
        End;
    End;
  End;
  OcMatchLine := OcBestCost^[OcImageWidth];
End;

Procedure OcWriteGlyph(OcCode: Integer);
Begin
  If OcCode < 128 Then
    Write(OcOutputFile, Chr(OcCode))
  Else If OcCode < 2048 Then
    Write(OcOutputFile, Chr($C0 Or (OcCode Shr 6)), Chr($80 Or (OcCode And $3F)))
  Else
    Write(OcOutputFile, Chr($E0 Or (OcCode Shr 12)), Chr($80 Or ((OcCode Shr 6) And $3F)),
          Chr($80 Or (OcCode And $3F)));
End;

Function OcRowHasText(OcNumber: Integer): Boolean;
Var
  OcRow: OcPImageRow;
  OcColumn: Integer;
Begin
  OcRow := OcImage^[OcNumber];
  OcRowHasText := False;
  For OcColumn := 1 To OcImageWidth Do
    If OcRow^[OcColumn] >= OcInkLevel Then
    Begin
      OcRowHasText := True;
      Exit;
    End;
End;

Procedure OcAppendCode(OcCode: Integer);
Begin
  OcLineBuffer^[OcLineLength] := OcCode;
  Inc(OcLineLength);
End;

Procedure OcAppendSpaces(OcCount: Integer);
Begin
  While OcCount > 0 Do
  Begin
    OcAppendCode(32);
    Dec(OcCount);
  End;
End;

Function OcIsUpper(OcCode: Integer): Boolean;
Begin
  OcIsUpper := ((OcCode >= Ord('A')) And (OcCode <= Ord('Z'))) Or
             ((OcCode >= 192) And (OcCode <= 222) And (OcCode <> 215));
End;

Function OcIsLower(OcCode: Integer): Boolean;
Begin
  OcIsLower := ((OcCode >= Ord('a')) And (OcCode <= Ord('z'))) Or
             ((OcCode >= 223) And (OcCode <= 255) And (OcCode <> 247));
End;

(* Les trois fermants se confondent facilement entre eux : chacun doit
   refermer l'ouvrant le plus recent de la ligne. *)
Procedure OcFixBrackets;
Var
  OcK, OcDepth, OcCode: Integer;
  OcStack: Array[0..255] Of Integer;
Begin
  OcDepth := 0;
  For OcK := 0 To OcLineLength - 1 Do
  Begin
    OcCode := OcLineBuffer^[OcK];
    If (OcCode = Ord('(')) Or (OcCode = Ord('[')) Or (OcCode = Ord('{')) Then
    Begin
      If OcDepth < 256 Then
      Begin
        OcStack[OcDepth] := OcCode;
        Inc(OcDepth);
      End;
    End
    Else If (OcCode = Ord(')')) Or (OcCode = Ord(']')) Or (OcCode = Ord('}')) Then
      If OcDepth > 0 Then
      Begin
        Dec(OcDepth);
        If OcStack[OcDepth] = Ord('(') Then
          OcLineBuffer^[OcK] := Ord(')')
        Else If OcStack[OcDepth] = Ord('[') Then
          OcLineBuffer^[OcK] := Ord(']')
        Else
          OcLineBuffer^[OcK] := Ord('}');
      End;
  End;
End;

{ Corrections de contexte avant l'ecriture de la ligne. }
{ Une ligne sans symbole de programmation est du texte courant. }
Function OcLooksLikeProse: Boolean;
Var
  OcK: Integer;
Begin
  OcLooksLikeProse := True;
  For OcK := 0 To OcLineLength - 1 Do
    If OcLineBuffer^[OcK] < 128 Then
      If Chr(OcLineBuffer^[OcK]) In ['{', '}', ';', '=', '_', '<', '>', '$', '&', '|', #92] Then
        OcLooksLikeProse := False;
End;

Procedure OcFlushLine;
Var
  OcK, OcBefore: Integer;
Begin
  OcFixBrackets;
  For OcK := 0 To OcLineLength - 2 Do
    { Un I colle a un = en debut de mot est un !. }
    If (OcLineBuffer^[OcK] = Ord('I')) And (OcLineBuffer^[OcK + 1] = Ord('=')) And
       ((OcK = 0) Or (OcLineBuffer^[OcK - 1] = 32) Or (OcLineBuffer^[OcK - 1] = Ord('('))) Then
      OcLineBuffer^[OcK] := Ord('!');
  { En Arial (et pour du texte courant en Segoe UI), I et l se ressemblent : on tranche selon le contexte. Apres
    une minuscule, c'est un l ; en debut de mot suivi d'une minuscule, c'est
    un I seulement en debut de phrase ; sinon c'est un I. }
  If (OcCurrentFont = OcFontArial) Or (((OcCurrentFont = OcFontSegoe) Or (OcCurrentFont = OcFontYuGothic)) And OcLooksLikeProse) Then
    For OcK := 0 To OcLineLength - 1 Do
      If (OcLineBuffer^[OcK] = Ord('I')) Or (OcLineBuffer^[OcK] = Ord('l')) Then
      Begin
        If (OcK > 0) And OcIsLower(OcLineBuffer^[OcK - 1]) Then
          OcLineBuffer^[OcK] := Ord('l')
        Else If (OcK > 0) And OcIsUpper(OcLineBuffer^[OcK - 1]) Then
        Begin
          { Apres une majuscule : I seulement devant une autre majuscule (HIV). }
          If (OcK + 1 < OcLineLength) And OcIsUpper(OcLineBuffer^[OcK + 1]) Then
            OcLineBuffer^[OcK] := Ord('I')
          Else
            OcLineBuffer^[OcK] := Ord('l');
        End
        Else If (OcK + 1 < OcLineLength) And (OcLineBuffer^[OcK + 1] = Ord('''')) And
                ((OcLanguageMask And (Not OcLangEnglish)) <> 0) Then
          OcLineBuffer^[OcK] := Ord('l')
        Else If (OcK + 1 < OcLineLength) And OcIsLower(OcLineBuffer^[OcK + 1]) Then
        Begin
          OcBefore := OcK - 1;
          While (OcBefore >= 0) And (OcLineBuffer^[OcBefore] = 32) Do
            Dec(OcBefore);
          If (OcBefore < 0) Or (OcLineBuffer^[OcBefore] = Ord('.')) Or
             (OcLineBuffer^[OcBefore] = Ord('!')) Or (OcLineBuffer^[OcBefore] = Ord('?')) Or
             (OcLineBuffer^[OcBefore] = Ord(':')) Or (OcLineBuffer^[OcBefore] = Ord('"')) Or
             (OcLineBuffer^[OcBefore] = Ord('(')) Then
            OcLineBuffer^[OcK] := Ord('I')
          Else
            OcLineBuffer^[OcK] := Ord('l');
        End
        Else
          OcLineBuffer^[OcK] := Ord('I');
      End;
  For OcK := 0 To OcLineLength - 1 Do
    OcWriteGlyph(OcLineBuffer^[OcK]);
  Writeln(OcOutputFile);
  OcLineLength := 0;
End;

Function OcIsSampleLine(OcNumber: Integer): Boolean;
Var
  OcK: Integer;
Begin
  OcIsSampleLine := False;
  For OcK := 0 To OcSampleCount - 1 Do
    If OcSampleLine[OcK] = OcNumber Then OcIsSampleLine := True;
End;

{ Cout relatif de la reconnaissance des lignes echantillons avec une
  police et une taille donnees (plus petit = meilleur). }
Procedure OcTryCandidate(OcFontNo, Em100: Integer);
Var
  OcK, OcBase, OcUsedSamples: Integer;
  OcBestCostLine, OcLineCost: Longint;
  OcCost, OcEnergy, OcScore: Real;
Begin
  Inc(OcEvalCount);
  OcProgress('Detection de la police et de la taille : essai ' + OcNumberText(OcEvalCount) +
           '/~' + OcNumberText(OcEvalTotal) + ' (' + OcFontNames[OcFontNo] + ' ' + OcEmText(Em100) + ')');
  OcUsedSamples := OcSampleCount;
  OcCoarseScoring := OcCoarsePass And (Not OcFullScoring);
  If OcFullScoring Then
  Begin
    { Evaluation fidele : tous les caracteres de la langue, avec crenage. }
    OcBuildTemplates(OcFontNo, Em100, OcTotalGlyphs);
    OcMaxOverlapUsed := OcMaxOverlap;
  End
  Else
  Begin
    If (OcLanguageMask And OcLangJapanese) <> 0 Then
      OcBuildTemplates(OcFontNo, Em100, OcTotalGlyphs)
    Else
      OcBuildTemplates(OcFontNo, Em100, OcUnaccentedCount);
    OcMaxOverlapUsed := 0;
  End;
  If ((OcLanguageMask And OcLangJapanese) <> 0) And (OcUsedSamples > 2) Then OcUsedSamples := 2;
  { Recherche grossiere : peu de lignes et peu de gabarits suffisent. }
  If (Not OcFullScoring) And (Not OcCoarseScoring) And (OcUsedSamples > 3) Then OcUsedSamples := 3;
  If OcCoarseScoring Then
    If (OcLanguageMask And OcLangJapanese) <> 0 Then
      OcUsedSamples := 1
    Else If OcUsedSamples > 2 Then
      OcUsedSamples := 2;
  OcCost := 0;
  OcEnergy := 0;
  For OcK := 0 To OcUsedSamples - 1 Do
  Begin
    OcPrepareLine(OcLineTop^[OcSampleLine[OcK]], OcLineBottom^[OcSampleLine[OcK]]);
    If (OcLanguageMask And OcLangJapanese) <> 0 Then
    Begin
      { Les kana n'ont pas de ligne de base nette : on essaie quelques lignes. }
      OcBestCostLine := OcInfinity * 2;
      For OcBase := OcLineBottom^[OcSampleLine[OcK]] - Em100 Div 500 - 1 To OcLineBottom^[OcSampleLine[OcK]] - 1 Do
      Begin
        OcLineCost := OcMatchLine(OcBase);
        If OcLineCost < OcBestCostLine Then OcBestCostLine := OcLineCost;
      End;
      OcCost := OcCost + OcBestCostLine;
    End
    Else
      OcCost := OcCost + OcMatchLine(OcLineEstimate^[OcSampleLine[OcK]]);
    OcEnergy := OcEnergy + OcPrefixSquares^[OcImageWidth];
  End;
  If OcEnergy < 1 Then OcEnergy := 1;
  OcScore := OcCost / OcEnergy * OcScoreBonus;
  If OcScore < OcSearchScore Then
  Begin
    OcSearchScore := OcScore;
    OcSearchFont := OcFontNo;
    OcSearchEm := Em100;
  End;
End;

{ Les applications utilisent des tailles usuelles (entiers en pixels, ou points
  convertis a 96 ppp : 8 pt = 10,67 px, 10 pt = 13,33 px, 11 pt = 14,67 px ...).
  On s'y cale quand la taille mesuree en est a moins de 0,25 pixel. }
Function OcSnapToUsualSize(Em100: Integer): Integer;
Const
  OcPoints: Array[0..4] Of Integer = (1067, 1333, 1467, 1867, 2133);
Var
  OcI, OcBest: Integer;
Begin
  OcBest := ((Em100 + 50) Div 100) * 100;
  For OcI := 0 To 4 Do
    If Abs(OcPoints[OcI] - Em100) < Abs(OcBest - Em100) Then OcBest := OcPoints[OcI];
  If Abs(OcBest - Em100) <= 25 Then
    OcSnapToUsualSize := OcBest
  Else
    OcSnapToUsualSize := Em100;
End;

{ Essaie les tailles usuelles voisines (entier de pixels, 8/10/11/14/16 pt)
  avec l'evaluation fidele ; une taille usuelle l'emporte a score presque egal. }
Procedure OcTryNominalSizes(OcFontNo, OcCenter: Integer);
Const
  OcPoints: Array[0..4] Of Integer = (1067, 1333, 1467, 1867, 2133);
Var
  OcI, OcCandidate: Integer;
Begin
  OcFullScoring := True;
  OcSearchScore := 1E30;
  OcScoreBonus := 1;
  OcTryCandidate(OcFontNo, OcCenter);
  OcScoreBonus := 0.94;
  OcCandidate := ((OcCenter + 50) Div 100) * 100;
  If (OcCandidate <> OcCenter) And (Abs(OcCandidate - OcCenter) <= 60) Then
    OcTryCandidate(OcFontNo, OcCandidate);
  For OcI := 0 To 4 Do
    If (OcPoints[OcI] <> OcCenter) And (Abs(OcPoints[OcI] - OcCenter) <= 60) Then
      OcTryCandidate(OcFontNo, OcPoints[OcI]);
  OcScoreBonus := 1;
  OcFullScoring := False;
End;

{ Choix de la police et de la taille : recherche grossiere, fine, puis tailles usuelles. }
Procedure OcChooseFont(OcHeight75: Integer);
Var
  OcFontNo, OcFirstFont, OcLastFont, OcEm, OcCenter, OcEmLow, OcEmHigh, OcCoarseStep, OcFineStep, OcFineSpan: Integer;
  OcExactScore: Real;
Begin
  OcCoarseStep := 40;
  OcFineStep := 10;
  OcFineSpan := 2;
  If (OcLanguageMask And OcLangJapanese) <> 0 Then
  Begin
    OcCoarseStep := 60;
    OcFineStep := 30;
    OcFineSpan := 2;
  End;
  If (OcFontOption = OcFontAuto) And ((OcLanguageMask And OcLangJapanese) <> 0) Then
  Begin
    { Les kana sont communs a toutes les polices : seules Segoe UI et Yu Gothic
      (police japonaise habituelle) se distinguent par leurs lettres latines. }
    OcFirstFont := OcFontSegoe;
    OcLastFont := OcFontYuGothic;
  End
  Else If OcFontOption = OcFontAuto Then
  Begin
    OcFirstFont := OcFontSegoe;
    OcLastFont := OcFontConsolas;
  End
  Else
  Begin
    OcFirstFont := OcFontOption;
    OcLastFont := OcFontOption;
  End;
  OcFullScoring := False;
  OcCoarsePass := False;
  OcUseExact := True;
  OcScoreBonus := 1;
  OcSearchScore := 1E30;
  OcSearchFont := OcFirstFont;
  OcSearchEm := OcSizeOption;
  If OcSizeOption <> 0 Then
  Begin
    If OcFirstFont <> OcLastFont Then
      For OcFontNo := OcFirstFont To OcLastFont Do
        OcTryCandidate(OcFontNo, OcSizeOption);
  End
  Else
  Begin
    OcEmLow := OcClampTo(Integer((Longint(OcHeight75) * 10000) Div 135), 600, 4800);
    OcEmHigh := OcClampTo(Integer((Longint(OcHeight75) * 10000) Div 85), 600, 4800);
    OcEvalTotal := ((OcLastFont - OcFirstFont + 1) * ((OcEmHigh - OcEmLow) Div OcCoarseStep + 1)) +
                 2 * OcFineSpan + 5 + 5;
    OcCoarsePass := True;
    For OcFontNo := OcFirstFont To OcLastFont Do
    If Not (((OcLanguageMask And OcLangJapanese) <> 0) And (OcFontNo In [OcFontArial, OcFontConsolas])) Then
    Begin
      OcEm := OcEmLow;
      While OcEm <= OcEmHigh Do
      Begin
        OcTryCandidate(OcFontNo, OcEm);
        Inc(OcEm, OcCoarseStep);
      End;
    End;
    OcCoarsePass := False;
    OcFontNo := OcSearchFont;
    OcSearchScore := 1E30;
    OcCenter := OcSearchEm;
    OcTryCandidate(OcFontNo, OcCenter);
    For OcEm := -OcFineSpan To OcFineSpan Do
      If (OcEm <> 0) And (OcCenter + OcEm * OcFineStep >= 600) And (OcCenter + OcEm * OcFineStep <= 4800) Then
        OcTryCandidate(OcFontNo, OcCenter + OcEm * OcFineStep);
    OcCenter := OcSearchEm;
    For OcEm := -2 To 2 Do
      If OcEm <> 0 Then OcTryCandidate(OcFontNo, OcCenter + OcEm * (OcFineStep Div 2));
    OcTryNominalSizes(OcFontNo, OcSearchEm);
  End;
  OcCurrentFont := OcSearchFont;
  OcCurrentEm := OcSearchEm;
  If OcSizeOption = 0 Then OcCurrentEm := OcSnapToUsualSize(OcCurrentEm);
  { A 13,33 px les gabarits Segoe exacts sont tres precis mais sensibles a la
    taille reelle : on garde ceux qui s'ajustent le mieux, exacts ou derives. }
  OcUseExact := True;
  If (OcCurrentFont = OcFontSegoe) And (OcCurrentEm = OcExactEm) And (OcSizeOption = 0) Then
  Begin
    OcFullScoring := True;
    OcScoreBonus := 1;
    OcSearchScore := 1E30;
    OcUseExact := True;
    OcTryCandidate(OcFontSegoe, OcExactEm);
    OcExactScore := OcSearchScore;
    OcSearchScore := 1E30;
    OcUseExact := False;
    OcTryCandidate(OcFontSegoe, OcExactEm);
    If OcSearchScore < OcExactScore Then OcUseExact := False Else OcUseExact := True;
    OcFullScoring := False;
  End;
End;

Procedure OcRecognizeText;
Var
  OcI, OcJ, OcNumber, OcPitch, OcSpaces, OcRounded, OcMinStart, OcRunCount, OcLineBase, OcPreviousBase: Integer;
  OcEstimate, OcBestBase, OcBase, OcGlyphIndex, OcBlanks, OcDelta: Integer;
  OcRowA, OcRowB, OcCount, OcEndColumn, OcSpaceQ, OcHeight75: Integer;
  OcPrevious, OcNext, OcDrop, OcBestDrop, OcCostValue, OcBestValue, OcExpectedPen, OcGap: Longint;
  OcRow: OcPImageRow;
  OcInRun: Boolean;
  OcDeltaHistogram: Array[0..400] Of Integer;
  OcHeightHistogram: Array[0..255] Of Integer;
  OcTotal, OcAccumulated: Longint;
Begin
  If OcImageWidth > OcMaxRecognizeWidth Then
  Begin
    
    OcrFailed := True; Exit;
  End;
  FillChar(OcTemplates, SizeOf(OcTemplates), 0);
  GetMem(OcBestCost, Word((OcImageWidth + 8) * SizeOf(Longint)));
  GetMem(OcPrefixSquares, Word((OcImageWidth + 8) * SizeOf(Longint)));
  GetMem(OcColumnSquares, Word((OcImageWidth + 8) * SizeOf(Longint)));
  GetMem(OcColumnMax, OcImageWidth + 8);
  GetMem(OcBackX, Word((OcImageWidth + 8) * SizeOf(Word)));
  GetMem(OcBackT, Word((OcImageWidth + 8) * SizeOf(Word)));
  GetMem(OcBackS, Word((OcImageWidth + 8) * SizeOf(Word)));
  GetMem(OcOutX, Word((OcImageWidth + 8) * SizeOf(Word)));
  GetMem(OcOutT, Word((OcImageWidth + 8) * SizeOf(Word)));
  GetMem(OcLineBuffer, Word((OcImageWidth + 16) * SizeOf(Word)));
  GetMem(OcLineTop, SizeOf(OcTIntegerArray));
  GetMem(OcLineBottom, SizeOf(OcTIntegerArray));
  GetMem(OcLineEstimate, SizeOf(OcTIntegerArray));
  GetMem(OcLineFirst, SizeOf(OcTIntegerArray));
  GetMem(OcLineInk, SizeOf(OcTLongArray));

  { Passe 1 : reperer les lignes de texte (rangees contenant de l'encre). }
  OcLineCount := 0;
  OcLineLength := 0;
  OcNumber := 1;
  While OcNumber <= OcImageHeight Do
  Begin
    While (OcNumber <= OcImageHeight) And (Not OcRowHasText(OcNumber)) Do
      Inc(OcNumber);
    If OcNumber <= OcImageHeight Then
    Begin
      OcLineTop^[OcLineCount] := OcNumber;
      While (OcNumber <= OcImageHeight) And OcRowHasText(OcNumber) Do
        Inc(OcNumber);
      OcLineBottom^[OcLineCount] := OcNumber - 1;
      Inc(OcLineCount);
    End;
  End;
  If OcLineCount = 0 Then
  Begin
    
    Exit;
  End;

  For OcI := 0 To OcLineCount - 1 Do
  Begin
    OcRowA := OcLineTop^[OcI] - 2;
    If OcRowA < 1 Then OcRowA := 1;
    OcRowB := OcLineBottom^[OcI] + 2;
    If OcRowB > OcImageHeight Then OcRowB := OcImageHeight;
    OcPrevious := OcRowSum(OcRowA);
    OcLineInk^[OcI] := 0;
    OcBestDrop := -OcInfinity;
    OcEstimate := OcRowA;
    For OcNumber := OcRowA To OcRowB - 1 Do
    Begin
      OcNext := OcRowSum(OcNumber + 1);
      OcDrop := OcPrevious - OcNext;
      If OcDrop > OcBestDrop Then
      Begin
        OcBestDrop := OcDrop;
        OcEstimate := OcNumber;
      End;
      If (OcNumber >= OcLineTop^[OcI]) And (OcNumber <= OcLineBottom^[OcI]) Then
        Inc(OcLineInk^[OcI], OcPrevious);
      OcPrevious := OcNext;
    End;
    OcLineEstimate^[OcI] := OcEstimate;

    OcLineFirst^[OcI] := OcImageWidth;
    For OcNumber := OcLineTop^[OcI] To OcLineBottom^[OcI] Do
    Begin
      OcRow := OcImage^[OcNumber];
      For OcJ := 1 To OcLineFirst^[OcI] - 1 Do
        If OcRow^[OcJ] >= OcInkLevel Then
        Begin
          OcLineFirst^[OcI] := OcJ;
          Break;
        End;
    End;
  End;

  OcMinStart := OcImageWidth;
  For OcI := 0 To OcLineCount - 1 Do
    If OcLineFirst^[OcI] < OcMinStart Then OcMinStart := OcLineFirst^[OcI];

  { Interligne : premier quartile des ecarts entre lignes de base. }
  OcStep('Lignes de texte reperees : ' + OcNumberText(OcLineCount) + '.');
  FillChar(OcDeltaHistogram, SizeOf(OcDeltaHistogram), 0);
  OcTotal := 0;
  For OcI := 1 To OcLineCount - 1 Do
  Begin
    OcDelta := OcLineEstimate^[OcI] - OcLineEstimate^[OcI - 1];
    If (OcDelta >= 8) And (OcDelta <= 400) Then
    Begin
      Inc(OcDeltaHistogram[OcDelta]);
      Inc(OcTotal);
    End;
  End;
  OcPitch := 0;
  OcAccumulated := 0;
  For OcDelta := 8 To 400 Do
  Begin
    Inc(OcAccumulated, OcDeltaHistogram[OcDelta]);
    If (OcPitch = 0) And (OcTotal > 0) And (OcAccumulated * 4 >= OcTotal) Then OcPitch := OcDelta;
  End;

  { Hauteur typique d'une ligne (75e centile) et lignes echantillons. }
  FillChar(OcHeightHistogram, SizeOf(OcHeightHistogram), 0);
  For OcI := 0 To OcLineCount - 1 Do
    Inc(OcHeightHistogram[OcClampTo(OcLineBottom^[OcI] - OcLineTop^[OcI] + 1, 0, 255)]);
  OcHeight75 := 255;
  OcAccumulated := 0;
  For OcJ := 0 To 255 Do
  Begin
    Inc(OcAccumulated, OcHeightHistogram[OcJ]);
    If OcAccumulated * 4 >= Longint(OcLineCount) * 3 Then
    Begin
      OcHeight75 := OcJ;
      Break;
    End;
  End;
  OcSampleCount := 0;
  For OcJ := 0 To 3 Do
  Begin
    OcBestValue := -1;
    OcBestBase := -1;
    For OcI := 0 To OcLineCount - 1 Do
      If (OcLineBottom^[OcI] - OcLineTop^[OcI] + 1 >= (OcHeight75 * 3) Div 4) And
         (Not OcIsSampleLine(OcI)) And
         (OcLineInk^[OcI] > OcBestValue) Then
      Begin
        OcBestValue := OcLineInk^[OcI];
        OcBestBase := OcI;
      End;
    If OcBestBase >= 0 Then
    Begin
      OcSampleLine[OcSampleCount] := OcBestBase;
      Inc(OcSampleCount);
    End;
  End;
  If OcSampleCount = 0 Then
  Begin
    OcSampleLine[0] := 0;
    OcSampleCount := 1;
  End;

  OcStep('Detection de la police et de la taille ...');
  OcEvalCount := 0;
  OcChooseFont(OcHeight75);
  OcProgress('Preparation des gabarits ...');
  OcBuildTemplates(OcCurrentFont, OcCurrentEm, OcTotalGlyphs);
  OcMaxOverlapUsed := OcMaxOverlap;
  OcSpaceQ := (Longint(OcFontSpace) * OcCurrentEm * 4 + 51200) Div 102400;
  If OcSpaceQ < 4 Then OcSpaceQ := 4;
  OcStep('Police detectee : ' + OcFontNames[OcCurrentFont] + ' ' + OcEmText(OcCurrentEm));

  { Passe 2 : reconnaitre chaque ligne. }
  OcPreviousBase := 0;
  For OcI := 0 To OcLineCount - 1 Do
  Begin
    OcProgress('Reconnaissance : ligne ' + OcNumberText(OcI + 1) + '/' + OcNumberText(OcLineCount) +
             ' (' + OcNumberText(Longint(OcI) * 100 Div OcLineCount) + ' %)');
    If OcrCancelCheck Then Break;
    OcPrepareLine(OcLineTop^[OcI], OcLineBottom^[OcI]);

    OcRunCount := 0;
    OcInRun := False;
    For OcJ := 0 To OcImageWidth - 1 Do
      If OcColumnMax^[OcJ] >= OcInkLevel Then
      Begin
        If Not OcInRun Then Inc(OcRunCount);
        OcInRun := True;
      End
      Else
        OcInRun := False;

    If (OcRunCount <= 4) Or ((OcLanguageMask And OcLangJapanese) <> 0) Then
    Begin
      OcBestBase := OcLineBottom^[OcI];
      OcBestValue := OcInfinity * 2;
      For OcBase := OcLineBottom^[OcI] - OcCurrentEm Div 300 - 1 To OcLineBottom^[OcI] Do
      Begin
        OcCostValue := OcMatchLine(OcBase);
        If OcCostValue < OcBestValue Then
        Begin
          OcBestValue := OcCostValue;
          OcBestBase := OcBase;
        End;
      End;
      OcLineBase := OcBestBase;
    End
    Else
      OcLineBase := OcLineEstimate^[OcI];
    OcMatchLine(OcLineBase);

    { Retour arriere : suite des gabarits retenus. }
    OcCount := 0;
    OcEndColumn := OcImageWidth;
    While OcEndColumn > 0 Do
    Begin
      If OcBackT^[OcEndColumn] <> 0 Then
      Begin
        OcOutX^[OcCount] := OcBackS^[OcEndColumn];
        OcOutT^[OcCount] := OcBackT^[OcEndColumn] - 1;
        Inc(OcCount);
      End;
      OcEndColumn := OcBackX^[OcEndColumn];
    End;

    { Lignes vides entre deux lignes de texte. }
    If (OcI > 0) And (OcPitch > 0) Then
    Begin
      OcBlanks := (2 * (OcLineBase - OcPreviousBase) + OcPitch) Div (2 * OcPitch) - 1;
      While OcBlanks > 0 Do
      Begin
        Writeln(OcOutputFile);
        Dec(OcBlanks);
      End;
    End;
    OcPreviousBase := OcLineBase;

    { Indentation en espaces de la police ; on s'aligne sur 4 espaces. }
    OcSpaces := ((OcLineFirst^[OcI] - OcMinStart) * 8 + OcSpaceQ) Div (2 * OcSpaceQ);
    OcRounded := ((OcSpaces + 2) Div 4) * 4;
    If Abs(OcSpaces - OcRounded) <= 1 Then OcSpaces := OcRounded;
    OcAppendSpaces(OcSpaces);

    { Espaces entre caracteres : ecart entre la position attendue du
      crayon (crayon precedent + chasse) et la position reelle, en quarts de pixel. }
    OcExpectedPen := -1000000;
    For OcJ := OcCount - 1 Downto 0 Do
    Begin
      OcGlyphIndex := OcOutT^[OcJ];
      If OcExpectedPen > -1000000 Then
      Begin
        OcGap := Longint(OcOutX^[OcJ]) * 4 + OcTemplates[OcGlyphIndex].Pen - OcExpectedPen;
        If OcGap > 0 Then
          OcAppendSpaces((OcGap * 10 + 3 * OcSpaceQ) Div (10 * OcSpaceQ));
      End;
      OcAppendCode(OcGlyphCodeOf(OcGlyphIndex Shr 2));
      OcExpectedPen := Longint(OcOutX^[OcJ]) * 4 + OcTemplates[OcGlyphIndex].Pen +
                     OcTemplates[OcGlyphIndex].Advance;
    End;
    OcFlushLine;
  End;
End;

Procedure OcRecognizeLegacy;
Begin
  OcY := 1;
  While OcY <= OcImageHeight Do
  Begin
    While (OcY <= OcImageHeight) And (Not OcRowHasInk(OcY)) Do
      Inc(OcY);
    If OcY <= OcImageHeight Then
    Begin
      OcTopY := OcY;
      While (OcY <= OcImageHeight) And OcRowHasInk(OcY) Do
        Inc(OcY);
      OcBottomY := OcY - 1;
      OcRecognizedLine := '';
      OcPreviousRight := 0;
      OcCurrentX := 1;
      While OcCurrentX <= OcImageWidth Do
      Begin
        While (OcCurrentX <= OcImageWidth) And
              (Not OcColumnHasInk(OcCurrentX, OcTopY, OcBottomY)) Do
          Inc(OcCurrentX);
        If OcCurrentX <= OcImageWidth Then
        Begin
          OcLeftX := OcCurrentX;
          While (OcCurrentX <= OcImageWidth) And
                OcColumnHasInk(OcCurrentX, OcTopY, OcBottomY) Do
            Inc(OcCurrentX);
          OcRightX := OcCurrentX - 1;
          If (OcPreviousRight > 0) And (OcLeftX - OcPreviousRight > 2) Then
            OcRecognizedLine := OcRecognizedLine + ' ';
          OcRecognizedLine := OcRecognizedLine +
            OcRecognizeGlyph(OcLeftX, OcRightX, OcTopY, OcBottomY);
          OcPreviousRight := OcRightX;
        End;
      End;
      If Not OcLegacyDry Then Writeln(OcOutputFile, OcRecognizedLine);
    End;
  End;
End;

{ Langues : eng, fra, deu, spa, por, combinables avec + (ex. fra+eng). }
{$IFDEF FPC}{$POP}{$ENDIF}

Const
 OX_LANGS = 10;
 OX_MAXLINES = 2000;
 OX_LANGMASK: Array[0..OX_LANGS-1] of Integer = (2,1,4,8,16,32,64,128,256,512);
 OX_ROWS = 18;

Type
 TOxState = Record
  X, Y: Integer;
  Phase: Integer;
  Langs: Integer;
  Font, SizeEm: Integer;
  AutoSize, UseSel, HasSel: Boolean;
  Done, Dirty, Run: Boolean;
  LangRects: Array[0..OX_LANGS-1] of TRect;
  FontRects: Array[0..5] of TRect;
  SizeAuto, ZoneImg, ZoneSel: TRect;
  SzM, SzTrack, SzP: TRect;
  GoButton, CancelButton: TRect;
  CopyButton, SaveButton, BackButton, CloseButton: TRect;
  UpButton, DownButton, TextBox: TRect;
  Text: PChar;
  TextLen: LongInt;
  LineStart: Array[0..OX_MAXLINES] of LongInt;
  LineCount, Top: Integer;
  Status: String[80];
  MX, MY, MB, PreviousButtons: Integer;
 End;

Function OxLangName(I: Integer): String;
Begin
 Case I Of
  0: OxLangName := 'Francais';
  1: OxLangName := 'Anglais';
  2: OxLangName := 'Allemand';
  3: OxLangName := 'Espagnol';
  4: OxLangName := 'Portugais';
  5: OxLangName := 'Suedois';
  6: OxLangName := 'Italien';
  7: OxLangName := 'Albanais';
  8: OxLangName := 'Danois';
 Else OxLangName := 'Japonais'; End;
End;

Function OxFontName(I: Integer): String;
Begin
 Case I Of
  0: OxFontName := 'Detection automatique';
  1: OxFontName := 'Segoe UI';
  2: OxFontName := 'Arial';
  3: OxFontName := 'Consolas';
  4: OxFontName := 'Yu Gothic';
 Else OxFontName := 'Matricielle 5 x 7'; End;
End;

{ Lit le fichier texte UTF-8 produit par le moteur }
Function OxLoadText(Const Name: String; Var Buf: PChar; Var Len: LongInt): Boolean;
Var
 F: File;
 N: LongInt;
 Old: Byte;
Begin
 OxLoadText := False;
 Buf := Nil;
 Len := 0;
 Assign(F,Name);
 Old := FileMode;
 FileMode := 0;
 {$I-} Reset(F,1); {$I+}
 FileMode := Old;
 If IOResult <> 0 Then Exit;
 N := FileSize(F);
 If (N < 0) Or (N > 4000000) Then Begin
  Close(F);
  Exit;
 End;
 GetMem(Buf,N+1);
 If N > 0 Then
  BlockRead(F,Buf^,N);
 Buf[N] := #0;
 Close(F);
 Len := N;
 OxLoadText := True;
End;

Function OxRecognize(Var D: TOxState; X1, Y1, X2, Y2: Integer): Boolean;
Var
 W, H, X, Y: Integer;
 Idx: Byte;
 Col: TRGBColor;
 Row: PByte;
 Name: String;
 Dummy: LongInt;
Begin
 OxRecognize := False;
 W := X2-X1+1;
 H := Y2-Y1+1;
 OcrFailed := False;
 OcrCancelled := False;
 OcImage := Nil;
 OcSetImageSize(W,H);
 If OcrFailed Or (OcImage = Nil) Then Exit;
 For Y := 1 To H Do Begin
  Row := CanvasImage;
  Inc(Row,LongInt(Y1+Y-2)*CanvasImageW+X1-1);
  For X := 1 To W Do Begin
   Idx := Row^;
   Inc(Row);
   Col := ImageBuffer.Palette[Idx];
   OcImage^[Y]^[X] := OcGrayOf(Col.R,Col.G,Col.B);
  End;
 End;
 OcNormalizeImage;
 OcLanguageMask := D.Langs;
 OcFontOption := OcFontAuto;
 OcUseLegacy := False;
 OcSizeOption := 0;
 Case D.Font Of
  1: OcFontOption := OcFontSegoe;
  2: OcFontOption := OcFontArial;
  3: OcFontOption := OcFontConsolas;
  4: OcFontOption := OcFontYuGothic;
  5: OcUseLegacy := True;
 End;
 If Not D.AutoSize Then
  OcSizeOption := D.SizeEm*100;
 { police matricielle 5 x 7 : elle colle presque parfaitement a la grille }
 If (Not OcUseLegacy) And (OcFontOption = OcFontAuto) And (OcSizeOption = 0) Then Begin
  OcLegacyDry := True;
  OcDryGlyphs := 0;
  OcDryErrors := 0;
  OcRecognizeLegacy;
  OcLegacyDry := False;
  If (OcDryGlyphs > 0) And (OcDryErrors <= OcDryGlyphs*3) Then
   OcUseLegacy := True;
 End;
 Name := ScTempFile;
 Name := Copy(Name,1,Length(Name)-12)+'PAINTOCR.TXT';
 Assign(OcOutputFile,Name);
 {$I-} Rewrite(OcOutputFile); {$I+}
 If IOResult <> 0 Then
  OcrFailed := True
 Else Begin
  If OcUseLegacy Then
   OcRecognizeLegacy
  Else
   OcRecognizeText;
  Close(OcOutputFile);
 End;
 { liberation de la memoire du moteur }
 For Y := 1 To H Do
  If OcImage^[Y] <> Nil Then FreeMem(OcImage^[Y]);
 FreeMem(OcImage);
 OcImage := Nil;
 OcFreeTemplates;
 If OcBestCost <> Nil Then FreeMem(OcBestCost);
 If OcPrefixSquares <> Nil Then FreeMem(OcPrefixSquares);
 If OcColumnSquares <> Nil Then FreeMem(OcColumnSquares);
 If OcColumnMax <> Nil Then FreeMem(OcColumnMax);
 If OcBackX <> Nil Then FreeMem(OcBackX);
 If OcBackT <> Nil Then FreeMem(OcBackT);
 If OcBackS <> Nil Then FreeMem(OcBackS);
 If OcOutX <> Nil Then FreeMem(OcOutX);
 If OcOutT <> Nil Then FreeMem(OcOutT);
 If OcLineBuffer <> Nil Then FreeMem(OcLineBuffer);
 If OcLineTop <> Nil Then FreeMem(OcLineTop);
 If OcLineBottom <> Nil Then FreeMem(OcLineBottom);
 If OcLineEstimate <> Nil Then FreeMem(OcLineEstimate);
 If OcLineFirst <> Nil Then FreeMem(OcLineFirst);
 If OcLineInk <> Nil Then FreeMem(OcLineInk);
 OcBestCost := Nil; OcPrefixSquares := Nil; OcColumnSquares := Nil;
 OcColumnMax := Nil; OcBackX := Nil; OcBackT := Nil; OcBackS := Nil;
 OcOutX := Nil; OcOutT := Nil; OcLineBuffer := Nil; OcLineTop := Nil;
 OcLineBottom := Nil; OcLineEstimate := Nil; OcLineFirst := Nil; OcLineInk := Nil;
 If OcrFailed Then Exit;
 If D.Text <> Nil Then Begin
  FreeMem(D.Text);
  D.Text := Nil;
 End;
 If Not OxLoadText(Name,D.Text,D.TextLen) Then Exit;
 Assign(OcOutputFile,Name);
 {$I-} Erase(OcOutputFile); {$I+}
 If IOResult <> 0 Then;
 OxRecognize := True;
End;

{ Convertit une ligne UTF-8 en CP437 pour l'affichage. }
Function OxToScreen(Const Src: String): String;
Var
 I, Code: Integer;
 B: Byte;
 R: String;
Begin
 R := '';
 I := 1;
 While (I <= Length(Src)) And (Length(R) < 250) Do Begin
  B := Ord(Src[I]);
  Code := B;
  If (B >= $C0) And (B < $E0) And (I < Length(Src)) Then Begin
   Code := ((B And $1F) Shl 6) Or (Ord(Src[I+1]) And $3F);
   Inc(I);
  End
  Else If (B >= $E0) And (I+1 < Length(Src)) Then Begin
   Code := 63;
   Inc(I,2);
  End;
  If Code < 128 Then
   R := R+Chr(Code)
  Else Begin
   Case Code Of
    233: B := 130; 226: B := 131; 228: B := 132; 224: B := 133; 229: B := 134;
    231: B := 135; 234: B := 136; 235: B := 137; 232: B := 138; 239: B := 139;
    238: B := 140; 236: B := 141; 196: B := 142; 197: B := 143; 201: B := 144;
    230: B := 145; 198: B := 146; 244: B := 147; 246: B := 148; 242: B := 149;
    251: B := 150; 249: B := 151; 255: B := 152; 214: B := 153; 220: B := 154;
    252: B := 129; 225: B := 160; 237: B := 161; 243: B := 162; 250: B := 163;
    241: B := 164; 209: B := 165; 191: B := 168; 161: B := 173; 223: B := 225;
   Else B := 63; End;
   R := R+Chr(B);
  End;
  Inc(I);
 End;
 OxToScreen := R;
End;

Procedure OxIndexLines(Var D: TOxState);
Var
 I: LongInt;
Begin
 D.LineCount := 0;
 D.LineStart[0] := 0;
 For I := 0 To D.TextLen-1 Do
  If D.Text[I] = #10 Then
   If D.LineCount < OX_MAXLINES-1 Then Begin
    Inc(D.LineCount);
    D.LineStart[D.LineCount] := I+1;
   End;
 If (D.TextLen > 0) And (D.Text[D.TextLen-1] <> #10) Then
  Inc(D.LineCount);
 D.LineStart[D.LineCount] := D.TextLen;
 D.Top := 0;
End;

Function OxLine(Const D: TOxState; N: Integer): String;
Var
 I, A, B: LongInt;
 S: String;
Begin
 S := '';
 A := D.LineStart[N];
 B := D.LineStart[N+1];
 If (B > A) And (D.Text[B-1] = #10) Then Dec(B);
 If (B > A) And (D.Text[B-1] = #13) Then Dec(B);
 For I := A To B-1 Do
  If Length(S) < 250 Then S := S+D.Text[I];
 OxLine := S;
End;

Function OxCopyText(Const D: TOxState): Boolean;
{$IFDEF WINDOWS}
Var
 Memory: TPaintWinHandle;
 Buffer: PChar;
 I, J: LongInt;
 B: Byte;
 Code: Integer;
Begin
 OxCopyText := False;
 If (D.Text = Nil) Or (D.TextLen = 0) Then Exit;
 If Not PaintWinOpenClipboard(0) Then Exit;
 Memory := PaintWinGlobalAlloc(PAINT_GMEM_MOVEABLE,D.TextLen*2+1);
 If Memory = 0 Then Begin
  PaintWinCloseClipboard;
  Exit;
 End;
 Buffer := PChar(PaintWinGlobalLock(Memory));
 If Buffer = Nil Then Begin
  PaintWinGlobalFree(Memory);
  PaintWinCloseClipboard;
  Exit;
 End;
 { UTF-8 -> ANSI (Latin-1) ; les autres caracteres deviennent ? }
 J := 0;
 I := 0;
 While I < D.TextLen Do Begin
  B := Ord(D.Text[I]);
  If B < 128 Then Begin
   If B = 10 Then Begin
    Buffer[J] := #13; Inc(J);
   End;
   Buffer[J] := Chr(B);
  End
  Else If (B >= $C0) And (B < $E0) And (I+1 < D.TextLen) Then Begin
   Code := ((B And $1F) Shl 6) Or (Ord(D.Text[I+1]) And $3F);
   Inc(I);
   If Code < 256 Then Buffer[J] := Chr(Code) Else Buffer[J] := '?';
  End
  Else Begin
   Buffer[J] := '?';
   If B >= $E0 Then Inc(I,2);
  End;
  Inc(J);
  Inc(I);
 End;
 Buffer[J] := #0;
 PaintWinGlobalUnlock(Memory);
 If PaintWinEmptyClipboard Then
  If PaintWinSetClipboardData(PAINT_CF_TEXT,Memory) <> 0 Then Begin
   OxCopyText := True;
   Memory := 0;
  End;
 If Memory <> 0 Then PaintWinGlobalFree(Memory);
 PaintWinCloseClipboard;
End;
{$ELSE}
Begin
 OxCopyText := False;
End;
{$ENDIF}

Function OxSaveText(Const D: TOxState; Var Name: String): Boolean;
Var
 F: File;
 P: Integer;
Begin
 OxSaveText := False;
 If (D.Text = Nil) Or (D.TextLen = 0) Then Exit;
 Name := ImageBuffer.FileName;
 If Name = '' Then
  Name := 'OCR.TXT'
 Else Begin
  P := Length(Name);
  While (P > 0) And (Name[P] <> '.') And (Name[P] <> '\') And (Name[P] <> '/') Do
   Dec(P);
  If (P > 0) And (Name[P] = '.') Then
   Name := Copy(Name,1,P-1);
  Name := Name+'.TXT';
 End;
 Assign(F,Name);
 {$I-}
 Rewrite(F,1);
 If IOResult = 0 Then Begin
  BlockWrite(F,D.Text^,D.TextLen);
  Close(F);
  OxSaveText := IOResult = 0;
 End;
 {$I+}
End;

Procedure OxLayout(Var D: TOxState);
Var
 I: Integer;
Begin
 D.X := (ScreenWidth-BR_W) Div 2;
 D.Y := (ScreenHeight-BR_H) Div 2;
 For I := 0 To OX_LANGS-1 Do
  PERect(D.LangRects[I],D.X+12+(I Div 5)*150,D.Y+52+(I Mod 5)*22,146,20);
 For I := 0 To 5 Do
  PERect(D.FontRects[I],D.X+324,D.Y+52+I*22,270,20);
 PERect(D.SizeAuto,D.X+12,D.Y+196,280,20);
 PERect(D.SzM,D.X+12,D.Y+224,24,20);
 PERect(D.SzTrack,D.X+42,D.Y+224,220,20);
 PERect(D.SzP,D.X+268,D.Y+224,24,20);
 PERect(D.ZoneImg,D.X+324,D.Y+206,270,20);
 PERect(D.ZoneSel,D.X+324,D.Y+228,270,20);
 PERect(D.GoButton,D.X+12,D.Y+340,150,25);
 PERect(D.CancelButton,D.X+174,D.Y+340,108,25);
 PERect(D.TextBox,D.X+12,D.Y+34,572,OX_ROWS*15+8);
 PERect(D.UpButton,D.X+586,D.Y+34,18,24);
 PERect(D.DownButton,D.X+586,D.Y+34+OX_ROWS*15+8-24,18,24);
 PERect(D.CopyButton,D.X+12,D.Y+340,108,25);
 PERect(D.SaveButton,D.X+132,D.Y+340,150,25);
 PERect(D.BackButton,D.X+294,D.Y+340,120,25);
 PERect(D.CloseButton,D.X+426,D.Y+340,108,25);
End;

Procedure OxDraw(Var D: TOxState);
Var
 R: TRect;
 I: Integer;
 S: String;
Begin
 PEHideMouse;
 SetWriteMode(CopyPut);
 SetLineStyle(SolidLn,0,NormWidth);
 PERect(R,D.X,D.Y,BR_W,BR_H);
 PEFill(R,LightGray);
 PEBevel(R,False);
 SetFillStyle(SolidFill,Blue);
 Bar(D.X+3,D.Y+3,D.X+BR_W-4,D.Y+21);
 SetColor(White);
 OutTextXY(D.X+9,D.Y+7,'Reconnaissance de texte (OCR) - PAINT');
 OutTextXY(D.X+BR_W-18,D.Y+7,'X');
 If D.Phase = 0 Then Begin
  PELabel(D.X+12,D.Y+33,'Langues du texte :');
  For I := 0 To OX_LANGS-1 Do
   BRCheckBox(D.LangRects[I],(D.Langs And OX_LANGMASK[I]) <> 0,OxLangName(I));
  PELabel(D.X+324,D.Y+33,'Police du texte :');
  For I := 0 To 5 Do
   BRRadio(D.FontRects[I],D.Font = I,OxFontName(I));
  Str(D.SizeEm,S);
  If D.AutoSize Then
   PELabel(D.X+12,D.Y+178,'Taille de la police : automatique')
  Else
   PELabel(D.X+12,D.Y+178,'Taille de la police : '+S+' px');
  BRCheckBox(D.SizeAuto,D.AutoSize,'Detecter la taille automatiquement');
  If Not D.AutoSize Then
   BLSlider(D.SzM,D.SzTrack,D.SzP,D.SizeEm-6,42)
  Else Begin
   PEFill(D.SzTrack,LightGray);
   PEBevel(D.SzTrack,True);
  End;
  PELabel(D.X+324,D.Y+186,'Zone a analyser :');
  BRRadio(D.ZoneImg,Not D.UseSel,'Image entiere');
  If D.HasSel Then
   BRRadio(D.ZoneSel,D.UseSel,'Selection active')
  Else Begin
   SetColor(DarkGray);
   OutTextXY(D.ZoneSel.Left+18,D.ZoneSel.Top+6,'Selection indisponible');
  End;
  PELabel(D.X+12,D.Y+264,'Le moteur lit le texte affiche a l''ecran');
  PELabel(D.X+12,D.Y+280,'(captures, polices Segoe UI, Arial,');
  PELabel(D.X+12,D.Y+296,'Consolas, Yu Gothic) ; il ne reconnait pas');
  PELabel(D.X+12,D.Y+312,'l''ecriture manuscrite ni les photos.');
  PEButton(D.GoButton,'Reconnaitre',False);
  PEButton(D.CancelButton,'Annuler',False);
  If D.Status <> '' Then Begin
   SetColor(DarkGray);
   OutTextXY(D.X+300,D.Y+346,D.Status);
  End;
 End
 Else Begin
  PEFill(D.TextBox,White);
  PEBevel(D.TextBox,True);
  SetColor(Black);
  For I := 0 To OX_ROWS-1 Do
   If D.Top+I < D.LineCount Then Begin
    S := OxToScreen(OxLine(D,D.Top+I));
    If Length(S) > 68 Then S := Copy(S,1,68);
    OutTextXY(D.TextBox.Left+4,D.TextBox.Top+4+I*15,S);
   End;
  PEButton(D.UpButton,'^',False);
  PEButton(D.DownButton,'v',False);
  Str(D.LineCount,S);
  PELabel(D.X+12,D.Y+34+OX_ROWS*15+14,S+' ligne(s) reconnue(s)');
  PEButton(D.CopyButton,'Copier',False);
  PEButton(D.SaveButton,'Enregistrer .TXT',False);
  PEButton(D.BackButton,'Options',False);
  PEButton(D.CloseButton,'Fermer',False);
  If D.Status <> '' Then Begin
   SetColor(DarkGray);
   OutTextXY(D.X+12,D.Y+322,D.Status);
  End;
 End;
 PEShowMouse;
 D.Dirty := False;
End;

Procedure OxScroll(Var D: TOxState; Delta: Integer);
Begin
 D.Top := PEClamp(D.Top+Delta,0,Max(0,D.LineCount-OX_ROWS));
 D.Dirty := True;
End;

Procedure OxMouse(Var D: TOxState);
Var
 I: Integer;
 Pressed: Boolean;
 Name: String;
Begin
 GetMouseStateLocal(D.MX,D.MY,D.MB);
 Pressed := ((D.MB And 1) <> 0) And ((D.PreviousButtons And 1) = 0);
 If Pressed Then Begin
  D.Status := '';
  If (D.MX >= D.X+BR_W-24) And (D.MX <= D.X+BR_W-4) And
     (D.MY >= D.Y+3) And (D.MY <= D.Y+21) Then
   D.Done := True
  Else If D.Phase = 0 Then Begin
   If PEInside(D.MX,D.MY,D.CancelButton) Then
    D.Done := True
   Else If PEInside(D.MX,D.MY,D.GoButton) Then
    D.Run := True
   Else If PEInside(D.MX,D.MY,D.SizeAuto) Then Begin
    D.AutoSize := Not D.AutoSize;
    D.Dirty := True;
   End
   Else If PEInside(D.MX,D.MY,D.SzM) Then Begin
    D.SizeEm := PEClamp(D.SizeEm-1,6,48); D.AutoSize := False; D.Dirty := True;
   End
   Else If PEInside(D.MX,D.MY,D.SzP) Then Begin
    D.SizeEm := PEClamp(D.SizeEm+1,6,48); D.AutoSize := False; D.Dirty := True;
   End
   Else If PEInside(D.MX,D.MY,D.SzTrack) Then Begin
    D.SizeEm := PEClamp(6+(D.MX-D.SzTrack.Left-2)*42 Div (D.SzTrack.Right-D.SzTrack.Left-4),6,48);
    D.AutoSize := False;
    D.Dirty := True;
   End
   Else If PEInside(D.MX,D.MY,D.ZoneImg) Then Begin
    D.UseSel := False; D.Dirty := True;
   End
   Else If PEInside(D.MX,D.MY,D.ZoneSel) And D.HasSel Then Begin
    D.UseSel := True; D.Dirty := True;
   End
   Else Begin
    For I := 0 To OX_LANGS-1 Do
     If PEInside(D.MX,D.MY,D.LangRects[I]) Then Begin
      D.Langs := D.Langs Xor OX_LANGMASK[I];
      If D.Langs = 0 Then D.Langs := OX_LANGMASK[I];
      D.Dirty := True;
     End;
    For I := 0 To 5 Do
     If PEInside(D.MX,D.MY,D.FontRects[I]) Then Begin
      D.Font := I;
      D.Dirty := True;
     End;
   End;
  End
  Else Begin
   If PEInside(D.MX,D.MY,D.CloseButton) Then
    D.Done := True
   Else If PEInside(D.MX,D.MY,D.BackButton) Then Begin
    D.Phase := 0; D.Dirty := True;
   End
   Else If PEInside(D.MX,D.MY,D.CopyButton) Then Begin
    If OxCopyText(D) Then D.Status := 'Texte copie dans le presse-papiers.'
    Else D.Status := 'Copie impossible.';
    D.Dirty := True;
   End
   Else If PEInside(D.MX,D.MY,D.SaveButton) Then Begin
    If OxSaveText(D,Name) Then D.Status := 'Enregistre : '+Name
    Else D.Status := 'Enregistrement impossible.';
    If Length(D.Status) > 76 Then D.Status := Copy(D.Status,1,76);
    D.Dirty := True;
   End
   Else If PEInside(D.MX,D.MY,D.UpButton) Then OxScroll(D,-3)
   Else If PEInside(D.MX,D.MY,D.DownButton) Then OxScroll(D,3);
  End;
 End;
 D.PreviousButtons := D.MB;
End;

Procedure OxKeyboard(Var D: TOxState);
Var
 K: Char;
Begin
 K := ReadKey;
 If K = #0 Then Begin
  K := ReadKey;
  If D.Phase = 1 Then
   Case Ord(K) Of
    72: OxScroll(D,-1);
    80: OxScroll(D,1);
    73: OxScroll(D,-OX_ROWS);
    81: OxScroll(D,OX_ROWS);
    71: OxScroll(D,-OX_MAXLINES);
    79: OxScroll(D,OX_MAXLINES);
   End;
  Exit;
 End;
 Case K Of
  #27: D.Done := True;
  #13: If D.Phase = 0 Then D.Run := True;
 End;
End;

Procedure OcrDialog;
Var
 D: TOxState;
 X1, Y1, X2, Y2: Integer;
 Ok: Boolean;
Begin
 If Not PGHasImage Then Begin
  ShowMessage('Reconnaissance de texte (OCR)','Aucune image a analyser.');
  Exit;
 End;
 MenuActive := False;
 RedrawInterface;
 FillChar(D,SizeOf(D),0);
 D.Phase := 0;
 D.Langs := 2;
 D.Font := 0;
 D.SizeEm := 14;
 D.AutoSize := True;
 D.HasSel := SelectionActive;
 D.UseSel := SelectionActive;
 D.Text := Nil;
 OxLayout(D);
 GetMouseStateLocal(D.MX,D.MY,D.PreviousButtons);
 D.Dirty := True;
 While Not D.Done Do Begin
  If D.Dirty Then OxDraw(D);
  If KeyPressed Then OxKeyboard(D);
  If Not D.Done Then OxMouse(D);
  If D.Run Then Begin
   D.Run := False;
   X1 := 0; Y1 := 0; X2 := CanvasImageW-1; Y2 := CanvasImageH-1;
   If D.UseSel And SelectionActive Then Begin
    X1 := PEClamp(SelectionRect.Left-CanvasX,0,CanvasImageW-1);
    Y1 := PEClamp(SelectionRect.Top-CanvasY,0,CanvasImageH-1);
    X2 := PEClamp(SelectionRect.Right-CanvasX,0,CanvasImageW-1);
    Y2 := PEClamp(SelectionRect.Bottom-CanvasY,0,CanvasImageH-1);
   End;
   Inc(X1); Inc(Y1); Inc(X2); Inc(Y2);
   D.Status := '';
   If X2-X1+1 > 12000 Then
    D.Status := 'Image trop large (12000 px maximum).'
   Else Begin
    OcrBoxX := D.X;
    OcrBoxY := D.Y;
    OcrDrawProgress('Preparation...',0);
    Ok := OxRecognize(D,X1,Y1,X2,Y2);
    If OcrCancelled Then
     D.Status := 'Reconnaissance annulee.'
    Else If Not Ok Then
     D.Status := 'Echec de la reconnaissance.'
    Else If D.TextLen = 0 Then
     D.Status := 'Aucun texte trouve dans l''image.'
    Else Begin
     OxIndexLines(D);
     D.Phase := 1;
    End;
   End;
   D.PreviousButtons := 1;
   D.Dirty := True;
   OxDraw(D);
  End;
  Delay(10);
 End;
 If D.Text <> Nil Then FreeMem(D.Text);
 Repeat
  GetMouseStateLocal(D.MX,D.MY,D.MB);
  If (D.MB And 1) <> 0 Then
   Delay(10);
 Until (D.MB And 1) = 0;
 OldMouseButtons := 0;
 MouseButtons := 0;
 RedrawInterface;
End;


{ Fusionner des vetements : le moteur ci-dessous est le code complet de
  VTON.PAS (essayage virtuel pilote par IA : reseau SegFormer, decodeurs
  JPEG/PNG/BMP/PPM, recoloration, motifs, ajout/retrait d'accessoires,
  calcul multi-fils et GPU Direct3D 11 optionnel). Les identifiants du moteur
  portent le prefixe Vt pour ne pas entrer en conflit avec PAINT ; la ligne de
  commande, l'aide et la console sont remplacees par l'interface de PAINT :
  la photo vient du canevas et les messages vont dans le journal du dialogue. }

{$IFDEF FPC}{$PUSH}{$ENDIF}
{$H+}{$I-}{$R-}{$Q-}{$POINTERMATH ON}{$INLINE ON}{$MACRO ON}
{$NOTES OFF}{$HINTS OFF}{$WARNINGS OFF}

Type
 TVxErr = Class(TObject)
 End;

Var
 VxCancelled: Boolean;
 VxFails: LongInt;
 VxMsg, VxLastWarn: AnsiString;
 VxPrevPx: PByte;
 VxPrevW, VxPrevH: LongInt;
 VxLog: Array[0..3] of String;
 VxLogX, VxLogY: Integer;
 VxCancelRect: TRect;

Procedure VxPal(Idx: Byte; Var R1, G1, B1: Byte);
Begin
 R1 := ImageBuffer.Palette[Idx].R;
 G1 := ImageBuffer.Palette[Idx].G;
 B1 := ImageBuffer.Palette[Idx].B;
End;

Procedure VxDrawLog;
Var
 R: TRect;
 I: Integer;
Begin
 PEHideMouse;
 PERect(R,VxLogX,VxLogY,288,64);
 PEFill(R,White);
 PEBevel(R,True);
 SetColor(Black);
 For I := 0 To 3 Do
  OutTextXY(VxLogX+4,VxLogY+4+I*14,Copy(VxLog[I],1,34));
 PEShowMouse;
End;

Procedure VxNote(Const S: AnsiString);
Var
 I, MX, MY, MB: Integer;
 T: String;
Begin
 T := Copy(S,1,255);
 If (VxLog[3] <> T) Then Begin
  For I := 0 To 2 Do
   VxLog[I] := VxLog[I+1];
  VxLog[3] := T;
  VxDrawLog;
 End;
 GetMouseStateLocal(MX,MY,MB);
 If ((MB And 1) <> 0) And PEInside(MX,MY,VxCancelRect) Then
  VxCancelled := True;
 If KeyPressed Then
  If ReadKey = #27 Then
   VxCancelled := True;
 If VxCancelled Then Begin
  VxMsg := 'Operation annulee.';
  Raise TVxErr.Create;
 End;
End;

Procedure VxWarn(Const S: AnsiString);
Begin
 VxLastWarn := S;
 VxNote('Attention : '+S);
End;

Procedure VxFail(Const S: AnsiString);
Begin
 VxMsg := S;
 Raise TVxErr.Create;
End;

