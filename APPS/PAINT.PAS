Procedure RFDraw(Var D: TRFState);
Var
 R: TRect;
 I: Integer;
Begin
 PEHideMouse;
 SetWriteMode(CopyPut);
 SetLineStyle(SolidLn,0,NormWidth);
 PERect(R,D.X,D.Y,620,430);
 PEFill(R,LightGray);
 PEBevel(R,False);
 SetFillStyle(SolidFill,Blue);
 Bar(D.X+3,D.Y+3,D.X+616,D.Y+21);
 SetColor(White);
 OutTextXY(D.X+9,D.Y+7,'Retourner / Pivoter - PAINT');
 OutTextXY(D.X+602,D.Y+7,'X');
 PELabel(D.X+12,D.Y+33,'Choisissez le resultat souhaite :');
 For I := 0 To RF_MODE_COUNT-1 Do
  RFDrawTile(D,I);
 PELabel(D.X+264,D.Y+49,'AVANT');
 PELabel(D.X+442,D.Y+49,'APRES');
 RFDrawPreview(D,D.BeforeBox,False);
 RFDrawPreview(D,D.AfterBox,True);
 PELabel(D.X+264,D.Y+239,PENumber(D.SourceW)+' x '+PENumber(D.SourceH)+' px');
 PELabel(D.X+442,D.Y+239,PENumber(D.ResultW)+' x '+PENumber(D.ResultH)+' px');
 PELabel(D.X+264,D.Y+255,'Apercus ajustes aux proportions.');
 RFDrawScope(D);
 RFDrawExplanation(D);
 PEButton(D.ApplyButton,'Appliquer',D.Focus = RF_FOCUS_APPLY);
 If (D.Mode = RF_ORIGINAL) Or Not D.ValidResult Then Begin
  PEFill(D.ApplyButton,LightGray);
  PEBevel(D.ApplyButton,False);
  SetColor(DarkGray);
  RFCenteredText(D.ApplyButton,D.ApplyButton.Top+8,'Appliquer');
 End;
 PEButton(D.CancelButton,'Annuler',D.Focus = RF_FOCUS_CANCEL);
 PEButton(D.ResetButton,'Reinitialiser',D.Focus = RF_FOCUS_RESET);
 PEButton(D.HelpButton,'Aide (F1)',D.Focus = RF_FOCUS_HELP);
 SetFillStyle(SolidFill,LightGray);
 Bar(0,ScreenHeight-STATUSBAR_HEIGHT,ScreenWidth-1,ScreenHeight-1);
 PELabel(5,ScreenHeight-STATUSBAR_HEIGHT+5,D.Status);
 PEShowMouse;
 D.Dirty := False;
End;

Procedure RFChoose(Var D: TRFState; Mode: Integer);
Begin
 D.Mode := PEClamp(Mode,0,RF_MODE_COUNT-1);
 D.Focus := D.Mode;
 RFUpdateResult(D);
End;

Procedure RFHelp(Var D: TRFState);
Begin
 ShowMessage('Aide - Retourner / Pivoter',
  'Horizontal : echange gauche et droite.'+#10+
  'Vertical : echange haut et bas.'+#10+
  '90 deg : quart de tour ; 180 deg : demi-tour.'+#10+
  'H/V : miroirs ; G/D : gauche/droite ; I : 180.'+#10+
  'Entree applique ; Echap annule ; Ctrl+Z ensuite.');
 D.Dirty := True;
End;

Procedure RFActivate(Var D: TRFState; Action: Integer);
Begin
 Case Action Of
  RF_FOCUS_APPLY: Begin
   If D.ValidResult And (D.Mode <> RF_ORIGINAL) Then Begin
    D.Accepted := True;
    D.Done := True;
   End;
  End;
  RF_FOCUS_CANCEL: Begin
   D.Accepted := False;
   D.Done := True;
  End;
  RF_FOCUS_RESET: RFChoose(D,RF_ORIGINAL);
  RF_FOCUS_HELP: RFHelp(D);
  RF_FOCUS_SCOPE: Begin
   If D.HasSelection Then Begin
    D.UseSelection := Not D.UseSelection;
    RFUpdateResult(D);
   End;
  End;
 Else
  If (Action >= 0) And (Action < RF_MODE_COUNT) Then
   RFChoose(D,Action);
 End;
End;

Procedure RFKeyboard(Var D: TRFState);
Var
 K: Char;
 Next: Integer;
Begin
 K := ReadKey;
 If K = #0 Then Begin
  K := ReadKey;
  Case Ord(K) Of
   15: Begin
    D.Focus := (D.Focus+RF_FOCUS_HELP) Mod (RF_FOCUS_HELP+1);
    D.Dirty := True;
   End;
   59: RFHelp(D);
   72,75,77,80: Begin
    If D.Focus < RF_MODE_COUNT Then Begin
     Next := D.Focus;
     Case Ord(K) Of
      72: Dec(Next,2);
      80: Inc(Next,2);
      75: Dec(Next);
      77: Inc(Next);
     End;
     Next := (Next+RF_MODE_COUNT) Mod RF_MODE_COUNT;
     RFChoose(D,Next);
    End;
   End;
  End;
  Exit;
 End;
 Case K Of
  #27: RFActivate(D,RF_FOCUS_CANCEL);
  #9: Begin
   D.Focus := (D.Focus+1) Mod (RF_FOCUS_HELP+1);
   D.Dirty := True;
  End;
  #13: Begin
   If D.Focus >= RF_FOCUS_SCOPE Then
    RFActivate(D,D.Focus)
   Else
    RFActivate(D,RF_FOCUS_APPLY);
  End;
  ' ': RFActivate(D,D.Focus);
 Else
  Case UpCase(K) Of
   'H': RFChoose(D,RF_HORIZONTAL);
   'V': RFChoose(D,RF_VERTICAL);
   'G','L': RFChoose(D,RF_LEFT);
   'D','R': RFChoose(D,RF_RIGHT);
   'I': RFChoose(D,RF_HALF);
   'O','0': RFChoose(D,RF_ORIGINAL);
  End;
 End;
End;

Procedure RFMouse(Var D: TRFState);
Var
 I: Integer;
Begin
 GetMouseStateLocal(D.MX,D.MY,D.MB);
 If ((D.MB And 1) <> 0) And ((D.PreviousButtons And 1) = 0) Then Begin
  If (D.MX >= D.X+596) And (D.MX <= D.X+617) And
     (D.MY >= D.Y+3) And (D.MY <= D.Y+21) Then
   RFActivate(D,RF_FOCUS_CANCEL)
  Else If PEInside(D.MX,D.MY,D.ApplyButton) Then
   RFActivate(D,RF_FOCUS_APPLY)
  Else If PEInside(D.MX,D.MY,D.CancelButton) Then
   RFActivate(D,RF_FOCUS_CANCEL)
  Else If PEInside(D.MX,D.MY,D.ResetButton) Then
   RFActivate(D,RF_FOCUS_RESET)
  Else If PEInside(D.MX,D.MY,D.HelpButton) Then
   RFActivate(D,RF_FOCUS_HELP)
  Else If PEInside(D.MX,D.MY,D.ScopeBox) And D.HasSelection Then Begin
   D.UseSelection := D.MY >= D.Y+338;
   D.Focus := RF_FOCUS_SCOPE;
   RFUpdateResult(D);
  End
  Else
   For I := 0 To RF_MODE_COUNT-1 Do
    If PEInside(D.MX,D.MY,D.Tiles[I]) Then
     RFChoose(D,I);
 End;
 D.PreviousButtons := D.MB;
End;

Procedure RFInitialize(Var D: TRFState);
Begin
 FillChar(D,SizeOf(D),0);
 PEInitialize(D.PaletteData);
 D.HasSelection := SelectionActive;
 D.UseSelection := D.HasSelection;
 RFLayout(D);
 RFUpdateResult(D);
 GetMouseStateLocal(D.MX,D.MY,D.PreviousButtons);
End;

Function RFBuildResult(Const D: TRFState; Var Buffer: PByte): Boolean;
Var
 X, Y, SX, SY: Integer;
 Dest: PByte;
 Index: Byte;
 Size: LongInt;
Begin
 Buffer := Nil;
 RFBuildResult := False;
 If Not D.ValidResult Or (D.Mode = RF_ORIGINAL) Then
  Exit;
 Size := LongInt(D.ResultW)*D.ResultH;
 If Size <= 0 Then
  Exit;
 GetMem(Buffer,Size);
 Dest := Buffer;
 For Y := 0 To D.ResultH-1 Do
  For X := 0 To D.ResultW-1 Do Begin
   RFMapPixel(D.Mode,D.SourceW,D.SourceH,X,Y,SX,SY);
   If Not PGReadIndex(D.Source.Left+SX,D.Source.Top+SY,Index) Then Begin
    FreeMem(Buffer,Size);
    Buffer := Nil;
    Exit;
   End;
   Dest^ := Index;
   Inc(Dest);
  End;
 RFBuildResult := True;
End;

Function RFApply(Const D: TRFState): Boolean;
Var
 Buffer, SourceRow, DestRow: PByte;
 X, Y: Integer;
Begin
 RFApply := False;
 If Not RFBuildResult(D,Buffer) Then
  Exit;
 { Aucun changement du document avant que le resultat soit disponible. }
 AddSnapshotToHistory(TOOL_PENCIL);
 If D.UseSelection Then Begin
  For Y := D.Source.Top To D.Source.Bottom Do Begin
   DestRow := CanvasImage;
   Inc(DestRow,LongInt(Y)*CanvasImageW+D.Source.Left);
   FillChar(DestRow^,D.SourceW,BackgroundColor);
  End;
  SourceRow := Buffer;
  For Y := 0 To D.ResultH-1 Do Begin
   DestRow := CanvasImage;
   Inc(DestRow,LongInt(D.Destination.Top+Y)*CanvasImageW+D.Destination.Left);
   For X := 0 To D.ResultW-1 Do Begin
    DestRow^ := SourceRow^;
    Inc(DestRow);
    Inc(SourceRow);
   End;
  End;
  FreeMem(Buffer,LongInt(D.ResultW)*D.ResultH);
  SelectionRect.Left := CanvasX+D.Destination.Left;
  SelectionRect.Top := CanvasY+D.Destination.Top;
  SelectionRect.Right := CanvasX+D.Destination.Right;
  SelectionRect.Bottom := CanvasY+D.Destination.Bottom;
  SelectionActive := True;
 End
 Else Begin
  FreeMem(CanvasImage,LongInt(CanvasImageW)*CanvasImageH);
  CanvasImage := Buffer;
  CanvasImageW := D.ResultW;
  CanvasImageH := D.ResultH;
  ImageBuffer.Width := D.ResultW;
  ImageBuffer.Height := D.ResultH;
  SelectionActive := False;
 End;
 AntsValid := False;
 RubberValid := False;
 PreviewValid := False;
 ImageBuffer.Modified := True;
 RFApply := True;
End;

Procedure FlipRotateDialog;
Var
 D: TRFState;
Begin
 If Not PGHasImage Then Begin
  ShowMessage('Retourner / Pivoter','Aucune image a transformer.');
  Exit;
 End;
 MenuActive := False;
 RedrawInterface;
 RFInitialize(D);
 PEHideMouse;
 PEBuildDisplayPalette;
 PEShowMouse;
 While Not D.Done Do Begin
  If D.Dirty Then
   RFDraw(D);
  If KeyPressed Then
   RFKeyboard(D);
  If Not D.Done Then
   RFMouse(D);
  Delay(10);
 End;
 PEHideMouse;
 PERestoreHardware(D.PaletteData);
 If D.Accepted Then
  If Not RFApply(D) Then Begin
   PEShowMouse;
   ShowMessage('Retourner / Pivoter','Transformation impossible. Le dessin est conserve.');
   PEHideMouse;
  End;
 PEShowMouse;
 Repeat
  GetMouseStateLocal(D.MX,D.MY,D.MB);
  If (D.MB And 1) <> 0 Then
   Delay(10);
 Until (D.MB And 1) = 0;
 OldMouseButtons := 0;
 MouseButtons := 0;
 RedrawInterface;
End;


{ Supprimer l'arriere-plan : segmentation fond / premier plan.
  1) la couleur du fond est estimee sur le pourtour de l'image (couleurs
     dominantes des bords, jusqu'a 4 graines) ;
  2) le fond est propage depuis les bords, par voisinage, tant que la couleur
     reste proche d'une graine ou varie peu d'un pixel au suivant (degrades) ;
  3) les zones fermees de meme couleur peuvent etre retirees (option) ;
  4) les petits ilots parasites sont elimines et les bords lisses.
  Le resultat est soit un fond transparent (couleur de transparence dediee),
  soit un fond rempli avec une couleur choisie. }

Const
 BR_W = 616;
 BR_H = 384;

Type
 PBRQueue = ^TBRQueue;
 TBRQueue = Array[0..100000000] of LongInt;
 TBRState = Record
  X, Y: Integer;
  Mode: Integer;
  ColorIndex: Integer;
  Tolerance: Integer;
  Holes, Smooth: Boolean;
  Mask: PByte;
  MaskSize: LongInt;
  BRPercent: Integer;
  Radius: Integer;
  Minus2, Track2, Plus2: TRect;
  Done, Accepted, Dirty: Boolean;
  RadioT, RadioC, Track, MinusB, PlusB, HolesBox, SmoothBox: TRect;
  Swatches: Array[0..15] of TRect;
  BeforeBox, AfterBox, ApplyButton, CancelButton, HelpButton: TRect;
  PaletteData: TPEState;
  MX, MY, MB, PreviousButtons: Integer;
 End;

Var
 BRSeeds: Array[0..3] of TRGBColor;
 BRSeedCount: Integer;
 BRThr: LongInt;

Function BRSeedDistance(Const C: TRGBColor): LongInt;
Var
 I: Integer;
 Best, Dist: LongInt;
Begin
 Best := 1000000;
 For I := 0 To BRSeedCount-1 Do Begin
  Dist := PGDistance(C,BRSeeds[I]);
  If Dist < Best Then
   Best := Dist;
 End;
 BRSeedDistance := Best;
End;

Procedure BRComputeMask(Var D: TBRState);
Var
 W, H, I, J, K: Integer;
 Size, P, Q0, N, Head, Tail, Total, BgCount, MinKeep, Comp: LongInt;
 Queue: PBRQueue;
 Hist: Array[0..255] of LongInt;
 Tmp: PByte;
 M: PByte;
 Idx: Byte;
 Best: Integer;
 CurC, NbC: TRGBColor;
 Step: LongInt;
 NX, NY, Dir, Neigh: Integer;

 Procedure CountBorder(X, Y: Integer);
 Var
  B: Byte;
 Begin
  If PGReadIndex(X,Y,B) Then Begin
   Inc(Hist[B]);
   Inc(Total);
  End;
 End;

 Procedure Seed(X, Y: Integer);
 Var
  Pos: LongInt;
  C: TRGBColor;
 Begin
  Pos := LongInt(Y)*W+X;
  If M[Pos] = 0 Then
   Exit;
  If PGReadRGB(X,Y,C) Then
   If BRSeedDistance(C) <= BRThr Then Begin
    M[Pos] := 0;
    Queue^[Tail] := Pos;
    Inc(Tail);
   End;
 End;

Begin
 W := CanvasImageW;
 H := CanvasImageH;
 Size := LongInt(W)*H;
 If D.Mask <> Nil Then
  FreeMem(D.Mask,D.MaskSize);
 D.Mask := Nil;
 D.BRPercent := 0;
 If Not PGHasImage Or (Size <= 0) Then
  Exit;
 GetMem(D.Mask,Size);
 D.MaskSize := Size;
 M := D.Mask;
 FillChar(M^,Size,1);
 GetMem(Queue,Size*SizeOf(LongInt));

 { 1) couleurs dominantes du pourtour = graines de fond }
 FillChar(Hist,SizeOf(Hist),0);
 Total := 0;
 For I := 0 To W-1 Do Begin
  CountBorder(I,0);
  CountBorder(I,H-1);
 End;
 For J := 1 To H-2 Do Begin
  CountBorder(0,J);
  CountBorder(W-1,J);
 End;
 BRSeedCount := 0;
 For K := 0 To 3 Do Begin
  Best := -1;
  For I := 0 To 255 Do
   If (Hist[I] > 0) And ((Best < 0) Or (Hist[I] > Hist[Best])) Then
    Best := I;
  If Best < 0 Then
   Break;
  If (K > 0) And (Hist[Best]*100 < Total*8) Then
   Break;
  BRSeeds[BRSeedCount] := ImageBuffer.Palette[Best];
  Inc(BRSeedCount);
  Hist[Best] := 0;
 End;
 { seuil quadratique : 0..100 % -> distance RVB 0..250 }
 Step := LongInt(D.Tolerance)*5 Div 2;
 BRThr := Step*Step;

 { 2) propagation du fond depuis les bords }
 Head := 0;
 Tail := 0;
 For I := 0 To W-1 Do Begin
  Seed(I,0);
  Seed(I,H-1);
 End;
 For J := 1 To H-2 Do Begin
  Seed(0,J);
  Seed(W-1,J);
 End;
 While Head < Tail Do Begin
  P := Queue^[Head];
  Inc(Head);
  NX := Integer(P Mod W);
  NY := Integer(P Div W);
  PGReadRGB(NX,NY,CurC);
  For Dir := 0 To 3 Do Begin
   I := NX;
   J := NY;
   Case Dir Of
    0: Dec(I);
    1: Inc(I);
    2: Dec(J);
    3: Inc(J);
   End;
   If (I < 0) Or (J < 0) Or (I >= W) Or (J >= H) Then
    Continue;
   Q0 := LongInt(J)*W+I;
   If M[Q0] = 0 Then
    Continue;
   PGReadRGB(I,J,NbC);
   N := BRSeedDistance(NbC);
   { proche d'une graine, ou degrade doux pas trop loin du fond }
   If (N <= BRThr) Or ((PGDistance(CurC,NbC) <= BRThr Div 16) And
                        (N <= BRThr*4)) Then Begin
    M[Q0] := 0;
    Queue^[Tail] := Q0;
    Inc(Tail);
   End;
  End;
 End;

 { 3) zones fermees de meme couleur que le fond }
 If D.Holes Then
  For J := 0 To H-1 Do
   For I := 0 To W-1 Do
    If M[LongInt(J)*W+I] <> 0 Then Begin
     PGReadRGB(I,J,CurC);
     If BRSeedDistance(CurC) <= BRThr Then
      M[LongInt(J)*W+I] := 0;
    End;

 { 4a) elimination des petits ilots de premier plan }
 MinKeep := Size Div 800;
 If MinKeep < 3 Then
  MinKeep := 3;
 For P := 0 To Size-1 Do Begin
  If M[P] <> 1 Then
   Continue;
  Head := 0;
  Tail := 1;
  Queue^[0] := P;
  M[P] := 2;
  While Head < Tail Do Begin
   Q0 := Queue^[Head];
   Inc(Head);
   NX := Integer(Q0 Mod W);
   NY := Integer(Q0 Div W);
   For Dir := 0 To 3 Do Begin
    I := NX;
    J := NY;
    Case Dir Of
     0: Dec(I);
     1: Inc(I);
     2: Dec(J);
     3: Inc(J);
    End;
    If (I < 0) Or (J < 0) Or (I >= W) Or (J >= H) Then
     Continue;
    Comp := LongInt(J)*W+I;
    If M[Comp] = 1 Then Begin
     M[Comp] := 2;
     Queue^[Tail] := Comp;
     Inc(Tail);
    End;
   End;
  End;
  If Tail < MinKeep Then
   For Head := 0 To Tail-1 Do
    M[Queue^[Head]] := 0;
 End;
 For P := 0 To Size-1 Do
  If M[P] = 2 Then
   M[P] := 1;

 { 4b) lissage des bords : un pixel isole prend la valeur majoritaire }
 If D.Smooth And (W > 2) And (H > 2) Then Begin
  GetMem(Tmp,Size);
  Move(M^,Tmp^,Size);
  For J := 1 To H-2 Do
   For I := 1 To W-2 Do Begin
    P := LongInt(J)*W+I;
    Neigh := 0;
    For K := -1 To 1 Do Begin
     Inc(Neigh,Tmp[P-W+K]);
     Inc(Neigh,Tmp[P+W+K]);
    End;
    Inc(Neigh,Tmp[P-1]);
    Inc(Neigh,Tmp[P+1]);
    If (Tmp[P] = 1) And (Neigh <= 2) Then
     M[P] := 0
    Else If (Tmp[P] = 0) And (Neigh >= 7) Then
     M[P] := 1;
   End;
  FreeMem(Tmp,Size);
 End;

 BgCount := 0;
 For P := 0 To Size-1 Do
  If M[P] = 0 Then
   Inc(BgCount);
 D.BRPercent := Integer((BgCount*100) Div Size);
 FreeMem(Queue,Size*SizeOf(LongInt));
End;

Procedure BRLayout(Var D: TBRState);
Var
 I: Integer;
Begin
 D.X := (ScreenWidth-BR_W) Div 2;
 D.Y := (ScreenHeight-BR_H) Div 2;
 PERect(D.RadioT,D.X+12,D.Y+52,236,20);
 PERect(D.RadioC,D.X+12,D.Y+74,236,20);
 For I := 0 To 15 Do
  PERect(D.Swatches[I],D.X+16+(I Mod 8)*28,D.Y+102+(I Div 8)*26,24,20);
 PERect(D.MinusB,D.X+12,D.Y+178,24,20);
 PERect(D.Track,D.X+42,D.Y+178,160,20);
 PERect(D.PlusB,D.X+208,D.Y+178,24,20);
 PERect(D.HolesBox,D.X+12,D.Y+212,236,18);
 PERect(D.SmoothBox,D.X+12,D.Y+234,236,18);
 PERect(D.BeforeBox,D.X+300,D.Y+65,140,140);
 PERect(D.AfterBox,D.X+454,D.Y+65,140,140);
 PERect(D.ApplyButton,D.X+12,D.Y+340,120,25);
 PERect(D.CancelButton,D.X+144,D.Y+340,108,25);
 PERect(D.HelpButton,D.X+300,D.Y+340,150,25);
End;

Procedure BRDrawPreview(Const D: TBRState; Const R: TRect; After: Boolean);
Var
 W, H, DrawW, DrawH, X, Y, DX, DY, Left, Top, Disp: Integer;
 C: TRGBColor;
Begin
 PEFill(R,LightGray);
 PEBevel(R,True);
 If Not PGHasImage Then
  Exit;
 W := CanvasImageW;
 H := CanvasImageH;
 RFFitSize(W,H,132,132,DrawW,DrawH);
 Left := R.Left+(R.Right-R.Left+1-DrawW) Div 2;
 Top := R.Top+(R.Bottom-R.Top+1-DrawH) Div 2;
 For Y := 0 To DrawH-1 Do Begin
  DY := Min(H-1,(LongInt(Y)*H+H Div 2) Div DrawH);
  For X := 0 To DrawW-1 Do Begin
   DX := Min(W-1,(LongInt(X)*W+W Div 2) Div DrawW);
   If After And (D.Mask <> Nil) And (D.Mask[LongInt(DY)*W+DX] = 0) Then Begin
    If D.Mode = 0 Then Begin
     If (((X Div 4)+(Y Div 4)) And 1) = 0 Then
      Disp := LightGray
     Else
      Disp := White;
    End
    Else
     Disp := PEDisplayColor(ImageBuffer.Palette[D.ColorIndex]);
    PutPixel(Left+X,Top+Y,Disp);
   End
   Else If PGReadRGB(DX,DY,C) Then
    PutPixel(Left+X,Top+Y,PEDisplayColor(C));
  End;
 End;
 SetColor(DarkGray);
 Rectangle(Left-1,Top-1,Left+DrawW,Top+DrawH);
End;

