Function OcEmText(Em100: Integer): String;
Var
  OcCents: String;
Begin
  OcCents := OcNumberText(Em100 Mod 100);
  If Length(OcCents) < 2 Then OcCents := '0' + OcCents;
  OcEmText := OcNumberText(Em100 Div 100) + ',' + OcCents + ' px';
End;


Function OcGetInk(PixelX, PixelY: Integer): Boolean;
Begin
  OcGetInk := OcImage^[PixelY]^[PixelX] >= 8;
End;

Function OcRowHasInk(RowNumber: Integer): Boolean;
Var
  OcColumn: Integer;
Begin
  OcRowHasInk := False;
  For OcColumn := 1 To OcImageWidth Do
    If OcGetInk(OcColumn, RowNumber) Then
    Begin
      OcRowHasInk := True;
      Exit;
    End;
End;

Function OcColumnHasInk(ColumnNumber, FirstRow, LastRow: Integer): Boolean;
Var
  OcRow: Integer;
Begin
  OcColumnHasInk := False;
  For OcRow := FirstRow To LastRow Do
    If OcGetInk(ColumnNumber, OcRow) Then
    Begin
      OcColumnHasInk := True;
      Exit;
    End;
End;

Function OcRecognizeGlyph(FirstColumn, LastColumn, FirstRow, LastRow: Integer): Char;
Begin
  OcBestErrors := 36;
  OcBestIndex := 0;
  For OcFontIndex := 1 To 36 Do
  Begin
    OcErrors := 0;
    For OcRowIndex := 1 To 7 Do
    Begin
      OcSourceY := FirstRow + (Longint(2 * OcRowIndex - 1) * (LastRow - FirstRow + 1)) Div 14;
      For OcColumnIndex := 1 To 5 Do
      Begin
        OcSourceX := FirstColumn + (Longint(2 * OcColumnIndex - 1) * (LastColumn - FirstColumn + 1)) Div 10;
        If OcGetInk(OcSourceX, OcSourceY) <>
           (OcFont[OcFontIndex][(OcRowIndex - 1) * 5 + OcColumnIndex] = '1') Then
          Inc(OcErrors);
      End;
    End;
    If OcErrors < OcBestErrors Then
    Begin
      OcBestErrors := OcErrors;
      OcBestIndex := OcFontIndex;
    End;
  End;

  Inc(OcDryGlyphs);
  Inc(OcDryErrors, OcBestErrors);
  If (OcBestIndex = 0) Or (OcBestErrors > 17) Then
    OcRecognizeGlyph := '?'
  Else
    OcRecognizeGlyph := OcFontCharacters[OcBestIndex];
End;

