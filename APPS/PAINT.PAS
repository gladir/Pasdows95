  Preview: Boolean;
  Done, Accepted, DriverUI, Dirty: Boolean;
  Status: String[80];
  DevRows: Array[0..5] of TRect;
  SrcRect, ModeRect, ZoneRect: Array[0..3] of TRect;
  DpiM, DpiTrack, DpiP: TRect;
  BriM, BriTrack, BriP: TRect;
  ConM, ConTrack, ConP: TRect;
