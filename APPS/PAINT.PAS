 X := X + PdwVP.X1; Y := Y + PdwVP.Y1;
 If (X < 0) Or (Y < 0) Or (X >= PdwW) Or (Y >= PdwH) Then GetPixel := 0
 Else GetPixel := (PdwBits + (Y * PdwW + X))^;
End;

